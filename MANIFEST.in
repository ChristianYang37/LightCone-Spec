include LICENSE NOTICE README.md README_zh-CN.md CHANGELOG.md
include CONTRIBUTING.md CONTRIBUTING_zh-CN.md SECURITY.md
include AGENTS.md .codex/project-standards.md
include .dockerignore
include pyproject.toml uv.lock Dockerfile
recursive-include docs *.md
recursive-include manifests *.json *.sha256
recursive-include patches *.patch *.json *.sh series
recursive-include scripts *.py
recursive-include tests *.py
global-exclude __pycache__ *.py[cod] .DS_Store
prune artifacts
prune sglang
prune tmp
prune .local-backup
