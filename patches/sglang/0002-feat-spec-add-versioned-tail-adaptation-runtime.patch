+"""Backend-neutral LightCone tail adaptation for speculative workers.
+
+This module is deliberately a thin SGLang bridge.  The parameter bank,
+candidate generator, L0--L3 policies, version publication and controller logic
+remain owned by :mod:`lightcone_spec`; the code below only:
+
+* binds DFlash/EAGLE proposal tensors to the common runtime hooks;
+* applies one of the three cache-safe tail layouts before proposal sampling;
+* enforces the backend-specific legal publication boundary; and
+* keeps per-batch parameter rows at stable device addresses for graph replay.
+
+No object from this module is constructed when
+``--speculative-adaptation-config`` is absent (or resolves to ``static``).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import time
+from functools import partial
+from pathlib import Path
+from typing import Any, Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+class _FallbackExactnessViolation(RuntimeError):
+    """Exactness failure used only before the optional runtime is initialized."""
+
+
+def validate_proposal_depth(
+    *, actual: int, declared: int, expected: int, algorithm: str, pair_id: str
+) -> int:
+    """Fail closed when worker proposal rows disagree with pre-KV sizing."""
+
+    actual = int(actual)
+    declared = int(declared)
+    expected = int(expected)
+    if actual < 1 or actual > declared or actual != expected:
+        raise ValueError(
+            f"{algorithm} proposal depth mismatch: worker uses {actual}, pair "
+            f"{pair_id!r} declares an upper bound of {declared}, and runtime "
+            f"config resolves to {expected}"
+        )
+    return actual
+
+
+def tp_gradient_consensus(
+    grad: torch.Tensor,
+    finite_t: torch.Tensor,
+    *,
+    tp_size: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Average one FP32 gradient across TP ranks without a host sync.
+
+    The callback runs on the adaptation side stream. Its collectives have a
+    fixed order on every rank: finite-flag SUM, flattened-gradient SUM, then a
+    post-reduction checksum SUM. A non-finite rank or checksum disagreement
+    produces an exact zero gradient plus a device-resident false validity flag.
+    """
+
+    grad_fp32 = grad.to(dtype=torch.float32)
+    if grad_fp32.ndim not in (1, 2):
+        raise ValueError("TP adaptation gradient must have shape (P,) or (B, P)")
+    was_single = grad_fp32.ndim == 1
+    rows = grad_fp32.unsqueeze(0) if was_single else grad_fp32
+    finite = torch.as_tensor(finite_t, device=grad.device, dtype=torch.bool)
+    finite = finite.reshape(-1)
+    if finite.shape != (rows.shape[0],):
+        raise ValueError("TP gradient health must have one predicate per request")
+    finite = finite & torch.isfinite(rows).all(dim=1)
+    local = torch.where(finite[:, None], rows, torch.zeros_like(rows))
+    if int(tp_size) <= 1:
+        output = torch.where(finite[:, None], local, torch.zeros_like(local))
+        return (
+            (output.squeeze(0), finite.squeeze(0))
+            if was_single
+            else (output, finite)
+        )
+
+    from sglang.srt.distributed.communication_op import (
+        tensor_model_parallel_all_reduce,
+    )
+
+    finite_count = tensor_model_parallel_all_reduce(finite.to(dtype=torch.float32))
+    flat = tensor_model_parallel_all_reduce(local.reshape(-1).contiguous())
+    consensus = flat.reshape_as(rows) / float(tp_size)
+
+    local_checksum = torch.stack(
+        (consensus.sum(dim=1), consensus.square().sum(dim=1)), dim=1
+    )
+    checksum_sum = tensor_model_parallel_all_reduce(local_checksum.clone())
+    checksum_ok = torch.isclose(
+        checksum_sum,
+        local_checksum * float(tp_size),
+        rtol=1e-5,
+        atol=1e-6,
+    ).all(dim=1)
+    global_ok = (
+        finite_count.eq(float(tp_size))
+        & torch.isfinite(consensus).all(dim=1)
+        & checksum_ok
+    )
+    output = torch.where(global_ok[:, None], consensus, torch.zeros_like(consensus))
+    return (
+        (output.squeeze(0), global_ok.squeeze(0))
+        if was_single
+        else (output, global_ok)
+    )
+
+
+def maybe_build_tail_adaptation_manager(server_args, worker, *, algorithm: str):
+    """Build the shared tail manager only for an explicitly configured run."""
+
+    path = getattr(server_args, "speculative_adaptation_config", None)
+    if not path:
+        return None
+
+    from lightcone_spec.config.loader import load_adaptation_config
+    from lightcone_spec.sglang_bridge.static_observer import (
+        evidence_only_static_bypass,
+    )
+
+    config = load_adaptation_config(path)
+    bypass, reason = evidence_only_static_bypass(config)
+    if bypass:
+        logger.info(
+            "Using native %s with evidence-only telemetry (%s).",
+            str(algorithm).upper(),
+            reason,
+        )
+        return None
+    return LightConeTailAdaptationManager(
+        config_path=path,
+        worker=worker,
+        algorithm=algorithm,
+    )
+
+
+class _TensorParallelTailProjection:
+    """Project through an existing vocab-parallel head without replicating it."""
+
+    def __init__(
+        self,
+        lm_head,
+        *,
+        tp_rank: int,
+        tp_size: int,
+        vocab_size: int,
+    ) -> None:
+        weight = getattr(lm_head, "weight", None)
+        if weight is None or not torch.is_tensor(weight) or weight.ndim != 2:
+            raise RuntimeError("tail adaptation requires a 2-D floating LM head")
+        if not torch.is_floating_point(weight):
+            raise RuntimeError(
+                "tail adaptation does not yet support a quantized proposal head"
+            )
+        self.lm_head = lm_head
+        self.weight = weight.detach()
+        self.tp_rank = int(tp_rank)
+        self.tp_size = int(tp_size)
+        self.vocab_size = int(vocab_size)
+        self.dtype = self.weight.dtype
+        self.device = self.weight.device
+
+    def project_hidden(self, hidden: torch.Tensor) -> torch.Tensor:
+        local = hidden.to(self.weight.dtype) @ self.weight.T
+        if self.tp_size > 1:
+            from sglang.srt.distributed.communication_op import (
+                tensor_model_parallel_all_gather,
+            )
+
+            local = tensor_model_parallel_all_gather(local, dim=-1)
+        return local[..., : self.vocab_size]
+
+    def project_hidden_range(
+        self, hidden: torch.Tensor, *, vocab_start: int, vocab_end: int
+    ) -> torch.Tensor:
+        """Project one global-vocabulary range using its local head rows."""
+
+        start = int(vocab_start)
+        end = int(vocab_end)
+        shard = getattr(self.lm_head, "shard_indices", None)
+        if shard is None:
+            if start < 0 or end > self.weight.shape[0]:
+                raise ValueError(
+                    f"proposal vocab range [{start}, {end}) is outside the head"
+                )
+            weight = self.weight[start:end]
+        else:
+            org_start = int(getattr(shard, "org_vocab_start_index", 0))
+            org_count = int(
+                getattr(shard, "num_org_elements", self.weight.shape[0])
+            )
+            org_end = org_start + org_count
+            if start >= org_start and end <= org_end:
+                weight = self.weight[start - org_start : end - org_start]
+            else:
+                added_start = int(getattr(shard, "added_vocab_start_index", -1))
+                added_count = int(getattr(shard, "num_added_elements", 0))
+                added_end = added_start + added_count
+                if not (start >= added_start and end <= added_end):
+                    raise ValueError(
+                        "proposal vocab range does not belong to this TP head shard: "
+                        f"range=[{start}, {end}), org=[{org_start}, {org_end}), "
+                        f"added=[{added_start}, {added_end})"
+                    )
+                padded = int(
+                    getattr(shard, "num_org_elements_padded", org_count)
+                )
+                local_start = padded + start - added_start
+                weight = self.weight[local_start : local_start + end - start]
+        return hidden.to(weight.dtype) @ weight.T
+
+    def backproject_logits(self, logit_grad: torch.Tensor) -> torch.Tensor:
+        """Compute ``grad_logits @ W`` and sum the TP-vocabulary shards."""
+
+        shard = getattr(self.lm_head, "shard_indices", None)
+        if shard is None:
+            start = self.tp_rank * int(self.weight.shape[0])
+            count = max(
+                0,
+                min(int(self.weight.shape[0]), self.vocab_size - start),
+            )
+            local_weight = self.weight[:count]
+            local_grad = logit_grad[..., start : start + count]
+        else:
+            start = int(getattr(shard, "org_vocab_start_index", 0))
+            count = max(
+                0,
+                min(
+                    int(getattr(shard, "num_org_elements", self.weight.shape[0])),
+                    self.vocab_size - start,
+                ),
+            )
+            local_weight = self.weight[:count]
+            local_grad = logit_grad[..., start : start + count]
+        hidden_grad = local_grad.to(local_weight.dtype) @ local_weight
+        if self.tp_size > 1:
+            from sglang.srt.distributed.communication_op import (
+                tensor_model_parallel_all_reduce,
+            )
+
+            hidden_grad = tensor_model_parallel_all_reduce(hidden_grad)
+        return hidden_grad
+
+
+class LightConeTailAdaptationManager:
+    """One common runtime front-end for DFlash, classic EAGLE and EAGLE3."""
+
+    # ``__init__`` replaces this with lightcone_spec's typed exit-code error.
+    # Keeping a local fallback makes fail-closed protocol checks well-defined
+    # during partial construction and in isolated worker/protocol tests.
+    _ExactnessViolation = _FallbackExactnessViolation
+
+    def __init__(self, *, config_path: str, worker, algorithm: str) -> None:
+        import numpy as np
+
+        from lightcone_spec.adapters.adapter_params import (
+            HIDDEN_PROJ_DIM,
+            AdapterShapes,
+            parameter_layout_identity,
+            parameter_layout_sha256,
+        )
+        from lightcone_spec.adapters.projections import (
+            build_hidden_projection,
+            build_output_basis,
+            load_projection_artifact,
+            save_projection_artifact,
+        )
+        from lightcone_spec.config.loader import load_adaptation_config
+        from lightcone_spec.config.schema import (
+            MODEL_PAIRS,
+            effective_proposal_depth,
+        )
+        from lightcone_spec.controller.artifact import ControllerArtifact
+        from lightcone_spec.exit_codes import ExactnessViolation
+        from lightcone_spec.locking.hashing import sha256_bytes
+        from lightcone_spec.methods.registry import build_method
+        from lightcone_spec.sglang_bridge import hooks as H
+        from lightcone_spec.sglang_bridge.bank import (
+            AdaptationCapacityError,
+            estimate_dflash_supervision_fanout_bytes,
+            estimate_adaptation_memory,
+        )
+        from lightcone_spec.sglang_bridge.runtime import AdaptationRuntime
+        from lightcone_spec.sglang_bridge.telemetry import (
+            CudaTelemetryLanePool,
+            TelemetrySink,
+        )
+
+        self._H = H
+        self._CapacityError = AdaptationCapacityError
+        self._ExactnessViolation = ExactnessViolation
+        self.worker = worker
+        self.config = load_adaptation_config(config_path)
+        self.algorithm = str(algorithm).upper()
+        if self.algorithm not in ("DFLASH", "EAGLE", "EAGLE3"):
+            raise ValueError(f"unsupported tail-adaptation backend {algorithm!r}")
+
+        pair = MODEL_PAIRS.get(self.config.model.pair_id)
+        if pair is not None and pair["speculative_algorithm"] != self.algorithm:
+            raise ValueError(
+                "adaptation model/backend mismatch: "
+                f"pair {self.config.model.pair_id!r} declares "
+                f"{pair['speculative_algorithm']}, worker is {self.algorithm}"
+            )
+
+        self.device = str(worker.device)
+        self.tp_rank = int(getattr(worker.ps, "tp_rank", 0))
+        self.tp_size = int(getattr(worker.ps, "tp_size", 1))
+        proposal_head = self._resolve_proposal_head(worker)
+        head_weight = proposal_head.weight.detach()
+        self._forward_dtype = head_weight.dtype
+        if self._forward_dtype not in (torch.bfloat16, torch.float32):
+            raise RuntimeError(
+                "tail adaptation requires a certified bf16/fp32 proposal head; "
+                f"got {self._forward_dtype}"
+            )
+        hidden_size = int(head_weight.shape[1])
+        vocab_size = self._resolve_vocab_size(worker, proposal_head)
+        mode = self.config.tail_layout_mode
+        rank = int(self.config.adapter_rank)
+        draft_depth = self._resolve_draft_depth(worker)
+        if pair is not None:
+            expected_depth = effective_proposal_depth(
+                pair, int(self.config.runtime.speculative_num_draft_tokens)
+            )
+            draft_depth = validate_proposal_depth(
+                actual=draft_depth,
+                declared=int(pair["draft_depth"]),
+                expected=expected_depth,
+                algorithm=self.algorithm,
+                pair_id=self.config.model.pair_id,
+            )
+
+        r_h_np = build_hidden_projection(
+            d=hidden_size,
+            m=HIDDEN_PROJ_DIM,
+            seed=0,
+        )
+        r_h_sha = sha256_bytes(
+            np.ascontiguousarray(r_h_np, dtype=np.float32).tobytes()
+        )
+        projection_identity: Optional[dict] = {
+            "kind": "hidden_projection",
+            "seed": 0,
+            "sha256": r_h_sha,
+        }
+        projection = _TensorParallelTailProjection(
+            proposal_head,
+            tp_rank=self.tp_rank,
+            tp_size=self.tp_size,
+            vocab_size=vocab_size,
+        )
+        if mode == "output_residual":
+            basis, output_identity = self._load_or_build_output_basis(
+                proposal_head=proposal_head,
+                vocab_size=vocab_size,
+                hidden_projection=r_h_np,
+                build_output_basis=build_output_basis,
+                load_projection_artifact=load_projection_artifact,
+                save_projection_artifact=save_projection_artifact,
+            )
+            projection_identity = output_identity
+            basis_dev: Any = basis.to(
+                device=self.device, dtype=self._forward_dtype
+            )
+        else:
+            # Tail LoRA/full use the resident proposal head.  Do not materialise
+            # a global or FP32 duplicate of W.
+            basis_dev = projection
+
+        shapes = AdapterShapes(
+            rank=rank,
+            markov_dim=0,
+            vocab_size=vocab_size,
+            weight_update_mode=mode,
+            hidden_size=hidden_size,
+            draft_depth=draft_depth,
+            has_markov=False,
+            has_confidence=False,
+            algorithm=self.algorithm,
+        )
+        self.shapes = shapes
+        self._slices = shapes.parameter_slices()
+        self._projection = projection
+        self._r_h_dev = torch.from_numpy(r_h_np).to(
+            device=self.device,
+            dtype=self._forward_dtype,
+        )
+        self._basis_dev = basis_dev
+        self._r_h_forward = (
+            self._r_h_dev
+            if mode == "output_residual"
+            else None
+        )
+        self._basis_forward = (
+            basis_dev
+            if mode == "output_residual"
+            else None
+        )
+
+        layout_identity = parameter_layout_identity(
+            shapes,
+            forward_dtype=str(self._forward_dtype),
+            tensor_parallel_rank=self.tp_rank,
+            tensor_parallel_world_size=self.tp_size,
+            target_revision=self.config.model.target_revision,
+            drafter_revision=self.config.model.drafter_revision,
+            projection_identity=projection_identity,
+            head_identity={
+                "module": type(proposal_head).__name__,
+                "local_shape": list(head_weight.shape),
+                "global_vocab_size": vocab_size,
+                "dtype": str(head_weight.dtype),
+                "owner": (
+                    "draft" if self.algorithm == "EAGLE3" else "target"
+                ),
+            },
+            optimizer_identity={
+                "name": self.config.optimizer,
+                "update_contract": "decoupled_adamw_delta_v1",
+                "weight_decay": self.config.weight_decay,
+            },
+        )
+        self.parameter_layout_identity = layout_identity
+        self.parameter_layout_sha256 = parameter_layout_sha256(layout_identity)
+
+        artifact = None
+        if self.config.controller.artifact_path is not None:
+            artifact = ControllerArtifact.load(self.config.controller.artifact_path)
+        planned_delay = 1 + self.config.async_.logical_delay_rounds
+        constant_profiles = (
+            artifact.extra.get("constant_controller_profiles", {})
+            if artifact is not None
+            else {}
+        )
+        constant_delay = (
+            planned_delay
+            if self.config.method == "lc_damp"
+            and str(planned_delay) in constant_profiles
+            and self.config.trace.trace_capture_max_bytes == 0
+            else None
+        )
+
+        num_slots = self.config.runtime.resolved_adaptation_slots()
+        row_capacity = self._row_capacity(worker, num_slots)
+        planned_row_capacity = self.config.runtime.adapter_row_capacity
+        if (
+            planned_row_capacity is not None
+            and int(planned_row_capacity) != row_capacity
+        ):
+            raise ValueError(
+                "tail adaptation row-capacity contract changed after pre-KV "
+                f"sizing: planned {planned_row_capacity}, runtime {row_capacity}"
+            )
+        telemetry_path = self.config.trace.telemetry_path or str(
+            Path(self.config.trace.artifact_root)
+            / (
+                f"adaptation-telemetry-{self.algorithm.lower()}-p{os.getpid()}-"
+                f"r{self.tp_rank}.jsonl"
+            )
+        )
+        telemetry = TelemetrySink(telemetry_path)
+        self.runtime = AdaptationRuntime(
+            config=self.config,
+            method_factory=lambda: build_method(
+                self.config,
+                shapes,
+                basis_dev,
+                controller_artifact=artifact,
+                parameter_layout_sha256=self.parameter_layout_sha256,
+            ),
+            shapes=shapes,
+            basis=basis_dev,
+            telemetry=telemetry,
+            num_slots=num_slots,
+            device=self.device,
+            distance_weights=(artifact.distance_weights if artifact else None),
+            zvectorizer=(artifact.zvectorizer if artifact else None),
+            constant_controller_delay=constant_delay,
+            parameter_layout_sha256=self.parameter_layout_sha256,
+            enable_replay_writer=self.tp_rank == 0,
+            forward_dtype=self._forward_dtype,
+            gradient_consensus_fn=(
+                partial(tp_gradient_consensus, tp_size=self.tp_size)
+                if self.tp_size > 1
+                else None
+            ),
+        )
+
+        supervision_fanout_bytes = 0
+        if self.algorithm == "DFLASH":
+            supervision_fanout_bytes = estimate_dflash_supervision_fanout_bytes(
+                batch_capacity=row_capacity,
+                active_capacity=min(num_slots, row_capacity),
+                vocab_size=vocab_size,
+                hidden_size=hidden_size,
+                draft_depth=draft_depth,
+                forward_dtype_bytes=self._forward_dtype.itemsize,
+                output_residual=mode == "output_residual",
+                stochastic=float(self.config.sampling.temperature) > 0.0,
+                tensor_parallel_size=self.tp_size,
+                trace_capture=self.config.trace.trace_capture_max_bytes > 0,
+            )
+        ledger = estimate_adaptation_memory(
+            num_slots=num_slots,
+            max_in_flight=self.config.async_.max_in_flight,
+            num_params=shapes.num_params(),
+            vocab_size=vocab_size,
+            rank=rank,
+            markov_dim=0,
+            hidden_size=hidden_size,
+            draft_depth=draft_depth,
+            adapter_row_capacity=row_capacity,
+            with_optimizer=self.config.optimizer == "adamw",
+            with_fisher=self.config.method == "lc_transport",
+            with_optimizer_preview=self.config.method == "lc_transport",
+            retain_source_signal=self.config.method == "onlinespec_ens",
+            trace_capture=self.config.trace.trace_capture_max_bytes > 0,
+            safety_factor=self.config.runtime.memory_safety_factor,
+            calibrated_reserve_mb=self.config.runtime.calibrated_reserve_mb,
+            enabled=True,
+            weight_update_mode=mode,
+            forward_dtype_bytes=self._forward_dtype.itemsize,
+            supervision_fanout_bytes=supervision_fanout_bytes,
+        )
+        self.memory_ledger = ledger
+        current_reserve = int(
+            getattr(worker.server_args, "speculative_adaptation_reserve_mb", 0)
+            or 0
+        )
+        worker.server_args.override(
+            "lightcone.tail_adaptation_memory",
+            speculative_adaptation_reserve_mb=max(
+                current_reserve,
+                self.memory_ledger.reserve_mb,
+            ),
+        )
+        self._write_memory_ledger(num_slots=num_slots, row_capacity=row_capacity)
+
+        # These buffers are process-lifetime allocations.  CUDA graphs capture
+        # their addresses; publication only changes their contents at a legal
+        # backend boundary.
+        self.adapter_rows = torch.zeros(
+            row_capacity,
+            shapes.num_params(),
+            dtype=self._forward_dtype,
+            device=self.device,
+        )
+        self._row_slot_indices = torch.zeros(
+            row_capacity,
+            dtype=torch.int64,
+            device=self.device,
+        )
+        pin = self.device.startswith("cuda")
+        self._row_slot_indices_cpu = torch.zeros(
+            row_capacity,
+            dtype=torch.int64,
+            pin_memory=pin,
+        )
+        self._row_enabled = torch.ones(
+            row_capacity,
+            dtype=self._forward_dtype,
+            device=self.device,
+        )
+        self._row_enabled_cpu = torch.ones(
+            row_capacity,
+            dtype=self._forward_dtype,
+            pin_memory=pin,
+        )
+        self._adapter_signature: Optional[tuple[tuple[int, int], ...]] = None
+
+        self._round_of: dict[str, int] = {}
+        self._round_t0: dict[str, float] = {}
+        self._pinned_versions: dict[str, int] = {}
+        # CUDA new-sequence lengths are copied to pinned host storage at
+        # verify/commit time and consumed at the next legal publication
+        # boundary.  Keeping the whole RoundCommitted hook pending (instead of
+        # merely fixing telemetry later) guarantees controller delay features
+        # and replay labels see the same exact prefix as the scheduler.
+        self._pending_round_commits: dict[str, list[dict]] = {}
+        self._prefix_blocked_rounds: set[tuple[str, int]] = set()
+        self._disabled: set[str] = set()
+        self._fallback_counts: dict[str, int] = {}
+        self._batch = None
+        self._batch_capture_enabled = False
+        self._source_versions_tensor: Optional[torch.Tensor] = None
+        self._eagle_capture: dict[str, dict[int, dict[str, torch.Tensor]]] = {}
+        self._dflash_proposal = None
+        self._dflash_accept = None
+        self._algorithmic_censored = None
+        self._dflash_target_logits = None
+        self._dflash_target_hidden = None
+        self._batch_timing: dict[str, torch.cuda.Event] = {}
+        self._batch_cpu_timing: dict[str, float] = {}
+        self._telemetry_lanes = (
+            CudaTelemetryLanePool(
+                device=self.device,
+                max_batch_size=row_capacity,
+                event_names=(
+                    "draft_start",
+                    "draft_end",
+                    "verify_end",
+                    "accept_end",
+                    "signal_prep_start",
+                    "signal_prep_end",
+                    "telemetry_ready",
+                ),
+                host_names=("new_seq", "algorithmic_censored"),
+            )
+            if self.device.startswith("cuda")
+            else None
+        )
+        self._batch_telemetry_lane: Optional[int] = None
+        # Trace retention is decided once per request/round.  In TP runs rank 0
+        # owns the replay quota, then broadcasts the Python decision so every
+        # rank takes the same eager/graph branch and enters the same collectives.
+        self._capture_decisions: dict[tuple[str, int], bool] = {}
+
+        logger.info(
+            "LightCone tail adaptation enabled: backend=%s method=%s mode=%s "
+            "layout=%s telemetry=%s",
+            self.algorithm,
+            self.config.method,
+            mode,
+            self.parameter_layout_sha256,
+            telemetry_path,
+        )
+
+    # ------------------------------------------------------------------
+    # Construction and artifact identity
+    # ------------------------------------------------------------------
+
+    def _resolve_proposal_head(self, worker):
+        if self.algorithm == "DFLASH" or self.algorithm == "EAGLE":
+            model = worker.target_worker.model_runner.model
+        else:
+            model = worker.draft_worker.draft_runner.model
+        head = getattr(model, "lm_head", None)
+        if head is None or not hasattr(head, "weight"):
+            raise RuntimeError(
+                f"{self.algorithm} tail adaptation cannot resolve proposal lm_head"
+            )
+        return head
+
+    @staticmethod
+    def _resolve_vocab_size(worker, lm_head) -> int:
+        value = getattr(lm_head, "org_vocab_size", None)
+        if value is None:
+            value = getattr(worker.target_worker.model_config, "vocab_size", None)
+        if value is None:
+            value = lm_head.weight.shape[0]
+        return int(value)
+
+    def _resolve_draft_depth(self, worker) -> int:
+        if self.algorithm == "DFLASH":
+            depth = int(worker.block_size) - 1
+            if depth <= 0:
+                raise ValueError(
+                    "DFLASH tail adaptation requires block_size >= 2"
+                )
+            return depth
+        # EAGLE's public draft width includes the proposal produced by the
+        # preceding verify plus the internal extend steps.  ``num_steps`` is
+        # only the latter, so using it here under-counts proposal/verify rows
+        # by one and corrupts both telemetry and resident-memory sizing.
+        return max(int(worker.speculative_num_draft_tokens), 1)
+
+    @staticmethod
+    def _row_capacity(worker, num_slots: int) -> int:
+        from lightcone_spec.sglang_bridge.bank import (
+            resolve_adapter_row_capacity,
+        )
+
+        decode = getattr(worker.server_args.cuda_graph_config, "decode", None)
+        graph_bs = getattr(decode, "bs", ())
+        capacity = resolve_adapter_row_capacity(
+            max_running_requests=int(
+                getattr(worker.server_args, "max_running_requests", 0)
+                or num_slots
+            ),
+            cuda_graph_max_bs_decode=getattr(decode, "max_bs", None),
+            cuda_graph_batch_sizes=graph_bs,
+        )
+        return capacity
+
+    def _load_or_build_output_basis(
+        self,
+        *,
+        proposal_head,
+        vocab_size: int,
+        hidden_projection,
+        build_output_basis,
+        load_projection_artifact,
+        save_projection_artifact,
+    ) -> tuple[torch.Tensor, dict]:
+        import numpy as np
+
+        configured = self.config.model.projection_artifact_path
+        if configured is not None:
+            configured = configured.format(rank=self.tp_rank)
+        path = Path(
+            configured
+            or (
+                Path(self.config.trace.artifact_root)
+                / "projections"
+                / (
+                    f"{self.config.model.pair_id}-{self.algorithm.lower()}-"
+                    f"r{self.config.adapter_rank}-tp{self.tp_rank}.npz"
+                )
+            )
+        )
+        identity = {
+            "schema_version": 1,
+            "pair_id": self.config.model.pair_id,
+            "algorithm": self.algorithm,
+            "target_revision": self.config.model.target_revision,
+            "drafter_revision": self.config.model.drafter_revision,
+            "adapter_rank": int(self.config.adapter_rank),
+            "tensor_parallel_rank": int(self.tp_rank),
+            "tensor_parallel_size": int(self.tp_size),
+            "hidden_size": int(proposal_head.weight.shape[1]),
+            "vocab_size": int(vocab_size),
+        }
+        if path.is_file() or Path(str(path) + ".npz").is_file():
+            arrays, metadata = load_projection_artifact(path)
+            for key, expected in identity.items():
+                if metadata.get(key) != expected:
+                    raise RuntimeError(
+                        "tail projection artifact identity mismatch for "
+                        f"{key}: {metadata.get(key)!r} != {expected!r}"
+                    )
+            basis = torch.from_numpy(arrays["output_basis"].astype(np.float32))
+            if basis.shape != (vocab_size, self.config.adapter_rank):
+                raise RuntimeError(
+                    "tail projection basis shape mismatch: "
+                    f"{tuple(basis.shape)} != "
+                    f"{(vocab_size, self.config.adapter_rank)}"
+                )
+            return basis, metadata
+
+        weight = proposal_head.weight.detach()
+        if self.tp_size > 1:
+            from sglang.srt.distributed.communication_op import (
+                tensor_model_parallel_all_gather,
+            )
+
+            weight = tensor_model_parallel_all_gather(weight, dim=0)
+        weight_np = weight[:vocab_size].float().cpu().numpy()
+        # DFlash/EAGLE have no Markov output.  The shared deterministic basis
+        # constructor accepts an empty second block and performs the SVD of
+        # colnorm(W R_h) only.
+        empty_markov = np.empty((vocab_size, 0), dtype=np.float32)
+        output = build_output_basis(
+            weight_np,
+            empty_markov,
+            hidden_projection,
+            rank=int(self.config.adapter_rank),
+        )
+        metadata = {
+            **identity,
+            "basis_input_sha256": output.input_sha256,
+            "basis_sha256": output.sha256(),
+            "hidden_projection_seed": 0,
+        }
+        save_projection_artifact(
+            path,
+            {
+                "hidden_projection": hidden_projection,
+                "output_basis": output.basis,
+            },
+            metadata,
+        )
+        # Use the persisted metadata (which includes file/array hashes) for the
+        # layout identity on both the first and every subsequent process.
+        _, metadata = load_projection_artifact(path)
+        logger.warning(
+            "built %s output-residual projection at startup and cached %s; "
+            "pre-create it for latency-sensitive launches",
+            self.algorithm,
+            path,
+        )
+        return torch.from_numpy(output.basis), metadata
+
+    def _write_memory_ledger(self, *, num_slots: int, row_capacity: int) -> None:
+        path = Path(self.config.trace.artifact_root) / (
+            f"adaptation-memory-{self.algorithm.lower()}-p{os.getpid()}-"
+            f"r{self.tp_rank}.json"
+        )
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(
+            json.dumps(
+                {
+                    "schema_version": 1,
+                    "algorithm": self.algorithm,
+                    "weight_update_mode": self.config.weight_update_mode,
+                    "parameter_scope": self.config.parameter_scope,
+                    "tail_layout_mode": self.shapes.mode,
+                    "resolved_rank": self.config.effective_adapter_rank,
+                    "num_slots": num_slots,
+                    "adapter_row_capacity": row_capacity,
+                    "num_params": self.shapes.num_params(),
+                    "fixed_bytes": self.memory_ledger.fixed_bytes,
+                    "transient_bytes": self.memory_ledger.transient_bytes,
+                    "reserve_bytes": self.memory_ledger.reserve_bytes,
+                    "reserve_mb": self.memory_ledger.reserve_mb,
+                    "categories": self.memory_ledger.category_bytes(),
+                    "headroom_breakdown": (
+                        self.memory_ledger.headroom_breakdown()
+                    ),
+                    "parameter_layout_sha256": self.parameter_layout_sha256,
+                    "parameter_layout_identity": self.parameter_layout_identity,
+                    # Both generic backends bind controller/replay features to
+                    # the exact committed prefix.  CUDA lengths are finalized
+                    # from an event-guarded pinned copy before publication; an
+                    # unready request is skipped rather than approximated.
+                    "prefix_feature_exact": True,
+                    "cpu_offload": False,
+                    "evictable": False,
+                },
+                sort_keys=True,
+            )
+            + "\n"
+        )
+
+    # ------------------------------------------------------------------
+    # Request lifecycle and fixed-row publication
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _tenant_hash(req) -> str:
+        value = str(getattr(req, "session_id", None) or "tenant-0")
+        return hashlib.sha256(value.encode()).hexdigest()[:16]
+
+    def begin_requests(self, batch) -> None:
+        for req in batch.reqs:
+            rid = req.rid
+            if rid in self._round_of or rid in self._disabled:
+                continue
+            try:
+                self.runtime.on_request_lifecycle(
+                    self._H.RequestLifecycle(
+                        request_id=rid,
+                        event=(
+                            "stream_begin"
+                            if self.config.lifecycle == "stream"
+                            and getattr(req, "session_id", None)
+                            else "begin"
+                        ),
+                        request_epoch=0,
+                        slot_index=-1,
+                        stream_id=getattr(req, "session_id", None),
+                        tenant_id_hash=self._tenant_hash(req),
+                    )
+                )
+            except self._CapacityError as exc:
+                self._disable(rid, "adapter_slots_exhausted", exc)
+                continue
+            except self._ExactnessViolation as exc:
+                self._disable(rid, "exactness", exc)
+                continue
+            except torch.cuda.OutOfMemoryError as exc:
+                self._disable(rid, "adaptation_cuda_oom", exc)
+                continue
+            self._round_of[rid] = 0
+            self._round_t0[rid] = time.monotonic() * 1e6
+
+    def finish_request(self, *, rid: str, natural_stop: bool = True) -> None:
+        del natural_stop
+        # There is no next proposal boundary after the final verify.  Drain
+        # the exact pinned prefix/count copy here before freeing the runtime
+        # slot, otherwise the last (or several previously blocked) rounds are
+        # silently absent from telemetry and controller traces.  This is a
+        # request-termination boundary, never the decode hot path.
+        pending = self._pending_round_commits.get(rid, ())
+        try:
+            for item in pending:
+                ready = item.get("ready")
+                if ready is not None and not ready.query():
+                    ready.synchronize()
+            if pending and not self._finalize_pending_rounds(rid):
+                raise RuntimeError(
+                    "exact final RoundCommitted materialization was rejected"
+                )
+        except Exception as exc:
+            logger.error(
+                "tail adaptation final round drain failed for %s: %s", rid, exc
+            )
+            self._disable(rid, "telemetry_finalize", exc)
+        if rid in self.runtime.requests:
+            ctx = self.runtime.requests[rid]
+            try:
+                self.runtime.on_request_lifecycle(
+                    self._H.RequestLifecycle(
+                        request_id=rid,
+                        event=(
+                            "stream_end"
+                            if self.config.lifecycle == "stream" and ctx.stream_id
+                            else "end"
+                        ),
+                        request_epoch=ctx.request_epoch,
+                        slot_index=ctx.slot_index,
+                        stream_id=ctx.stream_id,
+                        tenant_id_hash=ctx.tenant_id_hash,
+                    )
+                )
+            except (self._ExactnessViolation, torch.cuda.OutOfMemoryError) as exc:
+                logger.error("tail adaptation request cleanup failed for %s: %s", rid, exc)
+        self._round_of.pop(rid, None)
+        self._round_t0.pop(rid, None)
+        self._pinned_versions.pop(rid, None)
+        self._pending_round_commits.pop(rid, None)
+        for key in tuple(self._prefix_blocked_rounds):
+            if key[0] == rid:
+                self._prefix_blocked_rounds.discard(key)
+        self._eagle_capture.pop(rid, None)
+        for key in tuple(self._capture_decisions):
+            if key[0] == rid:
+                self._capture_decisions.pop(key, None)
+        self._disabled.discard(rid)
+        self._adapter_signature = None
+
+    def _disable(self, rid: str, reason: str, exc: Exception) -> None:
+        """Fail open to the frozen speculative backend for one request."""
+
+        if rid in self._disabled:
+            return
+        self._disabled.add(rid)
+        self._adapter_signature = None
+        self._fallback_counts[reason] = self._fallback_counts.get(reason, 0) + 1
+        level = logger.error if reason == "exactness" else logger.warning
+        level(
+            "%s tail adaptation disabled for request %s (%s): %s",
+            self.algorithm,
+            rid,
+            reason,
+            exc,
+        )
+        try:
+            from lightcone_spec.sglang_bridge.telemetry import UpdateTelemetry
+
+            self.runtime.telemetry.emit(
+                "update",
+                UpdateTelemetry(
+                    request_id=rid,
+                    update_id=f"{rid}-fallback",
+                    source_round=self._round_of.get(rid, -1),
+                    source_version=self._pinned_versions.get(rid, -1),
+                    snapshot_ts_us=time.monotonic() * 1e6,
+                    decision="discard",
+                    failure_reason=f"fallback:{reason}:{exc}",
+                ),
+            )
+        except Exception:
+            logger.exception("failed to record tail adaptation fallback for %s", rid)
+        self.runtime.cancel_pending(rid)
+
+    def _guard(self, rid: str, fn):
+        if rid in self._disabled:
+            return None
+        try:
+            return fn()
+        except self._ExactnessViolation as exc:
+            self._disable(rid, "exactness", exc)
+        except torch.cuda.OutOfMemoryError as exc:
+            self._disable(rid, "adaptation_cuda_oom", exc)
+        return None
+
+    def activate_step_by_batch(self, batch_size: int) -> None:
+        del batch_size
+
+    def record_stage(self, name: str) -> None:
+        """Record one lightweight CUDA stage boundary without synchronizing."""
+
+        if name not in ("draft_start", "draft_end", "verify_end", "accept_end"):
+            raise ValueError(f"unknown tail timing stage {name!r}")
+        self._batch_cpu_timing[name] = time.monotonic() * 1e6
+        if not self.device.startswith("cuda"):
+            return
+        if name == "draft_start":
+            if self._batch_telemetry_lane is not None:
+                raise RuntimeError("tail telemetry batch lane was not retired")
+            assert self._telemetry_lanes is not None
+            self._batch_telemetry_lane = self._telemetry_lanes.acquire()
+        lane = self._batch_telemetry_lane
+        if lane is None or self._telemetry_lanes is None:
+            raise RuntimeError(f"tail timing stage {name!r} has no telemetry lane")
+        event = self._telemetry_lanes.event(lane, name)
+        event.record(torch.cuda.current_stream(self.device))
+        self._batch_timing[name] = event
+
+    def _ctx(self, rid: str):
+        return self.runtime.requests[rid]
+
+    def _poll_ready(self, batch, *, skip_rids: frozenset[str] = frozenset()) -> None:
+        for req in batch.reqs:
+            rid = req.rid
+            if (
+                rid in skip_rids
+                or rid in self._disabled
+                or rid not in self.runtime.requests
+            ):
+                continue
+            ctx = self._ctx(rid)
+            self._guard(
+                rid,
+                lambda rid=rid, ctx=ctx: self.runtime.on_update_poll(
+                    self._H.UpdatePollPoint(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        request_epoch=ctx.request_epoch,
+                        slot_index=ctx.slot_index,
+                        active_version=self.runtime.bank.slots[
+                            ctx.slot_index
+                        ].active_version,
+                    )
+                ),
+            )
+
+    def _prepare_rows(self, batch) -> None:
+        bs = len(batch.reqs)
+        if bs > self.adapter_rows.shape[0]:
+            raise RuntimeError(
+                f"tail adaptation batch {bs} exceeds row capacity "
+                f"{self.adapter_rows.shape[0]}"
+            )
+        signature: list[tuple[int, int]] = []
+        for req in batch.reqs:
+            ctx = self.runtime.requests.get(req.rid)
+            if ctx is None or req.rid in self._disabled:
+                signature.append((-1, -1))
+                continue
+            slot = self.runtime.bank.slots[ctx.slot_index]
+            signature.append((ctx.slot_index, slot.active_version))
+        signature_t = tuple(signature)
+        if signature_t == self._adapter_signature:
+            return
+        rows = self.adapter_rows[:bs]
+        enabled = 0
+        for index, (slot_index, _version) in enumerate(signature_t):
+            active = slot_index >= 0 and self.runtime.bank.slots[
+                slot_index
+            ].active_has_effect
+            self._row_slot_indices_cpu[index] = max(slot_index, 0)
+            self._row_enabled_cpu[index] = float(active)
+            enabled += int(active)
+        if not enabled:
+            rows.zero_()
+            self._adapter_signature = signature_t
+            return
+        indices = self._row_slot_indices[:bs]
+        indices.copy_(self._row_slot_indices_cpu[:bs], non_blocking=True)
+        bank = self.runtime.bank
+        # Current AdapterBank instances expose a model-dtype forward bank,
+        # while legacy/rebind-only protocol doubles expose only the canonical
+        # ``active`` tensor.  Prefer the graph-visible bank in production, but
+        # keep row ownership/rebinding independent of that storage detail.
+        forward_active = getattr(bank, "forward_active", None)
+        if forward_active is None:
+            forward_active = bank.active
+        torch.index_select(forward_active, 0, indices, out=rows)
+        mask = self._row_enabled[:bs]
+        mask.copy_(self._row_enabled_cpu[:bs], non_blocking=True)
+        rows.mul_(mask[:, None])
+        self._adapter_signature = signature_t
+
+    def _pin_versions(self, batch) -> torch.Tensor:
+        values: list[int] = []
+        for req in batch.reqs:
+            ctx = self.runtime.requests.get(req.rid)
+            version = (
+                0
+                if ctx is None or req.rid in self._disabled
+                else int(self.runtime.bank.slots[ctx.slot_index].active_version)
+            )
+            self._pinned_versions[req.rid] = version
+            values.append(version)
+        # Proposal state owns this small tensor.  It may be filtered/merged by
+        # overlap scheduling and therefore must not alias a mutable batch buffer.
+        versions = torch.tensor(values, dtype=torch.int64, device=self.device)
+        self._source_versions_tensor = versions
+        return versions
+
+    def _validate_version_tensor(self, batch, versions: torch.Tensor) -> None:
+        if (
+            not torch.is_tensor(versions)
+            or versions.dtype != torch.int64
+            or versions.ndim != 1
+            or int(versions.numel()) != len(batch.reqs)
+            or versions.device != self.adapter_rows.device
+        ):
+            raise self._ExactnessViolation(
+                "proposal/source adapter versions must be a same-device, "
+                "one-dimensional int64 tensor with one value per request"
+            )
+        # Values are a graph/kernel canary, never the source of row ownership.
+        # The authoritative pin is the host ``rid -> version`` map created at
+        # the legal publication boundary. ``assert_pinned`` checks that map
+        # against each request's host active version and then rebinds rows by
+        # current rid order. Avoiding an uncatchable CUDA device assertion keeps
+        # a malformed evidence tensor from poisoning the whole worker.
+
+    def _validate_or_disable_batch(self, batch, versions: torch.Tensor) -> bool:
+        try:
+            self._validate_version_tensor(batch, versions)
+            return True
+        except self._ExactnessViolation as exc:
+            for req in batch.reqs:
+                self._disable(req.rid, "exactness", exc)
+            return False
+
+    # ------------------------------------------------------------------
+    # Shared tail math
+    # ------------------------------------------------------------------
+
+    def _delta_hidden(self, hidden: torch.Tensor, rows: torch.Tensor) -> torch.Tensor:
+        n = hidden.shape[0]
+        h = hidden.to(rows.dtype).view(n, 1, self.shapes.hidden_size)
+        if self.shapes.mode == "tail_lora":
+            a_h = rows[:, self._slices["a_h"]].view(
+                n,
+                self.shapes.hidden_size,
+                self.shapes.rank,
+            )
+            b_h = rows[:, self._slices["b_h"]].view(
+                n,
+                self.shapes.rank,
+                self.shapes.hidden_size,
+            )
+            return torch.bmm(torch.bmm(h, a_h), b_h).squeeze(1)
+        d_h = rows[:, self._slices["d_h"]].view(
+            n,
+            self.shapes.hidden_size,
+            self.shapes.hidden_size,
+        )
+        return torch.bmm(h, d_h).squeeze(1)
+
+    def _delta_hidden_grouped(
+        self, hidden: torch.Tensor, rows: torch.Tensor
+    ) -> torch.Tensor:
+        """Batched ``[B,K,d]`` hidden-tail GEMM without parameter expansion."""
+
+        h = hidden.to(rows.dtype)
+        batch_size = h.shape[0]
+        if self.shapes.mode == "tail_lora":
+            a_h = rows[:, self._slices["a_h"]].view(
+                batch_size,
+                self.shapes.hidden_size,
+                self.shapes.rank,
+            )
+            b_h = rows[:, self._slices["b_h"]].view(
+                batch_size,
+                self.shapes.rank,
+                self.shapes.hidden_size,
+            )
+            return torch.bmm(torch.bmm(h, a_h), b_h)
+        d_h = rows[:, self._slices["d_h"]].view(
+            batch_size,
+            self.shapes.hidden_size,
+            self.shapes.hidden_size,
+        )
+        return torch.bmm(h, d_h)
+
+    def _output_residual(
+        self,
+        hidden: torch.Tensor,
+        rows: torch.Tensor,
+        basis: torch.Tensor,
+    ) -> torch.Tensor:
+        n = hidden.shape[0]
+        if self._r_h_forward is None:
+            raise RuntimeError("output-residual forward projection is unavailable")
+        u = hidden.to(self._r_h_forward.dtype) @ self._r_h_forward
+        a_h = rows[:, self._slices["a_h"]].view(
+            n,
+            self.shapes.rank,
+            128,
+        )
+        coefficients = torch.bmm(
+            u.unsqueeze(1), a_h.transpose(1, 2)
+        ).squeeze(1)
+        return coefficients.to(basis.dtype) @ basis.T
+
+    def _output_residual_grouped(
+        self,
+        hidden: torch.Tensor,
+        rows: torch.Tensor,
+        basis: torch.Tensor,
+    ) -> torch.Tensor:
+        if self._r_h_forward is None:
+            raise RuntimeError("output-residual forward projection is unavailable")
+        batch_size = hidden.shape[0]
+        u = hidden.to(self._r_h_forward.dtype) @ self._r_h_forward
+        a_h = rows[:, self._slices["a_h"]].view(
+            batch_size,
+            self.shapes.rank,
+            128,
+        )
+        coefficients = torch.bmm(u, a_h.transpose(1, 2))
+        return coefficients.to(basis.dtype) @ basis.T
+
+    def _dflash_delta_logits(
+        self,
+        hidden_states: torch.Tensor,
+        *,
+        row_start: int,
+        rows_per_request: int,
+        vocab_start: int,
+        vocab_end: int,
+    ) -> torch.Tensor:
+        """Request-grouped DFlash tail math (at most three batched pieces).
+
+        In particular, full-rank parameters are never expanded to one copy per
+        draft token.  A normal request-major block is a single batched GEMM;
+        a sampler chunk crossing request boundaries becomes leading/middle/
+        trailing pieces only.
+        """
+
+        if hidden_states.ndim != 2:
+            raise ValueError(
+                "DFLASH tail hidden states must be a two-dimensional tensor"
+            )
+        if int(hidden_states.shape[1]) != self.shapes.hidden_size:
+            raise ValueError(
+                "DFLASH tail hidden size mismatch: "
+                f"{hidden_states.shape[1]} != {self.shapes.hidden_size}"
+            )
+        total = int(hidden_states.shape[0])
+        depth = int(rows_per_request)
+        global_start = int(row_start)
+        vocab_start = int(vocab_start)
+        vocab_end = int(vocab_end)
+        if depth <= 0:
+            raise ValueError("DFLASH rows_per_request must be positive")
+        if global_start < 0:
+            raise ValueError("DFLASH row_start must be non-negative")
+        if not 0 <= vocab_start <= vocab_end <= self.shapes.vocab_size:
+            raise ValueError(
+                "DFLASH proposal vocabulary range is outside the global vocabulary: "
+                f"[{vocab_start}, {vocab_end}) vs {self.shapes.vocab_size}"
+            )
+        if total == 0:
+            return hidden_states.new_empty((0, vocab_end - vocab_start))
+        last_request = (global_start + total - 1) // depth
+        if last_request >= int(self.adapter_rows.shape[0]):
+            raise RuntimeError(
+                "DFLASH tail row buffer is smaller than the proposal request range: "
+                f"last_request={last_request}, capacity={self.adapter_rows.shape[0]}"
+            )
+        cursor = 0
+        pieces: list[torch.Tensor] = []
+
+        def run_piece(
+            hidden: torch.Tensor,
+            request_start: int,
+            requests: int,
+            tokens_per_request: int,
+        ) -> torch.Tensor:
+            grouped = hidden.reshape(
+                requests,
+                tokens_per_request,
+                self.shapes.hidden_size,
+            )
+            rows = self.adapter_rows[request_start : request_start + requests]
+            if self.shapes.mode == "output_residual":
+                assert self._basis_forward is not None
+                basis = self._basis_forward[vocab_start:vocab_end]
+                delta = self._output_residual_grouped(grouped, rows, basis)
+            else:
+                delta_hidden = self._delta_hidden_grouped(grouped, rows)
+                delta = self._projection.project_hidden_range(
+                    delta_hidden.reshape(-1, self.shapes.hidden_size),
+                    vocab_start=vocab_start,
+                    vocab_end=vocab_end,
+                ).view(requests, tokens_per_request, -1)
+            return delta.reshape(-1, delta.shape[-1])
+
+        offset = global_start % depth
+        if offset:
+            count = min(total, depth - offset)
+            request = global_start // depth
+            # A partial request still uses one row and one batched GEMM.
+            pieces.append(
+                run_piece(
+                    hidden_states[:count],
+                    request,
+                    1,
+                    count,
+                )
+            )
+            cursor += count
+            global_start += count
+
+        remaining = total - cursor
+        full_requests = remaining // depth
+        if full_requests:
+            count = full_requests * depth
+            request = global_start // depth
+            pieces.append(
+                run_piece(
+                    hidden_states[cursor : cursor + count],
+                    request,
+                    full_requests,
+                    depth,
+                )
+            )
+            cursor += count
+            global_start += count
+
+        if cursor < total:
+            count = total - cursor
+            request = global_start // depth
+            pieces.append(
+                run_piece(
+                    hidden_states[cursor:],
+                    request,
+                    1,
+                    count,
+                )
+            )
+        return pieces[0] if len(pieces) == 1 else torch.cat(pieces, dim=0)
+
+    # ------------------------------------------------------------------
+    # DFlash protocol
+    # ------------------------------------------------------------------
+
+    def before_draft(self, batch, prefix_lens) -> None:
+        self.begin_requests(batch)
+        self._batch_timing = {}
+        self._batch_cpu_timing = {}
+        self.record_stage("draft_start")
+        prefix_by_rid: dict[str, int] = {}
+        blocked: set[str] = set()
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            key = (rid, self._round_of.get(rid, -1))
+            if rid in self._disabled or key in self._prefix_blocked_rounds:
+                continue
+            try:
+                prefix = self._host_prefix_len(prefix_lens, batch, index)
+            except RuntimeError as exc:
+                logger.warning("DFLASH exact prefix unavailable for %s: %s", rid, exc)
+                blocked.add(rid)
+                continue
+            prefix_by_rid[rid] = prefix
+            if not self._finalize_pending_rounds(
+                rid, prefix_override=prefix
+            ):
+                blocked.add(rid)
+                continue
+            # ArrivalContext is constructed by _poll_ready below.  Bind the
+            # scheduler's exact host prefix first so delay_tokens/controller
+            # features never observe the preceding round's value.
+            self._ctx(rid).prefix_len = prefix
+        self._poll_ready(batch, skip_rids=frozenset(blocked))
+        self._prepare_rows(batch)
+        self._batch = batch
+        # Materialize every request decision before reducing it.  ``any`` over
+        # a generator short-circuits and would make the number of TP broadcast
+        # collectives depend on which request first consumes the trace quota.
+        capture_decisions = []
+        for req in batch.reqs:
+            rid = req.rid
+            key = (rid, self._round_of.get(rid, -1))
+            if rid in blocked:
+                self._prefix_blocked_rounds.add(key)
+                self._capture_decisions[key] = False
+                capture_decisions.append(False)
+            else:
+                self._prefix_blocked_rounds.discard(key)
+                capture_decisions.append(self._capture_round(rid))
+        self._batch_capture_enabled = any(capture_decisions)
+        versions = self._pin_versions(batch)
+        del versions
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled or rid in blocked:
+                continue
+            prefix = prefix_by_rid[rid]
+            ctx = self._ctx(rid)
+            ctx.round_id = self._round_of[rid]
+            self._guard(
+                rid,
+                lambda rid=rid, ctx=ctx, prefix=prefix: (
+                    self.runtime.on_draft_inputs_ready(
+                        self._H.DraftInputsReady(
+                            request_id=rid,
+                            round_id=self._round_of[rid],
+                            request_epoch=ctx.request_epoch,
+                            slot_index=ctx.slot_index,
+                            active_version=self._pinned_versions[rid],
+                            prefix_len=prefix,
+                        )
+                    )
+                ),
+            )
+            if rid in self._disabled:
+                self.adapter_rows[index].zero_()
+
+    def source_adapter_versions(self, batch) -> torch.Tensor:
+        versions = self._source_versions_tensor
+        if versions is None or int(versions.numel()) != len(batch.reqs):
+            raise RuntimeError("DFLASH source versions were not pinned before draft")
+        return versions
+
+    def capture_proposal_signals(self, batch) -> bool:
+        del batch
+        return self._batch_capture_enabled
+
+    def correct_draft_logits(
+        self,
+        *,
+        hidden_states: torch.Tensor,
+        raw_logits: torch.Tensor,
+        row_start: int,
+        rows_per_request: int,
+        vocab_start: int,
+        vocab_end: int,
+        graph_capture: bool,
+    ) -> torch.Tensor:
+        del graph_capture
+        if rows_per_request <= 0:
+            raise ValueError("DFLASH rows_per_request must be positive")
+        # Request grouping is derived from the configured depth.  A runtime
+        # depth drift would bind token rows to the wrong parameter row.
+        if int(rows_per_request) != self.shapes.draft_depth:
+            raise RuntimeError(
+                "DFLASH proposal depth changed after adaptation initialization: "
+                f"{rows_per_request} != {self.shapes.draft_depth}"
+            )
+        with torch.profiler.record_function("lightcone::tail_forward_dflash"):
+            delta = self._dflash_delta_logits(
+                hidden_states,
+                row_start=int(row_start),
+                rows_per_request=int(rows_per_request),
+                vocab_start=int(vocab_start),
+                vocab_end=int(vocab_end),
+            )
+        return raw_logits + delta.to(raw_logits.dtype)
+
+    def after_proposal(self, batch, proposal) -> None:
+        self.record_stage("draft_end")
+        if not self._validate_or_disable_batch(
+            batch, proposal.source_adapter_versions
+        ):
+            return
+        self._dflash_proposal = proposal
+        for req in batch.reqs:
+            key = (req.rid, self._round_of.get(req.rid, -1))
+            if req.rid in self._disabled or key in self._prefix_blocked_rounds:
+                continue
+            version = self._pinned_versions[req.rid]
+            self._guard(
+                req.rid,
+                lambda req=req, version=version: self.runtime.on_proposal_ready(
+                    self._H.ProposalReady(
+                        request_id=req.rid,
+                        round_id=self._round_of[req.rid],
+                        proposal_version=version,
+                    )
+                ),
+            )
+
+    def _after_dflash_verify(self, batch, target_logits, hidden_states) -> None:
+        self.record_stage("verify_end")
+        self._dflash_target_logits = target_logits
+        self._dflash_target_hidden = hidden_states
+        self._emit_verify_hooks(batch, target_logits, hidden_states)
+
+    def after_accept(self, batch, accept) -> None:
+        self._dflash_accept = accept
+        self.record_stage("accept_end")
+        self._emit_accept_hooks(batch)
+
+    def maybe_launch_updates(self, batch, target_logits, proposal) -> None:
+        if proposal is None or target_logits is None:
+            return
+        if not self.device.startswith("cuda"):
+            self._launch_dflash_signals(batch, target_logits, proposal)
+            return
+        lane = self._batch_telemetry_lane
+        if lane is None or self._telemetry_lanes is None:
+            raise RuntimeError("DFLASH signal preparation has no telemetry lane")
+        stream = torch.cuda.current_stream(self.device)
+        start = self._telemetry_lanes.event(lane, "signal_prep_start")
+        end = self._telemetry_lanes.event(lane, "signal_prep_end")
+        start.record(stream)
+        self._batch_timing["signal_prep_start"] = start
+        try:
+            self._launch_dflash_signals(batch, target_logits, proposal)
+        finally:
+            # This event is only materialized by the telemetry worker after
+            # ``telemetry_ready``; the decode thread never synchronizes it.
+            end.record(stream)
+            self._batch_timing["signal_prep_end"] = end
+
+    def after_commit(self, batch, new_seq_lens) -> None:
+        self._emit_round_committed(batch, new_seq_lens)
+
+    def poll_updates(self, batch) -> None:
+        for req in batch.reqs:
+            if req.rid in self._round_of:
+                old_key = (req.rid, self._round_of[req.rid])
+                self._capture_decisions.pop(old_key, None)
+                self._prefix_blocked_rounds.discard(old_key)
+                self._round_of[req.rid] += 1
+                self._round_t0[req.rid] = time.monotonic() * 1e6
+        # Publication deliberately occurs in the *next* before_draft call.
+
+    # ------------------------------------------------------------------
+    # EAGLE / EAGLE3 protocol
+    # ------------------------------------------------------------------
+
+    def before_draft_extend(self, batch) -> torch.Tensor:
+        """Legal EAGLE boundary: verify -> publish -> draft_extend -> pin."""
+
+        self.begin_requests(batch)
+        self._batch_timing = {}
+        self._batch_cpu_timing = {}
+        self.record_stage("draft_start")
+        prefix_by_rid: dict[str, int] = {}
+        blocked: set[str] = set()
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            key = (rid, self._round_of.get(rid, -1))
+            if rid in self._disabled or key in self._prefix_blocked_rounds:
+                continue
+            if not self._finalize_pending_rounds(rid):
+                blocked.add(rid)
+                continue
+            ctx = self._ctx(rid)
+            if rid not in self._pending_round_commits and ctx.prefix_len == 0:
+                # First prefill boundary has no preceding RoundCommitted hook.
+                ctx.prefix_len = self._host_prefix_len(None, batch, index)
+            prefix_by_rid[rid] = int(ctx.prefix_len)
+        self._poll_ready(batch, skip_rids=frozenset(blocked))
+        self._prepare_rows(batch)
+        self._batch = batch
+        capture_decisions = []
+        for req in batch.reqs:
+            rid = req.rid
+            key = (rid, self._round_of.get(rid, -1))
+            if rid in blocked:
+                self._prefix_blocked_rounds.add(key)
+                self._capture_decisions[key] = False
+                capture_decisions.append(False)
+            else:
+                self._prefix_blocked_rounds.discard(key)
+                capture_decisions.append(self._capture_round(rid))
+        self._batch_capture_enabled = any(capture_decisions)
+        versions = self._pin_versions(batch)
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled or rid in blocked:
+                continue
+            if self._batch_capture_enabled:
+                self._eagle_capture[rid] = {}
+            prefix = prefix_by_rid[rid]
+            ctx = self._ctx(rid)
+            ctx.round_id = self._round_of[rid]
+            self._guard(
+                rid,
+                lambda rid=rid, ctx=ctx, prefix=prefix: (
+                    self.runtime.on_draft_inputs_ready(
+                        self._H.DraftInputsReady(
+                            request_id=rid,
+                            round_id=self._round_of[rid],
+                            request_epoch=ctx.request_epoch,
+                            slot_index=ctx.slot_index,
+                            active_version=self._pinned_versions[rid],
+                            prefix_len=prefix,
+                        )
+                    )
+                ),
+            )
+            if rid in self._disabled:
+                self.adapter_rows[index].zero_()
+        return versions
+
+    def assert_pinned(self, *, batch, source_adapter_version) -> None:
+        valid = self._validate_or_disable_batch(batch, source_adapter_version)
+        # The proposal's first token was produced in the preceding draft-extend.
+        # The scheduler may filter, merge or reorder requests before the internal
+        # draft steps.  Rebind fixed rows to the *current* request order here;
+        # otherwise a valid version tensor can still read another request's tail.
+        self._batch = batch
+        if valid:
+            for req in batch.reqs:
+                rid = req.rid
+                ctx = self.runtime.requests.get(rid)
+                if ctx is None or rid in self._disabled:
+                    continue
+                active = int(
+                    self.runtime.bank.slots[ctx.slot_index].active_version
+                )
+                pinned = self._pinned_versions.get(rid)
+                if pinned is None or active != pinned:
+                    self._disable(
+                        rid,
+                        "exactness",
+                        self._ExactnessViolation(
+                            f"{rid}: active tail version {active} changed after "
+                            f"proposal pin {pinned}"
+                        ),
+                    )
+                    valid = False
+        # This also zeros rows for requests disabled by either validation above.
+        self._prepare_rows(batch)
+        if not valid:
+            return
+
+    def after_draft(self, batch) -> None:
+        """Mark the complete EAGLE chain ready immediately before verify."""
+
+        self.record_stage("draft_end")
+        for req in batch.reqs:
+            key = (req.rid, self._round_of.get(req.rid, -1))
+            if req.rid in self._disabled or key in self._prefix_blocked_rounds:
+                continue
+            self._guard(
+                req.rid,
+                lambda req=req: self.runtime.on_proposal_ready(
+                    self._H.ProposalReady(
+                        request_id=req.rid,
+                        round_id=self._round_of[req.rid],
+                        proposal_version=self._pinned_versions[req.rid],
+                    )
+                ),
+            )
+
+    def requires_eager_capture(self, batch=None) -> bool:
+        del batch
+        return bool(self._batch_capture_enabled)
+
+    def tail_logits_offset(
+        self,
+        *,
+        logits: torch.Tensor,
+        hidden_states: Optional[torch.Tensor],
+        source_adapter_version: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+        phase: str,
+        proposal_step: int,
+    ) -> torch.Tensor:
+        del req_pool_indices
+        if hidden_states is None:
+            raise RuntimeError(
+                f"{self.algorithm} tail adaptation requires proposal hidden states"
+            )
+        n = int(logits.shape[0])
+        if (
+            source_adapter_version.dtype != torch.int64
+            or source_adapter_version.ndim != 1
+            or int(source_adapter_version.numel()) < n
+        ):
+            raise ValueError(
+                "EAGLE tail source versions must be one-dimensional int64 with "
+                "at least one value per proposal row"
+            )
+        if n > self.adapter_rows.shape[0]:
+            raise RuntimeError("EAGLE tail row buffer is smaller than graph batch")
+        rows = self.adapter_rows[:n]
+        with torch.profiler.record_function(
+            f"lightcone::tail_forward_{self.algorithm.lower()}"
+        ):
+            if self.shapes.mode == "output_residual":
+                if self._basis_forward is None:
+                    raise RuntimeError("output-residual forward basis is unavailable")
+                delta = self._output_residual(
+                    hidden_states,
+                    rows,
+                    self._basis_forward,
+                )
+            else:
+                delta = self._projection.project_hidden(
+                    self._delta_hidden(hidden_states, rows)
+                )
+        if delta.shape != logits.shape:
+            raise RuntimeError(
+                f"{self.algorithm} full-vocabulary tail shape mismatch: "
+                f"{tuple(delta.shape)} != {tuple(logits.shape)}"
+            )
+        delta = delta.to(dtype=logits.dtype)
+
+        # Python is not re-entered on graph replay.  Supervision rounds are
+        # forced eager, so every retained tensor below is real request evidence.
+        if self._batch_capture_enabled and self._batch is not None:
+            if len(self._batch.reqs) != n:
+                raise RuntimeError(
+                    "EAGLE supervision row count does not match request batch"
+                )
+            for index, req in enumerate(self._batch.reqs):
+                key = (req.rid, self._round_of.get(req.rid, -1))
+                if (
+                    req.rid in self._disabled
+                    or key in self._prefix_blocked_rounds
+                    or not self._capture_decisions.get(key, False)
+                ):
+                    continue
+                self._eagle_capture.setdefault(req.rid, {})[int(proposal_step)] = {
+                    "raw_logits": logits[index].detach(),
+                    "offset": delta[index].detach(),
+                    "tail_hidden": hidden_states[index].detach(),
+                    "phase": phase,
+                }
+        return delta
+
+    def _after_eagle_verify(
+        self,
+        *,
+        batch,
+        batch_result,
+        source_adapter_version: torch.Tensor,
+    ) -> None:
+        if not self._validate_or_disable_batch(batch, source_adapter_version):
+            return
+        if "verify_end" not in self._batch_timing:
+            self.record_stage("verify_end")
+        if "accept_end" not in self._batch_timing:
+            self.record_stage("accept_end")
+        target_logits = batch_result.logits_output.next_token_logits
+        target_hidden = batch_result.logits_output.hidden_states
+        self._emit_verify_hooks(batch, target_logits, target_hidden)
+        self._emit_accept_hooks(batch)
+        self._launch_eagle_signals(batch, batch_result, target_logits)
+        self._emit_round_committed(batch, batch_result.new_seq_lens)
+        for req in batch.reqs:
+            if req.rid in self._round_of:
+                old_key = (req.rid, self._round_of[req.rid])
+                self._capture_decisions.pop(
+                    old_key, None
+                )
+                self._prefix_blocked_rounds.discard(old_key)
+                self._round_of[req.rid] += 1
+                self._round_t0[req.rid] = time.monotonic() * 1e6
+        self._batch_capture_enabled = False
+
+    def after_verify(self, *args, **kwargs) -> None:
+        """Dispatch the two native worker protocols without duplicating state."""
+
+        if self.algorithm == "DFLASH":
+            if kwargs or len(args) != 3:
+                raise TypeError(
+                    "DFLASH after_verify expects (batch, target_logits, hidden_states)"
+                )
+            self._after_dflash_verify(*args)
+            return
+        if args:
+            raise TypeError(
+                "EAGLE after_verify expects keyword batch, batch_result and "
+                "source_adapter_version"
+            )
+        self._after_eagle_verify(**kwargs)
+
+    # ------------------------------------------------------------------
+    # Common evidence and telemetry hooks
+    # ------------------------------------------------------------------
+
+    def _capture_round(self, rid: str) -> bool:
+        round_id = self._round_of.get(rid, 0)
+        key = (rid, round_id)
+        cached = self._capture_decisions.get(key)
+        if cached is not None:
+            return cached
+        trigger = round_id > 0 and round_id % self.config.update_stride == 0
+        trace = False
+        if not trigger and self.config.trace.trace_capture_max_bytes > 0:
+            trace = self.runtime.wants_trace_signal(rid) if self.tp_rank == 0 else False
+            if self.tp_size > 1:
+                from sglang.srt.distributed import get_tp_group
+
+                trace = bool(
+                    get_tp_group().broadcast_object(
+                        trace if self.tp_rank == 0 else None,
+                        src=0,
+                    )
+                )
+        decision = bool(trigger or trace)
+        self._capture_decisions[key] = decision
+        return decision
+
+    @staticmethod
+    def _host_prefix_len(prefix_lens, batch, index: int) -> int:
+        if prefix_lens is not None and torch.is_tensor(prefix_lens):
+            if not prefix_lens.is_cuda:
+                return int(prefix_lens[index])
+        elif prefix_lens is not None:
+            return int(prefix_lens[index])
+        req = batch.reqs[index]
+        for name in ("kv_committed_len", "origin_input_ids"):
+            value = getattr(req, name, None)
+            if isinstance(value, int):
+                return value
+            if isinstance(value, (list, tuple)):
+                return len(value)
+        seq_lens_cpu = getattr(batch, "seq_lens_cpu", None)
+        if seq_lens_cpu is not None:
+            return int(seq_lens_cpu[index])
+        # This fallback is used only by CPU unit mocks.  Real GPU scheduling
+        # must expose one of the host-side length fields above.
+        seq_lens = getattr(batch, "seq_lens", None)
+        if seq_lens is not None and not seq_lens.is_cuda:
+            return int(seq_lens[index])
+        raise RuntimeError("tail adaptation requires a host prefix length")
+
+    def _finalize_round_commit(
+        self,
+        rid: str,
+        item: dict,
+        *,
+        prefix_override: Optional[int] = None,
+    ) -> None:
+        """Publish one exact RoundCommitted hook without synchronizing CUDA.
+
+        ``prefix_override`` is used by DFlash at the next ``before_draft``
+        boundary, where SGLang already exposes the exact host prefix.  EAGLE's
+        immediate post-verify boundary has no such host value, so it may only
+        consume the pinned copy after its completion event reports ready.
+        CUDA timing/count materialization remains delegated to the telemetry
+        worker and therefore never blocks this control path.
+        """
+
+        index = int(item["request_index"])
+        ctx = self.runtime.requests.get(rid)
+        if ctx is None:
+            return
+        if prefix_override is None:
+            prefix_after = int(item["new_seq_lens_cpu"][index])
+        else:
+            prefix_after = int(prefix_override)
+        commit_cpu = item.get("commit_lens_cpu")
+        ready = item.get("ready")
+        counts_ready = ready is None or ready.query()
+        # Prefix position and per-verification commit count are separate exact
+        # signals.  In particular, the runtime context can still contain the
+        # prefill/previously observed prefix when an event-guarded EAGLE copy
+        # becomes ready.  Once that copy is ready its commit lane is therefore
+        # authoritative; deriving the count from the context delta can turn a
+        # harmless prefix race into a false exactness violation.
+        prefix_delta = prefix_after - int(ctx.prefix_len)
+        committed = (
+            int(commit_cpu[index])
+            if commit_cpu is not None and counts_ready
+            else prefix_delta
+        )
+        if not 1 <= committed <= self.shapes.draft_depth + 1:
+            self._disable(
+                rid,
+                "exactness",
+                self._ExactnessViolation(
+                    f"{getattr(self, 'algorithm', 'tail')} exact committed "
+                    f"count {committed} "
+                    f"is outside [1, {self.shapes.draft_depth + 1}]"
+                ),
+            )
+            return
+        # When the previous context prefix is itself a legal immediately prior
+        # boundary, the two exact lanes must agree.  A delta outside the legal
+        # per-verify range instead means that context is the stale side of the
+        # prefix race; the ready commit lane remains authoritative in that case.
+        if (
+            commit_cpu is not None
+            and counts_ready
+            and 1 <= prefix_delta <= self.shapes.draft_depth + 1
+            and prefix_delta != committed
+        ):
+            self._disable(
+                rid,
+                "exactness",
+                self._ExactnessViolation(
+                    "tail committed count disagrees with exact prefix delta: "
+                    f"{committed} != {prefix_delta}"
+                ),
+            )
+            return
+        timing = item.get("timing")
+        if timing is not None:
+            # DFlash may finalize from the exact host prefix before its
+            # redundant pinned scalar copy becomes queryable.  Preserve that
+            # exact control-plane value and make the deferred evidence worker
+            # reject any later disagreement instead of silently overwriting it.
+            timing["expected_committed_per_verify"] = committed
+            timing["expected_prefix_pos_after"] = prefix_after
+        event = self._H.RoundCommitted(
+            request_id=rid,
+            round_id=int(item["round_id"]),
+            prefix_len_after=prefix_after,
+            active_version=int(item["version"]),
+            proposal_version=int(item["version"]),
+            draft_tokens=self.shapes.draft_depth,
+            accepted_drafts=max(committed - 1, 0),
+            committed_per_verify=committed,
+            target_calls=1,
+            rng_substream_id=self._H.rng_substream_identity(
+                request_id=rid,
+                sampling_seed=item.get("sampling_seed"),
+                is_greedy=bool(item.get("is_greedy", True)),
+                round_id=int(item["round_id"]),
+                prefix_len=int(ctx.prefix_len),
+            ),
+            draft_cpu_us=float(item["draft_cpu_us"]),
+            verify_cpu_us=float(item["verify_cpu_us"]),
+            verify_len=int(item["verify_len"]),
+            batch_size=int(item["batch_size"]),
+            offered_concurrency=int(self.config.runtime.concurrency),
+            algorithmic_censored=bool(item.get("algorithmic_censored", False)),
+            prefix_feature_exact=True,
+            cuda_timing_ref=timing,
+            round_wall_us=float(item["round_wall_us"]),
+        )
+        self._guard(
+            rid,
+            lambda rid=rid, event=event: self.runtime.on_round_committed(event),
+        )
+
+    def _complete_round_telemetry_lane(self, item: dict) -> None:
+        """Retire one batch reference after its RoundCommitted hook is handled."""
+
+        if item.get("telemetry_lane_done"):
+            return
+        item["telemetry_lane_done"] = True
+        lease = item.get("telemetry_lane_lease")
+        if lease is None:
+            return
+        lease["remaining"] -= 1
+        if lease["remaining"] < 0:
+            raise RuntimeError("tail telemetry lane reference count underflow")
+        if lease["remaining"] or lease["release_queued"]:
+            return
+        if self._telemetry_lanes is None:
+            raise RuntimeError("CUDA telemetry lease has no lane pool")
+        lease["release_queued"] = True
+        # All records for this batch were enqueued before this FIFO callback.
+        # The ready event additionally fences the pinned D2H copies.
+        self.runtime.telemetry.defer(
+            partial(self._telemetry_lanes.release, lease["lane"]),
+            lease["ready"],
+        )
+
+    def _finalize_pending_rounds(
+        self,
+        rid: str,
+        *,
+        prefix_override: Optional[int] = None,
+    ) -> bool:
+        """Apply every queued prefix in order; return False if CUDA is unready.
+
+        A host override is valid only for the newest queued round.  If more
+        than one round is outstanding, older events must first become ready so
+        each telemetry/controller transition retains its own exact prefix.
+        """
+
+        pending = self._pending_round_commits.get(rid)
+        if not pending:
+            return True
+        while pending:
+            item = pending[0]
+            ready = item.get("ready")
+            is_last = len(pending) == 1
+            override = prefix_override if is_last else None
+            if override is None and ready is not None and not ready.query():
+                return False
+            try:
+                self._finalize_round_commit(rid, item, prefix_override=override)
+            finally:
+                self._complete_round_telemetry_lane(item)
+                pending.pop(0)
+        self._pending_round_commits.pop(rid, None)
+        return rid not in self._disabled
+
+    def _emit_verify_hooks(self, batch, target_logits, target_hidden) -> None:
+        if target_logits is None:
+            return
+        bs = len(batch.reqs)
+        logits_3d = target_logits.view(bs, -1, target_logits.shape[-1])
+        hidden_3d = None
+        if target_hidden is not None:
+            hidden_3d = target_hidden.view(bs, -1, target_hidden.shape[-1])
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            key = (rid, self._round_of.get(rid, -1))
+            if rid in self._disabled or key in self._prefix_blocked_rounds:
+                continue
+            hidden_ref = None
+            if hidden_3d is not None and self.runtime.needs_trajectory:
+                hidden = hidden_3d[index, 0].float()
+                if hidden.shape[-1] == self._r_h_dev.shape[0]:
+                    hidden_ref = (hidden @ self._r_h_dev).unsqueeze(0)
+            self._guard(
+                rid,
+                lambda rid=rid, index=index, hidden_ref=hidden_ref: (
+                    self.runtime.on_verify_logits_ready(
+                        self._H.VerifyLogitsReady(
+                            request_id=rid,
+                            round_id=self._round_of[rid],
+                            proposal_version=self._pinned_versions[rid],
+                            target_logits_ref=logits_3d[index],
+                            target_hidden_ref=hidden_ref,
+                            valid_positions=int(logits_3d.shape[1]),
+                        )
+                    )
+                ),
+            )
+
+    def _emit_accept_hooks(self, batch) -> None:
+        for req in batch.reqs:
+            rid = req.rid
+            key = (rid, self._round_of.get(rid, -1))
+            if rid in self._disabled or key in self._prefix_blocked_rounds:
+                continue
+            version = self._pinned_versions[rid]
+            self._guard(
+                rid,
+                lambda rid=rid, version=version: self.runtime.on_acceptance_done(
+                    self._H.AcceptanceDone(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        proposal_version=version,
+                        denominator_version=version,
+                        residual_version=version,
+                        used_bonus=True,
+                    )
+                ),
+            )
+
+    def _emit_round_committed(self, batch, new_seq_lens) -> None:
+        now = time.monotonic() * 1e6
+        bs = len(batch.reqs)
+        commit_lens = None
+        if not new_seq_lens.is_cuda and getattr(batch, "seq_lens", None) is not None:
+            commit_lens = new_seq_lens - batch.seq_lens
+        ready = None
+        new_cpu = new_seq_lens
+        commit_cpu = commit_lens
+        censored = self._algorithmic_censored
+        censored_cpu = censored
+        lease = None
+        if new_seq_lens.is_cuda:
+            lane = self._batch_telemetry_lane
+            if lane is None or self._telemetry_lanes is None:
+                raise RuntimeError("tail commit has no telemetry lane")
+            new_cpu = self._telemetry_lanes.host(
+                lane,
+                "new_seq",
+                new_seq_lens.dtype,
+                bs,
+            )
+            new_cpu.copy_(new_seq_lens, non_blocking=True)
+            if censored is not None:
+                censored_cpu = self._telemetry_lanes.host(
+                    lane,
+                    "algorithmic_censored",
+                    torch.bool,
+                    bs,
+                )
+                censored_cpu.copy_(censored, non_blocking=True)
+            ready = self._telemetry_lanes.event(lane, "telemetry_ready")
+            ready.record(torch.cuda.current_stream(new_seq_lens.device))
+            lease = {
+                "lane": lane,
+                "ready": ready,
+                "remaining": 0,
+                "release_queued": False,
+            }
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled:
+                continue
+            timing = None
+            if ready is not None:
+                timing = {
+                    **self._batch_timing,
+                    "telemetry_ready": ready,
+                    "request_index": index,
+                    "new_seq_lens_cpu": new_cpu,
+                }
+                if commit_cpu is not None:
+                    timing["commit_lens_cpu"] = commit_cpu
+                if censored_cpu is not None:
+                    timing["algorithmic_censored_cpu"] = censored_cpu
+            version = self._pinned_versions[rid]
+            verify_len = self.shapes.draft_depth + 1
+            draft_cpu_us = max(
+                self._batch_cpu_timing.get("draft_end", 0.0)
+                - self._batch_cpu_timing.get("draft_start", 0.0),
+                0.0,
+            )
+            verify_cpu_us = max(
+                self._batch_cpu_timing.get("verify_end", 0.0)
+                - self._batch_cpu_timing.get("draft_end", 0.0),
+                0.0,
+            )
+            item = {
+                "round_id": self._round_of[rid],
+                "version": version,
+                "request_index": index,
+                "new_seq_lens_cpu": new_cpu,
+                "commit_lens_cpu": commit_cpu,
+                "ready": ready,
+                "timing": timing,
+                "draft_cpu_us": draft_cpu_us,
+                "verify_cpu_us": verify_cpu_us,
+                "verify_len": verify_len,
+                "batch_size": bs,
+                "round_wall_us": now - self._round_t0.get(rid, now),
+                "telemetry_lane_lease": lease,
+                "sampling_seed": getattr(
+                    req.sampling_params, "sampling_seed", None
+                ),
+                "is_greedy": int(req.sampling_params.top_k) <= 1,
+                "algorithmic_censored": (
+                    False
+                    if censored_cpu is None or ready is not None
+                    else bool(censored_cpu[index])
+                ),
+            }
+            if lease is not None:
+                lease["remaining"] += 1
+            self._pending_round_commits.setdefault(rid, []).append(item)
+            if ready is None:
+                # CPU/mocked execution already owns an exact scalar and can
+                # preserve the old immediate hook semantics.
+                self._finalize_pending_rounds(rid)
+        if lease is not None and lease["remaining"] == 0:
+            lease["release_queued"] = True
+            self.runtime.telemetry.defer(
+                partial(self._telemetry_lanes.release, lease["lane"]),
+                lease["ready"],
+            )
+        self._batch_telemetry_lane = None
+        self._dflash_accept = None
+        # Candidate/trace paths have already taken owned snapshots.  Keeping
+        # these scheduler-batch tensors as manager attributes until the next
+        # proposal needlessly pins full-vocabulary logits and hidden states.
+        self._dflash_proposal = None
+        self._dflash_target_logits = None
+        self._dflash_target_hidden = None
+        self._algorithmic_censored = None
+        self._batch_timing = {}
+        self._batch_cpu_timing = {}
+
+    def _globalize_dflash_logits(
+        self,
+        logits: torch.Tensor,
+        vocab_ranges: tuple[tuple[int, int], ...],
+    ) -> torch.Tensor:
+        if len(vocab_ranges) != 1:
+            raise RuntimeError(
+                "TP tail supervision does not support split base/added vocab ranges"
+            )
+        if self.tp_size == 1:
+            start, end = vocab_ranges[0]
+            if start == 0 and end == self.shapes.vocab_size:
+                return logits
+            full = torch.full(
+                (*logits.shape[:-1], self.shapes.vocab_size),
+                -torch.inf,
+                dtype=logits.dtype,
+                device=logits.device,
+            )
+            full[..., start:end] = logits
+            return full
+        from sglang.srt.distributed.communication_op import (
+            tensor_model_parallel_all_gather,
+        )
+
+        gathered = tensor_model_parallel_all_gather(logits, dim=-1)
+        return gathered[..., : self.shapes.vocab_size]
+
+    def _request_semantics(
+        self, batch
+    ) -> tuple[list[int], list[tuple[int, ...]], list[bool]]:
+        """Resolve request boundaries from scheduler-owned host metadata."""
+
+        remaining: list[int] = []
+        terminal_ids: list[tuple[int, ...]] = []
+        ignore_eos: list[bool] = []
+        for req in batch.reqs:
+            prefix = int(self._ctx(req.rid).prefix_len)
+            origin = getattr(req, "origin_input_ids", ())
+            if isinstance(origin, int):
+                prompt_len = origin
+            else:
+                prompt_len = len(origin) if origin is not None else 0
+            generated = max(prefix - prompt_len, 0)
+            sampling = req.sampling_params
+            remaining.append(max(int(sampling.max_new_tokens) - generated, 0))
+            stops = set(getattr(req, "eos_token_ids", None) or ())
+            stops.update(getattr(sampling, "stop_token_ids", None) or ())
+            terminal_ids.append(tuple(sorted(int(token) for token in stops)))
+            ignore_eos.append(bool(getattr(sampling, "ignore_eos", False)))
+        return remaining, terminal_ids, ignore_eos
+
+    def _launch_dflash_signals(self, batch, target_logits, proposal) -> None:
+        from lightcone_spec.methods.base import (
+            SourceBoundCandidateBatch,
+            TeacherSignal,
+        )
+        from sglang.srt.speculative.dflash_info_v2 import (
+            dflash_semantic_valid_mask,
+        )
+
+        accept = self._dflash_accept
+        if accept is None:
+            raise RuntimeError("DFLASH supervision requires its acceptance result")
+        remaining, terminal_ids, ignore_eos = self._request_semantics(batch)
+        semantic_mask, censored = dflash_semantic_valid_mask(
+            proposal_token_ids=proposal.proposal_token_ids,
+            base_valid_mask=proposal.valid_mask,
+            correct_len=accept.correct_len,
+            bonus=accept.bonus,
+            remaining_output_tokens=remaining,
+            terminal_token_ids=terminal_ids,
+            ignore_eos=ignore_eos,
+        )
+        self._algorithmic_censored = censored
+
+        if (
+            proposal.tail_hidden is None
+            or proposal.raw_logits is None
+            or proposal.proposal_logits is None
+        ):
+            # Non-supervision graph rounds intentionally carry no full logits.
+            return
+        bs, depth = proposal.proposal_token_ids.shape
+        target = target_logits.view(bs, -1, target_logits.shape[-1])[:, :depth]
+        corrected = self._globalize_dflash_logits(
+            proposal.proposal_logits,
+            proposal.vocab_ranges,
+        )
+        trace_rows: list[int] = []
+        update_rows: list[int] = []
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled or not self._capture_round(rid):
+                continue
+            if self.runtime.wants_trace_signal(rid):
+                trace_rows.append(index)
+            if (
+                self._round_of[rid] > 0
+                and self._round_of[rid] % self.config.update_stride == 0
+            ):
+                update_rows.append(index)
+
+        # Counterfactual traces still need the complete reconstructable signal,
+        # but headline/performance runs keep tracing disabled.  Only trace rows
+        # pay for raw-logit snapshots; online candidates use the compact exact
+        # source-point representation below.
+        raw = None
+        if trace_rows:
+            raw = self._globalize_dflash_logits(
+                proposal.raw_logits,
+                proposal.vocab_ranges,
+            )
+        sampling_info = getattr(batch, "sampling_info", None)
+        for index in trace_rows:
+            req = batch.reqs[index]
+            rid = req.rid
+            hidden = proposal.tail_hidden[index, :depth].detach().clone()
+            t = target[index].detach().to(dtype=torch.float32, copy=True)
+            mask = semantic_mask[index, :depth].detach().clone()
+            assert raw is not None
+            base_logits = raw[index, :depth].detach().clone()
+            corrected_logits = corrected[index, :depth].detach().to(
+                dtype=torch.float32, copy=True
+            )
+            u = hidden.to(self._forward_dtype) @ self._r_h_dev
+            scale = None
+            if sampling_info is not None and not sampling_info.is_all_greedy:
+                temperature = sampling_info.temperatures[index].reshape(-1)[0]
+                scale = temperature.reciprocal().expand(depth).clone()
+            signal = TeacherSignal(
+                source_round=self._round_of[rid],
+                source_version=self._pinned_versions[rid],
+                u=u,
+                m_prev=torch.empty(
+                    depth,
+                    0,
+                    dtype=torch.float32,
+                    device=hidden.device,
+                ),
+                # Preserve the online head dtype so reconstruction repeats the
+                # native residual cast/add/rounding order exactly.
+                base_proposal_logits=base_logits,
+                base_confidence_logits=torch.zeros(
+                    depth,
+                    dtype=torch.float32,
+                    device=hidden.device,
+                ),
+                target_logits=t,
+                valid_mask=mask,
+                # DFlash's exact q is the proposal_token_ids delta measure;
+                # corrected scores remain the proximal source point.
+                source_proposal_logits=(
+                    corrected_logits
+                    if scale is None
+                    else corrected_logits * scale[:, None]
+                ).detach(),
+                confidence_targets=None,
+                # DFlash q remains a deterministic argmax delta measure, so
+                # temperature does not change the sampled token.  It does change
+                # the target distribution and the differentiable score surrogate;
+                # applying the same real 1/T here reconstructs both exactly.
+                proposal_logit_scale=scale,
+                tail_hidden=(
+                    hidden if self.shapes.mode != "output_residual" else None
+                ),
+                proposal_distribution_kind="deterministic_argmax",
+            )
+            self._guard(
+                rid,
+                lambda rid=rid, signal=signal: self.runtime.observe_signal(
+                    rid, signal
+                ),
+            )
+
+        if not update_rows:
+            return
+        # One index-select per source tensor produces an owned verify-batch
+        # snapshot.  This replaces O(batch) clone launches and, critically,
+        # omits raw logits plus the FP32 corrected-logit promotion.
+        all_rows = update_rows == list(range(bs))
+        update_index = None
+
+        def owned_rows(value: torch.Tensor) -> torch.Tensor:
+            nonlocal update_index
+            if all_rows:
+                return value.detach().clone()
+            if update_index is None:
+                update_index = torch.tensor(
+                    update_rows,
+                    dtype=torch.int64,
+                    device=value.device,
+                )
+            return value.detach().index_select(0, update_index)
+
+        hidden_batch = owned_rows(proposal.tail_hidden[:, :depth])
+        target_batch = owned_rows(target)
+        proposal_batch = owned_rows(corrected[:, :depth])
+        mask_batch = owned_rows(semantic_mask[:, :depth])
+        u_batch = hidden_batch.to(self._forward_dtype) @ self._r_h_dev
+        scale_batch = None
+        if sampling_info is not None and not sampling_info.is_all_greedy:
+            temperatures = sampling_info.temperatures.reshape(bs, -1)[:, 0]
+            selected_temperatures = (
+                temperatures.clone()
+                if all_rows
+                else temperatures.index_select(0, update_index)
+            )
+            scale_batch = selected_temperatures.reciprocal()
+            scale_batch = scale_batch[:, None].expand(-1, depth)
+        request_ids = tuple(batch.reqs[index].rid for index in update_rows)
+        compact = SourceBoundCandidateBatch(
+            source_rounds=tuple(self._round_of[rid] for rid in request_ids),
+            source_versions=tuple(self._pinned_versions[rid] for rid in request_ids),
+            u=u_batch,
+            m_prev=torch.empty(
+                len(update_rows),
+                depth,
+                0,
+                dtype=self._forward_dtype,
+                device=hidden_batch.device,
+            ),
+            proposal_logits=proposal_batch,
+            target_logits=target_batch,
+            valid_mask=mask_batch,
+            proposal_logit_scale=scale_batch,
+            tail_hidden=(
+                hidden_batch if self.shapes.mode != "output_residual" else None
+            ),
+            proposal_distribution_kind="deterministic_argmax",
+        )
+        try:
+            self.runtime.launch_update_batch(request_ids, compact)
+        except self._ExactnessViolation as exc:
+            for rid in request_ids:
+                self._disable(rid, "exactness", exc)
+        except torch.cuda.OutOfMemoryError as exc:
+            for rid in request_ids:
+                self._disable(rid, "adaptation_cuda_oom", exc)
+
+    def _launch_eagle_signals(self, batch, batch_result, target_logits) -> None:
+        from lightcone_spec.methods.base import TeacherSignal
+        from sglang.srt.speculative.spec_utils import (
+            speculative_semantic_valid_mask,
+        )
+
+        bs = len(batch.reqs)
+        target = target_logits.view(bs, -1, target_logits.shape[-1])
+        draft_token = getattr(batch.spec_info, "draft_token", None)
+        if draft_token is None or draft_token.numel() % max(bs, 1) != 0:
+            raise RuntimeError(
+                f"{self.algorithm} supervision lacks a rectangular proposal chain"
+            )
+        proposal_tokens = draft_token.view(bs, -1)
+        semantic_depth = min(proposal_tokens.shape[1], target.shape[1])
+        proposal_tokens = proposal_tokens[:, :semantic_depth]
+        bonus = getattr(batch_result.next_draft_input, "bonus_tokens", None)
+        accept_lens = getattr(batch_result, "accept_lens", None)
+        if bonus is None or accept_lens is None:
+            raise RuntimeError(
+                f"{self.algorithm} supervision lacks exact acceptance semantics"
+            )
+        remaining, terminal_ids, ignore_eos = self._request_semantics(batch)
+        semantic_mask, censored = speculative_semantic_valid_mask(
+            proposal_token_ids=proposal_tokens,
+            base_valid_mask=torch.ones_like(proposal_tokens, dtype=torch.bool),
+            correct_len=(accept_lens - 1).clamp_min(0),
+            bonus=bonus,
+            remaining_output_tokens=remaining,
+            terminal_token_ids=terminal_ids,
+            ignore_eos=ignore_eos,
+            backend=self.algorithm,
+        )
+        self._algorithmic_censored = censored
+        for index, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled or not self._capture_round(rid):
+                continue
+            captured = self._eagle_capture.get(rid, {})
+            if not captured:
+                logger.warning(
+                    "%s supervision skipped for %s round %d: no real proposal "
+                    "signals (CUDA graph should have been forced eager)",
+                    self.algorithm,
+                    rid,
+                    self._round_of[rid],
+                )
+                continue
+            steps = sorted(captured)
+            expected = list(range(len(steps)))
+            if steps != expected:
+                raise RuntimeError(
+                    f"{self.algorithm} proposal signal steps are incomplete: "
+                    f"{steps} != {expected}"
+                )
+            depth = min(len(steps), semantic_depth)
+            items = [captured[step] for step in steps[:depth]]
+            raw = torch.stack([item["raw_logits"] for item in items])
+            offsets = torch.stack([item["offset"] for item in items])
+            corrected = raw + offsets.to(dtype=raw.dtype)
+            hidden = torch.stack([item["tail_hidden"] for item in items])
+            t = target[index, :depth].float().detach()
+            valid = semantic_mask[index, :depth]
+            u = hidden.to(self._forward_dtype) @ self._r_h_dev
+            scale = None
+            if getattr(
