@@ -0,0 +1,641 @@
+"""DFlash drafter-scope Full/LoRA updates on a bounded current canvas."""
+
+from __future__ import annotations
+
+import logging
+import math
+import re
+from dataclasses import dataclass
+from typing import Sequence
+
+import torch
+import torch.nn.functional as F
+
+from sglang.srt.speculative.online_adaptation_config import (
+    load_online_adaptation,
+)
+from sglang.srt.speculative.online_adaptation_runtime import (
+    FixedInferenceBank,
+    OnlineCohortRuntime,
+    ResidentOptimizer,
+)
+
+logger = logging.getLogger(__name__)
+
+_LINEAR = re.compile(
+    r"(?:^|\.)(?:fc|qkv_proj|o_proj|gate_up_proj|down_proj)\.weight$"
+)
+
+
+@dataclass
+class _RequestCanvas:
+    target_hidden: torch.Tensor
+    positions: torch.Tensor
+    valid_mask: torch.Tensor
+
+
+def _rms(hidden: torch.Tensor, weight: torch.Tensor, epsilon: float) -> torch.Tensor:
+    variance = hidden.to(torch.float32).square().mean(-1, keepdim=True)
+    return (
+        hidden * torch.rsqrt(variance + epsilon).to(hidden.dtype)
+    ) * weight
+
+
+def _linear(
+    hidden: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor:
+    return F.linear(
+        hidden,
+        weight.to(hidden.dtype),
+        None if bias is None else bias.to(hidden.dtype),
+    )
+
+
+def _rope(
+    value: torch.Tensor,
+    positions: torch.Tensor,
+    *,
+    theta: float,
+) -> torch.Tensor:
+    dimension = value.shape[-1]
+    if dimension % 2:
+        raise ValueError("RoPE head dimension must be even")
+    inverse = 1.0 / (
+        theta
+        ** (
+            torch.arange(
+                0,
+                dimension,
+                2,
+                device=value.device,
+                dtype=torch.float32,
+            )
+            / dimension
+        )
+    )
+    angles = positions.to(torch.float32)[:, None] * inverse[None, :]
+    cosine = torch.cat((angles.cos(), angles.cos()), dim=-1).to(value.dtype)
+    sine = torch.cat((angles.sin(), angles.sin()), dim=-1).to(value.dtype)
+    left, right = value.chunk(2, dim=-1)
+    rotated = torch.cat((-right, left), dim=-1)
+    return value * cosine[:, None, :] + rotated * sine[:, None, :]
+
+
+class DFlashDrafterAdapter:
+    """Update DFlash-owned parameters while target embeddings/head stay frozen."""
+
+    def __init__(self, server_args, worker) -> None:
+        config = load_online_adaptation(server_args)
+        if config is None or config.parameter_scope != "drafter":
+            raise ValueError("drafter adapter requires drafter-scope configuration")
+        if config.weight_update_mode not in {"lora", "full"}:
+            raise ValueError("drafter scope supports Full or LoRA")
+        if int(worker.ps.tp_size) != 1:
+            raise ValueError(
+                "differentiable DFlash current-canvas updates currently require "
+                "TP=1; start-up fails before adaptation allocation"
+            )
+        self.config = config
+        self.worker = worker
+        self.model = worker.draft_model
+        self.device = worker.device
+        self.runtime = OnlineCohortRuntime(
+            config,
+            device=self.device,
+            reserve_bytes=int(
+                server_args.speculative_adaptation_reserve_mb
+            )
+            * 1024
+            * 1024,
+            telemetry_path=server_args.speculative_adaptation_telemetry_path,
+        )
+        self.named = {
+            name: parameter
+            for name, parameter in self.model.named_parameters()
+            if parameter.is_floating_point()
+        }
+        if not self.named:
+            raise RuntimeError("DFlash drafter exposes no floating parameters")
+        self.names = tuple(sorted(self.named))
+        self.inference = FixedInferenceBank(
+            tuple(self.named[name] for name in self.names)
+        )
+        self.base = {
+            name: parameter.detach().to(torch.float32).clone()
+            for name, parameter in self.named.items()
+        }
+        self.factor_names: tuple[str, ...] = ()
+        self.factor_shapes: dict[str, tuple[int, int]] = {}
+        if config.weight_update_mode == "full":
+            self.optimizer = ResidentOptimizer(
+                tuple(self.named[name] for name in self.names),
+                config.optimizer,
+            )
+        else:
+            factor_names = [
+                name
+                for name in self.names
+                if self.named[name].ndim == 2 and _LINEAR.search(name)
+            ]
+            if not factor_names:
+                raise RuntimeError("DFlash LoRA parameter selection is empty")
+            self.factor_names = tuple(factor_names)
+            factors = []
+            generator = torch.Generator(device=self.device)
+            seed = int(config.sampling_profile_sha256[:16], 16)
+            generator.manual_seed(seed)
+            for name in self.factor_names:
+                weight = self.named[name]
+                rank = int(config.rank)
+                if rank > min(weight.shape):
+                    raise ValueError(
+                        f"LoRA rank {rank} exceeds {name} shape {tuple(weight.shape)}"
+                    )
+                a = torch.empty(
+                    (rank, weight.shape[1]),
+                    dtype=torch.float32,
+                    device=self.device,
+                )
+                torch.nn.init.kaiming_uniform_(
+                    a, a=math.sqrt(5), generator=generator
+                )
+                b = torch.zeros(
+                    (weight.shape[0], rank),
+                    dtype=torch.float32,
+                    device=self.device,
+                )
+                factors.extend((a, b))
+                self.factor_shapes[name] = (len(factors) - 2, len(factors) - 1)
+            self.optimizer = ResidentOptimizer(tuple(factors), config.optimizer)
+        self._captured_input: torch.Tensor | None = None
+        self._captured_positions: torch.Tensor | None = None
+        self._captured_request_ids: tuple[str, ...] = ()
+        self._contexts: dict[str, _RequestCanvas] = {}
+        self._verify_hidden: torch.Tensor | None = None
+        self._verify_positions: torch.Tensor | None = None
+        self._commit_lens: torch.Tensor | None = None
+        resident = (
+            tuple(self.base.values())
+            + self.optimizer.master
+            + self.optimizer.first
+            + self.optimizer.second
+            + self.inference.staging
+        )
+        hidden = int(self.model.config.hidden_size)
+        layers = int(self.model.config.num_hidden_layers)
+        scratch = (
+            max(1, int(server_args.max_running_requests))
+            * config.canvas_tokens
+            * hidden
+            * max(4, layers)
+            * 4
+        )
+        self.runtime.bind_memory(
+            resident_tensors=resident,
+            peak_scratch_bytes=scratch,
+        )
+
+    def begin_round(self, batch) -> tuple[int, ...]:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        version = self.runtime.begin_round(request_ids)
+        return (version,) * len(request_ids)
+
+    def capture_canvas(
+        self,
+        batch,
+        *,
+        input_embeds: torch.Tensor,
+        positions: torch.Tensor,
+    ) -> None:
+        if not self.runtime.update_due():
+            self._captured_input = None
+            self._captured_positions = None
+            return
+        self._captured_request_ids = tuple(
+            request.rid for request in batch.reqs
+        )
+        self._captured_input = input_embeds.detach().clone()
+        self._captured_positions = positions.detach().clone()
+
+    def capture_verify(
+        self,
+        *,
+        hidden_states: torch.Tensor,
+        positions: torch.Tensor,
+        commit_lens: torch.Tensor,
+    ) -> None:
+        self._verify_hidden = hidden_states.detach()
+        self._verify_positions = positions.detach()
+        self._commit_lens = commit_lens.detach()
+
+    def _effective_parameters(
+        self, trainable: Sequence[torch.Tensor]
+    ) -> dict[str, torch.Tensor]:
+        if self.config.weight_update_mode == "full":
+            return dict(zip(self.names, trainable, strict=True))
+        values = dict(self.base)
+        for name in self.factor_names:
+            a_index, b_index = self.factor_shapes[name]
+            values[name] = (
+                self.base[name]
+                + trainable[b_index] @ trainable[a_index]
+            )
+        return values
+
+    def _parameter(
+        self,
+        values: dict[str, torch.Tensor],
+        name: str,
+        fallback: torch.Tensor,
+    ) -> torch.Tensor:
+        return values.get(name, fallback.detach().to(torch.float32))
+
+    def _project_context(
+        self,
+        values: dict[str, torch.Tensor],
+        hidden: torch.Tensor,
+    ) -> torch.Tensor:
+        fc = self._parameter(values, "fc.weight", self.model.fc.weight)
+        projected = _linear(hidden, fc, None)
+        norm = self._parameter(
+            values, "hidden_norm.weight", self.model.hidden_norm.weight
+        )
+        return _rms(
+            projected,
+            norm.to(projected.dtype),
+            float(self.model.hidden_norm.variance_epsilon),
+        )
+
+    def _layer_forward(
+        self,
+        values: dict[str, torch.Tensor],
+        *,
+        layer_index: int,
+        hidden: torch.Tensor,
+        residual: torch.Tensor | None,
+        positions: torch.Tensor,
+        context: torch.Tensor | None,
+        context_positions: torch.Tensor | None,
+        context_valid: torch.Tensor | None,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        layer = self.model.layers[layer_index]
+        prefix = f"layers.{layer_index}"
+        if residual is None:
+            residual = hidden
+            norm_weight = self._parameter(
+                values,
+                f"{prefix}.input_layernorm.weight",
+                layer.input_layernorm.weight,
+            )
+            hidden = _rms(
+                hidden,
+                norm_weight.to(hidden.dtype),
+                float(layer.input_layernorm.variance_epsilon),
+            )
+        else:
+            residual = residual + hidden
+            norm_weight = self._parameter(
+                values,
+                f"{prefix}.input_layernorm.weight",
+                layer.input_layernorm.weight,
+            )
+            hidden = _rms(
+                residual,
+                norm_weight.to(residual.dtype),
+                float(layer.input_layernorm.variance_epsilon),
+            )
+        attention = layer.self_attn
+        qkv_weight = self._parameter(
+            values,
+            f"{prefix}.self_attn.qkv_proj.weight",
+            attention.qkv_proj.weight,
+        )
+        qkv = _linear(hidden, qkv_weight, attention.qkv_proj.bias)
+        query, current_key, current_value = qkv.split(
+            [attention.q_size, attention.kv_size, attention.kv_size],
+            dim=-1,
+        )
+        query = query.view(-1, attention.num_heads, attention.head_dim)
+        current_key = current_key.view(
+            -1, attention.num_kv_heads, attention.head_dim
+        )
+        current_value = current_value.view(
+            -1, attention.num_kv_heads, attention.head_dim
+        )
+        q_norm = self._parameter(
+            values,
+            f"{prefix}.self_attn.q_norm.weight",
+            attention.q_norm.weight,
+        )
+        k_norm = self._parameter(
+            values,
+            f"{prefix}.self_attn.k_norm.weight",
+            attention.k_norm.weight,
+        )
+        query = _rms(
+            query,
+            q_norm.to(query.dtype),
+            float(attention.q_norm.variance_epsilon),
+        )
+        current_key = _rms(
+            current_key,
+            k_norm.to(current_key.dtype),
+            float(attention.k_norm.variance_epsilon),
+        )
+        theta = float(
+            getattr(self.model.config, "rope_theta", 1_000_000.0)
+        )
+        query = _rope(query, positions, theta=theta)
+        current_key = _rope(current_key, positions, theta=theta)
+        key_parts = []
+        value_parts = []
+        if context is not None and context.numel():
+            context_qkv = _linear(
+                context,
+                qkv_weight,
+                attention.qkv_proj.bias,
+            )
+            _, context_key, context_value = context_qkv.split(
+                [attention.q_size, attention.kv_size, attention.kv_size],
+                dim=-1,
+            )
+            context_key = context_key.view(
+                -1, attention.num_kv_heads, attention.head_dim
+            )
+            context_value = context_value.view(
+                -1, attention.num_kv_heads, attention.head_dim
+            )
+            context_key = _rms(
+                context_key,
+                k_norm.to(context_key.dtype),
+                float(attention.k_norm.variance_epsilon),
+            )
+            context_key = _rope(
+                context_key, context_positions, theta=theta
+            )
+            key_parts.append(context_key)
+            value_parts.append(context_value)
+        key_parts.append(current_key)
+        value_parts.append(current_value)
+        key = torch.cat(key_parts, dim=0)
+        value = torch.cat(value_parts, dim=0)
+        repeat = attention.num_heads // attention.num_kv_heads
+        key = key.repeat_interleave(repeat, dim=1)
+        value = value.repeat_interleave(repeat, dim=1)
+        query = query.transpose(0, 1).unsqueeze(0)
+        key = key.transpose(0, 1).unsqueeze(0)
+        value = value.transpose(0, 1).unsqueeze(0)
+        attention_mask = None
+        if context_valid is not None:
+            visible = torch.cat(
+                (
+                    context_valid,
+                    torch.ones(
+                        current_key.shape[0],
+                        device=self.device,
+                        dtype=torch.bool,
+                    ),
+                )
+            )
+            attention_mask = visible[None, None, None, :]
+        attended = F.scaled_dot_product_attention(
+            query,
+            key,
+            value,
+            attn_mask=attention_mask,
+            dropout_p=0.0,
+            is_causal=False,
+            scale=attention.scaling,
+        )
+        attended = attended.squeeze(0).transpose(0, 1).reshape(
+            hidden.shape[0], -1
+        )
+        o_weight = self._parameter(
+            values,
+            f"{prefix}.self_attn.o_proj.weight",
+            attention.o_proj.weight,
+        )
+        attention_output = _linear(
+            attended, o_weight, attention.o_proj.bias
+        )
+        residual = residual + attention_output
+        post_weight = self._parameter(
+            values,
+            f"{prefix}.post_attention_layernorm.weight",
+            layer.post_attention_layernorm.weight,
+        )
+        mlp_input = _rms(
+            residual,
+            post_weight.to(residual.dtype),
+            float(layer.post_attention_layernorm.variance_epsilon),
+        )
+        gate_weight = self._parameter(
+            values,
+            f"{prefix}.mlp.gate_up_proj.weight",
+            layer.mlp.gate_up_proj.weight,
+        )
+        gate_up = _linear(
+            mlp_input, gate_weight, layer.mlp.gate_up_proj.bias
+        )
+        gate, up = gate_up.chunk(2, dim=-1)
+        activated = F.silu(gate) * up
+        down_weight = self._parameter(
+            values,
+            f"{prefix}.mlp.down_proj.weight",
+            layer.mlp.down_proj.weight,
+        )
+        return (
+            _linear(activated, down_weight, layer.mlp.down_proj.bias),
+            residual,
+        )
+
+    def _surrogate_hidden(
+        self,
+        values: dict[str, torch.Tensor],
+        input_embeds: torch.Tensor,
+        positions: torch.Tensor,
+        request_ids: tuple[str, ...],
+    ) -> torch.Tensor:
+        block = int(self.worker.block_size)
+        batch_size = len(request_ids)
+        inputs = input_embeds.view(batch_size, block, -1)
+        positions = positions.view(batch_size, block)
+        outputs = []
+        for index, request_id in enumerate(request_ids):
+            context_state = self._contexts.get(request_id)
+            context = None
+            context_positions = None
+            context_valid = None
+            if context_state is not None:
+                target_hidden = context_state.target_hidden[
+                    -self.config.canvas_tokens :
+                ]
+                context = self._project_context(values, target_hidden)
+                context_positions = context_state.positions[
+                    -self.config.canvas_tokens :
+                ]
+                context_valid = context_state.valid_mask[
+                    -self.config.canvas_tokens :
+                ]
+            hidden = inputs[index]
+            residual = None
+            for layer_index in range(len(self.model.layers)):
+                hidden, residual = self._layer_forward(
+                    values,
+                    layer_index=layer_index,
+                    hidden=hidden,
+                    residual=residual,
+                    positions=positions[index],
+                    context=context,
+                    context_positions=context_positions,
+                    context_valid=context_valid,
+                )
+            if residual is not None:
+                hidden = hidden + residual
+            norm = self._parameter(
+                values, "norm.weight", self.model.norm.weight
+            )
+            outputs.append(
+                _rms(
+                    hidden,
+                    norm.to(hidden.dtype),
+                    float(self.model.norm.variance_epsilon),
+                )
+            )
+        return torch.stack(outputs)
+
+    def maybe_launch(
+        self,
+        *,
+        draft_hidden: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+        lm_head_weight: torch.Tensor,
+    ) -> None:
+        if not self.runtime.update_due():
+            return
+        if self._captured_input is None or self._captured_positions is None:
+            self.runtime.disable("missing_current_canvas", exactness=True)
+            return
+        source_round = self.runtime.round
+        source_version = self.runtime.active_version
+        owned_draft = draft_hidden.detach().clone()
+        owned_target = target_logits.detach().clone()
+        owned_mask = valid_mask.detach().clone()
+        source_tensors = (
+            self._captured_input,
+            self._captured_positions,
+            owned_draft,
+            owned_target,
+            owned_mask,
+        )
+        try:
+            with self.runtime.side_update(source_tensors):
+                leaves = tuple(
+                    value.detach().clone().requires_grad_(True)
+                    for value in self.optimizer.master
+                )
+                values = self._effective_parameters(leaves)
+                surrogate = self._surrogate_hidden(
+                    values,
+                    self._captured_input,
+                    self._captured_positions,
+                    self._captured_request_ids,
+                )
+                block = int(self.worker.block_size)
+                batch_size = len(self._captured_request_ids)
+                raw = owned_draft.view(batch_size, block, -1)
+                differentiable = raw.detach() + surrogate - surrogate.detach()
+                draft_logits = (
+                    differentiable[:, 1:, :].to(lm_head_weight.dtype)
+                    @ lm_head_weight.T
+                ).to(torch.float32)
+                target = owned_target.view(
+                    batch_size, block, -1
+                )[:, : block - 1].to(torch.float32)
+                weights = self.config.loss_position_decay ** torch.arange(
+                    block - 1,
+                    device=self.device,
+                    dtype=torch.float32,
+                )
+                weights = weights[None, :] * owned_mask.to(torch.float32)
+                probability = torch.softmax(target, dim=-1)
+                loss = (
+                    (
+                        probability
+                        * (
+                            torch.log_softmax(target, dim=-1)
+                            - torch.log_softmax(draft_logits, dim=-1)
+                        )
+                    ).sum(-1)
+                    * weights
+                ).sum() / weights.sum().clamp_min(1.0)
+                gradients = torch.autograd.grad(loss, leaves)
+                finite = torch.isfinite(loss) & torch.stack(
+                    [torch.isfinite(gradient).all() for gradient in gradients]
+                ).all()
+                proposal = self.optimizer.propose(gradients)
+                effective = self._effective_parameters(proposal.parameters)
+                staged = tuple(
+                    torch.where(
+                        finite,
+                        effective[name],
+                        self.named[name].detach().to(torch.float32),
+                    )
+                    for name in self.names
+                )
+                self.inference.stage(staged)
+                self.runtime.submit(
+                    source_round=source_round,
+                    source_version=source_version,
+                    optimizer=self.optimizer,
+                    proposal=proposal,
+                    inference_bank=self.inference,
+                    finite=finite,
+                )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("adaptation_cuda_oom")
+
+    def after_commit(self, batch, new_seq_lens: torch.Tensor) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        self.runtime.record_device_commit(request_ids, new_seq_lens)
+        if (
+            self._verify_hidden is None
+            or self._verify_positions is None
+            or self._commit_lens is None
+        ):
+            return
+        batch_size = len(request_ids)
+        block = int(self.worker.block_size)
+        hidden = self._verify_hidden.view(batch_size, block, -1)
+        positions = self._verify_positions.view(batch_size, block)
+        commit_lens = self._commit_lens
+        valid_positions = torch.arange(
+            block, device=self.device, dtype=commit_lens.dtype
+        )[None, :] < commit_lens[:, None]
+        for index, request_id in enumerate(request_ids):
+            self._contexts[request_id] = _RequestCanvas(
+                hidden[index].detach(),
+                positions[index].detach(),
+                valid_positions[index].detach(),
+            )
+        self._verify_hidden = None
+        self._verify_positions = None
+        self._commit_lens = None
+
+    def finish_request(self, request_id: str) -> None:
+        self.runtime.finish_request(request_id)
+        self._contexts.pop(request_id, None)
+
+    def diagnostics(self) -> dict:
+        return self.runtime.diagnostics()
+
+
+def maybe_build_dflash_drafter_adapter(server_args, worker):
+    config = load_online_adaptation(server_args)
+    if config is None or config.parameter_scope != "drafter":
+        return None
+    return DFlashDrafterAdapter(server_args, worker)
