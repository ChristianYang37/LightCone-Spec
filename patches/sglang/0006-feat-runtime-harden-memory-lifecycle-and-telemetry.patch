--- a/python/sglang/srt/entrypoints/engine.py
+++ b/python/sglang/srt/entrypoints/engine.py
@@ -1136,26 +1136,55 @@ class Engine(EngineScoreMixin, EngineBase):
         """Shutdown the engine; block until the scheduler subprocess releases
         its GPU context so the caller can immediately reallocate on the same
         device."""
-        if (
-            self.tokenizer_manager is not None
-            and self.tokenizer_manager._subprocess_watchdog is not None
-        ):
-            self.tokenizer_manager._subprocess_watchdog.stop()
+        tokenizer_manager = getattr(self, "tokenizer_manager", None)
+        subprocess_watchdog = getattr(
+            tokenizer_manager, "_subprocess_watchdog", None
+        )
+        owned_processes = ()
+        if subprocess_watchdog is not None:
+            owned_processes = subprocess_watchdog.processes
+            subprocess_watchdog.stop()
+            tokenizer_manager._subprocess_watchdog = None
+
+        metrics_collector = getattr(
+            getattr(self, "tokenizer_manager", None), "metrics_collector", None
+        )
+        cpu_monitor_thread = getattr(
+            getattr(self, "tokenizer_manager", None), "cpu_monitor_thread", None
+        )
+        if cpu_monitor_thread is not None:
+            from sglang.srt.observability.cpu_monitor import (
+                stop_cpu_monitor_thread,
+            )
+
+            stop_cpu_monitor_thread(cpu_monitor_thread)
+        close_metrics = getattr(metrics_collector, "close", None)
+        if close_metrics is not None:
+            close_metrics()
 
         send_to_rpc = getattr(self, "send_to_rpc", None)
         if send_to_rpc is not None:
             send_to_rpc.close(linger=0)
             self.send_to_rpc = None
 
-        # Gracefully stop weight cache daemons *before* the blanket
-        # kill_process_tree below, so their SIGTERM handlers can unlink the
+        # Gracefully stop weight cache daemons before the Engine workers, so
+        # their SIGTERM handlers can unlink the
         # .sock/.ready files instead of being SIGKILLed and leaving stale state.
         daemon_procs = getattr(self, "_weight_cache_daemon_procs", None)
         if daemon_procs:
             self._terminate_weight_cache_daemons(daemon_procs)
             self._weight_cache_daemon_procs = []
 
-        kill_process_tree(os.getpid(), include_parent=False, wait_timeout=60)
+        # Reap only the scheduler/detokenizer trees owned by this Engine.
+        # Killing every child of the caller also kills unrelated pools and
+        # Python resource trackers when Engines are embedded sequentially.
+        for process in owned_processes:
+            kill_process_tree(process.pid, include_parent=True, wait_timeout=60)
+            process.join(timeout=0)
+            if not process.is_alive():
+                # Release the multiprocessing sentinel/finalizer now instead
+                # of accumulating one handle per sequential Engine instance.
+                process.close()
 
     def __enter__(self):
         return self
@@ -1232,10 +1261,22 @@ class Engine(EngineScoreMixin, EngineBase):
         internal_states = self.loop.run_until_complete(
             self.tokenizer_manager.get_internal_state()
         )
+        adaptation_fallback_reason = getattr(
+            self.tokenizer_manager.server_args,
+            "speculative_adaptation_fallback_reason",
+            None,
+        )
         return msgspec_to_builtins(
             {
                 **dataclasses.asdict(self.tokenizer_manager.server_args),
                 **self._scheduler_init_result.scheduler_infos[0],
+                # This is a runtime-only mutation and therefore is absent from
+                # dataclasses.asdict(ServerArgs).  Surface it explicitly so
+                # benchmark orchestration cannot mistake a target-only safety
+                # fallback for a completed adaptation run with empty telemetry.
+                "speculative_adaptation_fallback_reason": (
+                    adaptation_fallback_reason
+                ),
                 "internal_states": internal_states,
                 "version": __version__,
             }
