 class TestSemanticValidMask(unittest.TestCase):
+    def test_device_prefix_overrides_overlap_delayed_output_ids(self):
+        requests = [
+            SimpleNamespace(
+                origin_input_ids=[1, 2, 3, 4, 5],
+                output_ids=[6, 7, 8],
+                eos_token_ids={9},
+                sampling_params=SimpleNamespace(
+                    max_new_tokens=20,
+                    stop_token_ids={10},
+                    ignore_eos=False,
+                ),
+            ),
+            SimpleNamespace(
+                origin_input_ids=[1, 2],
+                output_ids=[],
+                eos_token_ids=set(),
+                sampling_params=SimpleNamespace(
+                    max_new_tokens=8,
+                    stop_token_ids=None,
+                    ignore_eos=True,
+                ),
+            ),
+        ]
+        remaining, terminal_ids, ignore_eos = request_boundary_metadata(
+            requests,
+            prefix_lens=torch.tensor([24, 6], dtype=torch.int64),
+        )
+        torch.testing.assert_close(remaining, torch.tensor([1, 4]))
+        self.assertEqual(terminal_ids, [(9, 10), ()])
+        self.assertEqual(ignore_eos, [False, True])
+
+        mask = semantic_valid_mask(
+            proposal_tokens=torch.tensor([[1, 2, 3], [4, 5, 6]]),
+            correct_len=torch.tensor([3, 3]),
+            remaining_output_tokens=remaining,
+            terminal_token_ids=terminal_ids,
+            ignore_eos=ignore_eos,
+        )
+        torch.testing.assert_close(
+            mask,
+            torch.tensor([[True, False, False], [True, True, True]]),
+        )
+
     def test_full_canvas_terminal_and_request_boundary(self):
         proposals = torch.tensor([[5, 9, 7, 8], [1, 2, 3, 4], [6, 7, 8, 9]])
         mask = semantic_valid_mask(
@@ -1780,6 +1824,28 @@ class TestHistoryGather(unittest.TestCase):
 
 @unittest.skipUnless(torch.cuda.is_available(), "CUDA publication test")
 class TestCudaFixedAddress(unittest.TestCase):
