diff --git a/python/sglang/srt/speculative/online_valid_mask.py b/python/sglang/srt/speculative/online_valid_mask.py
index a8762fa..91fca3a 100644
--- a/python/sglang/srt/speculative/online_valid_mask.py
+++ b/python/sglang/srt/speculative/online_valid_mask.py
@@ -9,19 +9,45 @@ import torch
 
 def request_boundary_metadata(
     requests: Sequence[object],
-) -> tuple[list[int], list[tuple[int, ...]], list[bool]]:
-    """Extract max-token and terminal semantics once for every backend."""
-    remaining: list[int] = []
+    *,
+    prefix_lens: torch.Tensor | None = None,
+) -> tuple[torch.Tensor | list[int], list[tuple[int, ...]], list[bool]]:
+    """Extract request-boundary semantics without trusting delayed host state.
+
+    Under overlap scheduling, ``Req.output_ids`` trails the committed device
+    prefix by one speculative step.  Adapted workers therefore pass their
+    device-resident prefix lengths so the request budget remains exact without
+    a device-to-host synchronization.
+    """
+    if prefix_lens is not None and (
+        prefix_lens.ndim != 1 or prefix_lens.shape[0] != len(requests)
+    ):
+        raise ValueError("prefix_lens must have one value per request")
+    remaining_host: list[int] = []
+    boundaries: list[tuple[int, int]] = []
     terminal_ids: list[tuple[int, ...]] = []
     ignore_eos: list[bool] = []
     for request in requests:
-        generated = len(request.output_ids)
         sampling = request.sampling_params
-        remaining.append(max(int(sampling.max_new_tokens) - generated, 0))
+        maximum = int(sampling.max_new_tokens)
+        if prefix_lens is None:
+            remaining_host.append(max(maximum - len(request.output_ids), 0))
+        else:
+            boundaries.append((len(request.origin_input_ids), maximum))
         stops = set(getattr(request, "eos_token_ids", None) or ())
         stops.update(getattr(sampling, "stop_token_ids", None) or ())
         terminal_ids.append(tuple(sorted(int(token) for token in stops)))
         ignore_eos.append(bool(getattr(sampling, "ignore_eos", False)))
+    if prefix_lens is None:
+        remaining: torch.Tensor | list[int] = remaining_host
+    else:
+        bounds = torch.tensor(
+            boundaries,
+            device=prefix_lens.device,
+            dtype=prefix_lens.dtype,
+        ).reshape(-1, 2)
+        generated = prefix_lens.detach() - bounds[:, 0]
+        remaining = (bounds[:, 1] - generated).clamp_min(0)
     return remaining, terminal_ids, ignore_eos
 
 
@@ -29,7 +55,7 @@ def semantic_proposal_semantics(
     *,
     proposal_tokens: torch.Tensor,
     correct_len: torch.Tensor,
-    remaining_output_tokens: Sequence[int],
+    remaining_output_tokens: Sequence[int] | torch.Tensor,
     terminal_token_ids: Sequence[Sequence[int]],
     ignore_eos: Sequence[bool],
 ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
@@ -46,21 +72,29 @@ def semantic_proposal_semantics(
     batch, depth = proposal_tokens.shape
     if correct_len.shape != (batch,):
         raise ValueError("correct_len must have one value per request")
-    if not (
-        len(remaining_output_tokens)
-        == len(terminal_token_ids)
-        == len(ignore_eos)
-        == batch
-    ):
+    if isinstance(remaining_output_tokens, torch.Tensor):
+        remaining_count = (
+            remaining_output_tokens.shape[0]
+            if remaining_output_tokens.ndim == 1
+            else -1
+        )
+    else:
+        remaining_count = len(remaining_output_tokens)
+    if not (remaining_count == len(terminal_token_ids) == len(ignore_eos) == batch):
         raise ValueError("request-boundary metadata length mismatch")
     positions = torch.arange(
         depth, device=proposal_tokens.device, dtype=correct_len.dtype
     )[None, :]
-    remaining = torch.tensor(
-        remaining_output_tokens,
-        device=proposal_tokens.device,
-        dtype=correct_len.dtype,
-    )
+    if isinstance(remaining_output_tokens, torch.Tensor):
+        if remaining_output_tokens.device != proposal_tokens.device:
+            raise ValueError("remaining budget must stay on the proposal device")
+        remaining = remaining_output_tokens.detach().to(dtype=correct_len.dtype)
+    else:
+        remaining = torch.tensor(
+            remaining_output_tokens,
+            device=proposal_tokens.device,
+            dtype=correct_len.dtype,
+        )
     valid = positions < remaining[:, None]
     # The target bonus is committed only when the accepted draft prefix and
     # request boundary leave room for it.
