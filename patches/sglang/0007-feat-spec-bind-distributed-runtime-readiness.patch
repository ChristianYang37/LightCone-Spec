+            "arm_fail_once_prepare_collective",
+            "enter_all_rank_prepare_collective",
+            "collective_aborted_on_all_ranks_without_apply",
+            "fresh_communicator_generation_barrier_converges",
+            "communicator_failures",
+        ),
+        "parameters": (("collective", "prepare"), ("failure_count", "1")),
+    },
+    "replica_drain": {
+        "operations": (
+            "arm_replica_one_with_inflight_request",
+            "mark_replica_one_draining",
+            "new_admissions_fenced_and_inflight_terminal",
+            "zero_inflight_then_route_set_restored",
+            "replica_drain_events",
+        ),
+        "parameters": (("replica", "1"), ("route_policy", "fence_then_restore")),
+    },
+    "replica_restart": {
+        "operations": (
+            "record_replica_one_process_generation",
+            "terminate_and_restart_replica_one",
+            "old_generation_fenced_and_new_process_observed",
+            "new_generation_ready_then_route_restored",
+            "replica_restart_events",
+        ),
+        "parameters": (("generation_delta", "1"), ("replica", "1")),
+    },
+}
+
+_UNIVERSAL_COUNTERS = (
+    "exactness_violations",
+    "fallbacks",
+    "partial_target_continuations",
+    "retractions",
+    "version_mismatches",
+)
+_PHASES = ("arm", "trigger", "proof", "recover", "terminal")
+_SHA = frozenset("0123456789abcdef")
+_QUOTA_ROOT_BASE_ENVIRONMENT = "LIGHTCONE_FAILURE_ACTUATOR_QUOTA_ROOT_BASE"
+
+
+def _canonical(value: object) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode("utf-8")
+
+
+def _sha(value: object) -> str:
+    return hashlib.sha256(_canonical(value)).hexdigest()
+
+
+def _require_sha(label: str, value: object) -> str:
+    if type(value) is not str or len(value) != 64 or any(ch not in _SHA for ch in value):
+        raise ValueError(f"{label} must be a lowercase SHA-256")
+    return value
+
+
+def _process_start_monotonic_ns(process_id: int) -> int:
+    raw = Path(f"/proc/{process_id}/stat").read_text(encoding="ascii")
+    tail = raw[raw.rindex(")") + 2 :].split()
+    return int(tail[19]) * 1_000_000_000 // int(os.sysconf("SC_CLK_TCK"))
+
+
+def _visible_gpu_uuids() -> tuple[str, ...]:
+    visible = os.environ.get("CUDA_VISIBLE_DEVICES") or os.environ.get(
+        "NVIDIA_VISIBLE_DEVICES"
+    )
+    if visible is None:
+        raise RuntimeError("failure actuator lacks visible GPU UUIDs")
+    values = tuple(value.strip() for value in visible.split(","))
+    if not values or any(not value.startswith("GPU-") for value in values):
+        raise RuntimeError("failure actuator visible GPU UUIDs are noncanonical")
+    return values
+
+
+def _private_quota_root(raw: str) -> Path:
+    root = Path(raw)
+    if not root.is_absolute() or root.resolve(strict=True) != root or root.is_symlink():
+        raise ValueError("failure actuator quota root is not exact")
+    metadata = root.stat(follow_symlinks=False)
+    if (
+        not stat.S_ISDIR(metadata.st_mode)
+        or metadata.st_uid != os.geteuid()
+        or stat.S_IMODE(metadata.st_mode) & 0o077
+    ):
+        raise ValueError("failure actuator quota root is not private")
+    return root
+
+
+class SourceOwnedFailureActuatorRuntime:
+    """One fresh rank process and one exact deterministic failure lifecycle."""
+
+    def __init__(
+        self,
+        *,
+        assignment_sha256: str,
+        inventory_sha256: str,
+        launch_binding_sha256: str | None,
+        plan_sha256: str,
+        run_nonce_sha256: str,
+        topology: str,
+        rank: int,
+        world_size: int,
+        gpu_uuid: str,
+        quota_root: Path,
+        require_cuda: bool,
+    ) -> None:
+        for label, value in (
+            ("assignment", assignment_sha256),
+            ("inventory", inventory_sha256),
+            ("plan", plan_sha256),
+            ("run nonce", run_nonce_sha256),
+        ):
+            _require_sha(f"failure {label}", value)
+        if launch_binding_sha256 is not None:
+            _require_sha("failure launch", launch_binding_sha256)
+        expected = {"tp1_dp1": 1, "tp2_dp1": 2, "tp1_dp2": 2}
+        if (
+            topology not in expected
+            or world_size != expected[topology]
+            or rank not in range(world_size)
+        ):
+            raise ValueError("failure topology/rank scope differs")
+        if gpu_uuid not in _visible_gpu_uuids():
+            raise ValueError("failure assigned GPU UUID is not visible")
+        self.assignment_sha256 = assignment_sha256
+        self.inventory_sha256 = inventory_sha256
+        self.launch_binding_sha256 = launch_binding_sha256
+        self.plan_sha256 = plan_sha256
+        self.run_nonce_sha256 = run_nonce_sha256
+        self.topology = topology
+        self.rank = rank
+        self.world_size = world_size
+        self.gpu_uuid = gpu_uuid
+        self.quota_root = _private_quota_root(str(quota_root))
+        self.process_id = os.getpid()
+        self.process_group_id = os.getpgid(0)
+        self.process_start_monotonic_ns = _process_start_monotonic_ns(self.process_id)
+        self.require_cuda = require_cuda
+        if require_cuda and (not torch.cuda.is_available() or torch.cuda.device_count() < 1):
+            raise RuntimeError("formal failure actuator requires a live CUDA device")
+        self.scenario: str | None = None
+        self.semantics_sha256: str | None = None
+        self.next_phase = 0
+        self.last_ns = self.process_start_monotonic_ns
+        self.state: dict[str, Any] = {}
+        self.counter = 0
+        self.recovered = False
+        self.failed = False
+
+    @classmethod
+    def from_environment(
+        cls,
+        *,
+        topology: str,
+        rank: int,
+        world_size: int,
+        gpu_index: int,
+    ) -> SourceOwnedFailureActuatorRuntime | None:
+        if os.environ.get("LIGHTCONE_FAILURE_ACTUATOR_ENABLE") != "1":
+            return None
+        required = (
+            "ASSIGNMENT_SHA256",
+            "INVENTORY_SHA256",
+            "PLAN_SHA256",
+            "RUN_NONCE_SHA256",
+            "QUOTA_ROOT_BASE",
+        )
+        values = {}
+        for suffix in required:
+            key = (
+                _QUOTA_ROOT_BASE_ENVIRONMENT
+                if suffix == "QUOTA_ROOT_BASE"
+                else f"LIGHTCONE_FAILURE_ACTUATOR_{suffix}"
+            )
+            if key not in os.environ:
+                raise RuntimeError(f"failure actuator environment lacks {key}")
+            values[suffix] = os.environ[key]
+        visible = _visible_gpu_uuids()
+        if gpu_index not in range(len(visible)):
+            raise RuntimeError("failure actuator GPU index is not visible")
+        quota_base = _private_quota_root(values["QUOTA_ROOT_BASE"])
+        quota_root = quota_base / f"{topology}-rank-{rank}"
+        quota_root.mkdir(mode=0o700, exist_ok=False)
+        return cls(
+            assignment_sha256=values["ASSIGNMENT_SHA256"],
+            inventory_sha256=values["INVENTORY_SHA256"],
+            launch_binding_sha256=None,
+            plan_sha256=values["PLAN_SHA256"],
+            run_nonce_sha256=values["RUN_NONCE_SHA256"],
+            topology=topology,
+            rank=rank,
+            world_size=world_size,
+            gpu_uuid=visible[gpu_index],
+            quota_root=quota_root,
+            require_cuda=True,
+        )
+
+    def capability(self) -> dict[str, object]:
+        """Return the exact live rank identity used to build a launch binding."""
+
+        self._revalidate_live_identity()
+        return {
+            "schema_version": 1,
+            "hook": FAILURE_ACTUATOR_HOOK,
+            "protocol_sha256": FAILURE_ACTUATOR_PROTOCOL_SHA256,
+            "assignment_sha256": self.assignment_sha256,
+            "inventory_sha256": self.inventory_sha256,
+            "plan_sha256": self.plan_sha256,
+            "run_nonce_sha256": self.run_nonce_sha256,
+            "topology": self.topology,
+            "rank": self.rank,
+            "world_size": self.world_size,
+            "process_id": self.process_id,
+            "process_group_id": self.process_group_id,
+            "process_start_monotonic_ns": self.process_start_monotonic_ns,
+            "gpu_uuid": self.gpu_uuid,
+            "temp_quota_root": str(self.quota_root),
+        }
+
+    def _revalidate_live_identity(self) -> None:
+        if self.failed:
+            raise RuntimeError("failure actuator process is terminally failed")
+        if (
+            os.getpid() != self.process_id
+            or os.getpgid(0) != self.process_group_id
+            or _process_start_monotonic_ns(os.getpid())
+            != self.process_start_monotonic_ns
+        ):
+            raise RuntimeError("failure actuator process generation changed")
+        if self.gpu_uuid not in _visible_gpu_uuids():
+            raise RuntimeError("failure actuator GPU assignment changed")
+        try:
+            _private_quota_root(str(self.quota_root))
+        except (OSError, ValueError) as error:
+            raise RuntimeError("failure actuator quota scope changed") from error
+
+    def fail_closed(self) -> None:
+        """Fence this process after any malformed or failed lifecycle command."""
+
+        self.failed = True
+        descriptor = self.state.get("descriptor")
+        if isinstance(descriptor, int):
+            try:
+                os.close(descriptor)
+            except OSError:
+                pass
+            self.state["descriptor"] = None
+        process = self.state.get("process")
+        if isinstance(process, subprocess.Popen) and process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=5)
+        for key in ("sender", "receiver"):
+            channel = self.state.get(key)
+            if isinstance(channel, socket.socket):
+                channel.close()
+        for key in ("cancel", "release"):
+            event = self.state.get(key)
+            if isinstance(event, threading.Event):
+                event.set()
+
+    def _validate_command(self, command: dict[str, object]) -> tuple[str, str, str]:
+        expected = {
+            "schema_version", "kind", "protocol_sha256", "launch_binding_sha256",
+            "assignment_sha256", "inventory_sha256", "plan_sha256", "scenario",
+            "scenario_semantics_sha256", "phase", "operation", "parameters",
+            "topology", "rank", "process_id", "process_group_id",
+            "process_start_monotonic_ns", "gpu_uuid", "temp_quota_root",
+            "run_nonce_sha256",
+        }
+        self._revalidate_live_identity()
+        if set(command) != expected:
+            raise ValueError("failure actuator command fields differ")
+        scenario = command["scenario"]
+        phase = command["phase"]
+        operation = command["operation"]
+        if type(scenario) is not str or scenario not in _SCENARIOS:
+            raise ValueError("failure actuator scenario is unsupported")
+        if type(phase) is not str or phase != _PHASES[self.next_phase]:
+            raise ValueError("failure actuator phase is replayed or out of order")
+        if type(operation) is not str:
+            raise TypeError("failure actuator operation must be text")
+        semantics = _SCENARIOS[scenario]
+        if operation != semantics["operations"][self.next_phase]:
+            raise ValueError("failure actuator operation differs from semantics")
+        parameters = command["parameters"]
+        if (
+            type(parameters) is not list
+            or tuple(tuple(row) for row in parameters) != semantics["parameters"]
+        ):
+            raise ValueError("failure actuator parameters differ from semantics")
+        if (
+            command["schema_version"] != 1
+            or command["kind"] != "lightcone_e5_failure_actuator_command"
+            or command["protocol_sha256"] != FAILURE_ACTUATOR_PROTOCOL_SHA256
+            or command["assignment_sha256"] != self.assignment_sha256
+            or command["inventory_sha256"] != self.inventory_sha256
+            or command["plan_sha256"] != self.plan_sha256
+            or command["run_nonce_sha256"] != self.run_nonce_sha256
+            or command["topology"] != self.topology
+            or command["rank"] != self.rank
+            or command["process_id"] != self.process_id
+            or command["process_group_id"] != self.process_group_id
+            or command["process_start_monotonic_ns"] != self.process_start_monotonic_ns
+            or command["gpu_uuid"] != self.gpu_uuid
+            or command["temp_quota_root"] != str(self.quota_root)
+        ):
+            raise ValueError("failure actuator command differs from live rank identity")
+        launch_binding_sha256 = _require_sha(
+            "failure launch", command["launch_binding_sha256"]
+        )
+        if self.launch_binding_sha256 is None:
+            if phase != "arm":
+                raise ValueError("failure actuator launch was not armed")
+            self.launch_binding_sha256 = launch_binding_sha256
+        elif launch_binding_sha256 != self.launch_binding_sha256:
+            raise ValueError("failure actuator launch identity changed")
+        if self.scenario is None:
+            self.scenario = scenario
+            self.semantics_sha256 = str(command["scenario_semantics_sha256"])
+            _require_sha("failure scenario semantics", self.semantics_sha256)
+        elif scenario != self.scenario or command["scenario_semantics_sha256"] != self.semantics_sha256:
+            raise ValueError("failure actuator process cannot change scenario")
+        return scenario, phase, operation
+
+    def _device(self) -> torch.device:
+        return torch.device("cuda", 0) if self.require_cuda else torch.device("cpu")
+
+    def _arm(self, scenario: str) -> None:
+        if scenario == "queue_saturation":
+            probe = queue.Queue(maxsize=1)
+            probe.put_nowait("held")
+            self.state["queue"] = probe
+        elif scenario == "cancellation":
+            cancel = threading.Event()
+            terminal = threading.Event()
+            committed = []
+            def request() -> None:
+                cancel.wait(timeout=30)
+                if not cancel.is_set():
+                    committed.append(True)
+                terminal.set()
+            thread = threading.Thread(target=request, daemon=True)
+            thread.start()
+            self.state.update(
+                cancel=cancel,
+                terminal=terminal,
+                committed=committed,
+                thread=thread,
+            )
+        elif scenario == "duplicate_retry":
+            key = _sha({"plan": self.plan_sha256, "rank": self.rank})
+            digest = _sha({"key": key, "terminal": "complete"})
+            self.state.update(idempotency={key: digest}, key=key, digest=digest, executions=1)
+        elif scenario == "nonfinite_candidate":
+            active = torch.ones(8, device=self._device())
+            self.state.update(active=active, active_version=0)
+        elif scenario == "oom_candidate":
+            self.state.update(fail_next=True, active_version=0)
+        elif scenario == "evidence_backpressure":
+            evidence = queue.Queue(maxsize=1)
+            evidence.put_nowait("first")
+            self.state["queue"] = evidence
+        elif scenario == "disk_quota":
+            path = self.quota_root / f"checkpoint-{self.run_nonce_sha256[:16]}.bin"
+            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            self.state.update(path=path, descriptor=descriptor, fault_armed=True)
+        elif scenario == "slow_rank":
+            self.state.update(active_version=0, published=False, generation=0)
+        elif scenario == "communicator_failure":
+            sender, receiver = socket.socketpair()
+            self.state.update(
+                active_version=0,
+                published=False,
+                generation=0,
+                sender=sender,
+                receiver=receiver,
+            )
+        elif scenario == "replica_drain":
+            release = threading.Event()
+            done = threading.Event()
+            def inflight() -> None:
+                release.wait(timeout=30)
+                done.set()
+            thread = threading.Thread(target=inflight, daemon=True)
+            thread.start()
+            self.state.update(release=release, done=done, thread=thread, draining=False, admissions=1)
+        elif scenario == "replica_restart":
+            process = subprocess.Popen(
+                [sys.executable, "-c", "import time; time.sleep(300)"],
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                close_fds=True,
+                start_new_session=True,
+            )
+            self.state.update(process=process, first_pid=process.pid, generation=0)
+
+    def _trigger(self, scenario: str) -> None:
+        if scenario == "queue_saturation":
+            try:
+                self.state["queue"].put_nowait("overflow")
+            except queue.Full:
+                self.counter += 1
+            else:
+                raise RuntimeError("failure admission queue did not saturate")
+        elif scenario == "cancellation":
+            self.state["cancel"].set()
+            if not self.state["terminal"].wait(timeout=30):
+                raise RuntimeError("failure cancellation did not terminate")
+            self.counter += 1
+        elif scenario == "duplicate_retry":
+            if self.state["idempotency"].get(self.state["key"]) != self.state["digest"]:
+                raise RuntimeError("failure idempotency record changed")
+            self.counter += 1
+        elif scenario == "nonfinite_candidate":
+            candidate = self.state["active"].clone()
+            candidate.fill_(float("nan"))
+            if bool(torch.isfinite(candidate).all()):
+                raise RuntimeError("failure candidate remained finite")
+            self.state["candidate"] = candidate
+            self.counter += 1
+        elif scenario == "oom_candidate":
+            if not self.state.pop("fail_next"):
+                raise RuntimeError("failure allocator was not armed")
+            try:
+                raise torch.cuda.OutOfMemoryError("source-owned fail-once candidate allocator")
+            except torch.cuda.OutOfMemoryError:
+                self.counter += 1
+        elif scenario == "evidence_backpressure":
+            started = threading.Event()
+            completed = threading.Event()
+            def producer() -> None:
+                started.set()
+                self.state["queue"].put("second", timeout=30)
+                completed.set()
+            thread = threading.Thread(target=producer, daemon=True)
+            thread.start()
+            if not started.wait(timeout=5):
+                raise RuntimeError("failure evidence producer did not start")
+            time.sleep(0.01)
+            if completed.is_set():
+                raise RuntimeError("failure evidence queue did not backpressure")
+            self.state.update(producer=thread, producer_completed=completed)
+            self.counter += 1
+        elif scenario == "disk_quota":
+            try:
+                if self.state.pop("fault_armed"):
+                    raise OSError(errno.ENOSPC, "source-owned fail-once checkpoint fsync")
+            except OSError as error:
+                if error.errno != errno.ENOSPC:
+                    raise
+                self.counter += 1
+        elif scenario == "slow_rank":
+            if self.rank == 1:
+                time.sleep(0.05)
+            self.state["slow_detected"] = True
+            self.counter += 1
+        elif scenario == "communicator_failure":
+            receiver = self.state["receiver"]
+            receiver.shutdown(socket.SHUT_RDWR)
+            receiver.close()
+            try:
+                self.state["sender"].sendall(b"prepare")
+            except (BrokenPipeError, ConnectionResetError, OSError):
+                self.state["collective_aborted"] = True
+            else:
+                raise RuntimeError("failure communicator did not abort")
+            self.counter += 1
+        elif scenario == "replica_drain":
+            self.state["draining"] = True
+            self.state["admissions"] = 0
+            self.counter += 1
+        elif scenario == "replica_restart":
+            process = self.state["process"]
+            process.terminate()
+            process.wait(timeout=30)
+            replacement = subprocess.Popen(
+                [sys.executable, "-c", "import time; time.sleep(300)"],
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                close_fds=True,
+                start_new_session=True,
+            )
+            if replacement.pid == self.state["first_pid"]:
+                replacement.terminate()
+                replacement.wait(timeout=30)
+                raise RuntimeError("failure replica process generation did not change")
+            self.state.update(process=replacement, generation=1)
+            self.counter += 1
+
+    def _prove(self, scenario: str) -> None:
+        if scenario == "queue_saturation":
+            valid = self.state["queue"].full()
+        elif scenario == "cancellation":
+            valid = self.state["terminal"].is_set() and not self.state["committed"]
+        elif scenario == "duplicate_retry":
+            valid = (
+                self.state["executions"] == 1
+                and len(self.state["idempotency"]) == 1
+            )
+        elif scenario == "nonfinite_candidate":
+            valid = self.state["active_version"] == 0 and not bool(
+                torch.isfinite(self.state["candidate"]).all()
+            )
+        elif scenario == "oom_candidate":
+            valid = self.state["active_version"] == 0
+        elif scenario == "evidence_backpressure":
+            valid = not self.state["producer_completed"].is_set()
+        elif scenario == "disk_quota":
+            valid = self.state["path"].stat().st_size == 0
+        elif scenario == "slow_rank":
+            valid = (
+                self.state.get("slow_detected") is True
+                and not self.state["published"]
+            )
+        elif scenario == "communicator_failure":
+            valid = (
+                self.state.get("collective_aborted") is True
+                and not self.state["published"]
+            )
+        elif scenario == "replica_drain":
+            valid = self.state["draining"] is True and self.state["admissions"] == 0
+        else:
+            valid = (
+                self.state["generation"] == 1
+                and self.state["process"].poll() is None
+            )
+        if not valid or self.counter < 1:
+            raise RuntimeError("failure actuator did not prove the injected condition")
+
+    def _recover(self, scenario: str) -> None:
+        if scenario == "queue_saturation":
+            self.state["queue"].get_nowait()
+            if not self.state["queue"].empty():
+                raise RuntimeError("failure admission queue did not recover")
+        elif scenario == "cancellation":
+            self.state["thread"].join(timeout=30)
+            if self.state["thread"].is_alive() or self.state["committed"]:
+                raise RuntimeError("failure cancelled request did not recover")
+        elif scenario == "duplicate_retry":
+            if len(self.state["idempotency"]) != 1 or self.state["executions"] != 1:
+                raise RuntimeError("failure duplicate recovery changed execution count")
+        elif scenario == "nonfinite_candidate":
+            self.state.pop("candidate")
+            if not bool(torch.isfinite(self.state["active"]).all()):
+                raise RuntimeError("failure active candidate became nonfinite")
+        elif scenario == "oom_candidate":
+            probe = torch.empty(1, device=self._device())
+            if probe.numel() != 1:
+                raise RuntimeError("failure allocator did not recover")
+        elif scenario == "evidence_backpressure":
+            first = self.state["queue"].get(timeout=5)
+            if first != "first" or not self.state["producer_completed"].wait(timeout=30):
+                raise RuntimeError("failure evidence queue did not resume")
+            second = self.state["queue"].get(timeout=5)
+            self.state["producer"].join(timeout=30)
+            if second != "second" or not self.state["queue"].empty():
+                raise RuntimeError("failure evidence queue lost a row")
+        elif scenario == "disk_quota":
+            descriptor = self.state["descriptor"]
+            os.write(descriptor, b"recovered\n")
+            os.fsync(descriptor)
+            os.close(descriptor)
+            self.state["descriptor"] = None
+            if self.state["path"].stat().st_size < 1:
+                raise RuntimeError("failure recovery checkpoint was not durable")
+        elif scenario == "slow_rank":
+            self.state["generation"] += 1
+            self.state["published"] = False
+        elif scenario == "communicator_failure":
+            self.state["sender"].close()
+            sender, receiver = socket.socketpair()
+            sender.sendall(b"recovered")
+            if receiver.recv(9) != b"recovered":
+                sender.close()
+                receiver.close()
+                raise RuntimeError("failure communicator generation did not recover")
+            self.state.update(
+                sender=sender,
+                receiver=receiver,
+                generation=self.state["generation"] + 1,
+                published=False,
+            )
+        elif scenario == "replica_drain":
+            self.state["release"].set()
+            if not self.state["done"].wait(timeout=30):
+                raise RuntimeError("failure drained request did not terminate")
+            self.state["thread"].join(timeout=30)
+            self.state.update(draining=False, admissions=1)
+        elif scenario == "replica_restart":
+            if self.state["process"].poll() is not None or self.state["generation"] != 1:
+                raise RuntimeError("failure replacement replica is not ready")
+        self.recovered = True
+
+    def _terminal(self, scenario: str) -> None:
+        if not self.recovered or self.counter < 1:
+            raise RuntimeError("failure actuator terminal lacks recovery")
+        if scenario == "disk_quota":
+            self.state["path"].unlink()
+        elif scenario == "communicator_failure":
+            self.state["sender"].close()
+            self.state["receiver"].close()
+        elif scenario == "replica_restart":
+            process = self.state["process"]
+            process.terminate()
+            process.wait(timeout=30)
+
+    def handle(self, command: dict[str, object]) -> dict[str, object]:
+        try:
+            scenario, phase, operation = self._validate_command(command)
+            if phase == "arm":
+                self._arm(scenario)
+            elif phase == "trigger":
+                self._trigger(scenario)
+            elif phase == "proof":
+                self._prove(scenario)
+            elif phase == "recover":
+                self._recover(scenario)
+            else:
+                self._terminal(scenario)
+        except Exception:
+            self.fail_closed()
+            raise
+        now = max(time.monotonic_ns(), self.last_ns + 1)
+        self.last_ns = now
+        event_count = 1
+        observation = {
+            "schema_version": 1,
+            "kind": "e5_first_party_failure_phase_observation",
+            "protocol_sha256": FAILURE_ACTUATOR_PROTOCOL_SHA256,
+            "plan_sha256": self.plan_sha256,
+            "scenario_semantics_sha256": self.semantics_sha256,
+            "topology": self.topology,
+            "rank": self.rank,
+            "world_size": self.world_size,
+            "process_id": self.process_id,
+            "process_start_monotonic_ns": self.process_start_monotonic_ns,
+            "session_epoch": 0,
+            "run_nonce_sha256": self.run_nonce_sha256,
+            "phase": phase,
+            "operation": operation,
+            "event_count": event_count,
+        }
+        response: dict[str, object] = {
+            "phase": phase,
+            "operation": operation,
+            "monotonic_ns": now,
+            "event_count": event_count,
+            "observation_sha256": _sha(observation),
+        }
+        if phase == "terminal":
+            counter_name = _SCENARIOS[scenario]["operations"][-1]
+            counters = {name: 0 for name in _UNIVERSAL_COUNTERS}
+            counters[str(counter_name)] = self.counter
+            response.update(counters=counters, recovery_valid=True)
+        self.next_phase += 1
+        return response
+
+
+__all__ = (
+    "FAILURE_ACTUATOR_HOOK",
+    "FAILURE_ACTUATOR_PROTOCOL_SHA256",
+    "SourceOwnedFailureActuatorRuntime",
+)
diff --git a/python/sglang/srt/speculative/formal_gang_serving.py b/python/sglang/srt/speculative/formal_gang_serving.py
new file mode 100644
