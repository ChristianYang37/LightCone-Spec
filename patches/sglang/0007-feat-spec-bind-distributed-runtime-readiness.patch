+"""Exact non-skippable live DSpark qualification."""
+
+import pytest
+from lightcone_live_qualification import (
+    LiveQualificationHarness,
+    require_live_contract,
+)
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("dspark_tp1")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="DSPARK")
+    return case
+
+
+def test_dspark_real_predecessor(live_suite) -> None:
+    case = _case(live_suite, "dspark_real_predecessor")
+    assert len(case.adaptation["native_last_source_tensor_shapes"]) == 6
+    assert case.adaptation["native_last_source_tensor_shapes"][4][1] > 0
+
+
+def test_dspark_markov_w1_w2(live_suite) -> None:
+    case = _case(live_suite, "dspark_markov_w1_w2")
+    names = set(case.adaptation["dspark_native_head_names"])
+    assert {"markov_head.markov_w1.weight", "markov_head.markov_w2.weight"} <= names
+
+
+def test_dspark_confidence_head(live_suite) -> None:
+    case = _case(live_suite, "dspark_confidence_head")
+    assert "confidence_head.proj.weight" in case.adaptation["dspark_native_head_names"]
+
+
+def test_dspark_56_scope_selector(live_suite) -> None:
+    case = _case(live_suite, "dspark_56_scope_selector")
+    assert case.adaptation["dspark_selector_size"] == 56
+    assert len(case.adaptation["dspark_selector_candidate_id"]) == 64
+
+
+def test_dspark_fixed_budget(live_suite) -> None:
+    case = _case(live_suite, "dspark_fixed_budget")
