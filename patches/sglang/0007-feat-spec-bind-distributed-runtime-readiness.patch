+def _merge_sglang_native_token_timestamp_result_pointer(
+    accumulated: Optional[Dict[str, Any]],
+    response_pointer: Any,
+) -> Dict[str, Any]:
+    """Retain one exact first-party terminal pointer across SSE chunks."""
+
+    fields = {
+        "schema_version",
+        "kind",
+        "hook",
+        "semantics",
+        "release_status",
+        "request_id",
+        "request_started_ns",
+        "request_terminal_ns",
+        "terminal_status",
+        "terminal_reason",
+        "events",
+        "result_pointer_sha256",
+    }
+    if not isinstance(response_pointer, dict) or set(response_pointer) != fields:
+        raise ValueError("SGLang native result pointer fields are incomplete")
+    value = copy.deepcopy(response_pointer)
+    digest = value.pop("result_pointer_sha256")
+    expected = hashlib.sha256(
+        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+    ).hexdigest()
+    if (
+        digest != expected
+        or value["schema_version"] != 1
+        or value["kind"] != "sglang_native_itl_result_pointer"
+        or value["hook"] != "sglang.schema_v3.native_per_token_timestamp.v2"
+        or value["semantics"]
+        != "scheduler_committed_token_at_result_processor_v1"
+        or value["release_status"]
+        != "IMPLEMENTED_PENDING_DYNAMIC_GPU_PROOF"
+    ):
+        raise ValueError("SGLang native result pointer identity changed")
+    value["result_pointer_sha256"] = digest
+    if accumulated is not None and accumulated != value:
+        raise ValueError("SGLang native terminal result pointer changed")
+    return value
+
+
