+"""Exact non-skippable live DSpark TP1/DP2 qualification."""
+
+import pytest
+from lightcone_live_qualification import LiveQualificationHarness, require_live_contract
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("dspark_dp2")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="DSPARK")
+    assert len(case.all_adaptation_records) == 2
+    assert all(
+        row["runtime_authority"]["topology_mode"] == "tp1_dp2"
+        and row["runtime_authority"]["qualification_only"] is True
+        for row in case.all_adaptation_records
+    )
+    return case
+
+
+def test_dspark_dp2_real_predecessor(live_suite) -> None:
+    case = _case(live_suite, "dspark_dp2_real_predecessor")
+    assert all(len(row["native_last_source_tensor_shapes"]) == 6 for row in case.all_adaptation_records)
+
+
+def test_dspark_dp2_native_heads(live_suite) -> None:
+    case = _case(live_suite, "dspark_dp2_native_heads")
+    assert all("confidence_head.proj.weight" in row["dspark_native_head_names"] for row in case.all_adaptation_records)
+
+
+def test_dspark_dp2_selector(live_suite) -> None:
+    case = _case(live_suite, "dspark_dp2_selector")
+    assert all(row["dspark_selector_size"] == 56 for row in case.all_adaptation_records)
+
+
+def test_dspark_dp2_sticky_routing(live_suite) -> None:
+    case = _case(live_suite, "dspark_dp2_sticky_routing")
+    states = [row["dp2_replica_state"] for row in case.all_adaptation_records]
+    assert all(state is not None for state in states)
+    assert all(set(state["cohort_to_replica"].values()) <= {0, 1} for state in states)
+
+
+def test_dspark_dp2_replica_state_isolation(live_suite) -> None:
+    case = _case(live_suite, "dspark_dp2_replica_state_isolation")
+    states = [row["dp2_replica_state"] for row in case.all_adaptation_records]
+    assert all(state["cross_replica_optimizer_state"] is False for state in states)
+    assert case.all_adaptation_records[0]["fixed_inference_address_sha256"] != case.all_adaptation_records[1]["fixed_inference_address_sha256"]
+
+
+def test_dspark_dp2_zero_cross_replica_gradient(live_suite) -> None:
+    case = _case(live_suite, "dspark_dp2_zero_cross_replica_gradient")
+    assert all(row["dp2_replica_state"]["cross_replica_gradient_collective"] is False for row in case.all_adaptation_records)
+
+
+def test_native_itl_pointer(live_suite) -> None:
+    case = _case(live_suite, "native_itl_pointer")
+    assert len(case.native_pointer["events"]) == 4
+
+
+def test_graph_fixed_address_no_host_sync(live_suite) -> None:
+    case = _case(live_suite, "graph_fixed_address_no_host_sync")
+    assert all(row["counters"]["graph_replay_hits"] > 0 for row in case.all_adaptation_records)
+    terminal = live_suite.formal_gang_terminal
+    assert terminal is not None
+    assert terminal["topology"] == "tp1_dp2"
+    assert terminal["decision"] == "COMMITTED"
+    assert terminal["cross_replica_gradient_collective"] is False
