+def test_dp2_sticky_replica_isolation() -> None:
+    runtime = Dp2StickyReplicaRuntime(_authority("tp1_dp2"))
+    cohorts = ("0" * 63 + "2", "0" * 63 + "3")
+    candidates = (_sha("dp2-candidate-0"), _sha("dp2-candidate-1"))
+    states = tuple(
+        runtime.apply(cohort_sha256=cohort, candidate_sha256=candidate)
+        for cohort, candidate in zip(cohorts, candidates, strict=True)
+    )
+    tensors = tuple(
+        torch.full((8,), rank + 1, dtype=torch.float32, device=rank) for rank in (0, 1)
+    )
+    events = tuple(torch.cuda.Event(blocking=False) for _ in (0, 1))
+    for rank, event in enumerate(events):
+        with torch.cuda.device(rank):
+            tensors[rank].add_(rank + 1)
+            event.record()
+    for event in events:
+        event.synchronize()
+    assert tuple(state.replica for state in states) == (0, 1)
+    assert runtime.state(1, cohorts[0]) is None
+    assert runtime.state(0, cohorts[1]) is None
+    assert tensors[0].data_ptr() != tensors[1].data_ptr()
+    _record(
+        "test_dp2_sticky_replica_isolation",
+        tuple(
+            {
+                "replica": rank,
+                "cohort_sha256": cohorts[rank],
+                "optimizer_generation": states[rank].optimizer_generation,
+                "state_sha256": states[rank].state_sha256,
+                "tensor_pointer": tensors[rank].data_ptr(),
+                "cross_replica_gradient_collective": False,
+            }
+            for rank in (0, 1)
+        ),
+    )
