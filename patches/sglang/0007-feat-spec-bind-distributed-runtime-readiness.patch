+@app.post("/v1/lightcone-spec/formal-gang/finalize")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_formal_gang_finalize(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    if set(obj) not in (
+        {"rank_reset_sha256s"},
