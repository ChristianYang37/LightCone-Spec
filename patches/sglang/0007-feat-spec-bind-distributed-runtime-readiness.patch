+"""Exact non-skippable live TP1/DP2 qualification."""
+
+import pytest
+from lightcone_live_qualification import LiveQualificationHarness, require_live_contract
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("tp1_dp2")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="DFLASH")
+    assert len(case.all_adaptation_records) == 2
+    for record in case.all_adaptation_records:
+        authority = record["runtime_authority"]
+        assert authority["topology_mode"] == "tp1_dp2"
+        assert authority["qualification_only"] is True
+    return case
+
+
+def test_dp2_two_worker_launch(live_suite) -> None:
+    _case(live_suite, "dp2_two_worker_launch")
+    rows = live_suite.compute_processes()
+    assert {row["gpu_uuid"] for row in rows} == set(live_suite.gpu_uuids)
+
+
+def test_dp2_sticky_routing(live_suite) -> None:
+    case = _case(live_suite, "dp2_sticky_routing")
+    states = [record["dp2_replica_state"] for record in case.all_adaptation_records]
+    assert all(state is not None for state in states)
+    assert all(
+        set(state["cohort_to_replica"].values()) <= {0, 1} for state in states
+    )
+
+
+def test_dp2_replica_state_isolation(live_suite) -> None:
+    case = _case(live_suite, "dp2_replica_state_isolation")
+    states = [record["dp2_replica_state"] for record in case.all_adaptation_records]
+    assert all(state["cross_replica_optimizer_state"] is False for state in states)
+    assert case.all_adaptation_records[0]["fixed_inference_address_sha256"] != (
+        case.all_adaptation_records[1]["fixed_inference_address_sha256"]
+    )
+
+
+def test_dp2_zero_cross_replica_gradient(live_suite) -> None:
+    case = _case(live_suite, "dp2_zero_cross_replica_gradient")
+    assert all(
+        record["dp2_replica_state"]["cross_replica_gradient_collective"] is False
+        for record in case.all_adaptation_records
+    )
+
+
+def test_dp2_failure_isolation(live_suite) -> None:
+    case = _case(live_suite, "dp2_failure_isolation")
+    assert all(
+        record["counters"]["communicator_failures"] == 0
+        for record in case.all_adaptation_records
+    )
+
+
+def test_dp2_rank_terminal_evidence(live_suite) -> None:
+    case = _case(live_suite, "dp2_rank_terminal_evidence")
+    assert len(case.all_adaptation_records) == len(live_suite.gpu_uuids)
+
+
+def test_native_itl_pointer(live_suite) -> None:
+    case = _case(live_suite, "native_itl_pointer")
+    assert len(case.native_pointer["events"]) == 4
+
+
+def test_graph_fixed_address_no_host_sync(live_suite) -> None:
+    case = _case(live_suite, "graph_fixed_address_no_host_sync")
+    assert all(
+        record["counters"]["graph_replay_hits"] > 0
+        for record in case.all_adaptation_records
+    )
+    terminal = live_suite.formal_gang_terminal
+    assert terminal is not None
+    assert terminal["topology"] == "tp1_dp2"
+    assert terminal["decision"] == "COMMITTED"
+    assert terminal["published_ranks"] == [0, 1]
+    assert terminal["cross_replica_gradient_collective"] is False
