+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+MODULE_PATH = (
+    Path(__file__).resolve().parents[4]
+    / "python/sglang/srt/speculative/formal_gang_serving.py"
+)
+SPEC = importlib.util.spec_from_file_location("formal_gang_serving", MODULE_PATH)
+assert SPEC is not None and SPEC.loader is not None
+gang_module = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = gang_module
+SPEC.loader.exec_module(gang_module)
+
+FORMAL_GANG_SERVING_HOOK = gang_module.FORMAL_GANG_SERVING_HOOK
+FORMAL_GANG_SERVING_PROTOCOL_SHA256 = (
+    gang_module.FORMAL_GANG_SERVING_PROTOCOL_SHA256
+)
+SourceOwnedFormalGangRuntime = gang_module.SourceOwnedFormalGangRuntime
+aggregate_formal_gang_rank_responses = (
+    gang_module.aggregate_formal_gang_rank_responses
+)
+content_sha256 = gang_module.content_sha256
+
+
+def _sha(label: str) -> str:
+    return hashlib.sha256(f"formal-gang:{label}".encode()).hexdigest()
+
+
+def _runtime(
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    topology: str,
+    rank: int,
+) -> SourceOwnedFormalGangRuntime:
+    monkeypatch.setenv("CUDA_VISIBLE_DEVICES", "GPU-test-0,GPU-test-1")
+    return SourceOwnedFormalGangRuntime(
+        assignment_sha256=_sha("assignment"),
+        inventory_sha256=_sha("inventory"),
+        execution_plan_sha256=_sha("execution-plan"),
+        rank_config_sha256=_sha("rank-config"),
+        run_nonce_sha256=_sha("nonce"),
+        topology=topology,
+        rank=rank,
+        world_size=2,
+        method="l0",
+        gpu_uuid=f"GPU-test-{rank}",
+        require_cuda=False,
+    )
+
+
+def _rows(*, topology: str, phase: str) -> list[dict[str, object]]:
+    return [
+        {
+            "request_id": f"{phase}-r{rank}",
+            "cohort_sha256": _sha(f"cohort-{rank}"),
+            "routed_dp_rank": None if topology == "tp2_dp1" else rank,
+        }
+        for rank in range(2)
+    ]
+
+
+def _begin(runtime: SourceOwnedFormalGangRuntime) -> dict[str, object]:
+    return runtime.begin(
+        {
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "assignment_sha256": runtime.assignment_sha256,
+            "inventory_sha256": runtime.inventory_sha256,
+            "execution_plan_sha256": runtime.execution_plan_sha256,
+            "rank_config_sha256": runtime.rank_config_sha256,
+            "run_nonce_sha256": runtime.run_nonce_sha256,
+            "method": runtime.method,
+            "topology": runtime.topology,
+            "warmup_requests": _rows(topology=runtime.topology, phase="warmup"),
+            "scored_requests": _rows(topology=runtime.topology, phase="scored"),
+        }
+    )
+
+
+def _note(runtime: SourceOwnedFormalGangRuntime, phase: str) -> None:
+    ranks = range(2) if runtime.topology == "tp2_dp1" else (runtime.rank,)
+    for rank in ranks:
+        runtime.note_request_terminal(
+            request_id=f"{phase}-r{rank}",
+            input_token_ids=(1, 2, rank + 3),
+            output_token_ids=(4, 5),
+            native_token_timestamp_semantics=(
+                "scheduler_committed_token_at_result_processor_v1"
+            ),
+            native_token_timestamp_events=((4, 100), (5, 120)),
+            terminal_status="completed",
+            terminal_reason="FINISH_LENGTH",
+        )
+
+
+def _client_lifecycle(
+    *, topology: str, non_submitted: frozenset[str] = frozenset()
+) -> tuple[list[dict[str, object]], str]:
+    rows = []
+    for phase in ("warmup", "scored"):
+        for scheduled in _rows(topology=topology, phase=phase):
+            request_id = str(scheduled["request_id"])
+            submitted = phase == "warmup" or request_id not in non_submitted
+            rows.append(
+                {
+                    "request_id": request_id,
+                    "phase": phase,
+                    "scheduled_arrival_us": 0,
+                    "offered": True,
+                    "offered_at_us": 0,
+                    "admitted_at_us": 0 if submitted else None,
+                    "effective_deadline_us": 100,
+                    "cancellation_at_us": None,
+                    "terminal_at_us": 10,
+                    "outcome_status": (
+                        "completed" if submitted else "rejected"
+                    ),
+                    "outcome_code": (
+                        "completed" if submitted else "admission_deadline"
+                    ),
+                    "submitted_to_server": submitted,
+                    "native_terminal_status": (
+                        "completed" if submitted else None
+                    ),
+                    "native_result_pointer_sha256": (
+                        _sha(f"pointer-{request_id}") if submitted else None
+                    ),
+                }
+            )
+    return rows, content_sha256(rows)
+
+
+def _finalize_payload(
+    *, topology: str, reset: dict[str, object], non_submitted: frozenset[str] = frozenset()
+) -> dict[str, object]:
+    rows, digest = _client_lifecycle(
+        topology=topology,
+        non_submitted=non_submitted,
+    )
+    return {
+        "hook": FORMAL_GANG_SERVING_HOOK,
+        "rank_reset_sha256s": reset["rank_reset_sha256s"],
+        "client_lifecycle_rows": rows,
+        "client_lifecycle_sha256": digest,
+    }
+
+
+@pytest.mark.parametrize("topology", ("tp2_dp1", "tp1_dp2"))
+def test_callback_free_two_rank_lifecycle_commits_exact_coverage(
+    monkeypatch: pytest.MonkeyPatch,
+    topology: str,
+) -> None:
+    runtimes = tuple(_runtime(monkeypatch, topology=topology, rank=rank) for rank in range(2))
+    capabilities = [runtime.capability() for runtime in runtimes]
+    capability = aggregate_formal_gang_rank_responses(
+        "formal_gang_capability", capabilities
+    )
+    assert capability["world_size"] == 2
+
+    begins = [_begin(runtime) for runtime in runtimes]
+    begin = aggregate_formal_gang_rank_responses("formal_gang_begin", begins)
+    assert len(begin["rank_begin_sha256s"]) == 2
+
+    for runtime in runtimes:
+        _note(runtime, "warmup")
+    resets = [
+        runtime.reset(
+            {
+                "hook": FORMAL_GANG_SERVING_HOOK,
+                "rank_begin_sha256s": begin["rank_begin_sha256s"],
+            },
+            native_state={"phase": "warmup", "rank": runtime.rank},
+        )
+        for runtime in runtimes
+    ]
+    reset = aggregate_formal_gang_rank_responses("formal_gang_reset", resets)
+    assert reset["decision"] == "COMMITTED"
+    assert reset["published_ranks"] == [0, 1]
+
+    for runtime in runtimes:
+        _note(runtime, "scored")
+    finals = [
+        runtime.finalize(
+            _finalize_payload(topology=topology, reset=reset),
+            native_state={"phase": "scored", "rank": runtime.rank},
+        )
+        for runtime in runtimes
+    ]
+    terminal = aggregate_formal_gang_rank_responses(
+        "formal_gang_finalize", finals
+    )
+    assert terminal["decision"] == "COMMITTED"
+    assert len(set(terminal["rank_terminal_sha256s"])) == 2
+    assert terminal["cross_replica_gradient_collective"] is False
+    for rank_terminal in terminal["rank_terminals"]:
+        for request in rank_terminal["request_terminals"]:
+            assert request["native_itl_semantics"] == (
+                "scheduler_committed_token_at_result_processor_v1"
+            )
+            assert request["native_itl_event_count"] == 2
+            assert len(request["native_itl_events_sha256"]) == 64
+
+
+@pytest.mark.parametrize("topology", ("tp2_dp1", "tp1_dp2"))
+def test_client_proven_non_submitted_request_does_not_abort_gang(
+    monkeypatch: pytest.MonkeyPatch,
+    topology: str,
+) -> None:
+    runtimes = tuple(
+        _runtime(monkeypatch, topology=topology, rank=rank) for rank in range(2)
+    )
+    begin = aggregate_formal_gang_rank_responses(
+        "formal_gang_begin", [_begin(runtime) for runtime in runtimes]
+    )
