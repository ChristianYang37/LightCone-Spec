+    reset = runtime.reset(
+        {
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "rank_begin_sha256s": [begin["begin_sha256"], _sha("other-begin")],
+        },
+        native_state={"rank": 0},
+    )
+    runtime.note_request_terminal(
+        request_id="scored-r0",
+        input_token_ids=(1, 2, 3),
+        output_token_ids=(4, 5),
+        native_token_timestamp_semantics=(
+            "scheduler_committed_token_at_result_processor_v1"
+        ),
+        native_token_timestamp_events=((4, 100), (5, 120)),
+        terminal_status="completed",
+        terminal_reason="FINISH_LENGTH",
+    )
+    payload = _finalize_payload(
+        topology="tp2_dp1",
+        reset={"rank_reset_sha256s": [reset["reset_sha256"], _sha("other-reset")]},
+        non_submitted=frozenset({"scored-r1"}),
+    )
+    payload["client_lifecycle_sha256"] = _sha("tampered-lifecycle")
+    with pytest.raises(ValueError, match="digest differs"):
+        runtime.finalize(payload, native_state={"rank": 0})
+
+    phase_tamper = _finalize_payload(
+        topology="tp2_dp1",
+        reset={"rank_reset_sha256s": [reset["reset_sha256"], _sha("other-reset")]},
+        non_submitted=frozenset({"scored-r1"}),
