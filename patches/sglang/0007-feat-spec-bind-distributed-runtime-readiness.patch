diff --git a/test/registered/unit/spec/test_session_reset_gpu_qualification.py b/test/registered/unit/spec/test_session_reset_gpu_qualification.py
new file mode 100644
index 00000000..bec9a2a7
--- /dev/null
+++ b/test/registered/unit/spec/test_session_reset_gpu_qualification.py
@@ -0,0 +1,431 @@
+"""First-party single-GPU qualification for source-owned session reset.
+
+The release runner launches the exact manifest-bound adapted TP1/DP1 server,
+records a cold-process reference, and selects these eight node IDs explicitly.
+This suite is intentionally not skippable: absent CUDA, a foreign launch, an
+incomplete reset, or an unavailable native terminal is a failed qualification.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import http.client
+import json
+import os
+import time
+import uuid
+from pathlib import Path
+from urllib.parse import urlsplit
+
+import torch
+
+TEST_NAMES = (
+    "test_session_reuse_token_trajectory",
+    "test_session_reset_state_receipt",
+    "test_session_hbm_drift",
+    "test_session_graph_pointer_stability",
+    "test_session_startup_latency_comparison",
+    "test_session_http_connection_accounting",
+    "test_session_fault_fallback",
+    "test_session_terminal_lifecycle",
+)
+_SESSION_HOOK = "sglang.schema_v3.source_owned_all_reset_session.v1"
+_TERMINAL_HOOK = "sglang.schema_v3.content_bound_terminal_speculative_evidence.v1"
+_RESULT: dict[str, object] | None = None
+_CONNECTION: http.client.HTTPConnection | None = None
+
+
+def _canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode()
+
+
+def _sha(value: object) -> str:
+    return hashlib.sha256(_canonical_bytes(value)).hexdigest()
+
+
+def _required_env(name: str) -> str:
+    value = os.environ.get(name)
+    if not value or value.strip() != value or "\n" in value:
+        raise AssertionError(f"session qualification lacks exact {name}")
+    return value
+
+
+def _load_canonical(path: Path, expected_raw_sha256: str) -> dict[str, object]:
+    body = path.read_bytes()
+    if hashlib.sha256(body).hexdigest() != expected_raw_sha256:
+        raise AssertionError("cold-process reference changed")
+    value = json.loads(body)
+    if not isinstance(value, dict) or body != _canonical_bytes(value) + b"\n":
+        raise AssertionError("cold-process reference is not canonical JSON")
+    return value
+
+
+def _connection() -> http.client.HTTPConnection:
+    global _CONNECTION
+    if _CONNECTION is None:
+        parsed = urlsplit(_required_env("LIGHTCONE_SESSION_BASE_URL"))
+        if parsed.scheme != "http" or parsed.path not in {"", "/"}:
+            raise AssertionError("session qualification requires a localhost HTTP URL")
+        if parsed.hostname not in {"127.0.0.1", "localhost", "::1"}:
+            raise AssertionError("session qualification server must be localhost")
+        _CONNECTION = http.client.HTTPConnection(
+            parsed.hostname,
+            parsed.port,
+            timeout=120,
+        )
+    return _CONNECTION
+
+
+def _post(path: str, payload: dict[str, object], *, expected_status: int = 200):
+    connection = _connection()
+    connection.request(
+        "POST",
+        path,
+        body=_canonical_bytes(payload),
+        headers={"Content-Type": "application/json"},
+    )
+    response = connection.getresponse()
+    body = response.read()
+    try:
+        value = json.loads(body)
+    except json.JSONDecodeError as error:
+        raise AssertionError(f"{path} returned non-JSON") from error
+    if response.status != expected_status:
+        raise AssertionError(
+            f"{path} returned {response.status}, expected {expected_status}: {value}"
+        )
+    return value
+
+
+def _generate(request_id: str, input_ids: list[int], max_new_tokens: int) -> list[int]:
+    value = _post(
+        "/generate",
+        {
+            "input_ids": input_ids,
+            "sampling_params": {
+                "temperature": 0.0,
+                "max_new_tokens": max_new_tokens,
+            },
+            "rid": request_id,
+            "stream": False,
+        },
+    )
+    if not isinstance(value, dict) or not isinstance(value.get("output_ids"), list):
+        raise TypeError("generate response lacks ordered output token IDs")
+    output_ids = value["output_ids"]
+    if not output_ids or any(
+        not isinstance(token, int) or isinstance(token, bool) or token < 0
+        for token in output_ids
+    ):
+        raise AssertionError("generate response contains invalid output token IDs")
+    return output_ids
+
+
+def _publish_json_no_replace(path: Path, value: object) -> None:
+    body = _canonical_bytes(value) + b"\n"
+    path.parent.mkdir(parents=False, exist_ok=True)
+    temporary = path.with_name(f"{path.name}.tmp.{uuid.uuid4().hex}")
+    descriptor = os.open(
+        temporary,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
+        0o600,
+    )
+    try:
+        offset = 0
+        while offset < len(body):
+            offset += os.write(descriptor, body[offset:])
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+    try:
+        os.link(temporary, path)
+    finally:
+        temporary.unlink(missing_ok=True)
+    sidecar = Path(f"{path}.sha256")
+    sidecar_body = f"{_sha(value)}\n".encode("ascii")
+    descriptor = os.open(
+        sidecar,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
+        0o600,
+    )
+    try:
+        os.write(descriptor, sidecar_body)
+        os.fsync(descriptor)
+    finally:
+        os.close(descriptor)
+
+
+def _exercise() -> dict[str, object]:
+    global _RESULT
+    if _RESULT is not None:
+        return _RESULT
+    if not torch.cuda.is_available() or torch.cuda.device_count() != 1:
+        raise AssertionError("session qualification requires exactly one visible GPU")
+    gpu_uuid = _required_env("LIGHTCONE_SESSION_GPU_UUID")
+    if os.environ.get("CUDA_VISIBLE_DEVICES") != gpu_uuid or not gpu_uuid.startswith(
+        "GPU-"
+    ):
+        raise AssertionError("session qualification GPU differs from inventory")
+    assignment_sha256 = _required_env("LIGHTCONE_SESSION_ASSIGNMENT_SHA256")
+    runner_protocol_sha256 = _required_env("LIGHTCONE_SESSION_RUNNER_PROTOCOL_SHA256")
+    method = _required_env("LIGHTCONE_SESSION_METHOD")
+    if method not in {"tts", "l0"}:
+        raise AssertionError("session qualification must exercise an adapted method")
+    cold = _load_canonical(
+        Path(_required_env("LIGHTCONE_SESSION_COLD_REFERENCE_PATH")),
+        _required_env("LIGHTCONE_SESSION_COLD_REFERENCE_RAW_SHA256"),
+    )
+    if cold.get("assignment_sha256") != assignment_sha256:
+        raise AssertionError("cold-process reference belongs to another assignment")
+    prompt = cold.get("input_token_ids")
+    cold_output = cold.get("output_token_ids")
+    max_new_tokens = cold.get("max_new_tokens")
+    if (
+        not isinstance(prompt, list)
+        or not isinstance(cold_output, list)
+        or not isinstance(max_new_tokens, int)
+    ):
+        raise TypeError("cold-process reference fields are incomplete")
+
+    reused_pre_session = _generate("session-pre-reset", prompt, max_new_tokens)
+    session_plan = _sha({"assignment": assignment_sha256, "kind": "session-plan"})
+    execution_plan = _sha({"assignment": assignment_sha256, "trace": 0})
+    capability = _post(
+        "/v1/lightcone-spec/session-reset/capability",
+        {
+            "session_plan_sha256": session_plan,
+            "execution_plan_sha256s": [execution_plan],
+        },
+    )
+    if (
+        capability.get("hook") != _SESSION_HOOK
+        or capability.get("gpu_reset_semantics")
+        != "IMPLEMENTED_PENDING_DYNAMIC_GPU_PROOF"
+    ):
+        raise AssertionError("server returned another session reset capability")
+    initial = _post(
+        "/v1/lightcone-spec/session-reset/initial-state",
+        {"capability_sha256": capability["capability_sha256"]},
+    )
+    reset = _post(
+        "/v1/lightcone-spec/session-reset",
+        {
+            "capability_sha256": capability["capability_sha256"],
+            "prior_execution_plan_sha256": None,
+            "next_execution_plan_sha256": execution_plan,
+        },
+    )
+
+    warmup_id = "session-warmup"
+    scored_id = "session-scored"
+    run_id = "session-reset-qualification"
+    terminal_begin = {
+        "schema_version": 1,
+        "hook": _TERMINAL_HOOK,
+        "run_id": run_id,
+        "run_nonce_sha256": _sha({"assignment": assignment_sha256, "run": 0}),
+        "execution_plan_sha256": execution_plan,
+        "rank_config_sha256": _sha({"topology": "tp1_dp1", "gpu": gpu_uuid}),
+        "attempt_id": "session-reset-attempt-0",
+        "session_id": session_plan,
+        "session_epoch": 1,
+        "previous_run_id": None,
+        "challenge_nonce_sha256": _sha(
+            {"assignment": assignment_sha256, "challenge": 0}
+        ),
+        "method": method,
+        "warmup_request_ids": [warmup_id],
+        "scored_request_ids": [scored_id],
+    }
+    begin = _post(
+        "/v1/lightcone-spec/session-reset/trace/begin",
+        {
+            "capability_sha256": capability["capability_sha256"],
+            "terminal_payload": terminal_begin,
+        },
+    )
+    _generate(warmup_id, prompt, max_new_tokens)
+    terminal_reset = _post(
+        "/v1/lightcone-spec/session-reset/trace/reset",
+        {
+            "capability_sha256": capability["capability_sha256"],
+            "terminal_payload": {
+                "hook": _TERMINAL_HOOK,
+                "run_id": run_id,
+                "begin_sha256": begin["terminal"]["begin_sha256"],
+            },
+        },
+    )
+    scored_output = _generate(scored_id, prompt, max_new_tokens)
+    finalized = _post(
+        "/v1/lightcone-spec/session-reset/trace/finalize",
+        {
+            "capability_sha256": capability["capability_sha256"],
+            "terminal_payload": {
+                "hook": _TERMINAL_HOOK,
+                "run_id": run_id,
+                "reset_sha256": terminal_reset["terminal"]["reset_sha256"],
+                "client_terminal_rows": [],
+            },
+        },
+    )
+    close = _post(
+        "/v1/lightcone-spec/session-reset/close-terminal",
+        {"capability_sha256": capability["capability_sha256"]},
+    )
+    _RESULT = {
+        "assignment_sha256": assignment_sha256,
+        "runner_protocol_sha256": runner_protocol_sha256,
+        "gpu_uuid": gpu_uuid,
+        "method": method,
+        "cold": cold,
+        "reused_pre_session_output_ids": reused_pre_session,
+        "scored_output_ids": scored_output,
+        "capability": capability,
+        "initial": initial,
+        "reset": reset,
+        "begin": begin,
+        "terminal_reset": terminal_reset,
+        "finalized": finalized,
+        "close": close,
+        "process_id": int(str(capability["process_identity"]).rsplit(":", 1)[1]),
+        "process_started_ns": capability["process_started_ns"],
+    }
+    return _RESULT
+
+
+def _states() -> tuple[dict[str, object], dict[str, object]]:
+    value = _exercise()
+    initial = value["initial"]["state"]
+    reset_after = value["reset"]["after"]
+    assert isinstance(initial, dict) and isinstance(reset_after, dict)
+    return initial, reset_after
+
+
+def test_session_reuse_token_trajectory() -> None:
+    value = _exercise()
+    cold = value["cold"]
+    assert isinstance(cold, dict)
+    assert value["scored_output_ids"] == cold["output_token_ids"]
+    assert value["reused_pre_session_output_ids"] == cold["output_token_ids"]
+
+
+def test_session_reset_state_receipt() -> None:
+    value = _exercise()
+    reset = value["reset"]
+    assert reset["reset_receipt_sha256"] == _sha(
+        {key: item for key, item in reset.items() if key != "reset_receipt_sha256"}
+    )
+    assert reset["after"]["reset_generation"] == reset["before"]["reset_generation"] + 1
+    assert reset["after"]["active_requests"] == 0
+    assert reset["after"]["queued_requests"] == 0
+    assert reset["after"]["request_kv_entries"] == 0
+
+
+def test_session_hbm_drift() -> None:
+    initial, after = _states()
+    assert after["allocator_allocated_bytes"] == initial["allocator_allocated_bytes"]
+    assert after["allocator_reserved_bytes"] == initial["allocator_reserved_bytes"]
+    assert after["hbm_state_sha256"] == initial["hbm_state_sha256"]
+
+
+def test_session_graph_pointer_stability() -> None:
+    initial, after = _states()
+    for field in (
+        "inference_weights_sha256",
+        "fp32_master_sha256",
+        "optimizer_moments_sha256",
+        "candidate_buffers_sha256",
+        "cohort_state_sha256",
+    ):
+        assert initial[field] is not None
+        assert after[field] == initial[field]
+
+
+def test_session_startup_latency_comparison() -> None:
+    value = _exercise()
+    cold = value["cold"]
+    reset = value["reset"]
+    assert isinstance(cold, dict) and isinstance(reset, dict)
+    assert 0 < reset["reset_duration_ns"] < cold["server_startup_duration_ns"]
+    assert reset["reset_duration_ns"] < int(
+        _required_env("LIGHTCONE_SESSION_REUSED_STARTUP_DURATION_NS")
+    )
+
+
+def test_session_http_connection_accounting() -> None:
+    initial, after = _states()
+    before_accounting = initial["connection_accounting"]
+    after_accounting = after["connection_accounting"]
+    assert before_accounting["process_id"] == after_accounting["process_id"]
+    assert before_accounting["generation"] == after_accounting["generation"]
+    assert (
+        after_accounting["connections_created"]
+        >= before_accounting["connections_created"]
+    )
+    assert after_accounting["connections_current"] >= 1
+
+
+def test_session_fault_fallback() -> None:
+    value = _exercise()
+    capability = value["capability"]
+    response = _post(
+        "/v1/lightcone-spec/session-reset",
+        {
+            "capability_sha256": capability["capability_sha256"],
+            "prior_execution_plan_sha256": None,
+            "next_execution_plan_sha256": _sha("foreign-plan"),
+        },
+        expected_status=409,
+    )
+    assert "fresh_process_required" in str(response)
+
+
+def test_session_terminal_lifecycle() -> None:
+    value = _exercise()
+    assert value["finalized"]["terminal"]["completion_marker"] == "TERMINAL_COMPLETE"
+    assert value["close"]["close_receipt_sha256"] == _sha(
+        {
+            key: item
+            for key, item in value["close"].items()
+            if key != "close_receipt_sha256"
+        }
+    )
+    terminal = {
+        "schema_version": 1,
+        "kind": "formal_session_reset_raw_rank_terminal",
+        "runner_protocol_sha256": value["runner_protocol_sha256"],
+        "assignment_sha256": value["assignment_sha256"],
+        "global_rank": 0,
+        "gpu_uuid": value["gpu_uuid"],
+        "status": "PASSED",
+        "started_ns": value["process_started_ns"],
+        "finished_ns": time.monotonic_ns(),
+        "process_id": value["process_id"],
+        "completed_test_names": list(TEST_NAMES),
+        "native_terminal_sha256": value["finalized"]["terminal"]["terminal_sha256"],
+        "reset_receipt_sha256": value["reset"]["reset_receipt_sha256"],
+        "close_receipt_sha256": value["close"]["close_receipt_sha256"],
+        "cold_output_ids_sha256": _sha(value["cold"]["output_token_ids"]),
+        "reused_output_ids_sha256": _sha(value["scored_output_ids"]),
+        "observation_sha256": _sha(
+            {
+                "capability": value["capability"],
+                "initial": value["initial"],
+                "reset": value["reset"],
+                "begin": value["begin"],
+                "terminal_reset": value["terminal_reset"],
+                "finalized": value["finalized"],
+                "close": value["close"],
+            }
+        ),
+    }
+    _publish_json_no_replace(
+        Path(_required_env("LIGHTCONE_SESSION_RANK0_TERMINAL_PATH")), terminal
+    )
