+        "formal_gang_reset",
+        [
+            runtime.reset(
+                {
+                    "hook": FORMAL_GANG_SERVING_HOOK,
+                    "rank_begin_sha256s": begin["rank_begin_sha256s"],
+                },
+                native_state={"rank": runtime.rank},
+            )
+            for runtime in runtimes
+        ],
+    )
+    # r1 was rejected before native submission.  TP2 therefore sees r0 on
+    # both ranks; DP2 sees r0 only on rank zero and an empty native set on rank
+    # one.  Both are complete only because the exact full lifecycle is bound.
+    for runtime in runtimes:
+        if runtime.topology == "tp2_dp1" or runtime.rank == 0:
+            runtime.note_request_terminal(
+                request_id="scored-r0",
+                input_token_ids=(1, 2, 3),
+                output_token_ids=(4, 5),
+                native_token_timestamp_semantics=(
+                    "scheduler_committed_token_at_result_processor_v1"
+                ),
+                native_token_timestamp_events=((4, 100), (5, 120)),
+                terminal_status="completed",
+                terminal_reason="FINISH_LENGTH",
+            )
+    payload = _finalize_payload(
+        topology=topology,
+        reset=reset,
+        non_submitted=frozenset({"scored-r1"}),
+    )
+    terminal = aggregate_formal_gang_rank_responses(
+        "formal_gang_finalize",
+        [
+            runtime.finalize(
+                payload,
+                native_state={"rank": runtime.rank},
+            )
+            for runtime in runtimes
+        ],
+    )
+    assert terminal["decision"] == "COMMITTED"
+    assert {
+        rank["client_lifecycle_sha256"] for rank in terminal["rank_terminals"]
+    } == {payload["client_lifecycle_sha256"]}
