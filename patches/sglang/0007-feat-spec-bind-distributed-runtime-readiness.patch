+_RANK_LIFECYCLES: (
+    tuple[
+        NativeQualificationRankLifecycle,
+        NativeQualificationRankLifecycle,
+    ]
+    | None
+) = None
+
+
+def _sha(label: str) -> str:
+    return __import__("hashlib").sha256(label.encode()).hexdigest()
+
+
+def _require_two_gpus() -> tuple[str, str]:
+    if not torch.cuda.is_available() or torch.cuda.device_count() != 2:
+        raise AssertionError("formal qualification requires exactly two visible GPUs")
+    visible = tuple(os.environ.get("CUDA_VISIBLE_DEVICES", "").split(","))
+    if (
+        len(visible) != 2
+        or len(set(visible)) != 2
+        or any(not value.startswith("GPU-") for value in visible)
+    ):
+        raise AssertionError("formal qualification requires two inventory GPU UUIDs")
+    return visible
+
+
+def _lifecycles() -> tuple[
+    NativeQualificationRankLifecycle,
+    NativeQualificationRankLifecycle,
+]:
+    global _RANK_LIFECYCLES
+    gpu_uuids = _require_two_gpus()
+    if _RANK_LIFECYCLES is None:
+        _RANK_LIFECYCLES = tuple(
+            NativeQualificationRankLifecycle(global_rank=rank, gpu_uuid=gpu_uuid)
+            for rank, gpu_uuid in enumerate(gpu_uuids)
+        )
+    return _RANK_LIFECYCLES
+
+
+def _record(test_name: str, observations: tuple[dict[str, object], ...]) -> None:
+    if len(observations) != 2:
+        raise AssertionError("native qualification requires two rank observations")
+    for lifecycle, observation in zip(_lifecycles(), observations, strict=True):
+        lifecycle.record(test_name, observation)
+
+
+def _authority(mode: str) -> NativeRuntimeAuthority:
+    gpu_uuids = _require_two_gpus()
+    return NativeRuntimeAuthority(
+        proof_sha256=_sha(f"qualification-proof-{mode}"),
+        source_capability_sha256=_sha(f"qualification-capability-{mode}"),
+        source_identity_sha256=_sha("qualification-source-identity"),
+        inventory_sha256=_sha("qualification-inventory"),
+        hardware_envelope_sha256=_sha("qualification-hardware"),
+        topology_mode=mode,
+        topology_sha256=_sha(f"qualification-topology-{mode}"),
+        gpu_uuids=gpu_uuids,
+        backend_capabilities=("dspark", "graph_hot_path", "native_itl", "nextn"),
+    )
+
+
+def _nccl_worker(rank: int, init_path: str, case: str, output_dir: str) -> None:
+    torch.cuda.set_device(rank)
+    dist.init_process_group(
+        "nccl",
+        init_method=f"file://{init_path}",
+        rank=rank,
+        world_size=2,
+        timeout=timedelta(seconds=120),
+    )
+    try:
+        stream = torch.cuda.current_stream(rank)
+        active = torch.zeros(4, dtype=torch.float32, device=rank)
+        staging = torch.arange(4, dtype=torch.float32, device=rank) + 1 + rank * 4
+        valid = torch.tensor(
+            [1 if case == "parity" or rank == 0 else 0],
+            dtype=torch.int32,
+            device=rank,
+        )
+        dist.all_reduce(valid, op=dist.ReduceOp.MIN)
+        if bool(valid):
+            active.copy_(staging)
+        gathered = [torch.empty_like(active) for _ in range(2)]
+        dist.all_gather(gathered, active)
+        terminal_event = torch.cuda.Event(blocking=False)
+        terminal_event.record(stream)
+        terminal_event.synchronize()
+        combined = torch.cat(gathered).cpu()
+        if case == "parity":
+            expected = torch.arange(1, 9, dtype=torch.float32)
+            if not torch.equal(combined, expected):
+                raise AssertionError("TP2 shards differ from the reference tensor")
+        elif torch.count_nonzero(combined).item() != 0:
+            raise AssertionError("one-rank abort exposed a partial TP2 publication")
+        observation = {
+            "case": case,
+            "rank": rank,
+            "active_pointer": active.data_ptr(),
+            "staging_pointer": staging.data_ptr(),
+            "published_rank_count": 2 if case == "parity" else 0,
+            "terminal_event_recorded": True,
+            "nccl_backend": dist.get_backend(),
+        }
+        Path(output_dir, f"rank-{rank}.json").write_text(
+            json.dumps(observation, sort_keys=True, separators=(",", ":")),
+            encoding="utf-8",
+        )
+    finally:
+        dist.destroy_process_group()
+
+
+def _run_nccl_case(case: str) -> tuple[dict[str, object], dict[str, object]]:
+    _require_two_gpus()
+    with tempfile.TemporaryDirectory(prefix=f"lightcone-{case}-") as directory:
+        init_path = str(Path(directory, "nccl-init"))
+        mp.spawn(
+            _nccl_worker,
+            args=(init_path, case, directory),
+            nprocs=2,
+            join=True,
+        )
+        return tuple(
+            json.loads(Path(directory, f"rank-{rank}.json").read_text("utf-8"))
+            for rank in (0, 1)
+        )
+
+
+class _PublicationTransport:
+    def __init__(self, *, commit: bool) -> None:
+        self.commit = commit
+        self.committed = False
+        self.discarded = False
+
+    def commit_all(self, prepares) -> bool:
+        self.committed = self.commit
+        return self.commit
+
+    def discard_all(self, prepares) -> None:
+        self.discarded = True
+
