+"""Exact non-skippable live NEXTN TP2 qualification."""
+
+import pytest
+from lightcone_live_qualification import LiveQualificationHarness, require_live_contract
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("nextn_tp2")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="NEXTN")
+    assert case.adaptation["nextn_topology"] == {
+        "tensor_parallel_size": 2,
+        "data_parallel_size": 1,
+    }
+    return case
+
+
+def test_nextn_mtp_hidden_interface_tp2(live_suite) -> None:
+    case = _case(live_suite, "nextn_mtp_hidden_interface_tp2")
+    assert len(case.adaptation["nextn_mtp_interface_sha256"]) == 64
+
+
+def test_nextn_teacher_mask_tp2(live_suite) -> None:
+    case = _case(live_suite, "nextn_teacher_mask_tp2")
+    shapes = case.adaptation["native_last_source_tensor_shapes"]
+    assert len(shapes) == 4 and len(shapes[3]) == 2
+
+
+def test_nextn_source_adapter_version_tp2(live_suite) -> None:
+    case = _case(live_suite, "nextn_source_adapter_version_tp2")
+    assert case.adaptation["native_last_feedback_source_version"] >= 0
+
+
+def test_nextn_target_two_shard_authority(live_suite) -> None:
+    case = _case(live_suite, "nextn_target_two_shard_authority")
+    assert len(case.adaptation["nextn_target_revision"]) in {40, 64}
+
+
+def test_nextn_drafter_two_shard_authority(live_suite) -> None:
+    case = _case(live_suite, "nextn_drafter_two_shard_authority")
+    assert len(case.adaptation["nextn_drafter_revision"]) in {40, 64}
+
+
+def test_nextn_tp2_sharded_candidate_parity(live_suite) -> None:
+    case = _case(live_suite, "nextn_tp2_sharded_candidate_parity")
+    assert case.adaptation["native_live_launch_count"] > 0
+    assert case.adaptation["counters"]["communicator_failures"] == 0
+
+
+def test_native_itl_pointer(live_suite) -> None:
+    case = _case(live_suite, "native_itl_pointer")
+    assert len(case.native_pointer["events"]) == 4
+
+
+def test_graph_fixed_address_no_host_sync(live_suite) -> None:
+    case = _case(live_suite, "graph_fixed_address_no_host_sync")
+    assert case.adaptation["counters"]["graph_replay_hits"] > 0
+    assert case.adaptation["fixed_inference_address_sha256"]
