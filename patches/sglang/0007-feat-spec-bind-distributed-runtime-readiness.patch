+                source_adapter_version=7,
+                selector_authority=selector_authority,
+                selector_candidate_id=candidates[rank],
+            )
+            corrected, confidence = batch.reconstruct()
+            loss = batch.loss(confidence_weight=0.25)
+            loss.backward()
+            age_authority = SafeBoundaryAgeAuthority.derive(
+                source_version=batch.source_adapter_version,
+                safe_boundary_version=batch.source_adapter_version + 3,
+            )
+            try:
+                SafeBoundaryAgeAuthority.derive(
+                    source_version=batch.source_adapter_version + 1,
+                    safe_boundary_version=batch.source_adapter_version,
+                )
+            except ValueError:
+                stale_source_rejected = True
+            else:
+                stale_source_rejected = False
+            assert stale_source_rejected
+            event = torch.cuda.Event(blocking=False)
+            event.record()
+            event.synchronize()
+            assert confidence is not None
+            assert w1.grad is not None and w2.grad is not None
+            assert confidence_weight.grad is not None
+            observations.append(
+                {
+                    "predecessor_pointer": batch.predecessor_token_ids.data_ptr(),
+                    "markov_w1_pointer": w1.data_ptr(),
+                    "markov_w2_pointer": w2.data_ptr(),
