+def resolve_rank_publication_hook(
+    authority: NativeRuntimeAuthority,
+) -> RankPublicationHook:
+    provider = _RANK_PUBLICATION_HOOK_PROVIDER
+    if provider is None:
+        raise RuntimeError("TP2 native all-rank publication hook is unavailable")
+    hook = provider(authority)
+    if not callable(hook):
+        raise TypeError("TP2 publication provider returned a non-callable hook")
+    return hook
