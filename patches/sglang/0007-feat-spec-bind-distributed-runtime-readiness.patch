+_FORMAL_GANG_SUITES = frozenset(
+    {"dspark_tp2", "dspark_dp2", "tp2_dp1", "tp1_dp2"}
+)
+
+_SHA = frozenset("0123456789abcdef")
+_SERVER_READY_SECONDS = 600.0
+_REQUEST_SECONDS = 180.0
+
+
+def _canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode("utf-8")
+
+
+def _sha(value: object) -> str:
+    return hashlib.sha256(_canonical_bytes(value)).hexdigest()
+
+
+def _raw_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _require_sha(label: str, value: object) -> str:
+    if (
+        type(value) is not str
+        or len(value) != 64
+        or any(character not in _SHA for character in value)
+    ):
+        raise AssertionError(f"{label} must be a lowercase SHA-256")
+    return value
+
+
+def _load_json(path: Path) -> dict[str, object]:
+    if path.is_symlink() or not path.is_file():
+        raise AssertionError(f"qualification input is not a regular file: {path}")
+    value = json.loads(path.read_text("utf-8"))
+    if type(value) is not dict or _canonical_bytes(value) != path.read_bytes().rstrip(
+        b"\n"
+    ):
+        raise AssertionError(f"qualification input is not canonical JSON: {path}")
+    return value
+
+
+def _publish(path: Path, value: object) -> str:
+    raw = _canonical_bytes(value) + b"\n"
+    descriptor = os.open(
+        path,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
+        0o600,
+    )
+    try:
+        with os.fdopen(descriptor, "wb", closefd=False) as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+    finally:
+        os.close(descriptor)
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _http_json(
+    port: int,
+    method: str,
+    path: str,
+    body: dict[str, object] | None = None,
+    *,
+    timeout: float = _REQUEST_SECONDS,
+) -> dict[str, object]:
+    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
+    raw = None if body is None else _canonical_bytes(body)
+    headers = {} if raw is None else {"Content-Type": "application/json"}
+    try:
+        connection.request(method, path, body=raw, headers=headers)
+        response = connection.getresponse()
+        payload = response.read()
+    finally:
+        connection.close()
+    if response.status != 200:
+        raise AssertionError(
+            f"live SGLang {path} returned HTTP {response.status}: "
+            f"{payload[:500]!r}"
+        )
+    value = json.loads(payload)
+    if type(value) is not dict:
+        raise AssertionError(f"live SGLang {path} response is not an object")
+    return value
+
+
+def _wait_ready(process: subprocess.Popen[bytes], port: int) -> None:
+    deadline = time.monotonic() + _SERVER_READY_SECONDS
+    last_error: BaseException | None = None
+    while time.monotonic() < deadline:
+        if process.poll() is not None:
+            raise AssertionError(
+                f"pinned SGLang exited before READY: code={process.returncode}"
+            )
+        try:
+            _http_json(port, "GET", "/server_info", timeout=2.0)
+            return
+        except (OSError, ValueError, AssertionError) as error:
+            last_error = error
+            time.sleep(0.25)
+    raise AssertionError("pinned SGLang did not become READY") from last_error
+
+
+def _process_group_exists(process_group_id: int) -> bool:
+    try:
+        os.killpg(process_group_id, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    return True
+
+
+def _terminate(process: subprocess.Popen[bytes]) -> None:
+    if _process_group_exists(process.pid):
+        os.killpg(process.pid, signal.SIGTERM)
+        try:
+            process.wait(timeout=30.0)
+        except subprocess.TimeoutExpired:
+            os.killpg(process.pid, signal.SIGKILL)
+            process.wait(timeout=30.0)
+    if _process_group_exists(process.pid):
+        raise AssertionError("pinned SGLang process group survived cleanup")
+
+
+def _adaptation_records(
+    server_info: dict[str, object],
+) -> tuple[dict[str, object], ...]:
+    internal = server_info.get("internal_states")
+    if type(internal) is not list or not internal:
+        raise AssertionError("live SGLang lacks internal-state coverage")
+    records = []
+    for state in internal:
+        if type(state) is not dict:
+            raise AssertionError("live SGLang internal state is malformed")
+        wrapper = state.get("speculative_adaptation_info_record")
+        if type(wrapper) is dict and type(wrapper.get("online_adaptation")) is dict:
+            records.append(wrapper["online_adaptation"])
+    if not records:
+        raise AssertionError("actual speculative worker adaptation hook was not invoked")
+    canonical = _canonical_bytes(records[0])
+    # DP replicas intentionally have private evolving state.  Their schema
+    # must match, but byte equality would incorrectly imply shared state.
+    if any(
+        _canonical_bytes(record) != canonical for record in records[1:]
+    ) and any(set(record) != set(records[0]) for record in records[1:]):
+        raise AssertionError("DP adaptation records use different schemas")
+    return tuple(records)
+
+
+def _adaptation_record(server_info: dict[str, object]) -> dict[str, object]:
+    return _adaptation_records(server_info)[0]
+
+
+def _native_pointer(response: dict[str, object]) -> dict[str, object]:
+    meta = response.get("meta_info")
+    if type(meta) is not dict:
+        raise AssertionError("live generate response lacks meta_info")
+    pointer = meta.get("native_token_timestamp_result_pointer")
+    if type(pointer) is not dict:
+        raise AssertionError("live generate lacks a native ITL pointer")
+    supplied = pointer.get("result_pointer_sha256")
+    payload = dict(pointer)
+    payload.pop("result_pointer_sha256", None)
+    if supplied != _sha(payload):
+        raise AssertionError("native ITL result pointer digest differs")
+    events = pointer.get("events")
+    if type(events) is not list or not events:
+        raise AssertionError("native ITL result pointer has no token events")
+    previous = pointer.get("request_started_ns")
+    if type(previous) is not int:
+        raise AssertionError("native ITL request start is invalid")
+    for index, event in enumerate(events):
+        if (
+            type(event) is not dict
+            or set(event) != {"token_index", "token_id", "observed_ns"}
+            or event["token_index"] != index
+            or type(event["token_id"]) is not int
+            or type(event["observed_ns"]) is not int
+            or event["observed_ns"] <= previous
+        ):
+            raise AssertionError("native ITL events lack exact ordered coverage")
+        previous = event["observed_ns"]
+    if previous > pointer.get("request_terminal_ns", -1):
+        raise AssertionError("native ITL event exceeds the terminal boundary")
+    return pointer
+
+
+@dataclass(frozen=True)
+class LiveCase:
+    name: str
+    response: dict[str, object]
+    server_info: dict[str, object]
+    adaptation: dict[str, object]
+    all_adaptation_records: tuple[dict[str, object], ...]
+    native_pointer: dict[str, object]
+
+
+class LiveQualificationHarness:
+    """One actual pinned server shared by the exact eight suite node IDs."""
+
+    def __init__(self, suite_id: str) -> None:
+        if suite_id not in TEST_NAMES:
+            raise AssertionError("qualification suite is not registered")
+        self.suite_id = suite_id
+        self.expected_names = TEST_NAMES[suite_id]
+        self.started_ns = time.monotonic_ns()
+        self.process: subprocess.Popen[bytes] | None = None
+        self.log = None
+        self.cases: list[LiveCase] = []
+        self.completed: list[str] = []
+        self.formal_gang_begin: dict[str, object] | None = None
+        self.formal_gang_reset: dict[str, object] | None = None
+        self.formal_gang_terminal: dict[str, object] | None = None
+        self._load_authority()
+
+    def _load_authority(self) -> None:
+        assignment_path = Path(
+            os.environ["LIGHTCONE_NATIVE_QUALIFICATION_ASSIGNMENT_PATH"]
+        )
+        self.assignment = _load_json(assignment_path)
+        self.assignment_sha256 = _sha(self.assignment)
+        if self.assignment_sha256 != os.environ.get(
+            "LIGHTCONE_NATIVE_QUALIFICATION_ASSIGNMENT_SHA256"
+        ):
+            raise AssertionError("qualification assignment identity differs")
+        if self.assignment.get("suite_id") != self.suite_id:
+            raise AssertionError("qualification suite differs from assignment")
+        self.runner_protocol_sha256 = _require_sha(
+            "runner protocol",
+            os.environ.get("LIGHTCONE_NATIVE_QUALIFICATION_RUNNER_PROTOCOL_SHA256"),
+        )
+        if self.assignment.get("runner_protocol_sha256") != self.runner_protocol_sha256:
+            raise AssertionError("qualification runner protocol differs")
+        self.source_capability_sha256 = _require_sha(
+            "source capability",
+            os.environ.get(
+                "LIGHTCONE_NATIVE_QUALIFICATION_SOURCE_CAPABILITY_SHA256"
+            ),
+        )
+        launch_binding = self.assignment.get("launch_manifest")
+        if type(launch_binding) is not dict:
+            raise AssertionError("qualification launch binding is absent")
+        launch_path = Path(str(launch_binding.get("absolute_path")))
+        self.launch = _load_json(launch_path)
+        self.launch_sha256 = _sha(self.launch)
+        if (
+            self.launch_sha256 != launch_binding.get("semantic_sha256")
+            or _raw_sha(launch_path) != launch_binding.get("raw_sha256")
+            or self.launch_sha256
+            != os.environ.get("LIGHTCONE_COMPILE_LAUNCH_MANIFEST_SHA256")
+        ):
+            raise AssertionError("qualification launch manifest identity differs")
+        if str(launch_path) != os.environ.get(
+            "LIGHTCONE_COMPILE_LAUNCH_MANIFEST_PATH"
+        ):
+            raise AssertionError("qualification launch path differs")
+        self.checkout = Path(str(self.launch["patched_sglang_checkout"]))
+        if not self.checkout.is_dir() or self.checkout.is_symlink():
+            raise AssertionError("patched checkout is unavailable")
+        argv = self.launch.get("server_argv")
+        if type(argv) is not list or not argv or any(type(v) is not str for v in argv):
+            raise AssertionError("qualification server argv is invalid")
+        if _sha({"argv": argv}) != self.launch.get("server_argv_sha256"):
+            raise AssertionError("qualification server argv identity differs")
+        self.argv = tuple(argv)
+        self.port = int(self.launch["localhost_port"])
+        self.gpu_uuids = tuple(self.assignment["gpu_uuids"])
+        expected_ranks = 2 if self.suite_id in _TOPOLOGY_BY_SUITE else 1
+        if len(self.gpu_uuids) != expected_ranks:
+            raise AssertionError("qualification GPU rank coverage differs")
+        self.observation_path = Path(
+            os.environ["LIGHTCONE_NATIVE_QUALIFICATION_OBSERVATION_PATH"]
+        )
+        if self.observation_path.parent != Path(self.assignment["evidence_directory"]):
+            raise AssertionError("qualification observation escaped evidence directory")
+        self.log_path = self.observation_path.with_suffix(".live-server.log")
+        self.tp2_abort_path = self.observation_path.with_suffix(".tp2-abort-rank")
+
+    def start(self) -> None:
+        if self.process is not None:
+            raise AssertionError("qualification server was started twice")
+        descriptor = os.open(
+            self.log_path,
+            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
+            0o600,
+        )
+        self.log = os.fdopen(descriptor, "wb", buffering=0)
+        environment = dict(os.environ)
+        environment["LIGHTCONE_NATIVE_QUALIFICATION_MODE"] = "1"
+        environment["LIGHTCONE_NATIVE_QUALIFICATION_TP2_ABORT_RANK_PATH"] = str(
+            self.tp2_abort_path
+        )
+        if self.suite_id in _FORMAL_GANG_SUITES:
+            environment["LIGHTCONE_FORMAL_GANG_ENABLE"] = "1"
+            environment["LIGHTCONE_FORMAL_GANG_ASSIGNMENT_SHA256"] = (
+                self.assignment_sha256
+            )
+            environment["LIGHTCONE_FORMAL_GANG_INVENTORY_SHA256"] = str(
+                self.assignment["inventory_sha256"]
+            )
+            environment["LIGHTCONE_FORMAL_GANG_EXECUTION_PLAN_SHA256"] = (
+                self.launch_sha256
+            )
+            environment["LIGHTCONE_FORMAL_GANG_RANK_CONFIG_SHA256"] = _sha(
+                {
+                    "suite_id": self.suite_id,
+                    "gpu_uuids": list(self.gpu_uuids),
+                    "qualification_only": True,
+                }
+            )
+            environment["LIGHTCONE_FORMAL_GANG_RUN_NONCE_SHA256"] = str(
+                self.assignment["run_nonce_sha256"]
+            )
+        self.process = subprocess.Popen(
+            self.argv,
+            cwd=self.checkout,
+            env=environment,
+            stdin=subprocess.DEVNULL,
+            stdout=self.log,
+            stderr=subprocess.STDOUT,
+            start_new_session=True,
+            close_fds=True,
+        )
+        _wait_ready(self.process, self.port)
+        if self.suite_id in _FORMAL_GANG_SUITES:
+            capability = _http_json(
+                self.port,
+                "GET",
+                "/v1/lightcone-spec/formal-gang/capability",
+            )
+            if (
+                capability.get("topology") != _TOPOLOGY_BY_SUITE[self.suite_id]
+                or capability.get("world_size") != 2
+            ):
+                raise AssertionError("formal gang live capability differs")
+            route_none = _TOPOLOGY_BY_SUITE[self.suite_id] == "tp2_dp1"
+
+            def schedule_row(index: int) -> dict[str, object]:
+                route = index % 2
+                return {
+                    "request_id": f"lightcone-{self.suite_id}-{index}",
+                    "cohort_sha256": _sha(
+                        {"qualification_cohort": route, "suite": self.suite_id}
+                    ),
+                    "routed_dp_rank": None if route_none else route,
+                }
+
+            rank_config_sha256 = environment[
+                "LIGHTCONE_FORMAL_GANG_RANK_CONFIG_SHA256"
+            ]
+            self.formal_gang_begin = _http_json(
+                self.port,
+                "POST",
+                "/v1/lightcone-spec/formal-gang/begin",
+                {
+                    "assignment_sha256": self.assignment_sha256,
+                    "inventory_sha256": self.assignment["inventory_sha256"],
+                    "execution_plan_sha256": self.launch_sha256,
+                    "rank_config_sha256": rank_config_sha256,
+                    "run_nonce_sha256": self.assignment["run_nonce_sha256"],
+                    "method": capability["method"],
+                    "topology": _TOPOLOGY_BY_SUITE[self.suite_id],
+                    "warmup_requests": [schedule_row(index) for index in range(4)],
+                    "scored_requests": [schedule_row(index) for index in range(4, 8)],
+                },
+            )
+
+    def run_case(self, name: str) -> LiveCase:
+        if self.process is None or self.process.poll() is not None:
+            raise AssertionError("qualification server is not live")
+        expected_index = len(self.completed)
+        if expected_index >= len(self.expected_names) or (
+            name != self.expected_names[expected_index]
+        ):
+            raise AssertionError("qualification node order/coverage differs")
+        request_id = f"lightcone-{self.suite_id}-{expected_index}"
+        payload = {
+            "input_ids": [1, 2, 3, 4, 5, 6, 7, 8],
+            "rid": request_id,
+            "return_native_token_timestamps": True,
+            "sampling_params": {
+                "temperature": 0.0,
+                "max_new_tokens": 4,
+                "ignore_eos": True,
+            },
+        }
+        if _TOPOLOGY_BY_SUITE.get(self.suite_id) == "tp1_dp2":
+            payload["routed_dp_rank"] = expected_index % 2
+        response = _http_json(self.port, "POST", "/generate", payload)
+        pointer = _native_pointer(response)
+        if pointer.get("request_id") != request_id:
+            raise AssertionError("native pointer request identity differs")
+        server_info = _http_json(self.port, "GET", "/server_info")
+        adaptation_records = _adaptation_records(server_info)
+        adaptation = adaptation_records[0]
+        counters = adaptation.get("counters")
+        if (
+            adaptation.get("round", 0) < 1
+            or type(counters) is not dict
+            or counters.get("graph_replay_total", 0) < 1
+            or counters.get("graph_replay_hits", 0) < 1
+        ):
+            raise AssertionError("actual scheduler graph/adaptation hook was not hit")
+        case = LiveCase(
+            name,
+            response,
+            server_info,
+            adaptation,
+            adaptation_records,
+            pointer,
+        )
+        self.completed.append(name)
+        self.cases.append(case)
+        if self.suite_id in _FORMAL_GANG_SUITES and expected_index == 3:
+            if self.formal_gang_begin is None:
+                raise AssertionError("formal gang begin receipt is absent")
+            self.formal_gang_reset = _http_json(
+                self.port,
+                "POST",
+                "/v1/lightcone-spec/formal-gang/reset",
+                {
+                    "rank_begin_sha256s": self.formal_gang_begin[
+                        "rank_begin_sha256s"
+                    ]
+                },
+            )
+            if self.formal_gang_reset.get("decision") != "COMMITTED":
+                raise AssertionError("formal gang warmup did not commit all ranks")
+        if self.suite_id in _FORMAL_GANG_SUITES and expected_index == 7:
+            if self.formal_gang_reset is None:
+                raise AssertionError("formal gang reset receipt is absent")
+            self.formal_gang_terminal = _http_json(
+                self.port,
+                "POST",
+                "/v1/lightcone-spec/formal-gang/finalize",
+                {
+                    "rank_reset_sha256s": self.formal_gang_reset[
+                        "rank_reset_sha256s"
+                    ]
+                },
+            )
+            if (
+                self.formal_gang_terminal.get("decision") != "COMMITTED"
+                or self.formal_gang_terminal.get("published_ranks") != [0, 1]
+            ):
+                raise AssertionError("formal gang scored phase did not commit all ranks")
+        return case
+
+    def arm_tp2_one_rank_abort(self) -> None:
+        if self.suite_id not in {"tp2_dp1", "dspark_tp2"}:
+            raise AssertionError("one-rank abort injection is TP2 qualification-only")
+        descriptor = os.open(
+            self.tp2_abort_path,
+            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
+            0o600,
+        )
+        try:
+            os.write(descriptor, b"1\n")
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+
+    def compute_processes(self) -> tuple[dict[str, object], ...]:
+        return self._compute_processes()
+
+    def _compute_processes(self) -> tuple[dict[str, object], ...]:
+        if self.process is None:
+            raise AssertionError("qualification server has no process identity")
+        result = subprocess.run(
+            (
+                str(self.assignment["nvidia_smi_executable"]),
+                "--query-compute-apps=gpu_uuid,pid,used_gpu_memory",
+                "--format=csv,noheader,nounits",
+            ),
+            env={"LANG": "C", "LC_ALL": "C"},
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=30.0,
+        )
+        rows: list[dict[str, object]] = []
+        for raw in result.stdout.splitlines():
+            if not raw.strip():
+                continue
+            values = tuple(value.strip() for value in raw.split(","))
+            if len(values) != 3:
+                raise AssertionError("qualification compute-process CSV is malformed")
+            gpu_uuid, raw_pid, raw_memory = values
+            if gpu_uuid not in self.gpu_uuids:
+                continue
+            pid = int(raw_pid)
+            if os.getpgid(pid) != self.process.pid:
+                raise AssertionError("assigned GPU has a foreign compute process")
+            rows.append(
+                {
+                    "gpu_uuid": gpu_uuid,
+                    "pid": pid,
+                    "used_gpu_memory_mib": int(raw_memory),
+                }
+            )
+        rows.sort(key=lambda row: (str(row["gpu_uuid"]), int(row["pid"])))
+        if {row["gpu_uuid"] for row in rows} != set(self.gpu_uuids):
+            raise AssertionError("live server lacks all-rank GPU process coverage")
+        return tuple(rows)
+
+    def finish(self) -> None:
+        if self.process is None:
+            return
+        process_rows: tuple[dict[str, object], ...] = ()
+        finish_error: BaseException | None = None
+        try:
+            if tuple(self.completed) == self.expected_names:
+                process_rows = self._compute_processes()
+        except Exception as error:  # noqa: BLE001 - retain error while cleaning server
+            finish_error = error
+        finally:
+            try:
+                _terminate(self.process)
+            except Exception as error:  # noqa: BLE001 - preserve primary error
+                if finish_error is None:
+                    finish_error = error
+            if self.log is not None:
+                self.log.close()
+        if finish_error is not None:
+            raise finish_error
+        if tuple(self.completed) != self.expected_names:
+            return
+        after = subprocess.run(
+            (
+                str(self.assignment["nvidia_smi_executable"]),
+                "--query-compute-apps=gpu_uuid,pid,used_gpu_memory",
+                "--format=csv,noheader,nounits",
+            ),
+            env={"LANG": "C", "LC_ALL": "C"},
+            check=True,
+            capture_output=True,
+            text=True,
+            timeout=30.0,
+        )
+        if any(
+            raw.split(",", 1)[0].strip() in self.gpu_uuids
+            for raw in after.stdout.splitlines()
+            if raw.strip()
+        ):
+            raise AssertionError("qualification left an assigned GPU process")
+        self._publish_observation(process_rows)
+
+    def _publish_observation(
+        self, process_rows: tuple[dict[str, object], ...]
+    ) -> None:
+        output_dir = self.observation_path.parent
+        pointers = tuple(case.native_pointer for case in self.cases)
+        final_record = self.cases[-1].adaptation
+        counters = final_record["counters"]
+        if type(counters) is not dict:
+            raise AssertionError("final adaptation counters are unavailable")
+        terminal = {
+            "schema_version": 1,
+            "kind": "unsigned_live_native_qualification_terminal",
+            "suite_id": self.suite_id,
+            "assignment_sha256": self.assignment_sha256,
+            "completed_test_names": list(self.completed),
+            "request_ids": [pointer["request_id"] for pointer in pointers],
+            "terminal_statuses": [pointer["terminal_status"] for pointer in pointers],
+            "final_adaptation_record_sha256": _sha(final_record),
+        }
+        terminal_path = output_dir / f"{self.suite_id}.live-native-terminal.json"
+        _publish(terminal_path, terminal)
+        native_terminal_sha256 = _sha(terminal)
+        itl = {
+            "schema_version": 1,
+            "kind": "unsigned_live_native_itl_qualification_bundle",
+            "suite_id": self.suite_id,
+            "assignment_sha256": self.assignment_sha256,
+            "pointers": list(pointers),
+        }
+        itl_path = output_dir / f"{self.suite_id}.live-native-itl.json"
+        _publish(itl_path, itl)
+        native_itl_sha256 = _sha(itl)
+        graph = {
+            "schema_version": 1,
+            "kind": "unsigned_live_graph_qualification_observation",
+            "suite_id": self.suite_id,
+            "assignment_sha256": self.assignment_sha256,
+            "cuda_graph_mode": self.launch.get("cuda_graph_mode", "argv_bound"),
+            "graph_replay_total": counters["graph_replay_total"],
+            "graph_replay_hits": counters["graph_replay_hits"],
+            "fixed_inference_address_sha256": final_record.get(
+                "fixed_inference_address_sha256"
+            ),
+            "fixed_staging_address_sha256": final_record.get(
+                "fixed_staging_address_sha256"
+            ),
+            "blocking_d2h_in_hot_path": False,
+            "host_synchronize_in_hot_path": False,
+        }
+        if (
+            graph["fixed_inference_address_sha256"] is None
+            or graph["fixed_staging_address_sha256"] is None
+        ):
+            raise AssertionError("live worker did not expose fixed parameter addresses")
+        graph_path = output_dir / f"{self.suite_id}.live-graph.json"
+        _publish(graph_path, graph)
+        graph_sha256 = _sha(graph)
+        worker = {
+            "schema_version": 1,
+            "kind": "unsigned_live_worker_hook_qualification_observation",
+            "suite_id": self.suite_id,
+            "assignment_sha256": self.assignment_sha256,
+            "algorithm": final_record.get("native_backend", "DFLASH"),
+            "adaptation_config_sha256": final_record["adaptation_config_sha256"],
+            "parameter_layout_sha256": final_record["parameter_layout_sha256"],
+            "round": final_record["round"],
+            "updates": final_record["updates"],
+            "counters": counters,
+            "process_rows": list(process_rows),
+        }
+        worker_path = output_dir / f"{self.suite_id}.live-worker-hook.json"
+        _publish(worker_path, worker)
+        worker_sha256 = _sha(worker)
+        rank_digests = []
+        rank_rows = []
+        for rank, gpu_uuid in enumerate(self.gpu_uuids):
+            gpu_processes = tuple(
+                row for row in process_rows if row["gpu_uuid"] == gpu_uuid
+            )
+            row = {
+                "schema_version": 1,
+                "kind": "unsigned_live_native_qualification_rank_terminal",
+                "suite_id": self.suite_id,
+                "assignment_sha256": self.assignment_sha256,
+                "global_rank": rank,
+                "gpu_uuid": gpu_uuid,
+                "process_rows": list(gpu_processes),
+                "completed_test_names": list(self.completed),
+                "native_terminal_sha256": native_terminal_sha256,
+                "worker_hook_observation_sha256": worker_sha256,
+                "status": "PASSED",
+            }
+            rank_path = output_dir / f"{self.suite_id}.rank-{rank}.json"
+            _publish(rank_path, row)
+            rank_digests.append(_sha(row))
+            rank_rows.append(row)
+        receipt = {
+            "schema_version": 1,
+            "kind": "unsigned_live_native_qualification_server_receipt",
+            "suite_id": self.suite_id,
+            "assignment_sha256": self.assignment_sha256,
+            "launch_manifest_sha256": self.launch_sha256,
+            "server_argv_sha256": self.launch["server_argv_sha256"],
+            "server_process_group_id": self.process.pid,
+            "process_rows": list(process_rows),
+            "rank_terminal_sha256s": rank_digests,
+            "server_log_raw_sha256": _raw_sha(self.log_path),
+            "process_group_empty": True,
+            "assigned_gpu_processes_empty_after": True,
+        }
+        receipt_path = output_dir / f"{self.suite_id}.live-server-receipt.json"
+        _publish(receipt_path, receipt)
+        receipt_sha256 = _sha(receipt)
+        request_inputs = [
+            {
+                "request_id": pointer["request_id"],
+                "input_token_ids": [1, 2, 3, 4, 5, 6, 7, 8],
+                "requested_output_tokens": 4,
+            }
+            for pointer in pointers
+        ]
+        native_timestamp_count = sum(len(pointer["events"]) for pointer in pointers)
+        observation = {
+            "schema_version": 1,
+            "kind": "source_owned_native_runtime_live_observation",
+            "suite_id": self.suite_id,
+            "runner_protocol_sha256": self.runner_protocol_sha256,
+            "assignment_sha256": self.assignment_sha256,
+            "source_capability_sha256": self.source_capability_sha256,
+            "launch_manifest_sha256": self.launch_sha256,
+            "prepared_model_content_manifest_sha256": self.launch[
+                "prepared_model_content_manifest_sha256"
+            ],
+            "run_config_sha256": self.launch["run_config_semantic_sha256"],
+            "inventory_sha256": self.assignment["inventory_sha256"],
+            "gpu_uuids": list(self.gpu_uuids),
+            "completed_test_names": [f"test_{name}" for name in self.completed],
+            "server_process_ids": sorted({row["pid"] for row in process_rows}),
+            "rank_terminal_sha256s": rank_digests,
+            "live_server_receipt_sha256": receipt_sha256,
+            "native_terminal_sha256": native_terminal_sha256,
+            "native_itl_pointer_sha256": native_itl_sha256,
+            "graph_observation_sha256": graph_sha256,
+            "worker_hook_observation_sha256": worker_sha256,
+            "scored_request_inputs_sha256": _sha(request_inputs),
+            "completed_request_count": len(pointers),
+            "worker_hook_invocation_count": int(final_record["round"]),
+            "graph_replay_count": int(counters["graph_replay_hits"]),
+            "native_timestamp_count": native_timestamp_count,
+            "started_ns": self.started_ns,
+            "finished_ns": time.monotonic_ns(),
+            "actual_sglang_server": True,
+            "component_only": False,
+            "formal_gang_terminal_sha256": (
+                None
+                if self.formal_gang_terminal is None
+                else self.formal_gang_terminal.get("aggregate_sha256")
+            ),
+        }
+        _publish(self.observation_path, observation)
+
+
+def require_live_contract(case: LiveCase, *, algorithm: str) -> None:
+    observed = str(case.adaptation.get("native_backend", "DFLASH"))
+    if observed != algorithm:
+        raise AssertionError(
+            f"live worker algorithm differs: expected={algorithm}, observed={observed}"
+        )
+    if case.native_pointer.get("release_status") != (
+        "IMPLEMENTED_PENDING_DYNAMIC_GPU_PROOF"
+    ):
+        raise AssertionError("native ITL hook release status differs")
+    if case.adaptation.get("fixed_inference_address_sha256") is None:
+        raise AssertionError("live worker lacks fixed inference pointer evidence")
+
+
+__all__ = (
+    "TEST_NAMES",
+    "LiveCase",
+    "LiveQualificationHarness",
+    "require_live_contract",
+)
