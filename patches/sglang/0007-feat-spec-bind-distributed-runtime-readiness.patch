@@ -0,0 +1,283 @@
+"""CPU/static contract for the prepared official EAGLE3 live path."""
+
+from __future__ import annotations
+
+import ast
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+SPEC_ROOT = Path(__file__).resolve().parents[4] / "python/sglang/srt/speculative"
+
+
+def _load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+runtime = _load("lightcone_eagle3_native_release", SPEC_ROOT / "native_runtime_release.py")
+config_module = _load("lightcone_eagle3_config", SPEC_ROOT / "online_adaptation_config.py")
+
+
+def _binding(**changes):
+    values = {
+        "execution_authority_sha256": "1" * 64,
+        "compatibility_authority_sha256": "2" * 64,
+        "model_selector_sha256": "3" * 64,
+        "native_gpu_proof_sha256": "4" * 64,
+        "target_revision": "a" * 40,
+        "drafter_revision": "b" * 40,
+        "live_model_interface_sha256": "5" * 64,
+        "native_source_identity_sha256": "6" * 64,
+        "native_proof_sha256s": ("4" * 64,),
+    }
+    values.update(changes)
+    return runtime.Eagle3OfficialSelectorBinding(**values)
+
+
+def _payload() -> dict[str, object]:
+    return {
+        "schema_version": 3,
+        "method": "l0",
+        "algorithm": "EAGLE3",
+        "weight_update_mode": "full",
+        "parameter_scope": "last1",
+        "kv_history_policy": "frozen",
+        "adaptation_scope": "cohort",
+        "adaptation_group_id": "e0-eagle3",
+        "tenant_id": "research",
+        "optimizer": {
+            "name": "adam",
+            "learning_rate": 1e-5,
+            "weight_decay": 0.0,
+            "beta1": 0.9,
+            "beta2": 0.999,
+            "epsilon": 1e-8,
+            "grad_clip": 1.0,
+            "momentum": None,
+            "muon_ns_steps": None,
+            "muon_auxiliary_learning_rate": None,
+            "muon_auxiliary_weight_decay": None,
+            "schedule": "constant",
+            "schedule_total_published_updates": None,
+        },
+        "rank": None,
+        "lora_alpha": None,
+        "lora_matrix_policy": "registered_matrices_v1",
+        "native_head_policy": "frozen",
+        "stride": 1,
+        "max_in_flight": 1,
+        "canvas_tokens": 4,
+        "loss_position_decay": 1.0,
+        "extra_logical_delay": 0,
+        "teacher_row_policy": "update_round",
+        "verification_mode": "native_scheduler",
+        "fixed_verification_budget": None,
+        "confidence_loss_weight": None,
+        "chronobelief_release_capability_sha256": None,
+        "chronobelief_gpu_proof_sha256": None,
+        "eagle3_e0_execution_authority_sha256": "1" * 64,
+        "eagle3_compatibility_authority_sha256": "2" * 64,
+        "eagle3_model_selector_sha256": "3" * 64,
+        "eagle3_native_gpu_proof_sha256": "4" * 64,
+        "eagle3_qualification_compatibility_authority_sha256": None,
+        "eagle3_qualification_model_selector_sha256": None,
+        "target_revision": "a" * 40,
+        "drafter_revision": "b" * 40,
+        "sampling_profile_sha256": "7" * 64,
+        "telemetry_detail": "headline",
+        "adaptation_microbatch_size": 1,
+        "adaptation_publication_coalescing": 1,
+        "adaptation_stream_priority": "default",
+        "topology": {
+            "tensor_parallel_size": 1,
+            "data_parallel_size": 1,
+            "tp_rank": 0,
+            "dp_rank": 0,
+            "node_count": 1,
+            "node_rank": 0,
+            "device_identity": "GPU-eagle3",
+            "rendezvous_identity": "local",
+            "router_identity": "single-replica",
+            "clock_identity": "clock",
+            "process_group_backend": "none",
+            "distributed_runtime_capability": "single_rank",
+            "distributed_release_capability_sha256": None,
+            "distributed_capability_receipt_sha256": None,
+            "distributed_control_mode": "single_rank",
+            "adaptation_collective_mode": "none",
+        },
+    }
+
+
+def test_official_selector_binding_is_canonical() -> None:
+    value = _binding()
+    assert value.status == "COMPATIBLE"
+    assert len(value.sha256) == 64
+
+
+def test_selector_binding_rejects_unbound_gpu_proof() -> None:
+    with pytest.raises(ValueError, match="GPU authority"):
+        _binding(native_proof_sha256s=("8" * 64,))
+
+
+def test_eagle3_native_batch_uses_real_teacher_rows() -> None:
+    binding = _binding()
+    logits = torch.tensor([[[1.0, -1.0], [0.0, 2.0]]], requires_grad=True)
+    batch = runtime.Eagle3NativeBatch(
+        draft_hidden_states=torch.ones(1, 2, 3),
+        draft_logits=logits,
+        teacher_probabilities=torch.tensor([[[0.8, 0.2], [0.1, 0.9]]]),
+        valid_mask=torch.ones(1, 2, dtype=torch.bool),
+        source_adapter_version=2,
+        selector_binding=binding,
+    )
+    loss = batch.distillation_loss(binding)
+    loss.backward()
+    assert loss.requires_grad and logits.grad is not None
+
+
+def test_eagle3_native_batch_rejects_selector_substitution() -> None:
+    binding = _binding()
+    batch = runtime.Eagle3NativeBatch(
+        draft_hidden_states=torch.ones(1, 1, 3),
+        draft_logits=torch.ones(1, 1, 2, requires_grad=True),
+        teacher_probabilities=torch.full((1, 1, 2), 0.5),
+        valid_mask=torch.ones(1, 1, dtype=torch.bool),
+        source_adapter_version=0,
+        selector_binding=binding,
+    )
+    with pytest.raises(TypeError, match="official selector"):
+        batch.validate(_binding(model_selector_sha256="9" * 64))
+
+
+def test_config_requires_atomic_e0_authority(tmp_path: Path) -> None:
+    value = _payload()
+    value["eagle3_model_selector_sha256"] = None
+    path = tmp_path / "adaptation.json"
+    path.write_text(json.dumps(value), encoding="utf-8")
+    with pytest.raises(ValueError, match="exactly one formal-E0"):
+        config_module.OnlineAdaptationConfig.load(path)
+
+
+def test_qualification_config_requires_no_future_gpu_proof(tmp_path: Path) -> None:
+    value = _payload()
+    for field in (
+        "eagle3_e0_execution_authority_sha256",
+        "eagle3_compatibility_authority_sha256",
+        "eagle3_model_selector_sha256",
+        "eagle3_native_gpu_proof_sha256",
+    ):
+        value[field] = None
+    value["eagle3_qualification_compatibility_authority_sha256"] = "8" * 64
+    value["eagle3_qualification_model_selector_sha256"] = "9" * 64
+    path = tmp_path / "qualification-adaptation.json"
+    path.write_text(json.dumps(value), encoding="utf-8")
+    parsed = config_module.OnlineAdaptationConfig.load(path)
+    assert parsed.eagle3_native_gpu_proof_sha256 is None
+    assert parsed.eagle3_qualification_model_selector_sha256 == "9" * 64
+
+
+def test_qualification_config_rejects_formal_authority_mix(tmp_path: Path) -> None:
+    value = _payload()
+    value["eagle3_qualification_compatibility_authority_sha256"] = "8" * 64
+    value["eagle3_qualification_model_selector_sha256"] = "9" * 64
+    path = tmp_path / "mixed-adaptation.json"
+    path.write_text(json.dumps(value), encoding="utf-8")
+    with pytest.raises(ValueError, match="exactly one formal-E0"):
+        config_module.OnlineAdaptationConfig.load(path)
+
+
+def test_qualification_bootstrap_is_suite_and_selector_bound() -> None:
+    values = {
+        "assignment_sha256": "1" * 64,
+        "dispatch_sha256": "2" * 64,
+        "suite_id": "eagle3_tp1",
+        "source_capability_sha256": "3" * 64,
+        "source_identity_sha256": "4" * 64,
+        "inventory_sha256": "5" * 64,
+        "hardware_envelope_sha256": "6" * 64,
+        "topology_mode": "tp1_dp1",
+        "topology_sha256": "7" * 64,
+        "gpu_uuids": ("GPU-eagle3",),
+        "backend_capabilities": ("eagle3", "graph_hot_path", "native_itl"),
+        "eagle3_selector_status": "COMPATIBLE",
+        "eagle3_compatibility_authority_sha256": "8" * 64,
+        "eagle3_model_selector_sha256": "9" * 64,
+    }
+    bootstrap = runtime.NativeRuntimeQualificationBootstrap(**values)
+    assert bootstrap.qualification_only is True
+    with pytest.raises(ValueError, match="forbidden for another live suite"):
+        runtime.NativeRuntimeQualificationBootstrap(
+            **{**values, "suite_id": "dspark_tp1"}
+        )
+
+
+def test_qualification_selector_binding_is_unsigned_and_nonformal() -> None:
+    binding = runtime.Eagle3QualificationSelectorBinding(
+        qualification_assignment_sha256="1" * 64,
+        qualification_dispatch_sha256="2" * 64,
+        compatibility_authority_sha256="3" * 64,
+        model_selector_sha256="4" * 64,
+        bootstrap_proof_sha256="5" * 64,
+        target_revision="a" * 40,
+        drafter_revision="b" * 40,
+        live_model_interface_sha256="6" * 64,
+        native_source_identity_sha256="7" * 64,
+    )
+    assert binding.qualification_only is True
+    assert not hasattr(binding, "execution_authority_sha256")
+    assert not hasattr(binding, "native_gpu_proof_sha256")
+
+
+def test_config_rejects_eagle3_distributed_topology(tmp_path: Path) -> None:
+    value = _payload()
+    topology = value["topology"]
+    assert isinstance(topology, dict)
+    topology.update(
+        tensor_parallel_size=2,
+        distributed_runtime_capability="patched_two_gpu_v1",
+        distributed_release_capability_sha256="8" * 64,
+        distributed_capability_receipt_sha256="9" * 64,
+        distributed_control_mode="tp_all_rank_two_phase",
+        adaptation_collective_mode="tp_shard_all_rank",
+        process_group_backend="nccl",
+    )
+    path = tmp_path / "adaptation.json"
+    path.write_text(json.dumps(value), encoding="utf-8")
+    with pytest.raises(ValueError, match="only for TP1/DP1"):
+        config_module.OnlineAdaptationConfig.load(path)
+
+
+def test_live_worker_contains_eager_training_and_scheduler_hooks() -> None:
+    source = (SPEC_ROOT / "eagle_worker_v2.py").read_text("utf-8")
+    tree = ast.parse(source)
+    assert "torch.enable_grad() if online_update" in source
+    assert "Eagle3NativeBatch" in source
+    assert "online_adapter.begin_round(batch)" in source
+    assert "online_adapter.after_commit(" in source
+    assert any(
+        isinstance(node, ast.FunctionDef) and node.name == "note_request_aborted"
+        for node in ast.walk(tree)
+    )
+
+
+def test_live_gpu_suite_is_exact_and_non_skippable() -> None:
+    path = Path(__file__).with_name("test_eagle3_live_gpu_qualification.py")
+    source = path.read_text("utf-8")
+    tree = ast.parse(source)
+    tests = tuple(
+        node.name
+        for node in tree.body
+        if isinstance(node, ast.FunctionDef) and node.name.startswith("test_")
+    )
+    assert len(tests) == 8
+    assert "pytest.skip" not in source and "pytest.mark.skip" not in source
