+class NativeQualificationRankLifecycle:
+    """Rank-local first-party observations accumulated by the GPU suite."""
+
+    def __init__(self, *, global_rank: int, gpu_uuid: str) -> None:
+        if global_rank not in {0, 1}:
+            raise ValueError("qualification rank must be zero or one")
+        if not gpu_uuid.startswith("GPU-"):
+            raise ValueError("qualification rank requires one physical GPU UUID")
+        self.global_rank = global_rank
+        self.gpu_uuid = gpu_uuid
+        self.started_ns = time.monotonic_ns()
+        self.process_id = os.getpid()
+        self.process_started_ns = self.started_ns
+        self._observations: dict[str, str] = {}
+        self._finalized = False
+
+    def record(self, test_name: str, observation: Mapping[str, object]) -> None:
+        if self._finalized:
+            raise RuntimeError("qualification rank lifecycle is already terminal")
+        if test_name not in PREFLIGHT_QUALIFICATION_TEST_NAMES:
+            raise ValueError("qualification observation names an unregistered test")
+        if test_name in self._observations:
+            raise RuntimeError("qualification observation was recorded twice")
+        if not isinstance(observation, Mapping) or not observation:
+            raise TypeError("qualification observation must be a non-empty mapping")
+        self._observations[test_name] = _sha256(
+            {
+                "schema_version": 1,
+                "kind": "sglang_native_gpu_qualification_observation",
+                "global_rank": self.global_rank,
+                "gpu_uuid": self.gpu_uuid,
+                "test_name": test_name,
+                "observation": dict(observation),
+            }
+        )
+
+    def finalize(
+        self,
+        *,
+        runner_protocol_sha256: str,
+        assignment_sha256: str,
+        output_path: Path,
+    ) -> str:
+        if self._finalized:
+            raise RuntimeError("qualification rank lifecycle is already terminal")
+        _require_sha256("qualification runner protocol", runner_protocol_sha256)
+        _require_sha256("qualification assignment", assignment_sha256)
+        names = tuple(sorted(self._observations))
+        if names != PREFLIGHT_QUALIFICATION_TEST_NAMES:
+            raise RuntimeError("qualification rank lacks exact native test coverage")
+        finished_ns = time.monotonic_ns()
+        native_terminal = {
+            "schema_version": 1,
+            "kind": "sglang_lightcone_native_rank_terminal",
+            "global_rank": self.global_rank,
+            "gpu_uuid": self.gpu_uuid,
+            "started_ns": self.started_ns,
+            "finished_ns": finished_ns,
+            "process_id": self.process_id,
+            "process_started_ns": self.process_started_ns,
+            "completed_test_names": list(names),
+            "native_observation_sha256s": [
+                self._observations[name] for name in names
+            ],
+        }
+        native_terminal_sha256 = _sha256(native_terminal)
+        observation_sha256 = _sha256(
+            {
+                "native_terminal_sha256": native_terminal_sha256,
+                "native_observation_sha256s": (
+                    native_terminal["native_observation_sha256s"]
+                ),
+            }
+        )
+        terminal = {
+            "schema_version": 1,
+            "kind": "formal_exactness_raw_rank_terminal",
+            "runner_protocol_sha256": runner_protocol_sha256,
+            "assignment_sha256": assignment_sha256,
+            "global_rank": self.global_rank,
+            "gpu_uuid": self.gpu_uuid,
+            "status": "PASSED",
+            "started_ns": self.started_ns,
+            "finished_ns": finished_ns,
+            "process_id": self.process_id,
+            "process_started_ns": self.process_started_ns,
+            "completed_test_names": list(names),
+            "native_terminal_sha256": native_terminal_sha256,
+            "observation_sha256": observation_sha256,
+        }
+        _publish_exclusive_json(output_path, terminal)
+        self._finalized = True
+        return native_terminal_sha256
+
+
+def publish_preflight_rank_terminals(
+    rank_lifecycles: tuple[
+        NativeQualificationRankLifecycle,
+        NativeQualificationRankLifecycle,
+    ],
+) -> tuple[str, str]:
+    """Seal the exact two rank terminals requested by the first-party runner."""
+
+    if (
+        type(rank_lifecycles) is not tuple
+        or len(rank_lifecycles) != 2
+        or tuple(value.global_rank for value in rank_lifecycles) != (0, 1)
+        or len({value.gpu_uuid for value in rank_lifecycles}) != 2
+    ):
+        raise ValueError("qualification publication requires exact two-rank coverage")
+    assignment_sha256 = os.environ.get("LIGHTCONE_PREFLIGHT_ASSIGNMENT_SHA256", "")
+    runner_protocol_sha256 = os.environ.get(
+        "LIGHTCONE_PREFLIGHT_RUNNER_PROTOCOL_SHA256", ""
+    )
+    paths = tuple(
+        Path(os.environ.get(f"LIGHTCONE_PREFLIGHT_RANK{rank}_TERMINAL_PATH", ""))
+        for rank in (0, 1)
+    )
+    _require_sha256("qualification assignment", assignment_sha256)
+    _require_sha256("qualification runner protocol", runner_protocol_sha256)
+    if any(not str(path) for path in paths):
+        raise ValueError("qualification rank terminal paths are unavailable")
+    return tuple(
+        lifecycle.finalize(
+            runner_protocol_sha256=runner_protocol_sha256,
+            assignment_sha256=assignment_sha256,
+            output_path=path,
+        )
+        for lifecycle, path in zip(rank_lifecycles, paths, strict=True)
+    )
+
