+
+def test_native_itl_monotonic_clock(live_suite) -> None:
+    case = _case(live_suite, "native_itl_monotonic_clock")
+    stamps = [row["observed_ns"] for row in case.native_pointer["events"]]
+    assert stamps == sorted(set(stamps))
+
+
+def test_native_itl_pointer_stability(live_suite) -> None:
+    case = _case(live_suite, "native_itl_pointer_stability")
+    assert len(case.native_pointer["result_pointer_sha256"]) == 64
+
+
+def test_cuda_stream_event_dependency(live_suite) -> None:
+    case = _case(live_suite, "cuda_stream_event_dependency")
+    assert case.adaptation["native_commit_event_protocol_sha256"]
+
+
+def test_graph_input_pointer_stability(live_suite) -> None:
+    case = _case(live_suite, "graph_input_pointer_stability")
+    assert case.adaptation["fixed_inference_address_sha256"]
+
+
+def test_graph_candidate_pointer_stability(live_suite) -> None:
+    case = _case(live_suite, "graph_candidate_pointer_stability")
+    assert case.adaptation["fixed_staging_address_sha256"]
+
+
+def test_no_blocking_d2h(live_suite) -> None:
+    case = _case(live_suite, "no_blocking_d2h")
+    assert case.adaptation["hot_path_blocking_d2h_count"] == 0
