+    return await _source_owned_formal_gang_transition(
+        action="formal_gang_finalize",
+        payload={"hook": FORMAL_GANG_SERVING_HOOK, **obj},
+    )
+
+
 @app.post("/v1/lightcone-spec/compile-cache-evidence/begin")
 @auth_level(AuthLevel.ADMIN_OPTIONAL)
 async def source_owned_compile_begin(
@@ -966,6 +1221,18 @@ async def source_owned_compile_finalize(
     )
 
 
+@app.post("/v1/lightcone-spec/compile-cache-evidence/terminal")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_compile_terminal(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
