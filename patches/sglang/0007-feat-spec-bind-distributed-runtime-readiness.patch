+async def source_owned_formal_gang_begin(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    if set(obj) != {
+        "assignment_sha256",
+        "inventory_sha256",
+        "execution_plan_sha256",
+        "rank_config_sha256",
+        "run_nonce_sha256",
+        "method",
+        "topology",
+        "warmup_requests",
+        "scored_requests",
