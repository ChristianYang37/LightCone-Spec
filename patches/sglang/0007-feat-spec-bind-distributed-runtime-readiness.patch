+"""Exact non-skippable live native-ITL and graph qualification."""
+
+import pytest
+from lightcone_live_qualification import LiveQualificationHarness, require_live_contract
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("native_hot_path_tp1")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="DFLASH")
+    return case
+
+
+def test_native_itl_full_token_coverage(live_suite) -> None:
+    case = _case(live_suite, "native_itl_full_token_coverage")
