+DSPARK_SELECTOR_SCOPES = (
+    "all",
+    "last1",
+    "last1_native_heads",
+    "last3",
+    "last3_native_heads",
+    "last5",
+    "last5_native_heads",
+)
+DSPARK_SELECTOR_LORA_RANKS = (1, 2, 4, 8, 16, 32, 64)
+DSPARK_NATIVE_HEAD_NAMES = (
+    "markov_head.markov_w1.weight",
+    "markov_head.markov_w2.weight",
+    "confidence_head.proj.weight",
+)
+
+
+def dspark_parameter_inventory_sha256(
+    *, model_interface_sha256: str, parameter_names: Sequence[str]
+) -> str:
+    _require_sha256("DSpark model interface", model_interface_sha256)
+    names = tuple(parameter_names)
+    if (
+        not names
+        or names != tuple(sorted(set(names)))
+        or any(not isinstance(name, str) or not name.strip() for name in names)
+    ):
+        raise ValueError("DSpark parameter inventory must be sorted and unique")
+    if any(name not in names for name in DSPARK_NATIVE_HEAD_NAMES):
+        raise ValueError("DSpark parameter inventory lacks exact native heads")
+    return _sha256(
+        {
+            "schema_version": 1,
+            "model_interface_sha256": model_interface_sha256,
+            "parameter_names": names,
+        }
+    )
+
+
+def dspark_selector_candidate_ids(
+    *, model_interface_sha256: str, parameter_inventory_sha256: str
+) -> tuple[str, ...]:
+    _require_sha256("DSpark model interface", model_interface_sha256)
+    _require_sha256("DSpark parameter inventory", parameter_inventory_sha256)
+    common = {
+        "schema_version": 1,
+        "model_interface_sha256": model_interface_sha256,
+        "parameter_inventory_sha256": parameter_inventory_sha256,
+        "native_head_names": DSPARK_NATIVE_HEAD_NAMES,
+    }
+    rows = [
+        _sha256({**common, "mode": "lora", "scope": scope, "rank": rank})
+        for scope in DSPARK_SELECTOR_SCOPES
+        for rank in DSPARK_SELECTOR_LORA_RANKS
+    ]
+    rows.extend(
+        _sha256({**common, "mode": "full", "scope": scope, "rank": None})
+        for scope in DSPARK_SELECTOR_SCOPES
+    )
+    return tuple(sorted(rows))
+
+
+@dataclass(frozen=True)
+class DSparkSelectorAuthority:
+    model_interface_sha256: str
+    parameter_inventory_sha256: str
+    parameter_names: tuple[str, ...]
+    candidate_ids: tuple[str, ...]
+    native_head_names: tuple[str, str, str] = DSPARK_NATIVE_HEAD_NAMES
+
+    @classmethod
+    def derive(
+        cls,
+        *,
+        model_interface_sha256: str,
+        parameter_names: Sequence[str],
+        supplied_candidate_ids: tuple[str, ...],
+    ) -> DSparkSelectorAuthority:
+        names = tuple(parameter_names)
+        inventory = dspark_parameter_inventory_sha256(
+            model_interface_sha256=model_interface_sha256,
+            parameter_names=names,
+        )
+        expected = dspark_selector_candidate_ids(
+            model_interface_sha256=model_interface_sha256,
+            parameter_inventory_sha256=inventory,
+        )
+        if supplied_candidate_ids != expected:
+            raise ValueError(
+                "DSpark supplied selector differs from the exact 56-cell grid"
+            )
+        return cls(
+            model_interface_sha256=model_interface_sha256,
+            parameter_inventory_sha256=inventory,
+            parameter_names=names,
+            candidate_ids=expected,
+        )
+
+    def __post_init__(self) -> None:
+        observed_inventory = dspark_parameter_inventory_sha256(
+            model_interface_sha256=self.model_interface_sha256,
+            parameter_names=self.parameter_names,
+        )
+        expected = dspark_selector_candidate_ids(
+            model_interface_sha256=self.model_interface_sha256,
+            parameter_inventory_sha256=self.parameter_inventory_sha256,
+        )
+        if (
+            self.parameter_inventory_sha256 != observed_inventory
+            or self.candidate_ids != expected
+            or len(self.candidate_ids) != 56
+            or self.native_head_names != DSPARK_NATIVE_HEAD_NAMES
+        ):
+            raise ValueError("DSpark selector authority differs from source policy")
+
+
+@dataclass(frozen=True)
+class DSparkNativeBatch:
+    predecessor_token_ids: torch.Tensor
+    markov_w1: torch.Tensor
+    markov_w2: torch.Tensor
+    backbone_logits: torch.Tensor
+    draft_hidden: torch.Tensor
+    teacher_probabilities: torch.Tensor
+    confidence_head_weight: torch.Tensor | None
+    confidence_head_bias: torch.Tensor | None
+    valid_mask: torch.Tensor
+    source_adapter_version: int
+    selector_authority: DSparkSelectorAuthority
+    selector_candidate_id: str
+
+    def reconstruct(self) -> tuple[torch.Tensor, torch.Tensor | None]:
+        if type(self.selector_authority) is not DSparkSelectorAuthority:
+            raise TypeError("DSpark requires its exact selector authority")
+        self.selector_authority.__post_init__()
+        if self.selector_candidate_id not in self.selector_authority.candidate_ids:
+            raise ValueError("DSpark update is outside the exact 56-cell selector")
+        logits = _require_tensor("DSpark backbone logits", self.backbone_logits, ndim=3)
+        hidden = _require_tensor("DSpark draft hidden", self.draft_hidden, ndim=3)
+        w1 = _require_tensor("DSpark Markov W1", self.markov_w1, ndim=2)
+        w2 = _require_tensor("DSpark Markov W2", self.markov_w2, ndim=2)
+        if (
+            self.predecessor_token_ids.shape != logits.shape[:-1]
+            or hidden.shape[:2] != logits.shape[:2]
+        ):
+            raise ValueError("DSpark predecessor IDs do not cover proposal rows")
+        predecessor = torch.nn.functional.embedding(self.predecessor_token_ids, w1)
+        if w2.shape != w1.shape:
+            raise ValueError("DSpark W1/W2 shard geometry differs")
+        corrected = logits + torch.nn.functional.linear(predecessor, w2)
+        confidence = None
+        if self.confidence_head_weight is not None:
+            features = torch.cat((hidden, predecessor), dim=-1)
+            confidence = torch.nn.functional.linear(
+                features,
+                self.confidence_head_weight,
+                self.confidence_head_bias,
+            ).squeeze(-1)
+        return corrected, confidence
+
+    def loss(self, *, confidence_weight: float) -> torch.Tensor:
+        corrected, confidence = self.reconstruct()
+        target = _require_tensor("DSpark teacher probabilities", self.teacher_probabilities, ndim=3)
+        if target.shape != corrected.shape or self.valid_mask.shape != corrected.shape[:-1]:
+            raise ValueError("DSpark teacher/mask layout differs from reconstruction")
+        rows = -(target.detach() * corrected.log_softmax(dim=-1)).sum(dim=-1)
+        if confidence is not None:
+            proposal = corrected.detach().softmax(dim=-1)
+            survival = (1.0 - 0.5 * (target.detach() - proposal).abs().sum(dim=-1)).clamp(0, 1)
+            rows = rows + float(confidence_weight) * torch.nn.functional.binary_cross_entropy_with_logits(
+                confidence, survival, reduction="none"
+            )
+        weights = self.valid_mask.to(rows.dtype)
+        return (rows * weights).sum() / weights.sum()
+
+
+@dataclass(frozen=True)
+class Eagle3OfficialSelectorBinding:
+    """Prepared E0 selector authority bound to one live EAGLE3 worker.
+
+    Signature/content verification happens in LightCone's release-root process.
+    The child receives only the four canonical authority digests in its sealed
+    adaptation config, then binds them to the exact loaded revisions, model
+    interface, source identity, and suite-specific GPU proof before allocating
+    an optimizer.  A direct or partially populated SGLang config cannot enable
+    this path.
+    """
+
+    execution_authority_sha256: str
+    compatibility_authority_sha256: str
+    model_selector_sha256: str
+    native_gpu_proof_sha256: str
+    target_revision: str
+    drafter_revision: str
+    live_model_interface_sha256: str
+    native_source_identity_sha256: str
+    native_proof_sha256s: tuple[str, ...]
+    status: Literal["COMPATIBLE"] = "COMPATIBLE"
+    topology_mode: Literal["tp1_dp1"] = "tp1_dp1"
+
+    def __post_init__(self) -> None:
+        for label, value in (
+            ("EAGLE3 execution authority", self.execution_authority_sha256),
+            ("EAGLE3 compatibility authority", self.compatibility_authority_sha256),
+            ("EAGLE3 model selector", self.model_selector_sha256),
+            ("EAGLE3 native GPU proof", self.native_gpu_proof_sha256),
+            ("EAGLE3 live model interface", self.live_model_interface_sha256),
+            ("EAGLE3 native source identity", self.native_source_identity_sha256),
+        ):
+            _require_sha256(label, value)
+        for label, value in (
+            ("EAGLE3 target revision", self.target_revision),
+            ("EAGLE3 drafter revision", self.drafter_revision),
+        ):
+            if len(value) != 40 or any(
+                character not in "0123456789abcdef" for character in value
+            ):
+                raise ValueError(f"{label} must be a lowercase Git SHA")
+        if (
+            self.status != "COMPATIBLE"
+            or self.topology_mode != "tp1_dp1"
+            or self.native_proof_sha256s
+            != tuple(sorted(set(self.native_proof_sha256s)))
+            or self.native_gpu_proof_sha256 not in self.native_proof_sha256s
+        ):
+            raise ValueError("EAGLE3 selector binding lacks exact TP1 GPU authority")
+
+    @property
+    def sha256(self) -> str:
+        return _sha256(self.__dict__)
+
+
+@dataclass(frozen=True)
+class Eagle3QualificationSelectorBinding:
+    """Root-dispatched official selector for unsigned ``eagle3_tp1`` proof.
+
+    This token can drive only the source-owned qualification worker.  It does
+    not contain, and cannot stand in for, the durable E0 execution authority or
+    the native GPU proof that normal serving requires.
+    """
+
+    qualification_assignment_sha256: str
+    qualification_dispatch_sha256: str
+    compatibility_authority_sha256: str
+    model_selector_sha256: str
+    bootstrap_proof_sha256: str
+    target_revision: str
+    drafter_revision: str
+    live_model_interface_sha256: str
+    native_source_identity_sha256: str
+    status: Literal["COMPATIBLE"] = "COMPATIBLE"
+    suite_id: Literal["eagle3_tp1"] = "eagle3_tp1"
+    topology_mode: Literal["tp1_dp1"] = "tp1_dp1"
+    qualification_only: Literal[True] = True
+
+    def __post_init__(self) -> None:
+        for label, value in (
+            ("EAGLE3 qualification assignment", self.qualification_assignment_sha256),
+            ("EAGLE3 qualification dispatch", self.qualification_dispatch_sha256),
+            ("EAGLE3 compatibility authority", self.compatibility_authority_sha256),
+            ("EAGLE3 model selector", self.model_selector_sha256),
+            ("EAGLE3 bootstrap proof", self.bootstrap_proof_sha256),
+            ("EAGLE3 live model interface", self.live_model_interface_sha256),
+            ("EAGLE3 native source identity", self.native_source_identity_sha256),
+        ):
+            _require_sha256(label, value)
+        for label, value in (
+            ("EAGLE3 target revision", self.target_revision),
+            ("EAGLE3 drafter revision", self.drafter_revision),
+        ):
+            if len(value) != 40 or any(
+                character not in "0123456789abcdef" for character in value
+            ):
+                raise ValueError(f"{label} must be a lowercase Git SHA")
+        if (
+            self.status != "COMPATIBLE"
+            or self.suite_id != "eagle3_tp1"
+            or self.topology_mode != "tp1_dp1"
+            or self.qualification_only is not True
+        ):
+            raise ValueError("EAGLE3 qualification selector is not exact TP1")
+
+    @property
+    def sha256(self) -> str:
+        return _sha256(self.__dict__)
+
+
+Eagle3SelectorBinding = (
+    Eagle3OfficialSelectorBinding | Eagle3QualificationSelectorBinding
+)
+
+
+@dataclass(frozen=True)
+class Eagle3NativeBatch:
+    draft_hidden_states: torch.Tensor
+    draft_logits: torch.Tensor
+    teacher_probabilities: torch.Tensor
+    valid_mask: torch.Tensor
+    source_adapter_version: int
+    selector_binding: Eagle3SelectorBinding
+
+    def validate(self, expected: Eagle3SelectorBinding) -> None:
+        if (
+            type(self.selector_binding) not in {
+                Eagle3OfficialSelectorBinding,
+                Eagle3QualificationSelectorBinding,
+            }
+            or type(self.selector_binding) is not type(expected)
+            or self.selector_binding != expected
+        ):
+            raise TypeError("EAGLE3 update differs from its official selector binding")
+        self.selector_binding.__post_init__()
+        hidden = _require_tensor(
+            "EAGLE3 draft hidden state", self.draft_hidden_states, ndim=3
+        )
+        logits = _require_tensor("EAGLE3 draft logits", self.draft_logits, ndim=3)
+        teacher = _require_tensor(
+            "EAGLE3 teacher probabilities", self.teacher_probabilities, ndim=3
+        )
+        if (
+            hidden.shape[:2] != logits.shape[:2]
+            or logits.shape != teacher.shape
+            or self.valid_mask.shape != logits.shape[:2]
+            or self.valid_mask.dtype is not torch.bool
+            or self.source_adapter_version < 0
+            or self.valid_mask.numel() < 1
+        ):
+            raise ValueError("EAGLE3 live teacher/interface rows are not exact")
+
+    def distillation_loss(
+        self, expected: Eagle3SelectorBinding
+    ) -> torch.Tensor:
+        self.validate(expected)
+        rows = -(
+            self.teacher_probabilities.detach()
+            * self.draft_logits.log_softmax(dim=-1)
+        ).sum(-1)
+        weights = self.valid_mask.to(rows.dtype)
+        return (rows * weights).sum() / weights.sum()
+
+
+@dataclass(frozen=True)
+class NextNNativeBatch:
+    mtp_hidden_states: torch.Tensor
+    teacher_probabilities: torch.Tensor
+    valid_mask: torch.Tensor
+    source_adapter_version: int
+    interface_sha256: str
+    target_revision: str
+    drafter_revision: str
+    topology_mode: Literal["tp1_dp1", "tp2_dp1"]
+    target_shard_sha256s: tuple[str, ...]
+    drafter_shard_sha256s: tuple[str, ...]
+
+    def validate(self) -> None:
+        hidden = _require_tensor("NEXTN MTP hidden state", self.mtp_hidden_states, ndim=3)
+        teacher = _require_tensor("NEXTN teacher probabilities", self.teacher_probabilities, ndim=3)
+        if hidden.shape[:2] != teacher.shape[:2] or self.valid_mask.shape != teacher.shape[:2]:
+            raise ValueError("NEXTN hidden/teacher/mask rows differ")
+        if self.source_adapter_version < 0:
+            raise ValueError("NEXTN source adapter version is invalid")
+        _require_sha256("NEXTN interface", self.interface_sha256)
+        world = 2 if self.topology_mode == "tp2_dp1" else 1
+        if len(self.target_shard_sha256s) != world or len(self.drafter_shard_sha256s) != world:
+            raise ValueError("NEXTN two-model shard coverage differs from topology")
+        for value in (*self.target_shard_sha256s, *self.drafter_shard_sha256s):
+            _require_sha256("NEXTN model shard", value)
+
+    def distillation_loss(self, logits: torch.Tensor) -> torch.Tensor:
+        self.validate()
+        if logits.shape != self.teacher_probabilities.shape:
+            raise ValueError("NEXTN logits differ from teacher rows")
+        rows = -(self.teacher_probabilities.detach() * logits.log_softmax(dim=-1)).sum(-1)
+        weights = self.valid_mask.to(rows.dtype)
+        return (rows * weights).sum() / weights.sum()
+
+
+@dataclass(frozen=True)
+class NativeHotPathResultPointer:
+    run_sha256: str
+    topology_sha256: str
+    tensor_addresses: tuple[tuple[str, int], ...]
+    operations: tuple[str, ...]
+    token_timestamp_buffer_pointer: int
+    rank_terminal_sha256s: tuple[str, ...]
+
+    def __post_init__(self) -> None:
+        _require_sha256("native hot-path run", self.run_sha256)
+        _require_sha256("native hot-path topology", self.topology_sha256)
+        if tuple(name for name, _ in self.tensor_addresses) != tuple(
+            sorted({name for name, _ in self.tensor_addresses})
+        ) or any(pointer <= 0 for _, pointer in self.tensor_addresses):
+            raise ValueError("native graph tensor addresses are not fixed/canonical")
+        forbidden = {"blocking_d2h", "host_synchronize", "tensor_item"}
+        required = {"cuda_event_record", "cuda_stream_wait_event", "graph_replay"}
+        if forbidden & set(self.operations) or not required <= set(self.operations):
+            raise ValueError("native hot path contains blocking host work")
+        if self.token_timestamp_buffer_pointer <= 0:
+            raise ValueError("native token timestamp buffer pointer is invalid")
+        for value in self.rank_terminal_sha256s:
+            _require_sha256("native rank terminal", value)
+
+    @property
+    def sha256(self) -> str:
+        return _sha256(self.__dict__)
+
