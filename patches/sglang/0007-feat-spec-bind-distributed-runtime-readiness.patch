+DSparkNativeBatch = _NATIVE.DSparkNativeBatch
+DSparkSelectorAuthority = _NATIVE.DSparkSelectorAuthority
+Dp2StickyReplicaRuntime = _NATIVE.Dp2StickyReplicaRuntime
+NativeHotPathResultPointer = _NATIVE.NativeHotPathResultPointer
+NativeQualificationRankLifecycle = _NATIVE.NativeQualificationRankLifecycle
+NativeRuntimeAuthority = _NATIVE.NativeRuntimeAuthority
+NextNNativeBatch = _NATIVE.NextNNativeBatch
+RankPrepare = _NATIVE.RankPrepare
+Tp2AllRankPublisher = _NATIVE.Tp2AllRankPublisher
+dspark_selector_candidate_ids = _NATIVE.dspark_selector_candidate_ids
+dspark_parameter_inventory_sha256 = _NATIVE.dspark_parameter_inventory_sha256
+publish_preflight_rank_terminals = _NATIVE.publish_preflight_rank_terminals
+native_token_timestamp_result_pointer = (
+    _TIMESTAMPS.native_token_timestamp_result_pointer
+)
+SafeBoundaryAgeAuthority = _RUNTIME.SafeBoundaryAgeAuthority
