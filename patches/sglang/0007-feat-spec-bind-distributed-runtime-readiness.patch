+"""Rank-local deterministic failure primitives for LightCone E5.
+
+This module is loaded only when a formal launcher supplies a complete
+``LIGHTCONE_FAILURE_ACTUATOR_*`` environment.  Every HTTP command is rebound to
+the current Linux process generation, process group, visible GPU UUID, private
+quota root, topology/rank, assignment, inventory, plan, and run nonce.  The
+eleven scenarios execute source-owned OS/runtime primitives and keep their
+state across the exact arm/trigger/proof/recover/terminal sequence.
+
+The endpoint emits unsigned observations.  Release authority remains outside
+the GPU host and is granted only after local external-control verification.
+"""
+
+from __future__ import annotations
+
+import errno
+import hashlib
+import json
+import os
+import queue
+import socket
+import stat
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+import torch
+
+FAILURE_ACTUATOR_HOOK = "sglang.lightcone_e5_failure_actuator.v1"
+FAILURE_ACTUATOR_PROTOCOL_SHA256 = (
+    "7f5833687374aba52db79cc52bcb3bd01efeedee415afad7a165e4df7fb36dad"
+)
+
+_SCENARIOS: dict[str, dict[str, object]] = {
+    "queue_saturation": {
+        "operations": (
+            "admission_queue_hold_capacity_one",
+            "submit_request_beyond_capacity",
+            "admission_rejected_queue_full",
+            "release_hold_and_queue_depth_zero",
+            "admission_rejections",
+        ),
+        "parameters": (("capacity", "1"), ("overflow_requests", "1")),
+    },
+    "cancellation": {
+        "operations": (
+            "hold_request_before_first_token",
+            "abort_exact_request_id",
+            "cancelled_terminal_without_post_abort_commit",
+            "inflight_zero_and_abort_acknowledged",
+            "cancellations",
+        ),
+        "parameters": (("abort_grace", "registered"), ("target_state", "pre_first_token")),
+    },
+    "duplicate_retry": {
+        "operations": (
+            "record_idempotency_key_and_terminal_digest",
+            "resubmit_identical_key_and_payload",
+            "duplicate_suppressed_without_second_execution",
+            "one_terminal_record_and_same_digest",
+            "duplicate_retry_suppressions",
+        ),
+        "parameters": (("duplicate_count", "1"), ("payload_relation", "byte_identical")),
+    },
+    "nonfinite_candidate": {
+        "operations": (
+            "freeze_finite_active_candidate_version",
+            "inject_nan_before_candidate_publish",
+            "nonfinite_rejected_and_version_unchanged",
+            "clear_candidate_and_active_state_finite",
+            "nonfinite_updates",
+        ),
+        "parameters": (("injection_value", "nan"), ("publication_stage", "pre_publish")),
+    },
+    "oom_candidate": {
+        "operations": (
+            "arm_fail_once_candidate_allocator",
+            "allocate_candidate_scratch",
+            "oom_caught_and_active_version_unchanged",
+            "release_scratch_and_allocator_probe_succeeds",
+            "oom_events",
+        ),
+        "parameters": (("failure_count", "1"), ("injection_site", "candidate_scratch")),
+    },
+    "evidence_backpressure": {
+        "operations": (
+            "pause_consumer_with_queue_capacity_one",
+            "enqueue_evidence_beyond_capacity",
+            "backpressure_observed_without_evidence_drop",
+            "resume_consumer_flush_and_queue_zero",
+            "evidence_backpressure_events",
+        ),
+        "parameters": (("capacity", "1"), ("overflow_mode", "block")),
+    },
+    "disk_quota": {
+        "operations": (
+            "arm_fail_once_checkpoint_fsync_enospc",
+            "publish_checkpoint_boundary",
+            "enospc_observed_without_terminal_commit",
+            "remove_fault_and_recovery_checkpoint_fsyncs",
+            "disk_quota_events",
+        ),
+        "parameters": (("errno", "ENOSPC"), ("failure_count", "1")),
+    },
