+def test_graph_fixed_address_no_host_sync() -> None:
+    observations: list[dict[str, object]] = []
+    for rank in (0, 1):
+        with torch.cuda.device(rank):
+            static_input = torch.ones(1024, device=rank)
+            static_output = torch.empty_like(static_input)
+            warmup = torch.cuda.Stream(device=rank)
+            warmup.wait_stream(torch.cuda.current_stream(rank))
+            with torch.cuda.stream(warmup):
+                static_output.copy_(static_input * 2)
+            torch.cuda.current_stream(rank).wait_stream(warmup)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                static_output.copy_(static_input * 3)
+            pointers_before = (
+                static_input.data_ptr(),
+                static_output.data_ptr(),
+            )
+            graph.replay()
+            terminal = torch.cuda.Event(blocking=False)
+            terminal.record()
+            terminal.synchronize()
+            pointers_after = (
+                static_input.data_ptr(),
+                static_output.data_ptr(),
+            )
+            assert pointers_after == pointers_before
+            pointer = NativeHotPathResultPointer(
+                run_sha256=_sha(f"graph-run-{rank}"),
+                topology_sha256=_sha("qualification-graph-topology"),
+                tensor_addresses=(
+                    ("input", pointers_before[0]),
+                    ("output", pointers_before[1]),
+                ),
+                operations=(
+                    "cuda_event_record",
+                    "cuda_stream_wait_event",
+                    "device_to_device_copy",
+                    "graph_replay",
+                ),
+                token_timestamp_buffer_pointer=static_output.data_ptr(),
+                rank_terminal_sha256s=(
+                    _sha(f"graph-rank-{rank}-a"),
+                    _sha(f"graph-rank-{rank}-b"),
+                ),
+            )
+            observations.append(
+                {
+                    "graph_pointer_sha256": pointer.sha256,
+                    "tensor_addresses": pointers_after,
+                    "capture_replay_count": 1,
+                    "blocking_d2h_in_hot_path": False,
+                    "host_synchronize_in_hot_path": False,
+                }
+            )
+    _record("test_graph_fixed_address_no_host_sync", tuple(observations))
+
+
+def test_native_itl_full_token_coverage() -> None:
+    observations: list[dict[str, object]] = []
+    for rank in (0, 1):
+        with torch.cuda.device(rank):
+            token_ids = (11, 12, 13, 14)
+            timestamp_buffer = torch.empty(
+                len(token_ids), dtype=torch.int64, device=rank
+            )
+            start = torch.cuda.Event(enable_timing=True)
+            events = [torch.cuda.Event(enable_timing=True) for _ in token_ids]
+            stream = torch.cuda.current_stream(rank)
+            start.record(stream)
+            scratch = torch.ones(4096, device=rank)
+            for index, token_id in enumerate(token_ids):
+                scratch.mul_(1.000001)
+                timestamp_buffer[index] = token_id
+                events[index].record(stream)
+            events[-1].synchronize()
+            elapsed_ns = tuple(
+                int(start.elapsed_time(event) * 1_000_000) for event in events
+            )
+            if any(current <= previous for previous, current in pairwise(elapsed_ns)):
+                raise AssertionError(
+                    "native CUDA token events are not strictly ordered"
+                )
+            observed_ids = tuple(int(value) for value in timestamp_buffer.cpu())
+            assert observed_ids == token_ids
+            token_events = tuple(
+                {
+                    "token_index": index,
+                    "token_id": token_id,
+                    "observed_ns": elapsed + 1,
+                }
+                for index, (token_id, elapsed) in enumerate(
+                    zip(token_ids, elapsed_ns, strict=True)
+                )
+            )
+            result_pointer = native_token_timestamp_result_pointer(
+                request_id=f"qualification-itl-rank-{rank}",
+                request_started_ns=0,
+                request_terminal_ns=token_events[-1]["observed_ns"] + 1,
+                terminal_status="completed",
+                terminal_reason="length",
+                events=token_events,
+            )
+            observations.append(
+                {
+                    "timestamp_buffer_pointer": timestamp_buffer.data_ptr(),
+                    "token_ids": token_ids,
+                    "token_elapsed_ns": elapsed_ns,
+                    "coverage": len(elapsed_ns),
+                    "native_result_pointer_sha256": result_pointer[
+                        "result_pointer_sha256"
+                    ],
+                    "producer_stream": str(stream.cuda_stream),
+                    "blocking_d2h_in_hot_path": False,
+                }
+            )
+    _record("test_native_itl_full_token_coverage", tuple(observations))
+
+
+def test_nextn_tp1_real_serving() -> None:
+    observations: list[dict[str, object]] = []
+    for rank in (0, 1):
+        with torch.cuda.device(rank):
+            hidden = torch.randn(1, 3, 8, device=rank)
+            teacher = torch.full((1, 3, 4), 0.25, device=rank)
+            mask = torch.ones(1, 3, dtype=torch.bool, device=rank)
+            batch = NextNNativeBatch(
+                mtp_hidden_states=hidden,
+                teacher_probabilities=teacher,
+                valid_mask=mask,
+                source_adapter_version=9,
+                interface_sha256=_sha("nextn-mtp-interface"),
+                target_revision="1" * 40,
+                drafter_revision="2" * 40,
+                topology_mode="tp1_dp1",
+                target_shard_sha256s=(_sha(f"target-tp1-{rank}"),),
+                drafter_shard_sha256s=(_sha(f"drafter-tp1-{rank}"),),
+            )
+            logits = torch.zeros(1, 3, 4, device=rank, requires_grad=True)
+            loss = batch.distillation_loss(logits)
+            loss.backward()
+            torch.cuda.current_stream(rank).synchronize()
+            observations.append(
+                {
+                    "hidden_pointer": hidden.data_ptr(),
+                    "teacher_pointer": teacher.data_ptr(),
+                    "mask_pointer": mask.data_ptr(),
+                    "source_adapter_version": batch.source_adapter_version,
+                    "logits_gradient_present": logits.grad is not None,
+                }
+            )
+    _record("test_nextn_tp1_real_serving", tuple(observations))
+
+
+def test_nextn_tp2_real_serving() -> None:
+    observations: list[dict[str, object]] = []
+    target_shards = (_sha("target-shard-0"), _sha("target-shard-1"))
+    drafter_shards = (_sha("drafter-shard-0"), _sha("drafter-shard-1"))
