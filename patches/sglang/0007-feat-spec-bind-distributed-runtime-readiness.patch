+async def _source_owned_failure_capability() -> Dict[str, Any]:
+    responses = await _global_state.tokenizer_manager.terminal_speculative_evidence(
+        TerminalSpeculativeEvidenceReq(
+            action="failure_actuator_capability",
+            payload={"hook": FAILURE_ACTUATOR_HOOK},
+        )
+    )
+    if not responses or any(not response.success for response in responses):
+        message = " | ".join(
+            response.message for response in responses if response.message
+        )
+        raise HTTPException(status_code=409, detail=message or "failure actuator disabled")
+    rank_bindings: List[Dict[str, Any]] = []
+    for response in responses:
+        payload = msgspec_to_builtins(response.payload)
+        if (
+            set(payload) != {"schema_version", "hook", "rank_bindings"}
+            or payload["schema_version"] != 1
+            or payload["hook"] != FAILURE_ACTUATOR_HOOK
+            or not isinstance(payload["rank_bindings"], list)
+        ):
+            raise HTTPException(
+                status_code=409,
+                detail="failure actuator capability response is malformed",
+            )
+        rank_bindings.extend(payload["rank_bindings"])
+    if not rank_bindings:
+        raise HTTPException(status_code=409, detail="failure actuator has no live ranks")
+    rank_bindings.sort(key=lambda row: row.get("rank", -1))
+    topology = rank_bindings[0].get("topology")
+    world_size = rank_bindings[0].get("world_size")
+    if (
+        topology not in {"tp1_dp1", "tp2_dp1", "tp1_dp2"}
+        or world_size not in {1, 2}
+        or len(rank_bindings) != world_size
+        or tuple(row.get("rank") for row in rank_bindings)
+        != tuple(range(world_size))
+        or any(
+            row.get("topology") != topology or row.get("world_size") != world_size
+            for row in rank_bindings
+        )
+    ):
+        raise HTTPException(
+            status_code=409,
+            detail="failure actuator capability rank coverage differs",
+        )
+    return {
+        "schema_version": 1,
+        "hook": FAILURE_ACTUATOR_HOOK,
+        "topology": topology,
+        "world_size": world_size,
+        "rank_bindings": rank_bindings,
+    }
+
+
+@app.get("/v1/lightcone-spec/failure-actuator/capability")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_failure_actuator_capability(request: Request):
+    return await _source_owned_failure_capability()
+
+
+@app.post("/v1/lightcone-spec/failure-actuator")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_failure_actuator(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    if set(obj) != {
+        "schema_version",
+        "kind",
+        "protocol_sha256",
+        "launch_binding_sha256",
+        "assignment_sha256",
+        "inventory_sha256",
+        "plan_sha256",
+        "scenario",
+        "scenario_semantics_sha256",
+        "phase",
+        "operation",
+        "parameters",
+        "topology",
+        "rank",
+        "process_id",
+        "process_group_id",
+        "process_start_monotonic_ns",
+        "gpu_uuid",
+        "temp_quota_root",
+        "run_nonce_sha256",
+    }:
+        raise HTTPException(status_code=422, detail="failure actuator fields differ")
+    responses = await _global_state.tokenizer_manager.terminal_speculative_evidence(
+        TerminalSpeculativeEvidenceReq(action="failure_actuator", payload=obj)
+    )
+    targeted = []
+    errors = []
+    for response in responses:
+        payload = msgspec_to_builtins(response.payload)
+        if response.message:
+            errors.append(response.message)
+        if (
+            isinstance(payload, dict)
+            and payload.get("hook") == FAILURE_ACTUATOR_HOOK
+            and payload.get("targeted") is True
+            and payload.get("topology") == obj["topology"]
+            and payload.get("rank") == obj["rank"]
+        ):
+            targeted.append((response, payload))
+    if len(targeted) != 1 or errors or not targeted[0][0].success:
+        raise HTTPException(
+            status_code=409,
+            detail=" | ".join(errors) or "failure actuator target rank differs",
+        )
+    value = targeted[0][1].get("response")
+    if not isinstance(value, dict):
+        raise HTTPException(
+            status_code=409,
+            detail="failure actuator response is malformed",
+        )
+    return value
+
+
+async def _source_owned_formal_gang_transition(
+    *, action: str, payload: Dict[str, Any]
+) -> Dict[str, Any]:
+    responses = await _global_state.tokenizer_manager.terminal_speculative_evidence(
+        TerminalSpeculativeEvidenceReq(action=action, payload=payload)
+    )
+    if not responses or any(not response.success for response in responses):
+        message = " | ".join(
+            response.message for response in responses if response.message
+        )
+        raise HTTPException(
+            status_code=409,
+            detail=message or "source-owned formal gang serving is disabled",
+        )
+    values = [msgspec_to_builtins(response.payload) for response in responses]
+    aggregate_kinds = {
+        "formal_gang_capability": "sglang_formal_gang_capability",
+        "formal_gang_begin": "sglang_formal_gang_begin",
+        "formal_gang_reset": "sglang_formal_gang_all_rank_terminal",
+        "formal_gang_finalize": "sglang_formal_gang_all_rank_terminal",
+    }
+    expected_kind = aggregate_kinds.get(action)
+    if expected_kind is None:
+        raise HTTPException(status_code=422, detail="formal gang action is unsupported")
+    aggregates = [
+        value
+        for value in values
+        if isinstance(value, dict) and value.get("kind") == expected_kind
+    ]
+    if aggregates:
+        if len(aggregates) != len(values) or any(
+            value != aggregates[0] for value in aggregates[1:]
+        ):
+            raise HTTPException(
+                status_code=409,
+                detail="formal gang all-rank responses conflict across fanout",
+            )
+        return aggregates[0]
+    try:
+        rank_values = [value for value in values if isinstance(value, dict)]
+        if len(rank_values) != len(values):
+            raise TypeError("formal gang rank response is not an object")
+        return aggregate_formal_gang_rank_responses(action, rank_values)
+    except (TypeError, ValueError) as error:
+        raise HTTPException(
+            status_code=409,
+            detail=f"formal gang rank aggregation failed:{type(error).__name__}: {error}",
+        ) from error
+
+
