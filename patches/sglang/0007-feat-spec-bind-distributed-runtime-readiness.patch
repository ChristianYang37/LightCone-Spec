+"""First-party two-GPU qualification for LightCone native release paths.
+
+This file is intentionally not CPU-skippable.  The source runner selects its
+eight exact node IDs only after root-authorized dispatch on a clean two-GPU
+host.  Any missing CUDA/NCCL capability is therefore a failed qualification,
+not an xfail or an unavailable cell silently promoted to READY.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import sys
+import tempfile
+from datetime import timedelta
+from itertools import pairwise
+from pathlib import Path
+from types import ModuleType
+
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+PYTHON_ROOT = Path(__file__).resolve().parents[4] / "python"
+SPECULATIVE_ROOT = PYTHON_ROOT / "sglang/srt/speculative"
+
+
+def _stub_package(name: str, path: Path) -> ModuleType:
+    package = ModuleType(name)
+    package.__package__ = name
+    package.__path__ = [str(path)]
+    sys.modules[name] = package
+    return package
+
+
+if "sglang" not in sys.modules:
+    sglang = _stub_package("sglang", PYTHON_ROOT / "sglang")
+    srt = _stub_package("sglang.srt", PYTHON_ROOT / "sglang/srt")
+    speculative = _stub_package("sglang.srt.speculative", SPECULATIVE_ROOT)
+    managers = _stub_package("sglang.srt.managers", PYTHON_ROOT / "sglang/srt/managers")
+    sglang.srt = srt
+    srt.speculative = speculative
+    srt.managers = managers
+
+_MODULE_SPEC = importlib.util.spec_from_file_location(
+    "sglang.srt.speculative.native_runtime_release",
+    SPECULATIVE_ROOT / "native_runtime_release.py",
+)
+assert _MODULE_SPEC is not None and _MODULE_SPEC.loader is not None
+_NATIVE = importlib.util.module_from_spec(_MODULE_SPEC)
+sys.modules[_MODULE_SPEC.name] = _NATIVE
+_MODULE_SPEC.loader.exec_module(_NATIVE)
+
+_CONFIG_SPEC = importlib.util.spec_from_file_location(
+    "sglang.srt.speculative.online_adaptation_config",
+    SPECULATIVE_ROOT / "online_adaptation_config.py",
+)
+assert _CONFIG_SPEC is not None and _CONFIG_SPEC.loader is not None
+_CONFIG = importlib.util.module_from_spec(_CONFIG_SPEC)
+sys.modules[_CONFIG_SPEC.name] = _CONFIG
+_CONFIG_SPEC.loader.exec_module(_CONFIG)
+
+_RUNTIME_SPEC = importlib.util.spec_from_file_location(
+    "sglang.srt.speculative.online_adaptation_runtime",
+    SPECULATIVE_ROOT / "online_adaptation_runtime.py",
+)
+assert _RUNTIME_SPEC is not None and _RUNTIME_SPEC.loader is not None
+_RUNTIME = importlib.util.module_from_spec(_RUNTIME_SPEC)
+sys.modules[_RUNTIME_SPEC.name] = _RUNTIME
+_RUNTIME_SPEC.loader.exec_module(_RUNTIME)
+
+_TIMESTAMP_SPEC = importlib.util.spec_from_file_location(
+    "sglang.srt.managers.native_token_timestamps",
+    PYTHON_ROOT / "sglang/srt/managers/native_token_timestamps.py",
+)
+assert _TIMESTAMP_SPEC is not None and _TIMESTAMP_SPEC.loader is not None
+_TIMESTAMPS = importlib.util.module_from_spec(_TIMESTAMP_SPEC)
+sys.modules[_TIMESTAMP_SPEC.name] = _TIMESTAMPS
+_TIMESTAMP_SPEC.loader.exec_module(_TIMESTAMPS)
