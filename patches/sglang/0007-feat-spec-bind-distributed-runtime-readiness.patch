index 00000000..004a147e
--- /dev/null
+++ b/test/registered/unit/spec/test_chronobelief_gpu_parity_qualification.py
@@ -0,0 +1,138 @@
+"""Exact non-skippable ChronoBelief mixed-precision/live qualification."""
+
+import pytest
+import torch
+from lightcone_live_qualification import LiveQualificationHarness, require_live_contract
+
+
+def _config():
+    from sglang.srt.speculative.online_adaptation_config import OnlineOptimizerConfig
+
+    return OnlineOptimizerConfig(
+        name="chronobelief",
+        learning_rate=1e-3,
+        weight_decay=0.01,
+        beta1=0.9,
+        beta2=0.999,
+        epsilon=1e-8,
+        grad_clip=1.0,
+    )
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("chronobelief_gpu_parity")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="DFLASH")
+    return case
+
+
+def _proposal(dtype: torch.dtype):
+    from sglang.srt.speculative.online_adaptation_runtime import ResidentOptimizer
+
+    parameter = torch.tensor([0.25, -0.5, 1.0], device="cuda", dtype=dtype)
+    gradient = torch.tensor([0.1, -0.2, 0.3], device="cuda", dtype=dtype)
+    optimizer = ResidentOptimizer((parameter,), _config())
+    proposal = optimizer.propose(
+        (gradient,), feedback_source_version=2, safe_boundary_version=5
+    )
+    beta1, beta2 = 0.9, 0.999
+    grad = gradient.float()
+    first = (1 - beta1) * grad
+    residual = grad - first
+    second = (1 - beta2) * residual.square()
+    direction = (first / (1 - beta1)) / (
+        (second / (1 - beta2)).sqrt() + 1e-8
+    )
+    kappa = (beta1 / beta2**0.5) ** 3
+    expected = parameter.float() * (1 - 1e-3 * 0.01) - 1e-3 * kappa * direction
+    torch.testing.assert_close(proposal.parameters[0], expected, rtol=3e-3, atol=3e-4)
+    assert proposal.safe_boundary_age == 3
+    return optimizer, proposal
+
+
+def test_chronobelief_fp16_gpu_parity(live_suite) -> None:
+    _case(live_suite, "chronobelief_fp16_gpu_parity")
+    _proposal(torch.float16)
+
+
+def test_chronobelief_bf16_gpu_parity(live_suite) -> None:
+    _case(live_suite, "chronobelief_bf16_gpu_parity")
+    _proposal(torch.bfloat16)
+
+
+def test_chronobelief_fp32_gpu_parity(live_suite) -> None:
+    _case(live_suite, "chronobelief_fp32_gpu_parity")
+    _proposal(torch.float32)
+
+
+def test_chronobelief_safe_boundary_age_exactness(live_suite) -> None:
+    from sglang.srt.speculative.online_adaptation_runtime import (
+        SafeBoundaryAgeAuthority,
+    )
+
+    case = _case(live_suite, "chronobelief_safe_boundary_age_exactness")
+    assert case.adaptation["native_commit_event_protocol_sha256"]
+    authority = SafeBoundaryAgeAuthority.derive(
+        source_version=4, safe_boundary_version=9
+    )
+    assert authority.safe_boundary_age == 5
+    with pytest.raises(ValueError, match="stale"):
+        SafeBoundaryAgeAuthority.derive(source_version=9, safe_boundary_version=4)
+
+
+def test_chronobelief_abort_no_state_advance(live_suite) -> None:
+    _case(live_suite, "chronobelief_abort_no_state_advance")
+    optimizer, proposal = _proposal(torch.float32)
+    before = tuple(value.clone() for value in optimizer.state_tensors)
+    optimizer.commit(
+        proposal,
+        valid=torch.zeros((), device="cuda", dtype=torch.bool),
+        expected_safe_boundary_version=5,
+    )
+    assert all(torch.equal(left, right) for left, right in zip(before, optimizer.state_tensors))
+
+
+def test_chronobelief_skip_no_state_advance(live_suite) -> None:
+    _case(live_suite, "chronobelief_skip_no_state_advance")
+    optimizer, proposal = _proposal(torch.bfloat16)
+    optimizer.commit(
+        proposal,
+        valid=torch.zeros((), device="cuda", dtype=torch.bool),
+        expected_safe_boundary_version=5,
+    )
+    assert optimizer.step == 0
+
+
+def test_chronobelief_commit_once_decoupled_decay(live_suite) -> None:
+    _case(live_suite, "chronobelief_commit_once_decoupled_decay")
+    optimizer, proposal = _proposal(torch.float32)
+    before = optimizer.master[0].clone()
+    optimizer.commit(proposal, expected_safe_boundary_version=5)
+    assert optimizer.step == 1
+    assert not torch.equal(before, optimizer.master[0])
+    assert proposal.safe_boundary_age == 3
+
+
+def test_chronobelief_nonfinite_overflow_fail_closed(live_suite) -> None:
+    _case(live_suite, "chronobelief_nonfinite_overflow_fail_closed")
+    optimizer, proposal = _proposal(torch.float32)
+    proposal.parameters[0].fill_(float("nan"))
+    before = tuple(value.clone() for value in optimizer.state_tensors)
+    finite = torch.stack(
+        [torch.isfinite(value).all() for value in proposal.parameters]
+    ).all()
+    optimizer.commit(
+        proposal,
+        valid=finite,
+        expected_safe_boundary_version=5,
+    )
+    assert all(torch.equal(left, right) for left, right in zip(before, optimizer.state_tensors))
