--- /dev/null
+++ b/python/sglang/srt/speculative/formal_gang_serving.py
@@ -0,0 +1,1065 @@
+"""Source-owned formal TP2/DP2 serving terminal producer.
+
+This module is deliberately independent of the diagnostic project-side gang
+state machine.  A patched scheduler rank is activated only by a complete,
+launch-owned environment and records terminals for the exact request schedule
+opened through the dedicated localhost HTTP endpoint.  TP2 combines the two
+ranks with an all-rank prepare/decision; DP2 proves a disjoint sticky-cohort
+partition and never exposes a cross-replica gradient operation.
+
+The producer emits unsigned raw evidence.  Release authority remains outside
+the GPU process and must bind the resulting aggregate later.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from dataclasses import dataclass
+from typing import Literal
+
+import torch
+
+
+def _canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode("utf-8")
+
+
+def content_sha256(value: object) -> str:
+    return hashlib.sha256(_canonical_bytes(value)).hexdigest()
+
+
+FORMAL_GANG_SERVING_HOOK = "sglang.lightcone_formal_gang_serving.v1"
+FORMAL_GANG_SERVING_PROTOCOL_SHA256 = content_sha256(
+    {
+        "schema_version": 1,
+        "kind": "sglang_source_owned_formal_gang_serving_protocol",
+        "topologies": ["tp2_dp1", "tp1_dp2"],
+        "phases": ["begin", "warmup_terminal", "reset", "scored_terminal", "finalize"],
+        "tp2": "all_rank_prepare_then_atomic_commit_or_zero_rank_abort",
+        "dp2": "sticky_cohort_disjoint_request_partition_no_gradient_collective",
+        "publication": "unsigned_rank_terminals_then_one_all_rank_aggregate",
+        "client_terminal_partition": (
+            "scored_lifecycle_digest_exact_schedule_and_native_submission_reconciliation"
+        ),
+        "caller_callback": False,
+    }
+)
+
+_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
+_METHODS = frozenset(
+    {
+        "target_only",
+        "static",
+        "tts",
+        "l0",
+        "onlinespec_ogd",
+        "onlinespec_opt",
+        "onlinespec_ens",
+    }
+)
+_ACTIONS = frozenset(
+    {
+        "formal_gang_capability",
+        "formal_gang_begin",
+        "formal_gang_reset",
+        "formal_gang_finalize",
+    }
+)
+
+
+def _sha256(label: str, value: object) -> str:
+    if type(value) is not str or _SHA256.fullmatch(value) is None:
+        raise ValueError(f"{label} must be a lower-case SHA-256")
+    return value
+
+
+def _text(label: str, value: object) -> str:
+    if (
+        type(value) is not str
+        or not value
+        or value.strip() != value
+        or "\n" in value
+        or "\r" in value
+        or "\x00" in value
+    ):
+        raise ValueError(f"{label} must be canonical text")
+    return value
+
+
+def _visible_gpu_uuids() -> tuple[str, ...]:
+    raw = os.environ.get("CUDA_VISIBLE_DEVICES", "")
+    values = tuple(value.strip() for value in raw.split(",") if value.strip())
+    if not values or len(values) != len(set(values)):
+        raise RuntimeError("formal gang visible GPU identity is unavailable")
+    return values
+
+
+def _request_row(value: object, *, topology: str) -> dict[str, object]:
+    fields = {"request_id", "cohort_sha256", "routed_dp_rank"}
+    if type(value) is not dict or set(value) != fields:
+        raise ValueError("formal gang request schedule row fields differ")
+    request_id = _text("formal gang request ID", value["request_id"])
+    cohort = _sha256("formal gang cohort", value["cohort_sha256"])
+    routed = value["routed_dp_rank"]
+    if topology == "tp2_dp1":
+        if routed is not None:
+            raise ValueError("TP2 formal requests cannot carry a DP route")
+    elif type(routed) is not int or routed not in {0, 1}:
+        raise ValueError("DP2 formal requests require an exact replica route")
+    return {
+        "request_id": request_id,
+        "cohort_sha256": cohort,
+        "routed_dp_rank": routed,
+    }
+
+
+def _request_schedule(
+    value: object, *, topology: str
+) -> tuple[dict[str, object], ...]:
+    if type(value) is not list or not value:
+        raise ValueError("formal gang request schedule must be non-empty")
+    rows = tuple(_request_row(row, topology=topology) for row in value)
+    request_ids = tuple(str(row["request_id"]) for row in rows)
+    if len(request_ids) != len(set(request_ids)):
+        raise ValueError("formal gang request schedule contains duplicates")
+    if topology == "tp1_dp2":
+        cohort_routes: dict[str, int] = {}
+        for row in rows:
+            cohort = str(row["cohort_sha256"])
+            route = int(row["routed_dp_rank"])
+            previous = cohort_routes.setdefault(cohort, route)
+            if previous != route:
+                raise ValueError("DP2 cohort crossed its sticky replica")
+        if set(cohort_routes.values()) != {0, 1}:
+            raise ValueError("DP2 schedule must exercise both replicas")
+    return rows
+
+
+_CLIENT_LIFECYCLE_FIELDS = frozenset(
+    {
+        "request_id",
+        "phase",
+        "scheduled_arrival_us",
+        "offered",
+        "offered_at_us",
+        "admitted_at_us",
+        "effective_deadline_us",
+        "cancellation_at_us",
+        "terminal_at_us",
+        "outcome_status",
+        "outcome_code",
+        "submitted_to_server",
+        "native_terminal_status",
+        "native_result_pointer_sha256",
+    }
+)
+_CLIENT_OUTCOMES = frozenset(
+    {"completed", "rejected", "timed_out", "cancelled", "unfinished"}
+)
+
+
+def _client_lifecycle_rows(
+    value: object,
+    *,
+    expected_by_phase: dict[str, tuple[dict[str, object], ...]],
+    declared_sha256: object,
+) -> dict[str, tuple[dict[str, object], ...]]:
+    """Validate the complete client partition before exempting any native row."""
+
+    digest = _sha256("formal gang client lifecycle", declared_sha256)
+    if type(value) is not list or content_sha256(value) != digest:
+        raise ValueError("formal gang client lifecycle digest differs")
+    rows = tuple(dict(row) for row in value if type(row) is dict)
+    expected_ids = tuple(
+        str(row["request_id"])
+        for phase in ("warmup", "scored")
+        for row in expected_by_phase[phase]
+    )
+    expected_phase_by_id = {
+        str(row["request_id"]): phase
+        for phase in ("warmup", "scored")
+        for row in expected_by_phase[phase]
+    }
+    if (
+        len(rows) != len(value)
+        or tuple(row.get("request_id") for row in rows) != expected_ids
+    ):
+        raise ValueError("formal gang client lifecycle schedule coverage differs")
+    for row in rows:
+        if set(row) != _CLIENT_LIFECYCLE_FIELDS or row.get("phase") not in {
+            "warmup",
+            "scored",
+        }:
+            raise ValueError("formal gang client lifecycle fields differ")
+        if row["phase"] != expected_phase_by_id[str(row["request_id"])]:
+            raise ValueError("formal gang client lifecycle phase differs")
+        offered = row["offered"]
+        submitted = row["submitted_to_server"]
+        status = row["outcome_status"]
+        if type(offered) is not bool or type(submitted) is not bool:
+            raise TypeError("formal gang client lifecycle flags are invalid")
+        if not offered:
+            if (
+                submitted
+                or status is not None
+                or row["offered_at_us"] is not None
+                or row["admitted_at_us"] is not None
+                or row["native_terminal_status"] is not None
+                or row["native_result_pointer_sha256"] is not None
+            ):
+                raise ValueError("unoffered formal gang request carries a terminal")
+            if row["phase"] == "warmup":
+                raise ValueError(
+                    "formal gang warmup lifecycle is not strict completed"
+                )
+            continue
+        if (
+            status not in _CLIENT_OUTCOMES
+            or type(row["offered_at_us"]) is not int
+            or type(row["effective_deadline_us"]) is not int
+            or type(row["outcome_code"]) is not str
+            or not row["outcome_code"]
+        ):
+            raise ValueError("offered formal gang client terminal is incomplete")
+        if submitted:
+            if (
+                status not in {"completed", "timed_out", "cancelled", "unfinished"}
+                or type(row["admitted_at_us"]) is not int
+                or row["native_terminal_status"] not in {"completed", "aborted"}
+                or (
+                    status == "completed"
+                    and type(row["native_result_pointer_sha256"]) is not str
+                )
+                or (status == "completed")
+                != (row["native_terminal_status"] == "completed")
+            ):
+                raise ValueError("submitted formal gang client/native status differs")
+            if row["native_result_pointer_sha256"] is not None:
+                _sha256(
+                    "submitted formal gang native result pointer",
+                    row["native_result_pointer_sha256"],
+                )
+        elif (
+            status not in {"rejected", "cancelled", "unfinished"}
+            or row["native_terminal_status"] is not None
+            or row["native_result_pointer_sha256"] is not None
+        ):
+            raise ValueError("non-submitted formal gang outcome is not exemptible")
+        if row["phase"] == "warmup" and (
+            not offered
+            or not submitted
+            or status != "completed"
+            or row["native_terminal_status"] != "completed"
+        ):
+            raise ValueError("formal gang warmup lifecycle is not strict completed")
+    return {
+        phase: tuple(row for row in rows if row["phase"] == phase)
+        for phase in ("warmup", "scored")
+    }
+
+
+@dataclass(frozen=True)
+class FormalGangRankTerminal:
+    topology: Literal["tp2_dp1", "tp1_dp2"]
+    rank: int
+    world_size: Literal[2]
+    gpu_uuid: str
+    execution_plan_sha256: str
+    rank_config_sha256: str
+    run_nonce_sha256: str
+    method: str
+    phase: Literal["warmup", "scored"]
+    full_schedule_sha256: str
+    local_request_routes_sha256: str
+    sticky_cohort_routes_sha256: str
+    expected_request_ids_sha256: str
+    client_lifecycle_sha256: str | None
+    non_submitted_request_ids_sha256: str | None
+    request_terminals: tuple[dict[str, object], ...]
+    request_terminal_sha256s: tuple[str, ...]
+    native_state: dict[str, object]
+    native_state_sha256: str
+    status: Literal["COMPLETE", "ABORTED"]
+    reason_code: str | None
+
+    def __post_init__(self) -> None:
+        if self.topology not in {"tp2_dp1", "tp1_dp2"}:
+            raise ValueError("formal gang rank terminal topology is unsupported")
+        if self.rank not in {0, 1} or self.world_size != 2:
+            raise ValueError("formal gang rank terminal coverage differs")
+        _text("formal gang rank terminal GPU", self.gpu_uuid)
+        for label, digest in (
+            ("execution plan", self.execution_plan_sha256),
+            ("rank config", self.rank_config_sha256),
+            ("run nonce", self.run_nonce_sha256),
+            ("full schedule", self.full_schedule_sha256),
+            ("local request routes", self.local_request_routes_sha256),
+            ("sticky cohort routes", self.sticky_cohort_routes_sha256),
+            ("request IDs", self.expected_request_ids_sha256),
+            ("native state", self.native_state_sha256),
+        ):
+            _sha256(f"formal gang rank terminal {label}", digest)
+        if self.phase == "scored" and any(
+            value is not None
+            for value in (
+                self.client_lifecycle_sha256,
+                self.non_submitted_request_ids_sha256,
+            )
+        ):
+            _sha256(
+                "formal gang rank terminal client lifecycle",
+                self.client_lifecycle_sha256,
+            )
+            _sha256(
+                "formal gang rank terminal non-submitted requests",
+                self.non_submitted_request_ids_sha256,
+            )
+        elif self.phase != "scored" and (
+            self.client_lifecycle_sha256 is not None
+            or self.non_submitted_request_ids_sha256 is not None
+        ):
+            raise ValueError("warmup formal gang terminal carries scored lifecycle")
+        if self.method not in _METHODS or self.phase not in {"warmup", "scored"}:
+            raise ValueError("formal gang rank terminal method/phase differs")
+        if (
+            self.status == "COMPLETE"
+            and not self.request_terminals
+            and self.phase != "scored"
+        ):
+            raise ValueError("completed formal gang rank terminal has no request coverage")
+        if tuple(content_sha256(row) for row in self.request_terminals) != (
+            self.request_terminal_sha256s
+        ):
+            raise ValueError("formal gang request terminal content differs")
+        if content_sha256(self.native_state) != self.native_state_sha256:
+            raise ValueError("formal gang native state content differs")
+        if (self.status == "COMPLETE") != (self.reason_code is None):
+            raise ValueError("formal gang rank terminal status/reason differs")
+
+    def to_dict(self) -> dict[str, object]:
+        return {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_rank_terminal",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "topology": self.topology,
+            "rank": self.rank,
+            "world_size": self.world_size,
+            "gpu_uuid": self.gpu_uuid,
+            "execution_plan_sha256": self.execution_plan_sha256,
+            "rank_config_sha256": self.rank_config_sha256,
+            "run_nonce_sha256": self.run_nonce_sha256,
+            "method": self.method,
+            "phase": self.phase,
+            "full_schedule_sha256": self.full_schedule_sha256,
+            "local_request_routes_sha256": self.local_request_routes_sha256,
+            "sticky_cohort_routes_sha256": self.sticky_cohort_routes_sha256,
+            "expected_request_ids_sha256": self.expected_request_ids_sha256,
+            "client_lifecycle_sha256": self.client_lifecycle_sha256,
+            "non_submitted_request_ids_sha256": (
+                self.non_submitted_request_ids_sha256
+            ),
+            "request_terminals": [dict(row) for row in self.request_terminals],
+            "request_terminal_sha256s": list(self.request_terminal_sha256s),
+            "native_state": dict(self.native_state),
+            "native_state_sha256": self.native_state_sha256,
+            "status": self.status,
+            "reason_code": self.reason_code,
+            "terminal_sha256": self.sha256,
+        }
+
+    @property
+    def sha256(self) -> str:
+        value = self.to_dict_without_sha256()
+        return content_sha256(value)
+
+    def to_dict_without_sha256(self) -> dict[str, object]:
+        # Keep digest construction explicit; it must never recurse through to_dict.
+        return {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_rank_terminal",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "topology": self.topology,
+            "rank": self.rank,
+            "world_size": self.world_size,
+            "gpu_uuid": self.gpu_uuid,
+            "execution_plan_sha256": self.execution_plan_sha256,
+            "rank_config_sha256": self.rank_config_sha256,
+            "run_nonce_sha256": self.run_nonce_sha256,
+            "method": self.method,
+            "phase": self.phase,
+            "full_schedule_sha256": self.full_schedule_sha256,
+            "local_request_routes_sha256": self.local_request_routes_sha256,
+            "sticky_cohort_routes_sha256": self.sticky_cohort_routes_sha256,
+            "expected_request_ids_sha256": self.expected_request_ids_sha256,
+            "client_lifecycle_sha256": self.client_lifecycle_sha256,
+            "non_submitted_request_ids_sha256": (
+                self.non_submitted_request_ids_sha256
+            ),
+            "request_terminals": [dict(row) for row in self.request_terminals],
+            "request_terminal_sha256s": list(self.request_terminal_sha256s),
+            "native_state": dict(self.native_state),
+            "native_state_sha256": self.native_state_sha256,
+            "status": self.status,
+            "reason_code": self.reason_code,
+        }
+
+
+class SourceOwnedFormalGangRuntime:
+    """One rank of a fresh formal distributed serving lifecycle."""
+
+    def __init__(
+        self,
+        *,
+        assignment_sha256: str,
+        inventory_sha256: str,
+        execution_plan_sha256: str,
+        rank_config_sha256: str,
+        run_nonce_sha256: str,
+        topology: str,
+        rank: int,
+        world_size: int,
+        method: str,
+        gpu_uuid: str,
+        require_cuda: bool,
+    ) -> None:
+        for label, digest in (
+            ("assignment", assignment_sha256),
+            ("inventory", inventory_sha256),
+            ("execution plan", execution_plan_sha256),
+            ("rank config", rank_config_sha256),
+            ("run nonce", run_nonce_sha256),
+        ):
+            _sha256(f"formal gang {label}", digest)
+        if topology not in {"tp2_dp1", "tp1_dp2"} or world_size != 2:
+            raise ValueError("formal gang requires exact world-size-two topology")
+        if rank not in {0, 1} or method not in _METHODS:
+            raise ValueError("formal gang rank or method is unsupported")
+        if gpu_uuid not in _visible_gpu_uuids():
+            raise ValueError("formal gang GPU is outside visible assignment")
+        if require_cuda and (not torch.cuda.is_available() or torch.cuda.device_count() < 1):
+            raise RuntimeError("formal gang requires a live CUDA device")
+        self.assignment_sha256 = assignment_sha256
+        self.inventory_sha256 = inventory_sha256
+        self.execution_plan_sha256 = execution_plan_sha256
+        self.rank_config_sha256 = rank_config_sha256
+        self.run_nonce_sha256 = run_nonce_sha256
+        self.topology = topology
+        self.rank = rank
+        self.world_size = world_size
+        self.method = method
+        self.gpu_uuid = gpu_uuid
+        self.phase = "IDLE"
+        self.begin_sha256: str | None = None
+        self.reset_sha256: str | None = None
+        self._expected: dict[str, tuple[dict[str, object], ...]] = {}
+        self._full_schedule_sha256: str | None = None
+        self._sticky_cohort_routes_sha256: str | None = None
+        self._terminals: dict[str, dict[str, dict[str, object]]] = {
+            "warmup": {},
+            "scored": {},
+        }
+        self.failed = False
+
+    @classmethod
+    def from_environment(
+        cls,
+        *,
+        topology: str,
+        rank: int,
+        world_size: int,
+        gpu_index: int,
+        method: str,
+    ) -> SourceOwnedFormalGangRuntime | None:
+        if os.environ.get("LIGHTCONE_FORMAL_GANG_ENABLE") != "1":
+            return None
+        values: dict[str, str] = {}
+        for suffix in (
+            "ASSIGNMENT_SHA256",
+            "INVENTORY_SHA256",
+            "EXECUTION_PLAN_SHA256",
+            "RANK_CONFIG_SHA256",
+            "RUN_NONCE_SHA256",
+        ):
+            key = f"LIGHTCONE_FORMAL_GANG_{suffix}"
+            if key not in os.environ:
+                raise RuntimeError(f"formal gang environment lacks {key}")
+            values[suffix] = os.environ[key]
+        visible = _visible_gpu_uuids()
+        if gpu_index not in range(len(visible)):
+            raise RuntimeError("formal gang GPU index is not visible")
+        return cls(
+            assignment_sha256=values["ASSIGNMENT_SHA256"],
+            inventory_sha256=values["INVENTORY_SHA256"],
+            execution_plan_sha256=values["EXECUTION_PLAN_SHA256"],
+            rank_config_sha256=values["RANK_CONFIG_SHA256"],
+            run_nonce_sha256=values["RUN_NONCE_SHA256"],
+            topology=topology,
+            rank=rank,
+            world_size=world_size,
+            method=method,
+            gpu_uuid=visible[gpu_index],
+            require_cuda=True,
+        )
+
+    def capability(self) -> dict[str, object]:
+        if self.failed:
+            raise RuntimeError("formal gang rank is terminally failed")
+        return {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_rank_capability",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "assignment_sha256": self.assignment_sha256,
+            "inventory_sha256": self.inventory_sha256,
+            "execution_plan_sha256": self.execution_plan_sha256,
+            "rank_config_sha256": self.rank_config_sha256,
+            "run_nonce_sha256": self.run_nonce_sha256,
+            "topology": self.topology,
+            "rank": self.rank,
+            "world_size": self.world_size,
+            "method": self.method,
+            "gpu_uuid": self.gpu_uuid,
+            "process_id": os.getpid(),
+        }
+
+    def fail_closed(self) -> None:
+        self.failed = True
+        self.phase = "FAILED"
+
+    def begin(self, payload: dict[str, object]) -> dict[str, object]:
+        expected_fields = {
+            "hook",
+            "protocol_sha256",
+            "assignment_sha256",
+            "inventory_sha256",
+            "execution_plan_sha256",
+            "rank_config_sha256",
+            "run_nonce_sha256",
+            "method",
+            "topology",
+            "warmup_requests",
+            "scored_requests",
+        }
+        if self.failed or self.phase != "IDLE" or set(payload) != expected_fields:
+            raise ValueError("formal gang begin is replayed or malformed")
+        for field in (
+            "hook",
+            "protocol_sha256",
+            "assignment_sha256",
+            "inventory_sha256",
+            "execution_plan_sha256",
+            "rank_config_sha256",
+            "run_nonce_sha256",
+            "method",
+            "topology",
+        ):
+            expected = (
+                FORMAL_GANG_SERVING_HOOK
+                if field == "hook"
+                else FORMAL_GANG_SERVING_PROTOCOL_SHA256
+                if field == "protocol_sha256"
+                else getattr(self, field)
+            )
+            if payload[field] != expected:
+                raise ValueError(f"formal gang begin {field} differs")
+        warmup = _request_schedule(payload["warmup_requests"], topology=self.topology)
+        scored = _request_schedule(payload["scored_requests"], topology=self.topology)
+        if {row["request_id"] for row in warmup} & {
+            row["request_id"] for row in scored
+        }:
+            raise ValueError("formal gang warmup/scored requests overlap")
+        if self.topology == "tp1_dp2":
+            global_routes: dict[str, int] = {}
+            for row in (*warmup, *scored):
+                cohort = str(row["cohort_sha256"])
+                route = int(row["routed_dp_rank"])
+                prior = global_routes.setdefault(cohort, route)
+                if prior != route:
+                    raise ValueError("DP2 cohort route changed between phases")
+        self._expected = {"warmup": warmup, "scored": scored}
+        all_rows = (*warmup, *scored)
+        self._full_schedule_sha256 = content_sha256(
+            {"warmup": list(warmup), "scored": list(scored)}
+        )
+        self._sticky_cohort_routes_sha256 = content_sha256(
+            sorted(
+                {
+                    str(row["cohort_sha256"]): row["routed_dp_rank"]
+                    for row in all_rows
+                }.items()
+            )
+        )
+        begin = {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_rank_begin",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "topology": self.topology,
+            "rank": self.rank,
+            "execution_plan_sha256": self.execution_plan_sha256,
+            "schedule_sha256": self._full_schedule_sha256,
+        }
+        self.begin_sha256 = content_sha256(begin)
+        self.phase = "WARMUP"
+        return {**begin, "begin_sha256": self.begin_sha256}
+
+    def note_request_terminal(
+        self,
+        *,
+        request_id: str,
+        input_token_ids: tuple[int, ...],
+        output_token_ids: tuple[int, ...],
+        native_token_timestamp_semantics: str | None,
+        native_token_timestamp_events: tuple[tuple[int, int], ...],
+        terminal_status: str,
+        terminal_reason: str,
+    ) -> None:
+        if self.failed or self.phase not in {"WARMUP", "SCORED"}:
+            return
+        phase = self.phase.lower()
+        expected = self._expected[phase]
+        matches = tuple(row for row in expected if row["request_id"] == request_id)
+        if self.topology == "tp1_dp2":
+            matches = tuple(
+                row for row in matches if row["routed_dp_rank"] == self.rank
+            )
+        if len(matches) != 1 or request_id in self._terminals[phase]:
+            self.fail_closed()
+            raise ValueError("formal gang observed an unexpected/duplicate terminal")
+        if (
+            not input_token_ids
+            or any(type(token) is not int or token < 0 for token in input_token_ids)
+            or any(type(token) is not int or token < 0 for token in output_token_ids)
+            or terminal_status not in {"completed", "aborted"}
+        ):
+            self.fail_closed()
+            raise ValueError("formal gang request terminal is invalid")
+        if (
+            native_token_timestamp_semantics
+            != "scheduler_committed_token_at_result_processor_v1"
+            or len(native_token_timestamp_events) != len(output_token_ids)
+            or tuple(token for token, _observed_ns in native_token_timestamp_events)
+            != output_token_ids
+            or any(
+                type(observed_ns) is not int or observed_ns < 0
+                for _token, observed_ns in native_token_timestamp_events
+            )
+            or any(
+                right <= left
+                for left, right in zip(
+                    (row[1] for row in native_token_timestamp_events),
+                    (row[1] for row in native_token_timestamp_events[1:]),
+                )
+            )
+        ):
+            self.fail_closed()
+            raise ValueError("formal gang native ITL coverage is invalid")
+        native_itl_events = [
+            {
+                "token_index": index,
+                "token_id": token_id,
+                "observed_ns": observed_ns,
+            }
+            for index, (token_id, observed_ns) in enumerate(
+                native_token_timestamp_events
+            )
+        ]
+        self._terminals[phase][request_id] = {
+            "request_id": request_id,
+            "input_token_ids": list(input_token_ids),
+            "output_token_ids": list(output_token_ids),
+            "native_itl_semantics": native_token_timestamp_semantics,
+            "native_itl_event_count": len(native_itl_events),
+            "native_itl_events_sha256": content_sha256(native_itl_events),
+            "terminal_status": terminal_status,
+            "terminal_reason": _text("formal gang terminal reason", terminal_reason),
+        }
+
+    def _terminal(
+        self,
+        phase: Literal["warmup", "scored"],
+        *,
+        native_state: object,
+        client_lifecycle_rows: object = None,
+        client_lifecycle_sha256: object = None,
+    ) -> FormalGangRankTerminal:
+        expected = self._expected[phase]
+        local = tuple(
+            row
+            for row in expected
+            if self.topology == "tp2_dp1" or row["routed_dp_rank"] == self.rank
+        )
+        request_ids = tuple(str(row["request_id"]) for row in local)
+        observed = self._terminals[phase]
+        non_submitted_ids: tuple[str, ...] = ()
+        lifecycle_digest: str | None = None
+        if (
+            phase == "scored"
+            and client_lifecycle_rows is not None
+            and client_lifecycle_sha256 is not None
+        ):
+            lifecycle = _client_lifecycle_rows(
+                client_lifecycle_rows,
+                expected_by_phase=self._expected,
+                declared_sha256=client_lifecycle_sha256,
+            )[phase]
+            lifecycle_digest = str(client_lifecycle_sha256)
+            local_ids = set(request_ids)
+            local_lifecycle = tuple(
+                row for row in lifecycle if row["request_id"] in local_ids
+            )
+            submitted_ids = {
+                str(row["request_id"])
+                for row in local_lifecycle
+                if row["submitted_to_server"] is True
+            }
+            non_submitted_ids = tuple(
+                str(row["request_id"])
+                for row in local_lifecycle
+                if row["submitted_to_server"] is False
+            )
+            complete = set(observed) == submitted_ids
+            if complete:
+                lifecycle_by_id = {
+                    str(row["request_id"]): row for row in local_lifecycle
+                }
+                complete = all(
+                    lifecycle_by_id[request_id]["native_terminal_status"]
+                    == observed[request_id]["terminal_status"]
+                    for request_id in submitted_ids
+                )
+        elif phase == "scored" and (
+            client_lifecycle_rows is not None
+            or client_lifecycle_sha256 is not None
+        ):
+            raise ValueError("formal gang client lifecycle binding is partial")
+        else:
+            complete = set(observed) == set(request_ids)
+        request_terminals = tuple(
+            observed[request_id] for request_id in request_ids if request_id in observed
+        )
+        values = tuple(content_sha256(row) for row in request_terminals)
+        if type(native_state) is not dict:
+            raise TypeError("formal gang native state must be an object")
+        if self._full_schedule_sha256 is None or self._sticky_cohort_routes_sha256 is None:
+            raise RuntimeError("formal gang schedule identity is unavailable")
+        return FormalGangRankTerminal(
+            topology=self.topology,  # type: ignore[arg-type]
+            rank=self.rank,
+            world_size=2,
+            gpu_uuid=self.gpu_uuid,
+            execution_plan_sha256=self.execution_plan_sha256,
+            rank_config_sha256=self.rank_config_sha256,
+            run_nonce_sha256=self.run_nonce_sha256,
+            method=self.method,
+            phase=phase,
+            full_schedule_sha256=self._full_schedule_sha256,
+            local_request_routes_sha256=content_sha256(list(local)),
+            sticky_cohort_routes_sha256=self._sticky_cohort_routes_sha256,
+            expected_request_ids_sha256=content_sha256(list(request_ids)),
+            client_lifecycle_sha256=lifecycle_digest,
+            non_submitted_request_ids_sha256=(
+                None
+                if phase == "warmup" or lifecycle_digest is None
+                else content_sha256(list(non_submitted_ids))
+            ),
+            request_terminals=request_terminals,
+            request_terminal_sha256s=values,
+            native_state=dict(native_state),
+            native_state_sha256=content_sha256(native_state),
+            status="COMPLETE" if complete else "ABORTED",
+            reason_code=None if complete else "incomplete_rank_request_coverage",
+        )
+
+    def request_terminals(
+        self,
+        phase: Literal["warmup", "scored"],
+        *,
+        client_lifecycle_rows: object = None,
+        client_lifecycle_sha256: object = None,
+    ) -> tuple[dict[str, object], ...]:
+        """Return exact local rows in the launch-owned schedule order."""
+
+        if phase not in self._expected:
+            raise ValueError("formal gang request terminal phase is unavailable")
+        expected = tuple(
+            row
+            for row in self._expected[phase]
+            if self.topology == "tp2_dp1" or row["routed_dp_rank"] == self.rank
+        )
+        request_ids = tuple(str(row["request_id"]) for row in expected)
+        observed = self._terminals[phase]
+        if (
+            phase == "scored"
+            and client_lifecycle_rows is not None
+            and client_lifecycle_sha256 is not None
+        ):
+            lifecycle = _client_lifecycle_rows(
+                client_lifecycle_rows,
+                expected_by_phase=self._expected,
+                declared_sha256=client_lifecycle_sha256,
+            )[phase]
+            local_ids = set(request_ids)
+            submitted_ids = {
+                str(row["request_id"])
+                for row in lifecycle
+                if row["request_id"] in local_ids
+                and row["submitted_to_server"] is True
+            }
+            if set(observed) != submitted_ids:
+                raise RuntimeError(
+                    "formal gang native/client terminal reconciliation differs"
+                )
+        elif phase == "scored" and (
+            client_lifecycle_rows is not None
+            or client_lifecycle_sha256 is not None
+        ):
+            raise ValueError("formal gang client lifecycle binding is partial")
+        elif set(observed) != set(request_ids):
+            raise RuntimeError("formal gang request terminal coverage is incomplete")
+        return tuple(
+            dict(observed[request_id])
+            for request_id in request_ids
+            if request_id in observed
+        )
+
+    def reset(self, payload: dict[str, object], *, native_state: object) -> dict[str, object]:
+        rank_begin_sha256s = payload.get("rank_begin_sha256s")
+        if (
+            self.failed
+            or self.phase != "WARMUP"
+            or set(payload) != {"hook", "rank_begin_sha256s"}
+            or payload["hook"] != FORMAL_GANG_SERVING_HOOK
+            or type(rank_begin_sha256s) is not list
+            or len(rank_begin_sha256s) != 2
+            or rank_begin_sha256s[self.rank] != self.begin_sha256
+        ):
+            raise ValueError("formal gang reset identity differs")
+        terminal = self._terminal("warmup", native_state=native_state)
+        if terminal.status != "COMPLETE":
+            self.fail_closed()
+        value = {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_rank_reset",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "rank_terminal": terminal.to_dict(),
+            "rank_terminal_sha256": terminal.sha256,
+            "begin_sha256": self.begin_sha256,
+        }
+        self.reset_sha256 = content_sha256(value)
+        if not self.failed:
+            self.phase = "SCORED"
+        return {**value, "reset_sha256": self.reset_sha256}
+
+    def finalize(
+        self, payload: dict[str, object], *, native_state: object
+    ) -> dict[str, object]:
+        rank_reset_sha256s = payload.get("rank_reset_sha256s")
+        client_lifecycle_rows = payload.get("client_lifecycle_rows")
+        client_lifecycle_sha256 = payload.get("client_lifecycle_sha256")
+        if (
+            self.failed
+            or self.phase != "SCORED"
+            or set(payload)
+            not in (
+                {"hook", "rank_reset_sha256s"},
+                {
+                    "hook",
+                    "rank_reset_sha256s",
+                    "client_lifecycle_rows",
+                    "client_lifecycle_sha256",
+                },
+            )
+            or payload["hook"] != FORMAL_GANG_SERVING_HOOK
+            or type(rank_reset_sha256s) is not list
+            or len(rank_reset_sha256s) != 2
+            or rank_reset_sha256s[self.rank] != self.reset_sha256
+        ):
+            raise ValueError("formal gang finalize identity differs")
+        terminal = self._terminal(
+            "scored",
+            native_state=native_state,
+            client_lifecycle_rows=client_lifecycle_rows,
+            client_lifecycle_sha256=client_lifecycle_sha256,
+        )
+        self.phase = "FINALIZED" if terminal.status == "COMPLETE" else "FAILED"
+        self.failed = terminal.status != "COMPLETE"
+        return {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_rank_finalize",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "rank_terminal": terminal.to_dict(),
+            "rank_terminal_sha256": terminal.sha256,
+            "reset_sha256": self.reset_sha256,
+        }
+
+
+def aggregate_formal_gang_rank_responses(
+    action: str, responses: list[dict[str, object]]
+) -> dict[str, object]:
+    """Build one exact all-rank response from scheduler-owned rank rows."""
+
+    if action not in _ACTIONS or type(responses) is not list:
+        raise ValueError("formal gang aggregate action/responses are invalid")
+    by_rank: dict[int, dict[str, object]] = {}
+    for response in responses:
+        if type(response) is not dict:
+            raise TypeError("formal gang rank response must be an object")
+        if response.get("kind") == "sglang_formal_gang_rank_capability":
+            rank = response.get("rank")
+        else:
+            rank_terminal = response.get("rank_terminal")
+            rank = (
+                rank_terminal.get("rank")
+                if type(rank_terminal) is dict
+                else response.get("rank")
+            )
+        if type(rank) is not int or rank not in {0, 1}:
+            raise ValueError("formal gang rank response lacks exact rank")
+        existing = by_rank.get(rank)
+        if existing is not None and existing != response:
+            raise ValueError("formal gang rank response conflicts across fanout")
+        by_rank[rank] = response
+    if set(by_rank) != {0, 1}:
+        raise ValueError("formal gang aggregate lacks exact two-rank coverage")
+    ordered = [by_rank[0], by_rank[1]]
+    topology = (
+        ordered[0].get("topology")
+        if action in {"formal_gang_capability", "formal_gang_begin"}
+        else ordered[0]["rank_terminal"].get("topology")
+    )
+    if topology not in {"tp2_dp1", "tp1_dp2"}:
+        raise ValueError("formal gang aggregate topology differs")
+    if action == "formal_gang_capability":
+        identity_fields = (
+            "hook",
+            "protocol_sha256",
+            "assignment_sha256",
+            "inventory_sha256",
+            "execution_plan_sha256",
+            "rank_config_sha256",
+            "run_nonce_sha256",
+            "topology",
+            "world_size",
+            "method",
+        )
+        if any(
+            row.get(field) != ordered[0].get(field)
+            for row in ordered[1:]
+            for field in identity_fields
+        ):
+            raise ValueError("formal gang capabilities do not share one launch")
+        return {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_capability",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "topology": topology,
+            "world_size": 2,
+            "method": ordered[0]["method"],
+            "execution_plan_sha256": ordered[0]["execution_plan_sha256"],
+            "rank_config_sha256": ordered[0]["rank_config_sha256"],
+            "run_nonce_sha256": ordered[0]["run_nonce_sha256"],
+            "rank_capabilities": ordered,
+            "rank_capability_sha256s": [content_sha256(row) for row in ordered],
+        }
+    if action == "formal_gang_begin":
+        if any(
+            row.get("kind") != "sglang_formal_gang_rank_begin"
+            or row.get("hook") != FORMAL_GANG_SERVING_HOOK
+            or row.get("protocol_sha256") != FORMAL_GANG_SERVING_PROTOCOL_SHA256
+            or row.get("topology") != topology
+            or row.get("execution_plan_sha256")
+            != ordered[0].get("execution_plan_sha256")
+            or row.get("schedule_sha256") != ordered[0].get("schedule_sha256")
+            for row in ordered
+        ):
+            raise ValueError("formal gang begin rows belong to different schedules")
+        value = {
+            "schema_version": 1,
+            "kind": "sglang_formal_gang_begin",
+            "hook": FORMAL_GANG_SERVING_HOOK,
+            "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+            "topology": topology,
+            "world_size": 2,
+            "execution_plan_sha256": ordered[0]["execution_plan_sha256"],
+            "schedule_sha256": ordered[0]["schedule_sha256"],
+            "rank_begin_sha256s": [str(row["begin_sha256"]) for row in ordered],
+        }
+        value["begin_sha256"] = content_sha256(value)
+        return value
+    terminals = [row["rank_terminal"] for row in ordered]
+    assert all(type(row) is dict for row in terminals)
+    if any(
+        terminal.get("topology") != topology
+        or terminal.get("execution_plan_sha256")
+        != terminals[0].get("execution_plan_sha256")
+        or terminal.get("run_nonce_sha256") != terminals[0].get("run_nonce_sha256")
+        or terminal.get("method") != terminals[0].get("method")
+        or terminal.get("phase") != terminals[0].get("phase")
+        or terminal.get("full_schedule_sha256")
+        != terminals[0].get("full_schedule_sha256")
+        or terminal.get("sticky_cohort_routes_sha256")
+        != terminals[0].get("sticky_cohort_routes_sha256")
+        or terminal.get("client_lifecycle_sha256")
+        != terminals[0].get("client_lifecycle_sha256")
+        for terminal in terminals
+    ):
+        raise ValueError("formal gang rank terminals belong to different runs")
+    complete = all(terminal.get("status") == "COMPLETE" for terminal in terminals)
+    if topology == "tp2_dp1" and complete:
+        complete = (
+            terminals[0].get("expected_request_ids_sha256")
+            == terminals[1].get("expected_request_ids_sha256")
+        )
+    if topology == "tp1_dp2" and complete:
+        complete = (
+            terminals[0].get("expected_request_ids_sha256")
+            != terminals[1].get("expected_request_ids_sha256")
+            and terminals[0].get("local_request_routes_sha256")
+            != terminals[1].get("local_request_routes_sha256")
+        )
+    decision = "COMMITTED" if complete else "ABORTED"
+    rank_digests = [str(row["rank_terminal_sha256"]) for row in ordered]
+    aggregate = {
+        "schema_version": 1,
+        "kind": "sglang_formal_gang_all_rank_terminal",
+        "hook": FORMAL_GANG_SERVING_HOOK,
+        "protocol_sha256": FORMAL_GANG_SERVING_PROTOCOL_SHA256,
+        "action": action,
+        "topology": topology,
+        "world_size": 2,
+        "rank_terminal_sha256s": rank_digests,
+        "rank_terminals": terminals,
+        "decision": decision,
+        "published_ranks": [0, 1] if complete else [],
+        "reason_code": None if complete else "all_rank_prepare_or_coverage_failed",
+        "cross_replica_gradient_collective": False,
+    }
+    if action == "formal_gang_reset":
+        aggregate["rank_reset_sha256s"] = [
+            str(row["reset_sha256"]) for row in ordered
+        ]
+    aggregate["aggregate_sha256"] = content_sha256(aggregate)
+    return aggregate
+
+
+__all__ = [
+    "FORMAL_GANG_SERVING_HOOK",
+    "FORMAL_GANG_SERVING_PROTOCOL_SHA256",
+    "FormalGangRankTerminal",
+    "SourceOwnedFormalGangRuntime",
+    "aggregate_formal_gang_rank_responses",
+    "content_sha256",
+]
