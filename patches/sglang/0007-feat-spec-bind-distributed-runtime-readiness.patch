+def _publish_exclusive_json(path: Path, value: object) -> None:
+    """Publish canonical JSON and semantic sidecar without replacement."""
+
+    if not path.is_absolute() or path != path.resolve(strict=False):
+        raise ValueError("qualification terminal path must be absolute and normalized")
+    if not path.parent.is_dir() or path.parent.is_symlink():
+        raise ValueError("qualification terminal parent must be a regular directory")
+    body = (
+        json.dumps(
+            value,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        ).encode("utf-8")
+        + b"\n"
+    )
+
+    def publish(target: Path, payload: bytes) -> None:
+        temporary = target.with_name(f"{target.name}.tmp.{uuid.uuid4().hex}")
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
+        descriptor = os.open(temporary, flags, 0o600)
+        try:
+            offset = 0
+            while offset < len(payload):
+                offset += os.write(descriptor, payload[offset:])
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+        try:
+            os.link(temporary, target)
+        except FileExistsError as error:
+            raise RuntimeError("qualification terminal target already exists") from error
+        finally:
+            temporary.unlink(missing_ok=True)
+
+    publish(path, body)
+    publish(Path(f"{path}.sha256"), f"{_sha256(value)}\n".encode("ascii"))
+    directory = os.open(path.parent, os.O_RDONLY)
+    try:
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+
