+"""Proof-gated native adaptation state machines for the LightCone patch.
+
+The classes in this module execute real tensor/state transitions.  They do not
+turn CPU tests into GPU evidence: construction of a live runtime requires an
+exact verified token produced by the source-owned ``lightcone_spec`` verifier.
+Direct SGLang launches therefore fail before worker or optimizer allocation.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import time
+import uuid
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal, Protocol
+
+import torch
+
+NEXTN_MTP_INTERFACE_SHA256 = hashlib.sha256(
+    b'{"drafter":"frozen_kv_mtp","hidden":"actual_mtp_rows",'
+    b'"mask":"target_verified_rows","schema_version":1,'
+    b'"source":"adapter_version","teacher":"target_verify_logits",'
+    b'"tp2_models":["target_two_shards","drafter_two_shards"]}'
+).hexdigest()
+
+
+def _sha256(value: object) -> str:
+    return hashlib.sha256(
+        json.dumps(
+            value,
+            sort_keys=True,
+            separators=(",", ":"),
+            ensure_ascii=False,
+            allow_nan=False,
+        ).encode()
+    ).hexdigest()
+
+
+def _require_sha256(label: str, value: str) -> None:
+    if len(value) != 64 or any(character not in "0123456789abcdef" for character in value):
+        raise ValueError(f"{label} must be a lowercase SHA-256")
+
+
+def _require_tensor(label: str, value: object, *, ndim: int) -> torch.Tensor:
+    if not isinstance(value, torch.Tensor):
+        raise TypeError(f"{label} must be a tensor")
+    if value.ndim != ndim or not value.is_floating_point():
+        raise ValueError(f"{label} must be a rank-{ndim} floating tensor")
+    return value
+
+
+@dataclass(frozen=True)
+class NativeRuntimeAuthority:
+    """Opaque bridge from the source verifier into the patched worker."""
+
+    proof_sha256: str
+    source_capability_sha256: str
+    source_identity_sha256: str
+    inventory_sha256: str
+    hardware_envelope_sha256: str
+    topology_mode: Literal["tp1_dp1", "tp2_dp1", "tp1_dp2"]
+    topology_sha256: str
+    gpu_uuids: tuple[str, ...]
+    backend_capabilities: tuple[str, ...]
+    proof_sha256s: tuple[str, ...] = ()
+    source_capability_sha256s: tuple[str, ...] = ()
+    qualification_only: bool = False
+    qualification_suite_id: str | None = None
+    qualification_assignment_sha256: str | None = None
+    qualification_dispatch_sha256: str | None = None
+    eagle3_selector_status: str | None = None
+    eagle3_compatibility_authority_sha256: str | None = None
+    eagle3_model_selector_sha256: str | None = None
+
+    def __post_init__(self) -> None:
+        for label, value in (
+            ("native proof", self.proof_sha256),
+            ("native source capability", self.source_capability_sha256),
+            ("native source identity", self.source_identity_sha256),
+            ("native inventory", self.inventory_sha256),
+            ("native hardware envelope", self.hardware_envelope_sha256),
+            ("native topology", self.topology_sha256),
+        ):
+            _require_sha256(label, value)
+        expected = 1 if self.topology_mode == "tp1_dp1" else 2
+        if len(self.gpu_uuids) != expected or len(set(self.gpu_uuids)) != expected:
+            raise ValueError("native authority has the wrong unique GPU coverage")
+        if self.backend_capabilities != tuple(sorted(set(self.backend_capabilities))):
+            raise ValueError("native backend capabilities must be sorted and unique")
+        for label, values in (
+            ("native proof set", self.proof_sha256s),
+            ("native source capability set", self.source_capability_sha256s),
+        ):
+            if values != tuple(sorted(set(values))) or any(
+                not isinstance(value, str) or len(value) != 64 for value in values
+            ):
+                raise ValueError(f"{label} must be canonical and unique")
+        if type(self.qualification_only) is not bool:
+            raise TypeError("native qualification-only marker must be boolean")
+        qualification = (
+            self.qualification_suite_id,
+            self.qualification_assignment_sha256,
+            self.qualification_dispatch_sha256,
+        )
+        eagle3 = (
+            self.eagle3_selector_status,
+            self.eagle3_compatibility_authority_sha256,
+            self.eagle3_model_selector_sha256,
+        )
+        if self.qualification_only:
+            if any(value is None for value in qualification):
+                raise ValueError("native qualification authority lacks exact lineage")
+            _require_sha256(
+                "qualification assignment", self.qualification_assignment_sha256
+            )
+            _require_sha256(
+                "qualification dispatch", self.qualification_dispatch_sha256
+            )
+            if self.qualification_suite_id == "eagle3_tp1":
+                if (
+                    self.topology_mode != "tp1_dp1"
+                    or self.eagle3_selector_status != "COMPATIBLE"
+                    or self.backend_capabilities
+                    != ("eagle3", "graph_hot_path", "native_itl")
+                    or any(value is None for value in eagle3[1:])
+                ):
+                    raise ValueError(
+                        "EAGLE3 qualification lacks its compatible TP1 selector"
+                    )
+                _require_sha256(
+                    "EAGLE3 qualification compatibility",
+                    self.eagle3_compatibility_authority_sha256,
+                )
+                _require_sha256(
+                    "EAGLE3 qualification selector",
+                    self.eagle3_model_selector_sha256,
+                )
+            elif any(value is not None for value in eagle3):
+                raise ValueError("EAGLE3 selector leaked into another qualification")
+        elif any(value is not None for value in (*qualification, *eagle3)):
+            raise ValueError("formal runtime authority cannot carry qualification data")
+
+
+@dataclass(frozen=True)
+class NativeRuntimeQualificationBootstrap:
+    """Unsigned live-suite bridge; incapable of authorizing formal evidence."""
+
+    assignment_sha256: str
+    dispatch_sha256: str
+    suite_id: str
+    source_capability_sha256: str
+    source_identity_sha256: str
+    inventory_sha256: str
+    hardware_envelope_sha256: str
+    topology_mode: Literal["tp1_dp1", "tp2_dp1", "tp1_dp2"]
+    topology_sha256: str
+    gpu_uuids: tuple[str, ...]
+    backend_capabilities: tuple[str, ...]
+    eagle3_selector_status: str | None
+    eagle3_compatibility_authority_sha256: str | None
+    eagle3_model_selector_sha256: str | None
+    qualification_only: Literal[True] = True
+
+    def __post_init__(self) -> None:
+        for label, value in (
+            ("qualification assignment", self.assignment_sha256),
+            ("qualification dispatch", self.dispatch_sha256),
+            ("qualification source capability", self.source_capability_sha256),
+            ("qualification source identity", self.source_identity_sha256),
+            ("qualification inventory", self.inventory_sha256),
+            ("qualification hardware envelope", self.hardware_envelope_sha256),
+            ("qualification topology", self.topology_sha256),
+        ):
+            _require_sha256(label, value)
+        expected = 1 if self.topology_mode == "tp1_dp1" else 2
+        if (
+            self.qualification_only is not True
+            or not self.suite_id
+            or len(self.gpu_uuids) != expected
+            or len(set(self.gpu_uuids)) != expected
+            or self.backend_capabilities
+            != tuple(sorted(set(self.backend_capabilities)))
+        ):
+            raise ValueError("native qualification bootstrap is not canonical")
+        eagle3 = (
+            self.eagle3_selector_status,
+            self.eagle3_compatibility_authority_sha256,
+            self.eagle3_model_selector_sha256,
+        )
+        if self.suite_id == "eagle3_tp1":
+            if (
+                self.topology_mode != "tp1_dp1"
+                or self.eagle3_selector_status != "COMPATIBLE"
+                or self.backend_capabilities
+                != ("eagle3", "graph_hot_path", "native_itl")
+                or any(value is None for value in eagle3[1:])
+            ):
+                raise ValueError(
+                    "EAGLE3 qualification bootstrap lacks official compatibility"
+                )
+            _require_sha256(
+                "EAGLE3 qualification compatibility",
+                self.eagle3_compatibility_authority_sha256,
+            )
+            _require_sha256(
+                "EAGLE3 qualification selector", self.eagle3_model_selector_sha256
+            )
+        elif any(value is not None for value in eagle3):
+            raise ValueError("EAGLE3 selector is forbidden for another live suite")
+
+
+def bind_verified_runtime_authority(
+    verified_proof: object,
+    *,
+    topology_mode: Literal["tp1_dp1", "tp2_dp1", "tp1_dp2"],
+    topology_sha256: str,
+    source_capability_sha256: str,
+    required_backend_capabilities: Sequence[str] = (),
+) -> NativeRuntimeAuthority:
+    """Accept only an object sealed by LightCone's root-signature verifier."""
+
+    try:
+        from lightcone_spec.runtime.distributed import (
+            VerifiedDistributedRuntimeGpuProof,
+        )
+        from lightcone_spec.runtime.readiness import VerifiedNativeRuntimeGpuProof
+    except ImportError as error:  # direct upstream launch is never authoritative
+        raise RuntimeError("LightCone release verifier is unavailable") from error
+
+    distributed = type(verified_proof) is VerifiedDistributedRuntimeGpuProof
+    native = type(verified_proof) is VerifiedNativeRuntimeGpuProof
+    qualification = type(verified_proof) is NativeRuntimeQualificationBootstrap
+    if not (distributed or native or qualification):
+        raise TypeError("native runtime requires an exact source-verified GPU proof")
+    if (
+        verified_proof.topology_mode != topology_mode
+        or verified_proof.topology_sha256 != topology_sha256
+        or verified_proof.source_capability_sha256 != source_capability_sha256
+    ):
+        raise ValueError("verified GPU proof belongs to another runtime identity")
+    capabilities = () if distributed else tuple(verified_proof.backend_capabilities)
+    required = frozenset(required_backend_capabilities)
+    if not required <= frozenset(capabilities):
+        raise RuntimeError("verified GPU proof lacks the required native backend")
+    proof_sha256 = (
+        _sha256(
+            {
+                "assignment_sha256": verified_proof.assignment_sha256,
+                "dispatch_sha256": verified_proof.dispatch_sha256,
+                "source_capability_sha256": verified_proof.source_capability_sha256,
+            }
+        )
+        if qualification
+        else verified_proof.receipt_sha256
+    )
+    return NativeRuntimeAuthority(
+        proof_sha256=proof_sha256,
+        source_capability_sha256=verified_proof.source_capability_sha256,
+        source_identity_sha256=verified_proof.source_identity_sha256,
+        inventory_sha256=verified_proof.inventory_sha256,
+        hardware_envelope_sha256=verified_proof.hardware_envelope_sha256,
+        topology_mode=topology_mode,
+        topology_sha256=topology_sha256,
+        gpu_uuids=tuple(verified_proof.gpu_uuids),
+        backend_capabilities=capabilities,
+        proof_sha256s=(proof_sha256,),
+        source_capability_sha256s=(verified_proof.source_capability_sha256,),
+        qualification_only=qualification,
+        qualification_suite_id=(verified_proof.suite_id if qualification else None),
+        qualification_assignment_sha256=(
+            verified_proof.assignment_sha256 if qualification else None
+        ),
+        qualification_dispatch_sha256=(
+            verified_proof.dispatch_sha256 if qualification else None
+        ),
+        eagle3_selector_status=(
+            verified_proof.eagle3_selector_status if qualification else None
+        ),
+        eagle3_compatibility_authority_sha256=(
+            verified_proof.eagle3_compatibility_authority_sha256
+            if qualification
+            else None
+        ),
+        eagle3_model_selector_sha256=(
+            verified_proof.eagle3_model_selector_sha256 if qualification else None
+        ),
+    )
+
+
+GpuProofProvider = Callable[[], object | Mapping[str, object] | None]
+_GPU_PROOF_PROVIDER: GpuProofProvider | None = None
+RankPublicationHook = Callable[["RankPrepare"], "AllRankPublicationReceipt"]
+RankPublicationHookProvider = Callable[[NativeRuntimeAuthority], RankPublicationHook]
+_RANK_PUBLICATION_HOOK_PROVIDER: RankPublicationHookProvider | None = None
+
+
+def register_runtime_gpu_proof_provider(provider: GpuProofProvider) -> None:
+    """Install the one process-local bridge before ServerArgs validation."""
+
+    global _GPU_PROOF_PROVIDER
+    if not callable(provider):
+        raise TypeError("runtime GPU proof provider must be callable")
+    if _GPU_PROOF_PROVIDER is not None:
+        raise RuntimeError("runtime GPU proof provider is already registered")
+    _GPU_PROOF_PROVIDER = provider
+
+
+def resolve_runtime_authority(
+    *,
+    topology_mode: Literal["tp1_dp1", "tp2_dp1", "tp1_dp2"],
+    required_backend_capabilities: Sequence[str],
+    expected_gpu_uuid: str | None = None,
+    expected_distributed_capability_sha256: str | None = None,
+    expected_distributed_proof_sha256: str | None = None,
+) -> NativeRuntimeAuthority:
+    provider = _GPU_PROOF_PROVIDER
+    if provider is None:
+        raise RuntimeError(
+            "native adaptation requires the LightCone proof provider before worker "
+            "construction"
+        )
+    supplied = provider()
+    if supplied is None:
+        raise RuntimeError("native adaptation GPU qualification is unavailable")
+    if isinstance(supplied, Mapping):
+        if set(supplied) - {"distributed", "native"}:
+            raise ValueError("runtime proof provider returned unknown proof roles")
+        distributed_proof = supplied.get("distributed")
+        native_proof = supplied.get("native")
+    else:
+        distributed_proof = supplied if topology_mode != "tp1_dp1" else None
+        native_proof = supplied if required_backend_capabilities else None
+
+    authorities: list[NativeRuntimeAuthority] = []
+    if topology_mode != "tp1_dp1":
+        if expected_distributed_capability_sha256 is None:
+            raise RuntimeError("distributed runtime lacks its source capability pin")
+        distributed_authority = bind_verified_runtime_authority(
+            distributed_proof,
+            topology_mode=topology_mode,
+            topology_sha256=distributed_proof.topology_sha256,
+            source_capability_sha256=expected_distributed_capability_sha256,
+        )
+        if (
+            expected_distributed_proof_sha256 is not None
+            and distributed_authority.proof_sha256
+            != expected_distributed_proof_sha256
+        ):
+            raise ValueError("distributed proof differs from the launch receipt")
+        authorities.append(distributed_authority)
+    if required_backend_capabilities:
+        if native_proof is None:
+            raise RuntimeError("native backend lacks its qualification proof")
+        native_authority = bind_verified_runtime_authority(
+            native_proof,
+            topology_mode=topology_mode,
+            topology_sha256=native_proof.topology_sha256,
+            source_capability_sha256=native_proof.source_capability_sha256,
+            required_backend_capabilities=required_backend_capabilities,
+        )
+        authorities.append(native_authority)
+    if not authorities:
+        raise RuntimeError("single-rank non-native runtime does not require GPU proof")
+    reference = authorities[0]
+    for authority in authorities[1:]:
+        if (
+            authority.topology_sha256 != reference.topology_sha256
+            or authority.source_identity_sha256 != reference.source_identity_sha256
+            or authority.inventory_sha256 != reference.inventory_sha256
+            or authority.hardware_envelope_sha256
+            != reference.hardware_envelope_sha256
+            or authority.gpu_uuids != reference.gpu_uuids
+            or authority.qualification_suite_id
+            != reference.qualification_suite_id
+            or authority.qualification_assignment_sha256
+            != reference.qualification_assignment_sha256
+            or authority.qualification_dispatch_sha256
+            != reference.qualification_dispatch_sha256
+            or authority.eagle3_selector_status != reference.eagle3_selector_status
+            or authority.eagle3_compatibility_authority_sha256
+            != reference.eagle3_compatibility_authority_sha256
+            or authority.eagle3_model_selector_sha256
+            != reference.eagle3_model_selector_sha256
+        ):
+            raise ValueError("runtime proof roles do not bind one physical execution")
+    if len({authority.qualification_only for authority in authorities}) != 1:
+        raise ValueError("runtime proof roles mix qualification and formal authority")
+    if expected_gpu_uuid is not None and expected_gpu_uuid not in reference.gpu_uuids:
+        raise ValueError("runtime rank device is absent from the verified proof")
+    proof_sha256s = tuple(sorted(authority.proof_sha256 for authority in authorities))
+    capability_sha256s = tuple(
+        sorted(authority.source_capability_sha256 for authority in authorities)
+    )
+    capabilities = tuple(
+        sorted(
+            {
+                capability
+                for authority in authorities
+                for capability in authority.backend_capabilities
+            }
+        )
+    )
+    return NativeRuntimeAuthority(
+        proof_sha256=_sha256(proof_sha256s),
+        source_capability_sha256=_sha256(capability_sha256s),
+        source_identity_sha256=reference.source_identity_sha256,
+        inventory_sha256=reference.inventory_sha256,
+        hardware_envelope_sha256=reference.hardware_envelope_sha256,
+        topology_mode=topology_mode,
+        topology_sha256=reference.topology_sha256,
+        gpu_uuids=reference.gpu_uuids,
+        backend_capabilities=capabilities,
+        proof_sha256s=proof_sha256s,
+        source_capability_sha256s=capability_sha256s,
+        qualification_only=any(authority.qualification_only for authority in authorities),
+        qualification_suite_id=reference.qualification_suite_id,
+        qualification_assignment_sha256=reference.qualification_assignment_sha256,
+        qualification_dispatch_sha256=reference.qualification_dispatch_sha256,
+        eagle3_selector_status=reference.eagle3_selector_status,
+        eagle3_compatibility_authority_sha256=(
+            reference.eagle3_compatibility_authority_sha256
+        ),
+        eagle3_model_selector_sha256=reference.eagle3_model_selector_sha256,
+    )
+
+
+def register_rank_publication_hook_provider(
+    provider: RankPublicationHookProvider,
+) -> None:
+    """Install the NCCL-backed rank hook before a TP2 cohort is allocated."""
+
+    global _RANK_PUBLICATION_HOOK_PROVIDER
+    if not callable(provider):
+        raise TypeError("rank publication hook provider must be callable")
+    if _RANK_PUBLICATION_HOOK_PROVIDER is not None:
+        raise RuntimeError("rank publication hook provider is already registered")
+    _RANK_PUBLICATION_HOOK_PROVIDER = provider
