+from __future__ import annotations
+
+import importlib.util
+import sys
+import unittest
+from pathlib import Path
+from types import ModuleType
+
+import torch
+
+PYTHON_ROOT = Path(__file__).resolve().parents[4] / "python"
+SPECULATIVE_ROOT = PYTHON_ROOT / "sglang/srt/speculative"
+
+
+def _stub_package(name: str, path: Path) -> ModuleType:
+    package = ModuleType(name)
+    package.__package__ = name
+    package.__path__ = [str(path)]
+    sys.modules[name] = package
+    return package
+
+
+def _load_module(name: str, path: Path) -> ModuleType:
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+if "sglang" not in sys.modules:
+    sglang = _stub_package("sglang", PYTHON_ROOT / "sglang")
+    srt = _stub_package("sglang.srt", PYTHON_ROOT / "sglang/srt")
+    speculative = _stub_package("sglang.srt.speculative", SPECULATIVE_ROOT)
+    sglang.srt = srt
+    srt.speculative = speculative
+
+MODULE = _load_module(
+    "sglang.srt.speculative.native_runtime_release",
+    SPECULATIVE_ROOT / "native_runtime_release.py",
+)
+
+
+def _authority(mode: str) -> object:
+    return MODULE.NativeRuntimeAuthority(
+        proof_sha256="a" * 64,
+        source_capability_sha256="b" * 64,
+        source_identity_sha256="c" * 64,
+        inventory_sha256="d" * 64,
+        hardware_envelope_sha256="e" * 64,
+        topology_mode=mode,
+        topology_sha256="f" * 64,
+        gpu_uuids=("GPU-A",) if mode == "tp1_dp1" else ("GPU-A", "GPU-B"),
+        backend_capabilities=(),
+    )
+
+
+class _AtomicTransport:
+    def __init__(self, *, succeeds: bool = True) -> None:
+        self.succeeds = succeeds
+        self.commits = 0
+        self.discards = 0
+
+    def commit_all(self, prepares) -> bool:
+        self.commits += 1
+        return self.succeeds
+
+    def discard_all(self, prepares) -> None:
+        self.discards += 1
+
+
+class DistributedRuntimeTests(unittest.TestCase):
+    def test_tp2_two_phase_commits_only_complete_all_rank_prepare(self):
+        transport = _AtomicTransport()
+        runtime = MODULE.Tp2AllRankPublisher(_authority("tp2_dp1"), transport)
+        for rank in (0, 1):
+            runtime.prepare(
+                MODULE.RankPrepare(
+                    rank=rank,
+                    source_version=3,
+                    candidate_sha256="1" * 64,
+                    terminal_sha256=str(rank + 2) * 64,
+                    valid=True,
+                )
+            )
+        receipt = runtime.finalize()
+        self.assertEqual(receipt.decision, "COMMITTED")
+        self.assertEqual(receipt.published_ranks, (0, 1))
+        self.assertEqual((transport.commits, transport.discards), (1, 0))
+
+    def test_tp2_one_rank_abort_has_zero_partial_publication(self):
+        transport = _AtomicTransport()
+        runtime = MODULE.Tp2AllRankPublisher(_authority("tp2_dp1"), transport)
+        runtime.prepare(MODULE.RankPrepare(0, 4, "1" * 64, "2" * 64, True))
+        runtime.prepare(MODULE.RankPrepare(1, 4, "1" * 64, "3" * 64, False))
+        receipt = runtime.finalize()
+        self.assertEqual(receipt.decision, "ABORTED")
+        self.assertEqual(receipt.published_ranks, ())
+        self.assertEqual((transport.commits, transport.discards), (0, 1))
+
+    def test_dp2_sticky_cohort_has_isolated_optimizer_state(self):
+        runtime = MODULE.Dp2StickyReplicaRuntime(_authority("tp1_dp2"))
+        cohort_a = "0" * 63 + "2"
+        cohort_b = "0" * 63 + "3"
+        state_a = runtime.apply(cohort_sha256=cohort_a, candidate_sha256="4" * 64)
+        state_b = runtime.apply(cohort_sha256=cohort_b, candidate_sha256="5" * 64)
+        self.assertEqual((state_a.replica, state_b.replica), (0, 1))
+        self.assertIsNone(runtime.state(1, cohort_a))
+        self.assertIsNone(runtime.state(0, cohort_b))
+        runtime.apply(cohort_sha256=cohort_a, candidate_sha256="6" * 64)
+        self.assertEqual((state_a.version, state_b.version), (2, 1))
+
+
+class NativeBackendTests(unittest.TestCase):
+    def test_dspark_executes_real_predecessor_w1_w2_confidence_and_56_selector(self):
+        interface = "1" * 64
+        parameters = tuple(
+            sorted(
+                (
+                    *MODULE.DSPARK_NATIVE_HEAD_NAMES,
+                    "layers.0.mlp.weight",
+                    "lm_head.weight",
+                )
+            )
+        )
+        inventory = MODULE.dspark_parameter_inventory_sha256(
+            model_interface_sha256=interface,
+            parameter_names=parameters,
+        )
+        candidates = MODULE.dspark_selector_candidate_ids(
+            model_interface_sha256=interface,
+            parameter_inventory_sha256=inventory,
+        )
+        self.assertEqual(len(candidates), 56)
+        authority = MODULE.DSparkSelectorAuthority.derive(
+            model_interface_sha256=interface,
+            parameter_names=parameters,
+            supplied_candidate_ids=candidates,
+        )
+        candidate = candidates[0]
+        batch = MODULE.DSparkNativeBatch(
+            predecessor_token_ids=torch.tensor([[0, 1]]),
+            markov_w1=torch.tensor([[1.0, 0.0], [0.0, 1.0], [1.0, 1.0]]),
+            markov_w2=torch.tensor([[1.0, 0.0], [0.0, 1.0], [1.0, 1.0]]),
+            backbone_logits=torch.zeros(1, 2, 3, requires_grad=True),
+            draft_hidden=torch.zeros(1, 2, 2, requires_grad=True),
+            teacher_probabilities=torch.full((1, 2, 3), 1 / 3),
+            confidence_head_weight=torch.ones(1, 4),
+            confidence_head_bias=torch.zeros(1),
+            valid_mask=torch.ones(1, 2, dtype=torch.bool),
+            source_adapter_version=3,
+            selector_authority=authority,
+            selector_candidate_id=candidate,
+        )
+        logits, confidence = batch.reconstruct()
+        self.assertEqual(logits.shape, (1, 2, 3))
+        self.assertEqual(confidence.shape, (1, 2))
+        loss = batch.loss(confidence_weight=0.25)
+        self.assertTrue(bool(torch.isfinite(loss)))
+        loss.backward()
+        self.assertIsNotNone(batch.backbone_logits.grad)
+
+    def test_nextn_executes_teacher_mask_source_and_two_model_tp2_contract(self):
+        batch = MODULE.NextNNativeBatch(
+            mtp_hidden_states=torch.zeros(1, 2, 4),
+            teacher_probabilities=torch.full((1, 2, 3), 1 / 3),
+            valid_mask=torch.ones(1, 2, dtype=torch.bool),
+            source_adapter_version=7,
+            interface_sha256="1" * 64,
+            target_revision="2" * 40,
+            drafter_revision="3" * 40,
+            topology_mode="tp2_dp1",
+            target_shard_sha256s=("4" * 64, "5" * 64),
+            drafter_shard_sha256s=("6" * 64, "7" * 64),
+        )
+        logits = torch.zeros(1, 2, 3, requires_grad=True)
+        loss = batch.distillation_loss(logits)
+        loss.backward()
+        self.assertIsNotNone(logits.grad)
+
+    def test_native_result_pointer_rejects_host_sync_and_accepts_fixed_graph(self):
+        pointer = MODULE.NativeHotPathResultPointer(
+            run_sha256="1" * 64,
+            topology_sha256="2" * 64,
+            tensor_addresses=(("candidate", 4096), ("timestamps", 8192)),
+            operations=(
+                "cuda_event_record",
+                "cuda_stream_wait_event",
+                "device_to_device_copy",
+                "graph_replay",
+            ),
+            token_timestamp_buffer_pointer=8192,
+            rank_terminal_sha256s=("3" * 64, "4" * 64),
+        )
+        self.assertEqual(len(pointer.sha256), 64)
+        with self.assertRaisesRegex(ValueError, "blocking host"):
+            MODULE.NativeHotPathResultPointer(
+                **{**pointer.__dict__, "operations": (*pointer.operations, "blocking_d2h")}
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
