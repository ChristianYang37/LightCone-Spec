+"""Exact non-skippable live TP2/DP1 qualification."""
+
+import pytest
+from lightcone_live_qualification import LiveQualificationHarness, require_live_contract
+
+
+@pytest.fixture(scope="module", autouse=True)
+def live_suite():
+    harness = LiveQualificationHarness("tp2_dp1")
+    harness.start()
+    try:
+        yield harness
+    finally:
+        harness.finish()
+
+
+def _case(live_suite, name):
+    case = live_suite.run_case(name)
+    require_live_contract(case, algorithm="DFLASH")
+    authority = case.adaptation["runtime_authority"]
+    assert authority["topology_mode"] == "tp2_dp1"
+    assert authority["qualification_only"] is True
+    return case
+
+
+def _receipt(case):
+    receipt = case.adaptation["tp2_last_publication_receipt"]
+    assert receipt is not None
+    return receipt
+
+
+def test_tp2_nccl_rank_coverage(live_suite) -> None:
+    _case(live_suite, "tp2_nccl_rank_coverage")
+    rows = live_suite.compute_processes()
+    assert {row["gpu_uuid"] for row in rows} == set(live_suite.gpu_uuids)
+
+
+def test_tp2_sharded_candidate_parity(live_suite) -> None:
+    case = _case(live_suite, "tp2_sharded_candidate_parity")
+    receipt = _receipt(case)
+    assert receipt["decision"] == "COMMITTED"
+    assert receipt["published_ranks"] == [0, 1]
+
+
+def test_tp2_all_rank_prepare(live_suite) -> None:
+    case = _case(live_suite, "tp2_all_rank_prepare")
+    receipt = _receipt(case)
+    assert len(receipt["rank_terminal_sha256s"]) == 2
+    assert len(set(receipt["rank_terminal_sha256s"])) == 2
+
+
+def test_tp2_two_phase_commit(live_suite) -> None:
+    case = _case(live_suite, "tp2_two_phase_commit")
+    receipt = _receipt(case)
+    assert receipt["decision"] == "COMMITTED"
+    assert receipt["reason_code"] is None
+
+
+def test_tp2_one_rank_abort_zero_partial(live_suite) -> None:
+    previous = live_suite.cases[-1].adaptation["active_version"]
+    live_suite.arm_tp2_one_rank_abort()
+    case = _case(live_suite, "tp2_one_rank_abort_zero_partial")
+    receipt = _receipt(case)
+    assert receipt["decision"] == "ABORTED"
+    assert receipt["published_ranks"] == []
+    assert case.adaptation["active_version"] == previous
+
+
+def test_tp2_rank_terminal_evidence(live_suite) -> None:
+    case = _case(live_suite, "tp2_rank_terminal_evidence")
+    assert len(_receipt(case)["rank_terminal_sha256s"]) == 2
+
+
+def test_native_itl_pointer(live_suite) -> None:
+    case = _case(live_suite, "native_itl_pointer")
+    assert len(case.native_pointer["events"]) == 4
+
+
+def test_graph_fixed_address_no_host_sync(live_suite) -> None:
+    case = _case(live_suite, "graph_fixed_address_no_host_sync")
+    assert case.adaptation["counters"]["graph_replay_hits"] > 0
+    assert case.adaptation["fixed_inference_address_sha256"]
+    terminal = live_suite.formal_gang_terminal
+    assert terminal is not None
+    assert terminal["topology"] == "tp2_dp1"
+    assert terminal["decision"] == "COMMITTED"
+    assert terminal["published_ranks"] == [0, 1]
+    assert len(set(terminal["rank_terminal_sha256s"])) == 2
