+        first_bytes = _bytes(self.optimizer.first)
+        second_bytes = _bytes(self.optimizer.second)
+        metadata_bytes = _bytes(self.optimizer.metadata_tensors)
+        online_bytes = 0
+        if isinstance(self.optimizer, OnlineSpecOptimizer):
