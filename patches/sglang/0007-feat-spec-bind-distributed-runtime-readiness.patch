+                )
+            else:
+                claimed_gpu_proof = config.eagle3_native_gpu_proof_sha256
+                if (
+                    claimed_gpu_proof is None
+                    or claimed_gpu_proof not in authority.proof_sha256s
+                    or any(
+                        value is not None
+                        for value in (
+                            config.eagle3_qualification_compatibility_authority_sha256,
+                            config.eagle3_qualification_model_selector_sha256,
+                        )
+                    )
+                ):
+                    raise RuntimeError("EAGLE3 live adapter GPU proof differs from E0")
+                values = (
+                    config.eagle3_e0_execution_authority_sha256,
+                    config.eagle3_compatibility_authority_sha256,
+                    config.eagle3_model_selector_sha256,
+                )
+                if any(value is None for value in values):
+                    raise RuntimeError("EAGLE3 live adapter lacks atomic E0 authority")
+                self.eagle3_selector_binding = Eagle3OfficialSelectorBinding(
+                    execution_authority_sha256=values[0],
+                    compatibility_authority_sha256=values[1],
+                    model_selector_sha256=values[2],
+                    native_gpu_proof_sha256=claimed_gpu_proof,
+                    target_revision=config.target_revision,
+                    drafter_revision=config.drafter_revision,
+                    live_model_interface_sha256=self.model_interface_sha256,
+                    native_source_identity_sha256=authority.source_identity_sha256,
+                    native_proof_sha256s=authority.proof_sha256s,
+                )
+        server_args._speculative_adaptation_resident_bytes = self.runtime.resident_bytes
+
+    @property
+    def source_adapter_version(self) -> int:
+        return self.runtime.active_version
+
+    @property
+    def update_due(self) -> bool:
+        return self.runtime.update_due()
+
+    def begin_round(self, batch) -> int:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        return self.runtime.begin_round(request_ids, batch.seq_lens)
+
+    def launch(
+        self,
+        *,
+        loss: torch.Tensor,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+        source_tensors: Sequence[torch.Tensor],
+        feedback_source_version: int,
+    ) -> None:
+        if not self.runtime.update_due():
+            return
+        if loss.numel() != 1 or not loss.requires_grad:
+            self.runtime.disable(
+                "native_backend_loss_not_differentiable", exactness=True
+            )
+            return
+        self.live_launch_count += 1
+        self.last_source_tensor_shapes = tuple(
+            tuple(int(value) for value in tensor.shape) for tensor in source_tensors
+        )
+        self.last_feedback_source_version = feedback_source_version
+        source_round = self.runtime.round
+        source_version = self.runtime.active_version
+        try:
+            with self.runtime.side_update(tuple(source_tensors)):
+                with self.runtime.timing("training"):
+                    raw = torch.autograd.grad(
+                        loss,
+                        self.trainable,
+                        allow_unused=True,
+                    )
+                    gradients = tuple(
+                        torch.zeros_like(parameter) if gradient is None else gradient
+                        for parameter, gradient in zip(self.trainable, raw, strict=True)
+                    )
+                    finite = (
+                        torch.isfinite(loss.detach())
+                        & torch.stack(
+                            [torch.isfinite(gradient).all() for gradient in gradients]
+                        ).all()
+                    )
+                with self.runtime.timing("optimizer"):
+                    proposal = self.optimizer.propose(
+                        gradients,
+                        **(
+                            {
+                                "feedback_source_version": feedback_source_version,
+                                "safe_boundary_version": source_version,
+                            }
+                            if self.config.optimizer.name == "chronobelief"
+                            else {}
+                        ),
+                    )
+                with self.runtime.timing("merge"):
+                    self.inference.stage(proposal.parameters)
+                self.runtime.submit(
+                    source_round=source_round,
+                    source_version=source_version,
+                    optimizer=self.optimizer,
+                    proposal=proposal,
+                    inference_bank=self.inference,
+                    finite=finite,
+                    loss=loss.detach(),
+                    request_ids=request_ids,
+                    prefix_lens=prefix_lens.detach(),
+                    reconstruction_ok=torch.ones(
+                        (), device=self.device, dtype=torch.bool
+                    ),
+                    supervision_nonempty=torch.ones(
+                        (), device=self.device, dtype=torch.bool
+                    ),
+                )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("native_backend_cuda_oom")
+        except Exception as error:
+            logger.exception("Disabling native adaptation after live update failure")
+            self.runtime.counters["fallbacks"] += 1
+            self.runtime.disable(f"native_update_failed:{type(error).__name__}")
+
+    def after_commit(
+        self,
+        batch,
+        *,
+        new_seq_lens: torch.Tensor,
+        verified_drafts: torch.Tensor,
+        accepted_drafts: torch.Tensor,
+        committed_tokens: torch.Tensor,
+    ) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        self.runtime.record_round_outcome(
+            request_ids,
+            verified_drafts=verified_drafts,
+            accepted_drafts=accepted_drafts,
+            committed_tokens=committed_tokens,
+        )
+        self.runtime.record_device_commit(request_ids, new_seq_lens)
+
+    def finish_request(self, request_id: str) -> None:
+        self.runtime.finish_request(request_id)
+
+    def abort_request(self, request_id: str) -> None:
+        self.runtime.abort_request(request_id)
+
+    def reset(self) -> None:
+        self.runtime.reset()
+        self.optimizer.reset(self.initial)
+        self.inference.stage(self.initial)
+        self.inference.publish()
+
+    def diagnostics(self) -> dict[str, object]:
+        return self.runtime.diagnostics(
+            extra={
+                "fixed_inference_address_sha256": (
+                    self.inference.active_address_sha256
+                ),
+                "fixed_staging_address_sha256": (
+                    self.inference.staging_address_sha256
+                ),
+                "native_backend": self.config.algorithm,
+                "native_model_interface_sha256": self.model_interface_sha256,
+                "native_live_launch_count": self.live_launch_count,
+                "native_last_source_tensor_shapes": (
+                    self.last_source_tensor_shapes
+                ),
+                "native_last_feedback_source_version": (
+                    self.last_feedback_source_version
+                ),
+                "dspark_native_head_names": (
+                    DSPARK_NATIVE_HEAD_NAMES
+                    if self.config.algorithm == "DSPARK"
+                    else None
+                ),
+                "dspark_selector_authority_sha256": (
+                    None
+                    if self.dspark_selector_authority is None
+                    else self.dspark_selector_authority.sha256
+                ),
+                "dspark_selector_size": (
+                    None
+                    if self.dspark_selector_authority is None
+                    else len(self.dspark_selector_authority.candidate_ids)
+                ),
+                "dspark_selector_candidate_id": self.dspark_selector_candidate_id,
+                "nextn_mtp_interface_sha256": (
+                    NEXTN_MTP_INTERFACE_SHA256
+                    if self.config.algorithm == "NEXTN"
+                    else None
+                ),
+                "nextn_target_revision": (
+                    self.config.target_revision
+                    if self.config.algorithm == "NEXTN"
+                    else None
+                ),
+                "nextn_drafter_revision": (
+                    self.config.drafter_revision
+                    if self.config.algorithm == "NEXTN"
+                    else None
+                ),
+                "nextn_topology": (
+                    {
+                        "tensor_parallel_size": (
+                            self.config.topology.tensor_parallel_size
+                        ),
+                        "data_parallel_size": (
+                            self.config.topology.data_parallel_size
+                        ),
+                    }
+                    if self.config.algorithm == "NEXTN"
+                    else None
+                ),
+                "eagle3_official_selector_status": (
+                    "COMPATIBLE" if self.eagle3_selector_binding is not None else None
+                ),
+                "eagle3_selector_binding_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.sha256
+                ),
+                "eagle3_selector_authority_mode": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else (
+                        "qualification_eagle3_tp1"
+                        if isinstance(
+                            self.eagle3_selector_binding,
+                            Eagle3QualificationSelectorBinding,
+                        )
+                        else "formal_e0"
+                    )
+                ),
+                "eagle3_e0_execution_authority_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else getattr(
+                        self.eagle3_selector_binding,
+                        "execution_authority_sha256",
+                        None,
+                    )
+                ),
+                "eagle3_compatibility_authority_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.compatibility_authority_sha256
+                ),
+                "eagle3_model_selector_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.model_selector_sha256
+                ),
+                "eagle3_native_gpu_proof_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else getattr(
+                        self.eagle3_selector_binding,
+                        "native_gpu_proof_sha256",
+                        None,
+                    )
+                ),
+                "eagle3_qualification_assignment_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else getattr(
+                        self.eagle3_selector_binding,
+                        "qualification_assignment_sha256",
+                        None,
+                    )
+                ),
+                "eagle3_qualification_dispatch_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else getattr(
+                        self.eagle3_selector_binding,
+                        "qualification_dispatch_sha256",
+                        None,
+                    )
+                ),
+                "eagle3_target_revision": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.target_revision
+                ),
+                "eagle3_drafter_revision": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.drafter_revision
+                ),
+                "eagle3_live_model_interface_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.live_model_interface_sha256
+                ),
+                "eagle3_native_source_identity_sha256": (
+                    None
+                    if self.eagle3_selector_binding is None
+                    else self.eagle3_selector_binding.native_source_identity_sha256
+                ),
+                "native_selector_sha256": hashlib.sha256(
+                    json.dumps(
+                        {
+                            "mode": self.config.weight_update_mode,
+                            "scope": self.config.parameter_scope,
+                            "rank": self.config.rank,
+                        },
+                        sort_keys=True,
+                        separators=(",", ":"),
+                    ).encode()
+                ).hexdigest(),
+            }
+        )
+
+
+def maybe_build_native_backend_adapter(server_args, worker, *, algorithm: str, model):
+    config = load_online_adaptation(server_args)
+    if config is None:
+        return None
+    if config.algorithm != algorithm:
+        raise ValueError("native worker/adaptation algorithm mismatch")
+    return NativeBackendOnlineAdapter(
+        server_args,
+        worker,
+        algorithm=algorithm,
+        model=model,
+    )
+
+
+__all__ = ("NativeBackendOnlineAdapter", "maybe_build_native_backend_adapter")
