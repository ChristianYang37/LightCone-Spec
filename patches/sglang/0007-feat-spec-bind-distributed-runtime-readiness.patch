+
+def qualification_rank_publication_hook_provider(
+    authority: NativeRuntimeAuthority,
+) -> RankPublicationHook:
+    """Return the live-suite NCCL all-rank decision hook.
+
+    This provider accepts only a root-dispatched *qualification-only* bootstrap.
+    Its receipt remains unsigned raw evidence until the local verifier lifts the
+    completed suite.  Production launches cannot reuse the bootstrap.
+    """
+
+    if (
+        type(authority) is not NativeRuntimeAuthority
+        or authority.topology_mode != "tp2_dp1"
+        or not authority.qualification_only
+    ):
+        raise TypeError("qualification TP2 hook requires its exact bootstrap")
+
+    def publish(value: RankPrepare) -> AllRankPublicationReceipt:
+        import torch.distributed as dist
+
+        if (
+            not dist.is_available()
+            or not dist.is_initialized()
+            or dist.get_backend() != "nccl"
+            or dist.get_world_size() != 2
+            or dist.get_rank() != value.rank
+        ):
+            raise RuntimeError("qualification TP2 hook requires exact NCCL ranks")
+        abort_path_value = os.environ.get(
+            "LIGHTCONE_NATIVE_QUALIFICATION_TP2_ABORT_RANK_PATH"
+        )
+        abort_path = Path(abort_path_value) if abort_path_value else None
+        armed_rank: int | None = None
+        if abort_path is not None and abort_path.is_file() and not abort_path.is_symlink():
+            raw_rank = abort_path.read_text("ascii").strip()
+            if raw_rank not in {"0", "1"}:
+                raise RuntimeError("qualification TP2 abort rank is malformed")
+            armed_rank = int(raw_rank)
+        if value.rank == armed_rank:
+            value = RankPrepare(
+                rank=value.rank,
+                source_version=value.source_version,
+                candidate_sha256=value.candidate_sha256,
+                terminal_sha256=value.terminal_sha256,
+                valid=False,
+            )
+        gathered: list[RankPrepare | None] = [None, None]
+        dist.all_gather_object(gathered, value)
+        if any(type(row) is not RankPrepare for row in gathered):
+            raise RuntimeError("qualification TP2 prepare coverage differs")
+        prepares = tuple(gathered)
+        assert all(type(row) is RankPrepare for row in prepares)
+        first, second = prepares
+        same = (
+            first.rank == 0
+            and second.rank == 1
+            and first.source_version == second.source_version
+            and first.candidate_sha256 == second.candidate_sha256
+        )
+        committed = same and first.valid and second.valid
+        dist.barrier()
+        if abort_path is not None and armed_rank is not None and value.rank == 0:
+            abort_path.unlink(missing_ok=False)
+        return AllRankPublicationReceipt(
+            topology_sha256=authority.topology_sha256,
+            source_version=first.source_version,
+            candidate_sha256=first.candidate_sha256,
+            rank_terminal_sha256s=(
+                first.terminal_sha256,
+                second.terminal_sha256,
+            ),
+            decision="COMMITTED" if committed else "ABORTED",
+            published_ranks=(0, 1) if committed else (),
+            reason_code=None if committed else "one_or_more_rank_prepares_invalid",
+        )
+
+    return publish
+
+
+@dataclass(frozen=True)
+class RankPrepare:
+    rank: int
+    source_version: int
+    candidate_sha256: str
+    terminal_sha256: str
+    valid: bool
+
+    def __post_init__(self) -> None:
+        if self.rank not in {0, 1} or self.source_version < 0:
+            raise ValueError("TP2 prepare rank/version is invalid")
+        _require_sha256("TP2 candidate", self.candidate_sha256)
+        _require_sha256("TP2 terminal", self.terminal_sha256)
+
+
+@dataclass(frozen=True)
+class AllRankPublicationReceipt:
+    topology_sha256: str
+    source_version: int
+    candidate_sha256: str
+    rank_terminal_sha256s: tuple[str, str]
+    decision: Literal["COMMITTED", "ABORTED"]
+    published_ranks: tuple[int, ...]
+    reason_code: str | None
+
+    def __post_init__(self) -> None:
+        _require_sha256("publication topology", self.topology_sha256)
+        _require_sha256("publication candidate", self.candidate_sha256)
+        for value in self.rank_terminal_sha256s:
+            _require_sha256("publication rank terminal", value)
+        expected = (0, 1) if self.decision == "COMMITTED" else ()
+        if self.published_ranks != expected:
+            raise ValueError("TP2 publication receipt permits a partial rank set")
+        if (self.reason_code is None) != (self.decision == "COMMITTED"):
+            raise ValueError("TP2 publication decision/reason is inconsistent")
+
+    @property
+    def sha256(self) -> str:
+        return _sha256(self.__dict__)
+
+
+class AtomicAllRankTransport(Protocol):
+    """Native transport stages both ranks and exposes one commit decision."""
+
+    def commit_all(self, prepares: tuple[RankPrepare, RankPrepare]) -> bool: ...
+
+    def discard_all(self, prepares: tuple[RankPrepare, RankPrepare]) -> None: ...
+
+
+class Tp2AllRankPublisher:
+    """Two-phase TP2 publication; any rank abort leaves zero published ranks."""
+
+    def __init__(
+        self,
+        authority: NativeRuntimeAuthority,
+        transport: AtomicAllRankTransport,
+    ) -> None:
+        if type(authority) is not NativeRuntimeAuthority or authority.topology_mode != "tp2_dp1":
+            raise TypeError("TP2 publisher requires exact TP2 release authority")
+        if not callable(getattr(transport, "commit_all", None)) or not callable(
+            getattr(transport, "discard_all", None)
+        ):
+            raise TypeError("TP2 publisher requires an atomic all-rank transport")
+        self.authority = authority
+        self.transport = transport
+        self._prepares: dict[int, RankPrepare] = {}
+        self._receipt: AllRankPublicationReceipt | None = None
+
+    def prepare(self, value: RankPrepare) -> None:
+        if self._receipt is not None or value.rank in self._prepares:
+            raise RuntimeError("TP2 publication attempt is terminal or duplicated")
+        self._prepares[value.rank] = value
+
+    def finalize(self) -> AllRankPublicationReceipt:
+        if self._receipt is not None:
+            raise RuntimeError("TP2 publication attempt is already terminal")
+        if set(self._prepares) != {0, 1}:
+            raise RuntimeError("TP2 publication lacks all-rank prepare coverage")
+        prepares = (self._prepares[0], self._prepares[1])
+        same = (
+            prepares[0].source_version == prepares[1].source_version
+            and prepares[0].candidate_sha256 == prepares[1].candidate_sha256
+        )
+        committed = all(value.valid for value in prepares) and same
+        if committed:
+            committed = self.transport.commit_all(prepares) is True
+        if not committed:
+            self.transport.discard_all(prepares)
+        receipt = AllRankPublicationReceipt(
+            topology_sha256=self.authority.topology_sha256,
+            source_version=prepares[0].source_version,
+            candidate_sha256=prepares[0].candidate_sha256,
+            rank_terminal_sha256s=tuple(value.terminal_sha256 for value in prepares),
+            decision="COMMITTED" if committed else "ABORTED",
+            published_ranks=(0, 1) if committed else (),
+            reason_code=None if committed else "all_rank_prepare_or_atomic_commit_failed",
+        )
+        self._receipt = receipt
+        return receipt
+
+
+@dataclass
+class ReplicaLocalState:
+    replica: int
+    cohort_sha256: str
+    version: int = 0
+    optimizer_generation: int = 0
+    state_sha256: str = "0" * 64
+
+    def apply(self, *, cohort_sha256: str, candidate_sha256: str) -> None:
+        if cohort_sha256 != self.cohort_sha256:
+            raise ValueError("DP2 update crossed a sticky cohort boundary")
+        _require_sha256("DP2 candidate", candidate_sha256)
+        self.version += 1
+        self.optimizer_generation += 1
+        self.state_sha256 = _sha256(
+            (self.replica, self.cohort_sha256, self.version, candidate_sha256)
+        )
+
+
+class Dp2StickyReplicaRuntime:
+    """Two independent TP1 replicas; no cross-replica gradient API exists."""
+
+    def __init__(self, authority: NativeRuntimeAuthority) -> None:
+        if type(authority) is not NativeRuntimeAuthority or authority.topology_mode != "tp1_dp2":
+            raise TypeError("DP2 runtime requires exact replica-local authority")
+        self.authority = authority
+        self._cohort_to_replica: dict[str, int] = {}
+        self._states: dict[int, dict[str, ReplicaLocalState]] = {0: {}, 1: {}}
+
+    def route(self, cohort_sha256: str) -> int:
+        _require_sha256("DP2 cohort", cohort_sha256)
+        replica = self._cohort_to_replica.get(cohort_sha256)
+        if replica is None:
+            replica = int(cohort_sha256, 16) % 2
+            self._cohort_to_replica[cohort_sha256] = replica
+        return replica
+
+    def apply(self, *, cohort_sha256: str, candidate_sha256: str) -> ReplicaLocalState:
+        replica = self.route(cohort_sha256)
+        states = self._states[replica]
+        state = states.setdefault(
+            cohort_sha256,
+            ReplicaLocalState(replica=replica, cohort_sha256=cohort_sha256),
+        )
+        state.apply(cohort_sha256=cohort_sha256, candidate_sha256=candidate_sha256)
+        return state
+
+    def state(self, replica: int, cohort_sha256: str) -> ReplicaLocalState | None:
+        if replica not in {0, 1}:
+            raise ValueError("DP2 replica must be zero or one")
+        return self._states[replica].get(cohort_sha256)
+
+    def snapshot(self) -> dict[str, object]:
+        return {
+            "cohort_to_replica": dict(sorted(self._cohort_to_replica.items())),
+            "replica_states": {
+                str(replica): [
+                    {
+                        "cohort_sha256": cohort_sha256,
+                        "optimizer_generation": state.optimizer_generation,
+                        "candidate_sha256": state.candidate_sha256,
+                        "state_sha256": state.state_sha256,
+                    }
+                    for cohort_sha256, state in sorted(states.items())
+                ]
+                for replica, states in sorted(self._states.items())
+            },
+            "cross_replica_gradient_collective": False,
+            "cross_replica_optimizer_state": False,
+        }
+
+    def reset(self) -> None:
+        self._cohort_to_replica.clear()
+        for states in self._states.values():
+            states.clear()
+
