new file mode 100644
index 0000000..1153bb8
--- /dev/null
+++ b/python/sglang/srt/speculative/online_eagle_adaptation.py
@@ -0,0 +1,287 @@
+"""Version-safe tail adaptation for single-layer EAGLE/EAGLE3 chains."""
+
+from __future__ import annotations
+
+import torch
+from sglang.srt.speculative.online_adaptation_runtime import CandidateBinding
+from sglang.srt.speculative.online_adaptation_config import (
+    load_online_adaptation,
+)
+from sglang.srt.speculative.online_tail_adaptation import (
+    maybe_build_online_tail_adapter,
+)
+from sglang.srt.speculative.online_valid_mask import (
+    request_boundary_metadata,
+    semantic_proposal_semantics,
+)
+
+
+class OnlineEagleAdapter:
+    """Keep a proposal version pinned from draft-extend through verification."""
+
+    def __init__(self, server_args, worker) -> None:
+        algorithm = "EAGLE3" if worker.speculative_algorithm.is_eagle3() else "EAGLE"
+        tail = maybe_build_online_tail_adapter(
+            server_args,
+            worker,
+            algorithm=algorithm,
+            proposal_depth=worker.speculative_num_draft_tokens - 1,
+        )
+        if tail is None:
+            raise ValueError("EAGLE adapter requires tail-scope configuration")
+        if int(worker.topk) != 1:
+            raise ValueError("EAGLE online adaptation requires topk=1")
+        if int(worker.speculative_num_steps) < 1:
+            raise ValueError("EAGLE online adaptation requires at least one step")
+        self.tail = tail
+        self.worker = worker
+        self.algorithm = algorithm
+        self.outstanding: dict[str, int] = {}
+        self.capture: dict[
+            str,
+            dict[int, tuple[torch.Tensor, torch.Tensor, torch.Tensor]],
+        ] = {}
+        self.capture_binding: CandidateBinding | None = None
+        self.capture_owners: set[str] = set()
+        self.current_request_ids: tuple[str, ...] = ()
+
+    @property
+    def runtime(self):
+        return self.tail.runtime
+
+    def begin_next_round(self, batch) -> torch.Tensor:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        duplicate = set(request_ids) & self.outstanding.keys()
+        if duplicate:
+            raise RuntimeError(
+                "EAGLE attempted to replace unverified proposals for "
+                f"{sorted(duplicate)}"
+            )
+        versions = self.tail.begin_round(batch, allow_publish=not self.outstanding)
+        if len(set(versions)) != 1:
+            raise RuntimeError("cohort publication returned mixed versions")
+        version = versions[0]
+        self.outstanding.update((request_id, version) for request_id in request_ids)
+        self.current_request_ids = request_ids
+        if self.capture_binding is None:
+            self.capture_binding = self.runtime.reserve_update()
+        if self.capture_binding is not None and not self.capture_owners:
+            self.capture_owners.update(request_ids)
+            for request_id in request_ids:
+                self.capture[request_id] = {}
+        return torch.full_like(batch.seq_lens, version, dtype=torch.int64)
+
+    def assert_pinned(self, batch, source_adapter_version: torch.Tensor | None) -> None:
+        if source_adapter_version is None:
+            raise RuntimeError("adapted EAGLE proposal has no source version")
+        if (
+            source_adapter_version.dtype != torch.int64
+            or source_adapter_version.device != batch.seq_lens.device
+            or source_adapter_version.shape != batch.seq_lens.shape
+        ):
+            raise ValueError(
+                "EAGLE source versions must be same-device int64 per request"
+            )
+        request_ids = tuple(request.rid for request in batch.reqs)
+        for request_id in request_ids:
+            expected = self.outstanding.get(request_id)
+            if expected is None or expected != self.runtime.active_version:
+                self.runtime.counters["version_mismatches"] += 1
+                self.runtime.disable("eagle_source_version_conflict", exactness=True)
+                raise RuntimeError(
+                    f"EAGLE proposal version is no longer resident: {request_id}"
+                )
+        self.current_request_ids = request_ids
+
+    def requires_eager_capture(self) -> bool:
+        return (
+            self.capture_binding is not None
+            and bool(set(self.current_request_ids) & self.capture_owners)
+            and self.runtime.disabled_reason is None
+        )
+
+    def correct_logits(
+        self,
+        *,
+        logits: torch.Tensor,
+        hidden_states: torch.Tensor | None,
+        phase: str,
+        proposal_step: int,
+    ) -> torch.Tensor:
+        if hidden_states is None:
+            raise RuntimeError("adapted EAGLE proposal has no tail hidden state")
+        correction = self.tail.proposal_offset(
+            hidden_states, logits_width=logits.shape[-1]
+        ).to(logits.dtype)
+        corrected = logits + correction
+        if self.requires_eager_capture():
+            if logits.shape[0] != len(self.current_request_ids):
+                raise RuntimeError(
+                    "EAGLE eager supervision rows do not match the live batch"
+                )
+            for index, request_id in enumerate(self.current_request_ids):
+                if request_id not in self.capture_owners:
+                    continue
+                steps = self.capture.setdefault(request_id, {})
+                if proposal_step in steps:
+                    raise RuntimeError(f"duplicate EAGLE proposal step {proposal_step}")
+                steps[proposal_step] = (
+                    logits[index].detach().clone(),
+                    corrected[index].detach().clone(),
+                    hidden_states[index].detach().clone(),
+                )
+        return corrected
+
+    def after_verify(self, *, batch, batch_result) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        proposal_tokens = batch.spec_info.draft_token.view(len(request_ids), -1)[
+            :, 1 : self.tail.proposal_depth + 1
+        ]
+        correct_len = (batch_result.accept_lens - 1).clamp_min(0)
+        remaining, terminal_ids, ignore_eos = request_boundary_metadata(batch.reqs)
+        valid, accepted, committed = semantic_proposal_semantics(
+            proposal_tokens=proposal_tokens,
+            correct_len=correct_len,
+            remaining_output_tokens=remaining,
+            terminal_token_ids=terminal_ids,
+            ignore_eos=ignore_eos,
+        )
+        binding = self.capture_binding
+        owner_indices = [
+            index
+            for index, request_id in enumerate(request_ids)
+            if request_id in self.capture_owners
+        ]
+        attempted_capture = binding is not None and bool(owner_indices)
+        should_launch = attempted_capture
+        if should_launch:
+            depth = proposal_tokens.shape[1]
+            rows = []
+            owner_ids = tuple(request_ids[index] for index in owner_indices)
+            for request_id in owner_ids:
+                captured = self.capture.get(request_id, {})
+                if sorted(captured) != list(range(depth)):
+                    self.runtime.disable("eagle_supervision_incomplete")
+                    should_launch = False
+                    break
+                rows.append([captured[index] for index in range(depth)])
+            if should_launch:
+                raw = torch.stack(
+                    [
+                        torch.stack([item[0] for item in request_rows])
+                        for request_rows in rows
+                    ]
+                )
+                proposal = torch.stack(
+                    [
+                        torch.stack([item[1] for item in request_rows])
+                        for request_rows in rows
+                    ]
+                )
+                hidden = torch.stack(
+                    [
+                        torch.stack([item[2] for item in request_rows])
+                        for request_rows in rows
+                    ]
+                )
+                target_all = batch_result.logits_output.next_token_logits.view(
+                    len(request_ids), -1, raw.shape[-1]
+                )[:, :depth]
+                selected = torch.tensor(
+                    owner_indices,
+                    device=target_all.device,
+                    dtype=torch.long,
+                )
+                target = target_all.index_select(0, selected)
+                temperatures = batch.sampling_info.temperatures.view(-1).index_select(
+                    0, selected
+                )
+                self.tail.maybe_launch_aligned(
+                    hidden=hidden,
+                    raw_logits=raw,
+                    proposal_logits=proposal,
+                    target_logits=target,
+                    valid_mask=valid[:, :depth].index_select(0, selected),
+                    request_ids=owner_ids,
+                    prefix_lens=batch.seq_lens.index_select(0, selected),
+                    logit_scales=temperatures.to(torch.float32)
+                    .clamp_min(1e-5)
+                    .reciprocal(),
+                    reservation=binding,
+                )
+        self.tail.after_commit(
+            batch,
+            batch.seq_lens + committed.to(batch.seq_lens.dtype),
+            accepted_drafts=accepted,
+            verified_drafts=torch.full_like(correct_len, proposal_tokens.shape[1]),
+            committed_tokens=committed,
+        )
+        for request_id in request_ids:
+            self.outstanding.pop(request_id, None)
+            self.capture.pop(request_id, None)
+        if attempted_capture:
+            self._clear_capture()
+        self.current_request_ids = ()
+
+    def _clear_capture(self) -> None:
+        binding = self.capture_binding
+        if binding is not None:
+            self.runtime.release_reservation(binding)
+        self.capture_binding = None
+        self.capture_owners.clear()
+        self.capture.clear()
+
+    def finish_request(self, request_id: str) -> None:
+        self.outstanding.pop(request_id, None)
+        self.capture.pop(request_id, None)
+        if request_id in self.capture_owners:
+            self._clear_capture()
+        self.tail.finish_request(request_id)
+
+    def abort_request(self, request_id: str) -> None:
+        self.outstanding.pop(request_id, None)
+        self.capture.pop(request_id, None)
+        if request_id in self.capture_owners:
+            self._clear_capture()
+        self.tail.abort_request(request_id)
+
+    def reset(self) -> None:
+        self.outstanding.clear()
+        self._clear_capture()
+        self.current_request_ids = ()
+        self.tail.reset()
+
+    def note_load(
+        self,
+        *,
+        running_requests: int,
+        waiting_requests: int,
+        graph_replay: bool,
+    ) -> None:
+        self.tail.note_load(
+            running_requests=running_requests,
+            waiting_requests=waiting_requests,
+            graph_replay=graph_replay,
+        )
+
+    def diagnostics(self) -> dict:
+        value = self.tail.diagnostics()
+        value["outstanding_eagle_proposals"] = len(self.outstanding)
+        return value
+
+
+def maybe_build_online_eagle_adapter(server_args, worker):
+    config = load_online_adaptation(server_args)
+    if config is None:
+        return None
+    if config.algorithm not in {"EAGLE", "EAGLE3"}:
+        return None
+    if config.parameter_scope != "tail":
+        raise ValueError("EAGLE/EAGLE3 adaptation is tail-only")
+    return OnlineEagleAdapter(server_args, worker)
+
+
+__all__ = (
+    "OnlineEagleAdapter",
+    "maybe_build_online_eagle_adapter",
+)
diff --git a/python/sglang/srt/speculative/online_tail_adaptation.py b/python/sglang/srt/speculative/online_tail_adaptation.py
