index 0000000..75a4fe8
--- /dev/null
+++ b/python/sglang/srt/speculative/online_tail_adaptation.py
@@ -0,0 +1,526 @@
+"""Cache-safe output-tail ablations for speculative proposal heads."""
+
+from __future__ import annotations
+
+import logging
+import math
+from collections.abc import Sequence
+
+import torch
+from sglang.srt.speculative.online_adaptation_config import (
+    load_online_adaptation,
+)
+from sglang.srt.speculative.online_adaptation_runtime import (
+    CandidateBinding,
+    FixedInferenceBank,
+    OnlineCohortRuntime,
+    ResidentOptimizer,
+    estimate_functional_optimizer_scratch_bytes,
+    estimate_full_vocab_training_scratch_bytes,
+)
+
+logger = logging.getLogger(__name__)
+
+
+class OnlineTailAdapter:
+    def __init__(
+        self,
+        server_args,
+        worker,
+        *,
+        algorithm: str | None = None,
+        proposal_depth: int | None = None,
+    ) -> None:
+        config = load_online_adaptation(server_args)
+        if config is None or config.parameter_scope != "tail":
+            raise ValueError("tail adapter requires tail-scope configuration")
+        if int(worker.ps.tp_size) != 1:
+            raise ValueError("tail ablations currently require TP=1")
+        self.config = config
+        self.worker = worker
+        self.device = worker.device
+        self.algorithm = str(algorithm or config.algorithm).upper()
+        if self.algorithm != config.algorithm:
+            raise ValueError("tail adapter algorithm/config mismatch")
+        if proposal_depth is None:
+            if self.algorithm == "DFLASH":
+                proposal_depth = int(worker.block_size) - 1
+            elif self.algorithm == "DSPARK":
+                proposal_depth = int(worker.gamma)
+            else:
+                proposal_depth = int(worker.speculative_num_draft_tokens) - 1
+        self.proposal_depth = int(proposal_depth)
+        if self.proposal_depth < 1:
+            raise ValueError("tail adaptation proposal depth must be positive")
+        if self.algorithm == "EAGLE3":
+            proposal_model = worker.draft_worker.draft_runner.model
+        else:
+            proposal_model = worker.target_worker.model_runner.model
+        lm_head = getattr(proposal_model, "lm_head", None)
+        if lm_head is None or not hasattr(lm_head, "weight"):
+            raise RuntimeError("tail updates require the target LM head")
+        self.lm_head_weight = lm_head.weight.detach()
+        hidden = int(self.lm_head_weight.shape[1])
+        vocab = int(self.lm_head_weight.shape[0])
+        generator = torch.Generator(device=self.device)
+        generator.manual_seed(int(config.sampling_profile_sha256[:16], 16))
+        if config.weight_update_mode == "residual":
+            rank = int(config.rank)
+            first = torch.empty(
+                (hidden, rank), dtype=self.lm_head_weight.dtype, device=self.device
+            )
+            torch.nn.init.kaiming_uniform_(first, a=math.sqrt(5), generator=generator)
+            second = torch.zeros(
+                (rank, vocab), dtype=self.lm_head_weight.dtype, device=self.device
+            )
+            parameters = (first, second)
+        elif config.weight_update_mode == "lora":
+            rank = int(config.rank)
+            first = torch.empty(
+                (hidden, rank), dtype=self.lm_head_weight.dtype, device=self.device
+            )
+            torch.nn.init.kaiming_uniform_(first, a=math.sqrt(5), generator=generator)
+            second = torch.zeros(
+                (rank, hidden), dtype=self.lm_head_weight.dtype, device=self.device
+            )
+            parameters = (first, second)
+        else:
+            parameters = (
+                torch.zeros(
+                    (hidden, hidden),
+                    dtype=self.lm_head_weight.dtype,
+                    device=self.device,
+                ),
+            )
+        self.active = tuple(parameters)
+        self.initial_trainable = tuple(
+            parameter.detach().clone() for parameter in self.active
+        )
+        self.bank = FixedInferenceBank(self.active)
+        self.optimizer = ResidentOptimizer(self.active, config.optimizer)
+        context_capacity = int(server_args.context_length or 0)
+        if context_capacity <= 0:
+            context_capacity = int(
+                worker.target_worker.model_runner.model_config.context_len
+            )
+        max_batch = max(1, int(server_args.max_running_requests))
+        self.runtime = OnlineCohortRuntime(
+            config,
+            device=self.device,
+            reserve_bytes=int(server_args.speculative_adaptation_reserve_mb)
+            * 1024
+            * 1024,
+            telemetry_path=server_args.speculative_adaptation_telemetry_path,
+            max_trace_updates=context_capacity // config.stride + 2,
+            max_trace_batch=max_batch,
+        )
+        self.runtime.bind_parameter_layout(
+            tuple(
+                (f"tail.{index}", parameter)
+                for index, parameter in enumerate(self.optimizer.master)
+            ),
+            projection_identity=(
+                f"{self.algorithm.lower()}_proposal_lm_head:"
+                f"{config.target_revision}:{config.drafter_revision}:"
+                f"{tuple(self.lm_head_weight.shape)}:{self.lm_head_weight.dtype}"
+            ),
+        )
+        resident = (
+            self.active
+            + self.bank.staging
+            + self.optimizer.state_tensors
+            + self.runtime.telemetry_tensors
+        )
+        batch_tokens = max_batch * self.proposal_depth
+        logits_scratch = estimate_full_vocab_training_scratch_bytes(
+            batch_tokens=batch_tokens,
+            vocab_size=vocab,
+        )
+        trainable_bytes = sum(value.nbytes for value in self.optimizer.master)
+        candidate_scratch = estimate_functional_optimizer_scratch_bytes(
+            self.optimizer,
+            merge_bytes=trainable_bytes,
+        )
+        scratch = logits_scratch + trainable_bytes + candidate_scratch
+
+        def bytes_of(tensors) -> int:
+            return sum(value.nbytes for value in tensors)
+
+        self.runtime.bind_memory(
+            resident_tensors=resident,
+            peak_scratch_bytes=scratch,
+            optimizer_tensors=self.optimizer.state_tensors,
+            trainable_tensors=self.optimizer.master,
+            categories={
+                "active_or_base_bytes": bytes_of(self.active),
+                "master_fp32_bytes": bytes_of(self.optimizer.master),
+                "gradient_bytes": trainable_bytes,
+                "first_moment_bytes": bytes_of(self.optimizer.first),
+                "second_moment_bytes": bytes_of(self.optimizer.second),
+                "optimizer_metadata_bytes": bytes_of(self.optimizer.metadata_tensors),
+                "staging_bytes": bytes_of(self.bank.staging),
+                "training_activation_bytes": logits_scratch,
+                "kv_gather_scratch_bytes": 0,
+                "candidate_scratch_bytes": candidate_scratch,
+                "graph_buffer_bytes": 0,
+                "telemetry_bytes": bytes_of(self.runtime.telemetry_tensors),
+            },
+        )
+        server_args._speculative_adaptation_resident_bytes = self.runtime.resident_bytes
+
+    def begin_round(self, batch, *, allow_publish: bool = True) -> tuple[int, ...]:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        version = self.runtime.begin_round(
+            request_ids,
+            batch.seq_lens,
+            allow_publish=allow_publish,
+        )
+        return (version,) * len(request_ids)
+
+    def _correction(
+        self,
+        hidden: torch.Tensor,
+        parameters: tuple[torch.Tensor, ...],
+        head_weight: torch.Tensor,
+    ) -> torch.Tensor:
+        compute_dtype = parameters[0].dtype
+        hidden_work = hidden.to(compute_dtype)
+        if self.config.weight_update_mode == "residual":
+            return ((hidden_work @ parameters[0]) @ parameters[1]).to(head_weight.dtype)
+        if self.config.weight_update_mode == "lora":
+            delta_hidden = (hidden_work @ parameters[0]) @ parameters[1]
+        else:
+            delta_hidden = hidden_work @ parameters[0]
+        return delta_hidden.to(head_weight.dtype) @ head_weight.T
+
+    def proposal_offset(
+        self,
+        hidden: torch.Tensor,
+        head_weight: torch.Tensor | None = None,
+        logits_width: int | None = None,
+    ) -> torch.Tensor:
+        weight = self.lm_head_weight if head_weight is None else head_weight
+        correction = self._correction(hidden, self.active, weight)
+        if logits_width is not None:
+            if correction.shape[-1] < logits_width:
+                raise ValueError("proposal head is narrower than proposal logits")
+            correction = correction[..., :logits_width]
+        return correction
+
+    def proposal_logits(
+        self,
+        hidden: torch.Tensor,
+        head_weight: torch.Tensor,
+        raw_logits: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        return self._proposal_with_parameters(
+            hidden,
+            self.active,
+            head_weight,
+            raw_logits=raw_logits,
+        )
+
+    def _proposal_with_parameters(
+        self,
+        hidden: torch.Tensor,
+        parameters: tuple[torch.Tensor, ...],
+        head_weight: torch.Tensor,
+        *,
+        raw_logits: torch.Tensor | None,
+    ) -> torch.Tensor:
+        if self.algorithm == "DFLASH" and self.config.weight_update_mode != "residual":
+            hidden_work = hidden.to(parameters[0].dtype)
+            if self.config.weight_update_mode == "lora":
+                hidden_work = (
+                    hidden_work + (hidden_work @ parameters[0]) @ parameters[1]
+                )
+            else:
+                hidden_work = hidden_work + hidden_work @ parameters[0]
+            return hidden_work.to(head_weight.dtype) @ head_weight.T
+        if raw_logits is None:
+            raw_logits = hidden.to(head_weight.dtype) @ head_weight.T
+        correction = self._correction(hidden, parameters, head_weight)
+        if correction.shape[-1] < raw_logits.shape[-1]:
+            raise ValueError("proposal head is narrower than raw proposal logits")
+        return raw_logits + correction[..., : raw_logits.shape[-1]].to(raw_logits.dtype)
+
+    def maybe_launch(
+        self,
+        *,
+        hidden: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+    ) -> None:
+        try:
+            batch = int(valid_mask.shape[0])
+            if self.algorithm != "DFLASH":
+                raise ValueError("unaligned tail launch is DFlash-only")
+            block = self.proposal_depth + 1
+            owned_hidden = hidden.view(batch, block, -1)[:, 1:, :]
+            owned_target = target_logits.view(batch, block, -1)[
+                :, : self.proposal_depth
+            ]
+            raw = owned_hidden.to(self.lm_head_weight.dtype) @ (self.lm_head_weight.T)
+            proposal = self.proposal_logits(
+                owned_hidden,
+                self.lm_head_weight,
+                raw_logits=raw,
+            )
+            self._launch_aligned(
+                hidden=owned_hidden,
+                raw_logits=raw,
+                proposal_logits=proposal,
+                target_logits=owned_target,
+                valid_mask=valid_mask,
+                request_ids=request_ids,
+                prefix_lens=prefix_lens,
+            )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("adaptation_cuda_oom")
+        except Exception as error:
+            logger.exception("Disabling tail adaptation after update failure")
+            self.runtime.counters["fallbacks"] += 1
+            self.runtime.disable(f"adaptation_update_failed:{type(error).__name__}")
+
+    def maybe_launch_aligned(
+        self,
+        *,
+        hidden: torch.Tensor,
+        raw_logits: torch.Tensor,
+        proposal_logits: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+        logit_scales: torch.Tensor | None = None,
+        reservation: CandidateBinding | None = None,
+    ) -> None:
+        try:
+            self._launch_aligned(
+                hidden=hidden,
+                raw_logits=raw_logits,
+                proposal_logits=proposal_logits,
+                target_logits=target_logits,
+                valid_mask=valid_mask,
+                request_ids=request_ids,
+                prefix_lens=prefix_lens,
+                logit_scales=logit_scales,
+                reservation=reservation,
+            )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("adaptation_cuda_oom")
+        except Exception as error:
+            logger.exception("Disabling tail adaptation after update failure")
+            self.runtime.counters["fallbacks"] += 1
+            self.runtime.disable(f"adaptation_update_failed:{type(error).__name__}")
+
+    def _launch_aligned(
+        self,
+        *,
+        hidden: torch.Tensor,
+        raw_logits: torch.Tensor,
+        proposal_logits: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+        logit_scales: torch.Tensor | None = None,
+        reservation: CandidateBinding | None = None,
+    ) -> None:
+        if reservation is None:
+            if not self.runtime.update_due():
+                return
+            source_round = self.runtime.round
+            source_version = self.runtime.active_version
+        else:
+            if not self.runtime.reservation_ready(reservation):
+                raise RuntimeError("tail update reservation is no longer valid")
+            source_round = reservation.source_round
+            source_version = reservation.source_version
+        batch = int(valid_mask.shape[0])
+        depth = int(valid_mask.shape[1])
+        expected = (batch, depth)
+        if hidden.shape[:2] != expected:
+            raise ValueError("tail hidden rows do not match the semantic mask")
+        if (
+            raw_logits.shape[:2] != expected
+            or proposal_logits.shape != raw_logits.shape
+            or target_logits.shape[:2] != expected
+        ):
+            raise ValueError("tail proposal/target rows do not match the mask")
+        if depth > self.proposal_depth:
+            raise ValueError("tail signal exceeds the configured proposal depth")
+        owned_hidden = hidden.detach().clone()
+        owned_raw = raw_logits.detach().clone()
+        owned_proposal = proposal_logits.detach().clone()
+        owned_target = target_logits.detach().clone()
+        owned_mask = valid_mask.detach().clone()
+        owned_scales = None if logit_scales is None else logit_scales.detach().clone()
+        if owned_scales is not None:
+            if owned_scales.shape == (batch,):
+                owned_scales = owned_scales[:, None]
+            if owned_scales.shape not in {(batch, 1), (batch, depth)}:
+                raise ValueError("logit scales must have one value per request/step")
+        with self.runtime.side_update(
+            tuple(
+                value
+                for value in (
+                    owned_hidden,
+                    owned_raw,
+                    owned_proposal,
+                    owned_target,
+                    owned_mask,
+                    prefix_lens,
+                    owned_scales,
+                )
+                if value is not None
+            )
+        ):
+            leaves = tuple(
+                parameter.detach().clone().requires_grad_(True)
+                for parameter in self.active
+            )
+            with self.runtime.timing("training"):
+                reconstructed = self._proposal_with_parameters(
+                    owned_hidden.reshape(-1, owned_hidden.shape[-1]),
+                    self.active,
+                    self.lm_head_weight,
+                    raw_logits=owned_raw.reshape(-1, owned_raw.shape[-1]),
+                ).view(batch, depth, -1)[..., : owned_raw.shape[-1]]
+                reconstruction_error = (
+                    (reconstructed.to(torch.float32) - owned_proposal.to(torch.float32))
+                    .abs()
+                    .max()
+                )
+                reconstruction_limit = 2e-3 + 2e-3 * owned_proposal.abs().max()
+                reconstruction_ok = (
+                    torch.isfinite(reconstruction_error)
+                    & torch.isfinite(reconstruction_limit)
+                    & (reconstruction_error <= reconstruction_limit)
+                )
+                draft = self._proposal_with_parameters(
+                    owned_hidden.reshape(-1, owned_hidden.shape[-1]),
+                    leaves,
+                    self.lm_head_weight,
+                    raw_logits=owned_raw.reshape(-1, owned_raw.shape[-1]),
+                ).view(batch, depth, -1)[..., : owned_raw.shape[-1]]
+                draft = draft.to(torch.float32)
+                target = owned_target.to(torch.float32)
+                if owned_scales is not None:
+                    scale = owned_scales.to(torch.float32)[..., None]
+                    draft = draft * scale
+                    target = target * scale
+                probability = torch.softmax(target, dim=-1)
+                weights = self.config.loss_position_decay ** torch.arange(
+                    depth, device=self.device, dtype=torch.float32
+                )
+                weights = weights[None, :] * owned_mask.to(torch.float32)
+                loss = (
+                    (
+                        probability
+                        * (
+                            torch.log_softmax(target, dim=-1)
+                            - torch.log_softmax(draft, dim=-1)
+                        )
+                    ).sum(-1)
+                    * weights
+                ).sum() / weights.sum().clamp_min(1.0)
+                gradients = torch.autograd.grad(loss, leaves)
+            finite = (
+                torch.isfinite(loss)
+                & torch.stack(
+                    [torch.isfinite(gradient).all() for gradient in gradients]
+                ).all()
+            )
+            with self.runtime.timing("optimizer"):
+                proposal = self.optimizer.propose(gradients)
+            with self.runtime.timing("merge"):
+                staged = tuple(
+                    torch.where(finite, candidate, active)
+                    for candidate, active in zip(
+                        proposal.parameters, self.active, strict=True
+                    )
+                )
+                self.bank.stage(staged)
+            self.runtime.submit(
+                source_round=source_round,
+                source_version=source_version,
+                optimizer=self.optimizer,
+                proposal=proposal,
+                inference_bank=self.bank,
+                finite=finite,
+                loss=loss,
+                request_ids=request_ids,
+                prefix_lens=prefix_lens,
+                reconstruction_ok=reconstruction_ok,
+                reconstruction_max_abs=reconstruction_error,
+                reservation=reservation,
+            )
+
+    def after_commit(
+        self,
+        batch,
+        new_seq_lens: torch.Tensor,
+        *,
+        accepted_drafts: torch.Tensor,
+        verified_drafts: torch.Tensor,
+        committed_tokens: torch.Tensor,
+    ) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        self.runtime.record_round_outcome(
+            request_ids,
+            verified_drafts=verified_drafts,
+            accepted_drafts=accepted_drafts,
+            committed_tokens=committed_tokens,
+        )
+        self.runtime.record_device_commit(request_ids, new_seq_lens)
+
+    def finish_request(self, request_id: str) -> None:
+        self.runtime.finish_request(request_id)
+
+    def abort_request(self, request_id: str) -> None:
+        self.runtime.abort_request(request_id)
+
+    def reset(self) -> None:
+        self.runtime.reset()
+        self.optimizer.reset(self.initial_trainable)
+        self.bank.stage(self.initial_trainable)
+        self.bank.publish()
+
+    def note_load(
+        self,
+        *,
+        running_requests: int,
+        waiting_requests: int,
+        graph_replay: bool,
+    ) -> None:
+        self.runtime.note_load(
+            running_requests=running_requests,
+            waiting_requests=waiting_requests,
+            graph_replay=graph_replay,
+        )
+
+    def diagnostics(self) -> dict:
+        return self.runtime.diagnostics()
+
+
+def maybe_build_online_tail_adapter(
+    server_args,
+    worker,
+    *,
+    algorithm: str | None = None,
+    proposal_depth: int | None = None,
+):
+    config = load_online_adaptation(server_args)
+    if config is None or config.parameter_scope != "tail":
+        return None
+    return OnlineTailAdapter(
+        server_args,
+        worker,
+        algorithm=algorithm,
+        proposal_depth=proposal_depth,
+    )
