+                            ),
+                        )
+                with self.runtime.timing("merge"):
+                    effective = self._effective_parameters(proposal.parameters)
+                    # Staging is branch-free. Device-resident validity selects
+                    # the staged or active values at the legal boundary.
+                    self.inference.stage(tuple(effective[name] for name in self.names))
+                self.runtime.submit(
+                    source_round=source_round,
+                    source_version=source_version,
+                    optimizer=self.optimizer,
+                    proposal=proposal,
+                    inference_bank=self.inference,
+                    finite=finite,
+                    loss=loss,
+                    request_ids=self._captured_request_ids,
+                    prefix_lens=self._captured_prefix_lens,
+                    reconstruction_ok=reconstruction_ok,
