+"""DFlash backend-native Full/LoRA updates on a bounded current canvas."""
+
+from __future__ import annotations
+
+import logging
+import math
+from collections.abc import Sequence
+from dataclasses import dataclass
+
+import torch
+import torch.distributed as dist
+import torch.nn.functional as F
+
+from sglang.srt.distributed.parallel_state import get_tp_group
+from sglang.srt.speculative.online_adaptation_config import (
+    load_online_adaptation,
+)
+from sglang.srt.speculative.online_adaptation_runtime import (
+    FixedInferenceBank,
+    OnlineCohortRuntime,
+    OnlineSpecOptimizer,
+    adaptation_layout,
+    anchor_forward_value,
+    build_parameter_optimizer,
+    estimate_full_vocab_training_scratch_bytes,
+    estimate_functional_optimizer_scratch_bytes,
+    loss_and_grad,
+    reconfigure_parameter_optimizer,
+)
+from sglang.srt.speculative.online_parameter_plan import (
+    build_native_parameter_plan,
+)
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class _CapturedHistory:
+    locations: torch.Tensor
+    valid_mask: torch.Tensor
+
+
+@dataclass(frozen=True)
+class RequestLoRASlot:
+    index: int
+    generation: int
+    request_id: str
+
+
+class RequestLoRASlotBank:
+    """Fixed request slots with generation-safe reuse."""
+
+    def __init__(self, capacity: int) -> None:
+        self.free = list(reversed(range(capacity)))
+        self.generations = [0] * capacity
+        self.by_request: dict[str, RequestLoRASlot] = {}
+
+    def acquire(self, request_id: str) -> RequestLoRASlot:
+        current = self.by_request.get(request_id)
+        if current is not None:
+            return current
+        if not self.free:
+            raise RuntimeError("per-request LoRA slot capacity is exhausted")
+        index = self.free.pop()
+        slot = RequestLoRASlot(index, self.generations[index], request_id)
+        self.by_request[request_id] = slot
+        return slot
+
+    def get(self, request_id: str) -> RequestLoRASlot:
+        return self.by_request[request_id]
+
+    def release(self, request_id: str) -> RequestLoRASlot | None:
+        slot = self.by_request.pop(request_id, None)
+        if slot is None:
+            return None
+        self.generations[slot.index] += 1
+        self.free.append(slot.index)
+        return slot
+
+
+class _TensorParallelAllGather(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, local: torch.Tensor, group) -> torch.Tensor:
+        ctx.rank = dist.get_rank(group)
+        ctx.world_size = dist.get_world_size(group)
+        shards = [torch.empty_like(local) for _ in range(ctx.world_size)]
+        dist.all_gather(shards, local.contiguous(), group=group)
+        return torch.cat(shards, dim=-1)
+
+    @staticmethod
+    def backward(ctx, gradient: torch.Tensor):
+        return gradient.chunk(ctx.world_size, dim=-1)[ctx.rank].contiguous(), None
+
+
+class _TensorParallelSum(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, local: torch.Tensor, group) -> torch.Tensor:
+        output = local.contiguous().clone()
+        dist.all_reduce(output, group=group)
+        return output
+
+    @staticmethod
+    def backward(ctx, gradient: torch.Tensor):
+        return gradient, None
+
+
+def _rms(hidden: torch.Tensor, weight: torch.Tensor, epsilon: float) -> torch.Tensor:
+    """Match SGLang RMSNorm's fp32 reduction and affine arithmetic.
+
+    Casting the reciprocal RMS to bf16 before the affine multiply introduces
+    a systematic error that is amplified by the frozen LM head.  Keep the
+    entire normalization in fp32 and cast only the final activation, matching
+    ``RMSNorm.forward_native`` and the non-residual CUDA kernel behavior.
+    """
+    variance = hidden.to(torch.float32).square().mean(-1, keepdim=True)
+    normalized = (
+        hidden.to(torch.float32)
+        * torch.rsqrt(variance + epsilon)
+        * weight.to(torch.float32)
+    )
+    return normalized.to(hidden.dtype)
+
+
+def _linear(
+    hidden: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor:
+    return F.linear(
+        hidden,
+        weight.to(hidden.dtype),
+        None if bias is None else bias.to(hidden.dtype),
+    )
+
+
+def _silu_and_mul(gate: torch.Tensor, up: torch.Tensor) -> torch.Tensor:
+    """Match the fused CUDA activation's single bf16 rounding boundary."""
+    if gate.shape != up.shape or gate.dtype != up.dtype:
+        raise ValueError("DFlash gated-MLP activation inputs do not match")
+    return (F.silu(gate.to(torch.float32)) * up.to(torch.float32)).to(gate.dtype)
+
+
+def _logit_reconstruction_gate(
+    inference_logits: torch.Tensor,
+    differentiable_logits: torch.Tensor,
+    *,
+    relative_units: float = 2.5,
+    kl_units: float = 32.0,
+    numerical_unit: float | None = None,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    if inference_logits.shape != differentiable_logits.shape:
+        raise ValueError("DFlash reconstruction logit shapes differ")
+    inference = inference_logits.detach().to(torch.float32)
+    reconstructed = differentiable_logits.detach().to(torch.float32)
+    error = (reconstructed - inference).abs()
+    maximum = error.max()
+    # FlashInfer and differentiable SDPA evaluate the same attention equation
+    # with different reduction orders.  Bound normalized logit error and
+    # proposal-distribution KL; max error and top-1 agreement remain audit
+    # signals because isolated low-probability outliers and near-ties are not
+    # stable semantic gates over a full vocabulary.
+    if numerical_unit is None:
+        numerical_unit = max(float(torch.finfo(inference_logits.dtype).eps), 1e-3)
+    denominator = inference.square().mean().sqrt().clamp_min(1e-12)
+    relative_rms = error.square().mean().sqrt() / denominator
+    top1_match = (
+        (inference.argmax(dim=-1) == reconstructed.argmax(dim=-1))
+        .to(torch.float32)
+        .mean()
+    )
+    # Top-1 agreement remains diagnostic rather than a hard gate: near-tied
+    # logits may exchange order under bf16 reduction drift even when their KL
+    # is tiny.  Exact decoding continues to use the retained inference q, not
+    # this differentiable surrogate.
+    probability = torch.softmax(inference, dim=-1)
+    mean_kl = (
+        (
+            probability
+            * (
+                torch.log_softmax(inference, dim=-1)
+                - torch.log_softmax(reconstructed, dim=-1)
+            )
+        )
+        .sum(-1)
+        .mean()
+    )
+    # The actual sampled q comes from inference logits; the differentiable
+    # reconstruction is used only for its Jacobian. Callers choose the numeric
+    # envelope for their fused inference path while these DFlash defaults stay
+    # unchanged.
+    valid = (
+        torch.isfinite(error).all()
+        & torch.isfinite(relative_rms)
+        & torch.isfinite(mean_kl)
+        & (relative_rms <= relative_units * numerical_unit)
+        & (mean_kl <= kl_units * numerical_unit**2)
+    )
+    return valid, maximum, relative_rms, top1_match, mean_kl
+
+
+def _is_default_rope_metadata(value: object) -> bool:
+    """Accept Transformers' normalized representation of unscaled RoPE."""
+    if value in (None, {}):
+        return True
+    if not isinstance(value, dict):
+        return False
+    return (
+        set(value) <= {"rope_type", "type", "rope_theta"}
+        and value.get("rope_type", "default") == "default"
+        and value.get("type", "default") == "default"
+    )
+
+
+def _is_disabled_sliding_window(value: object) -> bool:
+    """Recognize SGLang's only two no-window representations."""
+    return value is None or (type(value) is int and value == -1)
+
+
+def _rope(
+    value: torch.Tensor,
+    positions: torch.Tensor,
+    *,
+    cos_sin_cache: torch.Tensor,
+) -> torch.Tensor:
+    """Apply NeoX RoPE from the exact cache used by the inference kernel.
+
+    Recomputing trigonometric values on GPU does not reproduce SGLang's
+    initialization-time cache at long positions.  The discrepancy is small
+    per element but becomes visible after five draft layers and the frozen LM
+    head.  Reusing the immutable fp32 cache is both cheaper and bit-identical
+    to the JIT RoPE kernel after the final activation cast.
+    """
+    head_dimension, rotary_dimension = value.shape[-1], cos_sin_cache.shape[-1]
+    if rotary_dimension % 2 or rotary_dimension > head_dimension: raise ValueError("RoPE head dimension must be even")
+    if value.ndim != positions.ndim + 2 or value.shape[:-2] != positions.shape:
+        raise ValueError("RoPE positions do not match the token dimensions")
+    if not rotary_dimension:
+        raise ValueError("RoPE cache does not cover the requested head dimension")
+    cached = cos_sin_cache.index_select(0, positions.reshape(-1))
+    cached = cached.reshape(*positions.shape, rotary_dimension)
+    cosine, sine = cached.to(torch.float32).chunk(2, dim=-1)
+    cosine = cosine.unsqueeze(-2)
+    sine = sine.unsqueeze(-2)
+    left, right = value[..., :rotary_dimension].to(torch.float32).chunk(2, dim=-1)
+    rotated = torch.cat(
+        (
+            left * cosine - right * sine,
+            right * cosine + left * sine,
+        ),
+        dim=-1,
+    ).to(value.dtype)
+    return torch.cat((rotated, value[..., rotary_dimension:]), dim=-1)
+
+
+class DFlashDrafterAdapter:
+    """Update DFlash-owned parameters while target embeddings/head stay frozen."""
+
+    def __init__(self, server_args, worker) -> None:
+        config = load_online_adaptation(server_args)
+        if config is None or config.algorithm != "DFLASH":
+            raise ValueError("DFlash adapter requires a DFlash configuration")
+        if config.weight_update_mode not in {"lora", "full"}:
+            raise ValueError("DFlash supports Full or LoRA")
+        if int(worker.ps.tp_size) != config.topology.tensor_parallel_size:
+            raise ValueError(
+                "DFlash worker TP does not match the bound topology identity"
+            )
+        self.config = config
+        self.worker = worker
+        self.tp_group = get_tp_group()
+        if worker.draft_window_size is None:
+            raise ValueError(
+                "DFlash adaptation requires a bounded --speculative-draft-window-size"
+            )
+        if int(worker.draft_window_size) != int(config.canvas_tokens):
+            raise ValueError(
+                "canvas_tokens must equal speculative_draft_window_size so "
+                "the differentiable path sees the exact inference history"
+            )
+        self.model = worker.draft_model
+        self.device = worker.device
+        if self.model.__class__.__name__ != "DFlashDraftModel":
+            raise ValueError(
+                "DFlash updates currently require the base "
+                "DFlashDraftModel; specialized variants fail closed"
+            )
+        rope_scaling = getattr(self.model.config, "rope_scaling", None)
+        if not _is_default_rope_metadata(rope_scaling):
+            raise ValueError(
+                "differentiable DFlash adaptation does not yet reconstruct "
+                "non-default RoPE scaling; start-up fails before allocation"
+            )
+        if not bool(
+            getattr(
+                self.model.config,
+                "rope_is_neox_style",
+                getattr(self.model.config, "is_neox_style", True),
+            )
+        ):
+            raise ValueError(
+                "differentiable DFlash adaptation requires NeoX-style RoPE"
+            )
+        if any(
+            not _is_disabled_sliding_window(layer.self_attn.sliding_window_size)
+            for layer in self.model.layers
+        ):
+            raise ValueError(
+                "differentiable DFlash adaptation does not yet reconstruct "
+                "sliding-window attention"
+            )
+        if any(
+            getattr(layer.self_attn.attn.attn_type, "name", None) != "ENCODER_ONLY"
+            for layer in self.model.layers
+        ):
+            raise ValueError(
+                "differentiable DFlash adaptation currently requires "
+                "encoder-only canvas attention"
+            )
+        raw_parameters = tuple(self.model.named_parameters())
+        self.plan = build_native_parameter_plan(raw_parameters, config)
+        self.named = {}
+        for raw_name, parameter in raw_parameters:
+            name = raw_name.removeprefix("model.")
+            if name in self.named:
+                raise RuntimeError(f"duplicate canonical DFlash parameter: {name}")
+            self.named[name] = parameter
+        if any(name not in self.named for name in self.plan.selected_names):
+            raise AssertionError("DFlash parameter plan cannot resolve its selection")
+        context_capacity = int(
+            server_args.context_length or self.model.config.max_position_embeddings
+        )
+        max_batch = max(1, int(server_args.max_running_requests))
+        training_batch = min(max_batch, config.adaptation_microbatch_size)
+        trace_rounds = math.ceil(config.telemetry_round_items / max_batch)
+        self.runtime = OnlineCohortRuntime(
+            config,
+            device=self.device,
+            reserve_bytes=int(server_args.speculative_adaptation_reserve_mb)
+            * 1024
+            * 1024,
+            telemetry_path=server_args.speculative_adaptation_telemetry_path,
+            max_trace_updates=math.ceil(trace_rounds / config.stride) + 2,
+            max_trace_batch=max_batch,
+        )
+        self.factor_names: tuple[str, ...] = ()
+        self.factor_shapes: dict[str, tuple[int, int]] = {}
+        if config.weight_update_mode == "full":
+            self.names = self.plan.full_names
+            self.base: dict[str, torch.Tensor] = {}
+            trainable = tuple(self.named[name] for name in self.names)
+            self.initial_trainable = tuple(
+                value.detach().clone() for value in trainable
+            )
+            self.inference = FixedInferenceBank(trainable)
+            self.optimizer = build_parameter_optimizer(
+                trainable,
+                config,
+                projection_origin=self.initial_trainable,
+            )
+        else:
+            factor_names = self.plan.lora_names
+            if not factor_names:
+                raise RuntimeError("DFlash LoRA parameter selection is empty")
+            self.factor_names = tuple(factor_names)
+            self.names = self.factor_names
+            self.base = {
+                name: self.named[name].detach().to(torch.float32).clone()
+                for name in self.names
+            }
+            self.inference = FixedInferenceBank(
+                tuple(self.named[name] for name in self.names)
+            )
+            factors = []
+            generator = torch.Generator(device=self.device)
+            seed = config.seed
+            generator.manual_seed(seed)
+            for name in self.factor_names:
+                weight = self.named[name]
+                rank = int(config.rank)
+                if rank > min(weight.shape):
+                    raise ValueError(
+                        f"LoRA rank {rank} exceeds {name} shape {tuple(weight.shape)}"
+                    )
+                a = torch.empty(
+                    (rank, weight.shape[1]),
+                    dtype=torch.float32,
+                    device=self.device,
+                )
+                torch.nn.init.kaiming_uniform_(a, a=math.sqrt(5), generator=generator)
+                b = torch.zeros(
+                    (weight.shape[0], rank),
+                    dtype=torch.float32,
+                    device=self.device,
+                )
+                factors.extend((a, b))
+                self.factor_shapes[name] = (len(factors) - 2, len(factors) - 1)
+            trainable = tuple(factors)
+            self.initial_trainable = tuple(
+                value.detach().clone() for value in trainable
+            )
+            self.optimizer = build_parameter_optimizer(
+                trainable,
+                config,
+                projection_origin=self.initial_trainable,
+            )
+        if config.weight_update_mode == "full":
+            layout = tuple(zip(self.names, self.optimizer.master, strict=True))
+        else:
+            layout_rows = []
+            for name in self.factor_names:
+                a_index, b_index = self.factor_shapes[name]
+                layout_rows.extend(
+                    (
+                        (f"{name}.lora_a", self.optimizer.master[a_index]),
+                        (f"{name}.lora_b", self.optimizer.master[b_index]),
+                    )
+                )
+            layout = tuple(layout_rows)
+        self.runtime.bind_parameter_layout(
+            layout,
+            projection_identity=f"dflash:{config.parameter_scope}:{config.weight_update_mode}",
+        )
+        self._captured_input: torch.Tensor | None = None
+        self._captured_positions: torch.Tensor | None = None
+        self._captured_prefix_lens: torch.Tensor | None = None
+        self._captured_request_ids: tuple[str, ...] = ()
+        self.request_slots = (
+            RequestLoRASlotBank(max_batch)
+            if config.reset_scope == "request_batched"
+            else None
+        )
+        self.slot_optimizers = (
+            tuple(
+                build_parameter_optimizer(
+                    tuple(value.detach().clone() for value in self.initial_trainable),
+                    config,
+                    projection_origin=self.initial_trainable,
+                )
+                for _ in range(max_batch)
+            )
+            if self.request_slots is not None
+            else ()
+        )
+        self.slot_rounds = [0] * max_batch
+        self.slot_ready: list[torch.cuda.Event | None] = [None] * max_batch
+        self._captured_history: _CapturedHistory | None = None
+        resident = (
+            tuple(self.base.values())
+            + self.initial_trainable
+            + self.optimizer.state_tensors
+            + tuple(
+                tensor
+                for optimizer in self.slot_optimizers
+                for tensor in optimizer.state_tensors
+            )
+            + self.inference.staging
+            + self.runtime.telemetry_tensors
+        )
+        hidden = int(self.model.config.hidden_size)
+        layers = int(self.model.config.num_hidden_layers)
+        intermediate = int(self.model.config.intermediate_size)
+        target_model = worker.target_worker.model_runner.model
+        lm_head = getattr(target_model, "lm_head", None)
+        if lm_head is None or not hasattr(lm_head, "weight"):
+            raise RuntimeError("drafter updates require the target LM head")
+        vocab = int(lm_head.weight.shape[0])
+        logit_scratch = estimate_full_vocab_training_scratch_bytes(
+            batch_tokens=training_batch * (config.canvas_tokens - 1),
+            vocab_size=vocab,
+        )
+        history_capacity = config.canvas_tokens + max(int(worker.page_size) - 1, 0)
+        attention_workspace = (
+            training_batch
+            * layers
+            * int(self.model.config.num_attention_heads)
+            * config.canvas_tokens
+            * (history_capacity + config.canvas_tokens)
+            * 4
+        )
+        activation_scratch = (
+            (
+                training_batch
+                * config.canvas_tokens
+                * (layers * (8 * hidden + 3 * intermediate) + 4 * hidden)
+                * 4
+            )
+            + logit_scratch
+            + attention_workspace
+        )
+        kv_gather_scratch = (
+            training_batch * history_capacity * layers * hidden * 2 * 4
+        )
+        trainable_bytes = sum(value.nbytes for value in self.optimizer.master)
+        base_bytes = sum(value.nbytes for value in self.base.values())
+        merge_bytes = 0 if config.weight_update_mode == "full" else 2 * base_bytes
+        candidate_scratch = estimate_functional_optimizer_scratch_bytes(
+            self.optimizer,
+            merge_bytes=merge_bytes,
+        )
+        scratch = (
+            activation_scratch + kv_gather_scratch + trainable_bytes + candidate_scratch
+        )
+
+        def bytes_of(tensors) -> int:
+            return sum(value.nbytes for value in tensors)
+
+        self.runtime.bind_memory(
+            resident_tensors=resident,
+            peak_scratch_bytes=scratch,
+            trainable_tensors=(
+                self.optimizer.first
+                if isinstance(self.optimizer, OnlineSpecOptimizer)
+                and self.optimizer.is_ensemble
+                else self.optimizer.master
+            ),
+            categories={
+                "active_or_base_bytes": bytes_of(
+                    tuple(self.base.values()) + self.initial_trainable
+                ),
+                "master_fp32_bytes": bytes_of(self.optimizer.master),
+                # Hedge experts are differentiated sequentially. Only one
+                # expert-gradient layout is live at the scratch peak.
+                "gradient_bytes": trainable_bytes,
+                "first_moment_bytes": (
+                    0
+                    if isinstance(self.optimizer, OnlineSpecOptimizer)
+                    else bytes_of(self.optimizer.first)
+                ),
+                "second_moment_bytes": (
+                    0
+                    if isinstance(self.optimizer, OnlineSpecOptimizer)
+                    else bytes_of(self.optimizer.second)
+                ),
+                "online_state_bytes": (
+                    bytes_of(self.optimizer.first + self.optimizer.second)
+                    if isinstance(self.optimizer, OnlineSpecOptimizer)
+                    else 0
+                ),
+                "optimizer_metadata_bytes": bytes_of(self.optimizer.metadata_tensors),
+                "staging_bytes": bytes_of(self.inference.staging),
+                "training_activation_bytes": activation_scratch,
+                "kv_gather_scratch_bytes": kv_gather_scratch,
+                "candidate_scratch_bytes": candidate_scratch,
+                "graph_buffer_bytes": 0,
+                "telemetry_bytes": bytes_of(self.runtime.telemetry_tensors),
+            },
+        )
+        server_args._speculative_adaptation_resident_bytes = self.runtime.resident_bytes
+
+    def begin_round(self, batch) -> tuple[int, ...]:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        if self.request_slots is not None:
+            for request_id in request_ids:
+                slot = self.request_slots.acquire(request_id)
+                self.slot_rounds[slot.index] += 1
+        version = self.runtime.begin_round(request_ids, batch.seq_lens)
+        return (version,) * len(request_ids)
+
+    def capture_canvas(
+        self,
+        batch,
+        *,
+        input_embeds: torch.Tensor,
+        positions: torch.Tensor,
+    ) -> None:
+        if self.request_slots is None and not self.runtime.update_due():
+            self._captured_input = None
+            self._captured_positions = None
+            self._captured_prefix_lens = None
+            self._captured_history = None
+            return
+        self._captured_request_ids = tuple(request.rid for request in batch.reqs)
+        self._captured_input = input_embeds.detach().clone()
+        self._captured_positions = positions.detach().clone()
+        prefix_lens = batch.seq_lens.to(torch.int64)
+        self._captured_prefix_lens = prefix_lens.detach().clone()
+        visible_lens = self.worker._compute_compact_draft_seq_lens(prefix_lens).to(
+            torch.int64
+        )
+        capacity = int(self.config.canvas_tokens) + max(
+            int(self.worker.page_size) - 1, 0
+        )
+        offsets = torch.arange(capacity, device=self.device, dtype=torch.int64)[None, :]
+        history_positions = (prefix_lens - visible_lens)[:, None] + offsets
+        valid = offsets < visible_lens[:, None]
+        table = self.worker.model_runner.req_to_token_pool.req_to_token
+        safe_positions = history_positions.clamp(min=0, max=int(table.shape[1]) - 1)
+        locations = table[
+            batch.req_pool_indices.to(torch.int64)[:, None], safe_positions
+        ]
+        self._captured_history = _CapturedHistory(
+            locations=locations.detach().clone(),
+            valid_mask=valid.detach().clone(),
+        )
+
+    def _effective_parameters(
+        self, trainable: Sequence[torch.Tensor]
+    ) -> dict[str, torch.Tensor]:
+        if self.config.weight_update_mode == "full":
+            return dict(zip(self.names, trainable, strict=True))
+        values = dict(self.base)
+        scale = float(self.config.lora_alpha) / float(self.config.rank)
+        for name in self.factor_names:
+            a_index, b_index = self.factor_shapes[name]
+            values[name] = self.base[name] + scale * (
+                trainable[b_index] @ trainable[a_index]
+            )
+        return values
+
+    def inference_hidden(self, fused_hidden: torch.Tensor) -> torch.Tensor:
+        if self.request_slots is None:
+            return fused_hidden
+        if (
+            self._captured_input is None
+            or self._captured_positions is None
+            or self._captured_history is None
+        ):
+            return fused_hidden
+        block = int(self.worker.block_size)
+        rows = []
+        for index, request_id in enumerate(self._captured_request_ids):
+            slot = self.request_slots.get(request_id)
+            ready = self.slot_ready[slot.index]
+            if ready is not None:
+                torch.cuda.current_stream(self.device).wait_event(ready)
+            start, end = index * block, (index + 1) * block
+            values = self._effective_parameters(
+                self.slot_optimizers[slot.index].master
+            )
+            rows.append(
+                self._surrogate_hidden(
+                    values,
+                    self._captured_input[start:end],
+                    self._captured_positions[start:end],
+                    (request_id,),
+                    _CapturedHistory(
+                        self._captured_history.locations[index : index + 1],
+                        self._captured_history.valid_mask[index : index + 1],
+                    ),
+                )
+            )
+        return torch.cat(rows, dim=0).reshape_as(fused_hidden)
+
+    def _parameter(
+        self,
+        values: dict[str, torch.Tensor],
+        name: str,
+        fallback: torch.Tensor,
+    ) -> torch.Tensor:
+        return values.get(name, fallback.detach())
+
+    def _bias(
+        self,
+        values: dict[str, torch.Tensor],
+        name: str,
+        fallback: torch.Tensor | None,
+    ) -> torch.Tensor | None:
+        if fallback is None:
+            return None
+        return self._parameter(values, name, fallback)
+
+    def _gather_history(
+        self,
+        *,
+        layer_id: int,
+        locations: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        pool = self.worker.draft_model_runner.token_to_kv_pool
+        key_buffer, value_buffer = pool.get_kv_buffer(layer_id)
+
+        def gather(buffer: torch.Tensor) -> torch.Tensor:
+            if buffer.ndim == 3:
+                return buffer[locations]
+            if buffer.ndim == 4:
+                pages = torch.div(
+                    locations, int(self.worker.page_size), rounding_mode="floor"
+                )
+                offsets = torch.remainder(locations, int(self.worker.page_size))
+                return buffer[pages, :, offsets, :]
+            raise RuntimeError(
+                "differentiable DFlash adaptation requires NHD or HND KV "
+                f"layout, got rank {buffer.ndim}"
+            )
+
+        return gather(key_buffer).detach(), gather(value_buffer).detach()
+
+    def _layer_forward(
+        self,
+        values: dict[str, torch.Tensor],
+        *,
+        layer_index: int,
+        hidden: torch.Tensor,
+        residual: torch.Tensor | None,
+        positions: torch.Tensor,
+        history_locations: torch.Tensor,
+        history_valid: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if hidden.ndim != 3 or positions.shape != hidden.shape[:2]:
+            raise ValueError("batched DFlash canvas shapes are inconsistent")
+        if (
+            history_locations.ndim != 2
+            or history_valid.shape != history_locations.shape
+            or history_locations.shape[0] != hidden.shape[0]
+        ):
+            raise ValueError("batched DFlash history shapes are inconsistent")
+        layer = self.model.layers[layer_index]
+        prefix = f"layers.{layer_index}"
+        if residual is None:
+            residual = hidden
+            norm_weight = self._parameter(
+                values,
+                f"{prefix}.input_layernorm.weight",
+                layer.input_layernorm.weight,
+            )
+            hidden = _rms(
+                hidden,
+                norm_weight.to(hidden.dtype),
+                float(layer.input_layernorm.variance_epsilon),
+            )
+        else:
+            residual = residual + hidden
+            norm_weight = self._parameter(
+                values,
+                f"{prefix}.input_layernorm.weight",
+                layer.input_layernorm.weight,
+            )
+            hidden = _rms(
+                residual,
+                norm_weight.to(residual.dtype),
+                float(layer.input_layernorm.variance_epsilon),
+            )
+        attention = layer.self_attn
+        qkv_weight = self._parameter(
+            values,
+            f"{prefix}.self_attn.qkv_proj.weight",
+            attention.qkv_proj.weight,
+        )
+        qkv = _linear(
+            hidden,
+            qkv_weight,
+            self._bias(
+                values,
+                f"{prefix}.self_attn.qkv_proj.bias",
+                attention.qkv_proj.bias,
+            ),
+        )
+        query, current_key, current_value = qkv.split(
+            [attention.q_size, attention.kv_size, attention.kv_size],
+            dim=-1,
+        )
+        query = query.view(*hidden.shape[:2], attention.num_heads, attention.head_dim)
+        current_key = current_key.view(
+            *hidden.shape[:2], attention.num_kv_heads, attention.head_dim
+        )
+        current_value = current_value.view(
+            *hidden.shape[:2], attention.num_kv_heads, attention.head_dim
+        )
+        q_norm = self._parameter(
+            values,
+            f"{prefix}.self_attn.q_norm.weight",
+            attention.q_norm.weight,
+        )
+        k_norm = self._parameter(
+            values,
+            f"{prefix}.self_attn.k_norm.weight",
+            attention.k_norm.weight,
+        )
+        query = _rms(
+            query,
+            q_norm.to(query.dtype),
+            float(attention.q_norm.variance_epsilon),
+        )
+        current_key = _rms(
+            current_key,
+            k_norm.to(current_key.dtype),
+            float(attention.k_norm.variance_epsilon),
+        )
+        rope_cache = attention.rotary_emb.cos_sin_cache
+        query = _rope(query, positions, cos_sin_cache=rope_cache)
+        current_key = _rope(
+            current_key,
+            positions,
+            cos_sin_cache=rope_cache,
+        )
+        history_key, history_value = self._gather_history(
+            layer_id=int(attention.attn.layer_id),
+            locations=history_locations,
+        )
+        key = torch.cat((history_key, current_key), dim=1)
+        value = torch.cat((history_value, current_value), dim=1)
+        repeat = attention.num_heads // attention.num_kv_heads
+        key = key.repeat_interleave(repeat, dim=2)
+        value = value.repeat_interleave(repeat, dim=2)
+        query = query.transpose(1, 2)
+        key = key.transpose(1, 2)
+        value = value.transpose(1, 2)
+        visible = torch.cat(
+            (
+                history_valid,
+                torch.ones(
+                    hidden.shape[:2],
+                    device=self.device,
+                    dtype=torch.bool,
+                ),
+            ),
+            dim=1,
+        )
+        attention_mask = visible[:, None, None, :]
+        attended = F.scaled_dot_product_attention(
+            query,
+            key,
+            value,
+            attn_mask=attention_mask,
+            dropout_p=0.0,
+            is_causal=False,
+            scale=attention.scaling,
+        )
+        attended = attended.transpose(1, 2).reshape(*hidden.shape[:2], -1)
+        o_weight = self._parameter(
+            values,
+            f"{prefix}.self_attn.o_proj.weight",
+            attention.o_proj.weight,
+        )
+        attention_output = _linear(
+            attended,
+            o_weight,
+            self._bias(
+                values,
+                f"{prefix}.self_attn.o_proj.bias",
+                attention.o_proj.bias,
+            ),
+        )
+        if self.tp_group.world_size > 1:
+            attention_output = _TensorParallelSum.apply(
+                attention_output, self.tp_group.device_group
+            )
+        residual = residual + attention_output
+        post_weight = self._parameter(
+            values,
+            f"{prefix}.post_attention_layernorm.weight",
+            layer.post_attention_layernorm.weight,
+        )
+        mlp_input = _rms(
+            residual,
+            post_weight.to(residual.dtype),
+            float(layer.post_attention_layernorm.variance_epsilon),
+        )
+        gate_weight = self._parameter(
+            values,
+            f"{prefix}.mlp.gate_up_proj.weight",
+            layer.mlp.gate_up_proj.weight,
+        )
+        gate_up = _linear(
+            mlp_input,
+            gate_weight,
+            self._bias(
+                values,
+                f"{prefix}.mlp.gate_up_proj.bias",
+                layer.mlp.gate_up_proj.bias,
+            ),
+        )
+        gate, up = gate_up.chunk(2, dim=-1)
+        # SGLang's fused SiluAndMul evaluates both operations in fp32 and casts
+        # once. Two eager bf16 operations introduce an extra rounding boundary
+        # whose error compounds across the five DFlash layers.
+        activated = _silu_and_mul(gate, up)
+        down_weight = self._parameter(
+            values,
+            f"{prefix}.mlp.down_proj.weight",
+            layer.mlp.down_proj.weight,
+        )
+        output = _linear(
+            activated,
+            down_weight,
+            self._bias(
+                values,
+                f"{prefix}.mlp.down_proj.bias",
+                layer.mlp.down_proj.bias,
+            ),
+        )
+        if self.tp_group.world_size > 1:
+            output = _TensorParallelSum.apply(output, self.tp_group.device_group)
+        return output, residual
+
+    def _surrogate_hidden(
+        self,
+        values: dict[str, torch.Tensor],
+        input_embeds: torch.Tensor,
+        positions: torch.Tensor,
+        request_ids: tuple[str, ...],
+        history: _CapturedHistory,
+    ) -> torch.Tensor:
+        block = int(self.worker.block_size)
+        batch_size = len(request_ids)
+        hidden = input_embeds.view(batch_size, block, -1)
+        positions = positions.view(batch_size, block)
+        residual = None
+        for layer_index in range(len(self.model.layers)):
+            hidden, residual = self._layer_forward(
+                values,
+                layer_index=layer_index,
+                hidden=hidden,
+                residual=residual,
+                positions=positions,
+                history_locations=history.locations,
+                history_valid=history.valid_mask,
+            )
+        if residual is not None:
+            hidden = hidden + residual
+        norm = self._parameter(values, "norm.weight", self.model.norm.weight)
+        return _rms(
+            hidden,
+            norm.to(hidden.dtype),
+            float(self.model.norm.variance_epsilon),
+        )
+
+    def _distillation_loss(
+        self,
+        draft_logits: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+    ) -> torch.Tensor:
+        target = target_logits.to(torch.float32)
+        draft = draft_logits.to(torch.float32)
+        weights = self.config.loss_position_decay ** torch.arange(
+            draft.shape[1],
+            device=self.device,
+            dtype=torch.float32,
+        )
+        weights = weights[None, :] * valid_mask.to(torch.float32)
+        probability = torch.softmax(target, dim=-1)
+        return (
+            (
+                probability
+                * (torch.log_softmax(target, dim=-1) - torch.log_softmax(draft, dim=-1))
+            ).sum(-1)
+            * weights
+        ).sum() / weights.sum().clamp_min(1.0)
+
+    def _full_vocab_logits(
+        self, local_logits: torch.Tensor, vocab_size: int
+    ) -> torch.Tensor:
+        if self.tp_group.world_size == 1:
+            return local_logits[..., :vocab_size]
+        return _TensorParallelAllGather.apply(
+            local_logits, self.tp_group.device_group
+        )[..., :vocab_size]
+
+    def _launch_request_batched(
+        self,
+        *,
+        draft_hidden: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+        lm_head_weight: torch.Tensor,
+    ) -> None:
+        if (
+            self.request_slots is None
+            or self._captured_input is None
+            or self._captured_positions is None
+            or self._captured_history is None
+        ):
+            return
+        block = int(self.worker.block_size)
+        batch = len(self._captured_request_ids)
+        target = target_logits.view(batch, block, -1)
+        hidden = draft_hidden.view(batch, block, -1)
+        for index, request_id in enumerate(self._captured_request_ids):
+            slot = self.request_slots.get(request_id)
+            if self.slot_rounds[slot.index] % self.config.stride:
+                continue
+            optimizer = self.slot_optimizers[slot.index]
+            start, end = index * block, (index + 1) * block
+            history = _CapturedHistory(
+                self._captured_history.locations[index : index + 1],
+                self._captured_history.valid_mask[index : index + 1],
+            )
+            teacher = target[index : index + 1, : block - 1].detach()
+            mask = valid_mask[index : index + 1].detach()
+            inference_logits = self._full_vocab_logits(
+                hidden[index : index + 1, 1:, :].to(lm_head_weight.dtype)
+                @ lm_head_weight.T,
+                teacher.shape[-1],
+            ).detach()
+
+            def objective(leaves):
+                values = self._effective_parameters(leaves)
+                surrogate = self._surrogate_hidden(
+                    values,
+                    self._captured_input[start:end],
+                    self._captured_positions[start:end],
+                    (request_id,),
+                    history,
+                )
+                logits = self._full_vocab_logits(
+                    surrogate[:, 1:, :].to(lm_head_weight.dtype)
+                    @ lm_head_weight.T,
+                    teacher.shape[-1],
+                )
+                return self._distillation_loss(
+                    anchor_forward_value(logits, inference_logits), teacher, mask
+                )
+
+            with torch.cuda.stream(self.runtime.side_stream):
+                loss, gradients = loss_and_grad(optimizer.master, objective)
+                finite = torch.isfinite(loss) & torch.stack(
+                    [torch.isfinite(gradient).all() for gradient in gradients]
+                ).all()
+                optimizer.commit(optimizer.propose(gradients), valid=finite)
+                ready = torch.cuda.Event(blocking=False)
+                ready.record(self.runtime.side_stream)
+                self.slot_ready[slot.index] = ready
+            self.runtime.counters["updates_launched"] += 1
+            self.runtime.counters["updates_published"] += 1
+
+    def maybe_launch(
+        self,
+        *,
+        draft_hidden: torch.Tensor,
+        target_logits: torch.Tensor,
+        valid_mask: torch.Tensor,
+        lm_head_weight: torch.Tensor,
+        has_supervision: bool = True,
+    ) -> None:
+        if self.request_slots is not None:
+            self._launch_request_batched(
+                draft_hidden=draft_hidden,
+                target_logits=target_logits,
+                valid_mask=valid_mask,
+                lm_head_weight=lm_head_weight,
+            )
+            return
+        if not self.runtime.update_due():
+            return
+        if not has_supervision:
+            if self.config.teacher_row_policy == "quota_shadow":
+                # Runtime state records the request/source pair before
+                # consulting the backend capability. DFlash currently exposes
+                # update-round target rows only, so a real shadow need blocks
+                # rather than fabricating or reusing a teacher row.
+                self.runtime.request_quota_shadow(
+                    request_ids=self._captured_request_ids,
+                )
+                return
+            self.runtime.skip_update_no_supervision()
+            return
+        if (
+            self._captured_input is None
+            or self._captured_positions is None
+            or self._captured_prefix_lens is None
+            or self._captured_history is None
+        ):
+            self.runtime.disable("missing_current_canvas", exactness=True)
+            return
+        source_round = self.runtime.round
+        source_version = self.runtime.active_version
+        owned_draft = draft_hidden.detach().clone()
+        owned_target = target_logits.detach().clone()
+        owned_mask = valid_mask.detach().clone()
+        supervision_nonempty = owned_mask.any()
+        source_tensors = (
+            self._captured_input,
+            self._captured_positions,
+            owned_draft,
+            owned_target,
+            owned_mask,
+            self._captured_history.locations,
+            self._captured_history.valid_mask,
+            self._captured_prefix_lens,
+        )
+        try:
+            with self.runtime.side_update(source_tensors):
+                with self.runtime.timing("training"):
+                    block = int(self.worker.block_size)
+                    batch_size = len(self._captured_request_ids)
+                    microbatch = min(
+                        batch_size, self.config.adaptation_microbatch_size
+                    )
+                    target = owned_target.view(batch_size, block, -1)[
+                        :microbatch, : block - 1
+                    ]
+                    local_inference_logits = (
+                        owned_draft.view(batch_size, block, -1)[
+                            :microbatch, 1:, :
+                        ].to(
+                            lm_head_weight.dtype
+                        )
+                        @ lm_head_weight.T
+                    )
+                    inference_logits = self._full_vocab_logits(
+                        local_inference_logits, target.shape[-1]
+                    )
+                    active_values = self._effective_parameters(self.optimizer.master)
+                    active_surrogate = self._surrogate_hidden(
+                        active_values,
+                        self._captured_input,
+                        self._captured_positions,
+                        self._captured_request_ids,
+                        self._captured_history,
+                    )
+                    local_active_logits = (
+                        active_surrogate[:, 1:, :].to(lm_head_weight.dtype)
+                        @ lm_head_weight.T
+                    )[:microbatch]
+                    active_logits = self._full_vocab_logits(
+                        local_active_logits, target.shape[-1]
+                    )
+                    (
+                        reconstruction_ok,
+                        reconstruction_max_abs,
+                        reconstruction_relative_rms,
+                        reconstruction_top1_match,
+                        reconstruction_mean_kl,
+                    ) = _logit_reconstruction_gate(inference_logits, active_logits)
+                    loss = self._distillation_loss(
+                        inference_logits,
+                        target,
+                        owned_mask[:microbatch],
+                    )
+
+                    def member_feedback(parameters):
+                        align_to_inference = parameters is self.optimizer.master
+
+                        def objective(leaves):
+                            values = self._effective_parameters(leaves)
+                            surrogate = self._surrogate_hidden(
+                                values,
+                                self._captured_input,
+                                self._captured_positions,
+                                self._captured_request_ids,
+                                self._captured_history,
+                            )
+                            local_draft_logits = (
+                                surrogate[:, 1:, :].to(lm_head_weight.dtype)
+                                @ lm_head_weight.T
+                            )[:microbatch]
+                            draft_logits = self._full_vocab_logits(
+                                local_draft_logits, target.shape[-1]
+                            )
+                            if align_to_inference:
+                                # The inference and differentiable kernels use
+                                # different reduction orders.  Anchor the
+                                # source-point value to the logits that
+                                # actually generated q while retaining the
+                                # differentiable surrogate's local Jacobian.
+                                draft_logits = anchor_forward_value(
+                                    draft_logits,
+                                    inference_logits,
+                                )
