+                    reconstruction_relative_rms=reconstruction_relative_rms,
+                    reconstruction_top1_match=reconstruction_top1_match,
+                    reconstruction_mean_kl=reconstruction_mean_kl,
+                    supervision_nonempty=supervision_nonempty,
+                )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("adaptation_cuda_oom")
+        except Exception as error:
+            logger.exception("Disabling DFlash adaptation after update failure")
+            self.runtime.counters["fallbacks"] += 1
+            self.runtime.disable(f"adaptation_update_failed:{type(error).__name__}")
+
+    def after_commit(
+        self,
+        batch,
+        *,
+        accepted_drafts: torch.Tensor,
+        verified_drafts: torch.Tensor,
+        committed_tokens: torch.Tensor,
+    ) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        self.runtime.record_device_commit(request_ids, committed_tokens)
+        self.runtime.record_round_outcome(
+            request_ids,
+            verified_drafts=verified_drafts,
+            accepted_drafts=accepted_drafts,
+            committed_tokens=committed_tokens,
+        )
+
+    def finish_request(self, request_id: str) -> bool:
+        if self.request_slots is not None:
+            slot = self.request_slots.release(request_id)
+            if slot is not None:
+                ready = self.slot_ready[slot.index]
+                if ready is not None:
+                    ready.synchronize()
+                self.slot_optimizers[slot.index].reset(self.initial_trainable)
+                self.slot_rounds[slot.index] = 0
+                self.slot_ready[slot.index] = None
+            self.runtime.finish_request(request_id)
+            return
+        if self.runtime.finish_request(request_id):
+            self._restore_request_source()
+
+    def abort_request(self, request_id: str) -> None:
+        if self.request_slots is not None:
+            self.finish_request(request_id)
+            return
+        if self.runtime.abort_request(request_id):
+            self._restore_request_source()
+
+    def _restore_request_source(self) -> None:
+        self.optimizer.reset(self.initial_trainable)
+        effective = self._effective_parameters(self.optimizer.master)
+        self.inference.stage(tuple(effective[name] for name in self.names))
+        self.inference.publish()
+
+    def reset(self) -> None:
+        if self.request_slots is not None:
+            for request_id in tuple(self.request_slots.by_request):
+                self.finish_request(request_id)
+        self.runtime.reset()
+        self.optimizer.reset(self.initial_trainable)
+        effective = self._effective_parameters(self.optimizer.master)
+        self.inference.stage(tuple(effective[name] for name in self.names))
+        self.inference.publish()
+        self._captured_input = None
+        self._captured_positions = None
+        self._captured_prefix_lens = None
+        self._captured_request_ids = ()
+        self._captured_history = None
+
+    def reload_config(self, server_args) -> None:
+        config = load_online_adaptation(server_args)
+        if config is None or adaptation_layout(config) != adaptation_layout(self.config):
+            raise ValueError("DFlash adaptation layout changed; restart the server")
+        self.config = config
+        self.runtime.reload_config(config)
+        reconfigure_parameter_optimizer(self.optimizer, config)
+
+    def note_load(
+        self,
+        *,
+        running_requests: int,
+        waiting_requests: int,
+        graph_replay: bool,
+    ) -> None:
+        self.runtime.note_load(
+            running_requests=running_requests,
+            waiting_requests=waiting_requests,
+            graph_replay=graph_replay,
+        )
+
+    def diagnostics(self) -> dict:
+        online_spec_state = (
+            self.optimizer.diagnostics()
+            if isinstance(self.optimizer, OnlineSpecOptimizer)
+            else None
+        )
+        return self.runtime.diagnostics(extra={"online_spec_state": online_spec_state})
+
+
