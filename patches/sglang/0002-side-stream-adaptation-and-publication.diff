+class QuotaShadowLedger:
+    """One shadow request per due source round."""
+
+    def __init__(self, *, algorithm: str, policy: str) -> None:
+        self.algorithm = algorithm
+        self.policy = policy
+        self._used_source_rounds: set[int] = set()
+        self.events: list[TeacherRowAcquisitionEvent] = []
+
+    def request(
+        self,
+        *,
+        source_round: int,
+        source_version: int,
+        request_ids: Sequence[str],
+    ) -> bool:
+        identifiers = tuple(request_ids)
+        if self.policy != "quota_shadow":
+            raise RuntimeError("quota-shadow acquisition was not registered")
+        if source_round < 1 or source_version < 0 or not identifiers:
+            raise ValueError("quota-shadow request identity is incomplete")
+        if len(set(identifiers)) != len(identifiers):
+            raise ValueError("quota-shadow request IDs must be unique")
+        if source_round in self._used_source_rounds:
+            self.events.append(
+                TeacherRowAcquisitionEvent(
+                    source_round,
+                    source_version,
+                    identifiers,
+                    1,
+                    1,
+                    "EXHAUSTED",
+                    "quota_shadow_source_round_exhausted",
+                )
+            )
+            return False
+        self._used_source_rounds.add(source_round)
+        capability = TEACHER_ROW_ACQUISITION_CAPABILITIES[self.algorithm]
+        if capability != "quota_shadow_native_v1":
+            self.events.append(
+                TeacherRowAcquisitionEvent(
+                    source_round,
+                    source_version,
+                    identifiers,
+                    1,
+                    1,
+                    "BLOCKED",
+                    f"teacher_acquisition_capability:{capability}",
+                )
+            )
+            return False
+        self.events.append(
+            TeacherRowAcquisitionEvent(
+                source_round,
+                source_version,
+                identifiers,
+                1,
+                1,
+                "AUTHORIZED",
+                "quota_shadow_native_acquisition_authorized",
+            )
+        )
+        return True
+
+    def reset(self) -> None:
+        self._used_source_rounds.clear()
+        self.events.clear()
+
