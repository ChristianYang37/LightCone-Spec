+    @property
+    def has_tail_correction(self) -> bool:
+        return self._tail_logits_offset_fn is not None
+
+    def _tail_requires_eager_capture(self, batch=None) -> bool:
+        """Whether this proposal must expose real eager supervision tensors.
+
+        A bound-method owner may request eager execution only on trigger/trace
+        rounds.  Non-supervision rounds continue to use the captured tail
+        operations and fixed parameter-row addresses.
+        """
+        fn = self._tail_logits_offset_fn
+        owner = getattr(fn, "__self__", None) if fn is not None else None
+        policy = getattr(owner, "requires_eager_capture", None)
+        return bool(policy(batch) if callable(policy) else False)
+
+    def attach_tail_correction(self, fn: Callable) -> None:
+        """Attach a graph-capturable additive proposal-logits correction.
+
+        ``fn`` receives only tensor-valued dynamic inputs plus static
+        ``phase`` / ``proposal_step`` keywords.  It must return either None or
+        one additive tensor with the same shape as ``logits``.  The worker adds
+        that tensor exactly once before every proposal sampling operation.
+
+        Attachment must happen before graph capture so replay sees the same
+        callable and fixed parameter addresses used during capture.
+        """
+        if self.topk != 1:
+            raise ValueError(
+                "EAGLE tail adaptation currently supports only topk=1 chains; "
+                f"got topk={self.topk}"
+            )
+        if (
+            getattr(self, "cuda_graph_runner", None) is not None
+            or getattr(self, "cuda_graph_runner_for_draft_extend", None) is not None
+        ):
+            raise RuntimeError(
+                "EAGLE tail correction must be attached before CUDA graph capture"
+            )
+        if fn is None or not callable(fn):
+            raise TypeError("EAGLE tail correction must be callable")
+        self._tail_logits_offset_fn = fn
+
+    def _correct_proposal_logits(
+        self,
+        logits: torch.Tensor,
+        *,
+        hidden_states: Optional[torch.Tensor],
+        source_adapter_version: Optional[torch.Tensor],
+        req_pool_indices: torch.Tensor,
+        phase: str,
+        proposal_step: int,
+    ) -> torch.Tensor:
+        fn = self._tail_logits_offset_fn
+        if fn is None:
+            return logits
+        if source_adapter_version is None:
+            raise RuntimeError(
+                "adapted EAGLE proposal is missing source_adapter_version"
+            )
+        offset = fn(
+            logits=logits,
+            hidden_states=hidden_states,
+            source_adapter_version=source_adapter_version,
+            req_pool_indices=req_pool_indices,
+            phase=phase,
+            proposal_step=proposal_step,
+        )
+        if offset is None:
+            return logits
+        if not isinstance(offset, torch.Tensor):
+            raise TypeError("EAGLE tail correction must return a tensor or None")
+        if offset.shape != logits.shape:
+            raise ValueError(
+                "EAGLE tail correction shape mismatch: "
+                f"expected {tuple(logits.shape)}, got {tuple(offset.shape)}"
+            )
+        if offset.device != logits.device or offset.dtype != logits.dtype:
+            raise ValueError(
+                "EAGLE tail correction must match proposal logits device and dtype"
+            )
+        return logits + offset
+
