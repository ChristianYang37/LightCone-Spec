+def _merge_sglang_native_token_timestamp_events(
+    accumulated: Optional[List[Dict[str, int]]],
+    response_events: Any,
+) -> List[Dict[str, int]]:
+    """Merge exact native events; never infer timestamps from SSE chunks.
+
+    Streaming metadata can carry either the complete cumulative event prefix or
+    the next absolute-indexed delta.  Supporting both forms does not turn SSE
+    chunk timing into token timing: every accepted timestamp is still an
+    explicit native event emitted by the server.
+    """
+
+    if not isinstance(response_events, list):
+        raise TypeError("SGLang native token timestamp events must be a list")
+    merged = [] if accumulated is None else [dict(event) for event in accumulated]
+    if not response_events:
+        return merged
+
+    first = response_events[0]
+    if not isinstance(first, dict):
+        raise ValueError("SGLang native token timestamp event is malformed")
+    first_index = first.get("token_index")
+    if first_index == 0:
+        base_index = 0
+    elif merged and first_index == len(merged):
+        base_index = len(merged)
+    else:
+        raise ValueError("SGLang native token timestamp coverage is invalid")
+
+    parsed: List[Dict[str, int]] = []
+    for raw in response_events:
+        if not isinstance(raw, dict) or set(raw) != {
+            "token_index",
+            "token_id",
+            "observed_ns",
+        }:
+            raise ValueError("SGLang native token timestamp event is malformed")
+        if any(
+            isinstance(value, bool) or not isinstance(value, int)
+            for value in raw.values()
+        ):
+            raise ValueError("SGLang native token timestamp fields must be integers")
+        index = raw["token_index"]
+        token_id = raw["token_id"]
+        observed_ns = raw["observed_ns"]
+        if index != base_index + len(parsed) or token_id < 0 or observed_ns < 0:
+            raise ValueError("SGLang native token timestamp coverage is invalid")
+        if parsed and observed_ns <= parsed[-1]["observed_ns"]:
+            raise ValueError("SGLang native token timestamps are not increasing")
+        parsed.append(
+            {"token_index": index, "token_id": token_id, "observed_ns": observed_ns}
+        )
+    if base_index:
+        if merged and parsed[0]["observed_ns"] <= merged[-1]["observed_ns"]:
+            raise ValueError("SGLang native token timestamps are not increasing")
+        return [*merged, *parsed]
+    if not merged:
+        return parsed
+    if len(parsed) >= len(merged) and parsed[: len(merged)] == merged:
+        return parsed
+    raise ValueError("SGLang native token timestamp prefix changed")
+
+
+def _finalize_sglang_client_itl_coverage(
+    output: RequestFuncOutput,
+    *,
+    output_len: int,
+    coalesced_chunks: int,
+    coalesced_intervals: int,
+) -> None:
+    """Bind exact client-observed interval coverage without filling gaps."""
+
+    for label, value in (
+        ("output length", output_len),
+        ("coalesced chunk count", coalesced_chunks),
+        ("coalesced interval count", coalesced_intervals),
+    ):
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            raise ValueError(f"SGLang ITL {label} must be a non-negative integer")
+    if any(
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(float(value))
+        or value < 0
+        for value in output.itl
+    ):
+        raise ValueError(
+            "SGLang client ITL observations must be finite and non-negative"
+        )
+
+    expected = max(output_len - 1, 0)
+    observed = len(output.itl)
+    if observed > expected:
+        raise ValueError("SGLang client ITL observations exceed expected coverage")
+    missing = expected - observed
+    if coalesced_intervals > missing or coalesced_chunks > coalesced_intervals:
+        raise ValueError("SGLang coalesced ITL accounting is inconsistent")
+
+    output.itl_expected_intervals = expected
+    output.itl_observed_intervals = observed
+    output.itl_coalesced_chunks = coalesced_chunks
+    output.itl_coalesced_intervals = coalesced_intervals
+    output.itl_missing_intervals = missing
+    output.itl_coverage = 1.0 if expected == 0 else observed / expected
+    if missing:
+        output.itl_unsupported_reason = _SGLANG_ITL_INCOMPLETE_REASON
+    elif expected == 0:
+        output.itl_unsupported_reason = _SGLANG_ITL_NO_INTERVALS_REASON
+    else:
+        output.itl_unsupported_reason = None
+
+
+def _summarize_sglang_client_itl_coverage(
+    outputs: List[RequestFuncOutput],
+) -> Dict[str, Any]:
+    """Return all-or-none aggregate ITLs plus explicit coverage accounting."""
+
+    expected_total = 0
+    observed_total = 0
+    coalesced_chunks_total = 0
+    coalesced_intervals_total = 0
+    missing_total = 0
+    values: List[float] = []
+    for output in outputs:
+        if not output.success:
+            continue
+        counts = (
+            output.itl_expected_intervals,
+            output.itl_observed_intervals,
+            output.itl_coalesced_chunks,
+            output.itl_coalesced_intervals,
+            output.itl_missing_intervals,
+        )
+        if any(
+            isinstance(value, bool) or not isinstance(value, int) or value < 0
+            for value in counts
+        ):
+            raise ValueError("SGLang request lacks exact client ITL coverage")
+        expected, observed, coalesced_chunks, coalesced_intervals, missing = counts
+        if (
+            expected != max(output.output_len - 1, 0)
+            or observed != len(output.itl)
+            or missing != expected - observed
+            or coalesced_intervals > missing
+            or coalesced_chunks > coalesced_intervals
+        ):
+            raise ValueError("SGLang request client ITL coverage is inconsistent")
+        expected_coverage = 1.0 if expected == 0 else observed / expected
+        if (
+            not isinstance(output.itl_coverage, float)
+            or not math.isfinite(output.itl_coverage)
+            or not math.isclose(
+                output.itl_coverage,
+                expected_coverage,
+                rel_tol=0.0,
+                abs_tol=1e-12,
+            )
+        ):
+            raise ValueError("SGLang request client ITL coverage ratio changed")
+        expected_reason = (
+            _SGLANG_ITL_INCOMPLETE_REASON
+            if missing
+            else (_SGLANG_ITL_NO_INTERVALS_REASON if expected == 0 else None)
+        )
+        if output.itl_unsupported_reason != expected_reason:
+            raise ValueError("SGLang request client ITL support status changed")
+        expected_total += expected
+        observed_total += observed
+        coalesced_chunks_total += coalesced_chunks
+        coalesced_intervals_total += coalesced_intervals
+        missing_total += missing
+        values.extend(float(value) for value in output.itl)
+
+    coverage = 1.0 if expected_total == 0 else observed_total / expected_total
+    unsupported_reason = (
+        _SGLANG_ITL_INCOMPLETE_REASON
+        if missing_total
+        else (_SGLANG_ITL_NO_INTERVALS_REASON if expected_total == 0 else None)
+    )
+    return {
+        "expected_intervals": expected_total,
+        "observed_intervals": observed_total,
+        "coalesced_chunks": coalesced_chunks_total,
+        "coalesced_intervals": coalesced_intervals_total,
+        "missing_intervals": missing_total,
+        "coverage": coverage,
+        "unsupported_reason": unsupported_reason,
+        # Never expose a selected sparse subset as an aggregate distribution.
+        "supported_values": None if unsupported_reason is not None else values,
+    }
+
+
+def _itl_statistics_ms(
+    values: Optional[List[float]],
+) -> Tuple[
+    Optional[float],
+    Optional[float],
+    Optional[float],
+    Optional[float],
+    Optional[float],
+    Optional[float],
+    Optional[float],
+]:
+    """Return aggregate ITL statistics, or all ``None`` when unsupported."""
+
+    if values is None:
+        return (None, None, None, None, None, None, None)
+    samples = values or 0
+    return (
+        float(np.mean(samples) * 1000),
+        float(np.median(samples) * 1000),
+        float(np.std(samples) * 1000),
+        float(np.percentile(samples, 90) * 1000),
+        float(np.percentile(samples, 95) * 1000),
+        float(np.percentile(samples, 99) * 1000),
+        float(np.max(samples) * 1000),
+    )
+
