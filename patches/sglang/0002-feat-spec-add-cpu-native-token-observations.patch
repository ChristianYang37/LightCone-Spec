diff --git a/test/registered/unit/benchmark/test_native_token_timestamps.py b/test/registered/unit/benchmark/test_native_token_timestamps.py
new file mode 100644
index 0000000..9bd2ca8
--- /dev/null
+++ b/test/registered/unit/benchmark/test_native_token_timestamps.py
@@ -0,0 +1,158 @@
+from __future__ import annotations
+
+import ast
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+ROOT = Path(__file__).resolve().parents[4]
+HOOK_PATH = ROOT / "python/sglang/srt/managers/native_token_timestamps.py"
+SERVING_PATH = ROOT / "python/sglang/benchmark/serving.py"
+TOKENIZER_MANAGER_PATH = ROOT / "python/sglang/srt/managers/tokenizer_manager.py"
+
+
+def _load_functions(path: Path, names: set[str], namespace: dict | None = None):
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    selected = [
+        node
+        for node in tree.body
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and node.name in names
+    ]
+    scope = {} if namespace is None else dict(namespace)
+    exec(compile(ast.Module(body=selected, type_ignores=[]), path, "exec"), scope)
+    return tuple(scope[name] for name in names)
+
+
+class NativeTokenTimestampTests(unittest.TestCase):
+    def test_records_only_final_committed_prefix_with_explicit_cpu_semantics(self):
+        source = HOOK_PATH.read_text(encoding="utf-8")
+        self.assertIn("cpu_committed_token_observed_at_streamer_v1", source)
+        self.assertIn(
+            'NATIVE_TOKEN_TIMESTAMP_RELEASE_STATUS = "CPU_CONTRACT_ONLY"', source
+        )
+        (observe,) = _load_functions(
+            HOOK_PATH,
+            {"observe_committed_output_tokens"},
+            {
+                "Any": object,
+                "Callable": object,
+                "time": SimpleNamespace(monotonic_ns=lambda: 0),
+            },
+        )
+        req = SimpleNamespace(
+            return_native_token_timestamps=True,
+            output_ids_through_stop=[10, 11],
+            native_token_timestamp_events=[],
+        )
+        times = iter((100, 120, 140))
+        observe(req, clock=lambda: next(times))
+        self.assertEqual(req.native_token_timestamp_events, [(10, 100), (11, 120)])
+        req.output_ids_through_stop = [10, 11, 12]
+        observe(req, clock=lambda: next(times))
+        self.assertEqual(req.native_token_timestamp_events[-1], (12, 140))
+
+    def test_wire_metadata_binds_request_lifecycle_even_without_token_events(self):
+        source = TOKENIZER_MANAGER_PATH.read_text(encoding="utf-8")
+        for field in (
+            "native_token_timestamp_request_id",
+            "native_token_timestamp_request_started_ns",
+            "native_token_timestamp_request_terminal_ns",
+            "native_token_timestamp_terminal_status",
+            "native_token_timestamp_terminal_reason",
+        ):
+            self.assertIn(field, source)
+        base_metadata = source.index('"native_token_timestamp_request_id"')
+        event_branch = source.index("native_events = getattr")
+        self.assertLess(base_metadata, event_branch)
+
+    def test_one_streamer_observation_enumerates_an_already_committed_batch(self):
+        source = HOOK_PATH.read_text(encoding="utf-8")
+        self.assertIn("not a CUDA event", source)
+        self.assertIn("host observation", source)
+        (observe,) = _load_functions(
+            HOOK_PATH,
+            {"observe_committed_output_tokens"},
+            {
+                "Any": object,
+                "Callable": object,
+                "time": SimpleNamespace(monotonic_ns=lambda: 0),
+            },
+        )
+        req = SimpleNamespace(
+            return_native_token_timestamps=True,
+            output_ids_through_stop=[10, 11, 12],
+            native_token_timestamp_events=[],
+        )
+        times = iter((100, 101, 102))
+        observe(req, clock=lambda: next(times))
+        self.assertEqual(
+            req.native_token_timestamp_events,
+            [(10, 100), (11, 101), (12, 102)],
+        )
+
+    def test_rejects_mutated_or_retracted_committed_prefix(self):
+        (observe,) = _load_functions(
+            HOOK_PATH,
+            {"observe_committed_output_tokens"},
+            {
+                "Any": object,
+                "Callable": object,
+                "time": SimpleNamespace(monotonic_ns=lambda: 0),
+            },
+        )
+        for output_ids in ([10], [99, 11]):
+            req = SimpleNamespace(
+                return_native_token_timestamps=True,
+                output_ids_through_stop=output_ids,
+                native_token_timestamp_events=[(10, 100), (11, 120)],
+            )
+            with self.assertRaises(RuntimeError):
+                observe(req, clock=lambda: 140)
+
+    def test_benchmark_merges_native_events_and_has_no_chunk_interpolation(self):
+        source = SERVING_PATH.read_text(encoding="utf-8")
+        self.assertNotIn("adjust_itl = chunk_gap / num_new_tokens", source)
+        for field in (
+            "itl_expected_intervals",
+            "itl_observed_intervals",
+            "itl_coalesced_intervals",
+            "itl_missing_intervals",
+            "itl_coverage",
+            "itl_unsupported_reason",
+            "incomplete_client_interval_coverage",
+        ):
+            self.assertIn(field, source)
+        (merge,) = _load_functions(
+            SERVING_PATH,
