From 203fc47b5b1347f7c5f49b426f7965b216f6e803 Mon Sep 17 00:00:00 2001
From: Christian Yang <ChristianYang37@users.noreply.github.com>
Date: Mon, 10 Aug 2026 20:32:46 +0800
Subject: [PATCH] feat(spec): support low-memory OnlineSPEC Hedge decisions

---
 .../srt/speculative/online_adaptation_config.py     |  4 ----
 .../unit/spec/test_online_adaptation_protocol.py    | 13 +++++++++++++
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/python/sglang/srt/speculative/online_adaptation_config.py b/python/sglang/srt/speculative/online_adaptation_config.py
index 8b02ac0..99e2200 100644
--- a/python/sglang/srt/speculative/online_adaptation_config.py
+++ b/python/sglang/srt/speculative/online_adaptation_config.py
@@ -198,10 +198,6 @@ class OnlineAdaptationConfig:
         online_spec = _parse_online_spec(value.get("online_spec"), value["method"])
         optimizer = _parse_optimizer(value["optimizer"], method=value["method"])
         if value["method"] == "onlinespec_ens":
-            if value["weight_update_mode"] != "full":
-                raise ValueError(
-                    "OnlineSPEC Hedge combines full parameter decisions"
-                )
             if online_spec is None:
                 raise AssertionError("validated OnlineSPEC config is missing")
             rates = (
diff --git a/test/registered/unit/spec/test_online_adaptation_protocol.py b/test/registered/unit/spec/test_online_adaptation_protocol.py
index fd54177..7ffe6d4 100644
--- a/test/registered/unit/spec/test_online_adaptation_protocol.py
+++ b/test/registered/unit/spec/test_online_adaptation_protocol.py
@@ -221,6 +221,19 @@ class TestOnlineAdaptationConfig(unittest.TestCase):
         )
         loaded = OnlineAdaptationConfig.load(_write_config(ensemble))
         self.assertEqual(loaded.online_spec.additional_learning_rates, (0.2, 0.4))
+        ensemble_lora = _online_config(
+            "onlinespec_ens",
+            additional_learning_rates=[0.2, 0.4],
+            hedge_learning_rate=0.5,
+        )
+        ensemble_lora.update(
+            weight_update_mode="lora",
+            parameter_scope="drafter",
+            rank=8,
+        )
+        loaded_lora = OnlineAdaptationConfig.load(_write_config(ensemble_lora))
+        self.assertEqual(loaded_lora.weight_update_mode, "lora")
+        self.assertEqual(loaded_lora.rank, 8)
         with self.assertRaisesRegex(ValueError, "only valid"):
             OnlineAdaptationConfig.load(
                 _write_config(_config_value(online_spec=ensemble["online_spec"]))
-- 
