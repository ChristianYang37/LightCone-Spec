@@ -139,6 +142,7 @@ class DFlashDraftInputV2(SpecInput):
             raise ValueError(
                 f"DFLASH invalid speculative_num_draft_tokens={block_size}."
             )
+        row_capacity = int(batch.req_to_token_pool.req_to_token.shape[1])
         page_size = batch.token_to_kv_pool_allocator.page_size
         nxt_kv_lens_cpu_t = self._prepare_nxt_kv_lens_cpu_buf[:bs]
         committed_seq_lens_sum = 0
@@ -151,7 +155,14 @@ class DFlashDraftInputV2(SpecInput):
             committed_len = int(req.kv_committed_len)
             # Read the allocation watermark from the req object like EAGLE.
             cur_alloc_len = int(req.kv.kv_allocated_len)
-            reserved_len = max(cur_alloc_len, committed_len + 2 * block_size)
+            reserved_len = bounded_speculative_kv_reservation(
+                algorithm="DFLASH",
+                committed_len=committed_len,
+                allocated_len=cur_alloc_len,
+                verify_len=block_size,
+                reserve_len=2 * block_size,
+                row_capacity=row_capacity,
+            )
             top_k = int(req.sampling_params.top_k)
 
             batch_seq_lens_cpu_t[i] = committed_len
diff --git a/test/registered/unit/spec/test_online_adaptation_protocol.py b/test/registered/unit/spec/test_online_adaptation_protocol.py
