 from unittest.mock import patch
 
 import torch
+from sglang.srt.mem_cache.allocation_sizing import (
+    bounded_speculative_kv_reservation,
+    get_req_to_token_extra_context_len,
+)
 from sglang.srt.speculative.online_adaptation_config import (
     OnlineAdaptationConfig,
     OnlineOptimizerConfig,
@@ -37,6 +41,40 @@ register_cpu_ci(est_time=10, suite="base-a-test-cpu")
 register_cuda_ci(est_time=20, stage="base-b", runner_config="1-gpu-small")
 
 
+class TestDFlashRequestBoundaryKv(unittest.TestCase):
+    def test_token_granular_row_includes_double_buffer_headroom(self):
+        args = SimpleNamespace(
+            speculative_algorithm="DFLASH",
+            speculative_num_steps=1,
+            speculative_eagle_topk=1,
+            max_speculative_num_draft_tokens=16,
+            page_size=1,
+        )
+        self.assertEqual(get_req_to_token_extra_context_len(args), 32)
+
+    def test_reservation_is_bounded_by_physical_row(self):
+        self.assertEqual(
+            bounded_speculative_kv_reservation(
+                algorithm="DFLASH",
+                committed_len=20,
+                allocated_len=20,
+                verify_len=16,
+                reserve_len=32,
+                row_capacity=48,
+            ),
+            48,
+        )
+        with self.assertRaisesRegex(RuntimeError, "verify block exceeds"):
+            bounded_speculative_kv_reservation(
+                algorithm="DFLASH",
+                committed_len=33,
+                allocated_len=33,
+                verify_len=16,
+                reserve_len=32,
+                row_capacity=48,
+            )
+
+
