Subject: [PATCH] fix(spec): bound request-boundary KV reservations

---
 .../sglang/srt/mem_cache/allocation_sizing.py | 38 ++++++++++++++++---
 .../sglang/srt/speculative/dflash_info_v2.py  | 13 ++++++-
 .../spec/test_online_adaptation_protocol.py   | 38 +++++++++++++++++++
 3 files changed, 82 insertions(+), 7 deletions(-)

diff --git a/python/sglang/srt/mem_cache/allocation_sizing.py b/python/sglang/srt/mem_cache/allocation_sizing.py
index 10d08d6..bd0e7c2 100644
--- a/python/sglang/srt/mem_cache/allocation_sizing.py
+++ b/python/sglang/srt/mem_cache/allocation_sizing.py
@@ -43,18 +43,44 @@ def get_alloc_reserve_per_decode(server_args: Optional[ServerArgs] = None) -> in
     return 2 * get_alloc_len_per_decode(server_args)
 
 
+def bounded_speculative_kv_reservation(
+    *,
+    algorithm: str,
+    committed_len: int,
+    allocated_len: int,
+    verify_len: int,
+    reserve_len: int,
+    row_capacity: int,
+) -> int:
+    """Return an in-row reservation or fail before an out-of-bounds write."""
+    if allocated_len > row_capacity:
+        raise RuntimeError(
+            f"{algorithm} allocation watermark exceeds req_to_token row capacity: "
+            f"allocated={allocated_len}, capacity={row_capacity}."
+        )
+    if committed_len + verify_len > row_capacity:
+        raise RuntimeError(
+            f"{algorithm} verify block exceeds req_to_token row capacity: "
+            f"committed={committed_len}, block={verify_len}, "
+            f"capacity={row_capacity}."
+        )
+    return min(max(allocated_len, committed_len + reserve_len), row_capacity)
+
+
 def get_req_to_token_extra_context_len(server_args: ServerArgs) -> int:
     """req_to_token row headroom beyond the model context length.
 
-    Sized to hold the decode over-allocation; the spec v2 page>1 topk>1 holey
-    draft footprint can outgrow the default num_draft_tokens headroom.
+    Sized to hold the complete decode over-allocation.  The allocator reserves
+    two decode blocks even for token-granular pools, while page-granular pools
+    can additionally overshoot by one partial page.
     """
     # FIXME(lsyin): temporary fix for the context length issue under spec decoding
     extra = 4 + (server_args.max_speculative_num_draft_tokens or 0)
-    if server_args.speculative_algorithm is not None and server_args.page_size > 1:
-        # kv_allocated_len is page-aligned (eagle_prepare_for_decode), so near
-        # the context limit the aligned reserve can overshoot by page_size - 1;
-        # without the headroom the row write silently lands in the neighbor row.
+    if server_args.speculative_algorithm is not None:
+        # Without the full double-buffer reserve, a token-granular DFLASH row
+        # can also overflow near the context limit: prepare_for_decode reserves
+        # 2 * num_draft_tokens, not num_draft_tokens.  Page-aligned allocation
+        # may overshoot that reserve by a further page_size - 1 slots.
         extra = max(
             extra,
             get_alloc_reserve_per_decode(server_args) + server_args.page_size - 1,
