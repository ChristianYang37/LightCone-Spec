+    def bind_terminal_begin(
+        self,
+        *,
+        capability_sha256: str,
+        execution_plan_sha256: str,
+        run_id: str,
+        begin_sha256: str,
+        warmup_request_ids_sha256: str,
+        warmup_started_ns: int,
+    ) -> dict[str, object]:
+        """Bind the existing native terminal begin to the last clean reset."""
+
+        try:
+            if (
+                self.failed
+                or self.capability_receipt is None
+                or self.initial_state_receipt_value is None
+                or self.pending_reset is not None
+                or self.current_trace is not None
+                or self.close_terminal_receipt is not None
+                or self.last_reset_receipt_sha256 is None
+                or capability_sha256 != self.capability_receipt["capability_sha256"]
+            ):
+                raise RuntimeError("terminal begin capability mismatch")
+            plan = _sha256(execution_plan_sha256, "execution_plan_sha256")
+            if plan != self.last_execution_plan_sha256:
+                raise RuntimeError("terminal begin is not bound to the clean reset")
+            if not isinstance(run_id, str) or not run_id or "\n" in run_id:
+                raise ValueError("terminal run ID must be non-empty single-line text")
+            begin = _sha256(begin_sha256, "begin_sha256")
+            warmup = _sha256(warmup_request_ids_sha256, "warmup_request_ids_sha256")
+            started = _integer(warmup_started_ns, "warmup_started_ns")
+            source_reset_receipt_sha256 = self.last_reset_receipt_sha256
+            self.last_reset_receipt_sha256 = None
+            self.current_trace = {
+                "execution_plan_sha256": plan,
+                "run_id": run_id,
+                "begin_sha256": begin,
+                "warmup_request_ids_sha256": warmup,
+                "warmup_started_ns": started,
+                "source_reset_receipt_sha256": source_reset_receipt_sha256,
+            }
+            result = {
+                "schema_version": 1,
+                "hook": SOURCE_OWNED_SESSION_HOOK,
+                "capability_sha256": capability_sha256,
+                "execution_plan_sha256": plan,
+                "begin_sha256": begin,
+            }
+            result["session_begin_sha256"] = content_sha256(result)
+            return result
+        except Exception:
+            self.failed = True
+            raise
+
+    def bind_terminal_reset(
+        self,
+        *,
+        capability_sha256: str,
+        run_id: str,
+        native_reset_sha256: str,
+        warmup_completed_ns: int,
+        scored_started_ns: int,
+        connection_accounting: object,
+    ) -> dict[str, object]:
+        """Mint warm-up and scored-clock receipts from one native reset."""
+
+        try:
+            if (
+                self.failed
+                or self.capability_receipt is None
+                or self.current_trace is None
+                or self.current_trace.get("warmup_receipt") is not None
+                or capability_sha256 != self.capability_receipt["capability_sha256"]
+                or run_id != self.current_trace["run_id"]
+            ):
+                raise RuntimeError("terminal reset capability mismatch")
+            native_reset = _sha256(native_reset_sha256, "native_reset_sha256")
+            completed = _integer(warmup_completed_ns, "warmup_completed_ns")
+            scored = _integer(scored_started_ns, "scored_started_ns")
+            started = int(self.current_trace["warmup_started_ns"])
+            if completed < started or scored < completed:
+                raise RuntimeError("warm-up/scored monotonic interval is invalid")
+            accounting = validate_connection_accounting(connection_accounting)
+            assert self.last_connection_accounting is not None
+            _require_accounting_continuation(
+                accounting, self.last_connection_accounting
+            )
+            plan = str(self.current_trace["execution_plan_sha256"])
+            warmup = {
+                "schema_version": 1,
+                "execution_plan_sha256": plan,
+                # The terminal begin receipt already binds this digest to the
+                # exact ordered warm-up request IDs accepted by the scheduler.
+                "request_pool_sha256": self.current_trace["warmup_request_ids_sha256"],
+                "excluded": True,
+                "started_ns": started,
+                "completed_ns": completed,
+                "connection_accounting": accounting,
+            }
+            warmup["warmup_receipt_sha256"] = content_sha256(warmup)
+            self.clock_generation += 1
+            clock = {
+                "schema_version": 1,
+                "execution_plan_sha256": plan,
+                "warmup_receipt_sha256": warmup["warmup_receipt_sha256"],
+                "clock_generation": self.clock_generation,
+                "scored_started_ns": scored,
+                "native_reset_sha256": native_reset,
+            }
+            clock["clock_receipt_sha256"] = content_sha256(clock)
+            self.current_trace["warmup_receipt"] = warmup
+            self.current_trace["clock_receipt"] = clock
+            self.last_connection_accounting = accounting
+            result = {
+                "schema_version": 1,
+                "hook": SOURCE_OWNED_SESSION_HOOK,
+                "capability_sha256": capability_sha256,
+                "warmup_receipt": warmup,
+                "clock_receipt": clock,
+            }
+            result["trace_ready_sha256"] = content_sha256(result)
+            return result
+        except Exception:
+            self.failed = True
+            raise
+
+    def bind_terminal_finalize(
+        self,
+        *,
+        capability_sha256: str,
+        run_id: str,
+        terminal_receipt_sha256: str,
+        connection_accounting: object,
+    ) -> dict[str, object]:
+        """Bind one native terminal envelope to its independent scored clock."""
+
+        try:
+            if (
+                self.failed
+                or self.capability_receipt is None
+                or self.current_trace is None
+                or self.current_trace.get("warmup_receipt") is None
+                or self.current_trace.get("clock_receipt") is None
+                or capability_sha256 != self.capability_receipt["capability_sha256"]
+                or run_id != self.current_trace["run_id"]
+            ):
+                raise RuntimeError("terminal finalize capability mismatch")
+            terminal = _sha256(terminal_receipt_sha256, "terminal_receipt_sha256")
+            accounting = validate_connection_accounting(connection_accounting)
+            assert self.last_connection_accounting is not None
+            _require_accounting_continuation(
+                accounting, self.last_connection_accounting
+            )
+            warmup = self.current_trace["warmup_receipt"]
+            clock = self.current_trace["clock_receipt"]
+            assert isinstance(warmup, dict) and isinstance(clock, dict)
+            receipt = {
+                "schema_version": 1,
+                "execution_plan_sha256": self.current_trace["execution_plan_sha256"],
+                "clock_receipt_sha256": clock["clock_receipt_sha256"],
+                "terminal_receipt_sha256": terminal,
+                "aborted": False,
+                "connection_accounting": accounting,
+            }
+            receipt["trace_receipt_sha256"] = content_sha256(receipt)
+            self.completed_traces.append(
+                {
+                    "execution_plan_sha256": self.current_trace[
+                        "execution_plan_sha256"
+                    ],
+                    "reset_receipt_sha256": self.current_trace[
+                        "source_reset_receipt_sha256"
+                    ],
+                    "warmup_receipt_sha256": warmup["warmup_receipt_sha256"],
+                    "clock_receipt_sha256": clock["clock_receipt_sha256"],
+                    "trace_receipt_sha256": receipt["trace_receipt_sha256"],
+                    "terminal_receipt_sha256": terminal,
+                }
+            )
+            self.last_connection_accounting = accounting
+            self.current_trace = None
+            return receipt
+        except Exception:
+            self.failed = True
+            raise
+
+    def close_terminal(
+        self,
+        *,
+        capability_sha256: str,
+        connection_accounting: object,
+    ) -> dict[str, object]:
+        """Seal the whole native trace chain before transport/process close.
+
+        The HTTP connection carrying this receipt cannot already have emitted
+        ``connection_lost``.  The receipt therefore states that transport close
+        is pending instead of fabricating a zero-current connection snapshot.
+        The caller must close the pool and terminate this process afterwards.
+        """
+
+        try:
+            if (
+                self.failed
+                or self.capability_receipt is None
+                or self.initial_state_receipt_value is None
+                or self.pending_reset is not None
+                or self.current_trace is not None
+                or not self.completed_traces
+                or self.close_terminal_receipt is not None
+                or capability_sha256 != self.capability_receipt["capability_sha256"]
+            ):
+                raise RuntimeError("session close capability mismatch")
+            accounting = validate_connection_accounting(connection_accounting)
+            assert self.last_connection_accounting is not None
+            _require_accounting_continuation(
+                accounting, self.last_connection_accounting
+            )
+            if accounting["connections_current"] < 1:
+                raise RuntimeError(
+                    "session close response transport is already closed"
+                )
+            plans = [row["execution_plan_sha256"] for row in self.completed_traces]
+            if tuple(plans) != self.execution_plan_sha256s:
+                raise RuntimeError("session close trace chain is incomplete")
+            receipt = {
+                "schema_version": 1,
+                "hook": SOURCE_OWNED_SESSION_HOOK,
+                "capability_sha256": capability_sha256,
+                "initial_state_receipt_sha256": self.initial_state_receipt_value[
+                    "initial_state_receipt_sha256"
+                ],
+                "session_plan_sha256": self.session_plan_sha256,
+                "process_identity": self.process_identity,
+                "session_epoch": self.session_epoch,
+                "execution_plan_sha256s": plans,
+                "trace_chain": [dict(row) for row in self.completed_traces],
+                "lifecycle_closed": True,
+                "transport_close_pending": True,
+                "connection_accounting": accounting,
+            }
+            receipt["close_receipt_sha256"] = content_sha256(receipt)
+            self.close_terminal_receipt = receipt
+            self.last_connection_accounting = accounting
+            return dict(receipt)
+        except Exception:
+            self.failed = True
+            raise
+
 
