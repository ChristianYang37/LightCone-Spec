     obj: Annotated[Dict[str, Any], Body()], request: Request
 ):
-    if set(obj) != {"session_plan_sha256"}:
-        raise HTTPException(status_code=422, detail="session plan identity is required")
+    if set(obj) != {"session_plan_sha256", "execution_plan_sha256s"}:
+        raise HTTPException(
+            status_code=422,
+            detail="session plan and ordered trace identities are required",
+        )
     return await _source_owned_session_transition(
         action="session_capability", payload=obj
     )
@@ -962,6 +971,84 @@ async def source_owned_session_reset(
     )
 
 
+async def _source_owned_session_trace_transition(
+    *,
+    action: str,
+    bridge_action: str,
+    obj: Dict[str, Any],
+) -> Dict[str, Any]:
+    if set(obj) != {"capability_sha256", "terminal_payload"} or not isinstance(
+        obj["terminal_payload"], dict
+    ):
+        raise HTTPException(
+            status_code=422,
+            detail="session trace capability/terminal payload is incomplete",
+        )
+    terminal = await _send_terminal_speculative_evidence_transition(
+        TerminalSpeculativeEvidenceReq(
+            action=action,
+            payload=obj["terminal_payload"],
+        )
+    )
+    source = await _source_owned_session_transition(
+        action=bridge_action,
+        payload={"capability_sha256": obj["capability_sha256"]},
+    )
+    return {
+        "schema_version": 1,
+        "terminal": terminal,
+        "source_owned_session": source,
+    }
+
+
+@app.post("/v1/lightcone-spec/session-reset/trace/begin")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_session_trace_begin(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    return await _source_owned_session_trace_transition(
+        action="begin",
+        bridge_action="session_trace_begin",
+        obj=obj,
+    )
+
+
+@app.post("/v1/lightcone-spec/session-reset/trace/reset")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_session_trace_reset(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    return await _source_owned_session_trace_transition(
+        action="reset",
+        bridge_action="session_trace_ready",
+        obj=obj,
+    )
+
+
+@app.post("/v1/lightcone-spec/session-reset/trace/finalize")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_session_trace_finalize(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    return await _source_owned_session_trace_transition(
+        action="finalize",
+        bridge_action="session_trace_finalized",
+        obj=obj,
+    )
+
+
+@app.post("/v1/lightcone-spec/session-reset/close-terminal")
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def source_owned_session_close_terminal(
+    obj: Annotated[Dict[str, Any], Body()], request: Request
+):
+    if set(obj) != {"capability_sha256"}:
+        raise HTTPException(status_code=422, detail="capability identity is required")
+    return await _source_owned_session_transition(
+        action="session_close_terminal", payload=obj
+    )
+
+
 @app.get("/get_load")
