From f328666d2027b17f975ec8829de41c8035ef8c7c Mon Sep 17 00:00:00 2001
From: Christian Yang <ChristianYang37@users.noreply.github.com>
Date: Tue, 11 Aug 2026 00:32:08 +0800
Subject: [PATCH] fix(spec): preserve logical prefixes across overlap rounds

---
 .../speculative/online_adaptation_runtime.py  | 14 +++++++
 .../spec/test_online_adaptation_protocol.py   | 42 ++++++++++++++++++-
 2 files changed, 55 insertions(+), 1 deletion(-)

diff --git a/python/sglang/srt/speculative/online_adaptation_runtime.py b/python/sglang/srt/speculative/online_adaptation_runtime.py
index a9d3e01..fc01a8d 100644
--- a/python/sglang/srt/speculative/online_adaptation_runtime.py
+++ b/python/sglang/srt/speculative/online_adaptation_runtime.py
@@ -1520,6 +1520,17 @@ class OnlineCohortRuntime:
             raise RuntimeError(
                 f"previous round telemetry is incomplete for {sorted(repeated)}"
             )
+        # Overlap schedulers may carry speculative physical lengths beyond the
+        # last committed request boundary.  Preserve the previous device-side
+        # commit as the logical prefix without synchronizing it to the host.
+        committed_prefixes = tuple(
+            (
+                self.latest_device_lengths[request_id][0]
+                if request_id in self.latest_device_lengths
+                else None
+            )
+            for request_id in request_ids
+        )
         self.round += 1
         if len(self.pending_timings) >= 64:
             self._drain_ready_timings()
@@ -1543,6 +1554,9 @@ class OnlineCohortRuntime:
         row = self.round_metrics[trace_index, : len(request_ids)]
         row.fill_(-1)
         row[:, 0].copy_(prefix_lens.detach().to(torch.int64))
+        for index, committed_prefix in enumerate(committed_prefixes):
+            if committed_prefix is not None:
+                row[index, 0].copy_(committed_prefix)
         trace = RoundTrace(
             buffer_index=trace_index,
             round_index=self.round,
diff --git a/test/registered/unit/spec/test_online_adaptation_protocol.py b/test/registered/unit/spec/test_online_adaptation_protocol.py
index a746662..5dccc46 100644
--- a/test/registered/unit/spec/test_online_adaptation_protocol.py
+++ b/test/registered/unit/spec/test_online_adaptation_protocol.py
@@ -913,6 +913,31 @@ class TestFunctionalOptimizerAndBank(unittest.TestCase):
 
 
 class TestPublicationPolicies(unittest.TestCase):
+    def test_round_telemetry_prefers_last_device_commit(self):
+        from sglang.srt.speculative.online_adaptation_runtime import (
+            OnlineCohortRuntime,
+        )
+
+        runtime = OnlineCohortRuntime.__new__(OnlineCohortRuntime)
+        runtime.active_round_rows = {}
+        runtime.latest_device_lengths = {"request-a": (torch.tensor(105), 0)}
+        runtime.round = 0
+        runtime.pending_timings = deque()
+        runtime.counters = {"target_calls": 0}
+        runtime.requests = {"request-a": SimpleNamespace(version=0)}
+        runtime.active_version = 0
+        runtime.slot_generation = 0
+        runtime.round_traces = []
+        runtime.round_metrics = torch.full((1, 1, 4), -1, dtype=torch.int64)
+
+        runtime.begin_round(
+            ("request-a",),
+            torch.tensor([112]),
+            allow_publish=False,
+        )
+
+        self.assertEqual(runtime.round_metrics[0, 0, 0].item(), 105)
+
     @staticmethod
     def _runtime(method: str, *, ready: bool, round_index: int):
         from sglang.srt.speculative.online_adaptation_runtime import (
@@ -1888,10 +1913,25 @@ class TestCudaFixedAddress(unittest.TestCase):
             accepted_drafts=torch.tensor([4, 5], device="cuda"),
             committed_tokens=torch.tensor([5, 6], device="cuda"),
         )
+        runtime.record_device_commit(
+            ("r0", "r1"), torch.tensor([105, 206], device="cuda")
+        )
+        runtime.begin_round(
+            ("r0", "r1"),
+            # A speculative physical prefix may exceed the logical commit.
+            torch.tensor([112, 219], device="cuda"),
+        )
+        runtime.record_round_outcome(
+            ("r0", "r1"),
+            verified_drafts=torch.tensor([15, 15], device="cuda"),
+            accepted_drafts=torch.tensor([0, 0], device="cuda"),
+            committed_tokens=torch.tensor([0, 0], device="cuda"),
+        )
         rounds = runtime.diagnostics()["rounds"]
-        self.assertEqual(len(rounds), 1)
+        self.assertEqual(len(rounds), 2)
         self.assertEqual(rounds[0]["prefix_len_before"], [100, 200])
         self.assertEqual(rounds[0]["accepted_drafts"], [4, 5])
+        self.assertEqual(rounds[1]["prefix_len_before"], [105, 206])
 
 
 if __name__ == "__main__":
-- 
2.55.0

