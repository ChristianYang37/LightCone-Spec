+    def test_dflash_rope_reuses_inference_cache(self):
+        from sglang.srt.speculative.dflash_online_adaptation import _rope
+
+        value = torch.tensor(
+            [[[1.0, 2.0, 3.0, 4.0]], [[-2.0, 1.0, 0.5, -0.25]]],
+            dtype=torch.bfloat16,
+        )
+        positions = torch.tensor([1, 3], dtype=torch.int64)
+        cache = torch.tensor(
+            [
+                [1.0, 1.0, 0.0, 0.0],
+                [0.5, 0.25, 0.75, -0.5],
+                [1.0, 1.0, 0.0, 0.0],
+                [-0.25, 0.5, 1.0, 0.125],
+            ],
+            dtype=torch.float32,
+        )
+        selected = cache.index_select(0, positions)
+        cosine, sine = selected.chunk(2, dim=-1)
+        left, right = value.float().chunk(2, dim=-1)
+        reference = torch.cat(
+            (
+                left * cosine[:, None] - right * sine[:, None],
+                right * cosine[:, None] + left * sine[:, None],
+            ),
+            dim=-1,
+        ).to(value.dtype)
+        actual = _rope(value, positions, cos_sin_cache=cache)
+        self.assertTrue(torch.equal(actual, reference))
