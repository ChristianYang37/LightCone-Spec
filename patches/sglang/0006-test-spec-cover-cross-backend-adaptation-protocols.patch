+class TestFunctionalOptimizerAndBank(unittest.TestCase):
+    def test_full_vocab_training_scratch_is_conservative_and_validated(self):
+        self.assertEqual(
+            estimate_full_vocab_training_scratch_bytes(
+                batch_tokens=48 * 15, vocab_size=151936
+            ),
+            48 * 15 * 151936 * 32,
+        )
+        with self.assertRaisesRegex(ValueError, "must be positive"):
+            estimate_full_vocab_training_scratch_bytes(
+                batch_tokens=0, vocab_size=151936
+            )
+
+    def test_candidate_scratch_tracks_actual_optimizer_state(self):
+        matrix = torch.zeros((2, 2), dtype=torch.float32)
+        vector = torch.zeros(3, dtype=torch.float32)
+        optimizer = ResidentOptimizer(
+            (matrix, vector),
+            OnlineOptimizerConfig(
+                "muon",
+                0.02,
+                0.01,
+                0.9,
+                0.999,
+                1e-8,
+                1.0,
+                momentum=0.95,
+                muon_ns_steps=5,
+                muon_auxiliary_learning_rate=1e-3,
+                muon_auxiliary_weight_decay=0.01,
+            ),
+        )
+        master = sum(tensor.nbytes for tensor in optimizer.master)
+        moments = sum(tensor.nbytes for tensor in optimizer.first + optimizer.second)
+        self.assertEqual(
+            estimate_functional_optimizer_scratch_bytes(
+                optimizer,
+                merge_bytes=123,
+            ),
+            master + 2 * (master + moments) + 123,
+        )
+        with self.assertRaisesRegex(ValueError, "cannot be negative"):
+            estimate_functional_optimizer_scratch_bytes(
+                optimizer,
+                merge_bytes=-1,
+            )
+
+    def test_tts_and_first_ready_start_from_identical_candidate(self):
+        optimizer_config = OnlineOptimizerConfig(
+            "adam", 0.1, 0.0, 0.9, 0.999, 1e-8, 1.0
+        )
+        left = ResidentOptimizer((torch.tensor([1.0]),), optimizer_config)
+        right = ResidentOptimizer((torch.tensor([1.0]),), optimizer_config)
+        gradient = (torch.tensor([0.25]),)
+        left_proposal = left.propose(gradient)
+        right_proposal = right.propose(gradient)
+        torch.testing.assert_close(
+            left_proposal.parameters[0], right_proposal.parameters[0]
+        )
+
+    def test_adamw_proposal_is_immutable_until_commit(self):
+        parameter = torch.tensor([1.0, -2.0])
+        optimizer = ResidentOptimizer(
+            (parameter,),
+            OnlineOptimizerConfig("adamw", 0.1, 0.01, 0.9, 0.999, 1e-8, 1.0),
+        )
+        proposal = optimizer.propose((torch.tensor([0.25, -0.5]),))
+        torch.testing.assert_close(optimizer.master[0], torch.tensor([1.0, -2.0]))
+        self.assertEqual(optimizer.step, 0)
+        optimizer.commit(proposal)
+        self.assertEqual(optimizer.step, 1)
+        self.assertFalse(torch.equal(optimizer.master[0], parameter))
+
+    def test_sgdm_and_nag_match_torch(self):
+        for name, nesterov in (("sgdm", False), ("nag", True)):
+            initial = torch.tensor([1.0, -2.0])
+            gradient = torch.tensor([0.25, -0.5])
+            config = OnlineOptimizerConfig(
+                name,
+                0.1,
+                0.01,
+                0.9,
+                0.999,
+                1e-8,
+                10.0,
+                momentum=0.9,
+            )
+            ours = ResidentOptimizer((initial,), config)
+            proposal = ours.propose((gradient,))
+            reference = torch.nn.Parameter(initial.clone())
+            reference.grad = gradient.clone()
+            torch.optim.SGD(
+                (reference,),
+                lr=0.1,
+                momentum=0.9,
+                weight_decay=0.01,
+                nesterov=nesterov,
+            ).step()
+            with self.subTest(name=name):
+                torch.testing.assert_close(proposal.parameters[0], reference.detach())
+
+    def test_lion_matches_sign_update_and_uses_one_state_tensor(self):
+        parameter = torch.tensor([1.0, -2.0])
+        gradient = torch.tensor([0.25, -0.5])
+        config = OnlineOptimizerConfig("lion", 0.1, 0.01, 0.9, 0.99, 1e-8, 10.0)
+        optimizer = ResidentOptimizer((parameter,), config)
+        proposal = optimizer.propose((gradient,))
+        expected = parameter * 0.999 - 0.1 * gradient.sign()
+        torch.testing.assert_close(proposal.parameters[0], expected)
+        self.assertEqual(optimizer.first[0].numel(), parameter.numel())
+        self.assertEqual(optimizer.second[0].numel(), 0)
+
+    def test_muon_matrix_and_auxiliary_paths_are_state_light(self):
+        matrix = torch.tensor([[1.0, -2.0], [0.5, 3.0]])
+        vector = torch.tensor([1.0, -1.0])
+        matrix_grad = torch.tensor([[0.2, -0.3], [0.4, 0.1]])
+        vector_grad = torch.tensor([0.25, -0.5])
+        config = OnlineOptimizerConfig(
+            "muon",
+            0.02,
+            0.01,
+            0.9,
+            0.999,
+            1e-8,
+            10.0,
+            momentum=0.95,
+            muon_ns_steps=5,
+            muon_auxiliary_learning_rate=0.001,
+            muon_auxiliary_weight_decay=0.02,
+        )
+        optimizer = ResidentOptimizer((matrix, vector), config)
+        proposal = optimizer.propose((matrix_grad, vector_grad))
+        momentum = 0.05 * matrix_grad
+        nesterov = 0.05 * matrix_grad + 0.95 * momentum
+        direction = zeroth_power_newton_schulz(nesterov, steps=5, epsilon=1e-7)
+        expected_matrix = matrix * (1 - 0.02 * 0.01) - 0.02 * direction
+        torch.testing.assert_close(proposal.parameters[0], expected_matrix)
+        self.assertEqual(optimizer.second[0].numel(), 0)
+        self.assertEqual(optimizer.second[1].numel(), vector.numel())
+        self.assertTrue(torch.isfinite(proposal.parameters[1]).all())
+
+    def test_invalid_candidate_does_not_advance_optimizer_state(self):
+        optimizer = ResidentOptimizer(
+            (torch.tensor([1.0, -2.0]),),
+            OnlineOptimizerConfig("adam", 0.1, 0.0, 0.9, 0.999, 1e-8, 1.0),
+        )
+        proposal = optimizer.propose((torch.tensor([0.25, -0.5]),))
+        before = tuple(
+            value.clone()
+            for value in optimizer.master + optimizer.first + optimizer.second
+        )
+        optimizer.commit(proposal, valid=torch.tensor(False))
+        self.assertEqual(optimizer.step, 0)
+        for actual, expected in zip(
+            optimizer.master + optimizer.first + optimizer.second,
+            before,
+            strict=True,
+        ):
+            torch.testing.assert_close(actual, expected)
+
+    def test_fixed_bank_preserves_addresses(self):
+        active = torch.zeros(4)
+        bank = FixedInferenceBank((active,))
+        address = active.data_ptr()
+        bank.stage((torch.ones(4),))
+        bank.publish()
+        self.assertEqual(active.data_ptr(), address)
+        torch.testing.assert_close(active, torch.ones(4))
+
+    def test_reset_clears_moments_without_replacing_storage(self):
+        parameter = torch.tensor([1.0, 2.0])
+        optimizer = ResidentOptimizer(
+            (parameter,),
+            OnlineOptimizerConfig("adam", 0.1, 0.0, 0.9, 0.999, 1e-8, 1.0),
+        )
+        address = optimizer.master[0].data_ptr()
+        optimizer.commit(optimizer.propose((torch.ones(2),)))
+        optimizer.reset((torch.tensor([3.0, 4.0]),))
+        self.assertEqual(optimizer.master[0].data_ptr(), address)
+        self.assertEqual(optimizer.step, 0)
+        torch.testing.assert_close(optimizer.first[0], torch.zeros(2))
+        torch.testing.assert_close(optimizer.second[0], torch.zeros(2))
+        self.assertEqual(len(optimizer.metadata_tensors), 1)
+        self.assertEqual(optimizer.metadata_tensors[0].numel(), 1)
+        expected_state = (
+            optimizer.master
+            + optimizer.first
+            + optimizer.second
+            + optimizer.metadata_tensors
+        )
+        self.assertEqual(
+            [id(tensor) for tensor in optimizer.state_tensors],
+            [id(tensor) for tensor in expected_state],
+        )
+
+    def test_invalid_candidate_accounting_is_idempotent(self):
+        from sglang.srt.speculative.online_adaptation_runtime import (
+            OnlineCohortRuntime,
+            UpdateTrace,
+        )
+
+        runtime = OnlineCohortRuntime.__new__(OnlineCohortRuntime)
+        runtime.counters = {
+            "updates_discarded": 0,
+            "nonfinite_updates": 0,
+            "exactness_violations": 0,
+            "fallbacks": 0,
+        }
+        runtime.disabled_reason = None
+        runtime.pending = SimpleNamespace(trace_index=0)
+        trace = UpdateTrace(0, 1, 0, ("request-a",), 1)
+        runtime._record_invalid_candidate(
+            trace, finite_ok=True, reconstruction_ok=False
+        )
+        runtime._record_invalid_candidate(
+            trace, finite_ok=True, reconstruction_ok=False
+        )
+        self.assertEqual(runtime.counters["updates_discarded"], 1)
+        self.assertEqual(runtime.counters["exactness_violations"], 1)
+        self.assertEqual(runtime.counters["fallbacks"], 1)
+        self.assertIsNone(runtime.pending)
+        self.assertEqual(runtime.disabled_reason, "logit_reconstruction_mismatch")
+
