+    def test_onlinespec_ogd_proposal_is_transactional(self):
+        config = OnlineAdaptationConfig.load(
+            _write_config(_online_config("onlinespec_ogd", projection_radius=1.0))
+        )
+        optimizer = OnlineSpecOptimizer((torch.tensor([0.0, 0.0]),), config)
+        proposal = optimizer.propose((torch.tensor([6.0, 8.0]),))
+        torch.testing.assert_close(proposal.parameters[0], torch.tensor([-0.6, -0.8]))
+        torch.testing.assert_close(optimizer.master[0], torch.zeros(2))
+        optimizer.commit(proposal)
+        torch.testing.assert_close(optimizer.master[0], torch.tensor([-0.6, -0.8]))
+
+    def test_onlinespec_reuses_adapter_reset_snapshot_as_projection_origin(self):
+        config = OnlineAdaptationConfig.load(
+            _write_config(_online_config("onlinespec_ogd", projection_radius=1.0))
+        )
+        reset_snapshot = torch.tensor([1.0, -1.0])
+        optimizer = OnlineSpecOptimizer(
+            (reset_snapshot,),
+            config,
+            projection_origin=(reset_snapshot,),
+        )
+        self.assertEqual(optimizer.initial[0].data_ptr(), reset_snapshot.data_ptr())
+        self.assertNotIn(
+            reset_snapshot.data_ptr(),
+            {tensor.data_ptr() for tensor in optimizer.state_tensors},
+        )
+        proposal = optimizer.propose((torch.tensor([10.0, 0.0]),))
+        distance = (proposal.parameters[0] - reset_snapshot).norm()
+        self.assertLessEqual(float(distance), 1.0 + 1e-6)
+
+    def test_onlinespec_optimistic_uses_two_projected_states(self):
+        config = OnlineAdaptationConfig.load(
+            _write_config(_online_config("onlinespec_opt", projection_radius=1.0))
+        )
+        optimizer = OnlineSpecOptimizer((torch.tensor([0.0]),), config)
+        optimizer.commit(optimizer.propose((torch.tensor([20.0]),)))
+        torch.testing.assert_close(optimizer.master[0], torch.tensor([-1.0]))
+        diagnostics = optimizer.diagnostics()
+        self.assertEqual(diagnostics["algorithm"], "onlinespec_opt")
+        self.assertEqual(diagnostics["step"], 1)
+        self.assertEqual(diagnostics["hint_norm"], 20.0)
+        second = optimizer.propose((torch.tensor([-5.0]),))
+        torch.testing.assert_close(second.parameters[0], torch.tensor([0.0]))
+        # Applying the unconstrained 2g_t-g_(t-1) shortcut after projection
+        # would instead land at the positive boundary.
+        shortcut = torch.clamp(
+            optimizer.master[0] - 0.1 * (2 * torch.tensor([-5.0]) - 20.0),
+            -1.0,
+            1.0,
+        )
+        torch.testing.assert_close(shortcut, torch.tensor([1.0]))
+
+    def test_onlinespec_hedge_keeps_experts_independent(self):
+        config = OnlineAdaptationConfig.load(
+            _write_config(
+                _online_config(
+                    "onlinespec_ens",
+                    additional_learning_rates=[0.2],
+                    hedge_learning_rate=1.0,
+                )
+            )
+        )
+        optimizer = OnlineSpecOptimizer((torch.tensor([0.0]),), config)
+        proposal = optimizer.propose_ensemble(
+            torch.tensor([0.0, 2.0]),
+            ((torch.tensor([1.0]),), (torch.tensor([-1.0]),)),
+        )
+        probabilities = torch.softmax(torch.tensor([0.0, -2.0]), dim=0)
+        expected = probabilities[0] * -0.1 + probabilities[1] * 0.2
+        torch.testing.assert_close(proposal.parameters[0], expected.reshape(1))
