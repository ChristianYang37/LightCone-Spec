+def _config_value(**overrides):
+    value = {
+        "schema_version": 2,
+        "method": "tts",
+        "algorithm": "DFLASH",
+        "weight_update_mode": "lora",
+        "parameter_scope": "drafter",
+        "kv_history_policy": "frozen",
+        "adaptation_scope": "cohort",
+        "adaptation_group_id": "study-a",
+        "tenant_id": "tenant-a",
+        "optimizer": {
+            "name": "adamw",
+            "learning_rate": 1e-5,
+            "weight_decay": 0.01,
+            "beta1": 0.9,
+            "beta2": 0.999,
+            "epsilon": 1e-8,
+            "grad_clip": 1.0,
+            "momentum": None,
+            "muon_ns_steps": None,
+            "muon_auxiliary_learning_rate": None,
+            "muon_auxiliary_weight_decay": None,
+        },
+        "rank": 8,
+        "stride": 10,
+        "max_in_flight": 1,
+        "canvas_tokens": 16,
+        "loss_position_decay": 1.0,
+        "target_revision": "b" * 40,
+        "drafter_revision": "c" * 40,
+        "sampling_profile_sha256": "a" * 64,
+        "telemetry_detail": "headline",
+    }
+    value.update(overrides)
+    return value
+
+
+def _write_config(value) -> str:
+    directory = tempfile.mkdtemp(prefix="sglang-online-adaptation-")
+    path = Path(directory) / "config.json"
+    path.write_text(json.dumps(value), encoding="utf-8")
+    return str(path)
+
+
+def _online_config(method, **learner_overrides):
+    value = _config_value(
+        method=method,
+        weight_update_mode="full",
+        parameter_scope="tail",
+        rank=None,
+    )
+    value["optimizer"].update(
+        name="sgd",
+        learning_rate=0.1,
+        weight_decay=0.0,
+        grad_clip=100.0,
+    )
+    learner = {
+        "projection_radius": None,
+        "additional_learning_rates": [],
+        "hedge_learning_rate": None,
+    }
+    learner.update(learner_overrides)
+    value["online_spec"] = learner
+    return value
+
+
+def _server_args(config_path=None, **overrides):
+    value = {
+        "speculative_adaptation_config": config_path,
+        "speculative_adaptation_reserve_mb": 0 if config_path is None else 1024,
+        "speculative_adaptation_telemetry_path": None,
+        "speculative_speed_study_metrics": config_path is not None,
+        "speculative_algorithm": "DFLASH",
+        "speculative_draft_model_quantization": None,
+        "kv_cache_dtype": "auto",
+        "enable_two_batch_overlap": False,
+        "enable_pdmux": False,
+        "speculative_accept_threshold_single": 1.0,
+        "speculative_accept_threshold_acc": 1.0,
+        "speculative_use_rejection_sampling": config_path is not None,
+        "speculative_eagle_topk": 1,
+        "speculative_num_steps": 15,
+        "speculative_num_draft_tokens": 16,
+        "speculative_adaptive": False,
+        "enable_multi_layer_eagle": False,
+        "speculative_token_map": None,
+        "tp_size": 1,
+        "dp_size": 1,
+    }
+    value.update(overrides)
+    return SimpleNamespace(**value)
