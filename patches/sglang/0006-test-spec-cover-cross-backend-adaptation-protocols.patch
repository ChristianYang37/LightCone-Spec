+            "lion": {"beta2": 0.99, "weight_decay": 0.01},
+            "muon": {
+                "momentum": 0.95,
+                "muon_ns_steps": 5,
+                "muon_auxiliary_learning_rate": 1e-5,
+                "muon_auxiliary_weight_decay": 0.01,
+                "weight_decay": 0.01,
+            },
+        }
+        for name, updates in variants.items():
+            value = _config_value()
+            value["optimizer"].update(name=name, learning_rate=1e-3, **updates)
+            with self.subTest(name=name):
+                loaded = OnlineAdaptationConfig.load(_write_config(value))
+                self.assertEqual(loaded.optimizer.name, name)
