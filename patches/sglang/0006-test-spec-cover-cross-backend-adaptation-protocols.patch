+class TestFunctionalOptimizerAndBank(unittest.TestCase):
+    def test_full_vocab_training_scratch_is_conservative_and_validated(self):
+        self.assertEqual(
+            estimate_full_vocab_training_scratch_bytes(
+                batch_tokens=48 * 15, vocab_size=151936
+            ),
+            48 * 15 * 151936 * 32,
+        )
+        with self.assertRaisesRegex(ValueError, "must be positive"):
+            estimate_full_vocab_training_scratch_bytes(
+                batch_tokens=0, vocab_size=151936
+            )
+
+    def test_candidate_scratch_tracks_actual_optimizer_state(self):
+        matrix = torch.zeros((2, 2), dtype=torch.float32)
+        vector = torch.zeros(3, dtype=torch.float32)
+        optimizer = ResidentOptimizer(
+            (matrix, vector),
+            OnlineOptimizerConfig(
+                "muon",
+                0.02,
+                0.01,
+                0.9,
+                0.999,
+                1e-8,
+                1.0,
+                momentum=0.95,
+                muon_ns_steps=5,
+                muon_auxiliary_learning_rate=1e-3,
+                muon_auxiliary_weight_decay=0.01,
+            ),
+        )
+        master = sum(tensor.nbytes for tensor in optimizer.master)
+        moments = sum(tensor.nbytes for tensor in optimizer.first + optimizer.second)
+        self.assertEqual(
+            estimate_functional_optimizer_scratch_bytes(
+                optimizer,
+                merge_bytes=123,
+            ),
+            master + 2 * (master + moments) + 123,
+        )
+        with self.assertRaisesRegex(ValueError, "cannot be negative"):
+            estimate_functional_optimizer_scratch_bytes(
+                optimizer,
+                merge_bytes=-1,
+            )
+
+    def test_memory_ledger_does_not_double_count_projection_origin(self):
+        from sglang.srt.speculative.online_adaptation_runtime import (
+            OnlineCohortRuntime,
+        )
+
+        runtime = OnlineCohortRuntime.__new__(OnlineCohortRuntime)
+        runtime.reserve_bytes = 1024
+        projection_origin = torch.zeros(2, dtype=torch.float32)
+        master = torch.zeros(2, dtype=torch.float32)
+        online_state = torch.zeros(2, dtype=torch.float32)
+        runtime.bind_memory(
+            resident_tensors=(projection_origin, master, online_state),
+            peak_scratch_bytes=master.nbytes,
+            trainable_tensors=(master,),
+            categories={
+                "active_or_base_bytes": projection_origin.nbytes,
+                "master_fp32_bytes": master.nbytes,
+                "gradient_bytes": master.nbytes,
+                "first_moment_bytes": 0,
+                "second_moment_bytes": 0,
+                "online_state_bytes": online_state.nbytes,
+                "optimizer_metadata_bytes": 0,
+                "staging_bytes": 0,
+                "training_activation_bytes": 0,
+                "kv_gather_scratch_bytes": 0,
+                "candidate_scratch_bytes": 0,
+                "graph_buffer_bytes": 0,
+                "telemetry_bytes": 0,
+            },
+        )
+        self.assertEqual(runtime.optimizer_bytes, master.nbytes + online_state.nbytes)
+        self.assertEqual(
+            runtime.memory_ledger["active_or_base_bytes"], projection_origin.nbytes
+        )
+        self.assertEqual(
+            runtime.memory_ledger["optimizer_bytes"], runtime.optimizer_bytes
+        )
+
