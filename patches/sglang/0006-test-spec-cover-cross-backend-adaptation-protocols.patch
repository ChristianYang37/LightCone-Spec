+class TestOnlineAdaptationConfig(unittest.TestCase):
+    def test_strict_schema_and_normalized_modes(self):
+        value = _config_value()
+        loaded = OnlineAdaptationConfig.load(_write_config(value))
+        self.assertEqual(loaded.method, "tts")
+        self.assertEqual(loaded.weight_update_mode, "lora")
+        self.assertEqual(loaded.parameter_scope, "drafter")
+        canonical = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+        self.assertEqual(loaded.sha256, hashlib.sha256(canonical).hexdigest())
+
+    def test_unknown_method_and_legacy_schema_fail_closed(self):
+        for update in (
+            {"method": "unsupported_method_a"},
+            {"method": "unsupported_method_b"},
+            {"schema_version": 1},
+        ):
+            with self.subTest(update=update), self.assertRaises(ValueError):
+                OnlineAdaptationConfig.load(_write_config(_config_value(**update)))
+
+    def test_rejects_zero_depth_canvas(self):
+        with self.assertRaisesRegex(ValueError, "at least two"):
+            OnlineAdaptationConfig.load(_write_config(_config_value(canvas_tokens=1)))
+
+    def test_revisions_and_optimizer_values_are_immutable_and_finite(self):
+        with self.assertRaisesRegex(ValueError, "immutable Git SHA"):
+            OnlineAdaptationConfig.load(
+                _write_config(_config_value(target_revision="main"))
+            )
+        value = _config_value()
+        value["optimizer"]["learning_rate"] = float("nan")
+        with self.assertRaisesRegex(ValueError, "finite"):
+            OnlineAdaptationConfig.load(_write_config(value))
+
+    def test_extended_optimizer_fields_are_strict_and_canonical(self):
+        variants = {
