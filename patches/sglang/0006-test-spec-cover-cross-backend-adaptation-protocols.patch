+    def test_dspark_retains_actual_q_and_adapter_free_logits(self):
+        from sglang.srt.speculative.dspark_components.dspark_proposal import (
+            DraftBlockResult,
+            bind_tail_proposal_logits,
+            compute_dspark_projection,
+        )
+
+        actual = torch.tensor([[[1.5, -0.5], [0.25, 0.75]]])
+        offset = torch.tensor([[[0.5, 0.25], [-0.25, 0.5]]])
+        original = DraftBlockResult(
+            draft_tokens=torch.tensor([[0, 1]]),
+            corrected_logits=actual,
+            greedy_mask=torch.tensor([True]),
+            temperatures=torch.tensor([1.0]),
+        )
+        versions = torch.tensor([3], dtype=torch.int64)
+        bound = bind_tail_proposal_logits(original, offset, versions)
+        torch.testing.assert_close(bound.corrected_logits, actual)
+        torch.testing.assert_close(bound.raw_logits + offset, actual)
+        torch.testing.assert_close(bound.source_adapter_version, versions)
+        with self.assertRaisesRegex(ValueError, "must match"):
+            bind_tail_proposal_logits(original, offset[:, :1], versions)
+        with self.assertRaisesRegex(ValueError, "source versions"):
+            bind_tail_proposal_logits(
+                original,
+                offset,
+                torch.tensor([3], dtype=torch.int32),
