+    def test_eagle_blocks_publication_until_every_pinned_proposal_is_verified(self):
+        from sglang.srt.speculative.online_eagle_adaptation import (
+            OnlineEagleAdapter,
+        )
+
+        class Runtime:
+            def __init__(self):
+                self.active_version = 7
+                self.disabled_reason = None
+                self.counters = {"version_mismatches": 0}
+                self.disable_calls = []
+
+            def reserve_update(self):
+                return None
+
+            def disable(self, reason, *, exactness=False):
+                self.disable_calls.append((reason, exactness))
+
+        class Tail:
+            def __init__(self):
+                self.runtime = Runtime()
+                self.begin_calls = []
+
+            def begin_round(self, batch, *, allow_publish=True):
+                self.begin_calls.append(
+                    (tuple(req.rid for req in batch.reqs), allow_publish)
+                )
+                return (self.runtime.active_version,) * len(batch.reqs)
+
+        adapter = OnlineEagleAdapter.__new__(OnlineEagleAdapter)
+        adapter.tail = Tail()
+        adapter.outstanding = {}
+        adapter.capture = {}
+        adapter.capture_binding = None
+        adapter.capture_owners = set()
+        adapter.current_request_ids = ()
+
+        def batch(request_id):
+            return SimpleNamespace(
+                reqs=(SimpleNamespace(rid=request_id),),
+                seq_lens=torch.tensor([4], dtype=torch.int64),
+            )
+
+        first = batch("request-a")
+        versions = adapter.begin_next_round(first)
+        torch.testing.assert_close(versions, torch.tensor([7], dtype=torch.int64))
+        self.assertEqual(adapter.tail.begin_calls[-1][1], True)
+        adapter.assert_pinned(first, versions)
+
+        second = batch("request-b")
+        adapter.begin_next_round(second)
+        self.assertEqual(adapter.tail.begin_calls[-1][1], False)
+        with self.assertRaisesRegex(RuntimeError, "replace unverified"):
+            adapter.begin_next_round(first)
+
+        adapter.tail.runtime.active_version = 8
+        with self.assertRaisesRegex(RuntimeError, "no longer resident"):
+            adapter.assert_pinned(first, versions)
+        self.assertEqual(adapter.tail.runtime.counters["version_mismatches"], 1)
+        self.assertEqual(
+            adapter.tail.runtime.disable_calls,
+            [("eagle_source_version_conflict", True)],
+        )
