+        self.assertFalse(master.requires_grad)
+        self.assertFalse(loss.requires_grad)
+        torch.testing.assert_close(loss, torch.tensor(13.0))
+        torch.testing.assert_close(gradients[0], torch.tensor([4.0, -6.0]))
