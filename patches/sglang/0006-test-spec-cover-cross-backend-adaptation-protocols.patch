+def _config_value(**overrides):
+    value = {
+        "schema_version": 2,
+        "method": "tts",
+        "algorithm": "DFLASH",
+        "weight_update_mode": "lora",
+        "parameter_scope": "drafter",
+        "kv_history_policy": "frozen",
+        "adaptation_scope": "cohort",
+        "adaptation_group_id": "study-a",
+        "tenant_id": "tenant-a",
+        "optimizer": {
+            "name": "adamw",
+            "learning_rate": 1e-5,
+            "weight_decay": 0.01,
+            "beta1": 0.9,
+            "beta2": 0.999,
+            "epsilon": 1e-8,
+            "grad_clip": 1.0,
+            "momentum": None,
+            "muon_ns_steps": None,
+            "muon_auxiliary_learning_rate": None,
+            "muon_auxiliary_weight_decay": None,
+        },
+        "rank": 8,
+        "stride": 10,
+        "max_in_flight": 1,
+        "canvas_tokens": 16,
