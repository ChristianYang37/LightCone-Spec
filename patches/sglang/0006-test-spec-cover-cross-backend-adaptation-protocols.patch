+class TestSemanticValidMask(unittest.TestCase):
+    def test_rejection_terminal_and_request_boundary(self):
+        proposals = torch.tensor([[5, 9, 7, 8], [1, 2, 3, 4], [6, 7, 8, 9]])
+        mask = semantic_valid_mask(
+            proposal_tokens=proposals,
+            correct_len=torch.tensor([3, 1, 4]),
+            remaining_output_tokens=[4, 4, 2],
+            terminal_token_ids=[(9,), (), ()],
+            ignore_eos=[False, False, False],
+        )
+        torch.testing.assert_close(
+            mask,
+            torch.tensor(
+                [
+                    [True, True, False, False],
+                    [True, True, False, False],
+                    [True, True, False, False],
+                ]
+            ),
+            rtol=0,
+            atol=0,
+        )
+
+    def test_all_accepted_and_ignored_terminal_remain_valid(self):
+        mask = semantic_valid_mask(
+            proposal_tokens=torch.tensor([[2, 2, 2]]),
+            correct_len=torch.tensor([3]),
+            remaining_output_tokens=[3],
+            terminal_token_ids=[(2,)],
+            ignore_eos=[True],
+        )
+        self.assertTrue(bool(mask.all()))
+
+    def test_outcome_lengths_respect_terminal_bonus_and_request_boundary(self):
+        accepted, committed = semantic_outcome_lengths(
+            proposal_tokens=torch.tensor([[4, 9, 7, 8], [1, 2, 3, 4], [5, 6, 7, 8]]),
+            correct_len=torch.tensor([4, 3, 4]),
+            bonus_tokens=torch.tensor([6, 9, 2]),
+            remaining_output_tokens=[8, 4, 2],
+            terminal_token_ids=[(9,), (9,), ()],
+            ignore_eos=[False, False, False],
+        )
+        torch.testing.assert_close(accepted, torch.tensor([2, 3, 2]))
+        torch.testing.assert_close(committed, torch.tensor([2, 4, 2]))
+
