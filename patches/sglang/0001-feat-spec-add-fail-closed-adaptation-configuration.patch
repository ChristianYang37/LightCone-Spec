+def _preflight_dflash_adaptation_fallback(server_args: ServerArgs) -> bool:
+    """Route unsupported explicitly configured stochastic DFlash to target-only.
+
+    Returns true only when the speculative service arguments were cleared.
+    Greedy execution never imports or requires the stochastic verification
+    kernel.  Static experiments are covered too: silently substituting greedy
+    DFlash would invalidate paired sampling just as surely as for adaptation.
+    Unsafe heuristic thresholds remain a configuration error instead of being
+    hidden by fallback.
+    """
+
+    config_path = getattr(server_args, "speculative_adaptation_config", None)
+    backend = str(getattr(server_args, "speculative_algorithm", None) or "")
+    if not config_path or backend.upper() != "DFLASH":
+        return False
+
+    from lightcone_spec.config.loader import load_adaptation_config
+
+    config = load_adaptation_config(config_path)
+    if (
+        config.method != "static"
+        and getattr(config, "parameter_scope", "tail") != "tail"
+    ):
+        raise ValueError(
+            "Live speculative adaptation currently certifies only "
+            "parameter_scope=tail. Full-drafter/all-parameter and allowlisted "
+            "updates mutate cached draft states and must run through the "
+            "cache-rebuild reference path until a cache-validating SGLang "
+            "runtime is implemented."
+        )
+
+    threshold_single = float(server_args.speculative_accept_threshold_single)
+    threshold_acc = float(server_args.speculative_accept_threshold_acc)
+    if threshold_single != 1.0 or threshold_acc != 1.0:
+        raise ValueError(
+            "DFLASH tail adaptation requires "
+            "speculative_accept_threshold_single=1.0 and "
+            "speculative_accept_threshold_acc=1.0; heuristic thresholds "
+            "cannot be used as an exactness fallback."
+        )
+    if float(config.sampling.temperature) <= 0.0:
+        return False
+
+    from sglang.srt.speculative.dflash_utils import (
+        is_dflash_sampling_verify_available,
+    )
+
+    if is_dflash_sampling_verify_available():
+        return False
+
+    reason = "dflash_exact_stochastic_sampling_kernel_unavailable"
+    fields = {
+        "speculative_algorithm": None,
+        "speculative_draft_model_path": None,
+        "speculative_draft_model_revision": None,
+        "speculative_adaptation_config": None,
+        "speculative_adaptation_reserve_mb": 0,
+        "dspark_adaptation_config": None,
+        "dspark_adaptation_reserve_mb": 0,
+        "speculative_adaptation_fallback_reason": reason,
+    }
+    override = getattr(server_args, "override", None)
+    if callable(override):
+        override("lightcone.dflash_target_only_fallback", **fields)
+    else:
+        for name, value in fields.items():
+            setattr(server_args, name, value)
+    logger.warning(
+        "Explicit stochastic DFLASH requested, but this build/device lacks the "
+        "exact target-only verification kernel. Starting a target-only service "
+        "instead (fallback_reason=%s); greedy DFLASH was not substituted.",
+        reason,
+    )
+    return True
+
+
+def _validate_speculative_adaptation_before_model_load(
+    server_args: ServerArgs,
+) -> None:
+    """Fail closed on adaptation/backend combinations before loading weights.
+
+    Keep the native path deliberately cold: without an explicit config this
+    function performs one attribute read and imports neither LightCone nor any
+    speculative worker/kernel module.
+    """
+    config_path = getattr(server_args, "speculative_adaptation_config", None)
+    if not config_path:
+        return
+
+    from lightcone_spec.config.loader import load_adaptation_config
+    from lightcone_spec.config.schema import CONTROLLER_METHODS, MODEL_PAIRS
+
+    config = load_adaptation_config(config_path)
+    if (
+        config.method != "static"
+        and getattr(config, "parameter_scope", "tail") != "tail"
+    ):
+        raise ValueError(
+            "Live speculative adaptation currently certifies only "
+            "parameter_scope=tail. Full-drafter/all-parameter and allowlisted "
+            "updates mutate cached draft states and must run through the "
+            "cache-rebuild reference path until a cache-validating SGLang "
+            "runtime is implemented."
+        )
+    pair_id = config.model.pair_id
+    pair = MODEL_PAIRS.get(pair_id)
+    if pair is None:
+        raise ValueError(
+            "Live speculative tail adaptation requires a registered model pair; "
+            f"got {pair_id!r}. toy_* pairs are replay-only."
+        )
+    configured_backend = str(pair["speculative_algorithm"]).upper()
+    runtime_backend = str(server_args.speculative_algorithm or "NONE").upper()
+    if configured_backend != runtime_backend:
+        raise ValueError(
+            "Speculative adaptation model/backend mismatch before model load: "
+            f"pair {pair_id!r} requires {configured_backend}, but the server "
+            f"resolved {runtime_backend}."
+        )
+
+    from lightcone_spec.sglang_bridge.static_observer import (
+        evidence_only_static_bypass,
+    )
+
+    bypass, _bypass_reason = evidence_only_static_bypass(config)
+    if config.method in CONTROLLER_METHODS and config.method != "lc_gate":
+        from lightcone_spec.controller.artifact import (
+            load_bound_controller_artifact,
+        )
+        from lightcone_spec.methods.registry import validate_controller_artifact
+
+        # Resolve migration aliases sequentially.  Supplying
+        # ``config.weight_update_mode`` as getattr's default would evaluate it
+        # eagerly and break older/minimal config objects even when the
+        # canonical tail layout is already present.
+        layout_mode = getattr(config, "tail_layout_mode", None)
+        if layout_mode is None:
+            layout_mode = getattr(config, "weight_update_mode", None)
+        if layout_mode is None:
+            layout_mode = getattr(
+                config, "trainable_scope", "output_residual"
+            )
+        artifact = load_bound_controller_artifact(
+            config.controller.artifact_path,
+            model_pair_id=config.model.pair_id,
+            weight_update_mode=layout_mode,
+        )
+        validate_controller_artifact(config, artifact)
+    if bypass:
+        # Native Static and a certified constant-discard L1 do not instantiate
+        # a tail manager, so tail-only EAGLE/DFLASH restrictions do not apply.
+        return
+
+    # The live manager owns one mutable batch lifecycle (pinned versions,
+    # proposal evidence and telemetry-event lanes) and one CUDA side stream.
+    # TBO can interleave two child batches through that lifecycle; PDMux runs
+    # model work in CUDA green contexts whose event/stream ownership has not
+    # been certified for the adaptation stream.  Continuing would risk binding
+    # a teacher snapshot to another batch or context, so reject the combination
+    # before either model is loaded.  Evidence-only Static keeps the native
+    # backend path above and remains compatible.
+    generic_tail_backend = runtime_backend in ("DFLASH", "EAGLE", "EAGLE3")
+    if generic_tail_backend and bool(
+        getattr(server_args, "enable_two_batch_overlap", False)
+    ):
+        raise ValueError(
+            "Live speculative adaptation does not support "
+            "--enable-two-batch-overlap: its version/supervision lifecycle is "
+            "single-batch until TBO child ownership is implemented."
+        )
+    if generic_tail_backend and bool(getattr(server_args, "enable_pdmux", False)):
+        raise ValueError(
+            "Live speculative adaptation does not support --enable-pdmux: "
+            "adaptation CUDA events and the side stream are not certified "
+            "across PD-Multiplexing green contexts."
+        )
+
+    stochastic = float(config.sampling.temperature) > 0.0
+    if stochastic:
+        # Tail reconstruction currently models a full-vocabulary p/q pair.  A
+        # truncated request distribution needs the exact renormalized p carried
+        # in TeacherSignal; accepting a server default here would silently train
+        # on another objective after weights are loaded.
+        preferred = getattr(server_args, "preferred_sampling_params", None)
+        if isinstance(preferred, str):
+            preferred = json.loads(preferred)
+        if isinstance(preferred, dict):
+            from sglang.srt.sampling.sampling_params import TOP_K_ALL
+
+            top_p = float(preferred.get("top_p", 1.0))
+            top_k = int(preferred.get("top_k", TOP_K_ALL))
+            min_p = float(preferred.get("min_p", 0.0))
+            if top_p != 1.0 or top_k != TOP_K_ALL or min_p != 0.0:
+                raise ValueError(
+                    "Stochastic speculative tail adaptation currently requires "
+                    "a full-vocabulary sampling profile before model load: "
+                    f"top_p=1.0, top_k={TOP_K_ALL}, min_p=0.0; got "
+                    f"top_p={top_p}, top_k={top_k}, min_p={min_p}."
+                )
+
+    if runtime_backend in ("EAGLE", "EAGLE3"):
+        if bool(getattr(server_args, "enable_dp_attention", False)):
+            raise ValueError(
+                "EAGLE tail adaptation does not yet support DP attention; "
+                "the draft-head TP collective group has not been certified."
+            )
+        if int(server_args.speculative_eagle_topk) != 1:
+            raise ValueError(
+                "EAGLE tail adaptation currently supports only topk=1 chains; "
+                f"got topk={server_args.speculative_eagle_topk}."
+            )
+        if bool(getattr(server_args, "enable_multi_layer_eagle", False)):
+            raise ValueError(
+                "EAGLE tail adaptation currently supports only the single-layer "
+                "worker; --enable-multi-layer-eagle is unsupported."
+            )
+        if (
+            stochastic
+            and not server_args.speculative_use_rejection_sampling
+        ):
+            raise ValueError(
+                "Stochastic EAGLE tail adaptation requires "
+                "--speculative-use-rejection-sampling so the corrected full-vocab "
+                "proposal q is used by exact target verification."
+            )
+
+    if runtime_backend == "DFLASH":
+        if int(server_args.speculative_num_draft_tokens) < 2:
+            raise ValueError(
+                "DFLASH tail adaptation requires block_size >= 2 so at least "
+                "one draft token exists."
+            )
+        if (
+            float(server_args.speculative_accept_threshold_single) != 1.0
+            or float(server_args.speculative_accept_threshold_acc) != 1.0
+        ):
+            raise ValueError(
+                "DFLASH tail adaptation requires both speculative acceptance "
+                "thresholds to equal 1.0."
+            )
+
 
 def _handle_dflash(server_args: ServerArgs) -> None:
     from sglang.srt.arg_groups.overrides import resolved_view
