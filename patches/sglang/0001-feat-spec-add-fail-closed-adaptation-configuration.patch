+def speculative_semantic_valid_mask(
+    *,
+    proposal_token_ids: torch.Tensor,
+    base_valid_mask: torch.Tensor,
+    correct_len: torch.Tensor,
+    bonus: torch.Tensor,
+    remaining_output_tokens: Sequence[int] | torch.Tensor,
+    terminal_token_ids: Sequence[Sequence[int]],
+    ignore_eos: Sequence[bool],
+    backend: str,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Mask verified supervision outside the request's output semantics.
+
+    The full verified window remains useful counterfactual evidence, including
+    a rejected terminal token.  Only the output budget, an accepted terminal
+    proposal, or a terminal target bonus censors later proposal positions.
+    Acceptance-dependent work remains on the proposal device.
+    """
+
+    label = str(backend).upper()
+    if proposal_token_ids.ndim != 2:
+        raise ValueError(f"{label} proposal_token_ids must be rank two")
+    if base_valid_mask.shape != proposal_token_ids.shape:
+        raise ValueError(f"{label} base valid mask must match proposal tokens")
+    batch_size, depth = proposal_token_ids.shape
+    if correct_len.shape != (batch_size,) or bonus.shape != (batch_size,):
+        raise ValueError(f"{label} acceptance tensors must have one value per request")
+    if len(terminal_token_ids) != len(ignore_eos) or len(ignore_eos) != batch_size:
+        raise ValueError(f"{label} semantic metadata must match batch size")
+
+    positions = torch.arange(
+        depth, dtype=correct_len.dtype, device=proposal_token_ids.device
+    )
+    remaining = torch.as_tensor(
+        remaining_output_tokens,
+        dtype=correct_len.dtype,
+        device=proposal_token_ids.device,
+    ).reshape(-1)
+    if remaining.shape != (batch_size,):
+        raise ValueError(f"{label} remaining-token budget must match batch size")
+    remaining = remaining.clamp_min(0)
+    mask = base_valid_mask & positions.unsqueeze(0).lt(remaining.unsqueeze(1))
+    censored = correct_len.to(remaining.dtype).add(1).gt(remaining)
+    for index in range(batch_size):
+        row = mask[index]
+        stops = tuple(int(token) for token in terminal_token_ids[index])
+        if not bool(ignore_eos[index]) and stops:
+            proposal_stop = torch.zeros(
+                depth, dtype=torch.bool, device=proposal_token_ids.device
+            )
+            bonus_stop = torch.zeros(
+                (), dtype=torch.bool, device=proposal_token_ids.device
+            )
+            for token in stops:
+                proposal_stop |= proposal_token_ids[index].eq(token)
+                bonus_stop |= bonus[index].eq(token)
+
+            accepted_stop = proposal_stop & positions.lt(correct_len[index])
+            accepted_stop_i32 = accepted_stop.to(torch.int32)
+            seen_before = accepted_stop_i32.cumsum(0) - accepted_stop_i32
+            row &= seen_before.eq(0)
+            row &= (~bonus_stop) | positions.lt(correct_len[index])
+            censored[index] |= accepted_stop.any() | bonus_stop
+        mask[index] = row
+    return mask, censored
+
+
+def resolve_request_rng_metadata(
+    reqs, sampling_info=None
+) -> tuple[tuple[int | None, ...], tuple[bool, ...]]:
+    """Resolve optional per-request RNG metadata without assuming full requests.
+
+    Reduced scheduler/test batches may omit ``sampling_params`` (or only its
+    ``top_k`` field).  In that case the batch-wide greedy flag is the most
+    precise information available; absent batch metadata keeps the observer's
+    historical greedy default.  Complete requests still retain their own
+    seed/top-k values.
+    """
+
+    batch_greedy = getattr(sampling_info, "is_all_greedy", True)
+    if callable(batch_greedy):
+        batch_greedy = batch_greedy()
+    batch_greedy = bool(batch_greedy)
+
+    sampling_seeds = []
+    greedy_flags = []
+    for req in reqs:
+        params = getattr(req, "sampling_params", None)
+        seed = getattr(params, "sampling_seed", None)
+        sampling_seeds.append(None if seed is None else int(seed))
+        top_k = getattr(params, "top_k", None)
+        greedy_flags.append(batch_greedy if top_k is None else int(top_k) <= 1)
+    return tuple(sampling_seeds), tuple(greedy_flags)
+
