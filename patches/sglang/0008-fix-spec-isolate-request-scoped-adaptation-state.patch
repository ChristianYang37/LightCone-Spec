+def formal_rank_publication_hook_provider(
+    authority: NativeRuntimeAuthority,
+) -> RankPublicationHook:
+    """Return the production NCCL all-rank publication decision hook."""
+
+    if (
+        type(authority) is not NativeRuntimeAuthority
+        or authority.topology_mode != "tp2_dp1"
+        or authority.qualification_only
+    ):
+        raise TypeError("formal TP2 hook requires non-qualification authority")
+
+    def publish(value: RankPrepare) -> AllRankPublicationReceipt:
+        import torch.distributed as dist
+
+        if (
+            not dist.is_available()
+            or not dist.is_initialized()
+            or dist.get_backend() != "nccl"
+            or dist.get_world_size() != 2
+            or dist.get_rank() != value.rank
+        ):
+            raise RuntimeError("formal TP2 hook requires exact NCCL ranks")
+        gathered: list[RankPrepare | None] = [None, None]
+        dist.all_gather_object(gathered, value)
+        if any(type(row) is not RankPrepare for row in gathered):
+            raise RuntimeError("formal TP2 prepare coverage differs")
+        first, second = gathered
+        assert type(first) is RankPrepare and type(second) is RankPrepare
+        same = (
+            first.rank == 0
+            and second.rank == 1
+            and first.source_version == second.source_version
+            and first.candidate_sha256 == second.candidate_sha256
+        )
+        committed = same and first.valid and second.valid
+        # No rank may observe the decision and publish until every rank has
+        # submitted the exact prepare row.
+        dist.barrier()
+        return AllRankPublicationReceipt(
+            topology_sha256=authority.topology_sha256,
+            source_version=first.source_version,
+            candidate_sha256=first.candidate_sha256,
+            rank_terminal_sha256s=(
+                first.terminal_sha256,
+                second.terminal_sha256,
+            ),
+            decision="COMMITTED" if committed else "ABORTED",
+            published_ranks=(0, 1) if committed else (),
+            reason_code=(
+                None
+                if committed
+                else "one_or_more_rank_prepares_invalid_or_inconsistent"
+            ),
+        )
+
+    return publish
