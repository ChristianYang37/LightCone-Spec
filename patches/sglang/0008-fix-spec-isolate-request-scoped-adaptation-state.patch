+        updates_by_request.setdefault(key, []).append(
+            {
+                field: item
+                for field, item in row.items()
+                if field
+                not in {
+                    "update_index",
+                    "reset_scope",
+                    "request_reset_receipt_sha256",
+                    "cohort_sha256",
+                    "cohort_epoch",
+                    "parameter_layout_sha256",
+                    "update_sha256",
+                }
+            }
+        )
+    rounds_by_request: dict[tuple[int, str], list[dict[str, object]]] = {}
+    for row in round_rows:
+        if not isinstance(row, dict):
+            raise TypeError("formal gang request archive round is malformed")
+        key = (int(row["request_epoch"]), str(row["request_id"]))
+        if key not in acquired_keys:
+            raise RuntimeError("formal gang round has no acquired reset receipt")
+        if (
+            row.get("reset_scope") != "request"
+            or row.get("request_reset_receipt_sha256")
+            != acquired_receipts[key].get("receipt_sha256")
+        ):
+            raise RuntimeError("formal gang round reset receipt binding differs")
+        rounds_by_request.setdefault(key, []).append(
+            {
+                "request_epoch": key[0],
+                "round_index": row["round_index"],
+                "source_version": row["proposal_source_version"],
+                "request_ids": [key[1]],
+                "prefix_len_before": [row["prefix_len_before"]],
+                "verify_len": [row["verify_len"]],
+                "accepted_drafts": [row["accepted_drafts"]],
+                "committed_tokens": [row["committed_tokens"]],
+            }
+        )
