+def _assert_reset_then_admit(adapter: _Adapter, request_id: str) -> None:
+    acquired = [event for event in _events if event == ("acquired", request_id)]
+    terminals = [event for event in _events if event == ("terminal", request_id)]
+    if len(acquired) != 1 or len(terminals) != 1:
+        raise AssertionError(f"request terminal coverage differs: {_events}")
+    if _events.index(acquired[0]) > _events.index(terminals[0]):
+        raise AssertionError("terminal evidence preceded source reset")
+    adapter.admit_request(f"next-after-{request_id}")
