+    def _request_scoped_adaptation_adapter(self):
+        adapter = self._terminal_adapter()
+        if (
+            adapter is None
+            or adapter.config.reset_scope != "request"
+            or adapter.config.request_admission_policy
+            != "serialized_native_scheduler_v1"
+        ):
+            return None
+        return adapter
+
+    def _request_scoped_prefill_blocked(self, running_batch) -> bool:
+        """Keep offered requests queued until the current owner is reset."""
+
+        adapter = self._request_scoped_adaptation_adapter()
+        if adapter is None:
+            return False
+        scheduler_active_ids = {
+            req.rid
+            for batch in (running_batch, self.last_batch)
+            if batch is not None
+            for req in batch.reqs
+            if not req.finished()
+        }
+        chunked_id = None
+        if self.chunked_req is not None and not self.chunked_req.finished():
+            chunked_id = self.chunked_req.rid
+            scheduler_active_ids.add(chunked_id)
+        active_ids = set(scheduler_active_ids)
+        owner = adapter.runtime.active_request_id
+        if owner is not None:
+            active_ids.add(owner)
+        if len(active_ids) > 1:
+            raise RuntimeError(
+                "request-scoped adaptation observed concurrent scheduler owners"
+            )
+        if chunked_id is not None:
+            if active_ids != {chunked_id}:
+                raise RuntimeError("chunked request differs from adaptation owner")
+            return False
+        if (
+            owner is not None
+            and not scheduler_active_ids
+            and any(req.rid == owner for req in self.waiting_queue)
+        ):
+            # A retracted owner may resume its own prefill. Its mutable state
+            # remains exclusive; every other offered request stays queued.
+            return False
+        return bool(active_ids)
+
+    def _terminalize_queued_or_owned_request(
+        self, req: Req, *, sticky_reason: str | None = None
+    ) -> None:
+        adapter = self._request_scoped_adaptation_adapter()
+        if adapter is not None:
+            if adapter.runtime.active_request_id == req.rid:
+                if sticky_reason is not None:
+                    adapter.runtime.counters["oom_events"] += 1
+                    adapter.runtime.disable(sticky_reason)
+                adapter.abort_request(req.rid)
+            else:
+                adapter.record_unacquired_request_terminal(
+                    req.rid, terminal_outcome="aborted"
+                )
+        if not req.finished():
+            req.finished_reason = FINISH_ABORT()
+        self._record_terminal_request(req)
+
