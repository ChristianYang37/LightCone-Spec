+        if not isinstance(raw, dict):
+            raise TypeError("formal gang request reset receipt is malformed")
+        if raw.get("adaptation_state_acquired") is not True:
+            if raw.get("evidence_archive_sha256") != archive:
+                raise RuntimeError("formal gang unacquired receipt changed archive")
+            continue
