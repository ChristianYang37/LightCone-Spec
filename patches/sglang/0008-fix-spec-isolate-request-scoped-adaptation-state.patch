+        updates = updates_by_request.pop(key, [])
+        rounds = rounds_by_request.pop(key, [])
+        if (
+            raw.get("archived_update_count") != len(updates)
+            or raw.get("archived_round_count") != len(rounds)
+        ):
+            raise RuntimeError("formal gang request archive count differs")
+        terminal_round = max(
+            (int(row["round_index"]) for row in rounds),
+            default=0,
+        )
+        terminal_version = max(
+            (
+                int(row["published_version"])
+                for row in updates
+                if row.get("published_version") is not None
+            ),
+            default=0,
+        )
+        if terminal_round != int(raw["terminal_round"]):
+            raise RuntimeError("formal gang archive terminal round differs")
+        if terminal_version != int(raw["terminal_version"]):
+            raise RuntimeError("formal gang archive terminal version differs")
+        archive = content_sha256(
+            {
+                "schema_version": 1,
+                "previous_archive_sha256": archive,
+                "request_epoch": key[0],
+                "request_id": key[1],
+                "updates": updates,
+                "rounds": rounds,
+            }
+        )
+        if raw.get("evidence_archive_sha256") != archive:
+            raise RuntimeError("formal gang request archive replay digest differs")
+    if updates_by_request or rounds_by_request:
+        raise RuntimeError("formal gang request archive row coverage differs")
+    if reset_envelope.get("final_archive_sha256") != archive:
+        raise RuntimeError("formal gang final request archive digest differs")
