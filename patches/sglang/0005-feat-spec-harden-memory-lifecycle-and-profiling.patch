+def _logit_reconstruction_gate(
+    inference_logits: torch.Tensor,
+    differentiable_logits: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    if inference_logits.shape != differentiable_logits.shape:
+        raise ValueError("DFlash reconstruction logit shapes differ")
+    inference = inference_logits.detach().to(torch.float32)
+    reconstructed = differentiable_logits.detach().to(torch.float32)
+    maximum = (reconstructed - inference).abs().max()
+    limit = 2e-3 + 2e-3 * inference.abs().max()
+    valid = (
+        torch.isfinite(maximum)
+        & torch.isfinite(limit)
+        & (maximum <= limit)
+    )
+    return valid, maximum
