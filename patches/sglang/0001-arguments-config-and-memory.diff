diff --git a/python/sglang/srt/speculative/online_adaptation_config.py b/python/sglang/srt/speculative/online_adaptation_config.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/speculative/online_adaptation_config.py
@@ -0,0 +1,241 @@
+"""Small JSON configuration for online speculative adaptation."""
+
+from __future__ import annotations
+
+import json
+import math
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+LORA_RANKS = (1, 2, 4, 8, 16, 32, 64)
+LAYER_SCOPES = ("last1", "last3", "last5", "all", "last1_native_heads", "last3_native_heads", "last5_native_heads")
+DSPARK_HYBRID_SCOPES = ("last1_native_heads", "last3_native_heads", "last5_native_heads")
+BACKEND_ADAPTATION_CAPABILITIES = {
+    "DFLASH": "native_layers",
+    "DSPARK": "native_heads",
+    "EAGLE3": "selector",
+    "NEXTN": "native_mtp",
+}
+TEACHER_ROW_ACQUISITION_CAPABILITIES = {
+    name: "verification_rows" for name in BACKEND_ADAPTATION_CAPABILITIES
+}
+
+
+def _mapping(value: object, name: str) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise TypeError(f"{name} must be an object")
+    return {str(key): item for key, item in value.items()}
+
+
+def _finite(value: object, name: str) -> float:
+    result = float(value)
+    if not math.isfinite(result):
+        raise ValueError(f"{name} must be finite")
+    return result
+
+
+@dataclass(frozen=True)
+class OnlineOptimizerConfig:
+    name: str
+    learning_rate: float
+    weight_decay: float
+    beta1: float
+    beta2: float
+    epsilon: float
+    grad_clip: float
+    momentum: float | None = None
+    muon_ns_steps: int | None = None
+    muon_auxiliary_learning_rate: float | None = None
+    muon_auxiliary_weight_decay: float | None = None
+    schedule: str = "constant"
+    schedule_total_published_updates: int | None = None
+
+
+@dataclass(frozen=True)
+class OnlineSpecLearnerConfig:
+    projection_radius: float | None
+    additional_learning_rates: tuple[float, ...]
+    hedge_learning_rate: float | None
+
+
+@dataclass(frozen=True)
+class TopologyConfig:
+    tensor_parallel_size: int
+    data_parallel_size: int
+
+
+@dataclass(frozen=True)
+class OnlineAdaptationConfig:
+    method: str
+    algorithm: str
+    weight_update_mode: str
+    parameter_scope: str
+    optimizer: OnlineOptimizerConfig
+    rank: int | None
+    lora_alpha: int | None
+    stride: int
+    canvas_tokens: int
+    loss_position_decay: float
+    extra_logical_delay: int
+    teacher_row_policy: str
+    verification_mode: str
+    topology: TopologyConfig
+    online_spec: OnlineSpecLearnerConfig | None
+    adaptation_group_id: str
+    telemetry_detail: str
+    seed: int
+    controlled_candidate_replay: bool
+    reset_scope: str
+    fixed_total_token_budget: int | None
+    adaptation_microbatch_size: int = 1
+    update_coalescing: int = 1
+    stream_priority: str = "default"
+    confidence_loss_weight: float = 0.1
+    lora_matrix_policy: str = "linear_weights"
+    native_head_policy: str = "include_for_hybrid_scope"
+    failure_injection: str | None = None
+
+    @classmethod
+    def load(
+        cls, path: str | Path, *, tp_size: int = 1, dp_size: int = 1
+    ) -> OnlineAdaptationConfig:
+        value = _mapping(json.loads(Path(path).read_text(encoding="utf-8")), "adaptation")
+        method = str(value.get("method", "l0"))
+        if method not in {"tts", "l0", "onlinespec_ogd", "onlinespec_opt", "onlinespec_ens"}:
+            raise ValueError(f"unsupported adaptation method {method}")
+        algorithm = str(value.get("algorithm", "")).upper()
+        if algorithm not in BACKEND_ADAPTATION_CAPABILITIES:
+            raise ValueError(f"unsupported adaptation backend {algorithm}")
+        mode = str(value.get("weight_update_mode", "lora"))
+        if mode not in {"full", "lora"}:
+            raise ValueError("weight_update_mode must be full or lora")
+        scope = str(value.get("parameter_scope", "all"))
+        if scope not in LAYER_SCOPES:
+            raise ValueError(f"unsupported parameter scope {scope}")
+        rank = value.get("rank")
+        if mode == "lora":
+            rank = int(rank)
+            if rank not in LORA_RANKS:
+                raise ValueError("unsupported LoRA rank")
+        else:
+            rank = None
+        raw = _mapping(value.get("optimizer", {}), "optimizer")
+        optimizer = OnlineOptimizerConfig(
+            name=str(raw.get("name", "adam")),
+            learning_rate=_finite(raw.get("learning_rate", 1e-3), "learning_rate"),
+            weight_decay=_finite(raw.get("weight_decay", 0.0), "weight_decay"),
+            beta1=_finite(raw.get("beta1", 0.9), "beta1"),
+            beta2=_finite(raw.get("beta2", 0.999), "beta2"),
+            epsilon=_finite(raw.get("epsilon", 1e-8), "epsilon"),
+            grad_clip=_finite(raw.get("grad_clip", 1.0), "grad_clip"),
+            momentum=None if raw.get("momentum") is None else _finite(raw["momentum"], "momentum"),
+            muon_ns_steps=raw.get("muon_ns_steps"),
+            muon_auxiliary_learning_rate=raw.get("muon_auxiliary_learning_rate"),
+            muon_auxiliary_weight_decay=raw.get("muon_auxiliary_weight_decay"),
+            schedule=str(raw.get("schedule", "constant")),
+            schedule_total_published_updates=raw.get("schedule_total_published_updates"),
+        )
+        if optimizer.learning_rate <= 0 or optimizer.epsilon <= 0 or optimizer.grad_clip < 0:
+            raise ValueError(
+                "optimizer learning rate and epsilon must be positive; clipping cannot be negative"
+            )
+        if optimizer.weight_decay < 0 or not 0 < optimizer.beta1 < 1 or not 0 < optimizer.beta2 < 1:
+            raise ValueError("optimizer decay and beta values are invalid")
+        online_raw = value.get("online_spec")
+        online_spec = None
+        if online_raw is not None:
+            online = _mapping(online_raw, "online_spec")
+            online_spec = OnlineSpecLearnerConfig(
+                projection_radius=online.get("projection_radius"),
+                additional_learning_rates=tuple(float(item) for item in online.get("additional_learning_rates", ())),
+                hedge_learning_rate=online.get("hedge_learning_rate"),
+            )
+        stride = int(value.get("stride", 10))
+        canvas = int(value.get("canvas_tokens", 16))
+        microbatch = int(value.get("adaptation_microbatch_size", 1))
+        coalescing = int(value.get("update_coalescing", 1))
+        stream_priority = str(value.get("stream_priority", "default"))
+        confidence_weight = _finite(
+            value.get("confidence_loss_weight", 0.1), "confidence_loss_weight"
+        )
+        if stride < 1 or canvas < 1 or microbatch < 1 or coalescing < 1:
+            raise ValueError(
+                "stride, canvas_tokens, and adaptation_microbatch_size must be positive"
+            )
+        if confidence_weight < 0:
+            raise ValueError("confidence_loss_weight cannot be negative")
+        if stream_priority not in {"default", "high"}:
+            raise ValueError("stream_priority must be default or high")
+        reset_scope = str(value.get("reset_scope", "cohort"))
+        if reset_scope not in {"cohort", "request"}:
+            raise ValueError("reset_scope must be cohort or request")
+        fixed_budget = value.get("fixed_total_token_budget")
+        if fixed_budget is not None and (
+            not isinstance(fixed_budget, int) or fixed_budget < 1
+        ):
+            raise ValueError("fixed_total_token_budget must be a positive integer")
+        if (tp_size, dp_size) not in {(1, 1), (2, 1), (1, 2)}:
+            raise ValueError("online adaptation supports TP1, TP2, and two TP1 replicas")
+        return cls(
+            method=method,
+            algorithm=algorithm,
+            weight_update_mode=mode,
+            parameter_scope=scope,
+            optimizer=optimizer,
+            rank=rank,
+            lora_alpha=None if rank is None else int(value.get("lora_alpha", rank)),
+            stride=stride,
+            canvas_tokens=canvas,
+            loss_position_decay=_finite(value.get("loss_position_decay", 1.0), "loss_position_decay"),
+            extra_logical_delay=int(value.get("extra_logical_delay", 0)),
+            teacher_row_policy=str(value.get("teacher_row_policy", "verification_rows")),
+            verification_mode=str(value.get("verification_mode", "native_scheduler")),
+            topology=TopologyConfig(tp_size, dp_size),
+            online_spec=online_spec,
+            adaptation_group_id=str(value.get("adaptation_group_id", "default")),
+            telemetry_detail=str(value.get("telemetry_detail", "headline")),
+            seed=int(value.get("seed", 0)),
+            controlled_candidate_replay=bool(value.get("controlled_candidate_replay", False)),
+            reset_scope=reset_scope,
+            fixed_total_token_budget=fixed_budget,
+            adaptation_microbatch_size=microbatch,
+            update_coalescing=coalescing,
+            stream_priority=stream_priority,
+            confidence_loss_weight=confidence_weight,
+            failure_injection=value.get("failure_injection"),
+        )
+
+
+def load_online_adaptation(server_args) -> OnlineAdaptationConfig | None:
+    path = getattr(server_args, "speculative_adaptation_config", None)
+    if not path:
+        return None
+    return OnlineAdaptationConfig.load(
+        path,
+        tp_size=int(getattr(server_args, "tp_size", 1)),
+        dp_size=int(getattr(server_args, "dp_size", 1)),
+    )
+
+
+def validate_online_adaptation(server_args) -> None:
+    config = load_online_adaptation(server_args)
+    reserve_mb = int(getattr(server_args, "speculative_adaptation_reserve_mb", 0))
+    if reserve_mb < 0:
+        raise ValueError("speculative_adaptation_reserve_mb cannot be negative")
+    if config is None:
+        if reserve_mb or getattr(server_args, "speculative_adaptation_telemetry_path", None):
+            raise ValueError("adaptation reserve and telemetry require an adaptation config")
+        return
+    if not bool(getattr(server_args, "speculative_speed_study_metrics", False)):
+        raise ValueError("online adaptation requires speed-study metrics")
+    backend = str(getattr(server_args, "speculative_algorithm", "") or "").upper()
+    if backend != config.algorithm:
+        raise ValueError(f"adaptation backend mismatch: {config.algorithm} != {backend}")
+    width = int(getattr(server_args, "speculative_num_draft_tokens", 0) or 0)
+    if config.canvas_tokens != width:
+        raise ValueError("canvas_tokens must equal speculative_num_draft_tokens")
+    if reserve_mb <= 0:
+        raise ValueError("online adaptation requires a positive HBM reserve")
+    if not bool(getattr(server_args, "speculative_use_rejection_sampling", False)):
+        raise ValueError("online adaptation requires exact rejection sampling")
diff --git a/python/sglang/srt/speculative/online_parameter_plan.py b/python/sglang/srt/speculative/online_parameter_plan.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/speculative/online_parameter_plan.py
@@ -0,0 +1,186 @@
+"""Backend-native, deterministic LightCone trainable-parameter selectors."""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterable
+from dataclasses import dataclass
+
+import torch
+from sglang.srt.speculative.online_adaptation_config import (
+    DSPARK_HYBRID_SCOPES,
+    LAYER_SCOPES,
+    OnlineAdaptationConfig,
+)
+
+_LAYER = re.compile(r"(?:^|\.)layers\.(\d+)(?:\.|$)")
+_LORA_MATRIX = re.compile(
+    r"(?:^|\.)(?:fc|q_proj|k_proj|v_proj|qkv_proj|o_proj|gate_proj|"
+    r"gate_up_proj|up_proj|down_proj)\.weight$"
+)
+_BORROWED = frozenset({"embed_tokens", "lm_head", "target_model"})
+_DSPARK_W1 = re.compile(r"(?:^|\.)markov_head\.markov_w1\.weight$")
+_DSPARK_W2 = re.compile(r"(?:^|\.)markov_head\.markov_w2\.weight$")
+_DSPARK_ACCEPTANCE = re.compile(r"(?:^|\.)confidence_head\.proj\.(?:weight|bias)$")
+
+
+@dataclass(frozen=True)
+class ParameterSelection:
+    algorithm: str
+    scope: str
+    mode: str
+    selected_names: tuple[str, ...]
+    lora_names: tuple[str, ...]
+    full_names: tuple[str, ...]
+    frozen_names: tuple[str, ...]
+    native_head_names: tuple[str, ...]
+
+
+def _canonical_items(
+    named_parameters: Iterable[tuple[str, torch.Tensor]],
+) -> tuple[tuple[str, torch.Tensor], ...]:
+    rows = []
+    seen = set()
+    for raw_name, parameter in named_parameters:
+        name = raw_name.removeprefix("model.")
+        if name in seen:
+            raise ValueError(f"duplicate canonical parameter name: {name}")
+        seen.add(name)
+        rows.append((name, parameter))
+    if not rows:
+        raise ValueError("backend exposes no parameters")
+    return tuple(sorted(rows, key=lambda row: row[0]))
+
+
+def _selected_layers(
+    rows: tuple[tuple[str, torch.Tensor], ...], scope: str
+) -> frozenset[int]:
+    indices = sorted(
+        {
+            int(match.group(1))
+            for name, _ in rows
+            if (match := _LAYER.search(name)) is not None
+        }
+    )
+    if not indices or indices != list(range(indices[-1] + 1)):
+        raise ValueError("backend layer indices must be contiguous from zero")
+    if scope == "all":
+        return frozenset(indices)
+    count = int(scope.removeprefix("last"))
+    if count > len(indices):
+        raise ValueError(f"parameter scope {scope} exceeds backend depth")
+    return frozenset(indices[-count:])
+
+
+def _owned(name: str) -> bool:
+    return _BORROWED.isdisjoint(name.split("."))
+
+
+def _dspark_heads(rows: tuple[tuple[str, torch.Tensor], ...]) -> tuple[str, ...]:
+    w1 = [name for name, _ in rows if _DSPARK_W1.search(name)]
+    w2 = [name for name, _ in rows if _DSPARK_W2.search(name)]
+    acceptance = [name for name, _ in rows if _DSPARK_ACCEPTANCE.search(name)]
+    if len(w1) != 1 or len(w2) != 1:
+        raise ValueError("DSpark selector requires exact Markov W1 and W2 parameters")
+    acceptance_weights = [name for name in acceptance if name.endswith(".weight")]
+    if len(acceptance_weights) != 1:
+        raise ValueError(
+            "DSpark selector requires one scalar-output acceptance projection"
+        )
+    by_name = dict(rows)
+    w1_weight = by_name[w1[0]]
+    w2_weight = by_name[w2[0]]
+    if (
+        w1_weight.ndim != 2
+        or w2_weight.ndim != 2
+        or w1_weight.shape != w2_weight.shape
+    ):
+        raise ValueError(
+            "DSpark W1 embedding and W2 projection must share [vocab, rank]"
+        )
+    weight = by_name[acceptance_weights[0]]
+    if (
+        weight.ndim != 2
+        or weight.shape[0] != 1
+        or weight.shape[1] <= w1_weight.shape[1]
+    ):
+        raise ValueError(
+            "DSpark acceptance projection must consume hidden plus Markov W1"
+        )
+    acceptance_biases = [name for name in acceptance if name.endswith(".bias")]
+    if len(acceptance_biases) > 1:
+        raise ValueError("DSpark selector permits at most one acceptance bias")
+    if acceptance_biases and by_name[acceptance_biases[0]].shape != (1,):
+        raise ValueError("DSpark acceptance projection bias must be scalar-output")
+    return tuple(sorted((*w1, *w2, *acceptance)))
+
+
+def build_native_parameter_plan(
+    named_parameters: Iterable[tuple[str, torch.Tensor]],
+    config: OnlineAdaptationConfig,
+) -> ParameterSelection:
+    """Select one exact backend layout before allocating optimizer state."""
+    algorithm = config.algorithm
+    if algorithm not in {"DFLASH", "DSPARK", "EAGLE3", "NEXTN"}:
+        raise ValueError(f"{algorithm} has no implemented parameter selector")
+    scope = config.parameter_scope
+    allowed = (
+        {*LAYER_SCOPES, *DSPARK_HYBRID_SCOPES}
+        if algorithm == "DSPARK"
+        else set(LAYER_SCOPES)
+    )
+    if scope not in allowed:
+        raise ValueError(f"unregistered {algorithm} parameter scope")
+    rows = _canonical_items(named_parameters)
+    hybrid = scope in DSPARK_HYBRID_SCOPES
+    layer_scope = scope.removesuffix("_native_heads")
+    layer_ids = _selected_layers(rows, layer_scope)
+    native_heads = _dspark_heads(rows) if algorithm == "DSPARK" else ()
+    native_head_set = frozenset(native_heads)
+    selected: list[str] = []
+    lora: list[str] = []
+    full: list[str] = []
+    frozen: list[str] = []
+    for name, parameter in rows:
+        match = _LAYER.search(name)
+        in_selected_layer = match is not None and int(match.group(1)) in layer_ids
+        eligible = _owned(name) and parameter.is_floating_point() and in_selected_layer
+        parameterization = "full"
+        if config.weight_update_mode == "lora":
+            eligible = (
+                eligible
+                and parameter.ndim == 2
+                and _LORA_MATRIX.search(name) is not None
+            )
+            parameterization = "lora"
+        if hybrid and name in native_head_set:
+            if not parameter.is_floating_point():
+                raise ValueError("DSpark native heads must be floating point")
+            eligible = True
+            parameterization = "full"
+        if eligible:
+            selected.append(name)
+            (lora if parameterization == "lora" else full).append(name)
+        else:
+            frozen.append(name)
+    if not selected:
+        raise ValueError("backend-native parameter selection is empty")
+    selected_set = frozenset(selected)
+    if algorithm == "DSPARK":
+        if hybrid and not native_head_set <= selected_set:
+            raise AssertionError("DSpark hybrid selection lost a native head")
+        if not hybrid and native_head_set & selected_set:
+            raise AssertionError("DSpark layer-only selection changed a native head")
+    return ParameterSelection(
+        algorithm=algorithm,
+        scope=scope,
+        mode=config.weight_update_mode,
+        selected_names=tuple(selected),
+        lora_names=tuple(lora),
+        full_names=tuple(full),
+        frozen_names=tuple(sorted(frozen)),
+        native_head_names=native_heads,
+    )
+
+
+__all__ = ("ParameterSelection", "build_native_parameter_plan")
