+    if allocated_len > row_capacity:
+        raise RuntimeError(
+            f"{algorithm} allocation watermark exceeds req_to_token row capacity: "
+            f"allocated={allocated_len}, capacity={row_capacity}."
+        )
+    if committed_len + verify_len > row_capacity:
