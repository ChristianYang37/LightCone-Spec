+"""LightCone-DSpark test-time adaptation glue (fork side).
+
+Enabled only via ``--dspark-adaptation-config``. Zero-impact contract:
+
+* When the flag is unset, :func:`maybe_build_adaptation_manager` returns
+  ``None`` before importing anything beyond this module's stdlib imports.
+  Every call site in ``DSparkWorkerV2`` is a single ``is not None``
+  attribute check -- no ``lightcone_spec`` import, no allocation, no
+  behavioural change (byte-for-byte upstream parity).
+* When set, the manager lazily imports ``lightcone_spec.sglang_bridge``
+  and drives its ``AdaptationRuntime`` (request-slot adapter bank,
+  side-stream update math with CUDA events, telemetry JSONL) through the
+  seven typed hook boundaries of the DSpark decode round (spec 8.2):
+
+  1. draft inputs ready      -> ``on_draft_inputs_ready``
+  2. proposal ready          -> ``on_proposal_ready``
+  3. verify logits ready     -> ``on_verify_logits_ready``
+  4. acceptance done         -> ``on_acceptance_done``
+  5. round committed         -> ``on_round_committed``
+  6. update poll point       -> ``on_update_poll`` (only legal publish spot)
+  7. request lifecycle       -> ``on_request_lifecycle``
+
+Adapter application points: ``A_d`` modifies base draft logits, ``A_m``
+modifies each real Markov step before sampling, and ``A_c`` modifies the
+confidence logit consumed by the verify planner. Trigger/trace rounds use
+the eager path to retain supervision; other greedy rounds use fixed graph
+buffers so adapter publication is visible without recapture. Verification
+is untouched and accept/reject retains the exact corrected proposal q.
+
+Version-mismatch checks inside the hooks fail closed with
+``ExactnessViolation``; the worker converts that into aborting the
+request with ``failed_exactness`` rather than emitting tokens sampled
+under an inconsistent proposal/parameter version.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import time
+from functools import partial
+from pathlib import Path
+from typing import Optional
+
+import torch
+
+from sglang.srt.speculative.spec_utils import resolve_request_rng_metadata
+
+logger = logging.getLogger(__name__)
+
+
+def _resolve_worker_proposal_depth(worker) -> int:
+    """Read the DSpark proposal width selected by the native worker."""
+
+    depth = getattr(worker, "gamma", None)
+    if depth is None:
+        verify_width = getattr(worker, "verify_num_draft_tokens", None)
+        depth = None if verify_width is None else int(verify_width) - 1
+    if depth is None or int(depth) < 1:
+        raise ValueError(
+            "DSpark adaptation could not resolve a positive proposal depth "
+            "from worker.gamma or worker.verify_num_draft_tokens"
+        )
+    return int(depth)
+
+
+def _tp_rank_identity(worker) -> tuple[str, int, int]:
+    """Resolve one stable TP identity without touching model state."""
+    rank = int(
+        getattr(
+            getattr(worker, "ps", None),
+            "tp_rank",
+            os.environ.get("RANK", os.environ.get("LOCAL_RANK", "0")),
+        )
+    )
+    world_size = int(
+        getattr(
+            getattr(worker, "ps", None),
+            "tp_size",
+            getattr(worker.server_args, "tp_size", 1),
+        )
+    )
+    return str(rank), rank, world_size
+
+
+def maybe_build_adaptation_manager(server_args, worker):
+    """Return a DSparkAdaptationManager iff --dspark-adaptation-config is
+    set; otherwise None without importing lightcone_spec."""
+    path = getattr(server_args, "speculative_adaptation_config", None) or getattr(
+        server_args, "dspark_adaptation_config", None
+    )
+    if not path:
+        return None
+    from lightcone_spec.config.loader import load_adaptation_config
+    from lightcone_spec.sglang_bridge.static_observer import (
+        evidence_only_static_bypass,
+    )
+
+    config = load_adaptation_config(path)
+    bypass, reason = evidence_only_static_bypass(config)
+    if bypass:
+        logger.info(
+            "Using native DSpark with evidence-only telemetry (%s).", reason
+        )
+        return DSparkStaticTelemetryManager(
+            config=config, worker=worker, bypass_reason=reason
+        )
+    return DSparkAdaptationManager(config_path=path, worker=worker)
+
+
+def _resolve_markov_w2(markov_head) -> "torch.Tensor":
+    """DSpark markov head second (vocab-producing) matrix, fail closed."""
+    for name in ("w2", "markov_w2", "fc2", "out_proj", "lm_head"):
+        mod = getattr(markov_head, name, None)
+        if mod is None:
+            continue
+        weight = getattr(mod, "weight", mod if torch.is_tensor(mod) else None)
+        if weight is not None and weight.dim() == 2:
+            return weight
+    raise RuntimeError(
+        "dspark adaptation: could not resolve markov_w2 on "
+        f"{type(markov_head).__name__}; the SVD output basis (spec 5.1) "
+        "requires it. Refusing to run with a random basis (fail closed)."
+    )
+
+
+def _reshape_target_hidden(
+    hidden: "torch.Tensor", *, batch_size: int, hidden_size: int
+) -> "torch.Tensor":
+    """View eager or graph-packed target hidden states as [B, T, H]."""
+    row_size = int(batch_size) * int(hidden_size)
+    if row_size <= 0 or hidden.numel() % row_size:
+        raise RuntimeError(
+            "DSpark target hidden-state shape is incompatible with the "
+            f"locked model: shape={tuple(hidden.shape)}, batch={batch_size}, "
+            f"hidden_size={hidden_size}"
+        )
+    return hidden.reshape(batch_size, -1, hidden_size)
+
+
+class _TensorParallelTailProjection:
+    """Frozen LM-head projection without a replicated global weight copy."""
+
+    def __init__(self, lm_head, *, tp_rank: int, tp_size: int):
+        self.lm_head = lm_head
+        self.weight = lm_head.weight.detach()
+        self.tp_rank = int(tp_rank)
+        self.tp_size = int(tp_size)
+        self.vocab_size = int(
+            getattr(lm_head, "org_vocab_size", self.weight.shape[0])
+        )
+        self.dtype = self.weight.dtype
+        self.device = self.weight.device
+
+    def project_hidden(self, hidden: "torch.Tensor") -> "torch.Tensor":
+        from sglang.srt.models.dspark import gather_and_crop_vocab
+
+        local = hidden.to(self.weight.dtype) @ self.weight.T
+        return gather_and_crop_vocab(local, self.lm_head)
+
+    def backproject_logits(self, logit_grad: "torch.Tensor") -> "torch.Tensor":
+        """Compute grad_logits @ W over sharded vocab, then sum TP shards."""
+        shard = getattr(self.lm_head, "shard_indices", None)
+        start = int(
+            getattr(
+                shard,
+                "padded_org_vocab_start_index",
+                self.tp_rank * self.weight.shape[0],
+            )
+        )
+        count = max(
+            0,
+            min(int(self.weight.shape[0]), self.vocab_size - start),
+        )
+        local = logit_grad[..., start : start + count].to(self.weight.dtype)
+        hidden_grad = local @ self.weight[:count]
+        if self.tp_size > 1:
+            from sglang.srt.distributed.communication_op import (
+                tensor_model_parallel_all_reduce,
+            )
+
+            hidden_grad = tensor_model_parallel_all_reduce(hidden_grad)
+        return hidden_grad
+
+
+class DSparkStaticTelemetryManager:
+    """Thin DSpark protocol adapter over the shared native round observer."""
+
+    @property
+    def folded_graph_adaptation(self):
+        """Static telemetry preserves the native graph sampler unchanged."""
+        return None
+
+    def __init__(self, *, config, worker, bypass_reason=None):
+        from lightcone_spec.sglang_bridge.static_observer import (
+            build_static_speculative_observer,
+            evidence_only_static_bypass,
+        )
+
+        self.config = config
+        self.worker = worker
+        bypass, resolved_reason = evidence_only_static_bypass(config)
+        if not bypass:
+            raise ValueError(
+                "DSparkStaticTelemetryManager requires static or a globally "
+                "constant-discard controller"
+            )
+        if bypass_reason is not None and bypass_reason != resolved_reason:
+            raise ValueError(
+                "static bypass reason disagrees with the validated config: "
+                f"{bypass_reason!r} != {resolved_reason!r}"
+            )
+        bypass_reason = resolved_reason
+        self._observer = build_static_speculative_observer(
+            config=config,
+            server_args=worker.server_args,
+            worker=worker,
+            algorithm="DSPARK",
+            bypass_reason=bypass_reason,
+        )
+        self.telemetry = self._observer.telemetry
+        self._draft_tokens_hint = max(
+            int(
+                getattr(worker, "gamma", 0)
+                or getattr(worker, "verify_num_draft_tokens", 0)
+                or getattr(config.runtime, "speculative_num_draft_tokens", 0)
+            ),
+            1,
+        )
+
+    def begin_requests(self, batch) -> None:
+        del batch
+
+    def finish_request(self, rid: str) -> None:
+        self._observer.finish_request(rid)
+
+    def before_draft(self, batch, prefix_lens) -> None:
+        sampling_seeds, greedy_flags = resolve_request_rng_metadata(
+            batch.reqs, getattr(batch, "sampling_info", None)
+        )
+        self._observer.begin_round(
+            request_ids=tuple(req.rid for req in batch.reqs),
+            sampling_seeds=sampling_seeds,
+            greedy_flags=greedy_flags,
+            prefix_lens=prefix_lens,
+            draft_tokens=self._draft_tokens_hint,
+        )
+
+    def after_proposal(self, batch, proposal) -> None:
+        del batch
+        draft_tokens = int(proposal.draft_block.draft_tokens.shape[1])
+        self._observer.set_draft_tokens(draft_tokens)
+        self._observer.record_stage("draft_end")
+
+    def adapt_confidence(self, *, batch, proposal, confidence):
+        del batch, proposal
+        return confidence, None, None
+
+    def after_verify(self, batch, target_logits, hidden_strided) -> None:
+        del batch, target_logits, hidden_strided
+        self._observer.record_stage("verify_end")
+
+    def after_accept(self, batch, accept, verify_lens=None) -> None:
+        del batch
+        self._observer.after_accept(
+            commit_lens=accept.commit_lens,
+            verify_lens=verify_lens,
+        )
+
+    def maybe_launch_updates(self, batch, target_logits, proposal) -> None:
+        del batch, target_logits, proposal
+
+    def after_commit(self, batch, new_seq_lens) -> None:
+        del batch
+        self._observer.commit_round(new_seq_lens=new_seq_lens)
+
+    def poll_updates(self, batch) -> None:
+        del batch
+
+    def diagnostics(self) -> dict:
+        diagnostics = self._observer.diagnostics()
+        controller_static_fallback = self.config.method == "lc_gate"
+        diagnostics.update(
+            {
+                "fallback_counts": {},
+                "controller_static_fallback": controller_static_fallback,
+                "candidate_generation_bypassed": True,
+            }
+        )
+        return diagnostics
+
+    def close(self) -> None:
+        self._observer.close()
+
+    def __del__(self):
+        try:
+            self.close()
+        except Exception:
+            pass
+
+
+class DSparkAdaptationManager:
+    """Per-worker adaptation front end; one AdaptationRuntime behind it."""
+
+    def __init__(self, *, config_path: str, worker):
+        # Lazy heavy imports: only reached when the flag is set.
+        import numpy as np
+
+        from lightcone_spec.adapters.adapter_params import (
+            HIDDEN_PROJ_DIM,
+            AdapterShapes,
+            parameter_layout_identity,
+            parameter_layout_sha256,
+        )
+        from lightcone_spec.adapters.projections import (
+            build_hidden_projection,
+            build_output_basis,
+            load_projection_artifact,
+            save_projection_artifact,
+        )
+        from lightcone_spec.config.loader import load_adaptation_config
+        from lightcone_spec.config.schema import (
+            MODEL_PAIRS,
+            effective_proposal_depth,
+        )
+        from lightcone_spec.exit_codes import ExactnessViolation
+        from lightcone_spec.methods.registry import build_method
+        from lightcone_spec.sglang_bridge import hooks as H
+        from lightcone_spec.sglang_bridge.bank import (
+            AdaptationCapacityError,
+            estimate_adaptation_memory,
+            resolve_adapter_row_capacity,
+        )
+        from lightcone_spec.sglang_bridge.runtime import AdaptationRuntime
+        from lightcone_spec.sglang_bridge.telemetry import (
+            CudaTelemetryLanePool,
+            TelemetrySink,
+        )
+        from sglang.srt.speculative.tail_adaptation import (
+            tp_gradient_consensus,
+            validate_proposal_depth,
+        )
+
+        self._H = H
+        self._ExactnessViolation = ExactnessViolation
+        self._CapacityError = AdaptationCapacityError
+        self.worker = worker
+        self.config = load_adaptation_config(config_path)
+        self.device = str(worker.device)
+
+        target_model = worker.target_worker.model_runner.model
+        draft_model = worker.draft_model
+        w_lm_tensor = target_model.lm_head.weight.detach()
+        self._forward_dtype = w_lm_tensor.dtype
+        if self._forward_dtype not in (torch.bfloat16, torch.float32):
+            raise RuntimeError(
+                "DSpark tail adaptation requires a certified bf16/fp32 LM head; "
+                f"got {self._forward_dtype}"
+            )
+        w_m2_tensor = _resolve_markov_w2(draft_model.markov_head).detach()
+        d_hidden = int(w_lm_tensor.shape[1])
+        rank = self.config.adapter_rank
+        mode = self.config.tail_layout_mode
+        rank_id, tp_rank, tp_world_size = _tp_rank_identity(worker)
+        self.tp_rank = tp_rank
+        self.tp_size = tp_world_size
+        global_vocab_size = int(
+            getattr(target_model.lm_head, "org_vocab_size", w_lm_tensor.shape[0])
+        )
+        self._r_h = build_hidden_projection(
+            d=d_hidden, m=HIDDEN_PROJ_DIM, seed=0
+        )
+        configured_projection = self.config.model.projection_artifact_path
+        if configured_projection is not None:
+            configured_projection = configured_projection.format(rank=rank_id)
+        projection_path = Path(
+            configured_projection
+            or (
+                Path(self.config.trace.artifact_root)
+                / "projections"
+                / f"{self.config.model.pair_id}-rank{rank}-tp{rank_id}.npz"
+            )
+        )
+        projection_identity = {
+            "schema_version": 1,
+            "pair_id": self.config.model.pair_id,
+            "target_revision": self.config.model.target_revision,
+            "drafter_revision": self.config.model.drafter_revision,
+            "adapter_rank": rank,
+            "tensor_parallel_rank": str(rank_id),
+            "hidden_size": d_hidden,
+            "vocab_size": global_vocab_size,
+            "markov_dim": int(w_m2_tensor.shape[1]),
+        }
+        projection_layout_identity = None
+        if mode != "output_residual":
+            # Tail LoRA/full-rank reuse the frozen vocabulary head in place.
+            # Never construct an FP32/CPU duplicate of a multi-GB model head.
+            basis = _TensorParallelTailProjection(
+                target_model.lm_head,
+                tp_rank=tp_rank,
+                tp_size=tp_world_size,
+            )
+        elif projection_path.is_file():
+            arrays, projection_meta = load_projection_artifact(projection_path)
+            for key, expected in projection_identity.items():
+                actual = projection_meta.get(key)
+                if actual != expected:
+                    raise RuntimeError(
+                        "cached LightCone projection identity mismatch for "
+                        f"{key}: {actual!r} != {expected!r}; delete or rebuild "
+                        f"{projection_path} from the locked model revisions"
+                    )
+            self._r_h = arrays["hidden_projection"].astype(np.float32)
+            basis_np = arrays["output_basis"].astype(np.float32)
+            expected_basis = (global_vocab_size, rank)
+            if self._r_h.shape != (d_hidden, HIDDEN_PROJ_DIM):
+                raise RuntimeError(
+                    "cached hidden projection shape mismatch: "
+                    f"{self._r_h.shape} != {(d_hidden, HIDDEN_PROJ_DIM)}"
+                )
+            if basis_np.shape != expected_basis:
+                raise RuntimeError(
+                    "cached output basis shape mismatch: "
+                    f"{basis_np.shape} != {expected_basis}"
+                )
+            logger.info("loaded cached LightCone projections from %s", projection_path)
+            projection_layout_identity = projection_meta
+            basis = torch.from_numpy(basis_np)
+        else:
+            # One-time deterministic build.  Subsequent workers/runs load the
+            # compact artifact and avoid copying multi-GB model heads to CPU.
+            w_lm_for_basis = w_lm_tensor
+            if tp_world_size > 1:
+                from sglang.srt.distributed.communication_op import (
+                    tensor_model_parallel_all_gather,
+                )
+
+                w_lm_for_basis = tensor_model_parallel_all_gather(
+                    w_lm_for_basis, dim=0
+                )[:global_vocab_size]
+            w_lm = w_lm_for_basis.float().cpu().numpy()
+            w_m2 = w_m2_tensor.float().cpu().numpy()
+            out_basis = build_output_basis(w_lm, w_m2, self._r_h, rank=rank)
+            basis_np = out_basis.basis
+            save_projection_artifact(
+                projection_path,
+                {
+                    "hidden_projection": self._r_h,
+                    "output_basis": basis_np,
+                },
+                {
+                    **projection_identity,
+                    "basis_input_sha256": out_basis.input_sha256,
+                    "basis_sha256": out_basis.sha256(),
+                    "hidden_projection_seed": 0,
+                },
+            )
+            logger.warning(
+                "built LightCone projections once at startup and cached %s; "
+                "pre-create this artifact for latency-sensitive launches",
+                projection_path,
+            )
+            projection_layout_identity = {
+                **projection_identity,
+                "basis_input_sha256": out_basis.input_sha256,
+                "basis_sha256": out_basis.sha256(),
+                "hidden_projection_seed": 0,
+            }
+            basis = torch.from_numpy(basis_np)
+
+        pair = MODEL_PAIRS.get(self.config.model.pair_id)
+        if pair is not None and pair["speculative_algorithm"] != "DSPARK":
+            raise ValueError(
+                "adaptation model/backend mismatch: pair "
+                f"{self.config.model.pair_id!r} declares "
+                f"{pair['speculative_algorithm']}, worker is DSPARK"
+            )
+        draft_depth = _resolve_worker_proposal_depth(worker)
+        if pair is not None:
+            expected_depth = effective_proposal_depth(
+                pair, int(self.config.runtime.speculative_num_draft_tokens)
+            )
+            draft_depth = validate_proposal_depth(
+                actual=draft_depth,
+                declared=int(pair["draft_depth"]),
+                expected=expected_depth,
+                algorithm="DSPARK",
+                pair_id=self.config.model.pair_id,
+            )
+        shapes = AdapterShapes(
+            rank=rank,
+            markov_dim=int(w_m2_tensor.shape[1]),
+            vocab_size=global_vocab_size,
+            weight_update_mode=mode,
+            hidden_size=d_hidden,
+            draft_depth=draft_depth,
+            has_markov=True,
+            has_confidence=True,
+            algorithm="DSPARK",
+        )
+        self.shapes = shapes
+        self.parameter_layout_identity = parameter_layout_identity(
+            shapes,
+            forward_dtype=str(self._forward_dtype),
+            tensor_parallel_rank=rank_id,
+            tensor_parallel_world_size=tp_world_size,
+            target_revision=self.config.model.target_revision,
+            drafter_revision=self.config.model.drafter_revision,
+            projection_identity=projection_layout_identity,
+            head_identity={
+                "module": type(target_model.lm_head).__name__,
+                "local_shape": list(w_lm_tensor.shape),
+                "dtype": str(w_lm_tensor.dtype),
+            },
+            optimizer_identity={
+                "name": self.config.optimizer,
+                "update_contract": "decoupled_adamw_delta_v1",
+                "weight_decay": self.config.weight_decay,
+            },
+        )
+        self.parameter_layout_sha256 = parameter_layout_sha256(
+            self.parameter_layout_identity
+        )
+        num_slots = self.config.runtime.resolved_adaptation_slots()
+        decode_graph = getattr(
+            worker.server_args.cuda_graph_config, "decode", None
+        )
+        adapter_row_capacity = resolve_adapter_row_capacity(
+            max_running_requests=int(
+                worker.server_args.max_running_requests or num_slots
+            ),
+            cuda_graph_max_bs_decode=getattr(decode_graph, "max_bs", None),
+            cuda_graph_batch_sizes=getattr(decode_graph, "bs", ()),
+        )
+        planned_row_capacity = self.config.runtime.adapter_row_capacity
+        if (
+            planned_row_capacity is not None
+            and int(planned_row_capacity) != adapter_row_capacity
+        ):
+            raise ValueError(
+                "DSpark adaptation row-capacity contract changed after pre-KV "
+                f"sizing: planned {planned_row_capacity}, runtime "
+                f"{adapter_row_capacity}"
+            )
+        self.memory_ledger = estimate_adaptation_memory(
+            num_slots=num_slots,
+            max_in_flight=self.config.async_.max_in_flight,
+            num_params=shapes.num_params(),
+            vocab_size=shapes.vocab_size,
+            rank=shapes.rank,
+            markov_dim=shapes.markov_dim,
+            hidden_size=d_hidden,
+            draft_depth=draft_depth,
+            adapter_row_capacity=(
+                adapter_row_capacity if self.config.method != "static" else 0
+            ),
+            with_optimizer=self.config.optimizer == "adamw",
+            with_fisher=self.config.method == "lc_transport",
+            with_optimizer_preview=self.config.method == "lc_transport",
+            retain_source_signal=self.config.method == "onlinespec_ens",
+            trace_capture=self.config.trace.trace_capture_max_bytes > 0,
+            safety_factor=self.config.runtime.memory_safety_factor,
+            calibrated_reserve_mb=self.config.runtime.calibrated_reserve_mb,
+            enabled=self.config.method != "static",
+            weight_update_mode=mode,
+            forward_dtype_bytes=self._forward_dtype.itemsize,
+        )
+        current_reserve = int(
+            getattr(
+                self.worker.server_args,
+                "speculative_adaptation_reserve_mb",
+                getattr(
+                    self.worker.server_args,
+                    "dspark_adaptation_reserve_mb",
+                    0,
+                ),
+            )
+            or 0
+        )
+        self.worker.server_args.override(
+            "lightcone.adaptation_memory",
+            speculative_adaptation_reserve_mb=max(
+                current_reserve, self.memory_ledger.reserve_mb
+            ),
+        )
+        ledger_path = (
+            Path(self.config.trace.artifact_root)
+            / f"adaptation-memory-p{os.getpid()}-r{rank_id}.json"
+        )
+        ledger_path.parent.mkdir(parents=True, exist_ok=True)
+        ledger_path.write_text(
+            json.dumps(
+                {
+                    "schema_version": 1,
+                    "fixed_bytes": self.memory_ledger.fixed_bytes,
+                    "transient_bytes": self.memory_ledger.transient_bytes,
+                    "calibrated_bytes": self.memory_ledger.calibrated_bytes,
+                    "reserve_bytes": self.memory_ledger.reserve_bytes,
+                    "reserve_mb": self.memory_ledger.reserve_mb,
+                    "num_slots": num_slots,
+                    "max_in_flight": self.config.async_.max_in_flight,
+                    "num_params": shapes.num_params(),
+                    "adapter_row_capacity": self.memory_ledger.adapter_row_capacity,
+                    "weight_update_mode": self.config.weight_update_mode,
+                    "parameter_scope": self.config.parameter_scope,
+                    "tail_layout_mode": mode,
+                    "resolved_rank": self.config.effective_adapter_rank,
+                    "parameter_layout_sha256": self.parameter_layout_sha256,
+                    "parameter_layout_identity": self.parameter_layout_identity,
+                    "categories": self.memory_ledger.category_bytes(),
+                },
+                sort_keys=True,
+            )
+            + "\n"
+        )
+        telemetry_path = self.config.trace.telemetry_path or (
+            f"{self.config.trace.artifact_root.rstrip('/')}/"
+            f"adaptation-telemetry-p{os.getpid()}-r{rank_id}.jsonl"
+        )
+        artifact = None
+        if self.config.controller.artifact_path is not None:
+            from lightcone_spec.controller.artifact import ControllerArtifact
+
+            artifact = ControllerArtifact.load(self.config.controller.artifact_path)
+        self._controller_static_fallback = bool(
+            self.config.method == "lc_gate"
+            and artifact is not None
+            and artifact.gate_discard_all
+        )
+        planned_delay = 1 + self.config.async_.logical_delay_rounds
+        constant_profiles = (
+            artifact.extra.get("constant_controller_profiles", {})
+            if artifact is not None
+            else {}
+        )
+        self._constant_controller_delay = (
+            planned_delay
+            if self.config.method == "lc_damp"
+            and str(planned_delay) in constant_profiles
+            and self.config.trace.trace_capture_max_bytes == 0
+            else None
+        )
+        basis_dev = (
+            basis.to(device=self.device, dtype=self._forward_dtype)
+            if mode == "output_residual"
+            else basis
+        )
+        self.runtime = AdaptationRuntime(
+            config=self.config,
+            method_factory=lambda: build_method(
+                self.config,
+                shapes,
+                basis_dev,
+                controller_artifact=artifact,
+                parameter_layout_sha256=self.parameter_layout_sha256,
+            ),
+            shapes=shapes,
+            basis=basis_dev,
+            telemetry=TelemetrySink(telemetry_path),
+            num_slots=num_slots,
+            device=self.device,
+            distance_weights=(artifact.distance_weights if artifact else None),
+            zvectorizer=(artifact.zvectorizer if artifact else None),
+            constant_controller_delay=self._constant_controller_delay,
+            parameter_layout_sha256=self.parameter_layout_sha256,
+            enable_replay_writer=tp_rank == 0,
+            forward_dtype=self._forward_dtype,
+            gradient_consensus_fn=(
+                partial(tp_gradient_consensus, tp_size=tp_world_size)
+                if tp_world_size > 1
+                else None
+            ),
+        )
+        # Precompute the device-resident projection/basis used by the
+        # draft-logit offset; addresses are fixed for the process lifetime.
+        self._r_h_dev = torch.from_numpy(self._r_h).to(
+            device=self.device, dtype=self._forward_dtype
+        )
+        self._basis_dev = (
+            basis_dev if mode == "output_residual" else w_lm_tensor
+        )
+        self._tail_projection = basis if mode != "output_residual" else None
+        self._parameter_slices = shapes.parameter_slices()
+        self.adapter_rows = (
+            torch.zeros(
+                adapter_row_capacity,
+                shapes.num_params(),
+                dtype=self._forward_dtype,
+                device=self.device,
+            )
+            if self.config.method != "static"
+            else None
+        )
+        self._adapter_slot_indices = (
+            torch.zeros(
+                adapter_row_capacity,
+                dtype=torch.int64,
+                device=self.device,
+            )
+            if self.adapter_rows is not None
+            else None
+        )
+        self._adapter_slot_indices_cpu = (
+            torch.zeros(adapter_row_capacity, dtype=torch.int64, pin_memory=True)
+            if self.adapter_rows is not None
+            else None
+        )
+        self._adapter_enabled_mask = (
+            torch.ones(
+                adapter_row_capacity,
+                dtype=self._forward_dtype,
+                device=self.device,
+            )
+            if self.adapter_rows is not None
+            else None
+        )
+        self._adapter_enabled_mask_cpu = (
+            torch.ones(
+                adapter_row_capacity,
+                dtype=self._forward_dtype,
+                pin_memory=True,
+            )
+            if self.adapter_rows is not None
+            else None
+        )
+        self._adapter_slot_signature: Optional[
+            tuple[tuple[int, int], ...]
+        ] = None
+
+        # Per-request bookkeeping (round counters, epoch/slot lookup).
+        self._round_of: dict[str, int] = {}
+        self._round_t0_us: dict[str, float] = {}
+        self._round_stats: dict[str, dict] = {}
+        self._capture_decisions: dict[tuple[str, int], bool] = {}
+        self._disabled_requests: set[str] = set()
+        self._fallback_counts: dict[str, int] = {}
+        self._adapter_allocator_growth_bytes = 0
+        self._telemetry_lanes = CudaTelemetryLanePool(
+            device=self.device,
+            max_batch_size=adapter_row_capacity,
+            event_names=(
+                "draft_start",
+                "draft_end",
+                "verify_end",
+                "accept_end",
+                "telemetry_ready",
+            ),
+            host_names=("commit", "verify", "new_seq"),
+        )
+        self._batch_telemetry_lane: Optional[int] = None
+
+        if self.config.method != "static":
+            worker._proposer.attach_adaptation_fns(
+                logits_offset_fn=self.logits_offset,
+                markov_logits_offset_fn=self.markov_logits_offset,
+                versions_fn=self.adapter_versions,
+                allow_folded_fn=self.allow_folded,
+            )
+        logger.info(
+            "DSpark adaptation enabled: method=%s lifecycle=%s rank=%d "
+            "telemetry=%s",
+            self.config.method,
+            self.config.lifecycle,
+            rank,
+            telemetry_path,
+        )
+
+    # ------------------------------------------------------------------
+    # request lifecycle (hook 7)
+    # ------------------------------------------------------------------
+
+    @staticmethod
+    def _tenant_hash(req) -> str:
+        raw = str(getattr(req, "session_id", None) or "tenant-0")
+        return hashlib.sha256(raw.encode()).hexdigest()[:16]
+
+    def begin_requests(self, batch) -> None:
+        """Allocate slots for rids we have not seen (called at prefill)."""
+        for req in batch.reqs:
+            rid = req.rid
+            if rid in self._round_of or rid in self._disabled_requests:
+                continue
+            stream_id = getattr(req, "session_id", None)
+            try:
+                self.runtime.on_request_lifecycle(
+                    self._H.RequestLifecycle(
+                        request_id=rid,
+                        event=(
+                            "stream_begin"
+                            if self.config.lifecycle == "stream" and stream_id
+                            else "begin"
+                        ),
+                        request_epoch=0,  # runtime assigns the real epoch
+                        slot_index=-1,
+                        stream_id=stream_id,
+                        tenant_id_hash=self._tenant_hash(req),
+                    )
+                )
+            except self._CapacityError as exc:
+                self._fallback(rid, "adapter_slots_exhausted", exc)
+                continue
+            except self._ExactnessViolation as exc:
+                self._quarantine(rid, exc)
+                continue
+            self._round_of[rid] = 0
+            self._round_stats[rid] = {}
+
+    def finish_request(self, rid: str) -> None:
+        if rid not in self._round_of:
+            self._disabled_requests.discard(rid)
+            return
+        ctx = self.runtime.requests.get(rid)
+        self.runtime.on_request_lifecycle(
+            self._H.RequestLifecycle(
+                request_id=rid,
+                event=(
+                    "stream_end"
+                    if self.config.lifecycle == "stream"
+                    and ctx is not None
+                    and ctx.stream_id
+                    else "end"
+                ),
+                request_epoch=ctx.request_epoch if ctx is not None else 0,
+                slot_index=ctx.slot_index if ctx is not None else -1,
+                stream_id=ctx.stream_id if ctx is not None else None,
+                tenant_id_hash=ctx.tenant_id_hash if ctx is not None else "",
+            )
+        )
+        self._round_of.pop(rid, None)
+        self._round_t0_us.pop(rid, None)
+        self._round_stats.pop(rid, None)
+        for key in tuple(self._capture_decisions):
+            if key[0] == rid:
+                self._capture_decisions.pop(key, None)
+        self._disabled_requests.discard(rid)
+
+    def _fallback(self, rid: str, reason: str, exc: Exception) -> None:
+        """Fail open to exact base DSpark for bounded adaptation failures."""
+        if rid in self._disabled_requests:
+            return
+        self._disabled_requests.add(rid)
+        self._fallback_counts[reason] = self._fallback_counts.get(reason, 0) + 1
+        logger.warning("DSpark adaptation fallback for request %s (%s): %s", rid, reason, exc)
+        from lightcone_spec.sglang_bridge.telemetry import UpdateTelemetry
+
+        self.runtime.telemetry.emit(
+            "update",
+            UpdateTelemetry(
+                request_id=rid,
+                update_id=f"{rid}-fallback",
+                source_round=self._round_of.get(rid, -1),
+                source_version=-1,
+                snapshot_ts_us=time.monotonic() * 1e6,
+                decision="discard",
+                failure_reason=f"fallback:{reason}",
+            ),
+        )
+        self.runtime.cancel_pending(rid)
+
+    def _quarantine(self, rid: str, exc: Exception) -> None:
+        """Disable adaptation for one request while preserving exact DSpark.
+
+        Corrected proposal logits remain available to acceptance for the
+        current round; future rounds receive zero adapter offsets.  The GPU
+        client promotes this telemetry record to ``failed_exactness``.
+        """
+        if rid in self._disabled_requests:
+            return
+        self._disabled_requests.add(rid)
+        logger.error("DSpark adaptation quarantined request %s: %s", rid, exc)
+        from lightcone_spec.sglang_bridge.telemetry import UpdateTelemetry
+
+        self.runtime.telemetry.emit(
+            "update",
+            UpdateTelemetry(
+                request_id=rid,
+                update_id=f"{rid}-exactness",
+                source_round=self._round_of.get(rid, -1),
+                source_version=-1,
+                snapshot_ts_us=time.monotonic() * 1e6,
+                decision="discard",
+                failure_reason=f"exactness:{exc}",
+            ),
+        )
+        ctx = self.runtime.requests.get(rid)
+        if ctx is not None:
+            self.runtime.cancel_pending(rid)
+
+    def _guard(self, rid: str, fn):
+        if rid in self._disabled_requests:
+            return None
+        try:
+            return fn()
+        except self._ExactnessViolation as exc:
+            self._quarantine(rid, exc)
+            return None
+        except torch.cuda.OutOfMemoryError as exc:
+            self._fallback(rid, "adaptation_cuda_oom", exc)
+            return None
+
+    def diagnostics(self) -> dict:
+        telemetry_flushed = self.runtime.telemetry.flush()
+        health = self.runtime.telemetry.health()
+        allocator_growth = (
+            self._adapter_allocator_growth_bytes
+            + self.runtime.max_allocator_growth_bytes
+        )
+        return {
+            "memory": {
+                "fixed_bytes": self.memory_ledger.fixed_bytes,
+                "transient_bytes": self.memory_ledger.transient_bytes,
+                "reserve_bytes": self.memory_ledger.reserve_bytes,
+                "reserve_mb": self.memory_ledger.reserve_mb,
+                "num_slots": self.memory_ledger.num_slots,
+                "num_params": self.memory_ledger.num_params,
+                "adapter_row_capacity": self.memory_ledger.adapter_row_capacity,
+                "allocator_growth_bytes": allocator_growth,
+            },
+            "fallback_counts": dict(self._fallback_counts),
+            "controller_static_fallback": self._controller_static_fallback,
+            "constant_controller_delay": self._constant_controller_delay,
+            "late_candidate_policy": (
+                "drop_at_planned_boundary"
+                if self._constant_controller_delay is not None
+                else "retain_until_ready"
+            ),
+            "candidate_generation_bypassed": (
+                self._controller_static_fallback
+                and self.config.trace.trace_capture_max_bytes == 0
+            ),
+            "trace_capture": {
+                "reserved_bytes": self.runtime._trace_bytes_written,
+                "requests_with_records": len(
+                    self.runtime._trace_records_by_request
+                ),
+                "records": sum(
+                    self.runtime._trace_records_by_request.values()
+                ),
+            },
+            "active_requests": len(self.runtime.requests),
+            "telemetry_lanes": {
+                "capacity": self._telemetry_lanes.lane_count,
+                "leased": self._telemetry_lanes.leased_count,
+                "host_pinned_bytes": self._telemetry_lanes.host_bytes,
+            },
+            "telemetry_flushed": telemetry_flushed,
+            "telemetry_error_count": health["error_count"],
+            "telemetry_last_error": health["last_error"],
+        }
+
+    # ------------------------------------------------------------------
+    # decode-round hooks 1-6 (batch-level wrappers)
+    # ------------------------------------------------------------------
+
+    def _ctx(self, rid: str):
+        return self.runtime.requests[rid]
+
+    def before_draft(self, batch, prefix_lens) -> None:
+        """Hook 1 per request; also starts the round wall clock."""
+        self.begin_requests(batch)  # decode-only entry (e.g. after restart)
+        if prefix_lens.is_cuda:
+            raise RuntimeError(
+                "LightCone requires ScheduleBatch.seq_lens_cpu at the publish "
+                "boundary; refusing a synchronous GPU-to-host length copy"
+            )
+        lens = prefix_lens.tolist()
+        # Publish at the next round boundary, before the proposal consumes the
+        # fixed adapter row.  The scheduler has already refreshed seq_lens_cpu,
+        # so token-delay features require no host synchronization here.
+        for i, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            self._ctx(rid).prefix_len = int(lens[i])
+        self._poll_ready(batch)
+        self.prepare_adapter_rows(batch)
+        now = time.monotonic() * 1e6
+        if self._batch_telemetry_lane is not None:
+            raise RuntimeError("DSpark telemetry batch lane was not released")
+        lane = self._telemetry_lanes.acquire()
+        self._batch_telemetry_lane = lane
+        draft_start = self._telemetry_lanes.event(lane, "draft_start")
+        draft_start.record(torch.cuda.current_stream(self.device))
+        self._batch_timing = {
+            "draft_start": draft_start,
+            "draft_cpu_start": now,
+        }
+        for i, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            ctx = self._ctx(rid)
+            self._round_t0_us[rid] = now
+            self._guard(
+                rid,
+                lambda rid=rid, ctx=ctx, i=i: self.runtime.on_draft_inputs_ready(
+                    self._H.DraftInputsReady(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        request_epoch=ctx.request_epoch,
+                        slot_index=ctx.slot_index,
+                        active_version=self.runtime.bank.slots[
+                            ctx.slot_index
+                        ].active_version,
+                        prefix_len=int(lens[i]),
+                    )
+                ),
+            )
+
+    def after_proposal(self, batch, proposal) -> None:
+        """Hook 2: bind proposal to the canvas-locked version."""
+        now = time.monotonic() * 1e6
+        lane = self._batch_telemetry_lane
+        if lane is None:
+            raise RuntimeError("DSpark proposal has no telemetry lane")
+        draft_end = self._telemetry_lanes.event(lane, "draft_end")
+        draft_end.record(torch.cuda.current_stream(self.device))
+        self._batch_timing["draft_end"] = draft_end
+        self._batch_timing["verify_cpu_start"] = now
+        for i, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            ctx = self._ctx(rid)
+            proposal_version = (
+                proposal.source_adapter_versions[i]
+                if proposal.source_adapter_versions is not None
+                else ctx.canvas_version
+            )
+            self._round_stats[rid] = {
+                "proposal_version": int(proposal_version),
+                "draft_tokens": int(proposal.draft_block.draft_tokens.shape[1]),
+                "verify_len": int(proposal.draft_block.draft_tokens.shape[1]) + 1,
+                "draft_cpu_us": now - self._batch_timing["draft_cpu_start"],
+                "cuda_timing": self._batch_timing,
+            }
+            self._guard(
+                rid,
+                lambda rid=rid, proposal_version=proposal_version: self.runtime.on_proposal_ready(
+                    self._H.ProposalReady(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        proposal_version=int(proposal_version),
+                        draft_tokens=[],
+                    )
+                ),
+            )
+
+    def after_verify(self, batch, target_logits, hidden_strided) -> None:
+        """Hook 3: teacher-signal source; also feeds trajectory states."""
+        now = time.monotonic() * 1e6
+        lane = self._batch_telemetry_lane
+        if lane is None:
+            raise RuntimeError("DSpark verification has no telemetry lane")
+        verify_end = self._telemetry_lanes.event(lane, "verify_end")
+        verify_end.record(torch.cuda.current_stream(self.device))
+        self._batch_timing["verify_end"] = verify_end
+        bs = len(batch.reqs)
+        logits_3d = (
+            target_logits.view(bs, -1, target_logits.shape[-1])
+            if target_logits is not None
+            else None
+        )
+        hidden_3d = (
+            _reshape_target_hidden(
+                hidden_strided,
+                batch_size=bs,
+                hidden_size=self._r_h_dev.shape[0],
+            )
+            if hidden_strided is not None
+            else None
+        )
+        for i, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            self._round_stats.setdefault(rid, {})["verify_cpu_us"] = (
+                now - self._batch_timing["verify_cpu_start"]
+            )
+            ctx = self._ctx(rid)
+            hidden_ref = None
+            if hidden_3d is not None and self.runtime.needs_trajectory:
+                raw = hidden_3d[i, 0].float()
+                hidden_ref = (raw @ self._r_h_dev).unsqueeze(0)
+            proposal_version = self._round_stats.get(rid, {}).get(
+                "proposal_version", ctx.canvas_version
+            )
+            self._guard(
+                rid,
+                lambda rid=rid, proposal_version=proposal_version,
+                hidden_ref=hidden_ref, i=i: self.runtime.on_verify_logits_ready(
+                    self._H.VerifyLogitsReady(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        proposal_version=proposal_version,
+                        target_logits_ref=(
+                            logits_3d[i] if logits_3d is not None else None
+                        ),
+                        target_hidden_ref=hidden_ref,
+                        valid_positions=(
+                            logits_3d.shape[1] if logits_3d is not None else 0
+                        ),
+                    )
+                ),
+            )
+
+    def after_accept(self, batch, accept, verify_lens=None) -> None:
+        """Hook 4: version-consistent acceptance record."""
+        lane = self._batch_telemetry_lane
+        if lane is None:
+            raise RuntimeError("DSpark acceptance has no telemetry lane")
+        accept_end = self._telemetry_lanes.event(lane, "accept_end")
+        accept_end.record(torch.cuda.current_stream(self.device))
+        self._batch_timing["accept_end"] = accept_end
+        commit_lens_cpu = self._telemetry_lanes.host(
+            lane,
+            "commit",
+            accept.commit_lens.dtype,
+            len(batch.reqs),
+        )
+        commit_lens_cpu.copy_(accept.commit_lens, non_blocking=True)
+        self._batch_timing["commit_lens_cpu"] = commit_lens_cpu
+        if verify_lens is not None:
+            verify_lens_cpu = self._telemetry_lanes.host(
+                lane,
+                "verify",
+                verify_lens.dtype,
+                len(batch.reqs),
+            )
+            verify_lens_cpu.copy_(
+                verify_lens[: len(batch.reqs)], non_blocking=True
+            )
+            self._batch_timing["verify_lens_cpu"] = verify_lens_cpu
+        for i, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            ctx = self._ctx(rid)
+            version = int(
+                self._round_stats.get(rid, {}).get(
+                    "proposal_version", ctx.canvas_version
+                )
+            )
+            self._guard(
+                rid,
+                lambda rid=rid, version=version: self.runtime.on_acceptance_done(
+                    self._H.AcceptanceDone(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        proposal_version=version,
+                        denominator_version=version,
+                        residual_version=version,
+                        accepted_drafts=0,
+                        used_bonus=True,
+                    )
+                ),
+            )
+
+    def after_commit(self, batch, new_seq_lens) -> None:
+        """Hook 5: round outcome committed."""
+        now = time.monotonic() * 1e6
+        lane = self._batch_telemetry_lane
+        if lane is None:
+            raise RuntimeError("DSpark commit has no telemetry lane")
+        new_seq_lens_cpu = self._telemetry_lanes.host(
+            lane,
+            "new_seq",
+            new_seq_lens.dtype,
+            len(batch.reqs),
+        )
+        new_seq_lens_cpu.copy_(new_seq_lens, non_blocking=True)
+        self._batch_timing["new_seq_lens_cpu"] = new_seq_lens_cpu
+        telemetry_ready = self._telemetry_lanes.event(lane, "telemetry_ready")
+        telemetry_ready.record(torch.cuda.current_stream(self.device))
+        self._batch_timing["telemetry_ready"] = telemetry_ready
+        try:
+            sampling_seeds, greedy_flags = resolve_request_rng_metadata(
+                batch.reqs, getattr(batch, "sampling_info", None)
+            )
+            for i, req in enumerate(batch.reqs):
+                rid = req.rid
+                if rid in self._disabled_requests:
+                    continue
+                ctx = self._ctx(rid)
+                stats = self._round_stats.get(rid, {})
+                timing = dict(stats.get("cuda_timing") or {})
+                timing["request_index"] = i
+                sampling_seed = sampling_seeds[i]
+                is_greedy = greedy_flags[i]
+                self._guard(
+                    rid,
+                    lambda rid=rid, ctx=ctx, stats=stats, timing=timing,
+                    sampling_seed=sampling_seed, is_greedy=is_greedy: self.runtime.on_round_committed(
+                        self._H.RoundCommitted(
+                            request_id=rid,
+                            round_id=self._round_of[rid],
+                            prefix_len_after=None,
+                            active_version=self.runtime.bank.slots[
+                                ctx.slot_index
+                            ].active_version,
+                            proposal_version=int(
+                                stats.get("proposal_version", ctx.canvas_version)
+                            ),
+                            draft_tokens=int(stats.get("draft_tokens", 0)),
+                            accepted_drafts=0,
+                            committed_per_verify=0,
+                            target_calls=1,
+                            rng_substream_id=self._H.rng_substream_identity(
+                                request_id=rid,
+                                sampling_seed=sampling_seed,
+                                is_greedy=is_greedy,
+                                round_id=self._round_of[rid],
+                                prefix_len=int(ctx.prefix_len),
+                            ),
+                            draft_cpu_us=float(stats.get("draft_cpu_us", 0.0)),
+                            verify_cpu_us=float(stats.get("verify_cpu_us", 0.0)),
+                            verify_len=int(stats.get("verify_len", 0)),
+                            batch_size=len(batch.reqs),
+                            offered_concurrency=int(self.config.runtime.concurrency),
+                            cuda_timing_ref=timing,
+                            round_wall_us=now - self._round_t0_us.get(rid, now),
+                        )
+                    ),
+                )
+        finally:
+            # The callback is queued after every round record.  FIFO deferred
+            # processing fences both the pinned rows and reusable events before
+            # the lane can return to the decode thread.
+            self.runtime.telemetry.defer(
+                partial(self._telemetry_lanes.release, lane),
+                telemetry_ready,
+            )
+            self._batch_telemetry_lane = None
+            self._batch_timing = {}
+
+    def maybe_launch_updates(self, batch, target_logits, proposal) -> None:
+        """Trigger-round teacher capture + side-stream candidate launch
+        (spec 4.5: round r with r mod S == 0). Every draft position of the
+        trigger round supervises (full verification window, spec 5.2)."""
+        from lightcone_spec.methods.base import TeacherSignal
+
+        # A gate artifact with no safe operating threshold is a certified
+        # static fallback for this asynchronous path: candidates can only be
+        # observed at a later round and will therefore always be discarded.
+        # Keep candidate construction enabled for bounded trace capture so a
+        # replacement controller can still be trained from real signals.
+        if (
+            self._controller_static_fallback
+            and self.config.trace.trace_capture_max_bytes == 0
+        ):
+            return
+        stride = self.config.update_stride
+        bs = len(batch.reqs)
+        if target_logits is None:
+            return
+        logits_3d = target_logits.view(bs, -1, target_logits.shape[-1])
+        draft_hidden = proposal.draft_hidden
+        draft_tokens = proposal.draft_block.draft_tokens
+        proposal_logits = proposal.draft_block.proposal_logits
+        raw_logits = proposal.draft_block.raw_logits
+        markov_features = proposal.draft_block.markov_features
+        valid_mask = proposal.draft_block.valid_mask
+        logit_scales = proposal.draft_block.proposal_logit_scales
+        for i, req in enumerate(batch.reqs):
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            round_id = self._round_of[rid]
+            trigger = round_id > 0 and round_id % stride == 0
+            capture = self._capture_trace_round(rid)
+            if not trigger and not capture:
+                continue
+            if (
+                proposal_logits is None
+                or raw_logits is None
+                or markov_features is None
+            ):
+                # Folded graph path never runs under adaptation; a missing
+                # corrected_logits means no supervision window this round.
+                continue
+            ctx = self._ctx(rid)
+            k = int(draft_tokens.shape[1])
+            tail_hidden = draft_hidden[i, :k].detach()
+            u = (
+                tail_hidden.to(self._forward_dtype) @ self._r_h_dev
+                if self.shapes.mode == "output_residual"
+                else tail_hidden[:, :128]
+            )
+            m_prev = markov_features[i, :k].to(self._forward_dtype)
+            base = raw_logits[i, :k].detach()
+            source_q = proposal_logits[i, :k].float().detach()
+            t_target = logits_3d[i, :k].float().detach()
+            base_conf = (
+                proposal.base_confidence_logits[i, :k].float()
+                if proposal.base_confidence_logits is not None
+                else torch.zeros(k, dtype=torch.float32, device=t_target.device)
+            )
+            mask = (
+                valid_mask[i, :k]
+                if valid_mask is not None
+                else torch.ones(k, dtype=torch.bool, device=t_target.device)
+            )
+            # Compact verify scatters unverified rows as exact zeros.  These
+            # positions must not enter either distillation or confidence loss.
+            mask = mask & t_target.ne(0).any(dim=-1)
+            source_version = (
+                proposal.source_adapter_versions[i]
+                if proposal.source_adapter_versions is not None
+                else ctx.canvas_version
+            )
+            signal = TeacherSignal(
+                source_round=round_id,
+                source_version=int(source_version),
+                u=u,
+                m_prev=m_prev,
+                base_proposal_logits=base,
+                base_confidence_logits=base_conf,
+                target_logits=t_target,
+                valid_mask=mask,
+                source_proposal_logits=source_q,
+                # Derive on the side stream. Computing two full-vocabulary
+                # softmaxes here would put adaptation work on the decode path.
+                confidence_targets=None,
+                proposal_logit_scale=(
+                    logit_scales[i].expand(k)
+                    if logit_scales is not None
+                    else None
+                ),
+                tail_hidden=(
+                    tail_hidden
+                    if self.shapes.mode != "output_residual"
+                    else None
+                ),
+            )
+            if capture:
+                self.runtime.observe_signal(rid, signal)
+            if trigger:
+                self._guard(
+                    rid,
+                    lambda rid=rid, signal=signal: self.runtime.launch_update(
+                        rid, signal
+                    ),
+                )
+
+    def _capture_trace_round(self, rid: str) -> bool:
+        """Return one TP-consistent bounded-trace decision for this round."""
+
+        round_id = self._round_of.get(rid, 0)
+        key = (rid, round_id)
+        cached = self._capture_decisions.get(key)
+        if cached is not None:
+            return cached
+        if self.config.trace.trace_capture_max_bytes <= 0:
+            self._capture_decisions[key] = False
+            return False
+        capture = (
+            self.runtime.wants_trace_signal(rid)
+            if self.tp_rank == 0
+            else False
+        )
+        if self.tp_size > 1:
+            from sglang.srt.distributed import get_tp_group
+
+            capture = bool(
+                get_tp_group().broadcast_object(
+                    capture if self.tp_rank == 0 else None,
+                    src=0,
+                )
+            )
+        self._capture_decisions[key] = capture
+        return capture
+
+    def _poll_ready(self, batch) -> None:
+        """Hook 6: legal pre-proposal graph boundary."""
+        for req in batch.reqs:
+            rid = req.rid
+            if rid in self._disabled_requests:
+                continue
+            ctx = self._ctx(rid)
+            self._guard(
+                rid,
+                lambda rid=rid, ctx=ctx: self.runtime.on_update_poll(
+                    self._H.UpdatePollPoint(
+                        request_id=rid,
+                        round_id=self._round_of[rid],
+                        request_epoch=ctx.request_epoch,
+                        slot_index=ctx.slot_index,
+                        active_version=self.runtime.bank.slots[
+                            ctx.slot_index
+                        ].active_version,
+                    )
+                ),
+            )
+
+    def poll_updates(self, batch) -> None:
+        """Advance the logical round after commit; publishing is pre-draft."""
+        for req in batch.reqs:
+            rid = req.rid
+            if rid in self._round_of:
+                self._capture_decisions.pop((rid, self._round_of[rid]), None)
+                self._round_of[rid] += 1
+
+    # ------------------------------------------------------------------
+    # adapter application (A_d, A_m and A_c)
+    # ------------------------------------------------------------------
+
+    def prepare_adapter_rows(self, batch) -> None:
+        """Gather active request rows once at the legal pre-replay boundary."""
+        if self.adapter_rows is None:
+            return
+        bs = len(batch.reqs)
+        if bs > self.adapter_rows.shape[0]:
+            raise RuntimeError(
+                f"LightCone batch {bs} exceeds adapter row capacity "
+                f"{self.adapter_rows.shape[0]}"
+            )
+        rows = self.adapter_rows[:bs]
+        signature: list[tuple[int, int]] = []
+        for req in batch.reqs:
+            ctx = self.runtime.requests.get(req.rid)
+            if (
+                ctx is None
+                or req.rid in self._disabled_requests
+                or not self.runtime.bank.slots[ctx.slot_index].active_has_effect
+            ):
+                signature.append((-1, -1))
+                continue
+            slot = self.runtime.bank.slots[ctx.slot_index]
+            signature.append((ctx.slot_index, slot.active_version))
+        signature_t = tuple(signature)
+        enabled = sum(index >= 0 for index, _version in signature_t)
+        signature_changed = signature_t != self._adapter_slot_signature
+        if not signature_changed:
+            return
+        if not enabled:
+            rows.zero_()
+            self._adapter_slot_signature = signature_t
+            return
+        with torch.profiler.record_function("lightcone::prepare_rows"):
+            indices = self._adapter_slot_indices[:bs]
+            if signature_changed:
+                for i, (slot_index, _version) in enumerate(signature_t):
+                    self._adapter_slot_indices_cpu[i] = max(slot_index, 0)
+                    self._adapter_enabled_mask_cpu[i] = float(slot_index >= 0)
+                indices.copy_(
+                    self._adapter_slot_indices_cpu[:bs], non_blocking=True
+                )
+            torch.index_select(
+                self.runtime.bank.forward_active,
+                0,
+                indices,
+                out=rows,
+            )
+            if enabled != bs:
+                mask = self._adapter_enabled_mask[:bs]
+                if signature_changed:
+                    mask.copy_(
+                        self._adapter_enabled_mask_cpu[:bs], non_blocking=True
+                    )
+                rows.mul_(mask[:, None])
+        self._adapter_slot_signature = signature_t
+
+    def _fallback_batch(self, batch, reason: str, exc: Exception) -> None:
+        for req in batch.reqs:
+            if req.rid not in self._disabled_requests:
+                self._fallback(req.rid, reason, exc)
+
+    def _has_enabled_requests(self, batch) -> bool:
+        for req in batch.reqs:
+            ctx = self.runtime.requests.get(req.rid)
+            if (
+                ctx is not None
+                and req.rid not in self._disabled_requests
+                and self.runtime.bank.slots[ctx.slot_index].active_has_effect
+            ):
+                return True
+        return False
+
+    def _track_allocator_growth(self, before: int) -> None:
+        self._adapter_allocator_growth_bytes = max(
+            self._adapter_allocator_growth_bytes,
+            int(torch.cuda.memory_reserved(self.device)) - int(before),
+        )
+
+    def adapter_versions(self, *, batch) -> list[int]:
+        versions = []
+        for req in batch.reqs:
+            ctx = self.runtime.requests.get(req.rid)
+            versions.append(
+                0
+                if ctx is None or req.rid in self._disabled_requests
+                else int(self.runtime.bank.slots[ctx.slot_index].active_version)
+            )
+        return versions
+
+    @property
+    def folded_graph_adaptation(self):
+        """Adapter captured by the greedy draft graph, if it can take effect."""
+        return None if self._controller_static_fallback else self
+
+    def allow_folded(self, *, batch, adapter_captured: bool = True) -> bool:
+        """Fold non-trigger greedy rounds without changing proposal semantics."""
+        if self.config.trace.trace_capture_max_bytes > 0:
+            return False
+        if self._controller_static_fallback:
+            return not self._has_enabled_requests(batch)
+        for req in batch.reqs:
+            round_id = self._round_of.get(req.rid, 0)
+            if round_id > 0 and round_id % self.config.update_stride == 0:
+                return False
+        # A native graph is exact only while all active rows are still zero.
+        return adapter_captured or not self._has_enabled_requests(batch)
+
+    def _output_residual_hidden(self, rows, hidden):
+        """Return native projected hidden features and their A_d residual."""
+
+        bs = rows.shape[0]
+        hidden_features = hidden.to(rows.dtype) @ self._r_h_dev
+        a_h_slice = self._parameter_slices["a_h"]
+        a_d = rows[:, a_h_slice].view(
+            bs, self.shapes.rank, self._r_h_dev.shape[1]
+        )
+        coefficients = torch.bmm(hidden_features, a_d.transpose(1, 2))
+        return hidden_features, torch.matmul(coefficients, self._basis_dev.T)
+
+    def _output_residual_markov(self, rows, markov):
+        """Return native Markov features and their per-step A_m residual."""
+
+        bs = rows.shape[0]
+        markov_features = markov.to(rows.dtype)
+        a_m_slice = self._parameter_slices["a_m"]
+        a_m = rows[:, a_m_slice].view(
+            bs, self.shapes.rank, self.shapes.markov_dim
+        )
+        coefficients = torch.bmm(
+            markov_features.unsqueeze(1), a_m.transpose(1, 2)
+        ).squeeze(1)
+        return markov_features, torch.matmul(coefficients, self._basis_dev.T)
+
+    def _confidence_features(self, draft_hidden, markov_features):
+        """Native A_c feature map shared by eager and folded graph paths."""
+
+        hidden = draft_hidden.to(self._forward_dtype)
+        markov = markov_features.to(self._forward_dtype)
+        if self.shapes.mode == "output_residual":
+            hidden = hidden @ self._r_h_dev
+            markov = markov * torch.rsqrt(
+                markov.pow(2).mean(dim=-1, keepdim=True) + 1e-6
+            )
+        return torch.cat(
+            [
+                hidden,
+                markov,
+                torch.ones(
+                    *hidden.shape[:-1],
+                    1,
+                    dtype=self._forward_dtype,
+                    device=hidden.device,
+                ),
+            ],
+            dim=-1,
+        )
+
+    def _tail_delta_hidden(self, rows, *, hidden=None, markov=None):
+        """Batched cache-safe tail map shared by eager and folded paths."""
+        if self.shapes.mode == "output_residual":
+            raise RuntimeError("hidden-tail helper used for output residual")
+        if hidden is None and markov is None:
+            raise ValueError("tail update requires hidden or Markov features")
+        bs = rows.shape[0]
+        slices = self._parameter_slices
+        if self.shapes.mode == "tail_lora":
+            latent = None
+            if hidden is not None:
+                a_h = rows[:, slices["a_h"]].view(
+                    bs, self.shapes.hidden_size, self.shapes.rank
+                )
+                latent = torch.bmm(hidden.to(rows.dtype), a_h)
+            if markov is not None:
+                a_m = rows[:, slices["a_m"]].view(
+                    bs, self.shapes.markov_dim, self.shapes.rank
+                )
+                markov_latent = torch.bmm(markov.to(rows.dtype), a_m)
+                latent = (
+                    markov_latent
+                    if latent is None
+                    else latent + markov_latent
+                )
+            assert latent is not None
+            b_h = rows[:, slices["b_h"]].view(
+                bs, self.shapes.rank, self.shapes.hidden_size
+            )
+            return torch.bmm(latent, b_h)
+        delta = None
+        if hidden is not None:
+            d_h = rows[:, slices["d_h"]].view(
+                bs, self.shapes.hidden_size, self.shapes.hidden_size
+            )
+            delta = torch.bmm(hidden.to(rows.dtype), d_h)
+        if markov is not None:
+            d_m = rows[:, slices["d_m"]].view(
+                bs, self.shapes.markov_dim, self.shapes.hidden_size
+            )
+            markov_delta = torch.bmm(markov.to(rows.dtype), d_m)
+            delta = markov_delta if delta is None else delta + markov_delta
+        assert delta is not None
+        return delta
+
+    def logits_offset(self, *, batch, draft_hidden, base_logits):
+        """Apply the hidden-side tail from each request's active bank row."""
+        bs, gamma, _ = base_logits.shape
+        if self.adapter_rows is None or not self._has_enabled_requests(batch):
+            return None
+        allocator_before = torch.cuda.memory_reserved(self.device)
+        try:
+            with torch.profiler.record_function("lightcone::tail_hidden"):
+                rows = self.adapter_rows[:bs]
+                if self.shapes.mode == "output_residual":
+                    _u, result = self._output_residual_hidden(
+                        rows, draft_hidden
+                    )
+                else:
+                    delta_hidden = self._tail_delta_hidden(
+                        rows, hidden=draft_hidden
+                    )
+                    result = self._tail_projection.project_hidden(
+                        delta_hidden
+                    ).to(base_logits.dtype)
+            self._track_allocator_growth(allocator_before)
+            return result
+        except torch.cuda.OutOfMemoryError as exc:
+            self._fallback_batch(batch, "adapter_logits_cuda_oom", exc)
+            # Do not allocate a vocab-sized zero tensor while recovering from
+            # OOM.  The proposer treats None as an unapplied A_d offset and
+            # samples this round from native DSpark logits.
+            return None
+
+    def markov_logits_offset(self, *, batch, step_idx: int, prev_tokens):
+        del step_idx
+        bs = len(batch.reqs)
+        if self.adapter_rows is None or not self._has_enabled_requests(batch):
+            return None
+        allocator_before = torch.cuda.memory_reserved(self.device)
+        try:
+            with torch.profiler.record_function("lightcone::A_m"):
+                rows = self.adapter_rows[:bs]
+                markov_head = self.worker.draft_model.markov_head
+                m_prev = markov_head.get_prev_embeddings(prev_tokens)
+                if self.shapes.mode == "output_residual":
+                    _m_prev, result = self._output_residual_markov(
+                        rows, m_prev
+                    )
+                else:
+                    delta_hidden = self._tail_delta_hidden(
+                        rows,
+                        markov=m_prev.to(rows.dtype)[:, None, :],
+                    ).squeeze(1)
+                    result = self._tail_projection.project_hidden(delta_hidden)
+            self._track_allocator_growth(allocator_before)
+            return result
+        except torch.cuda.OutOfMemoryError as exc:
+            self._fallback_batch(batch, "adapter_markov_cuda_oom", exc)
+            # None is the allocation-free exact native-Markov fallback.  The
+            # sampler still retains the logits actually used for proposal q.
+            return None
+
+    def adapt_confidence(self, *, batch, proposal, confidence):
+        """Apply A_c in logit space and return planner probabilities.
+
+        The returned base/adapted logits are retained in DraftProposal so the
+        training signal reconstructs exactly the same confidence function.
+        """
+        if proposal.folded:
+            # A_c was already captured inside DsparkDraftSampler.
+            return confidence, None, None
+        draft_hidden = proposal.draft_hidden
+        markov_features = proposal.draft_block.markov_features
+        if draft_hidden is None or markov_features is None:
+            return confidence, None, None
+        bs, gamma, _ = draft_hidden.shape
+        device = draft_hidden.device
+        if confidence is None:
+            base_logits = torch.zeros(bs, gamma, dtype=torch.float32, device=device)
+        else:
+            base_logits = torch.logit(
+                confidence.float().clamp(min=1e-6, max=1.0 - 1e-6)
+            )
+        if self.adapter_rows is None or not self._has_enabled_requests(batch):
+            return confidence, base_logits, base_logits
+        allocator_before = torch.cuda.memory_reserved(self.device)
+        try:
+            with torch.profiler.record_function("lightcone::A_c"):
+                conf_slice = self._parameter_slices["a_c"]
+                a_c = self.adapter_rows[:bs, conf_slice].view(
+                    bs, self.shapes.draft_depth, self.shapes.conf_feature_dim
+                )
+                feat = self._confidence_features(
+                    draft_hidden, markov_features
+                )
+                adapted_logits = base_logits + (a_c[:, :gamma] * feat).sum(-1)
+            self._track_allocator_growth(allocator_before)
+        except torch.cuda.OutOfMemoryError as exc:
+            self._fallback_batch(batch, "adapter_confidence_cuda_oom", exc)
+            return confidence, base_logits, base_logits
+        return torch.sigmoid(adapted_logits), base_logits, adapted_logits
+
+    def close(self) -> None:
+        self.runtime.telemetry.close()
+
+    def __del__(self):
+        try:
+            self.close()
+        except Exception:
+            pass
