+def _merge_sglang_generated_token_ids(
+    accumulated: Optional[List[int]],
+    response_output_ids: Any,
+    completion_tokens: Any,
+) -> List[int]:
+    """Merge exact SGLang output IDs across cumulative or delta streams."""
+    if not isinstance(response_output_ids, list):
+        raise TypeError("SGLang output_ids must be a list")
+    if not isinstance(completion_tokens, int) or isinstance(completion_tokens, bool):
+        raise TypeError("SGLang completion_tokens must be an integer")
+    if completion_tokens < 0:
+        raise ValueError("SGLang completion_tokens must be non-negative")
+
+    token_ids: List[int] = []
+    for token_id in response_output_ids:
+        if not isinstance(token_id, int) or isinstance(token_id, bool) or token_id < 0:
+            raise ValueError("SGLang output_ids must contain non-negative integers")
+        token_ids.append(token_id)
+
+    if accumulated is not None and completion_tokens < len(accumulated):
+        raise ValueError("SGLang completion_tokens moved backwards")
+    if len(token_ids) == completion_tokens:
+        if accumulated is not None and token_ids[: len(accumulated)] != accumulated:
+            raise ValueError("SGLang cumulative output_ids changed prior tokens")
+        return token_ids
+    if (
+        accumulated is not None
+        and len(accumulated) + len(token_ids) == completion_tokens
+    ):
+        return [*accumulated, *token_ids]
+    raise ValueError("SGLang output_ids do not cover the reported completion tokens")
+
