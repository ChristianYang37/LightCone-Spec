+from __future__ import annotations
+
+import ast
+import asyncio
+import json
+import sys
+import time
+import traceback
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, List, Optional
+
+SERVING_PATH = (
+    Path(__file__).resolve().parents[4] / "python/sglang/benchmark/serving.py"
+)
+SERVING_TREE = ast.parse(SERVING_PATH.read_text(encoding="utf-8"))
+
+
+def _function(name: str) -> ast.FunctionDef | ast.AsyncFunctionDef:
+    for node in SERVING_TREE.body:
+        if (
+            isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+            and node.name == name
+        ):
+            return node
+    raise AssertionError(f"missing function: {name}")
+
+
+def _load_merge_function():
+    node = _function("_merge_sglang_generated_token_ids")
+    assert isinstance(node, ast.FunctionDef)
+    module = ast.Module(body=[node], type_ignores=[])
+    namespace = {"Any": Any, "List": List, "Optional": Optional}
+    exec(compile(module, SERVING_PATH, "exec"), namespace)
+    return namespace[node.name]
+
+
+class _ResponseContent:
+    def __init__(self, chunks: list[bytes]):
+        self.chunks = chunks
+
+    async def _iterate(self):
+        for chunk in self.chunks:
+            yield chunk
+
+    def __aiter__(self):
+        return self._iterate()
+
+
+class _Response:
+    status = 200
+    reason = ""
+
+    def __init__(self, chunks: list[bytes]):
+        self.content = _ResponseContent(chunks)
+
+    async def text(self):
+        return ""
+
+
+class _ResponseContext:
+    def __init__(self, chunks: list[bytes]):
+        self.response = _Response(chunks)
+
+    async def __aenter__(self):
+        return self.response
+
+    async def __aexit__(self, exc_type, exc, traceback_value):
+        return False
+
+
+class _Session:
+    def __init__(self, chunks: list[bytes]):
+        self.chunks = chunks
+        self.closed = False
+        self.close_calls = 0
+        self.posts = []
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, exc_type, exc, traceback_value):
+        return False
+
+    def post(self, **kwargs):
+        self.posts.append(kwargs)
+        return _ResponseContext(self.chunks)
+
+    async def close(self):
+        self.close_calls += 1
+        self.closed = True
+
+
+class _Output:
+    @staticmethod
+    def init_new(request):
+        return SimpleNamespace(
+            prompt_len=request.prompt_len,
+            generated_text="",
+            generated_token_ids=None,
+            success=False,
+            latency=0.0,
+            ttft=0.0,
+            itl=[],
+            output_len=0,
+            error="",
+            cached_tokens=0,
+            cached_tokens_details=None,
+            spec_accept_length=0.0,
+        )
+
+
+def _run_request(
+    payloads: list[dict],
+    *,
+    disable_stream: bool,
+    client_session: _Session | None = None,
+):
+    merge = _load_merge_function()
+    request_node = _function("async_request_sglang_generate")
+    assert isinstance(request_node, ast.AsyncFunctionDef)
+    chunks = []
+    for payload in payloads:
+        encoded = json.dumps(payload).encode("utf-8")
+        chunks.append(encoded if disable_stream else b"data: " + encoded + b"\n\n")
+    namespace = {
+        "List": List,
+        "Optional": Optional,
+        "RequestFuncInput": object,
+        "RequestFuncOutput": _Output,
+        "_ROUTING_KEY_HEADER": "X-SMG-Routing-Key",
+        "_create_bench_client_session": lambda: _Session(chunks),
+        "_merge_sglang_generated_token_ids": merge,
+        "aiohttp": SimpleNamespace(
+            ClientSession=object,
+            ClientTimeout=lambda **kwargs: kwargs,
+        ),
+        "args": SimpleNamespace(
+            temperature=0.0,
+            disable_ignore_eos=False,
+            top_p=1.0,
+            disable_stream=disable_stream,
+            return_logprob=False,
+            return_routed_experts=False,
+            logprob_start_len=-1,
+            top_logprobs_num=0,
+            token_ids_logprob=None,
+        ),
+        "get_request_headers": lambda: {},
+        "json": json,
+        "math": __import__("math"),
+        "remove_prefix": lambda value, prefix: (
+            value[len(prefix) :] if value.startswith(prefix) else value
+        ),
+        "sys": sys,
+        "time": time,
+        "tqdm": object,
+        "traceback": traceback,
+    }
+    module = ast.Module(body=[request_node], type_ignores=[])
+    exec(compile(module, SERVING_PATH, "exec"), namespace)
+    request = SimpleNamespace(
+        prompt=[1, 2],
+        api_url="http://127.0.0.1:30000/generate",
+        prompt_len=2,
+        output_len=2,
+        lora_name="",
+        extra_request_body={},
+        image_data=None,
+        routing_key=None,
+    )
+    return asyncio.run(
+        namespace[request_node.name](request, client_session=client_session)
+    )
+
+
+class ServingOutputTokenIdsTests(unittest.TestCase):
+    def test_output_contract_and_request_path_are_wired(self):
+        output = next(
+            node
+            for node in SERVING_TREE.body
+            if isinstance(node, ast.ClassDef) and node.name == "RequestFuncOutput"
+        )
+        fields = {
+            node.target.id
+            for node in output.body
+            if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name)
+        }
+        self.assertIn("generated_token_ids", fields)
+
+        request_source = ast.unparse(_function("async_request_sglang_generate"))
+        self.assertIn("data['output_ids']", request_source)
+        self.assertIn(
+            "output.generated_token_ids = generated_token_ids", request_source
+        )
+        self.assertIn("client_session", request_source)
+        generate = _function("async_request_sglang_generate")
+        self.assertEqual(
+            [argument.arg for argument in generate.args.kwonlyargs],
+            ["client_session", "timeout_s"],
+        )
+        self.assertTrue(all(value is not None for value in generate.args.kw_defaults))
+
+    def test_cumulative_and_incremental_output_ids_are_exact(self):
+        merge = _load_merge_function()
+        self.assertEqual(merge(None, [11], 1), [11])
+        self.assertEqual(merge([11], [12, 13], 3), [11, 12, 13])
+        self.assertEqual(merge([11, 12], [11, 12, 13], 3), [11, 12, 13])
+
+    def test_request_collects_streaming_cumulative_ids(self):
+        output = _run_request(
+            [
+                {
+                    "text": "A",
+                    "output_ids": [11],
+                    "meta_info": {"completion_tokens": 1},
+                },
+                {
+                    "text": "AB",
+                    "output_ids": [11, 12],
+                    "meta_info": {"completion_tokens": 2},
+                },
+            ],
+            disable_stream=False,
+        )
+        self.assertTrue(output.success, output.error)
+        self.assertEqual(output.generated_token_ids, [11, 12])
+
+    def test_request_collects_streaming_delta_ids(self):
+        output = _run_request(
