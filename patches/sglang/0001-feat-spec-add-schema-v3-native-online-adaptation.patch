+async def async_request_sglang_abort(
+    request_id: str,
+    base_url: str,
+    *,
+    client_session: Optional[aiohttp.ClientSession] = None,
+    timeout_s: Optional[float] = None,
+) -> None:
+    """Abort through the same caller-owned pool used by generate requests."""
+
+    if not isinstance(request_id, str) or not request_id or "\n" in request_id:
+        raise ValueError("SGLang abort requires a non-empty request ID")
+    if not isinstance(base_url, str) or not base_url.startswith(
+        ("http://", "https://")
+    ):
+        raise ValueError("SGLang abort requires an HTTP(S) base URL")
+    if timeout_s is not None and (not math.isfinite(timeout_s) or timeout_s <= 0):
+        raise ValueError("SGLang abort timeout must be finite and positive")
+    owns_client_session = client_session is None
+    session = (
+        _create_bench_client_session() if client_session is None else client_session
+    )
+    if getattr(session, "closed", False):
+        raise RuntimeError("SGLang abort received a closed client session")
+    try:
+        options = {
+            "url": base_url.rstrip("/") + "/abort_request",
+            "json": {"rid": request_id, "abort_all": False},
+            "headers": get_request_headers(),
+        }
+        if timeout_s is not None:
+            options["timeout"] = aiohttp.ClientTimeout(total=timeout_s)
+        async with session.post(**options) as response:
+            if int(response.status) != 200:
+                detail = (response.reason or "") + ": " + (await response.text())
+                raise RuntimeError(
+                    f"SGLang did not acknowledge request abort: {detail}"
+                )
+    finally:
+        if owns_client_session:
+            await session.close()
+
