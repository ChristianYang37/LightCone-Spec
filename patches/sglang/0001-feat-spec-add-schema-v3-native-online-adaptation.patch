+    distributed_capability_receipt_sha256: str | None
+
+
+@dataclass(frozen=True)
+class OnlineAdaptationConfig:
+    method: str
+    algorithm: str
+    weight_update_mode: str
+    parameter_scope: str
+    adaptation_group_id: str
+    tenant_id: str
+    optimizer: OnlineOptimizerConfig
+    rank: int | None
+    lora_alpha: int | None
+    lora_matrix_policy: str
+    native_head_policy: str
+    stride: int
+    canvas_tokens: int
+    loss_position_decay: float
+    extra_logical_delay: int
+    teacher_row_policy: str
+    verification_mode: str
+    fixed_verification_budget: int | None
+    confidence_loss_weight: float | None
+    target_revision: str
+    drafter_revision: str
+    sampling_profile_sha256: str
+    telemetry_detail: str
+    topology: TopologyConfig
+    online_spec: OnlineSpecLearnerConfig | None = None
+
+    @property
+    def sha256(self) -> str:
+        payload = {
+            "schema_version": 3,
+            "method": self.method,
+            "algorithm": self.algorithm,
+            "weight_update_mode": self.weight_update_mode,
+            "parameter_scope": self.parameter_scope,
+            "kv_history_policy": "frozen",
+            "adaptation_scope": "cohort",
+            "adaptation_group_id": self.adaptation_group_id,
+            "tenant_id": self.tenant_id,
+            "optimizer": self.optimizer.__dict__,
+            "rank": self.rank,
+            "lora_alpha": self.lora_alpha,
+            "lora_matrix_policy": self.lora_matrix_policy,
+            "native_head_policy": self.native_head_policy,
+            "stride": self.stride,
+            "max_in_flight": 1,
+            "canvas_tokens": self.canvas_tokens,
+            "loss_position_decay": self.loss_position_decay,
+            "extra_logical_delay": self.extra_logical_delay,
+            "teacher_row_policy": self.teacher_row_policy,
+            "verification_mode": self.verification_mode,
+            "fixed_verification_budget": self.fixed_verification_budget,
+            "confidence_loss_weight": self.confidence_loss_weight,
+            "target_revision": self.target_revision,
+            "drafter_revision": self.drafter_revision,
+            "sampling_profile_sha256": self.sampling_profile_sha256,
+            "telemetry_detail": self.telemetry_detail,
+            "topology": self.topology.__dict__,
+        }
+        if self.online_spec is not None:
+            payload["online_spec"] = {
+                "projection_radius": self.online_spec.projection_radius,
+                "additional_learning_rates": list(
+                    self.online_spec.additional_learning_rates
+                ),
+                "hedge_learning_rate": self.online_spec.hedge_learning_rate,
+            }
+        encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
+        return hashlib.sha256(encoded).hexdigest()
+
+    @classmethod
+    def load(cls, path: str | Path) -> OnlineAdaptationConfig:
+        source = Path(path)
+        try:
+            value = json.loads(source.read_text(encoding="utf-8"))
+        except (OSError, json.JSONDecodeError) as exc:
+            raise ValueError(
+                f"cannot load speculative adaptation config {source}: {exc}"
+            ) from exc
+        if not isinstance(value, dict):
+            raise TypeError("speculative adaptation config must be an object")
+        expected = {
+            "schema_version",
+            "method",
+            "algorithm",
+            "weight_update_mode",
+            "parameter_scope",
+            "kv_history_policy",
+            "adaptation_scope",
+            "adaptation_group_id",
+            "tenant_id",
+            "optimizer",
+            "rank",
+            "lora_alpha",
+            "lora_matrix_policy",
+            "native_head_policy",
+            "stride",
+            "max_in_flight",
+            "canvas_tokens",
+            "loss_position_decay",
+            "extra_logical_delay",
+            "teacher_row_policy",
+            "verification_mode",
+            "fixed_verification_budget",
+            "confidence_loss_weight",
+            "target_revision",
+            "drafter_revision",
+            "sampling_profile_sha256",
+            "telemetry_detail",
+            "topology",
+        }
+        unknown = set(value) - expected - {"online_spec"}
+        missing = expected - set(value)
+        if unknown or missing:
+            raise ValueError(
+                "speculative adaptation config fields mismatch: "
+                f"missing={sorted(missing)}, unknown={sorted(unknown)}"
+            )
+        if value["schema_version"] != 3:
+            raise ValueError("speculative adaptation requires schema_version=3")
+        method = value["method"]
+        if method not in {
+            "tts",
+            "l0",
+            "onlinespec_ogd",
+            "onlinespec_opt",
+            "onlinespec_ens",
+        }:
+            raise ValueError("unknown online adaptation method")
+        algorithm = value["algorithm"]
+        if algorithm not in BACKEND_ADAPTATION_CAPABILITIES:
+            raise ValueError("unknown speculative adaptation algorithm")
+        mode = value["weight_update_mode"]
+        if mode not in {"lora", "full"}:
+            raise ValueError("weight_update_mode must be lora or full")
+        scope = value["parameter_scope"]
+        valid_scopes = (
+            {*LAYER_SCOPES, *DSPARK_HYBRID_SCOPES}
+            if algorithm == "DSPARK"
+            else set(LAYER_SCOPES)
+        )
+        if scope not in valid_scopes:
+            raise ValueError(f"unregistered {algorithm} parameter_scope")
+        rank = value["rank"]
+        alpha = value["lora_alpha"]
+        if mode == "full":
+            if rank is not None or alpha is not None:
+                raise ValueError("full updates require rank and lora_alpha to be null")
+        elif (
+            not isinstance(rank, int)
+            or isinstance(rank, bool)
+            or not isinstance(alpha, int)
+            or isinstance(alpha, bool)
+            or rank not in LORA_RANKS
+            or alpha != rank
+        ):
+            raise ValueError("LoRA requires a registered rank and alpha/r=1")
+        if value["lora_matrix_policy"] != "registered_matrices_v1":
+            raise ValueError("unknown LoRA matrix policy")
+        head_policy = value["native_head_policy"]
+        hybrid = scope in DSPARK_HYBRID_SCOPES
+        if head_policy not in {"frozen", "full"}:
+            raise ValueError("native_head_policy must be frozen or full")
+        if head_policy != ("full" if hybrid else "frozen"):
+            raise ValueError(
+                "DSpark hybrid scopes train native heads; layer-only scopes freeze them"
+            )
+        if value["kv_history_policy"] != "frozen":
+            raise ValueError("only frozen historical drafter KV is supported")
+        if value["adaptation_scope"] != "cohort":
+            raise ValueError("only cohort-shared parameters are supported")
+        if value["max_in_flight"] != 1:
+            raise ValueError("max_in_flight must equal one")
+        for field in ("adaptation_group_id", "tenant_id"):
+            if not isinstance(value[field], str) or not value[field]:
+                raise ValueError(f"{field} must be a non-empty string")
+        for field in ("target_revision", "drafter_revision"):
+            _lower_hex(value[field], 40, field)
+        profile = _lower_hex(
+            value["sampling_profile_sha256"], 64, "sampling_profile_sha256"
+        )
+        telemetry_detail = value["telemetry_detail"]
+        if telemetry_detail not in {"headline", "profile"}:
+            raise ValueError("telemetry_detail must be headline or profile")
+        stride = _positive_int(value["stride"], "stride")
+        canvas_tokens = _positive_int(value["canvas_tokens"], "canvas_tokens")
+        if canvas_tokens < 2:
+            raise ValueError("canvas_tokens must be at least two")
+        extra_delay = _nonnegative_int(
+            value["extra_logical_delay"], "extra_logical_delay"
+        )
+        decay = _finite_float(value["loss_position_decay"], "loss_position_decay")
+        if not 0.0 < decay <= 1.0:
+            raise ValueError("loss_position_decay must be in (0, 1]")
+        teacher_policy = value["teacher_row_policy"]
+        if teacher_policy not in {"update_round", "quota_shadow"}:
+            raise ValueError("unknown teacher-row policy")
+        verification_mode = value["verification_mode"]
+        if verification_mode not in {"native_scheduler", "fixed_budget"}:
+            raise ValueError("unknown verification mode")
+        budget_raw = value["fixed_verification_budget"]
+        budget = (
+            None
+            if budget_raw is None
+            else _positive_int(budget_raw, "fixed_verification_budget")
+        )
+        if (verification_mode == "fixed_budget") != (budget is not None):
+            raise ValueError("fixed-budget verification requires exactly one budget")
+        confidence_raw = value["confidence_loss_weight"]
+        confidence = (
+            None
+            if confidence_raw is None
+            else _finite_float(confidence_raw, "confidence_loss_weight")
+        )
+        if confidence is not None and confidence < 0:
+            raise ValueError("confidence_loss_weight cannot be negative")
+        if algorithm != "DSPARK" and (
+            verification_mode != "native_scheduler"
+            or budget is not None
+            or confidence is not None
+        ):
+            raise ValueError("verification and confidence controls are DSpark-only")
+        if algorithm == "DSPARK" and ((confidence is not None) != hybrid):
+            raise ValueError(
+                "only DSpark native-head hybrids use the confidence objective"
+            )
+        topology = _parse_topology(value["topology"])
+        online_spec = _parse_online_spec(value.get("online_spec"), method)
+        optimizer = _parse_optimizer(value["optimizer"], method=method)
+        if method == "onlinespec_ens":
+            if online_spec is None:
+                raise AssertionError("validated OnlineSPEC config is missing")
+            rates = (
+                optimizer.learning_rate,
+                *online_spec.additional_learning_rates,
+            )
+            if len(rates) < 2 or tuple(sorted(rates)) != rates:
+                raise ValueError(
+                    "OnlineSPEC Hedge requires an increasing multi-rate grid"
+                )
+        return cls(
+            method=method,
+            algorithm=algorithm,
+            weight_update_mode=mode,
+            parameter_scope=scope,
+            adaptation_group_id=value["adaptation_group_id"],
+            tenant_id=value["tenant_id"],
+            optimizer=optimizer,
+            rank=rank,
+            lora_alpha=alpha,
+            lora_matrix_policy=value["lora_matrix_policy"],
+            native_head_policy=head_policy,
+            stride=stride,
+            canvas_tokens=canvas_tokens,
+            loss_position_decay=decay,
+            extra_logical_delay=extra_delay,
+            teacher_row_policy=teacher_policy,
+            verification_mode=verification_mode,
+            fixed_verification_budget=budget,
+            confidence_loss_weight=confidence,
+            target_revision=value["target_revision"],
+            drafter_revision=value["drafter_revision"],
+            sampling_profile_sha256=profile,
+            telemetry_detail=telemetry_detail,
+            topology=topology,
+            online_spec=online_spec,
+        )
+
+
+def _positive_int(value: Any, field: str) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+        raise ValueError(f"{field} must be a positive integer")
+    return value
+
+
+def _nonnegative_int(value: Any, field: str) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
+        raise ValueError(f"{field} must be a non-negative integer")
+    return value
+
+
+def _finite_float(value: Any, field: str) -> float:
+    if not isinstance(value, (int, float)) or isinstance(value, bool):
+        raise TypeError(f"{field} must be numeric")
+    number = float(value)
+    if not math.isfinite(number):
+        raise ValueError(f"{field} must be finite")
+    return number
+
+
+def _lower_hex(value: Any, width: int, field: str) -> str:
+    if (
+        not isinstance(value, str)
+        or len(value) != width
+        or any(character not in "0123456789abcdef" for character in value)
+    ):
+        label = "Git SHA" if width == 40 else "SHA-256"
+        raise ValueError(f"{field} must be a lowercase {label}")
+    return value
+
+
+def _parse_topology(value: Any) -> TopologyConfig:
+    expected = {
+        "tensor_parallel_size",
+        "data_parallel_size",
+        "tp_rank",
+        "dp_rank",
+        "node_count",
+        "node_rank",
+        "device_identity",
+        "rendezvous_identity",
+        "router_identity",
+        "clock_identity",
+        "process_group_backend",
+        "distributed_runtime_capability",
+        "distributed_capability_receipt_sha256",
+    }
+    if not isinstance(value, dict) or set(value) != expected:
+        raise ValueError("topology fields do not match schema-v3")
+    tp = _positive_int(value["tensor_parallel_size"], "tensor_parallel_size")
+    dp = _positive_int(value["data_parallel_size"], "data_parallel_size")
+    tp_rank = _nonnegative_int(value["tp_rank"], "tp_rank")
+    dp_rank = _nonnegative_int(value["dp_rank"], "dp_rank")
+    nodes = _positive_int(value["node_count"], "node_count")
+    node_rank = _nonnegative_int(value["node_rank"], "node_rank")
+    if tp_rank >= tp or dp_rank >= dp or node_rank >= nodes:
+        raise ValueError("topology rank is outside its declared world")
+    if nodes != 1 or node_rank != 0:
+        raise ValueError("multi-node LightCone adaptation is unavailable")
+    if tp * dp > 2:
+        raise ValueError("this protocol describes at most two local GPU ranks")
+    identities = {}
+    for field in (
+        "device_identity",
+        "rendezvous_identity",
+        "router_identity",
+        "clock_identity",
+    ):
+        item = value[field]
+        if not isinstance(item, str) or not item:
+            raise ValueError(f"{field} must be a non-empty string")
+        identities[field] = item
+    backend = value["process_group_backend"]
+    if backend not in {"nccl", "gloo"}:
+        raise ValueError("unknown process-group backend")
+    capability = value["distributed_runtime_capability"]
+    if capability not in {"single_rank", "patched_two_gpu_v1"}:
+        raise ValueError("unknown distributed runtime capability")
+    receipt_raw = value["distributed_capability_receipt_sha256"]
+    receipt = (
+        None
+        if receipt_raw is None
+        else _lower_hex(receipt_raw, 64, "distributed capability receipt")
+    )
+    distributed = tp * dp > 1
+    if distributed:
+        if capability != "patched_two_gpu_v1" or receipt is None:
+            raise ValueError(
+                "distributed topology requires its exact capability receipt"
+            )
+        if dp > 1 and identities["router_identity"] == "single-replica":
+            raise ValueError("DP topology requires a sticky router identity")
+    elif capability != "single_rank" or receipt is not None:
+        raise ValueError("single-rank topology cannot claim a distributed capability")
+    return TopologyConfig(
+        tensor_parallel_size=tp,
+        data_parallel_size=dp,
+        tp_rank=tp_rank,
+        dp_rank=dp_rank,
+        node_count=nodes,
+        node_rank=node_rank,
+        process_group_backend=backend,
+        distributed_runtime_capability=capability,
+        distributed_capability_receipt_sha256=receipt,
+        **identities,
+    )
+
+
+def _parse_online_spec(value: Any, method: str) -> OnlineSpecLearnerConfig | None:
+    baseline = method.startswith("onlinespec_")
+    if not baseline:
+        if value is not None:
+            raise ValueError("online_spec is only valid for OnlineSPEC baselines")
+        return None
+    if not isinstance(value, dict) or set(value) != {
+        "projection_radius",
+        "additional_learning_rates",
+        "hedge_learning_rate",
+    }:
+        raise ValueError("OnlineSPEC learner fields do not match schema-v3")
+    radius_raw = value["projection_radius"]
+    radius = (
+        None if radius_raw is None else _finite_float(radius_raw, "projection_radius")
+    )
+    rates_raw = value["additional_learning_rates"]
+    if not isinstance(rates_raw, list):
+        raise TypeError("additional_learning_rates must be a list")
+    rates = tuple(
+        _finite_float(rate, "additional_learning_rates") for rate in rates_raw
+    )
+    hedge_raw = value["hedge_learning_rate"]
+    hedge = (
+        None if hedge_raw is None else _finite_float(hedge_raw, "hedge_learning_rate")
+    )
+    if any(number is not None and number <= 0 for number in (radius, hedge, *rates)):
+        raise ValueError("OnlineSPEC learner values must be positive")
+    if len(set(rates)) != len(rates) or tuple(sorted(rates)) != rates:
+        raise ValueError("OnlineSPEC learning rates must be unique and increasing")
+    if method == "onlinespec_ens":
+        if hedge is None:
+            raise ValueError("OnlineSPEC Hedge requires hedge_learning_rate")
+    elif rates or hedge is not None:
+        raise ValueError("ensemble fields are only valid for onlinespec_ens")
+    return OnlineSpecLearnerConfig(radius, rates, hedge)
+
+
+def _parse_optimizer(value: Any, *, method: str) -> OnlineOptimizerConfig:
+    if not isinstance(value, dict):
+        raise TypeError("optimizer must be an object")
+    expected = {
+        "name",
+        "learning_rate",
+        "weight_decay",
+        "beta1",
+        "beta2",
+        "epsilon",
+        "grad_clip",
+        "momentum",
+        "muon_ns_steps",
+        "muon_auxiliary_learning_rate",
+        "muon_auxiliary_weight_decay",
+        "schedule",
+        "schedule_total_published_updates",
+    }
+    if set(value) != expected:
+        raise ValueError("optimizer fields do not match schema-v3")
+    name = value["name"]
+    allowed = (
+        {"sgd"}
+        if method.startswith("onlinespec_")
+        else {"adam", "adamw", "sgdm", "nag", "muon", "lion"}
+    )
+    if name not in allowed:
+        raise ValueError("optimizer is not valid for this online method")
+    schedule = value["schedule"]
+    if schedule not in {
+        "constant",
+        "inverse_sqrt_published_update",
+        "cosine_to_zero",
+    }:
+        raise ValueError("unknown optimizer schedule")
+    horizon_raw = value["schedule_total_published_updates"]
+    horizon = (
+        None
+        if horizon_raw is None
+        else _positive_int(horizon_raw, "schedule_total_published_updates")
+    )
+    if horizon is not None and horizon < 2:
+        raise ValueError("schedule_total_published_updates must be at least two")
+    if (schedule == "cosine_to_zero") != (horizon is not None):
+        raise ValueError("cosine_to_zero requires exactly one published-update horizon")
+    learning_rate = _finite_float(value["learning_rate"], "learning_rate")
+    weight_decay = _finite_float(value["weight_decay"], "weight_decay")
+    beta1 = _finite_float(value["beta1"], "beta1")
+    beta2 = _finite_float(value["beta2"], "beta2")
+    epsilon = _finite_float(value["epsilon"], "epsilon")
+    grad_clip = _finite_float(value["grad_clip"], "grad_clip")
+    momentum_raw = value["momentum"]
+    momentum = None if momentum_raw is None else _finite_float(momentum_raw, "momentum")
+    ns_steps = value["muon_ns_steps"]
+    auxiliary_lr_raw = value["muon_auxiliary_learning_rate"]
+    auxiliary_decay_raw = value["muon_auxiliary_weight_decay"]
+    auxiliary_lr = (
+        None
+        if auxiliary_lr_raw is None
+        else _finite_float(auxiliary_lr_raw, "muon_auxiliary_learning_rate")
+    )
+    auxiliary_decay = (
+        None
+        if auxiliary_decay_raw is None
+        else _finite_float(auxiliary_decay_raw, "muon_auxiliary_weight_decay")
+    )
+    if learning_rate <= 0 or epsilon <= 0 or grad_clip <= 0:
+        raise ValueError("optimizer lr, epsilon, and grad_clip must be positive")
+    if not 0 < beta1 < 1 or not 0 < beta2 < 1:
+        raise ValueError("optimizer betas must be in (0, 1)")
+    if weight_decay < 0 or (
+        name not in {"adamw", "sgdm", "nag", "muon", "lion"} and weight_decay != 0
+    ):
+        raise ValueError("weight decay is unsupported for this optimizer")
+    momentum_names = {"sgdm", "nag", "muon"}
+    if name in momentum_names:
+        if momentum is None or not 0 < momentum < 1:
+            raise ValueError(f"{name} requires momentum in (0, 1)")
+    elif momentum is not None:
+        raise ValueError(f"momentum is not valid for optimizer={name}")
+    if name in {"sgd", "sgdm", "nag"} and (
+        beta1 != 0.9 or beta2 != 0.999 or epsilon != 1e-8
+    ):
+        raise ValueError(f"unused Adam fields must stay canonical for optimizer={name}")
+    if name == "lion" and epsilon != 1e-8:
+        raise ValueError("unused epsilon must stay canonical for optimizer=lion")
+    if name == "muon":
+        if (
+            not isinstance(ns_steps, int)
+            or isinstance(ns_steps, bool)
+            or not 1 <= ns_steps <= 20
+        ):
+            raise ValueError("Muon requires muon_ns_steps in [1, 20]")
+        if auxiliary_lr is None or auxiliary_lr <= 0:
+            raise ValueError("Muon requires positive auxiliary AdamW lr")
+        if auxiliary_decay is None or auxiliary_decay < 0:
+            raise ValueError("Muon auxiliary weight decay must be non-negative")
+    elif any(item is not None for item in (ns_steps, auxiliary_lr, auxiliary_decay)):
+        raise ValueError("Muon-only fields require optimizer=muon")
+    return OnlineOptimizerConfig(
+        name,
+        learning_rate,
+        weight_decay,
+        beta1,
+        beta2,
+        epsilon,
+        grad_clip,
+        momentum,
+        ns_steps,
+        auxiliary_lr,
+        auxiliary_decay,
+        schedule,
+        horizon,
+    )
+
+
+def load_online_adaptation(server_args) -> OnlineAdaptationConfig | None:
+    path = getattr(server_args, "speculative_adaptation_config", None)
+    return None if not path else OnlineAdaptationConfig.load(path)
+
+
+def _require_implemented_capability(config: OnlineAdaptationConfig) -> None:
+    topology_capability = config.topology.distributed_runtime_capability
+    if topology_capability not in IMPLEMENTED_DISTRIBUTED_CAPABILITIES:
+        raise ValueError(
+            "this SGLang patch tree does not implement the declared distributed "
+            f"adaptation capability {topology_capability!r}"
+        )
+    backend_capability = BACKEND_ADAPTATION_CAPABILITIES[config.algorithm]
+    if backend_capability != "single_rank_native_layers_v1":
+        raise ValueError(
+            f"{config.algorithm} adaptation is unavailable in this patch tree "
+            f"(capability={backend_capability})"
+        )
+    if config.optimizer.schedule != "constant":
+        raise ValueError(
+            "this patch tree implements only the constant optimizer schedule"
+        )
+    if config.extra_logical_delay != 0:
+        raise ValueError(
+            "extra logical publication delay is not implemented by this patch tree"
+        )
+    if config.teacher_row_policy != "update_round":
+        raise ValueError(
+            "quota-shadow teacher rows are not implemented by this patch tree"
+        )
+
+
+def validate_online_adaptation(server_args) -> None:
+    config = load_online_adaptation(server_args)
+    metrics_enabled = bool(
+        getattr(server_args, "speculative_speed_study_metrics", False)
+    )
+    reserve_mb = int(getattr(server_args, "speculative_adaptation_reserve_mb", 0))
+    if reserve_mb < 0:
+        raise ValueError("speculative_adaptation_reserve_mb cannot be negative")
+    if config is None:
+        if reserve_mb or getattr(
+            server_args, "speculative_adaptation_telemetry_path", None
+        ):
+            raise ValueError(
+                "adaptation reserve and telemetry are forbidden without an "
+                "adaptation config"
+            )
+        if not metrics_enabled:
+            return
+        backend = str(server_args.speculative_algorithm or "").upper()
+        # Target-only uses the same aggregate terminal boundary without
+        # speculative allocation or exact-rejection controls.
+        if not backend:
+            return
+        if backend not in BACKEND_ADAPTATION_CAPABILITIES:
+            raise ValueError("speed-study metrics require a supported backend")
+        if not bool(getattr(server_args, "speculative_use_rejection_sampling", False)):
+            raise ValueError("speed-study metrics require exact rejection sampling")
+        if float(server_args.speculative_accept_threshold_single) != 1.0:
+            raise ValueError("speed-study metrics require accept threshold single=1")
+        if float(server_args.speculative_accept_threshold_acc) != 1.0:
+            raise ValueError("speed-study metrics require accept threshold acc=1")
+        return
+    if not metrics_enabled:
+        raise ValueError("online adaptation requires --speculative-speed-study-metrics")
+    backend = str(server_args.speculative_algorithm or "").upper()
+    if backend != config.algorithm:
+        raise ValueError(
+            "adaptation config/backend mismatch: "
+            f"config={config.algorithm}, runtime={backend}"
+        )
+    runtime_tp = int(getattr(server_args, "tp_size", 1))
+    runtime_dp = int(getattr(server_args, "dp_size", 1))
+    if (
+        runtime_tp != config.topology.tensor_parallel_size
+        or runtime_dp != config.topology.data_parallel_size
+    ):
+        raise ValueError("runtime TP/DP does not match the bound topology identity")
+    _require_implemented_capability(config)
+    width = int(getattr(server_args, "speculative_num_draft_tokens", 0) or 0)
+    if config.canvas_tokens != width:
+        raise ValueError(
+            "adaptation canvas_tokens must equal speculative_num_draft_tokens"
+        )
+    if getattr(server_args, "speculative_draft_model_quantization", None):
+        raise ValueError("online updates require an unquantized draft model")
+    if str(getattr(server_args, "kv_cache_dtype", "auto")) != "auto":
+        raise ValueError(
+            "online adaptation currently requires unquantized KV cache dtype=auto"
+        )
+    if bool(getattr(server_args, "enable_two_batch_overlap", False)):
+        raise ValueError("online adaptation does not support two-batch overlap")
+    if bool(getattr(server_args, "enable_pdmux", False)):
+        raise ValueError("online adaptation does not support PD multiplexing")
+    if not bool(getattr(server_args, "speculative_use_rejection_sampling", False)):
+        raise ValueError("online adaptation requires exact rejection sampling")
+    if float(server_args.speculative_accept_threshold_single) != 1.0:
+        raise ValueError("exact adaptation requires accept threshold single=1")
+    if float(server_args.speculative_accept_threshold_acc) != 1.0:
+        raise ValueError("exact adaptation requires accept threshold acc=1")
+    if reserve_mb <= 0:
+        raise ValueError("online adaptation requires an explicit pre-KV HBM reserve")
