+_LOWER_SHA256 = re.compile(r"[0-9a-f]{64}")
+_SAFE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:@+-]{0,511}")
+_BEGIN_KEYS = {
+    "schema_version",
+    "hook",
+    "run_id",
+    "run_nonce_sha256",
+    "execution_plan_sha256",
+    "rank_config_sha256",
