+    def _terminal_round_rows(
+        self, diagnostics: dict[str, object]
+    ) -> list[dict[str, object]]:
+        raw_rows = diagnostics.get("rounds", [])
+        kv_segments = diagnostics.get("kv_segments", {})
+        if not isinstance(raw_rows, list) or not isinstance(kv_segments, dict):
+            raise RuntimeError("native round diagnostics are malformed")
+        rows = []
+        for raw in raw_rows:
+            if not isinstance(raw, dict):
+                raise RuntimeError("native round diagnostic row is malformed")
+            request_ids = raw.get("request_ids")
+            fields = (
+                raw.get("prefix_len_before"),
+                raw.get("verify_len"),
+                raw.get("accepted_drafts"),
+                raw.get("committed_tokens"),
+            )
+            if not isinstance(request_ids, list) or any(
+                not isinstance(field, list) or len(field) != len(request_ids)
+                for field in fields
+            ):
+                raise RuntimeError("native round diagnostic coverage is malformed")
+            for index, request_id in enumerate(request_ids):
+                history = kv_segments.get(request_id, [])
+                row = {
+                    "request_id": request_id,
+                    "round_index": raw.get("round_index"),
+                    "proposal_source_version": raw.get("source_version"),
+                    "prefix_len_before": fields[0][index],
+                    "verify_len": fields[1][index],
+                    "accepted_drafts": fields[2][index],
+                    "committed_tokens": fields[3][index],
+                    "target_calls": 1,
+                    "historical_kv_source_versions": history,
+                }
+                row["round_sha256"] = terminal_content_sha256(row)
+                rows.append(row)
+        return rows
