+            self._captured_input is None
+            and self._captured_positions is None
+            and self._captured_prefix_lens is None
+            and not self._captured_request_ids
+            and self._captured_history is None
+        )
+        runtime_reset = (
+            self.runtime.active_version == 0
+            and self.runtime.round == 0
+            and self.runtime.pending is None
+            and self.runtime.reserved is None
+            and not self.runtime.requests
+            and not self.runtime.device_commits
+            and not self.runtime.latest_device_lengths
+            and not self.runtime.update_traces
+            and not self.runtime.round_traces
+            and not self.runtime.active_round_rows
+        )
+        return {
