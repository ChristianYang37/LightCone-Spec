+        "supported_methods": sorted(SUPPORTED_TERMINAL_METHODS),
+        "enabled": bool(server_args.speculative_speed_study_metrics)
+        and topology_supported
+        and active_method in SUPPORTED_TERMINAL_METHODS
+        and method_evidence_supported,
