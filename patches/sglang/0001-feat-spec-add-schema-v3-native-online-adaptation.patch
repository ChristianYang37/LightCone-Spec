diff --git a/python/sglang/srt/speculative/dspark_components/dspark_proposal.py b/python/sglang/srt/speculative/dspark_components/dspark_proposal.py
new file mode 100644
index 0000000..543c243
--- /dev/null
+++ b/python/sglang/srt/speculative/dspark_components/dspark_proposal.py
@@ -0,0 +1,45 @@
+"""Lightweight DSpark proposal evidence shared by draft and verify paths."""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import msgspec
+import torch
+
+
+class DraftBlockResult(msgspec.Struct, frozen=True):
+    draft_tokens: torch.Tensor
+    corrected_logits: Optional[torch.Tensor]
+    greedy_mask: torch.Tensor
+    temperatures: torch.Tensor
+    raw_logits: Optional[torch.Tensor] = None
+    source_adapter_version: Optional[torch.Tensor] = None
+
+
+def compute_dspark_projection(model, raw_hidden: torch.Tensor):
+    """Resolve logits and the exact LM-head input under one checked contract."""
+    callback = getattr(model, "compute_base_logits_and_hidden", None)
+    if callback is None:
+        raise ValueError("DSpark model does not expose its LM-head input")
+    result = callback(raw_hidden)
+    if not isinstance(result, tuple) or len(result) != 3:
+        raise TypeError(
+            "DSpark projection must return logits, confidence tap, and hidden"
+        )
+    base_logits, confidence_tap, head_hidden = result
+    if (
+        not isinstance(base_logits, torch.Tensor)
+        or not isinstance(head_hidden, torch.Tensor)
+        or base_logits.ndim != 2
+        or head_hidden.ndim != 2
+        or base_logits.shape[0] != head_hidden.shape[0]
+    ):
+        raise ValueError("DSpark projection rows are not aligned")
+    return base_logits, confidence_tap, head_hidden
+
+
+__all__ = (
+    "DraftBlockResult",
+    "compute_dspark_projection",
+)
