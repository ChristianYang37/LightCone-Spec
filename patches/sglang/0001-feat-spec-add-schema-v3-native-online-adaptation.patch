+    "schema_version",
+    "hook",
+    "run_id",
+    "run_nonce_sha256",
+    "execution_plan_sha256",
+    "rank_config_sha256",
+    "request_id",
+    "terminal_status",
+    "terminal_reason",
+    "client_terminal_sha256",
+}
