+_STATE_KEYS = {
+    "schema_version",
+    "scheduler_idle",
+    "active_requests",
+    "queued_requests",
+    "request_pool_active_slots",
+    "allocator_current_hbm_bytes",
+    "allocator_reserved_hbm_bytes",
+    "allocator_peak_hbm_bytes",
