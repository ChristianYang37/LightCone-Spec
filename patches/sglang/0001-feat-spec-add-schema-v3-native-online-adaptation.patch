+        """Return endpoint-only predicates proving the adapted state is clean.
+
+        The reset receipt binds these predicates to the parameter-layout and
+        configuration digests.  CUDA equality checks synchronize only at the
+        explicit control boundary; they are never reachable from decode.
+        """
+
+        master_reset = all(
+            torch.equal(master, initial.to(master.dtype))
+            for master, initial in zip(
+                self.optimizer.master, self.initial_trainable, strict=True
+            )
+        )
+        effective = self._effective_parameters(self.optimizer.master)
+        expected_inference = tuple(effective[name] for name in self.names)
+        inference_reset = all(
+            torch.equal(active, expected.to(active.dtype))
+            and torch.equal(staging, expected.to(staging.dtype))
+            for active, staging, expected in zip(
+                self.inference.active,
+                self.inference.staging,
+                expected_inference,
+                strict=True,
+            )
+        )
+        if isinstance(self.optimizer, OnlineSpecOptimizer):
+            optimizer_reset = self.optimizer.step == 0 and master_reset
+        else:
