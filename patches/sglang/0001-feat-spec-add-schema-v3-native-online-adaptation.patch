+
+LORA_RANKS = (1, 2, 4, 8, 16, 32, 64)
+LAYER_SCOPES = ("last1", "last3", "last5", "all")
+DSPARK_HYBRID_SCOPES = (
+    "last1_native_heads",
+    "last3_native_heads",
+    "last5_native_heads",
+)
+
+# These values are runtime facts, not promises inferred from upstream SGLang.
+# A schema can describe a cell without authorizing an implementation that this
+# patch tree does not contain.  Validation consumes this table before any
+# adaptation model or optimizer state is allocated.
