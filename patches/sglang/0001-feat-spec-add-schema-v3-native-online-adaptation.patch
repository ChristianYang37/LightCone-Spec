+            "adaptation_config_sha256": self.config.sha256,
+            "parameter_layout_sha256": self.runtime.parameter_layout_sha256,
+            "cohort_epoch": self.runtime.epoch,
+            "active_version": self.runtime.active_version,
+            "optimizer_generation": self.optimizer.step,
+            "master_reset": master_reset,
+            "optimizer_reset": optimizer_reset,
+            "inference_reset": inference_reset,
+            "runtime_reset": runtime_reset,
+            "captured_state_empty": captured_state_empty,
+        }
+
+    def note_load(
+        self,
+        *,
+        running_requests: int,
+        waiting_requests: int,
+        graph_replay: bool,
+    ) -> None:
