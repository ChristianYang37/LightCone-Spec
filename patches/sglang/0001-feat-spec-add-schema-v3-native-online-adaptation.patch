+            running_requests=running_requests,
+            waiting_requests=waiting_requests,
+            graph_replay=graph_replay,
+        )
+
+    def diagnostics(self) -> dict:
+        online_spec_state = (
+            self.optimizer.diagnostics()
+            if isinstance(self.optimizer, OnlineSpecOptimizer)
+            else None
+        )
+        return self.runtime.diagnostics(extra={"online_spec_state": online_spec_state})
