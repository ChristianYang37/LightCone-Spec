+
+def canonical_json_bytes(value: object) -> bytes:
+    """Serialize strict JSON for every digest and signature boundary."""
+
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode("utf-8")
+
+
+def content_sha256(value: object) -> str:
+    return hashlib.sha256(canonical_json_bytes(value)).hexdigest()
+
+
+def _require_sha256(value: object, field: str) -> str:
+    if not isinstance(value, str) or _LOWER_SHA256.fullmatch(value) is None:
+        raise ValueError(f"{field} must be a lowercase SHA-256")
+    return value
+
+
+def _require_id(value: object, field: str, *, nullable: bool = False) -> str | None:
+    if value is None and nullable:
+        return None
+    if not isinstance(value, str) or _SAFE_ID.fullmatch(value) is None:
+        raise ValueError(f"{field} must be a safe non-empty identity")
+    return value
+
+
+def _require_int(value: object, field: str, *, minimum: int = 0) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < minimum:
+        raise ValueError(f"{field} must be an integer at least {minimum}")
+    return value
+
+
+def _request_ids(value: object, field: str) -> tuple[str, ...]:
+    if not isinstance(value, list):
+        raise ValueError(f"{field} must be a JSON list")
+    rows = tuple(_require_id(item, field) for item in value)
+    if len(rows) != len(set(rows)):
+        raise ValueError(f"{field} contains duplicate request IDs")
+    return rows  # type: ignore[return-value]
+
+
+def _validate_finite_json(value: object, field: str = "payload") -> None:
+    if value is None or isinstance(value, (str, bool, int)):
+        return
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"{field} contains a non-finite number")
+        return
+    if isinstance(value, list):
+        for index, item in enumerate(value):
+            _validate_finite_json(item, f"{field}[{index}]")
+        return
+    if isinstance(value, dict):
+        if any(not isinstance(key, str) for key in value):
+            raise ValueError(f"{field} contains a non-string JSON key")
+        for key, item in value.items():
+            _validate_finite_json(item, f"{field}.{key}")
+        return
+    raise ValueError(f"{field} is not strict JSON")
+
+
+def validate_performance_counters(value: object, *, method: str) -> dict[str, object]:
+    if not isinstance(value, dict) or set(value) != _PERFORMANCE_KEYS:
+        raise ValueError("terminal performance counter fields are incomplete")
+    _validate_finite_json(value, "performance_counters")
+    for field in _PERFORMANCE_COUNT_KEYS:
+        _require_int(value[field], field)
+    for field in ("updates_launched", "updates_published"):
+        if value[field] is not None:
+            _require_int(value[field], field)
+    if value["collective_type"] != "none_tp1":
+        raise RuntimeError("terminal evidence is not bound to the supported TP1 path")
+    for field in ("collective_duration_ms", "collective_exposed_wait_ms"):
+        if not isinstance(value[field], (int, float)) or isinstance(value[field], bool):
+            raise ValueError(f"{field} must be a finite number")
+    if value["collective_overlap_ratio"] is not None:
+        raise RuntimeError("TP1 terminal evidence cannot report collective overlap")
+    if method in {"target_only", "static"}:
+        if any(value[field] != 0 for field in _ALLOCATION_FREE_ZERO_KEYS):
+            raise RuntimeError(
+                "allocation-free evidence reports native adaptation state"
+            )
+        if any(value[field] is not None for field in _ALLOCATION_FREE_NULL_KEYS):
+            raise RuntimeError(
+                "allocation-free evidence reports detailed update timing"
+            )
+    if method == "target_only":
+        for field in (
+            "accepted_drafts",
+            "committed_tokens",
+            "verified_drafts",
+            "accepted_drafts_per_verify",
+            "committed_tokens_per_verify",
+            "verified_drafts_per_verify",
+            "verification_waste",
+        ):
+            if value[field] is not None:
+                raise RuntimeError("Target-only evidence reports speculative counters")
+        if any(value[field] is not None for field in _SAFETY_COUNTER_KEYS):
+            raise RuntimeError(
+                "Target-only evidence reports adaptation safety counters"
+            )
+    else:
+        for field in _SAFETY_COUNTER_KEYS:
+            _require_int(value[field], field)
+    if method in {"tts", "l0"}:
+        if value["updates_launched"] is None or value["updates_published"] is None:
+            raise RuntimeError("adapted evidence lacks update counters")
+        if value["optimizer_bytes"] is None or value["trainable_parameters"] is None:
+            raise RuntimeError("adapted evidence lacks resident allocation counters")
+    return dict(value)
+
+
+def validate_state_snapshot(value: object, *, clean: bool) -> dict[str, object]:
+    if not isinstance(value, dict) or set(value) != _STATE_KEYS:
+        raise ValueError("terminal state snapshot fields are incomplete")
+    _validate_finite_json(value, "state")
+    if value["schema_version"] != 1:
+        raise ValueError("terminal state snapshot schema is unsupported")
+    for field in (
+        "active_requests",
+        "queued_requests",
+        "request_pool_active_slots",
+        "allocator_current_hbm_bytes",
+        "allocator_reserved_hbm_bytes",
+        "allocator_peak_hbm_bytes",
+        "kv_token_capacity",
+        "kv_available_tokens",
+        "adapter_active_version",
+        "adapter_epoch",
+        "optimizer_generation",
+        "telemetry_generation",
+        "completion_event_generation",
+    ):
+        _require_int(value[field], field)
+    for field in ("kv_state_sha256", "rng_state_sha256"):
+        _require_sha256(value[field], field)
+    adapter_digest = value["adapter_state_sha256"]
+    if adapter_digest is not None:
+        _require_sha256(adapter_digest, "adapter_state_sha256")
+    if (
+        not isinstance(value["scheduler_idle"], bool)
+        or not isinstance(value["adapter_reset_verified"], bool)
+        or not isinstance(value["completion_event_complete"], bool)
+    ):
+        raise ValueError("terminal state booleans are malformed")
+    if value["allocator_peak_hbm_bytes"] < value["allocator_current_hbm_bytes"]:
+        raise ValueError("allocator peak is smaller than current allocation")
+    if value["kv_available_tokens"] > value["kv_token_capacity"]:
+        raise ValueError("KV availability exceeds its capacity")
+    if clean and (
+        not value["scheduler_idle"]
+        or value["active_requests"] != 0
+        or value["queued_requests"] != 0
+        or value["request_pool_active_slots"] != 0
+        or value["kv_available_tokens"] != value["kv_token_capacity"]
+        or value["adapter_active_version"] != 0
+        or value["optimizer_generation"] != 0
+        or not value["adapter_reset_verified"]
+        or not value["completion_event_complete"]
+    ):
+        raise RuntimeError("terminal reset did not establish a clean server state")
+    return dict(value)
+
+
+@dataclass(frozen=True)
+class TerminalRunIdentity:
+    run_id: str
+    run_nonce_sha256: str
+    execution_plan_sha256: str
+    rank_config_sha256: str
+    attempt_id: str
+    session_id: str
+    session_epoch: int
+    previous_run_id: str | None
+    challenge_nonce_sha256: str
+    method: str
+    warmup_request_ids: tuple[str, ...]
+    scored_request_ids: tuple[str, ...]
+
+    @classmethod
+    def from_begin_payload(cls, value: object) -> "TerminalRunIdentity":
+        if not isinstance(value, dict) or set(value) != _BEGIN_KEYS:
+            raise ValueError("terminal begin payload fields are incomplete")
+        if value["schema_version"] != 1:
+            raise ValueError("terminal begin schema is unsupported")
+        if value["hook"] != NATIVE_TERMINAL_EVIDENCE_HOOK:
+            raise ValueError("terminal begin hook identity mismatch")
+        method = value["method"]
+        if method not in SUPPORTED_TERMINAL_METHODS:
+            raise ValueError("terminal evidence method is unsupported")
+        warmup = _request_ids(value["warmup_request_ids"], "warmup_request_ids")
+        scored = _request_ids(value["scored_request_ids"], "scored_request_ids")
+        if not scored:
+            raise ValueError("terminal evidence requires scored request IDs")
+        if set(warmup) & set(scored):
+            raise ValueError("warmup and scored request IDs must be disjoint")
+        return cls(
+            run_id=_require_id(value["run_id"], "run_id"),  # type: ignore[arg-type]
+            run_nonce_sha256=_require_sha256(
+                value["run_nonce_sha256"], "run_nonce_sha256"
+            ),
+            execution_plan_sha256=_require_sha256(
+                value["execution_plan_sha256"], "execution_plan_sha256"
+            ),
+            rank_config_sha256=_require_sha256(
+                value["rank_config_sha256"], "rank_config_sha256"
+            ),
+            attempt_id=_require_id(value["attempt_id"], "attempt_id"),  # type: ignore[arg-type]
+            session_id=_require_id(value["session_id"], "session_id"),  # type: ignore[arg-type]
+            session_epoch=_require_int(
+                value["session_epoch"], "session_epoch", minimum=1
+            ),
+            previous_run_id=_require_id(
+                value["previous_run_id"], "previous_run_id", nullable=True
+            ),
+            challenge_nonce_sha256=_require_sha256(
+                value["challenge_nonce_sha256"], "challenge_nonce_sha256"
+            ),
+            method=method,
+            warmup_request_ids=warmup,
+            scored_request_ids=scored,
+        )
+
+    def fields(self) -> dict[str, object]:
+        return {
+            "run_id": self.run_id,
+            "run_nonce_sha256": self.run_nonce_sha256,
+            "execution_plan_sha256": self.execution_plan_sha256,
+            "rank_config_sha256": self.rank_config_sha256,
+            "attempt_id": self.attempt_id,
+            "session_id": self.session_id,
+            "session_epoch": self.session_epoch,
+            "previous_run_id": self.previous_run_id,
+            "challenge_nonce_sha256": self.challenge_nonce_sha256,
+            "method": self.method,
+        }
+
+
+class TerminalAttestationSigner(Protocol):
+    """Out-of-band signer interface; implementations retain their private key."""
+
+    attester_id: str
+    trust_domain: str
+
+    def sign(self, message: bytes) -> bytes: ...
+
+
+SignatureVerifier = Callable[[bytes, bytes], bool]
+AttestationSignerProvider = Callable[[], TerminalAttestationSigner | None]
+_ATTESTATION_SIGNER_PROVIDER: AttestationSignerProvider | None = None
+
+
+def register_terminal_attestation_signer_provider(
+    provider: AttestationSignerProvider,
+) -> None:
+    """Register a process-local signer provider from trusted plugin code.
+
+    The provider, signer, and private key are never accepted over HTTP and are
+    never serialized into evidence.  SGLang loads plugins before constructing
+    the scheduler, so a deployment-owned hardware plugin can install this hook.
+    """
+
+    global _ATTESTATION_SIGNER_PROVIDER
+    if not callable(provider):
+        raise TypeError("terminal attestation signer provider must be callable")
+    if _ATTESTATION_SIGNER_PROVIDER is not None:
+        raise RuntimeError("terminal attestation signer provider is already registered")
+    _ATTESTATION_SIGNER_PROVIDER = provider
+
+
+def terminal_attestation_signer_provider_configured() -> bool:
+    return _ATTESTATION_SIGNER_PROVIDER is not None
+
+
+def resolve_terminal_attestation_signer() -> TerminalAttestationSigner | None:
+    provider = _ATTESTATION_SIGNER_PROVIDER
+    if provider is None:
+        return None
+    signer = provider()
+    if signer is None:
+        return None
+    _require_id(signer.attester_id, "attester_id")
+    if signer.trust_domain not in {"hardware", "test"} or not callable(signer.sign):
+        raise ValueError("terminal attestation signer metadata is unsupported")
+    return signer
+
+
+def _attestation_message(envelope: Mapping[str, object]) -> dict[str, object]:
+    return {
+        "schema_version": 1,
+        "kind": "lightcone_terminal_attestation_challenge",
+        "hook": NATIVE_TERMINAL_EVIDENCE_HOOK,
+        "challenge_nonce_sha256": envelope["challenge_nonce_sha256"],
+        "terminal_sha256": envelope["terminal_sha256"],
+        "run_id": envelope["run_id"],
+        "run_nonce_sha256": envelope["run_nonce_sha256"],
+        "server_process_id": envelope["server_process_id"],
+        "server_process_started_ns": envelope["server_process_started_ns"],
+        "session_id": envelope["session_id"],
+        "session_epoch": envelope["session_epoch"],
+        "attempt_id": envelope["attempt_id"],
+    }
+
+
+def build_terminal_attestation(
+    envelope: Mapping[str, object], signer: TerminalAttestationSigner | None
+) -> dict[str, object]:
+    message = _attestation_message(envelope)
+    message_sha256 = content_sha256(message)
+    if signer is None:
+        return {
+            "schema_version": 1,
+            "status": "UNAVAILABLE",
+            "challenge_nonce_sha256": envelope["challenge_nonce_sha256"],
+            "message_sha256": message_sha256,
+            "attester_id": None,
+            "trust_domain": None,
+            "signature_hex": None,
+        }
+    attester_id = _require_id(signer.attester_id, "attester_id")
+    if signer.trust_domain not in {"hardware", "test"}:
+        raise ValueError("attestation trust domain is unsupported")
+    signature = signer.sign(canonical_json_bytes(message))
+    if not isinstance(signature, bytes) or not signature:
+        raise ValueError("attestation signer returned an empty signature")
+    return {
+        "schema_version": 1,
+        "status": "SIGNED",
+        "challenge_nonce_sha256": envelope["challenge_nonce_sha256"],
+        "message_sha256": message_sha256,
+        "attester_id": attester_id,
+        "trust_domain": signer.trust_domain,
+        "signature_hex": signature.hex(),
+    }
+
+
+def verify_terminal_attestation(
+    envelope: Mapping[str, object],
+    *,
+    trusted_hardware_verifiers: Mapping[str, SignatureVerifier],
+) -> None:
+    """Release verifier: test identities are rejected before signature use."""
+
+    if not isinstance(envelope, dict):
+        raise ValueError("terminal envelope must be a JSON object")
+    terminal_sha256 = envelope.get("terminal_sha256")
+    _require_sha256(terminal_sha256, "terminal_sha256")
+    unsigned = dict(envelope)
+    unsigned.pop("terminal_sha256", None)
+    unsigned.pop("attestation", None)
+    if content_sha256(unsigned) != terminal_sha256:
+        raise ValueError("terminal evidence content digest mismatch")
+    attestation = envelope.get("attestation")
+    if not isinstance(attestation, dict) or attestation.get("status") != "SIGNED":
+        raise ValueError("terminal evidence has no signed attestation")
+    attester_id = _require_id(attestation.get("attester_id"), "attester_id")
+    if (
+        attestation.get("trust_domain") != "hardware"
+        or attester_id is None
+        or attester_id.lower().startswith(("test", "fixture", "cpu"))
+    ):
+        raise ValueError("release verification rejects non-hardware test attesters")
+    if attestation.get("challenge_nonce_sha256") != envelope.get(
+        "challenge_nonce_sha256"
+    ):
+        raise ValueError("attestation challenge nonce mismatch")
+    message = _attestation_message(envelope)
+    if attestation.get("message_sha256") != content_sha256(message):
+        raise ValueError("attestation message digest mismatch")
+    signature_hex = attestation.get("signature_hex")
+    if not isinstance(signature_hex, str):
+        raise ValueError("attestation signature is missing")
+    try:
+        signature = bytes.fromhex(signature_hex)
+    except ValueError as error:
+        raise ValueError("attestation signature is not hexadecimal") from error
+    verifier = trusted_hardware_verifiers.get(attester_id)
+    if verifier is None or not verifier(canonical_json_bytes(message), signature):
+        raise ValueError("terminal attestation signature verification failed")
+
+
+class TerminalSpeculativeEvidenceLifecycle:
+    """Strict begin -> warmup -> reset -> scored -> finalize state machine."""
+
+    def __init__(
+        self,
+        *,
+        server_process_id: int,
+        server_process_started_ns: int,
+        method: str,
+        signer: TerminalAttestationSigner | None = None,
+    ) -> None:
+        self.server_process_id = _require_int(
+            server_process_id, "server_process_id", minimum=1
+        )
+        self.server_process_started_ns = _require_int(
+            server_process_started_ns, "server_process_started_ns", minimum=1
+        )
+        if method not in SUPPORTED_TERMINAL_METHODS:
+            raise ValueError("terminal evidence method is unsupported")
+        self.method = method
+        self.signer = signer
+        self.phase = "IDLE"
+        self.identity: TerminalRunIdentity | None = None
+        self.begin_receipt: dict[str, object] | None = None
+        self.reset_receipt: dict[str, object] | None = None
+        self.request_rows: dict[str, dict[str, object]] = {}
+        self.last_finalized_run_id: str | None = None
+        self.next_session_epoch = 1
+        self.reset_generation = 0
+
+    def _failed(self, error: Exception) -> None:
+        self.phase = "FAILED"
+        raise error
+
+    def fail_closed(self) -> None:
+        """Poison this process-local lifecycle after a transport-side violation."""
+
+        self.phase = "FAILED"
+
+    def begin(
+        self,
+        payload: object,
+        *,
+        prior_state: object,
+        reset_state: object,
+    ) -> dict[str, object]:
+        try:
+            if self.phase not in {"IDLE", "FINALIZED"}:
+                raise RuntimeError("terminal begin is not legal in the current phase")
+            identity = TerminalRunIdentity.from_begin_payload(payload)
+            if identity.method != self.method:
+                raise ValueError("terminal begin method differs from the server")
+            if identity.session_epoch != self.next_session_epoch:
+                raise ValueError("terminal session epoch is stale or skipped")
+            if identity.previous_run_id != self.last_finalized_run_id:
+                raise ValueError("terminal begin previous trace identity mismatch")
+            prior = validate_state_snapshot(prior_state, clean=False)
+            reset = validate_state_snapshot(reset_state, clean=True)
+            self.reset_generation += 1
+            receipt = {
+                "schema_version": 1,
+                "kind": "lightcone_terminal_begin_receipt",
+                "hook": NATIVE_TERMINAL_EVIDENCE_HOOK,
+                **identity.fields(),
+                "server_process_id": self.server_process_id,
+                "server_process_started_ns": self.server_process_started_ns,
+                "reset_generation": self.reset_generation,
+                "prior_state_sha256": content_sha256(prior),
+                "reset_state_sha256": content_sha256(reset),
+                "warmup_request_ids_sha256": content_sha256(
+                    list(identity.warmup_request_ids)
+                ),
+                "scored_request_ids_sha256": content_sha256(
+                    list(identity.scored_request_ids)
+                ),
+            }
+            receipt["begin_sha256"] = content_sha256(receipt)
+            self.identity = identity
+            self.begin_receipt = receipt
+            self.reset_receipt = None
+            self.request_rows = {}
+            self.phase = "WARMUP"
+            return dict(receipt)
+        except Exception as error:
+            self._failed(error)
+
+    def note_request_terminal(
+        self,
+        *,
+        request_id: str,
+        input_token_ids: Sequence[int],
+        output_token_ids: Sequence[int],
+        terminal_status: str,
+        terminal_reason: str,
+    ) -> None:
+        try:
+            if self.identity is None or self.phase not in {"WARMUP", "SCORED"}:
+                raise RuntimeError("request terminal row is outside an active trace")
+            request_id = _require_id(request_id, "request_id")  # type: ignore[assignment]
+            expected = (
+                self.identity.warmup_request_ids
+                if self.phase == "WARMUP"
+                else self.identity.scored_request_ids
+            )
+            if request_id not in expected:
+                raise ValueError("terminal request is foreign to the active trace")
+            if request_id in self.request_rows:
+                raise RuntimeError("terminal request identity was recorded twice")
+            if terminal_status not in {"completed", "aborted"}:
+                raise ValueError("terminal request status is unsupported")
+            terminal_reason = _require_id(terminal_reason, "terminal_reason")  # type: ignore[assignment]
+            inputs = list(input_token_ids)
+            outputs = list(output_token_ids)
+            if any(
+                not isinstance(token, int) or isinstance(token, bool) or token < 0
+                for token in (*inputs, *outputs)
+            ):
+                raise ValueError("terminal token IDs must be non-negative integers")
+            row = {
+                "request_id": request_id,
+                "terminal_source": "server",
+                "input_tokens": len(inputs),
+                "input_token_ids_sha256": content_sha256(inputs),
+                "output_tokens": len(outputs),
+                "ordered_output_token_ids": outputs,
+                "output_token_ids_sha256": content_sha256(outputs),
+                "terminal_status": terminal_status,
+                "terminal_reason": terminal_reason,
+            }
+            row["request_sha256"] = content_sha256(row)
+            self.request_rows[request_id] = row
+        except Exception as error:
+            self._failed(error)
+
+    def _client_terminal_rows(self, value: object) -> dict[str, dict[str, object]]:
+        if self.identity is None or not isinstance(value, list):
+            raise ValueError("client terminal reconciliation must be a JSON list")
+        expected = set(self.identity.scored_request_ids)
+        reconciled: dict[str, dict[str, object]] = {}
+        identity_fields = {
+            "hook": NATIVE_TERMINAL_EVIDENCE_HOOK,
+            "run_id": self.identity.run_id,
+            "run_nonce_sha256": self.identity.run_nonce_sha256,
+            "execution_plan_sha256": self.identity.execution_plan_sha256,
+            "rank_config_sha256": self.identity.rank_config_sha256,
+        }
+        for raw in value:
+            if not isinstance(raw, dict) or set(raw) != _CLIENT_TERMINAL_KEYS:
+                raise ValueError("client terminal reconciliation fields are incomplete")
+            if raw["schema_version"] != 1 or any(
+                raw[field] != expected_value
+                for field, expected_value in identity_fields.items()
+            ):
+                raise ValueError("client terminal reconciliation identity mismatch")
+            request_id = _require_id(raw["request_id"], "client.request_id")
+            if request_id not in expected:
+                raise ValueError("client terminal reconciliation has a foreign request")
+            if request_id in self.request_rows:
+                raise RuntimeError(
+                    "client terminal reconciliation cannot override a "
+                    "server terminal row"
+                )
+            if request_id in reconciled:
+                raise RuntimeError("client terminal reconciliation is duplicated")
+            status = raw["terminal_status"]
+            if status not in _CLIENT_TERMINAL_STATUSES:
+                raise ValueError("client terminal reconciliation status is unsupported")
+            _require_id(raw["terminal_reason"], "client.terminal_reason")
+            digest = _require_sha256(
+                raw["client_terminal_sha256"], "client_terminal_sha256"
+            )
+            unsigned = dict(raw)
+            unsigned.pop("client_terminal_sha256")
+            if content_sha256(unsigned) != digest:
+                raise ValueError("client terminal reconciliation digest mismatch")
+            row = {
+                **raw,
+                "terminal_source": "client_reconciliation",
+                "output_tokens": 0,
+            }
+            row["request_sha256"] = content_sha256(row)
+            reconciled[request_id] = row
+        return reconciled
+
+    def _ordered_request_rows(
+        self,
+        expected: Sequence[str],
+        *,
+        client_terminal_rows: object | None = None,
+    ) -> list[dict[str, object]]:
+        reconciled = (
+            {}
+            if client_terminal_rows is None
+            else self._client_terminal_rows(client_terminal_rows)
+        )
+        observed = {**self.request_rows, **reconciled}
+        missing = set(expected) - set(observed)
+        foreign = set(observed) - set(expected)
+        if missing or foreign:
+            raise RuntimeError(
+                "terminal request coverage mismatch: "
+                f"missing={sorted(missing)}, foreign={sorted(foreign)}"
+            )
+        return [dict(observed[request_id]) for request_id in expected]
+
+    def _validate_terminal_detail(
+        self,
+        *,
+        request_rows: Sequence[Mapping[str, object]],
+        round_rows: list[object],
+        update_rows: list[object],
+        historical_kv_source_versions: object,
+        performance_counters: dict[str, object],
+    ) -> None:
+        if self.identity is None:
+            raise RuntimeError("terminal detail has no active identity")
+        expected = set(self.identity.scored_request_ids)
+        if self.method in {"target_only", "static"}:
+            if round_rows or update_rows or historical_kv_source_versions != {}:
+                raise RuntimeError(
+                    "allocation-free terminal evidence contains detailed traces"
+                )
+            return
+
+        if not round_rows or not update_rows:
+            raise RuntimeError(
+                "adapted terminal evidence requires round and update rows"
+            )
+        if not isinstance(historical_kv_source_versions, dict):
+            raise ValueError("historical KV evidence must be a JSON object")
+
+        completed = {
+            row["request_id"]
+            for row in request_rows
+            if row["terminal_status"] == "completed"
+        }
+        covered_round_requests: set[str] = set()
+        round_identities: set[tuple[str, int]] = set()
+        for raw in round_rows:
+            if not isinstance(raw, dict):
+                raise ValueError("terminal round row is malformed")
+            required = {
+                "request_id",
+                "round_index",
+                "proposal_source_version",
+                "prefix_len_before",
+                "verify_len",
+                "accepted_drafts",
+                "committed_tokens",
+                "target_calls",
+                "historical_kv_source_versions",
+                "round_sha256",
+            }
+            if set(raw) != required:
+                raise ValueError("terminal round row fields are incomplete")
+            request_id = _require_id(raw["request_id"], "round.request_id")
+            if request_id not in expected:
+                raise RuntimeError("terminal round row has a foreign request")
+            round_index = _require_int(raw["round_index"], "round.round_index")
+            identity = (request_id, round_index)
+            if identity in round_identities:
+                raise RuntimeError("terminal round identity is duplicated")
+            round_identities.add(identity)
+            covered_round_requests.add(request_id)
+            for field in (
+                "proposal_source_version",
+                "prefix_len_before",
+                "verify_len",
+                "accepted_drafts",
+                "committed_tokens",
+                "target_calls",
+            ):
+                _require_int(raw[field], f"round.{field}")
+            if raw["target_calls"] != 1:
+                raise RuntimeError("terminal round target-call accounting is malformed")
+            if raw["accepted_drafts"] > raw["verify_len"]:
+                raise RuntimeError(
+                    "terminal round accepts more drafts than it verifies"
+                )
+            if not isinstance(raw["historical_kv_source_versions"], list):
+                raise ValueError("terminal round historical KV rows are malformed")
+            if raw["historical_kv_source_versions"] != (
+                historical_kv_source_versions.get(request_id)
+            ):
+                raise RuntimeError(
+                    "terminal round historical KV evidence disagrees with "
+                    "the terminal map"
+                )
+            digest = _require_sha256(raw["round_sha256"], "round_sha256")
+            unsigned = dict(raw)
+            unsigned.pop("round_sha256")
+            if content_sha256(unsigned) != digest:
+                raise ValueError("terminal round content digest mismatch")
+        if not completed.issubset(covered_round_requests):
+            raise RuntimeError("completed adapted requests lack round evidence")
+        aggregate_fields = {
+            "target_calls": "target_calls",
+            "accepted_drafts": "accepted_drafts",
+            "committed_tokens": "committed_tokens",
+            "verified_drafts": "verify_len",
+        }
+        for performance_field, round_field in aggregate_fields.items():
+            if performance_counters[performance_field] != sum(
+                int(row[round_field]) for row in round_rows
+            ):
+                raise RuntimeError(
+                    "adapted aggregate counters disagree with terminal round rows"
+                )
+        if set(historical_kv_source_versions) != covered_round_requests:
+            raise RuntimeError("historical KV request coverage is incomplete")
+
+        for request_id, raw_segments in historical_kv_source_versions.items():
+            if not isinstance(raw_segments, list):
+                raise ValueError("historical KV segments are malformed")
+            previous_end = 0
+            for segment in raw_segments:
+                if not isinstance(segment, dict) or set(segment) != {
+                    "start",
+                    "end",
+                    "source_version",
+                }:
+                    raise ValueError("historical KV segment fields are incomplete")
+                start = _require_int(segment["start"], f"kv.{request_id}.start")
+                end = _require_int(segment["end"], f"kv.{request_id}.end")
+                _require_int(
+                    segment["source_version"], f"kv.{request_id}.source_version"
+                )
+                if start != previous_end or end <= start:
+                    raise RuntimeError("historical KV segments are not contiguous")
+                previous_end = end
+
+        update_request_coverage: set[str] = set()
+        for expected_index, raw in enumerate(update_rows):
+            if not isinstance(raw, dict):
+                raise ValueError("terminal update row is malformed")
+            required = {
+                "update_index",
+                "cohort_sha256",
+                "cohort_epoch",
+                "parameter_layout_sha256",
+                "source_round",
+                "source_version",
+                "request_ids",
+                "prefix_len_before",
+                "optimizer_step",
+                "published_version",
+                "status",
+                "loss",
+                "gradient_norm",
+                "reconstruction_ok",
+                "reconstruction_max_abs",
+                "reconstruction_relative_rms",
+                "reconstruction_top1_match",
+                "supervision_nonempty",
+                "reconstruction_mean_kl",
+                "online_hint_error",
+                "online_ensemble_entropy",
+                "online_effective_experts",
+                "online_expert_probabilities",
+                "online_cumulative_losses",
+                "online_expert_gradient_norms",
+                "update_sha256",
+            }
+            if set(raw) != required:
+                raise ValueError("terminal update row fields are incomplete")
+            if raw["update_index"] != expected_index:
+                raise RuntimeError("terminal update indexes are not contiguous")
+            _require_sha256(raw["cohort_sha256"], "update.cohort_sha256")
+            _require_sha256(
+                raw["parameter_layout_sha256"], "update.parameter_layout_sha256"
+            )
+            for field in (
+                "cohort_epoch",
+                "source_round",
+                "source_version",
+                "optimizer_step",
+            ):
+                _require_int(raw[field], f"update.{field}")
+            request_ids = _request_ids(raw["request_ids"], "update.request_ids")
+            if not request_ids or not set(request_ids).issubset(expected):
+                raise RuntimeError(
+                    "terminal update request coverage is foreign or empty"
+                )
+            update_request_coverage.update(request_ids)
+            if not isinstance(raw["prefix_len_before"], list) or len(
+                raw["prefix_len_before"]
+            ) != len(request_ids):
+                raise ValueError("terminal update prefix coverage is malformed")
+            for prefix in raw["prefix_len_before"]:
+                _require_int(prefix, "update.prefix_len_before")
+            published = raw["published_version"]
+            if published is not None:
+                _require_int(published, "update.published_version")
+            digest = _require_sha256(raw["update_sha256"], "update_sha256")
+            unsigned = dict(raw)
+            unsigned.pop("update_sha256")
+            if content_sha256(unsigned) != digest:
+                raise ValueError("terminal update content digest mismatch")
+        if not update_request_coverage.issubset(covered_round_requests):
+            raise RuntimeError("terminal update rows lack matching round evidence")
+        if performance_counters["updates_launched"] != len(update_rows):
+            raise RuntimeError("terminal update counter disagrees with native rows")
+        if performance_counters["updates_published"] != sum(
+            raw["status"] == "published" for raw in update_rows
+        ):
+            raise RuntimeError(
+                "terminal publication counter disagrees with native rows"
+            )
+
+    def reset(
+        self,
+        *,
+        begin_sha256: str,
+        discarded_native_sha256: str,
+        warmup_performance_counters: object,
+        warmup_state: object,
+        reset_state: object,
+    ) -> dict[str, object]:
+        try:
+            if self.phase != "WARMUP" or self.identity is None:
+                raise RuntimeError("terminal reset is not legal in the current phase")
+            if self.begin_receipt is None or begin_sha256 != self.begin_receipt.get(
+                "begin_sha256"
+            ):
+                raise ValueError("terminal reset begin receipt mismatch")
+            _require_sha256(discarded_native_sha256, "discarded_native_sha256")
+            warmup_performance_counters = validate_performance_counters(
+                warmup_performance_counters, method=self.method
+            )
+            warmup = validate_state_snapshot(warmup_state, clean=False)
+            reset = validate_state_snapshot(reset_state, clean=True)
+            warmup_rows = self._ordered_request_rows(self.identity.warmup_request_ids)
+            self.reset_generation += 1
+            receipt = {
+                "schema_version": 1,
+                "kind": "lightcone_terminal_reset_receipt",
+                "hook": NATIVE_TERMINAL_EVIDENCE_HOOK,
+                **self.identity.fields(),
+                "server_process_id": self.server_process_id,
+                "server_process_started_ns": self.server_process_started_ns,
+                "begin_sha256": begin_sha256,
+                "reset_generation": self.reset_generation,
+                "prior_trace_run_id": self.identity.previous_run_id,
+                "next_trace_run_id": self.identity.run_id,
+                "warmup_request_rows_sha256": content_sha256(warmup_rows),
+                "warmup_performance_sha256": content_sha256(
+                    warmup_performance_counters
+                ),
+                "discarded_native_sha256": discarded_native_sha256,
+                "warmup_state_sha256": content_sha256(warmup),
+                "reset_state_sha256": content_sha256(reset),
+                "expected_scored_request_ids_sha256": content_sha256(
+                    list(self.identity.scored_request_ids)
+                ),
+                "completion_event_generation": reset["completion_event_generation"],
+            }
+            receipt["reset_sha256"] = content_sha256(receipt)
+            self.reset_receipt = receipt
+            self.request_rows = {}
+            self.phase = "SCORED"
+            return dict(receipt)
+        except Exception as error:
+            self._failed(error)
+
+    def finalize(
+        self,
+        *,
+        reset_sha256: str,
+        round_rows: object,
+        update_rows: object,
+        performance_counters: object,
+        historical_kv_source_versions: object,
+        client_terminal_rows: object,
+        final_state: object,
+    ) -> dict[str, object]:
+        try:
+            if self.phase != "SCORED" or self.identity is None:
+                raise RuntimeError(
+                    "terminal finalize is not legal in the current phase"
+                )
+            if self.reset_receipt is None or reset_sha256 != self.reset_receipt.get(
+                "reset_sha256"
+            ):
+                raise ValueError("terminal finalize reset receipt mismatch")
+            if not isinstance(round_rows, list) or not isinstance(update_rows, list):
+                raise ValueError("terminal round/update evidence must be JSON lists")
+            _validate_finite_json(round_rows, "round_rows")
+            _validate_finite_json(update_rows, "update_rows")
+            performance_counters = validate_performance_counters(
+                performance_counters, method=self.method
+            )
+            _validate_finite_json(
+                historical_kv_source_versions, "historical_kv_source_versions"
+            )
+            final = validate_state_snapshot(final_state, clean=False)
+            if (
+                not final["scheduler_idle"]
+                or final["active_requests"] != 0
+                or final["queued_requests"] != 0
+            ):
+                raise RuntimeError("terminal finalize requires a drained scheduler")
+            request_rows = self._ordered_request_rows(
+                self.identity.scored_request_ids,
+                client_terminal_rows=client_terminal_rows,
+            )
+            self._validate_terminal_detail(
+                request_rows=request_rows,
+                round_rows=round_rows,
+                update_rows=update_rows,
+                historical_kv_source_versions=historical_kv_source_versions,
+                performance_counters=performance_counters,
+            )
+            terminal = {
+                "schema_version": 1,
+                "hook": NATIVE_TERMINAL_EVIDENCE_HOOK,
+                **self.identity.fields(),
+                "server_process_id": self.server_process_id,
+                "server_process_started_ns": self.server_process_started_ns,
+                "expected_request_ids": list(self.identity.scored_request_ids),
+                "reset_receipt_sha256": reset_sha256,
+                "request_round_rows": {
+                    "requests": request_rows,
+                    "rounds": round_rows,
+                },
+                "update_rows": update_rows,
+                "performance_counters": performance_counters,
+                "historical_kv_source_versions": historical_kv_source_versions,
+                "final_state": final,
+                "completion_marker": "TERMINAL_COMPLETE",
+            }
+            terminal["terminal_sha256"] = content_sha256(terminal)
+            terminal["attestation"] = build_terminal_attestation(terminal, self.signer)
+            self.phase = "FINALIZED"
+            self.last_finalized_run_id = self.identity.run_id
+            self.next_session_epoch += 1
+            self.request_rows = {}
+            return terminal
+        except Exception as error:
+            self._failed(error)
