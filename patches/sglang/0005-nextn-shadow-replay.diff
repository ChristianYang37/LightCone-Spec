+    # query-head contributions, while the column input collects hidden gradients.
+    weight = _tp_copy(module.weight) if replicated else module.weight
+    return F.linear(_tp_copy(value), weight, getattr(module, "bias", None))
+
+
+def _row(module, value):
+    from sglang.srt.speculative.dflash_online_adaptation import _TensorParallelSum
+
+    local = F.linear(value, module.weight, None)
+    group = get_tp_group()
+    output = _TensorParallelSum.apply(local, group.device_group) if group.world_size > 1 else local
+    bias = getattr(module, "bias", None)
+    return output if bias is None else output + bias
+
+
+def _replay_attention(attention, hidden, positions, history, *, eagle):
+    batch, count = history[2].shape[0], hidden.shape[0] // history[2].shape[0]
+    query = _column(attention.q_proj, hidden).view(
+        batch, count, attention.num_heads, attention.head_dim
+    )
+    replicated = attention.total_num_kv_heads == 1 and get_tp_group().world_size > 1
+    key = _column(attention.k_proj, hidden, replicated=replicated).view(
+        batch, count, attention.num_kv_heads, attention.head_dim
+    )
+    value = (
+        key
+        if attention.tied_kv
+        else _column(attention.v_proj, hidden, replicated=replicated).view_as(key)
+    )
+    query = gemma_rms(query, _tp_copy(attention.q_norm.weight), attention.q_norm.eps)
+    key = gemma_rms(key, _tp_copy(attention.k_norm.weight), attention.k_norm.eps)
+    value = gemma_rms(value, None, attention.v_norm.eps)
+    positions = positions.reshape(batch, count)
+    cache = attention.rotary_emb.cos_sin_cache
+    query, key = gemma_rotary(query, positions, cache), gemma_rotary(key, positions, cache)
+    attended = gemma_canvas_attention(query, key, value, *history, causal_canvas=eagle)
+    return _row(attention.o_proj, attended.reshape(-1, attention.q_size))
+
+
+def _replay_mlp(mlp, hidden):
+    gate, up = _column(mlp.gate_up_proj, hidden).chunk(2, dim=-1)
+    return _row(mlp.down_proj, F.gelu(gate, approximate="tanh") * up)
+
+
+class GemmaReplay:
+    """Latest-round replay reads a snapshot of actual active-bank inference KV."""
+
+    def capture_training_context(self, forward_batch, runner, *, step_kv=None):
+        from lightcone_spec.nextn import ragged_history_locations
+
+        with torch.inference_mode(False), torch.no_grad():
+            if hasattr(self, "model"):
+                if step_kv is None:
+                    raise RuntimeError("Eagle replay requires owned per-step KV metadata")
+                locations, valid = ragged_history_locations(*step_kv)
+            else:
+                lengths = forward_batch.seq_lens
+                positions = torch.arange(int(lengths.max().item()), device=lengths.device)
+                valid = positions[None] < lengths[:, None]
+                locations = runner.req_to_token_pool.req_to_token[
+                    forward_batch.req_pool_indices[:, None], positions[None]
+                ]
+                locations = locations.masked_fill(~valid, 0).long()
+            backbone = self.model if hasattr(self, "model") else self
+            pool = runner.token_to_kv_pool
+            histories = []
+            for layer in backbone.layers:
+                buffers = pool.get_kv_buffer(layer.self_attn.attn.layer_id)
+
+                def gather(buffer):
+                    if buffer.ndim == 3:
+                        return buffer[locations].detach().clone()
+                    page_size = int(runner.server_args.page_size)
+                    pages, offsets = locations // page_size, locations % page_size
+                    return buffer[pages, :, offsets, :].detach().clone()
+
+                histories.append((gather(buffers[0]), gather(buffers[1]), valid.detach().clone()))
+            self._training_histories = histories
+
+    def _replay_hidden(self, input_ids, positions, forward_batch, input_embeds=None):
+        histories = getattr(self, "_training_histories", None)
+        if histories is None:
+            raise RuntimeError("Gemma update lacks owned full-history KV snapshot")
+        # Consume the context once; tensors remain owned by this autograd graph.
+        self._training_histories = None
+        eagle = hasattr(self, "model")
+        backbone = self.model if eagle else self
+        with torch.no_grad():
+            embeds = backbone.embed_tokens(input_ids) * (self.config.hidden_size**0.5)
+        if input_embeds is not None:
+            embeds = input_embeds.detach()
+        if eagle:
+            hidden = forward_batch.spec_info.hidden_states.detach()
+            if hidden.shape[-1] != self.config.hidden_size:
+                hidden = F.linear(hidden, backbone.fc.weight)
+        else:
+            hidden = embeds
+        for layer, history in zip(backbone.layers, histories, strict=True):
+            inputs = (
+                torch.cat((layer.input_layernorm(embeds), layer.hidden_norm(hidden)), dim=-1)
+                if eagle
+                else layer.input_layernorm(hidden)
+            )
+            attended = _replay_attention(layer.self_attn, inputs, positions, history, eagle=eagle)
+            hidden = hidden + layer.post_attention_layernorm(attended)
+            hidden = hidden + layer.post_feedforward_layernorm(
+                _replay_mlp(layer.mlp, layer.pre_feedforward_layernorm(hidden))
+            )
+            hidden = hidden * layer.layer_scalar
+        return backbone.norm(hidden), hidden
+
+    def _replay_logits(self, hidden):
+        from sglang.srt.speculative.dflash_online_adaptation import _TensorParallelAllGather
+
+        logits = F.linear(_tp_copy(hidden.to(self.lm_head.weight.dtype)), self.lm_head.weight)
+        group = get_tp_group()
+        if group.world_size > 1:
+            logits = _TensorParallelAllGather.apply(logits, group.device_group)
+        logits = logits[..., : self.config.vocab_size]
+        cap = getattr(self.config, "final_logit_softcapping", None)
+        # Qwen's native head is model dtype; do not change Markov arithmetic
+        # merely because a differentiable replay is enabled on this round.
+        return gemma_softcap(logits.float(), cap) if cap is not None else logits
+
+    def check_training_reconstruction(self, valid_mask):
+        from sglang.srt.speculative.dflash_online_adaptation import _logit_reconstruction_gate
+
+        rows = getattr(self, "_reconstruction_rows", [])
+        self._reconstruction_rows = []
+        if not rows:
+            raise RuntimeError("Gemma update has no native/replay comparison")
+        native = torch.cat([row[0] for row in rows], dim=0)
+        replay = torch.cat([row[1] for row in rows], dim=0)
+        mask = valid_mask.reshape(-1)
+        if mask.numel() != native.shape[0]:
+            raise RuntimeError("Gemma reconstruction mask ownership mismatch")
+        stats = _logit_reconstruction_gate(
+            native,
+            replay,
+            valid_mask=mask,
+            numerical_unit=max(float(torch.finfo(self.lm_head.weight.dtype).eps), 1e-3),
+        )
+        self._last_reconstruction = dict(
+            zip(
+                ("ok", "max_abs", "relative_rms", "top1", "kl"),
+                [value.item() for value in stats],
+                strict=True,
+            )
+        )
+        return bool(stats[0].item())
+
+
+class GemmaDraftNorm(nn.Module):
+    """Use explicit differentiable norm, including learned scale, on update rounds."""
+
+    def __init__(self, dimension, epsilon, with_scale=True):
+        super().__init__()
+        self.eps = self.variance_epsilon = float(epsilon)
+        if with_scale:
+            self.weight = nn.Parameter(torch.ones(dimension))
+        else:
+            self.register_parameter("weight", None)
+
+    def forward(self, value):
+        return gemma_rms(value, self.weight, self.eps)
+
+
+class GemmaDraftAttention(nn.Module):
+    def __init__(self, config, layer_id, quant_config=None, *, eagle=False):
+        super().__init__()
+        if quant_config is not None:
+            raise ValueError("Gemma draft transfer currently requires unquantized official weights")
+        parallel = get_parallel()
+        self.total_num_heads = int(config.num_attention_heads)
+        self.head_dim = int(config.global_head_dim)
+        self.tied_kv = bool(config.attention_k_eq_v)
+        self.total_num_kv_heads = int(
+            config.num_global_key_value_heads if self.tied_kv else config.num_key_value_heads
+        )
+        if self.total_num_heads % parallel.tp_size:
+            raise ValueError("Gemma query heads cannot be partitioned across TP ranks")
+        self.num_heads = self.total_num_heads // parallel.tp_size
+        # One global KV head is replicated, never split into fractions of a head.
+        kv_tp = min(parallel.tp_size, self.total_num_kv_heads)
+        if self.total_num_kv_heads % kv_tp or parallel.tp_size % kv_tp:
+            raise ValueError("Gemma KV heads do not support this TP layout")
+        kv_rank = parallel.tp_rank // (parallel.tp_size // kv_tp)
+        self.num_kv_heads = self.total_num_kv_heads // kv_tp
+        self.q_size = self.num_heads * self.head_dim
+        self.kv_size = self.num_kv_heads * self.head_dim
+        self.scaling = 1.0
+        self.sliding_window_size = -1
+        self.attn_type = AttentionType.DECODER if eagle else AttentionType.ENCODER_ONLY
+        input_size = int(config.hidden_size) * (2 if eagle else 1)
+        bias = bool(config.attention_bias)
+        self.q_proj = ColumnParallelLinear(
+            input_size, self.total_num_heads * self.head_dim, bias=bias
+        )
+        self.k_proj = ColumnParallelLinear(
+            input_size,
+            self.total_num_kv_heads * self.head_dim,
+            bias=bias,
+            tp_size=kv_tp,
+            tp_rank=kv_rank,
+        )
+        self.v_proj = (
+            None
+            if self.tied_kv
+            else ColumnParallelLinear(
+                input_size,
+                self.total_num_kv_heads * self.head_dim,
+                bias=bias,
+                tp_size=kv_tp,
+                tp_rank=kv_rank,
+            )
+        )
+        self.o_proj = RowParallelLinear(
+            self.total_num_heads * self.head_dim, config.hidden_size, bias=bias
+        )
+        self.q_norm = GemmaDraftNorm(self.head_dim, config.rms_norm_eps)
+        self.k_norm = GemmaDraftNorm(self.head_dim, config.rms_norm_eps)
+        self.v_norm = GemmaDraftNorm(self.head_dim, config.rms_norm_eps, with_scale=False)
+        rope = config.rope_parameters["full_attention"]
+        self.rotary_emb = get_rope(
+            self.head_dim,
+            rotary_dim=self.head_dim,
+            max_position=config.max_position_embeddings,
+            base=rope["rope_theta"],
+            rope_scaling={"rope_type": rope.get("rope_type", "default")},
+            partial_rotary_factor=rope.get("partial_rotary_factor", 1.0),
+            is_neox_style=True,
+        )
+        self.attn = RadixAttention(
+            num_heads=self.num_heads,
+            head_dim=self.head_dim,
+            scaling=1.0,
+            num_kv_heads=self.num_kv_heads,
+            layer_id=layer_id,
+            attn_type=self.attn_type,
+        )
+
+    def kv_proj_only(self, hidden):
+        key, _ = self.k_proj(hidden)
+        value = key if self.tied_kv else self.v_proj(hidden)[0]
+        # Context injector normalizes/rotates K afterwards. V has its own no-scale norm.
+        return key, self.v_norm(value.view(-1, self.num_kv_heads, self.head_dim)).flatten(-2)
+
+    def apply_k_norm(self, key):
+        return self.k_norm(key.view(-1, self.num_kv_heads, self.head_dim)).flatten(-2)
+
+    def apply_k_rope(self, positions, key):
+        _, key = self.rotary_emb(positions, torch.empty_like(key), key)
+        return key
+
+    def forward(self, positions, hidden_states, forward_batch):
+        query, _ = self.q_proj(hidden_states)
+        key, value = self.kv_proj_only(hidden_states)
+        query = self.q_norm(query.view(-1, self.num_heads, self.head_dim)).flatten(-2)
+        key = self.apply_k_norm(key)
+        query, key = self.rotary_emb(positions, query, key)
+        output = self.attn(query, key, value, forward_batch)
+        return self.o_proj(output)[0]
+
+
+class GemmaDraftMLP(nn.Module):
+    def __init__(self, config, quant_config=None):
+        super().__init__()
+        if getattr(config, "hidden_activation", getattr(config, "hidden_act", None)) not in {
+            "gelu_pytorch_tanh",
+            "gelu_new",
+        }:
+            raise ValueError("Gemma draft requires the official tanh-GELU activation")
+        self.gate_up_proj = MergedColumnParallelLinear(
+            config.hidden_size,
+            [config.intermediate_size] * 2,
+            bias=False,
+        )
+        self.down_proj = RowParallelLinear(config.intermediate_size, config.hidden_size, bias=False)
+
+    def forward(self, hidden):
+        gate, up = self.gate_up_proj(hidden)[0].chunk(2, dim=-1)
+        return self.down_proj(F.gelu(gate, approximate="tanh") * up)[0]
+
+
+class GemmaDraftDecoder(nn.Module):
+    def __init__(self, config, layer_id, quant_config=None):
+        super().__init__()
+        if bool(getattr(config, "enable_moe_block", False)) or int(
+            getattr(config, "hidden_size_per_layer_input", 0)
+        ):
+            raise ValueError("Gemma draft integration supports official dense, ungated checkpoints")
+        self.self_attn = GemmaDraftAttention(config, layer_id, quant_config)
+        self.mlp = GemmaDraftMLP(config, quant_config)
+        for name in (
+            "input_layernorm",
+            "post_attention_layernorm",
+            "pre_feedforward_layernorm",
+            "post_feedforward_layernorm",
+        ):
+            setattr(self, name, GemmaDraftNorm(config.hidden_size, config.rms_norm_eps))
+        self.register_buffer("layer_scalar", torch.ones(1))
+
+    def forward(self, positions, hidden_states, forward_batch, residual=None):
+        if residual is not None:
+            raise ValueError("Gemma carries its residual explicitly, not Qwen's fused residual")
+        attention = self.self_attn(positions, self.input_layernorm(hidden_states), forward_batch)
+        hidden = hidden_states + self.post_attention_layernorm(attention)
+        hidden = hidden + self.post_feedforward_layernorm(
+            self.mlp(self.pre_feedforward_layernorm(hidden))
+        )
+        return hidden * self.layer_scalar, None
+
+
+class GemmaDraftBackbone(DFlashDraftModel):
+    decoder_layer_cls = GemmaDraftDecoder
+    supports_fused_context_kv = False
+
+    def __init__(self, config, quant_config=None, prefix=""):
+        super().__init__(config, quant_config=quant_config, prefix=prefix)
+        self.norm = GemmaDraftNorm(config.hidden_size, config.rms_norm_eps)
+        self.hidden_norm = GemmaDraftNorm(config.hidden_size, config.rms_norm_eps)
+
+    def get_attention_sliding_window_size(self):
+        return None
+
+    def load_weights(self, weights):
+        parameters = {name.removeprefix("model."): value for name, value in self.named_parameters()}
+        buffers = {name.removeprefix("model."): value for name, value in self.named_buffers()}
+        loaded, shard_names = set(), {}
+        for name, value in weights:
+            name = name.removeprefix("model.")
+            if name.startswith("rotary_emb.") or ".rotary_emb." in name:
+                continue
+            shard = None
+            for source, index in ((".gate_proj.", 0), (".up_proj.", 1)):
+                if source in name:
+                    name = name.replace(source, ".gate_up_proj.")
+                    shard = index
+                    break
+            destination = parameters.get(name, buffers.get(name))
+            if destination is None:
+                raise ValueError(f"unconsumed Gemma draft checkpoint weight: {name}")
+            loader = getattr(destination, "weight_loader", default_weight_loader)
+            if shard is None:
+                loader(destination, value)
+                loaded.add(name)
+            else:
+                loader(destination, value, shard)
+                shard_names.setdefault(name, set()).add(shard)
+                if shard_names[name] == {0, 1}:
+                    loaded.add(name)
+        required = {
+            name for name in parameters if not name.startswith(("markov_head.", "confidence_head."))
+        }
+        required.update(name for name in buffers if name.endswith("layer_scalar"))
+        missing = required - loaded
+        if missing:
+            raise ValueError(f"missing Gemma draft checkpoint weights: {sorted(missing)}")
+
+
+class Gemma4DSparkModel(GemmaReplay, DSparkDraftMixin, GemmaDraftBackbone):
+    owns_checkpoint_embed_head = True
+    requires_complete_gradients = True
+
+    def __init__(self, config, quant_config=None, prefix=""):
+        super().__init__(config, quant_config=quant_config, prefix=prefix)
+        self.embed_tokens = VocabParallelEmbedding(
+            config.vocab_size, config.hidden_size, prefix="embed_tokens"
+        )
+        self.lm_head = ParallelLMHead(
+            config.vocab_size, config.hidden_size, quant_config=quant_config, prefix="lm_head"
+        )
+
+    def forward_embed(self, input_ids):
+        return self.embed_tokens(input_ids) * (self.config.hidden_size**0.5)
+
+    def _stacked_ctx_kv_params(self):
+        return None
+
+    def forward(self, input_ids, positions, forward_batch, input_embeds=None, **kwargs):
+        if not torch.is_grad_enabled():
+            return super().forward(input_ids, positions, forward_batch, input_embeds, **kwargs)
+        with torch.no_grad():
+            native = super().forward(input_ids, positions, forward_batch, input_embeds, **kwargs)
+            native_logits = self._replay_logits(native.hidden_states)
+        replay, _ = self._replay_hidden(input_ids, positions, forward_batch, input_embeds)
+        replay_logits = self._replay_logits(replay)
+        self._reconstruction_rows = [(native_logits.detach(), replay_logits.detach())]
+        # Sampling sees actual native logits; gradients use the independently
+        # checked replay. A later owned-mask gate is mandatory before publication.
+        native.hidden_states = native.hidden_states.detach() + (replay - replay.detach())
+        return native
+
+    def compute_base_logits_and_hidden(self, hidden):
+        hidden = hidden.to(self.lm_head.weight.dtype)
+        if torch.is_grad_enabled():
+            return self._replay_logits(hidden), None, hidden
+        logits = gather_and_crop_vocab(hidden @ self.lm_head.weight.T, self.lm_head)
+        logits = gemma_softcap(logits.float(), getattr(self.config, "final_logit_softcapping", None))
+        # Markov correction is applied later, after the base-logit softcap.
+        return logits, None, hidden
+
+
+class GemmaEagleDecoder(GemmaDraftDecoder):
+    def __init__(self, config, layer_id, quant_config=None):
+        super().__init__(config, layer_id, quant_config)
+        self.self_attn = GemmaDraftAttention(config, layer_id, quant_config, eagle=True)
+        self.hidden_norm = GemmaDraftNorm(config.hidden_size, config.rms_norm_eps)
+
+    def forward(self, positions, embeds, hidden, forward_batch):
+        joined = torch.cat((self.input_layernorm(embeds), self.hidden_norm(hidden)), dim=-1)
+        hidden = hidden + self.post_attention_layernorm(
+            self.self_attn(positions, joined, forward_batch)
+        )
+        hidden = hidden + self.post_feedforward_layernorm(
+            self.mlp(self.pre_feedforward_layernorm(hidden))
+        )
+        return hidden * self.layer_scalar
+
+
+class GemmaEagleBackbone(nn.Module):
+    def __init__(self, config, quant_config=None):
+        super().__init__()
+        self.config = config
+        self.embed_tokens = VocabParallelEmbedding(
+            config.vocab_size, config.hidden_size, prefix="model.embed_tokens"
+        )
+        self.fc = nn.Linear(
+            len(config.target_layer_ids) * config.hidden_size, config.hidden_size, bias=False
+        )
+        self.layers = nn.ModuleList(
+            [
+                GemmaEagleDecoder(config, index, quant_config)
+                for index in range(config.num_hidden_layers)
+            ]
+        )
+        self.norm = GemmaDraftNorm(config.hidden_size, config.rms_norm_eps)
+
+    def forward(
+        self, input_ids, positions, forward_batch, input_embeds=None, pp_proxy_tensors=None
+    ):
+        embeds = (
+            self.embed_tokens(input_ids) * (self.config.hidden_size**0.5)
+            if input_embeds is None
+            else input_embeds
+        )
+        hidden = forward_batch.spec_info.hidden_states
+        if hidden.shape[-1] != self.config.hidden_size:
+            hidden = self.fc(hidden)
+        for layer in self.layers:
+            hidden = layer(positions, embeds, hidden, forward_batch)
+        # Eagle's next round consumes pre-final-norm hidden; logits consume norm once.
+        return self.norm(hidden), [hidden]
+
+
+class Gemma4Eagle3Model(GemmaReplay, LlamaForCausalLMEagle3):
+    owns_checkpoint_embed_head = True
+    requires_complete_gradients = True
+
+    def __init__(self, config, quant_config=None, prefix=""):
+        nn.Module.__init__(self)
+        self.config = copy.deepcopy(config)
+        self.config.draft_vocab_size = config.vocab_size
+        self.quant_config = quant_config
+        self.pp_group = get_pp_group()
+        self._draft_window_size = get_server_args().speculative_draft_window_size
+        self.model = GemmaEagleBackbone(self.config, quant_config)
+        self.lm_head = ParallelLMHead(
+            config.vocab_size, config.hidden_size, quant_config=quant_config, prefix="lm_head"
+        )
+        self.logits_processor = LogitsProcessor(self.config)
+        self.capture_aux_hidden_states = True
+        self.load_lm_head_from_target = False
+        self.hot_token_id = None
+        if self._draft_window_size is not None:
+            for layer in self.model.layers:
+                layer.self_attn.attn.sliding_window_size = self._draft_window_size
+
+    def load_weights(self, weights):
+        GemmaDraftBackbone.load_weights(self, weights)
+
+    def forward(self, input_ids, positions, forward_batch, input_embeds=None, **kwargs):
+        updating = torch.is_grad_enabled()
+        with torch.no_grad():
+            native = super().forward(input_ids, positions, forward_batch, input_embeds, **kwargs)
+        if not updating:
+            return native
+        replay, auxiliary = self._replay_hidden(input_ids, positions, forward_batch, input_embeds)
+        logits = self._replay_logits(replay)
+        rows = getattr(self, "_reconstruction_rows", [])
+        rows.append((native.next_token_logits.detach(), logits.detach()))
+        self._reconstruction_rows = rows
+        native.next_token_logits = native.next_token_logits.detach() + (logits - logits.detach())
+        if native.hidden_states.shape != auxiliary.shape:
+            raise RuntimeError("Gemma EAGLE auxiliary hidden alignment mismatch")
+        native.hidden_states = native.hidden_states.detach() + (auxiliary - auxiliary.detach())
+        return native
+
+
+EntryClass = [Gemma4DSparkModel, Gemma4Eagle3Model]
