+def _block_fp8_slot(
+    name: str,
+    raw_name: str,
+    module: torch.nn.Module,
+    weight: torch.Tensor,
+    parameter_indices: tuple[int, ...],
+) -> PublicationSlot:
+    parent_name, _, leaf = raw_name.rpartition(".")
+    scale_attribute = (
+        "weight_scale_inv" if leaf == "weight" else f"{leaf}_scale_inv"
+    )
+    scale = getattr(module, scale_attribute, None)
+    if scale is None or scale.ndim != weight.ndim:
+        raise ValueError(f"{name} uses an unsupported FP8 publication layout")
+    block_n = math.ceil(weight.shape[-2] / scale.shape[-2])
+    block_k = math.ceil(weight.shape[-1] / scale.shape[-1])
+
+    def expanded_scale(value: torch.Tensor) -> torch.Tensor:
+        return (
+            value.repeat_interleave(block_n, dim=-2)
+            .repeat_interleave(block_k, dim=-1)[..., : weight.shape[-2], : weight.shape[-1]]
+        )
+
+    base = weight.float() * expanded_scale(scale.float())
+
+    def quantize(value: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        rows, columns = value.shape[-2:]
+        padded_rows = scale.shape[-2] * block_n
+        padded_columns = scale.shape[-1] * block_k
+        padded = torch.nn.functional.pad(
+            value.float(), (0, padded_columns - columns, 0, padded_rows - rows)
+        )
+        grouped = padded.reshape(
+            *value.shape[:-2], scale.shape[-2], block_n, scale.shape[-1], block_k
+        )
+        candidate_scale = grouped.abs().amax(dim=(-3, -1)).clamp_min(1e-12) / 448.0
+        quantized = (value.float() / expanded_scale(candidate_scale)).clamp(-448, 448)
+        return quantized.to(weight.dtype), candidate_scale.to(scale.dtype)
+
+    return PublicationSlot(
+        name=name,
+        live_weight=weight,
+        base_master=base,
+        parameter_indices=parameter_indices,
+        live_scale=scale,
+        scale_name=f"{parent_name}.{scale_attribute}",
+        quantize=quantize,
+    )
+
+
+def _publication_slot(
+    name: str,
