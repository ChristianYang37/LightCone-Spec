+
+    def forward(self, input_ids, positions, forward_batch, input_embeds=None, **kwargs):
+        if not torch.is_grad_enabled():
+            return super().forward(input_ids, positions, forward_batch, input_embeds, **kwargs)
+        with torch.no_grad():
+            native = super().forward(input_ids, positions, forward_batch, input_embeds, **kwargs)
+            native_logits = (
+                native.next_token_logits
+                if hasattr(self, "model")
+                else self._replay_logits(native.hidden_states)
+            )
+        hidden, auxiliary = self._replay_hidden(input_ids, positions, forward_batch, input_embeds)
+        logits = self._replay_logits(hidden)
+        rows = getattr(self, "_reconstruction_rows", [])
+        rows.append((native_logits.detach(), logits.detach()))
+        self._reconstruction_rows = rows
+        if hasattr(self, "model"):
+            native.next_token_logits = native_logits.detach() + (logits - logits.detach())
+            replay = auxiliary
+        else:
+            replay = hidden
+        native.hidden_states = native.hidden_states.detach() + (replay - replay.detach())
+        return native
+
+    def compute_base_logits_and_hidden(self, hidden):
+        if torch.is_grad_enabled():
+            return self._replay_logits(hidden), None, hidden
+        return super().compute_base_logits_and_hidden(hidden)
diff --git a/python/sglang/srt/models/qwen3_eagle3.py b/python/sglang/srt/models/qwen3_eagle3.py
