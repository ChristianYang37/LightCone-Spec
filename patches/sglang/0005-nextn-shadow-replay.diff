+class _LowRankDelta(torch.nn.Module):
+    def __init__(self, weight: torch.Tensor, *, rank: int, seed: int) -> None:
+        super().__init__()
+        factors = _LowRankFactors(weight, rank=rank, seed=seed)
+        self.a = factors.a
+        self.b = factors.b
+
     def forward(self, original: torch.Tensor) -> torch.Tensor:
         return original + (self.b @ self.a).to(original.dtype)
 
 
+
+def _block_fp8_slot(
+    name: str,
+    raw_name: str,
+    module: torch.nn.Module,
+    weight: torch.Tensor,
+    parameter_indices: tuple[int, ...],
+) -> PublicationSlot:
+    parent_name, _, leaf = raw_name.rpartition(".")
+    scale_attribute = (
+        "weight_scale_inv" if leaf == "weight" else f"{leaf}_scale_inv"
+    )
+    scale = getattr(module, scale_attribute, None)
+    if scale is None or scale.ndim != weight.ndim:
+        raise ValueError(f"{name} uses an unsupported FP8 publication layout")
+    block_n = math.ceil(weight.shape[-2] / scale.shape[-2])
+    block_k = math.ceil(weight.shape[-1] / scale.shape[-1])
+
+    def expanded_scale(value: torch.Tensor) -> torch.Tensor:
+        return (
+            value.repeat_interleave(block_n, dim=-2)
+            .repeat_interleave(block_k, dim=-1)[..., : weight.shape[-2], : weight.shape[-1]]
+        )
+
+    base = weight.float() * expanded_scale(scale.float())
+
+    def quantize(value: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        rows, columns = value.shape[-2:]
+        padded_rows = scale.shape[-2] * block_n
+        padded_columns = scale.shape[-1] * block_k
+        padded = torch.nn.functional.pad(
+            value.float(), (0, padded_columns - columns, 0, padded_rows - rows)
+        )
+        grouped = padded.reshape(
+            *value.shape[:-2], scale.shape[-2], block_n, scale.shape[-1], block_k
+        )
+        candidate_scale = grouped.abs().amax(dim=(-3, -1)).clamp_min(1e-12) / 448.0
+        quantized = (value.float() / expanded_scale(candidate_scale)).clamp(-448, 448)
+        return quantized.to(weight.dtype), candidate_scale.to(scale.dtype)
+
+    return PublicationSlot(
+        name=name,
+        live_weight=weight,
+        base_master=base,
+        parameter_indices=parameter_indices,
+        live_scale=scale,
+        scale_name=f"{parent_name}.{scale_attribute}",
+        quantize=quantize,
+    )
+
+
+def _publication_slot(
+    name: str,
+    raw_name: str,
+    module: torch.nn.Module,
+    weight: torch.Tensor,
+    base: torch.Tensor,
+    parameter_indices: tuple[int, ...],
+) -> PublicationSlot:
+    if weight.dtype in {torch.float8_e4m3fn, torch.float8_e4m3fnuz}:
+        return _block_fp8_slot(
+            name, raw_name, module, weight, parameter_indices
+        )
+    return PublicationSlot(name, weight, base.float(), parameter_indices)
+
+
+def _moe_scale(module: torch.nn.Module, stem: str) -> torch.Tensor | None:
+    scale = getattr(module, f"{stem}_weight_scale_inv", None)
+    return scale if scale is not None else getattr(module, f"{stem}_weight_scale", None)
+
+
+def _shadow_moe_forward(
+    module: torch.nn.Module,
+    hidden_states: torch.Tensor,
+    topk_output,
+    pre_quant_input=None,
+):
+    del pre_quant_input
+    top_weights, top_ids, _ = topk_output
+    return torch_native_selected_moe(
+        hidden_states,
+        top_weights,
+        top_ids,
+        module.w13_weight,
+        module.w2_weight,
+        w13_scale=_moe_scale(module, "w13"),
+        w2_scale=_moe_scale(module, "w2"),
+    )
+
+
+def _shadow_linear_apply(method, layer, inputs, bias=None, **kwargs):
+    del method, kwargs
+    return torch.nn.functional.linear(inputs, layer.weight.to(inputs.dtype), bias)
