index 00000000..0da9d094
--- /dev/null
+++ b/python/sglang/srt/models/qwen3_eagle3.py
@@ -0,0 +1,54 @@
+"""Official DeepSpec Qwen3 EAGLE3: trained Q/K norms and checkpoint-owned head.
+
+The one-layer public TTT7 checkpoint shares the Eagle worker interface, not
+Llama attention mathematics. Old Llama/EAGLE registrations are unchanged.
+"""
+
+import copy
+
+from sglang.srt.layers.linear import QKVParallelLinear
+from sglang.srt.layers.radix_attention import AttentionType
+from sglang.srt.models.dflash import DFlashAttention
+from sglang.srt.models.llama_eagle3 import LlamaForCausalLMEagle3
+from sglang.srt.models.qwen3_draft_replay import QwenDraftReplay
+
+
+class Qwen3Eagle3Model(QwenDraftReplay, LlamaForCausalLMEagle3):
+    owns_checkpoint_embed_head = True
+
+    def __init__(self, config, quant_config=None, prefix=""):
+        config = copy.deepcopy(config)
+        if config.num_hidden_layers != 1:
+            raise ValueError(
+                "DeepSpec Qwen3 Eagle integration supports the public one-layer TTT7 model"
+            )
+        features = tuple(config.target_layer_ids)
+        if not features or len(set(features)) != len(features):
+            raise ValueError("official Eagle target features must be nonempty and distinct")
+        config.num_aux_hidden_states = len(features)
+        config.draft_vocab_size = config.vocab_size
+        config.fc_norm = False
+        config.use_aux_norm = False
+        config.norm_output = False
+        config.tie_word_embeddings = False
+        super().__init__(config, quant_config=quant_config, prefix=prefix)
+        for index, layer in enumerate(self.model.layers):
+            attention = DFlashAttention(config, index, quant_config)
+            attention.qkv_proj = QKVParallelLinear(
+                2 * config.hidden_size,
+                attention.head_dim,
+                attention.total_num_heads,
+                attention.total_num_kv_heads,
+                bias=bool(getattr(config, "attention_bias", False)),
+                quant_config=quant_config,
+                prefix=f"model.layers.{index}.self_attn.qkv_proj",
+            )
+            attention.attn_type = AttentionType.DECODER
+            attention.attn.attn_type = AttentionType.DECODER
+            if self._draft_window_size is not None:
+                attention.attn.sliding_window_size = self._draft_window_size
+            layer.self_attn = attention
+        self.load_lm_head_from_target = False
+
+
+EntryClass = [Qwen3Eagle3Model]
