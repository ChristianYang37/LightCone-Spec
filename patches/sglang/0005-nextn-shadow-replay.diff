+"""Explicit latest-round Qwen replay; never differentiate through cached kernels."""
+
+import torch
+import torch.nn.functional as F
+
+
+class QwenDraftReplay:
+    requires_complete_gradients = True
+
+    def capture_training_context(self, forward_batch, runner, *, step_kv=None):
+        # Lazy imports avoid a model-registry cycle through DSparkDraftMixin.
+        from sglang.srt.models.gemma4_draft import GemmaReplay
+
+        return GemmaReplay.capture_training_context(self, forward_batch, runner, step_kv=step_kv)
+
+    def check_training_reconstruction(self, valid_mask):
+        from sglang.srt.models.gemma4_draft import GemmaReplay
+
+        return GemmaReplay.check_training_reconstruction(self, valid_mask)
+
+    def _replay_logits(self, hidden):
+        from sglang.srt.models.gemma4_draft import GemmaReplay
+
+        return GemmaReplay._replay_logits(self, hidden)
+
+    def _replay_hidden(self, input_ids, positions, forward_batch, input_embeds=None):
+        from sglang.srt.distributed import get_tp_group
+        from sglang.srt.models.gemma4_draft import _column, _row, _tp_copy
+
+        from lightcone_spec.gemma import gemma_canvas_attention, gemma_rms, gemma_rotary
+
+        histories = getattr(self, "_training_histories", None)
+        self._training_histories = None
+        if histories is None:
+            raise RuntimeError("Qwen update lacks owned full-history KV snapshot")
+        eagle = hasattr(self, "model")
+        backbone = self.model if eagle else self
+        with torch.no_grad():
+            embeds = (
+                backbone.embed_tokens(input_ids) if input_embeds is None else input_embeds.detach()
+            )
+        hidden = forward_batch.spec_info.hidden_states.detach() if eagle else embeds
+        if eagle and hidden.shape[-1] != self.config.hidden_size:
+            hidden = F.linear(hidden, backbone.fc.weight, backbone.fc.bias)
+
+        def norm(module, value):
+            return gemma_rms(value, module.weight, module.variance_epsilon)
+
+        for layer, history in zip(backbone.layers, histories, strict=True):
+            inputs = (
+                torch.cat(
+                    (norm(layer.input_layernorm, embeds), norm(layer.hidden_norm, hidden)), -1
+                )
+                if eagle
+                else norm(layer.input_layernorm, hidden)
+            )
+            attention = layer.self_attn
+            if attention.total_num_kv_heads < get_tp_group().world_size:
+                raise RuntimeError("Qwen replicated-KV replay needs an explicit shard reduction")
+            packed = _column(attention.qkv_proj, inputs)
+            query, key, value = packed.split(
+                (attention.q_size, attention.kv_size, attention.kv_size), dim=-1
+            )
+            batch = history[2].shape[0]
+            count = inputs.shape[0] // batch
+            query = query.view(batch, count, attention.num_heads, attention.head_dim)
+            key = key.view(batch, count, attention.num_kv_heads, attention.head_dim)
+            value = value.view_as(key)
+            query = gemma_rms(
+                query, _tp_copy(attention.q_norm.weight), attention.q_norm.variance_epsilon
+            )
+            key = gemma_rms(
+                key, _tp_copy(attention.k_norm.weight), attention.k_norm.variance_epsilon
+            )
+            cache = attention.rotary_emb.cos_sin_cache
+            query = gemma_rotary(query, positions.reshape(batch, count), cache)
+            key = gemma_rotary(key, positions.reshape(batch, count), cache)
+            attended = gemma_canvas_attention(
+                query, key, value, *history, causal_canvas=eagle, scale=attention.head_dim**-0.5
+            )
+            hidden = hidden + _row(attention.o_proj, attended.reshape(-1, attention.q_size))
+            normalized = norm(layer.post_attention_layernorm, hidden)
+            gate, up = _column(layer.mlp.gate_up_proj, normalized).chunk(2, -1)
+            hidden = hidden + _row(layer.mlp.down_proj, F.silu(gate) * up)
