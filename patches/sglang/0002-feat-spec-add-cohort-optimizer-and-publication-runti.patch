+@dataclass
+class ParameterProposal:
+    parameters: tuple[torch.Tensor, ...]
+    first_moments: tuple[torch.Tensor, ...]
+    second_moments: tuple[torch.Tensor, ...]
+    step: torch.Tensor
+
+
+class ResidentOptimizer:
+    """Functional GPU optimizer; rejected proposals never mutate active state."""
+
+    def __init__(
+        self,
+        parameters: Sequence[torch.Tensor],
+        config,
+    ) -> None:
+        if not parameters:
+            raise ValueError("optimizer parameter layout is empty")
+        self.config = config
+        self.master = tuple(
+            parameter.detach().to(torch.float32).clone() for parameter in parameters
+        )
+        first_names = {"adam", "adamw", "sgdm", "nag", "muon", "lion"}
+        self.first = tuple(
+            (
+                torch.zeros_like(value)
+                if config.name in first_names
+                else torch.empty(0, dtype=torch.float32, device=value.device)
+            )
+            for value in self.master
+        )
+        self.second = tuple(
+            (
+                torch.zeros_like(value)
+                if config.name in {"adam", "adamw"}
+                or (config.name == "muon" and value.ndim != 2)
+                else torch.empty(0, dtype=torch.float32, device=value.device)
+            )
+            for value in self.master
+        )
+        self._step = torch.zeros((), dtype=torch.int64, device=self.master[0].device)
+
+    @property
+    def step(self) -> int:
+        """Expose the step only to diagnostics/tests, never the hot path."""
+        return int(self._step.item())
+
+    @property
+    def state_tensors(self) -> tuple[torch.Tensor, ...]:
+        """All persistent optimizer tensors, including scalar metadata."""
+        return self.master + self.first + self.second + self.metadata_tensors
+
+    @property
+    def metadata_tensors(self) -> tuple[torch.Tensor, ...]:
+        return (self._step,)
+
+    def propose(self, gradients: Sequence[torch.Tensor]) -> ParameterProposal:
+        gradients = _clip_fp32_gradients(
+            gradients,
+            width=len(self.master),
+            grad_clip=self.config.grad_clip,
+            label="optimizer",
+        )
+        step = self._step + 1
+        if self.config.name in {"sgdm", "nag"}:
+            momentum = self.config.momentum
+            if momentum is None:
+                raise AssertionError("validated momentum optimizer is incomplete")
+            effective = tuple(
+                torch._foreach_add(
+                    gradients,
+                    self.master,
+                    alpha=self.config.weight_decay,
+                )
+            )
+            first = torch._foreach_mul(self.first, momentum)
+            torch._foreach_add_(first, effective)
+            directions = (
+                tuple(first)
+                if self.config.name == "sgdm"
+                else tuple(
+                    torch._foreach_add(effective, first, alpha=momentum)
+                )
+            )
+            parameters = tuple(
+                torch._foreach_add(
+                    self.master,
+                    directions,
+                    alpha=-self.config.learning_rate,
+                )
+            )
+            return ParameterProposal(parameters, tuple(first), self.second, step)
+
+        if self.config.name == "lion":
+            beta1 = self.config.beta1
+            beta2 = self.config.beta2
+            directions = torch._foreach_mul(self.first, beta1)
+            torch._foreach_add_(directions, gradients, alpha=1 - beta1)
+            torch._foreach_sign_(directions)
+            first = torch._foreach_mul(self.first, beta2)
+            torch._foreach_add_(first, gradients, alpha=1 - beta2)
+            decay = 1 - self.config.learning_rate * self.config.weight_decay
+            parameters = torch._foreach_mul(self.master, decay)
+            torch._foreach_add_(
+                parameters,
+                directions,
+                alpha=-self.config.learning_rate,
+            )
+            return ParameterProposal(
+                tuple(parameters), tuple(first), self.second, step
+            )
+
+        if self.config.name == "muon":
+            return self._propose_muon(gradients, step)
+
+        beta1 = self.config.beta1
+        beta2 = self.config.beta2
+        first = torch._foreach_mul(self.first, beta1)
+        torch._foreach_add_(first, gradients, alpha=1 - beta1)
+        squared = torch._foreach_mul(gradients, gradients)
+        second = torch._foreach_mul(self.second, beta2)
+        torch._foreach_add_(second, squared, alpha=1 - beta2)
+        del squared
+        floating_step = step.to(torch.float32)
+        correction1 = 1 - torch.pow(
+            torch.as_tensor(beta1, device=step.device), floating_step
+        )
+        correction2 = 1 - torch.pow(
+            torch.as_tensor(beta2, device=step.device), floating_step
+        )
+        directions = torch._foreach_div(first, correction1)
+        denominators = torch._foreach_div(second, correction2)
+        torch._foreach_sqrt_(denominators)
+        torch._foreach_add_(denominators, self.config.epsilon)
+        torch._foreach_div_(directions, denominators)
+        if self.config.name == "adamw":
+            torch._foreach_add_(
+                directions,
+                self.master,
+                alpha=self.config.weight_decay,
+            )
+        parameters = torch._foreach_add(
+            self.master,
+            directions,
+            alpha=-self.config.learning_rate,
+        )
+        return ParameterProposal(
+            tuple(parameters), tuple(first), tuple(second), step
+        )
+
+    def _adamw_candidate(
+        self,
+        parameter: torch.Tensor,
+        gradient: torch.Tensor,
+        first: torch.Tensor,
+        second: torch.Tensor,
+        step: torch.Tensor,
+        *,
+        learning_rate: float,
+        weight_decay: float,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        beta1 = self.config.beta1
+        beta2 = self.config.beta2
+        next_first = beta1 * first + (1 - beta1) * gradient
+        next_second = beta2 * second + (1 - beta2) * gradient.square()
+        floating_step = step.to(torch.float32)
+        correction1 = 1 - torch.pow(
+            torch.as_tensor(beta1, device=step.device), floating_step
+        )
+        correction2 = 1 - torch.pow(
+            torch.as_tensor(beta2, device=step.device), floating_step
+        )
+        direction = (next_first / correction1) / (
+            (next_second / correction2).sqrt() + self.config.epsilon
+        )
+        updated = parameter * (1 - learning_rate * weight_decay) - (
+            learning_rate * direction
+        )
+        return updated, next_first, next_second
+
+    def _propose_muon(
+        self,
+        gradients: Sequence[torch.Tensor],
+        step: torch.Tensor,
+    ) -> ParameterProposal:
+        momentum = self.config.momentum
+        ns_steps = self.config.muon_ns_steps
+        auxiliary_lr = self.config.muon_auxiliary_learning_rate
+        auxiliary_decay = self.config.muon_auxiliary_weight_decay
+        if (
+            momentum is None
+            or ns_steps is None
+            or auxiliary_lr is None
+            or auxiliary_decay is None
+        ):
+            raise AssertionError("validated Muon configuration is incomplete")
+        parameters = []
+        first = []
+        second = []
+        for parameter, gradient, old_first, old_second in zip(
+            self.master,
+            gradients,
+            self.first,
+            self.second,
+            strict=True,
+        ):
+            if parameter.ndim != 2:
+                updated, next_first, next_second = self._adamw_candidate(
+                    parameter,
+                    gradient,
+                    old_first,
+                    old_second,
+                    step,
+                    learning_rate=auxiliary_lr,
+                    weight_decay=auxiliary_decay,
+                )
+            else:
+                next_first = momentum * old_first + (1 - momentum) * gradient
+                nesterov = (1 - momentum) * gradient + momentum * next_first
+                direction = zeroth_power_newton_schulz(
+                    nesterov,
+                    steps=ns_steps,
+                    epsilon=max(self.config.epsilon, 1e-7),
+                )
+                adjusted_lr = self.config.learning_rate * math.sqrt(
+                    max(1.0, parameter.shape[0] / parameter.shape[1])
+                )
+                updated = (
+                    parameter
+                    * (1 - self.config.learning_rate * self.config.weight_decay)
+                    - adjusted_lr * direction
+                )
+                next_second = old_second
+            parameters.append(updated)
+            first.append(next_first)
+            second.append(next_second)
+        return ParameterProposal(tuple(parameters), tuple(first), tuple(second), step)
+
+    def commit(
+        self,
+        proposal: ParameterProposal,
+        *,
+        valid: torch.Tensor | None = None,
+    ) -> None:
+        with torch.no_grad():
+            if valid is None:
+                # The publication boundary has already consumed the pinned
+                # validity receipt.  A second device-wide ``where`` would read
+                # and rewrite every full-drafter state tensor solely to select
+                # the candidate that is known to be valid.
+                torch._foreach_copy_(self.master, proposal.parameters)
+                if self.first:
+                    torch._foreach_copy_(self.first, proposal.first_moments)
+                if self.second:
+                    torch._foreach_copy_(self.second, proposal.second_moments)
+                self._step.copy_(proposal.step)
+                return
+            valid = valid.reshape(()).to(
+                device=self.master[0].device, dtype=torch.bool
+            )
+            for active, candidate in zip(self.master, proposal.parameters, strict=True):
+                active.copy_(torch.where(valid, candidate, active))
+            for active, candidate in zip(
+                self.first, proposal.first_moments, strict=True
+            ):
+                active.copy_(torch.where(valid, candidate, active))
+            for active, candidate in zip(
+                self.second, proposal.second_moments, strict=True
+            ):
+                active.copy_(torch.where(valid, candidate, active))
+            self._step.copy_(torch.where(valid, proposal.step, self._step))
+
+    def reset(self, parameters: Sequence[torch.Tensor]) -> None:
+        if len(parameters) != len(self.master):
+            raise ValueError("optimizer reset layout mismatch")
+        with torch.no_grad():
+            for destination, source in zip(self.master, parameters, strict=True):
+                destination.copy_(source.to(destination.dtype))
+            for moment in self.first + self.second:
+                moment.zero_()
+            self._step.zero_()
+
+
+def _project_online_parameters(
+    parameters: Sequence[torch.Tensor],
+    origin: Sequence[torch.Tensor],
+    radius: float | None,
+) -> tuple[torch.Tensor, ...]:
+    if radius is None:
+        return tuple(parameters)
+    distance = (
+        torch.stack(
+            [
+                (parameter - base).square().sum()
+                for parameter, base in zip(parameters, origin, strict=True)
+            ]
+        )
+        .sum()
+        .sqrt()
+    )
+    scale = torch.clamp(
+        torch.as_tensor(radius, device=distance.device) / distance.clamp_min(1e-12),
+        max=1.0,
+    )
+    return tuple(
+        base + (parameter - base) * scale
+        for parameter, base in zip(parameters, origin, strict=True)
+    )
+
+
+class OnlineSpecOptimizer:
+    """Transactional OGD, two-state optimistic OGD, or Hedge experts."""
+
+    def __init__(
+        self,
+        parameters: Sequence[torch.Tensor],
+        config: OnlineAdaptationConfig,
+        *,
+        projection_origin: Sequence[torch.Tensor] | None = None,
+    ) -> None:
+        if config.online_spec is None or not config.method.startswith("onlinespec_"):
+            raise ValueError("OnlineSPEC optimizer requires an OnlineSPEC method")
+        if not parameters:
+            raise ValueError("OnlineSPEC parameter layout is empty")
+        self.config = config.optimizer
+        self.method = config.method
+        self.online_spec = config.online_spec
+        self.master = tuple(
+            parameter.detach().to(torch.float32).clone() for parameter in parameters
+        )
+        if projection_origin is None:
+            self.initial = tuple(parameter.clone() for parameter in self.master)
+        else:
+            origin = tuple(projection_origin)
+            if len(origin) != len(self.master) or any(
+                base.shape != parameter.shape
+                or base.device != parameter.device
+                or not base.is_floating_point()
+                for base, parameter in zip(origin, self.master, strict=True)
+            ):
+                raise ValueError("OnlineSPEC projection origin layout mismatch")
+            # The adapter owns this immutable reset snapshot. Reuse it as the
+            # projection origin instead of retaining a second full FP32 copy.
+            self.initial = tuple(base.detach() for base in origin)
+        width = len(self.master)
+        if self.method == "onlinespec_ogd":
+            self.first = ()
+            self.second = ()
+            self.learning_rates = (self.config.learning_rate,)
+        elif self.method == "onlinespec_opt":
+            self.first = tuple(parameter.clone() for parameter in self.master)
+            self.second = tuple(
+                torch.zeros_like(parameter) for parameter in self.master
+            )
+            self.learning_rates = (self.config.learning_rate,)
+        else:
+            self.learning_rates = (
+                self.config.learning_rate,
+                *self.online_spec.additional_learning_rates,
+            )
+            self.first = tuple(
+                parameter.clone()
+                for _ in self.learning_rates
+                for parameter in self.master
+            )
+            self.second = (
+                torch.zeros(
+                    len(self.learning_rates),
+                    dtype=torch.float32,
+                    device=self.master[0].device,
+                ),
+            )
+        self._width = width
+        self._step = torch.zeros((), dtype=torch.int64, device=self.master[0].device)
+
+    @property
+    def is_ensemble(self) -> bool:
+        return self.method == "onlinespec_ens"
+
+    @property
+    def step(self) -> int:
+        return int(self._step.item())
+
+    @property
+    def metadata_tensors(self) -> tuple[torch.Tensor, ...]:
+        return (self._step,)
+
+    @property
+    def state_tensors(self) -> tuple[torch.Tensor, ...]:
+        return self.master + self.first + self.second + self.metadata_tensors
+
+    @property
+    def online_state_tensors(self) -> tuple[torch.Tensor, ...]:
+        return self.first + self.second + self.metadata_tensors
+
+    @property
+    def experts(self) -> tuple[tuple[torch.Tensor, ...], ...]:
+        if not self.is_ensemble:
+            raise RuntimeError("only OnlineSPEC Hedge owns expert states")
+        return tuple(
+            self.first[index : index + self._width]
+            for index in range(0, len(self.first), self._width)
+        )
+
+    @property
+    def expert_probabilities(self) -> torch.Tensor | None:
+        if not self.is_ensemble:
+            return None
+        rate = self.online_spec.hedge_learning_rate
+        if rate is None:
+            raise AssertionError("validated Hedge state has no meta learning rate")
+        return torch.softmax(-rate * self.second[0], dim=0)
+
+    def _clip(self, gradients: Sequence[torch.Tensor]) -> tuple[torch.Tensor, ...]:
+        return _clip_fp32_gradients(
+            gradients,
+            width=self._width,
+            grad_clip=self.config.grad_clip,
+            label="OnlineSPEC",
+        )
+
+    def _ogd(
+        self,
+        parameters: Sequence[torch.Tensor],
+        gradients: Sequence[torch.Tensor],
+        learning_rate: float,
+    ) -> tuple[torch.Tensor, ...]:
+        candidate = tuple(
+            parameter - learning_rate * gradient
+            for parameter, gradient in zip(
+                parameters, self._clip(gradients), strict=True
+            )
+        )
+        return _project_online_parameters(
+            candidate,
+            self.initial,
+            self.online_spec.projection_radius,
+        )
+
+    def propose(self, gradients: Sequence[torch.Tensor]) -> ParameterProposal:
+        if self.is_ensemble:
+            raise RuntimeError("Hedge requires per-expert losses and gradients")
+        next_step = self._step + 1
+        if self.method == "onlinespec_ogd":
+            parameters = self._ogd(self.master, gradients, self.config.learning_rate)
+            return ParameterProposal(parameters, (), (), next_step)
+        clipped = self._clip(gradients)
+        anchor = tuple(
+            parameter - self.config.learning_rate * gradient
+            for parameter, gradient in zip(self.first, clipped, strict=True)
+        )
+        anchor = _project_online_parameters(
+            anchor,
+            self.initial,
+            self.online_spec.projection_radius,
+        )
+        decision = tuple(
+            parameter - self.config.learning_rate * hint
+            for parameter, hint in zip(anchor, clipped, strict=True)
+        )
+        decision = _project_online_parameters(
+            decision,
+            self.initial,
+            self.online_spec.projection_radius,
+        )
+        return ParameterProposal(decision, anchor, clipped, next_step)
+
+    def propose_ensemble(
+        self,
+        losses: torch.Tensor,
+        gradients: Sequence[Sequence[torch.Tensor]],
+    ) -> ParameterProposal:
+        if not self.is_ensemble:
+            raise RuntimeError("only OnlineSPEC Hedge accepts expert feedback")
+        experts = self.experts
+        if losses.shape != (len(experts),) or len(gradients) != len(experts):
+            raise ValueError("one loss and gradient tuple is required per expert")
+        updated = tuple(
+            self.propose_ensemble_member(index, member_gradients)
+            for index, member_gradients in enumerate(gradients)
+        )
+        return self.combine_ensemble(losses, updated)
+
+    def propose_ensemble_member(
+        self,
+        index: int,
+        gradients: Sequence[torch.Tensor],
+    ) -> tuple[torch.Tensor, ...]:
+        """Update one Hedge expert so backends can release its gradients early."""
+        if not self.is_ensemble:
+            raise RuntimeError("only OnlineSPEC Hedge owns expert states")
+        experts = self.experts
+        if (
+            not isinstance(index, int)
+            or isinstance(index, bool)
+            or not 0 <= index < len(experts)
+        ):
+            raise ValueError("OnlineSPEC expert index is outside the learner")
+        return self._ogd(
+            experts[index],
+            gradients,
+            self.learning_rates[index],
+        )
+
+    def combine_ensemble(
+        self,
+        losses: torch.Tensor,
+        updated: Sequence[Sequence[torch.Tensor]],
+    ) -> ParameterProposal:
+        """Form the next Hedge decision from already-updated expert states."""
+        if not self.is_ensemble:
+            raise RuntimeError("only OnlineSPEC Hedge accepts expert feedback")
+        experts = tuple(tuple(parameters) for parameters in updated)
+        if losses.shape != (len(self.learning_rates),) or len(experts) != len(
+            self.learning_rates
+        ):
+            raise ValueError("one loss and updated state is required per expert")
+        if any(
+            len(expert) != self._width
+            or any(
+                parameter.shape != reference.shape
+                or parameter.device != reference.device
+                or not parameter.is_floating_point()
+                for parameter, reference in zip(expert, self.master, strict=True)
+            )
+            for expert in experts
+        ):
+            raise ValueError("updated OnlineSPEC expert layout mismatch")
+        cumulative = self.second[0] + losses.detach().to(torch.float32)
+        hedge_rate = self.online_spec.hedge_learning_rate
+        if hedge_rate is None:
+            raise AssertionError("validated Hedge state has no meta learning rate")
+        probabilities = torch.softmax(-hedge_rate * cumulative, dim=0)
+        decision = tuple(
+            torch.stack([expert[index] for expert in experts])
+            .mul(probabilities.view((-1,) + (1,) * parameter.ndim))
+            .sum(0)
+            for index, parameter in enumerate(self.master)
+        )
+        flattened = tuple(parameter for expert in experts for parameter in expert)
+        return ParameterProposal(
+            decision,
+            flattened,
+            (cumulative,),
+            self._step + 1,
+        )
+
+    def commit(
+        self,
+        proposal: ParameterProposal,
+        *,
+        valid: torch.Tensor | None = None,
+    ) -> None:
+        if len(proposal.first_moments) != len(self.first) or len(
+            proposal.second_moments
+        ) != len(self.second):
+            raise ValueError("OnlineSPEC proposal state layout mismatch")
+        with torch.no_grad():
+            if valid is None:
+                torch._foreach_copy_(self.master, proposal.parameters)
+                if self.first:
+                    torch._foreach_copy_(self.first, proposal.first_moments)
+                if self.second:
+                    torch._foreach_copy_(self.second, proposal.second_moments)
+                self._step.copy_(proposal.step)
+                return
+            valid = valid.reshape(()).to(
+                device=self.master[0].device, dtype=torch.bool
+            )
+            for active, candidate in zip(self.master, proposal.parameters, strict=True):
+                active.copy_(torch.where(valid, candidate, active))
+            for active, candidate in zip(
+                self.first, proposal.first_moments, strict=True
+            ):
+                active.copy_(torch.where(valid, candidate, active))
+            for active, candidate in zip(
+                self.second, proposal.second_moments, strict=True
+            ):
+                active.copy_(torch.where(valid, candidate, active))
+            self._step.copy_(torch.where(valid, proposal.step, self._step))
+
+    def reset(self, parameters: Sequence[torch.Tensor]) -> None:
+        if len(parameters) != self._width:
+            raise ValueError("OnlineSPEC reset layout mismatch")
+        with torch.no_grad():
+            for destination, source, initial in zip(
+                self.master, parameters, self.initial, strict=True
+            ):
+                initial.copy_(source.to(torch.float32))
+                destination.copy_(initial)
+            if self.method == "onlinespec_opt":
+                for anchor, master in zip(self.first, self.master, strict=True):
+                    anchor.copy_(master)
+                for hint in self.second:
+                    hint.zero_()
+            elif self.is_ensemble:
+                for index, expert in enumerate(self.experts):
+                    for destination, master in zip(expert, self.master, strict=True):
+                        destination.copy_(master)
+                self.second[0].zero_()
+            self._step.zero_()
+
+    def diagnostics(self) -> dict:
+        """Synchronizing endpoint-only diagnostics; never called in decode."""
+        payload = {
+            "algorithm": self.method,
+            "step": self.step,
+            "projection_radius": self.online_spec.projection_radius,
+            "learning_rates": list(self.learning_rates),
+        }
+        if self.method == "onlinespec_opt":
+            payload["hint_norm"] = float(
+                torch.stack([value.square().sum() for value in self.second])
+                .sum()
+                .sqrt()
+                .item()
+            )
+        elif self.is_ensemble:
+            probabilities = self.expert_probabilities
+            if probabilities is None:
+                raise AssertionError("validated Hedge state has no probabilities")
+            payload["expert_probabilities"] = probabilities.tolist()
+            payload["cumulative_losses"] = self.second[0].tolist()
+        return payload
+
+
+def build_parameter_optimizer(
+    parameters: Sequence[torch.Tensor],
+    config: OnlineAdaptationConfig,
+    *,
+    projection_origin: Sequence[torch.Tensor] | None = None,
+) -> ResidentOptimizer | OnlineSpecOptimizer:
+    if config.method.startswith("onlinespec_"):
+        return OnlineSpecOptimizer(
+            parameters,
+            config,
+            projection_origin=projection_origin,
+        )
+    return ResidentOptimizer(parameters, config.optimizer)
+
+
+class FixedInferenceBank:
+    """Stages model-dtype values and publishes without changing storage."""
+
+    def __init__(self, tensors: Sequence[torch.Tensor]) -> None:
+        if not tensors:
+            raise ValueError("inference bank cannot be empty")
+        self.active = tuple(tensors)
+        self.staging = tuple(torch.empty_like(tensor) for tensor in tensors)
+        self.addresses = tuple(tensor.data_ptr() for tensor in tensors)
+
+    def stage(self, tensors: Sequence[torch.Tensor]) -> None:
+        if len(tensors) != len(self.staging):
+            raise ValueError("inference parameter layout mismatch")
+        with torch.no_grad():
+            torch._foreach_copy_(self.staging, tuple(tensors))
+
+    def publish(self) -> None:
+        with torch.no_grad():
+            torch._foreach_copy_(self.active, self.staging)
+        if tuple(tensor.data_ptr() for tensor in self.active) != self.addresses:
+            raise RuntimeError("inference parameter address changed")
+
+
+@dataclass
+class ReadyCandidate:
+    binding: CandidateBinding
+    optimizer: ResidentOptimizer | OnlineSpecOptimizer
+    optimizer_proposal: ParameterProposal
+    inference_bank: FixedInferenceBank
+    ready_event: torch.cuda.Event | None
+    candidate_tensors: tuple[torch.Tensor, ...]
+    finite: torch.Tensor
+    reconstruction_ok: torch.Tensor
+    supervision_nonempty: torch.Tensor
+    host_validity: torch.Tensor
+    trace_index: int
+
+
+@dataclass
+class PendingTiming:
+    name: str
+    started: torch.cuda.Event
+    finished: torch.cuda.Event
+
+
+@dataclass
+class UpdateTrace:
+    buffer_index: int
+    source_round: int
+    source_version: int
+    request_ids: tuple[str, ...]
+    prefix_count: int
+    status: str = "pending"
+    published_version: int | None = None
+    diagnosed: bool = False
+
+
+@dataclass(frozen=True)
+class RoundTrace:
+    buffer_index: int
+    round_index: int
+    source_version: int
+    request_ids: tuple[str, ...]
+
+
+@dataclass(frozen=True)
+class KVVersionSegment:
+    start: int
+    end: int
+    source_version: int
+
+
+@dataclass
+class RequestVersionState:
+    version: int
+    slot_generation: int
+    prefix_length: int = 0
+    segments: list[KVVersionSegment] = field(default_factory=list)
+
+    def append(self, new_length: int, source_version: int) -> None:
+        if new_length < self.prefix_length:
+            self.retract(new_length)
+            return
+        if new_length == self.prefix_length:
+            return
+        segment = KVVersionSegment(self.prefix_length, new_length, source_version)
+        if self.segments and self.segments[-1].source_version == source_version:
+            previous = self.segments[-1]
+            segment = KVVersionSegment(previous.start, new_length, source_version)
+            self.segments[-1] = segment
+        else:
+            self.segments.append(segment)
+        self.prefix_length = new_length
+
+    def retract(self, new_length: int) -> None:
+        if new_length < 0 or new_length > self.prefix_length:
+            raise ValueError("invalid KV retraction")
+        retained = []
+        for segment in self.segments:
+            if segment.start >= new_length:
+                break
+            retained.append(
+                KVVersionSegment(
+                    segment.start,
+                    min(segment.end, new_length),
+                    segment.source_version,
+                )
+            )
+        self.segments = retained
+        self.prefix_length = new_length
+
+
+class OnlineCohortRuntime:
+    """One side stream and one active version for a homogeneous server cohort."""
+
+    def __init__(
+        self,
+        config: OnlineAdaptationConfig,
+        *,
+        device: torch.device,
+        reserve_bytes: int,
+        telemetry_path: str | None,
+        max_trace_updates: int,
+        max_trace_batch: int,
+    ) -> None:
+        self.config = config
+        self.device = device
+        self.reserve_bytes = int(reserve_bytes)
+        if self.reserve_bytes <= 0:
+            raise ValueError("adaptation reserve must be positive")
+        if max_trace_updates < 1 or max_trace_batch < 1:
+            raise ValueError("telemetry capacities must be positive")
+        self.telemetry_path = (
+            Path(telemetry_path) if telemetry_path is not None else None
+        )
+        # CUDA clamps out-of-range priorities to the nearest supported value.
+        # A large positive value requests the device's lowest-priority stream
+        # without relying on a version-specific priority-range API.
+        self.side_stream = torch.cuda.Stream(device=device, priority=2**31 - 1)
+        self.main_ready = torch.cuda.Event(blocking=False)
+        self.epoch = 0
+        self.active_version = 0
+        self.slot_generation = 0
+        self.round = 0
+        self.pending: ReadyCandidate | None = None
+        self.reserved: CandidateBinding | None = None
+        self.requests: dict[str, RequestVersionState] = {}
+        self.device_commits: list[
+            tuple[tuple[str, ...], torch.Tensor, int, torch.cuda.Event]
+        ] = []
+        self.latest_device_lengths: dict[str, tuple[torch.Tensor, int]] = {}
+        self.pending_timings: deque[PendingTiming] = deque()
+        self.update_traces: list[UpdateTrace] = []
+        self.round_traces: list[RoundTrace] = []
+        self.active_round_rows: dict[str, tuple[RoundTrace, int]] = {}
+        self.trace_prefix_lens = torch.empty(
+            (max_trace_updates, max_trace_batch),
+            device=device,
+            dtype=torch.int64,
+        )
+        self.trace_metrics = torch.empty(
+            (max_trace_updates, 11),
+            device=device,
+            dtype=torch.float32,
+        )
+        online_members = (
+            1 + len(config.online_spec.additional_learning_rates)
+            if config.method == "onlinespec_ens" and config.online_spec is not None
+            else 1
+        )
+        self.trace_online_experts = torch.empty(
+            (max_trace_updates, online_members, 2),
+            device=device,
+            dtype=torch.float32,
+        )
+        # Allocate the tiny D2H publication receipts once. Repeated pinned-host
+        # allocation in the update path can serialize the allocator and
+        # fragment the process-wide pinned pool under long-running loads.
+        self.host_validity = torch.empty(
+            (max_trace_updates, 3),
+            dtype=torch.uint8,
+            pin_memory=True,
+        )
+        max_trace_rounds = max(1, max_trace_updates - 2) * config.stride + 2
+        self.round_metrics = torch.empty(
+            (max_trace_rounds, max_trace_batch, 4),
+            device=device,
+            dtype=torch.int64,
+        )
+        self.disabled_reason: str | None = None
+        self.counters = {
+            "updates_launched": 0,
+            "updates_published": 0,
+            "updates_discarded": 0,
+            "updates_skipped_no_supervision": 0,
+            "version_mismatches": 0,
+            "exactness_violations": 0,
+            "nonfinite_updates": 0,
+            "oom_events": 0,
+            "fallbacks": 0,
+            "retractions": 0,
+            "target_calls": 0,
+            "graph_replay_hits": 0,
+            "graph_replay_total": 0,
+        }
+        self.timings_ms = {
+            "training": 0.0,
+            "optimizer": 0.0,
+            "merge": 0.0,
+            "publish": 0.0,
+            "barrier": 0.0,
+        }
+        self.resident_bytes = 0
+        self.peak_bytes = 0
+        self.optimizer_bytes = 0
+        self.trainable_parameters = 0
+        self.memory_ledger: dict[str, int] = {}
+        self.parameter_layout_sha256: str | None = None
+        self.load_samples = 0
+        self.running_requests_sum = 0
+        self.running_requests_max = 0
+        self.waiting_requests_sum = 0
+        self.waiting_requests_max = 0
+
+    @property
+    def telemetry_tensors(self) -> tuple[torch.Tensor, ...]:
+        return (
+            self.trace_prefix_lens,
+            self.trace_metrics,
+            self.trace_online_experts,
+            self.round_metrics,
+        )
+
+    @property
+    def cohort_sha256(self) -> str:
+        if self.parameter_layout_sha256 is None:
+            raise RuntimeError("parameter layout must be bound before cohort use")
+        fields = {
+            "method": self.config.method,
+            "target_revision": self.config.target_revision,
+            "drafter_revision": self.config.drafter_revision,
+            "sampling_profile_sha256": self.config.sampling_profile_sha256,
+            "adaptation_group_id": self.config.adaptation_group_id,
+            "tenant_id": self.config.tenant_id,
+            "weight_update_mode": self.config.weight_update_mode,
+            "parameter_scope": self.config.parameter_scope,
+            "parameter_layout_sha256": self.parameter_layout_sha256,
+            "optimizer": self.config.optimizer.__dict__,
+            "online_spec": (
+                None
+                if self.config.online_spec is None
+                else self.config.online_spec.__dict__
+            ),
+        }
+        value = json.dumps(fields, sort_keys=True, separators=(",", ":")).encode()
+        return hashlib.sha256(value).hexdigest()
+
+    def bind_parameter_layout(
+        self,
+        named_tensors: Sequence[tuple[str, torch.Tensor]],
+        *,
+        projection_identity: str,
+    ) -> str:
+        if not projection_identity:
+            raise ValueError("projection identity must be non-empty")
+        rows = [
+            {
+                "name": name,
+                "shape": list(tensor.shape),
+                "dtype": str(tensor.dtype),
+            }
+            for name, tensor in named_tensors
+        ]
+        if not rows or len({row["name"] for row in rows}) != len(rows):
+            raise ValueError("parameter layout must be non-empty and unique")
+        body = {
+            "algorithm": self.config.algorithm,
+            "weight_update_mode": self.config.weight_update_mode,
+            "parameter_scope": self.config.parameter_scope,
+            "rank": self.config.rank,
+            "target_revision": self.config.target_revision,
+            "drafter_revision": self.config.drafter_revision,
+            "projection_identity": projection_identity,
+            "parameters": rows,
+        }
+        digest = hashlib.sha256(
+            json.dumps(body, sort_keys=True, separators=(",", ":")).encode()
+        ).hexdigest()
+        if (
+            self.parameter_layout_sha256 is not None
+            and self.parameter_layout_sha256 != digest
+        ):
+            raise RuntimeError("parameter layout changed after initialization")
+        self.parameter_layout_sha256 = digest
+        return digest
+
+    @contextmanager
+    def side_update(
+        self, source_tensors: Sequence[torch.Tensor]
+    ) -> Iterator[torch.cuda.Stream]:
+        main = torch.cuda.current_stream(self.device)
+        self.main_ready.record(main)
+        self.side_stream.wait_event(self.main_ready)
+        for tensor in source_tensors:
+            tensor.record_stream(self.side_stream)
+        with torch.cuda.stream(self.side_stream):
+            yield self.side_stream
+
+    @contextmanager
+    def timing(self, name: str) -> Iterator[None]:
+        if name not in self.timings_ms:
+            raise ValueError(f"unknown adaptation timing lane: {name}")
+        started = torch.cuda.Event(enable_timing=True)
+        finished = torch.cuda.Event(enable_timing=True)
+        started.record(torch.cuda.current_stream(self.device))
+        try:
+            yield
+        finally:
+            finished.record(torch.cuda.current_stream(self.device))
+            self.pending_timings.append(
+                PendingTiming(name=name, started=started, finished=finished)
+            )
+
+    def submit(
+        self,
+        *,
+        source_round: int,
+        source_version: int,
+        optimizer: ResidentOptimizer | OnlineSpecOptimizer,
+        proposal: ParameterProposal,
+        inference_bank: FixedInferenceBank,
+        finite: torch.Tensor,
+        loss: torch.Tensor,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+        reconstruction_ok: torch.Tensor | None = None,
+        reconstruction_max_abs: torch.Tensor | None = None,
+        reconstruction_relative_rms: torch.Tensor | None = None,
+        reconstruction_top1_match: torch.Tensor | None = None,
+        reconstruction_mean_kl: torch.Tensor | None = None,
+        supervision_nonempty: torch.Tensor | None = None,
+        reservation: CandidateBinding | None = None,
+    ) -> None:
+        if self.pending is not None:
+            raise RuntimeError("max_in_flight=1")
+        request_ids = tuple(request_ids)
+        if prefix_lens.ndim != 1 or prefix_lens.shape[0] != len(request_ids):
+            raise ValueError("one prefix length is required per request")
+        trace_index = len(self.update_traces)
+        if (
+            trace_index >= self.trace_prefix_lens.shape[0]
+            or len(request_ids) > self.trace_prefix_lens.shape[1]
+        ):
+            raise RuntimeError("bounded update telemetry capacity exhausted")
+        prefix_row = self.trace_prefix_lens[trace_index, : len(request_ids)]
+        prefix_row.copy_(prefix_lens.detach().to(torch.int64))
+        finite = finite.reshape(()).to(device=self.device, dtype=torch.bool)
+        if reconstruction_ok is None:
+            reconstruction_ok = torch.ones((), device=self.device, dtype=torch.bool)
+        else:
+            reconstruction_ok = reconstruction_ok.reshape(()).to(
+                device=self.device, dtype=torch.bool
+            )
+        if reconstruction_max_abs is None:
+            reconstruction_max_abs = torch.zeros(
+                (), device=self.device, dtype=torch.float32
+            )
+        if reconstruction_relative_rms is None:
+            reconstruction_relative_rms = torch.full(
+                (), float("nan"), device=self.device, dtype=torch.float32
+            )
+        if reconstruction_top1_match is None:
+            reconstruction_top1_match = torch.full(
+                (), float("nan"), device=self.device, dtype=torch.float32
+            )
+        if reconstruction_mean_kl is None:
+            reconstruction_mean_kl = torch.full(
+                (), float("nan"), device=self.device, dtype=torch.float32
+            )
+        if supervision_nonempty is None:
+            supervision_nonempty = torch.ones(
+                (), device=self.device, dtype=torch.bool
+            )
+        else:
+            supervision_nonempty = supervision_nonempty.reshape(()).to(
+                device=self.device, dtype=torch.bool
+            )
+        publish_valid = finite & reconstruction_ok & supervision_nonempty
+        if reservation is None:
+            binding = CandidateBinding(
+                self.epoch,
+                source_version,
+                self.slot_generation,
+                source_round,
+            )
+        else:
+            if self.reserved != reservation:
+                raise RuntimeError("update reservation is stale or already consumed")
+            if (
+                source_round != reservation.source_round
+                or source_version != reservation.source_version
+                or not self._binding_fields_current(reservation)
+            ):
+                raise RuntimeError("update reservation no longer matches the cohort")
+            binding = reservation
+        online_hint_error = torch.full(
+            (), float("nan"), device=self.device, dtype=torch.float32
+        )
+        online_ensemble_entropy = torch.full_like(online_hint_error, float("nan"))
+        online_effective_experts = torch.full_like(online_hint_error, float("nan"))
+        online_probabilities = None
+        online_cumulative_losses = None
+        if isinstance(optimizer, OnlineSpecOptimizer):
+            if optimizer.method == "onlinespec_opt":
+                online_hint_error = (
+                    torch.stack(
+                        [
+                            (candidate - previous).to(torch.float32).square().sum()
+                            for candidate, previous in zip(
+                                proposal.second_moments,
+                                optimizer.second,
+                                strict=True,
+                            )
+                        ]
+                    )
+                    .sum()
+                    .sqrt()
+                )
+            elif optimizer.is_ensemble:
+                rate = optimizer.online_spec.hedge_learning_rate
+                if rate is None:
+                    raise AssertionError("validated Hedge state lacks its meta rate")
+                online_probabilities = torch.softmax(
+                    -rate * proposal.second_moments[0], dim=0
+                )
+                online_ensemble_entropy = -(
+                    online_probabilities * online_probabilities.clamp_min(1e-12).log()
+                ).sum()
+                online_effective_experts = online_ensemble_entropy.exp()
+                online_cumulative_losses = proposal.second_moments[0]
+        metric_row = self.trace_metrics[trace_index]
+        metric_row[0].copy_(loss.detach().reshape(()).to(torch.float32))
+        metric_row[1].copy_(finite.detach().to(torch.float32))
+        metric_row[2].copy_(reconstruction_ok.detach().to(torch.float32))
+        metric_row[3].copy_(reconstruction_max_abs.detach().to(torch.float32))
+        metric_row[4].copy_(online_hint_error)
+        metric_row[5].copy_(online_ensemble_entropy)
+        metric_row[6].copy_(online_effective_experts)
+        metric_row[7].copy_(reconstruction_relative_rms.detach().to(torch.float32))
+        metric_row[8].copy_(reconstruction_top1_match.detach().to(torch.float32))
+        metric_row[9].copy_(reconstruction_mean_kl.detach().to(torch.float32))
+        metric_row[10].copy_(supervision_nonempty.detach().to(torch.float32))
+        online_expert_row = self.trace_online_experts[trace_index]
+        online_expert_row.fill_(float("nan"))
+        if online_probabilities is not None and online_cumulative_losses is not None:
+            online_expert_row[:, 0].copy_(online_probabilities)
+            online_expert_row[:, 1].copy_(online_cumulative_losses)
+        self.update_traces.append(
+            UpdateTrace(
+                buffer_index=trace_index,
+                source_round=source_round,
+                source_version=source_version,
+                request_ids=request_ids,
+                prefix_count=len(request_ids),
+            )
+        )
+        candidate_tensors = (
+            proposal.parameters
+            + proposal.first_moments
+            + proposal.second_moments
+            + (
+                proposal.step,
+                publish_valid,
+                loss,
+                reconstruction_ok,
+                reconstruction_max_abs,
+                reconstruction_relative_rms,
+                reconstruction_top1_match,
+                reconstruction_mean_kl,
+                supervision_nonempty,
+                online_hint_error,
+                online_ensemble_entropy,
+                online_effective_experts,
+                prefix_row,
+                metric_row,
+                online_expert_row,
+            )
+        )
+        for tensor in candidate_tensors:
+            tensor.record_stream(self.side_stream)
+        device_validity = torch.stack(
+            (finite, reconstruction_ok, supervision_nonempty)
+        ).to(torch.uint8)
+        host_validity = self.host_validity[trace_index]
+        host_validity.copy_(device_validity, non_blocking=True)
+        device_validity.record_stream(self.side_stream)
+        # This event is the sole side->main publication dependency. Record it
+        # after proposal, staging, and device-resident evidence writes so both
+        # publication and later diagnostics observe one complete candidate.
+        ready = torch.cuda.Event(blocking=False)
+        ready.record(self.side_stream)
+        self.pending = ReadyCandidate(
+            binding=binding,
+            optimizer=optimizer,
+            optimizer_proposal=proposal,
+            inference_bank=inference_bank,
+            ready_event=ready,
+            candidate_tensors=candidate_tensors,
+            finite=publish_valid,
+            reconstruction_ok=reconstruction_ok,
+            supervision_nonempty=supervision_nonempty,
+            host_validity=host_validity,
+            trace_index=trace_index,
+        )
+        if reservation is not None:
+            self.reserved = None
+        self.counters["updates_launched"] += 1
+
+    def update_due(self) -> bool:
+        return (
+            self.disabled_reason is None
+            and self.round > 0
+            and self.round % self.config.stride == 0
+            and self.pending is None
+            and self.reserved is None
+        )
+
+    def reserve_update(self) -> CandidateBinding | None:
+        """Reserve a due signal whose proposal is verified in a later call."""
+        if not self.update_due():
+            return None
+        binding = CandidateBinding(
+            self.epoch,
+            self.active_version,
+            self.slot_generation,
+            self.round,
+        )
+        self.reserved = binding
+        return binding
+
+    def reservation_ready(self, binding: CandidateBinding) -> bool:
+        return (
+            self.disabled_reason is None
+            and self.pending is None
+            and self.reserved == binding
+            and self._binding_fields_current(binding)
+        )
+
+    def release_reservation(self, binding: CandidateBinding) -> None:
+        if self.reserved == binding:
+            self.reserved = None
+
+    def skip_update_no_supervision(
+        self, reservation: CandidateBinding | None = None
+    ) -> None:
+        """Account for a due update whose request boundary has no teacher row."""
+        if reservation is not None:
+            self.release_reservation(reservation)
+        self.counters["updates_skipped_no_supervision"] += 1
+
+    def _binding_fields_current(self, binding: CandidateBinding) -> bool:
+        return (
+            binding.cohort_epoch == self.epoch
+            and binding.source_version == self.active_version
+            and binding.slot_generation == self.slot_generation
+        )
+
+    def _binding_valid(self, candidate: ReadyCandidate) -> bool:
+        return self._binding_fields_current(candidate.binding)
+
+    def boundary(self) -> bool:
+        """Publish at L0 readiness, OnlineSPEC next-step, or TTS stride."""
+        candidate = self.pending
+        if candidate is None or self.disabled_reason is not None:
+            return False
+        if not self._binding_valid(candidate):
+            self.counters["version_mismatches"] += 1
+            self.counters["updates_discarded"] += 1
+            self.update_traces[candidate.trace_index].status = "version_conflict"
+            self.pending = None
+            return False
+        ready = candidate.ready_event
+        if ready is None:
+            raise RuntimeError("CUDA candidate has no ready event")
+        if self.config.method == "naive_async":
+            if not ready.query():
+                return False
+        elif self.config.method.startswith("onlinespec_"):
+            # Prequential online learning evaluates with w_t, observes the
+            # current feedback, and must expose w_(t+1) before the next
+            # prediction. The side stream may overlap the remainder of the
+            # current round, but it cannot lag by another full stride.
+            if self.round <= candidate.binding.source_round:
+                return False
+        else:
+            next_boundary = candidate.binding.source_round + self.config.stride
+            if self.round < next_boundary:
+                return False
+        main = torch.cuda.current_stream(self.device)
+        if self.config.method != "naive_async":
+            with self.timing("barrier"):
+                main.wait_event(ready)
+                # TTS has an explicit fixed-boundary barrier. Completing the
+                # side event also makes its pinned validity receipt readable.
+                ready.synchronize()
+        else:
+            main.wait_event(ready)
+        finite_ok = bool(candidate.host_validity[0].item())
+        reconstruction_ok = bool(candidate.host_validity[1].item())
+        supervision_ok = bool(candidate.host_validity[2].item())
+        if not finite_ok or not reconstruction_ok or not supervision_ok:
+            trace = self.update_traces[candidate.trace_index]
+            self._record_invalid_candidate(
+                trace,
+                finite_ok=finite_ok,
+                reconstruction_ok=reconstruction_ok,
+                supervision_ok=supervision_ok,
+            )
+            return False
+        with self.timing("publish"):
+            self._archive_latest_device_lengths()
+            candidate.optimizer.commit(candidate.optimizer_proposal, valid=None)
+            candidate.inference_bank.publish()
+        for tensor in candidate.candidate_tensors:
+            tensor.record_stream(main)
+        self.active_version += 1
+        trace = self.update_traces[candidate.trace_index]
+        trace.status = "published"
+        trace.published_version = self.active_version
+        self.pending = None
+        self.counters["updates_published"] += 1
+        return True
+
+    def begin_round(
+        self,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+        *,
+        allow_publish: bool = True,
+    ) -> int:
+        request_ids = tuple(request_ids)
+        if not request_ids:
+            raise ValueError("round telemetry requires a non-empty request batch")
+        if prefix_lens.ndim != 1 or prefix_lens.shape[0] != len(request_ids):
+            raise ValueError("one prefix length is required per round request")
+        repeated = set(request_ids) & self.active_round_rows.keys()
+        if repeated:
+            raise RuntimeError(
+                f"previous round telemetry is incomplete for {sorted(repeated)}"
+            )
+        self.round += 1
+        if len(self.pending_timings) >= 64:
+            self._drain_ready_timings()
+        self.counters["target_calls"] += len(request_ids)
+        if allow_publish:
+            self.boundary()
+        for request_id in request_ids:
+            state = self.requests.get(request_id)
+            if state is None:
+                self.requests[request_id] = RequestVersionState(
+                    self.active_version, self.slot_generation
+                )
+            else:
+                state.version = self.active_version
+        trace_index = len(self.round_traces)
+        if (
+            trace_index >= self.round_metrics.shape[0]
+            or len(request_ids) > self.round_metrics.shape[1]
+        ):
+            raise RuntimeError("bounded round telemetry capacity exhausted")
+        row = self.round_metrics[trace_index, : len(request_ids)]
+        row.fill_(-1)
+        row[:, 0].copy_(prefix_lens.detach().to(torch.int64))
+        trace = RoundTrace(
+            buffer_index=trace_index,
+            round_index=self.round,
+            source_version=self.active_version,
+            request_ids=request_ids,
+        )
+        self.round_traces.append(trace)
+        for index, request_id in enumerate(request_ids):
+            self.active_round_rows[request_id] = (trace, index)
+        return self.active_version
+
+    def record_round_outcome(
+        self,
+        request_ids: Sequence[str],
+        *,
+        verified_drafts: torch.Tensor,
+        accepted_drafts: torch.Tensor,
+        committed_tokens: torch.Tensor,
+    ) -> None:
+        request_ids = tuple(request_ids)
+        values = (verified_drafts, accepted_drafts, committed_tokens)
+        if any(
+            value.ndim != 1 or value.shape[0] != len(request_ids) for value in values
+        ):
+            raise ValueError("round outcome tensors must have one value per request")
+        if len(request_ids) != len(set(request_ids)):
+            raise ValueError("round outcome request ids must be unique")
+        active_rows = []
+        for request_id in request_ids:
+            active = self.active_round_rows.get(request_id)
+            if active is None:
+                raise RuntimeError(
+                    f"round outcome has no active proposal for {request_id}"
+                )
+            active_rows.append(active)
+        for output_index, (request_id, active) in enumerate(
+            zip(request_ids, active_rows, strict=True)
+        ):
+            trace, trace_index = active
+            row = self.round_metrics[trace.buffer_index, trace_index]
+            for column, value in enumerate(values, start=1):
+                row[column].copy_(value[output_index].detach().to(torch.int64))
+            self.active_round_rows.pop(request_id)
+
+    def commit_lengths(
+        self, request_ids: Sequence[str], new_lengths: Sequence[int]
+    ) -> None:
+        if len(request_ids) != len(new_lengths):
+            raise ValueError("one committed length is required per request")
+        for request_id, length in zip(request_ids, new_lengths, strict=True):
+            state = self.requests[request_id]
+            if int(length) < state.prefix_length:
+                self.counters["retractions"] += 1
+            state.append(int(length), state.version)
+
+    def record_device_commit(
+        self, request_ids: Sequence[str], new_lengths: torch.Tensor
+    ) -> None:
+        if not new_lengths.is_cuda:
+            self.commit_lengths(request_ids, new_lengths.tolist())
+            return
+        request_ids = tuple(request_ids)
+        if new_lengths.ndim != 1 or new_lengths.shape[0] != len(request_ids):
+            raise ValueError("one committed length is required per request")
+        main = torch.cuda.current_stream(self.device)
+        owned = new_lengths.detach().to(torch.int64).clone()
+        owned.record_stream(main)
+        for index, request_id in enumerate(request_ids):
+            self.latest_device_lengths[request_id] = (
+                owned[index],
+                self.active_version,
+            )
+
+    def _archive_latest_device_lengths(
+        self, request_ids: Sequence[str] | None = None
+    ) -> None:
+        selected = (
+            tuple(self.latest_device_lengths)
+            if request_ids is None
+            else tuple(
+                request_id
+                for request_id in request_ids
+                if request_id in self.latest_device_lengths
+            )
+        )
+        grouped: dict[int, list[tuple[str, torch.Tensor]]] = {}
+        for request_id in selected:
+            length, version = self.latest_device_lengths.pop(request_id)
+            grouped.setdefault(version, []).append((request_id, length))
+        if not grouped:
+            return
+        main = torch.cuda.current_stream(self.device)
+        for version, rows in grouped.items():
+            identifiers = tuple(request_id for request_id, _ in rows)
+            lengths = torch.stack([length for _, length in rows])
+            ready = torch.cuda.Event(blocking=False)
+            ready.record(main)
+            lengths.record_stream(main)
+            self.device_commits.append((identifiers, lengths, version, ready))
+
+    def finish_request(self, request_id: str) -> None:
+        # Keep compact version metadata until diagnostics are flushed. Tensor
+        # canvas state is owned and released by the backend adapter.
+        if request_id not in self.requests:
+            return
+        self._discard_active_round(request_id)
+        self._archive_latest_device_lengths((request_id,))
+
+    def abort_request(self, request_id: str) -> None:
+        if request_id not in self.requests:
+            return
+        self._discard_active_round(request_id)
+        self._archive_latest_device_lengths((request_id,))
+        self.slot_generation += 1
+        self.reserved = None
+        candidate = self.pending
+        if candidate is not None:
+            self.update_traces[candidate.trace_index].status = "request_aborted"
+            self.counters["updates_discarded"] += 1
+            self.pending = None
+
+    def reset(self) -> None:
+        self.side_stream.synchronize()
+        self.epoch += 1
+        self.active_version = 0
+        self.slot_generation += 1
+        self.round = 0
+        self.pending = None
+        self.reserved = None
+        self.requests.clear()
+        self.device_commits.clear()
+        self.latest_device_lengths.clear()
+        self.pending_timings.clear()
+        self.update_traces.clear()
+        self.round_traces.clear()
+        self.active_round_rows.clear()
+        self.disabled_reason = None
+        for key in self.counters:
+            self.counters[key] = 0
+        for key in self.timings_ms:
+            self.timings_ms[key] = 0.0
+        self.load_samples = 0
+        self.running_requests_sum = 0
+        self.running_requests_max = 0
+        self.waiting_requests_sum = 0
+        self.waiting_requests_max = 0
+
+    def _discard_active_round(self, request_id: str) -> None:
+        active = self.active_round_rows.pop(request_id, None)
+        if active is None:
+            return
+        trace, trace_index = active
+        row = self.round_metrics[trace.buffer_index, trace_index]
+        row[1:].zero_()
+
+    def disable(self, reason: str, *, exactness: bool = False) -> None:
+        self.disabled_reason = reason
+        self.pending = None
+        self.reserved = None
+        if exactness:
+            self.counters["exactness_violations"] += 1
+
+    def bind_memory(
+        self,
+        *,
+        resident_tensors: Sequence[torch.Tensor],
+        peak_scratch_bytes: int,
+        trainable_tensors: Sequence[torch.Tensor] = (),
+        categories: dict[str, int] | None = None,
+    ) -> None:
+        resident = sum(
+            tensor.numel() * tensor.element_size() for tensor in resident_tensors
+        )
+        peak = resident + int(peak_scratch_bytes)
+        if peak > self.reserve_bytes:
+            raise MemoryError(
+                f"adaptation peak {peak} exceeds pre-KV reserve "
+                f"{self.reserve_bytes}; no CPU offload or silent downgrade"
+            )
+        self.resident_bytes = resident
+        self.peak_bytes = peak
+        self.trainable_parameters = sum(tensor.numel() for tensor in trainable_tensors)
+        if categories is None:
+            categories = {
+                "active_or_base_bytes": resident,
+                "master_fp32_bytes": 0,
+                "gradient_bytes": 0,
+                "first_moment_bytes": 0,
+                "second_moment_bytes": 0,
+                "online_state_bytes": 0,
+                "optimizer_metadata_bytes": 0,
+                "staging_bytes": 0,
+                "training_activation_bytes": int(peak_scratch_bytes),
+                "kv_gather_scratch_bytes": 0,
+                "candidate_scratch_bytes": 0,
+                "graph_buffer_bytes": 0,
+                "telemetry_bytes": 0,
+            }
+        required_categories = {
+            "active_or_base_bytes",
+            "master_fp32_bytes",
+            "gradient_bytes",
+            "first_moment_bytes",
+            "second_moment_bytes",
+            "online_state_bytes",
+            "optimizer_metadata_bytes",
+            "staging_bytes",
+            "training_activation_bytes",
+            "kv_gather_scratch_bytes",
+            "candidate_scratch_bytes",
+            "graph_buffer_bytes",
+            "telemetry_bytes",
+        }
+        if set(categories) != required_categories or any(
+            int(value) < 0 for value in categories.values()
+        ):
+            raise ValueError("adaptation memory categories are incomplete")
+        resident_from_categories = sum(
+            int(categories[name])
+            for name in (
+                "active_or_base_bytes",
+                "master_fp32_bytes",
+                "first_moment_bytes",
+                "second_moment_bytes",
+                "online_state_bytes",
+                "optimizer_metadata_bytes",
+                "staging_bytes",
+                "graph_buffer_bytes",
+                "telemetry_bytes",
+            )
+        )
+        scratch_from_categories = sum(
+            int(categories[name])
+            for name in (
+                "gradient_bytes",
+                "training_activation_bytes",
+                "kv_gather_scratch_bytes",
+                "candidate_scratch_bytes",
+            )
+        )
+        if resident_from_categories != resident:
+            raise ValueError("resident adaptation memory ledger does not sum")
+        if scratch_from_categories != int(peak_scratch_bytes):
+            raise ValueError("peak adaptation memory ledger does not sum")
+        self.optimizer_bytes = sum(
+            int(categories[name])
+            for name in (
+                "master_fp32_bytes",
+                "first_moment_bytes",
+                "second_moment_bytes",
+                "online_state_bytes",
+                "optimizer_metadata_bytes",
+            )
+        )
+        self.memory_ledger = {
+            **{name: int(value) for name, value in categories.items()},
+            "resident_bytes": resident,
+            "optimizer_bytes": self.optimizer_bytes,
+            "peak_bytes": peak,
+        }
+
+    def note_load(
+        self,
+        *,
+        running_requests: int,
+        waiting_requests: int,
+        graph_replay: bool,
+    ) -> None:
+        self.load_samples += 1
+        self.running_requests_sum += int(running_requests)
+        self.running_requests_max = max(
+            self.running_requests_max, int(running_requests)
+        )
+        self.waiting_requests_sum += int(waiting_requests)
+        self.waiting_requests_max = max(
+            self.waiting_requests_max, int(waiting_requests)
+        )
+        self.counters["graph_replay_total"] += 1
+        self.counters["graph_replay_hits"] += int(graph_replay)
+
+    def _drain_ready_timings(self) -> None:
+        while self.pending_timings and self.pending_timings[0].finished.query():
+            timing = self.pending_timings.popleft()
+            self.timings_ms[timing.name] += timing.started.elapsed_time(timing.finished)
+
+    def _drain_diagnostics(
+        self,
+    ) -> tuple[list[list[int]], list[list[float]], list[list[list[float]]]]:
+        # Metrics and OnlineSPEC expert rows are written after the timed
+        # training/optimizer/merge regions.  Waiting only for those timing
+        # events can therefore expose a partially written final row when a
+        # request finishes with one candidate still in flight.  The candidate
+        # ready event is the single completion fence for all evidence writes.
+        candidate = self.pending
+        if candidate is not None:
+            ready = candidate.ready_event
+            if ready is None:
+                raise RuntimeError("CUDA candidate has no ready event")
+            ready.synchronize()
+        while self.pending_timings:
+            timing = self.pending_timings.popleft()
+            timing.finished.synchronize()
+            self.timings_ms[timing.name] += timing.started.elapsed_time(timing.finished)
+        prefix_rows = self.trace_prefix_lens[: len(self.update_traces)].tolist()
+        metric_rows = self.trace_metrics[: len(self.update_traces)].tolist()
+        expert_rows = self.trace_online_experts[: len(self.update_traces)].tolist()
+        for trace in self.update_traces:
+            if trace.diagnosed:
+                continue
+            metrics = metric_rows[trace.buffer_index]
+            finite_ok = bool(metrics[1])
+            reconstruction_ok = bool(metrics[2])
+            supervision_ok = bool(metrics[10])
+            if not finite_ok or not reconstruction_ok or not supervision_ok:
+                self._record_invalid_candidate(
+                    trace,
+                    finite_ok=finite_ok,
+                    reconstruction_ok=reconstruction_ok,
+                    supervision_ok=supervision_ok,
+                )
+            else:
+                trace.diagnosed = True
+        return prefix_rows, metric_rows, expert_rows
+
+    def _record_invalid_candidate(
+        self,
+        trace: UpdateTrace,
+        *,
+        finite_ok: bool,
+        reconstruction_ok: bool,
+        supervision_ok: bool = True,
+    ) -> None:
+        """Account for one invalid candidate exactly once and fail closed."""
+        if trace.diagnosed:
+            return
+        if not supervision_ok:
+            trace.status = "no_supervision"
+        elif not finite_ok:
+            trace.status = "nonfinite_update"
+        else:
+            trace.status = "reconstruction_mismatch"
+        trace.diagnosed = True
+        self.counters["updates_discarded"] += 1
+        if not supervision_ok:
+            self.counters["updates_skipped_no_supervision"] += 1
+        elif not finite_ok:
+            self.counters["nonfinite_updates"] += 1
+            self.disabled_reason = "nonfinite_update"
+        elif not reconstruction_ok:
+            self.counters["exactness_violations"] += 1
+            self.counters["fallbacks"] += 1
+            self.disabled_reason = "logit_reconstruction_mismatch"
+        candidate = self.pending
+        if candidate is not None and candidate.trace_index == trace.buffer_index:
+            self.pending = None
+
+    def diagnostics(self, *, extra: dict | None = None) -> dict:
+        trace_prefix_rows, trace_metric_rows, trace_expert_rows = (
+            self._drain_diagnostics()
+        )
+        if self.active_round_rows:
+            raise RuntimeError("cannot diagnose an incomplete decode round")
+        self._archive_latest_device_lengths()
+        for request_ids, lengths, version, ready in self.device_commits:
+            ready.synchronize()
+            for request_id, length in zip(request_ids, lengths.tolist(), strict=True):
+                state = self.requests.get(request_id)
+                if state is not None:
+                    if int(length) < state.prefix_length:
+                        self.counters["retractions"] += 1
+                    state.append(int(length), version)
+        self.device_commits.clear()
+        round_metric_rows = self.round_metrics[: len(self.round_traces)].tolist()
+        graph_total = self.counters["graph_replay_total"]
+        graph_hit_rate = (
+            self.counters["graph_replay_hits"] / graph_total if graph_total else 0.0
+        )
+        load_samples = self.load_samples
+        side_update_ms = sum(
+            self.timings_ms[name] for name in ("training", "optimizer", "merge")
+        )
+        exposed_update_ms = self.timings_ms["barrier"] + self.timings_ms["publish"]
+        overlap_ratio = (
+            max(0.0, min(1.0, 1.0 - exposed_update_ms / side_update_ms))
+            if side_update_ms > 0
+            else 0.0
+        )
+        payload = {
+            "schema_version": 2,
+            "adaptation_config_sha256": self.config.sha256,
+            "enabled": self.disabled_reason is None,
+            "disabled_reason": self.disabled_reason,
+            "cohort_sha256": self.cohort_sha256,
+            "active_version": self.active_version,
+            "round": self.round,
+            "resident_bytes": self.resident_bytes,
+            "peak_bytes": self.peak_bytes,
+            "peak_hbm_bytes": int(torch.cuda.max_memory_allocated(self.device)),
+            "optimizer_bytes": self.optimizer_bytes,
+            "trainable_parameters": self.trainable_parameters,
+            "memory_ledger": dict(self.memory_ledger),
+            "parameter_layout_sha256": self.parameter_layout_sha256,
+            "batch_fill": (
+                self.running_requests_sum / load_samples if load_samples else 0.0
+            ),
+            "max_batch_size": self.running_requests_max,
+            "queue_occupancy": (
+                self.waiting_requests_sum / load_samples if load_samples else 0.0
+            ),
+            "max_queue_occupancy": self.waiting_requests_max,
+            "graph_replay_hit_rate": graph_hit_rate,
+            "exposed_update_ms": exposed_update_ms,
+            "main_side_overlap_ratio": overlap_ratio,
+            "counters": dict(self.counters),
+            "timings_ms": dict(self.timings_ms),
+            "updates": [
+                {
+                    "source_round": trace.source_round,
+                    "source_version": trace.source_version,
+                    "request_ids": list(trace.request_ids),
+                    "prefix_len_before": trace_prefix_rows[trace.buffer_index][
+                        : trace.prefix_count
+                    ],
+                    "published_version": trace.published_version,
+                    "status": trace.status,
+                    "loss": float(trace_metric_rows[trace.buffer_index][0]),
+                    "reconstruction_ok": bool(trace_metric_rows[trace.buffer_index][2]),
+                    "reconstruction_max_abs": float(
+                        trace_metric_rows[trace.buffer_index][3]
+                    ),
+                    "reconstruction_relative_rms": (
+                        float(trace_metric_rows[trace.buffer_index][7])
+                        if math.isfinite(trace_metric_rows[trace.buffer_index][7])
+                        else None
+                    ),
+                    "reconstruction_top1_match": (
+                        float(trace_metric_rows[trace.buffer_index][8])
+                        if math.isfinite(trace_metric_rows[trace.buffer_index][8])
+                        else None
+                    ),
+                    "supervision_nonempty": bool(
+                        trace_metric_rows[trace.buffer_index][10]
+                    ),
+                    "reconstruction_mean_kl": (
+                        float(trace_metric_rows[trace.buffer_index][9])
+                        if math.isfinite(trace_metric_rows[trace.buffer_index][9])
+                        else None
+                    ),
+                    "online_hint_error": (
+                        float(trace_metric_rows[trace.buffer_index][4])
+                        if math.isfinite(trace_metric_rows[trace.buffer_index][4])
+                        else None
+                    ),
+                    "online_ensemble_entropy": (
+                        float(trace_metric_rows[trace.buffer_index][5])
+                        if math.isfinite(trace_metric_rows[trace.buffer_index][5])
+                        else None
+                    ),
+                    "online_effective_experts": (
+                        float(trace_metric_rows[trace.buffer_index][6])
+                        if math.isfinite(trace_metric_rows[trace.buffer_index][6])
+                        else None
+                    ),
+                    "online_expert_probabilities": (
+                        [float(row[0]) for row in trace_expert_rows[trace.buffer_index]]
+                        if all(
+                            math.isfinite(row[0])
