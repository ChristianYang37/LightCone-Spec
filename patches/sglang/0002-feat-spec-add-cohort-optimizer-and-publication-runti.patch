+_MUON_COEFFICIENTS = (3.4445, -4.7750, 2.0315)
+
+
+def notify_online_adapters(
+    adapters: Sequence[object | None],
+    *,
+    action: str,
+    request_id: str,
+) -> None:
+    """Apply one request lifecycle event to every active parameterization."""
+    if action not in {"finish", "abort"}:
+        raise ValueError("unknown online-adapter lifecycle action")
+    callback_name = f"{action}_request"
+    for adapter in adapters:
+        if adapter is not None:
+            getattr(adapter, callback_name)(request_id)
+
+
+def zeroth_power_newton_schulz(
+    matrix: torch.Tensor,
+    *,
+    steps: int,
+    epsilon: float,
+) -> torch.Tensor:
+    """Orthogonalize one Muon matrix on device without a host round trip."""
+    if matrix.ndim != 2:
+        raise ValueError("Muon orthogonalization requires a matrix")
+    if not 1 <= steps <= 20:
+        raise ValueError("Muon Newton--Schulz steps must be in [1, 20]")
+    work = matrix.to(torch.bfloat16)
+    transposed = work.shape[0] > work.shape[1]
+    if transposed:
+        work = work.T
+    work = work / work.norm().clamp_min(epsilon)
+    a, b, c = _MUON_COEFFICIENTS
+    for _ in range(steps):
+        gram = work @ work.T
+        polynomial = torch.addmm(gram, gram, gram, beta=b, alpha=c)
+        work = torch.addmm(work, polynomial, work, beta=a)
+    if transposed:
+        work = work.T
+    return work.to(torch.float32)
+
+
+def estimate_full_vocab_training_scratch_bytes(
+    *, batch_tokens: int, vocab_size: int
+) -> int:
+    """Conservative peak for update-only target-to-draft KL tensors.
+
+    The budget covers model-dtype target/draft copies plus the FP32 target,
+    draft, probability, log-probability, and KL intermediates. It is an HBM
+    admission bound, not a claim that the allocator retains every tensor at
+    the same instant.
+    """
+    if batch_tokens < 1 or vocab_size < 1:
+        raise ValueError("full-vocabulary scratch dimensions must be positive")
+    bytes_per_logit = 8 * 4
+    return int(batch_tokens) * int(vocab_size) * bytes_per_logit
+
+
+def estimate_functional_optimizer_scratch_bytes(
+    optimizer,
+    *,
+    merge_bytes: int,
+) -> int:
+    """Peak candidate state outside gradients and model activations.
+
+    The functional path retains trainable leaves, an optimizer proposal, and
+    the validity-guarded proposal copied into the pending candidate. Backend
+    publication may additionally materialize merged/staged inference tensors.
+    Counting actual moment layouts keeps one-state optimizers from inheriting
+    Adam's two-state reserve while still preventing Adam under-accounting.
+    """
+
+    if merge_bytes < 0:
+        raise ValueError("optimizer merge scratch cannot be negative")
+
+    def bytes_of(tensors: Sequence[torch.Tensor]) -> int:
+        return sum(tensor.numel() * tensor.element_size() for tensor in tensors)
+
+    master = bytes_of(optimizer.master)
+    moments = bytes_of(optimizer.first) + bytes_of(optimizer.second)
+    return master + 2 * (master + moments) + int(merge_bytes)
+
+
