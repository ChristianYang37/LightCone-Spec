+    def _reference(self, manager, hidden, *, row_start, depth, start, end):
+        outputs = []
+        for token_index, token_hidden in enumerate(hidden):
+            request_index = (row_start + token_index) // depth
+            row = manager.adapter_rows[request_index : request_index + 1]
+            token_hidden = token_hidden.view(1, -1)
+            if manager.shapes.mode == "output_residual":
+                outputs.append(
+                    manager._output_residual(
+                        token_hidden,
+                        row,
+                        manager._basis_forward[start:end],
+                    )
+                )
+            else:
+                delta_hidden = manager._delta_hidden(token_hidden, row)
+                outputs.append(
+                    manager._projection.project_hidden_range(
+                        delta_hidden,
+                        vocab_start=start,
+                        vocab_end=end,
+                    )
+                )
+        return torch.cat(outputs, dim=0)
+
