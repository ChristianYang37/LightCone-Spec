@@ -0,0 +1,609 @@
+"""CPU contract tests for DFlash tail adaptation.
+
+The CUDA graph replay/address checks live in GPU-marked integration tests; this
+module keeps the public callback, eager/graph sampling semantics, exactness
+guards, and lifecycle forwarding testable without a model or accelerator.
+"""
+
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.speculative.dflash_info_v2 import (
+    dflash_semantic_valid_mask,
+)
+from sglang.srt.speculative.dflash_utils import (
+    DFlashTargetDecodeRequired,
+    apply_dflash_tail_correction,
+    validate_dflash_adaptation_startup,
+    validate_dflash_exact_sampling,
+)
+from sglang.test.ci.ci_register import register_cuda_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cuda_ci(est_time=15, stage="base-b", runner_config="1-gpu-small")
+
+_HAS_CUDA = torch.cuda.is_available()
+
+
+class _TokenTwoTail:
+    capture_proposal_signals = True
+
+    def __init__(self):
+        self.calls = []
+        self.finished = []
+
+    def correct_draft_logits(self, **kwargs):
+        self.calls.append(
+            {
+                key: value
+                for key, value in kwargs.items()
+                if key not in ("hidden_states", "raw_logits")
+            }
+        )
+        out = kwargs["raw_logits"].clone()
+        out[:, 2].add_(100.0)
+        return out
+
+    def source_adapter_versions(self, batch):
+        return tuple(range(len(batch.reqs)))
+
+    def finish_request(self, *, rid, natural_stop):
+        self.finished.append((rid, natural_stop))
+
+
+class TestDFlashTailCorrection(CustomTestCase):
+    def test_disabled_is_identity_without_callback(self):
+        raw = torch.randn(3, 5)
+        corrected = apply_dflash_tail_correction(
+            None,
+            hidden_states=torch.randn(3, 2),
+            raw_logits=raw,
+            row_start=0,
+            rows_per_request=3,
+            vocab_start=0,
+            vocab_end=5,
+            graph_capture=False,
+        )
+        self.assertIs(corrected, raw)
+
+    def test_contract_rejects_shape_device_or_dtype_changes(self):
+        hidden = torch.randn(2, 3)
+        raw = torch.randn(2, 4)
+
+        class Bad:
+            def __init__(self, fn):
+                self.fn = fn
+
+            def correct_draft_logits(self, **kwargs):
+                return self.fn(kwargs["raw_logits"])
+
+        cases = [
+            Bad(lambda value: value[:, :-1]),
+            Bad(lambda value: value.to(torch.float64)),
+            Bad(lambda value: "not-a-tensor"),
+        ]
+        for adapter in cases:
+            with self.assertRaises((TypeError, ValueError)):
+                apply_dflash_tail_correction(
+                    adapter,
+                    hidden_states=hidden,
+                    raw_logits=raw,
+                    row_start=0,
+                    rows_per_request=2,
+                    vocab_start=0,
+                    vocab_end=4,
+                    graph_capture=False,
+                )
+
+    def test_graph_sampler_applies_tail_before_argmax_and_retains_signals(self):
+        from sglang.srt.speculative.dflash_worker_v2 import _DflashDraftSampler
+
+        weight = torch.tensor(
+            [[1.0, 0.0], [0.0, 1.0], [-1.0, -1.0], [0.5, 0.5]]
+        )
+        hidden = torch.tensor([[0.0, 0.0], [4.0, 0.0], [0.0, 4.0]])
+        tail = _TokenTwoTail()
+        sampler = _DflashDraftSampler(
+            weight=weight,
+            block_size=3,
+            num_org=4,
+            org_vocab_start=0,
+            max_bs=1,
+            tail_adaptation=tail,
+        )
+        sampler(hidden)
+
+        torch.testing.assert_close(sampler.out[:2], torch.tensor([2, 2]))
+        self.assertIsNotNone(sampler.tail_hidden)
+        self.assertIsNotNone(sampler.raw_logits)
+        self.assertIsNotNone(sampler.proposal_logits)
+        self.assertEqual(tail.calls[0]["rows_per_request"], 2)
+        self.assertTrue(tail.calls[0]["graph_capture"])
+
+    def test_graph_sampler_disabled_does_not_retain_adaptation_tensors(self):
+        from sglang.srt.speculative.dflash_worker_v2 import _DflashDraftSampler
+
+        sampler = _DflashDraftSampler(
+            weight=torch.eye(3),
+            block_size=2,
+            num_org=3,
+            org_vocab_start=0,
+            max_bs=1,
+        )
+        sampler(torch.eye(3)[:2])
+        self.assertIsNone(sampler.tail_hidden)
+        self.assertIsNone(sampler.raw_logits)
+        self.assertIsNone(sampler.proposal_logits)
+
+    def test_graph_supervision_uses_current_bs4_replay_after_bs8_capture(self):
+        """The final Python capture reference must not define replay shape.
+
+        Decode graphs are captured bs8 -> ... -> bs1.  Before this regression
+        fix, a later bs4 replay read the sampler's bs1 ``tail_hidden`` and
+        silently reshaped ``3 x H`` into ``12 x H/4`` whenever H was divisible
+        by four.  Use sentinel rows and a divisible hidden width so this test
+        catches row mixing rather than relying on ``view`` to raise.
+        """
+
+        from sglang.srt.speculative.dflash_worker_v2 import (
+            DFlashWorkerV2,
+            _DflashDraftSampler,
+        )
+
+        block_size = 4
+        hidden_size = 8
+        # Keep the native head non-trivial while ensuring the +100 tail makes
+        # token two the unambiguous winner.  The test is about replay-row
+        # ownership, not the arbitrary scale of this synthetic LM head.
+        weight = torch.arange(6 * hidden_size, dtype=torch.float32).view(
+            6, hidden_size
+        ) / 10_000.0
+        tail = _TokenTwoTail()
+        sampler = _DflashDraftSampler(
+            weight=weight,
+            block_size=block_size,
+            num_org=6,
+            org_vocab_start=0,
+            max_bs=8,
+            tail_adaptation=tail,
+        )
+        sampler(torch.randn(8 * block_size, hidden_size))
+        sampler(torch.randn(block_size, hidden_size))
+        self.assertEqual(tuple(sampler.tail_hidden.shape), (3, hidden_size))
+
+        replay_hidden = torch.arange(
+            4 * block_size * hidden_size, dtype=torch.float32
+        ).view(4 * block_size, hidden_size)
+        draft_out = SimpleNamespace(
+            can_run_graph=True,
+            logits_output=SimpleNamespace(hidden_states=replay_hidden),
+        )
+        worker = object.__new__(DFlashWorkerV2)
+        worker.block_size = block_size
+        worker._draft_sampler = sampler
+        draft_next, signals = worker._sample_dflash_draft_head(
+            draft_out=draft_out,
+            batch_size=4,
+            lm_head=SimpleNamespace(weight=weight),
+            adaptation=tail,
+            capture_tail_signals=True,
+        )
+
+        expected_hidden = replay_hidden.view(
+            4, block_size, hidden_size
+        )[:, 1:, :].reshape(12, hidden_size)
+        self.assertEqual(tuple(draft_next.shape), (4, 3))
+        self.assertIsNotNone(signals)
+        torch.testing.assert_close(signals.tail_hidden, expected_hidden)
+        self.assertEqual(tuple(signals.raw_logits.shape), (12, 6))
+        self.assertEqual(tuple(signals.proposal_logits.shape), (12, 6))
+        torch.testing.assert_close(draft_next, torch.full((4, 3), 2))
+
+    def test_graph_supervision_reuses_resolved_replay_bucket_head(self):
+        """Supervision must not launch a second full-vocabulary head matmul."""
+
+        from sglang.srt.speculative.dflash_worker_v2 import (
+            DFlashWorkerV2,
+            _DflashDraftSampler,
+        )
+
+        block_size = 3
+        hidden_size = 2
+        weight = torch.tensor(
+            [[1.0, 0.0], [0.0, 1.0], [-1.0, -1.0], [0.5, 0.5]]
+        )
+        tail = _TokenTwoTail()
+        sampler = _DflashDraftSampler(
+            weight=weight,
+            block_size=block_size,
+            num_org=4,
+            org_vocab_start=0,
+            max_bs=4,
+            tail_adaptation=tail,
+        )
+        captured_hidden = torch.arange(
+            4 * block_size * hidden_size, dtype=torch.float32
+        ).view(4 * block_size, hidden_size)
+        sampler(captured_hidden)
+        captured_call_count = len(tail.calls)
+
+        # A real replay updates the captured tensors in place.  The unit test
+        # only needs to prove bucket ownership and that no eager callback is
+        # launched; the captured sentinel values therefore remain sufficient.
+        worker = object.__new__(DFlashWorkerV2)
+        worker.block_size = block_size
+        worker._draft_sampler = sampler
+        worker.draft_model_runner = SimpleNamespace(
+            decode_cuda_graph_runner=SimpleNamespace(bs=4)
+        )
+        draft_out = SimpleNamespace(
+            can_run_graph=True,
+            logits_output=SimpleNamespace(
+                hidden_states=torch.full((2 * block_size, hidden_size), -99.0)
+            ),
+        )
+        draft_next, signals = worker._sample_dflash_draft_head(
+            draft_out=draft_out,
+            batch_size=2,
+            lm_head=SimpleNamespace(weight=weight),
+            adaptation=tail,
+            capture_tail_signals=True,
+        )
+
+        expected_hidden = captured_hidden.view(
+            4, block_size, hidden_size
+        )[:2, 1:, :].reshape(4, hidden_size)
+        self.assertEqual(len(tail.calls), captured_call_count)
+        self.assertEqual(tuple(draft_next.shape), (2, 2))
+        self.assertIsNotNone(signals)
+        torch.testing.assert_close(signals.tail_hidden, expected_hidden)
+        self.assertEqual(tuple(signals.raw_logits.shape), (4, 4))
+        self.assertEqual(tuple(signals.proposal_logits.shape), (4, 4))
+
+    def test_graph_supervision_rejects_malformed_replay_hidden(self):
+        from sglang.srt.speculative.dflash_worker_v2 import DFlashWorkerV2
+
+        worker = object.__new__(DFlashWorkerV2)
+        worker.block_size = 4
+        worker._draft_sampler = SimpleNamespace(out=torch.empty(24, dtype=torch.long))
+        malformed = SimpleNamespace(
+            can_run_graph=True,
+            logits_output=SimpleNamespace(hidden_states=torch.zeros(15, 8)),
+        )
+        with self.assertRaisesRegex(RuntimeError, "replay hidden shape mismatch"):
+            worker._sample_dflash_draft_head(
+                draft_out=malformed,
+                batch_size=4,
+                lm_head=SimpleNamespace(weight=torch.zeros(6, 8)),
+                adaptation=_TokenTwoTail(),
+                capture_tail_signals=True,
+            )
+
+    def test_eager_sampler_captures_scores_and_chunk_offsets(self):
+        from sglang.srt.speculative.dflash_worker_v2 import DFlashWorkerV2
+
+        fake = SimpleNamespace()
+        hidden = torch.tensor([[3.0, 0.0], [0.0, 3.0]])
+        lm_head = SimpleNamespace(
+            weight=torch.tensor(
+                [[1.0, 0.0], [0.0, 1.0], [-1.0, -1.0], [0.5, 0.5]]
+            )
+        )
+        tail = _TokenTwoTail()
+        result = DFlashWorkerV2._sample_from_vocab_parallel_head(
+            fake,
+            hidden_states=hidden,
+            lm_head=lm_head,
+            tail_adaptation=tail,
+            capture_signals=True,
+            rows_per_request=2,
+            chunk_size=1,
+        )
+
+        torch.testing.assert_close(result.token_ids, torch.tensor([2, 2]))
+        torch.testing.assert_close(result.tail_hidden, hidden)
+        self.assertEqual(result.raw_logits.shape, (2, 4))
+        self.assertEqual(result.proposal_logits.shape, (2, 4))
+        self.assertEqual(result.vocab_ranges, ((0, 4),))
+        self.assertEqual([call["row_start"] for call in tail.calls], [0, 1])
+
+
+class TestDFlashExactnessGuard(CustomTestCase):
+    def test_adapted_stochastic_requires_unit_thresholds(self):
+        with self.assertRaisesRegex(ValueError, "threshold_single=1.0"):
+            validate_dflash_exact_sampling(
+                adaptation_enabled=True,
+                is_all_greedy=False,
+                sampling_kernel_available=True,
+                threshold_single=0.9,
+                threshold_acc=1.0,
+            )
+
+    def test_missing_kernel_requests_target_decode(self):
+        with self.assertRaises(DFlashTargetDecodeRequired):
+            validate_dflash_exact_sampling(
+                adaptation_enabled=True,
+                is_all_greedy=False,
+                sampling_kernel_available=False,
+                threshold_single=1.0,
+                threshold_acc=1.0,
+            )
+
+    def test_startup_converts_missing_kernel_to_actionable_fail_closed(self):
+        with self.assertRaisesRegex(
+            RuntimeError, "scheduler-wide.*next_draft_input=None"
+        ):
+            validate_dflash_adaptation_startup(
+                sampling_kernel_available=False,
+                threshold_single=1.0,
+                threshold_acc=1.0,
+            )
+
+    def test_startup_validates_stochastic_superset(self):
+        validate_dflash_adaptation_startup(
+            sampling_kernel_available=True,
+            threshold_single=1.0,
+            threshold_acc=1.0,
+        )
+        with self.assertRaisesRegex(RuntimeError, "threshold_single=1.0"):
+            validate_dflash_adaptation_startup(
+                sampling_kernel_available=True,
+                threshold_single=0.9,
+                threshold_acc=1.0,
+            )
+
+    def test_greedy_startup_does_not_require_stochastic_kernel(self):
+        validate_dflash_adaptation_startup(
+            sampling_kernel_available=False,
+            threshold_single=1.0,
