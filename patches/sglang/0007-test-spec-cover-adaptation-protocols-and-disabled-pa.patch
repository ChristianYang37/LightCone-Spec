+                        expected_hidden_features,
+                        expected_markov_features,
+                        torch.ones(2, 3, 1, dtype=torch.bfloat16),
+                    ],
+                    dim=-1,
+                )
+                torch.testing.assert_close(
+                    confidence, expected_confidence, rtol=0, atol=0
+                )
