+def test_tail_row_capacity_matches_request_and_resolved_graph_contract():
+    worker = SimpleNamespace(
+        server_args=SimpleNamespace(
+            max_running_requests=20,
+            cuda_graph_config=SimpleNamespace(
+                decode=SimpleNamespace(max_bs=20, bs=[1, 2, 4, 8, 20])
+            ),
+        )
+    )
+    assert LightConeTailAdaptationManager._row_capacity(worker, 4) == 20
+
+    worker.server_args.cuda_graph_config.decode.max_bs = 32
+    worker.server_args.cuda_graph_config.decode.bs = [1, 8, 32]
+    assert LightConeTailAdaptationManager._row_capacity(worker, 4) == 32
+
+
+class _DenseProjection:
+    def __init__(self, weight: torch.Tensor):
+        self.weight = weight
+
+    def project_hidden(self, hidden: torch.Tensor) -> torch.Tensor:
+        return hidden.to(self.weight.dtype) @ self.weight.T
+
+    def project_hidden_range(
+        self, hidden: torch.Tensor, *, vocab_start: int, vocab_end: int
+    ) -> torch.Tensor:
+        weight = self.weight[vocab_start:vocab_end]
+        return hidden.to(weight.dtype) @ weight.T
+
+
+def _manager(mode: str, *, capacity: int = 4):
+    hidden_size, rank, vocab_size, depth = 5, 3, 7, 3
+    manager = object.__new__(LightConeTailAdaptationManager)
+    manager.shapes = SimpleNamespace(
+        mode=mode,
+        hidden_size=hidden_size,
+        rank=rank,
+        vocab_size=vocab_size,
+        draft_depth=depth,
+    )
+    if mode == "output_residual":
+        num_params = rank * 128
+        manager._slices = {"a_h": slice(0, num_params)}
+    elif mode == "tail_lora":
+        split = hidden_size * rank
+        num_params = 2 * split
+        manager._slices = {
+            "a_h": slice(0, split),
+            "b_h": slice(split, num_params),
+        }
+    else:
+        num_params = hidden_size * hidden_size
+        manager._slices = {"d_h": slice(0, num_params)}
+    manager._forward_dtype = torch.bfloat16
+    manager.adapter_rows = torch.zeros(
+        capacity, num_params, dtype=manager._forward_dtype
+    )
+    manager._r_h_forward = torch.randn(hidden_size, 128).to(
+        manager._forward_dtype
+    )
+    manager._basis_forward = torch.randn(vocab_size, rank).to(
+        manager._forward_dtype
+    )
+    manager._projection = _DenseProjection(
+        torch.randn(vocab_size, hidden_size).to(torch.bfloat16)
+    )
+    return manager
+
+
+def _dspark_manager(mode: str, *, capacity: int = 3):
+    """Build only the graph-visible DSpark tail math, without a model."""
+
+    hidden, markov, rank, vocab, depth = 5, 4, 3, 7, 3
+    manager = object.__new__(DSparkAdaptationManager)
+    confidence_width = (
+        128 + markov + 1 if mode == "output_residual" else hidden + markov + 1
+    )
+    manager.shapes = SimpleNamespace(
+        mode=mode,
+        hidden_size=hidden,
+        markov_dim=markov,
+        rank=rank,
+        vocab_size=vocab,
+        draft_depth=depth,
+        conf_feature_dim=confidence_width,
+    )
+    cursor = 0
+    slices = {}
+
+    def take(name, count):
+        nonlocal cursor
+        slices[name] = slice(cursor, cursor + count)
+        cursor += count
+
+    if mode == "output_residual":
+        take("a_h", rank * 128)
+        take("a_m", rank * markov)
+    elif mode == "tail_lora":
+        take("a_h", hidden * rank)
+        take("a_m", markov * rank)
+        take("b_h", rank * hidden)
+    else:
+        take("d_h", hidden * hidden)
+        take("d_m", markov * hidden)
+    take("a_c", depth * confidence_width)
+    manager._parameter_slices = slices
+    manager._forward_dtype = torch.bfloat16
+    manager._r_h_dev = torch.randn(hidden, 128).to(torch.bfloat16)
+    manager._basis_dev = torch.randn(vocab, rank).to(torch.bfloat16)
+    manager._tail_projection = _DenseProjection(
+        torch.randn(vocab, hidden).to(torch.bfloat16)
+    )
+    manager.adapter_rows = torch.randn(capacity, cursor).to(torch.bfloat16)
+    return manager
+
+
+class TestSharedTailMath(CustomTestCase):
+    def test_dflash_batch_signals_own_graph_backed_source_tensors(self):
+        from sglang.srt.speculative.dflash_info_v2 import (
+            DFlashAcceptResult,
+            DFlashProposalSignals,
+        )
+
+        batch_size, depth, hidden_size, vocab_size = 2, 3, 8, 6
+        manager = object.__new__(LightConeTailAdaptationManager)
+        manager._dflash_accept = DFlashAcceptResult(
+            correct_len=torch.full((batch_size,), depth, dtype=torch.int32),
+            commit_lens=torch.full((batch_size,), depth + 1, dtype=torch.int32),
+            bonus=torch.zeros(batch_size, dtype=torch.long),
+        )
+        manager._dflash_request_semantics = lambda batch: (
+            [depth + 1] * batch_size,
+            [()] * batch_size,
+            [True] * batch_size,
+        )
+        manager._dflash_algorithmic_censored = None
+        manager.tp_size = 1
+        manager.shapes = SimpleNamespace(
+            vocab_size=vocab_size,
+            mode="tail_lora",
+        )
+        manager._disabled = set()
+        manager._capture_round = lambda rid: True
+        manager._forward_dtype = torch.float32
+        manager._r_h_dev = torch.arange(
+            hidden_size * 128, dtype=torch.float32
+        ).view(hidden_size, 128)
+        manager._round_of = {"r0": 4, "r1": 4}
+        manager._pinned_versions = {"r0": 0, "r1": 0}
+        launched = []
+        manager.runtime = SimpleNamespace(
+            wants_trace_signal=lambda rid: False,
+            launch_update_batch=lambda request_ids, signal: launched.append(
+                (request_ids, signal)
+            ),
+        )
+        manager.config = SimpleNamespace(update_stride=4)
+        manager._guard = lambda rid, fn: fn()
+
+        proposal = DFlashProposalSignals(
+            proposal_token_ids=torch.arange(batch_size * depth).view(
+                batch_size, depth
+            ),
+            tail_hidden=torch.arange(
+                batch_size * depth * hidden_size, dtype=torch.float32
+            ).view(batch_size, depth, hidden_size),
+            raw_logits=torch.arange(
+                batch_size * depth * vocab_size, dtype=torch.float32
+            ).view(batch_size, depth, vocab_size),
+            proposal_logits=(
+                torch.arange(
+                    batch_size * depth * vocab_size, dtype=torch.float32
+                ).view(batch_size, depth, vocab_size)
+                + 1000
+            ),
+            valid_mask=torch.ones(batch_size, depth, dtype=torch.bool),
+            prefix_lens_before=torch.tensor([4096, 16384]),
+            source_adapter_versions=torch.zeros(batch_size, dtype=torch.long),
+            vocab_ranges=((0, vocab_size),),
+        )
+        target_logits = (
+            torch.arange(
+                batch_size * (depth + 1) * vocab_size,
+                dtype=torch.float32,
+            ).view(batch_size * (depth + 1), vocab_size)
+            + 2000
+        )
+        expected = {
+            "hidden": proposal.tail_hidden.clone(),
+            "corrected": proposal.proposal_logits.float().clone(),
+            "target": target_logits.view(batch_size, depth + 1, vocab_size)[
+                :, :depth
+            ].clone(),
+            "u": proposal.tail_hidden.clone() @ manager._r_h_dev,
+        }
+
+        manager._launch_dflash_signals(
+            SimpleNamespace(
+                reqs=[SimpleNamespace(rid="r0"), SimpleNamespace(rid="r1")],
+                sampling_info=SimpleNamespace(is_all_greedy=True),
+            ),
+            target_logits,
+            proposal,
+        )
+        self.assertEqual(len(launched), 1)
+        request_ids, signal = launched[0]
+        self.assertEqual(request_ids, ("r0", "r1"))
+
+        # A following graph replay writes every source buffer in-place.  The
+        # single batched side-stream candidate must still see round one.
+        proposal.tail_hidden.fill_(-1)
+        proposal.raw_logits.fill_(-2)
+        proposal.proposal_logits.fill_(-3)
+        proposal.valid_mask.zero_()
+        target_logits.fill_(-4)
+        self.assertEqual(signal.source_rounds, (4, 4))
+        self.assertEqual(signal.source_versions, (0, 0))
+        torch.testing.assert_close(signal.tail_hidden, expected["hidden"])
+        torch.testing.assert_close(signal.u, expected["u"])
+        torch.testing.assert_close(signal.proposal_logits, expected["corrected"])
+        torch.testing.assert_close(signal.target_logits, expected["target"])
+        self.assertTrue(bool(signal.valid_mask.all()))
