+    def test_eagle_prefix_race_skips_poll_until_exact_copy_is_ready(self):
+        manager, event, rounds, polls = self._prefix_manager(ready=False)
+        batch = SimpleNamespace(reqs=[SimpleNamespace(rid="r0")])
+
+        self.assertFalse(manager._finalize_pending_rounds("r0"))
+        manager._poll_ready(batch, skip_rids=frozenset({"r0"}))
+        self.assertEqual(rounds, [])
+        self.assertEqual(polls, [])
+
+        event.value = True
+        self.assertTrue(manager._finalize_pending_rounds("r0"))
+        manager._poll_ready(batch)
+        self.assertEqual(rounds[0].prefix_len_after, 8192)
+        self.assertEqual(rounds[0].rng_substream_id, "greedy:None:3:512")
+        self.assertTrue(rounds[0].prefix_feature_exact)
+        # ArrivalContext is built after the exact prefix transition, so the
+        # controller sees 8192 - 512 rather than a stale/telemetry-only value.
+        self.assertEqual(polls, [(4, 7680)])
