+    def test_dspark_folded_and_eager_helpers_share_native_dtype_math(self):
+        """All DSpark graph/eager call sites consume these same primitives."""
+
+        torch.manual_seed(19)
+        hidden = torch.randn(2, 3, 5)
+        markov = torch.randn(2, 3, 4)
+        for mode in ("output_residual", "tail_lora", "full_rank_tail"):
+            with self.subTest(mode=mode):
+                manager = _dspark_manager(mode)
+                rows = manager.adapter_rows[:2]
+                if mode == "output_residual":
+                    projected, hidden_delta = manager._output_residual_hidden(
+                        rows, hidden
+                    )
+                    a_h = rows[:, manager._parameter_slices["a_h"]].view(
+                        2, 3, 128
+                    )
+                    expected_projected = (
+                        hidden.to(torch.bfloat16) @ manager._r_h_dev
+                    )
+                    expected_hidden = torch.matmul(
+                        torch.bmm(expected_projected, a_h.transpose(1, 2)),
+                        manager._basis_dev.T,
+                    )
+                    torch.testing.assert_close(
+                        projected, expected_projected, rtol=0, atol=0
+                    )
+                    torch.testing.assert_close(
+                        hidden_delta, expected_hidden, rtol=0, atol=0
+                    )
+
+                    markov_projected, markov_delta = (
+                        manager._output_residual_markov(rows, markov[:, 0])
+                    )
+                    a_m = rows[:, manager._parameter_slices["a_m"]].view(
+                        2, 3, 4
+                    )
+                    expected_markov = markov[:, 0].to(torch.bfloat16)
+                    expected_markov_delta = torch.matmul(
+                        torch.bmm(
+                            expected_markov.unsqueeze(1),
+                            a_m.transpose(1, 2),
+                        ).squeeze(1),
+                        manager._basis_dev.T,
+                    )
+                    torch.testing.assert_close(
+                        markov_projected, expected_markov, rtol=0, atol=0
+                    )
+                    torch.testing.assert_close(
+                        markov_delta, expected_markov_delta, rtol=0, atol=0
+                    )
+                elif mode == "tail_lora":
+                    a_h = rows[:, manager._parameter_slices["a_h"]].view(
+                        2, 5, 3
+                    )
+                    a_m = rows[:, manager._parameter_slices["a_m"]].view(
+                        2, 4, 3
+                    )
+                    b_h = rows[:, manager._parameter_slices["b_h"]].view(
+                        2, 3, 5
+                    )
+                    expected_hidden = torch.bmm(
+                        torch.bmm(hidden.to(torch.bfloat16), a_h), b_h
+                    )
+                    expected_markov_delta = torch.bmm(
+                        torch.bmm(markov.to(torch.bfloat16), a_m), b_h
+                    )
+                    torch.testing.assert_close(
+                        manager._tail_delta_hidden(rows, hidden=hidden),
+                        expected_hidden,
+                        rtol=0,
+                        atol=0,
+                    )
+                    torch.testing.assert_close(
+                        manager._tail_delta_hidden(rows, markov=markov),
+                        expected_markov_delta,
+                        rtol=0,
+                        atol=0,
+                    )
+                else:
+                    d_h = rows[:, manager._parameter_slices["d_h"]].view(
+                        2, 5, 5
+                    )
+                    d_m = rows[:, manager._parameter_slices["d_m"]].view(
+                        2, 4, 5
+                    )
+                    torch.testing.assert_close(
+                        manager._tail_delta_hidden(rows, hidden=hidden),
+                        torch.bmm(hidden.to(torch.bfloat16), d_h),
+                        rtol=0,
+                        atol=0,
+                    )
+                    torch.testing.assert_close(
+                        manager._tail_delta_hidden(rows, markov=markov),
+                        torch.bmm(markov.to(torch.bfloat16), d_m),
+                        rtol=0,
+                        atol=0,
+                    )
+
+                confidence = manager._confidence_features(hidden, markov)
+                if mode == "output_residual":
+                    expected_hidden_features = (
+                        hidden.to(torch.bfloat16) @ manager._r_h_dev
+                    )
+                    native_markov = markov.to(torch.bfloat16)
+                    expected_markov_features = native_markov * torch.rsqrt(
+                        native_markov.pow(2).mean(dim=-1, keepdim=True) + 1e-6
