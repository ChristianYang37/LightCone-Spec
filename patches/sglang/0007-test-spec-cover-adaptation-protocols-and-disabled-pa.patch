+    def _prefix_manager(self, *, ready):
+        manager = object.__new__(LightConeTailAdaptationManager)
+        manager._disabled = set()
+        manager._pending_round_commits = {}
+        manager._round_of = {"r0": 4}
+        manager.shapes = SimpleNamespace(draft_depth=3)
+        manager.config = SimpleNamespace(
+            runtime=SimpleNamespace(concurrency=1)
+        )
+        manager._H = SimpleNamespace(
+            RoundCommitted=lambda **kwargs: SimpleNamespace(**kwargs),
+            UpdatePollPoint=lambda **kwargs: SimpleNamespace(**kwargs),
+            rng_substream_identity=lambda **kwargs: (
+                f"{'greedy' if kwargs['is_greedy'] else 'sample'}:"
+                f"{kwargs['sampling_seed']}:{kwargs['round_id']}:"
+                f"{kwargs['prefix_len']}"
+            ),
+        )
+        ctx = SimpleNamespace(
+            prefix_len=512,
+            request_epoch=7,
+            slot_index=0,
+        )
+        rounds = []
+        polls = []
+
+        def on_round_committed(event):
+            rounds.append(event)
+            ctx.prefix_len = event.prefix_len_after
+
+        def on_update_poll(event):
+            polls.append((event.round_id, ctx.prefix_len - 512))
+
+        manager.runtime = SimpleNamespace(
+            requests={"r0": ctx},
+            bank=SimpleNamespace(
+                slots=[SimpleNamespace(active_version=2)]
+            ),
+            on_round_committed=on_round_committed,
+            on_update_poll=on_update_poll,
+        )
+        manager._guard = lambda _rid, fn: fn()
+
+        class Event:
+            def __init__(self, value):
+                self.value = value
+
+            def query(self):
+                return self.value
+
+            def synchronize(self):
+                raise AssertionError("prefix boundary must never synchronize")
+
+        event = Event(ready)
+        manager._pending_round_commits["r0"] = [
+            {
+                "round_id": 3,
+                "version": 2,
+                "request_index": 0,
+                "new_seq_lens_cpu": torch.tensor([8192]),
+                "commit_lens_cpu": torch.tensor([4]),
+                "ready": event,
+                "timing": {"telemetry_ready": event},
+                "draft_cpu_us": 2.0,
+                "verify_cpu_us": 3.0,
+                "verify_len": 4,
+                "batch_size": 1,
+                "round_wall_us": 5.0,
+            }
+        ]
+        return manager, event, rounds, polls
