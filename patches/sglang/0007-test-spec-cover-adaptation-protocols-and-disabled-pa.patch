+"""CPU math contracts for the shared DFlash/EAGLE tail manager.
+
+The runtime/model construction path is covered by integration tests.  These
+tests isolate the graph-visible tail math so all three parameter layouts and a
+chunk crossing request boundaries can be checked without loading a model.
+"""
+
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.speculative.tail_adaptation import (
+    LightConeTailAdaptationManager,
+    tp_gradient_consensus,
+    validate_proposal_depth,
+)
