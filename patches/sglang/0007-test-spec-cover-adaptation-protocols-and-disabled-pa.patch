+class TestDFlashTailCudaGraph(CustomTestCase):
+    def test_fixed_address_tail_publish_changes_replay_without_recapture(self):
+        from sglang.srt.speculative.dflash_worker_v2 import _DflashDraftSampler
+
+        class FixedTail:
+            def __init__(self):
+                self.delta = torch.zeros((1, 3), device="cuda")
+
+            def correct_draft_logits(self, **kwargs):
+                return kwargs["raw_logits"] + self.delta
+
+        tail = FixedTail()
+        sampler = _DflashDraftSampler(
+            weight=torch.eye(3, device="cuda"),
+            block_size=2,
+            num_org=3,
+            org_vocab_start=0,
+            max_bs=1,
+            tail_adaptation=tail,
+        )
+        hidden = torch.tensor(
+            [[0.0, 0.0, 0.0], [2.0, 0.0, 0.0]], device="cuda"
+        )
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                sampler(hidden)
+        torch.cuda.current_stream().wait_stream(stream)
+
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            sampler(hidden)
+        raw_ptr = sampler.raw_logits.data_ptr()
+        proposal_ptr = sampler.proposal_logits.data_ptr()
+
+        graph.replay()
+        self.assertEqual(int(sampler.out[0]), 0)
+        replay = sampler.replay_signals(
+            graph_batch_size=1, actual_batch_size=1
+        )
+        self.assertIsNotNone(replay)
+        self.assertEqual(replay.raw_logits.data_ptr(), raw_ptr)
+        self.assertEqual(replay.proposal_logits.data_ptr(), proposal_ptr)
+        tail.delta[:, 2].fill_(100.0)
+        graph.replay()
+        self.assertEqual(int(sampler.out[0]), 2)
+        torch.testing.assert_close(
+            replay.proposal_logits,
+            replay.raw_logits + torch.tensor([[0.0, 0.0, 100.0]], device="cuda"),
+        )
+        self.assertEqual(sampler.raw_logits.data_ptr(), raw_ptr)
+        self.assertEqual(sampler.proposal_logits.data_ptr(), proposal_ptr)
