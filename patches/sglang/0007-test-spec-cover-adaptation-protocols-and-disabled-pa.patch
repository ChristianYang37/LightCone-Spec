@@ -0,0 +1,115 @@
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from prometheus_client import Counter
+
+from sglang.srt.observability.cpu_monitor import (
+    start_cpu_monitor_thread,
+    stop_cpu_monitor_thread,
+)
+from sglang.srt.observability.metrics_collector import TokenizerMetricsCollector
+from sglang.srt.utils.watchdog import SubprocessWatchdog
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class TestMetricsLifecycle(unittest.TestCase):
+    def test_watchdog_exposes_only_owned_processes(self):
+        owned = object()
+        watchdog = SubprocessWatchdog([owned])
+        self.assertEqual(watchdog.processes, (owned,))
+
+    def test_engine_shutdown_closes_owned_process_once(self):
+        from sglang.srt.entrypoints.engine import Engine
+
+        class Process:
+            pid = 42
+
+            def __init__(self):
+                self.joins = 0
+                self.closes = 0
+
+            def join(self, timeout):
+                self.joins += 1
+
+            def is_alive(self):
+                return False
+
+            def close(self):
+                self.closes += 1
+
+        process = Process()
+        watchdog = SimpleNamespace(
+            processes=(process,), stop=lambda: None
+        )
+        engine = object.__new__(Engine)
+        engine.tokenizer_manager = SimpleNamespace(
+            _subprocess_watchdog=watchdog,
+            metrics_collector=None,
+            cpu_monitor_thread=None,
+        )
+        engine.send_to_rpc = None
+        engine._weight_cache_daemon_procs = []
+        with patch("sglang.srt.entrypoints.engine.kill_process_tree") as kill:
+            engine.shutdown()
+            engine.shutdown()
+        kill.assert_called_once_with(42, include_parent=True, wait_timeout=60)
+        self.assertEqual(process.joins, 1)
+        self.assertEqual(process.closes, 1)
+
+    def test_prometheus_directory_can_rotate_in_one_process(self):
+        script = """
+from pathlib import Path
+from prometheus_client import Counter
+from sglang.srt.utils.common import set_prometheus_multiproc_dir
+
+set_prometheus_multiproc_dir()
+first = os.environ["PROMETHEUS_MULTIPROC_DIR"]
+Counter("sglang_test_rotation_first_total", "first").inc()
+set_prometheus_multiproc_dir()
+second = os.environ["PROMETHEUS_MULTIPROC_DIR"]
+Counter("sglang_test_rotation_second_total", "second").inc()
+assert first != second
+assert not Path(first).exists()
+assert Path(second).is_dir()
+"""
+        with tempfile.TemporaryDirectory() as root:
+            env = dict(os.environ)
+            env["PROMETHEUS_MULTIPROC_DIR"] = root
+            subprocess.run(
+                [sys.executable, "-c", "import os\n" + script],
+                check=True,
+                env=env,
+            )
+
+    def test_tokenizer_collector_close_is_idempotent(self):
+        name = "sglang_test_tokenizer_lifecycle_total"
+        collector = object.__new__(TokenizerMetricsCollector)
+        collector.metric = Counter(name, "lifecycle test")
+
+        collector.close()
+        collector.close()
+        replacement = Counter(name, "lifecycle test")
+        replacement_collector = object.__new__(TokenizerMetricsCollector)
+        replacement_collector.metric = replacement
+        replacement_collector.close()
+
+    def test_cpu_monitor_is_reused_per_component(self):
+        first = start_cpu_monitor_thread("lifecycle-test", interval=3600)
+        second = start_cpu_monitor_thread("lifecycle-test", interval=3600)
+        self.assertIs(first, second)
+        stop_cpu_monitor_thread(first)
+
+        replacement = start_cpu_monitor_thread("lifecycle-test", interval=3600)
+        self.assertIsNot(first, replacement)
+        stop_cpu_monitor_thread(replacement)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/test/registered/unit/spec/test_dflash_tail_adaptation.py b/test/registered/unit/spec/test_dflash_tail_adaptation.py
