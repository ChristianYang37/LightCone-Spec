+    def test_tp_gradient_consensus_discards_when_any_rank_is_nonfinite(self):
+        call_index = 0
+
+        def all_reduce(value):
+            nonlocal call_index
+            call_index += 1
+            if call_index == 1:
+                return torch.ones_like(value)  # only one of two ranks is finite
+            return value * 2
+
+        with patch(
+            "sglang.srt.distributed.communication_op."
+            "tensor_model_parallel_all_reduce",
+            side_effect=all_reduce,
+        ):
+            grad, ok = tp_gradient_consensus(
+                torch.tensor([2.0, -3.0]),
+                torch.tensor(True),
+                tp_size=2,
+            )
+
+        torch.testing.assert_close(grad, torch.zeros(2))
+        self.assertFalse(bool(ok))
