+"""DSpark adaptation tensors and loss functions."""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import torch
+import torch.nn.functional as F
+
+
+def _require_float_tensor(value: object, *, name: str, ndim: int) -> torch.Tensor:
+    if not isinstance(value, torch.Tensor):
+        raise TypeError(f"{name} must be a tensor")
+    if value.ndim != ndim or not value.is_floating_point():
+        raise ValueError(f"{name} must be a rank-{ndim} floating tensor")
+    if not bool(torch.isfinite(value).all()):
+        raise ValueError(f"{name} must be finite")
+    return value
+
+
+def _require_token_tensor(value: object, *, name: str, shape: tuple[int, ...]) -> None:
+    if not isinstance(value, torch.Tensor):
+        raise TypeError(f"{name} must be a tensor")
+    if value.shape != shape or value.dtype not in {torch.int32, torch.int64}:
+        raise ValueError(f"{name} has the wrong token layout")
+
+
+@dataclass(frozen=True)
+class DSparkAdapterFreeEvidence:
+    """Inference evidence with the online backbone delta represented once.
+
+    ``adapter_free_logits`` never include an online delta.  The source model's
+    deployed backbone is exactly ``adapter_free_logits + source_delta_logits``.
+    Candidate reconstruction replaces that delta; it never adds a candidate to
+    already-adapted deployed logits.
+    """
+
+    adapter_free_logits: torch.Tensor
+    source_delta_logits: torch.Tensor
+    source_corrected_logits: torch.Tensor
+    source_sampling_probabilities: torch.Tensor
+    teacher_probabilities: torch.Tensor
+    backbone_features: torch.Tensor
+    anchor_token_ids: torch.Tensor
+    sampled_token_ids: torch.Tensor
+    predecessor_embeddings: torch.Tensor
+    confidence: torch.Tensor | None
+    temperatures: torch.Tensor
+    greedy_mask: torch.Tensor
+    valid_mask: torch.Tensor
+    request_ids: tuple[str, ...]
+    source_adapter_version: int
+
+    @classmethod
+    def capture(
+        cls,
+        *,
+        adapter_free_logits: torch.Tensor,
+        source_delta_logits: torch.Tensor,
+        source_corrected_logits: torch.Tensor,
+        source_sampling_probabilities: torch.Tensor,
+        teacher_probabilities: torch.Tensor,
+        backbone_features: torch.Tensor,
+        anchor_token_ids: torch.Tensor,
+        sampled_token_ids: torch.Tensor,
+        predecessor_embeddings: torch.Tensor,
+        source_markov_w1: torch.Tensor,
+        confidence: torch.Tensor | None,
+        temperatures: torch.Tensor,
+        greedy_mask: torch.Tensor,
+        valid_mask: torch.Tensor,
+        request_ids: tuple[str, ...],
+        source_adapter_version: int,
+    ) -> DSparkAdapterFreeEvidence:
+        base = _require_float_tensor(
+            adapter_free_logits, name="adapter_free_logits", ndim=3
+        )
+        for name, value in (
+            ("source_delta_logits", source_delta_logits),
+            ("source_corrected_logits", source_corrected_logits),
+        ):
+            tensor = _require_float_tensor(value, name=name, ndim=3)
+            if tensor.shape != base.shape or tensor.device != base.device:
+                raise ValueError(f"{name} does not match adapter-free logits")
+        batch, rows, _ = base.shape
+        _require_token_tensor(anchor_token_ids, name="anchor_token_ids", shape=(batch,))
+        _require_token_tensor(
+            sampled_token_ids,
+            name="sampled_token_ids",
+            shape=(batch, rows),
+        )
+        features = _require_float_tensor(
+            backbone_features, name="backbone_features", ndim=3
+        )
+        predecessor = _require_float_tensor(
+            predecessor_embeddings, name="predecessor_embeddings", ndim=3
+        )
+        source_w1 = _require_float_tensor(
+            source_markov_w1, name="source_markov_w1", ndim=2
+        )
+        if (
+            features.shape[:2] != (batch, rows)
+            or predecessor.shape[:2] != (batch, rows)
+            or features.shape[-1] < 1
+            or predecessor.shape[-1] < 1
+            or features.device != base.device
+            or predecessor.device != base.device
+            or source_w1.device != base.device
+            or source_w1.shape[1] != predecessor.shape[2]
+        ):
+            raise ValueError("backend features do not cover every proposal row")
+        predecessor_ids = torch.cat(
+            (anchor_token_ids[:, None], sampled_token_ids[:, :-1]), dim=1
+        )
+        if predecessor_ids.numel() and (
+            bool((predecessor_ids < 0).any())
+            or bool((predecessor_ids >= source_w1.shape[0]).any())
+        ):
+            raise ValueError("source predecessor lies outside the Markov vocabulary")
+        if not torch.allclose(
+            predecessor,
+            F.embedding(predecessor_ids, source_w1),
+            atol=0.0,
+            rtol=0.0,
+        ):
+            raise ValueError("source predecessor embedding is not the actual W1 row")
+        if confidence is not None:
+            confidence_tensor = _require_float_tensor(
+                confidence, name="confidence", ndim=2
+            )
+            if (
+                confidence_tensor.shape != (batch, rows)
+                or confidence_tensor.device != base.device
+                or bool((confidence_tensor < 0).any())
+                or bool((confidence_tensor > 1).any())
+            ):
+                raise ValueError("confidence must be a probability per proposal row")
+        if (
+            not isinstance(temperatures, torch.Tensor)
+            or temperatures.shape != (batch,)
+            or not temperatures.is_floating_point()
+            or temperatures.device != base.device
+            or not bool(torch.isfinite(temperatures).all())
+            or not bool((temperatures > 0).all())
+            or temperatures.requires_grad
+        ):
+            raise ValueError(
+                "temperatures must be positive finite frozen values per request"
+            )
+        if (
+            not isinstance(greedy_mask, torch.Tensor)
+            or greedy_mask.shape != (batch,)
+            or greedy_mask.dtype != torch.bool
+            or greedy_mask.device != base.device
+        ):
+            raise ValueError("greedy_mask must identify every request")
+        if (
+            not isinstance(valid_mask, torch.Tensor)
+            or valid_mask.shape != (batch, rows)
+            or valid_mask.dtype != torch.bool
+            or valid_mask.device != base.device
+        ):
+            raise ValueError("valid_mask must cover every proposal row")
+        proposal = _require_probability_rows(
+            source_sampling_probabilities,
+            name="source_sampling_probabilities",
+            shape=base.shape,
+            device=base.device,
+        )
+        teacher = _require_probability_rows(
+            teacher_probabilities,
+            name="teacher_probabilities",
+            shape=base.shape,
+            device=base.device,
+        )
+        expected_proposal = proposal_probabilities(
+            source_corrected_logits,
+            temperatures,
+            greedy_mask=greedy_mask,
+        )
+        if not torch.allclose(proposal, expected_proposal, atol=1e-6, rtol=1e-5):
+            raise ValueError(
+                "source sampling probabilities are not the deployed proposal"
+            )
+        if (
+            len(request_ids) != batch
+            or not all(isinstance(item, str) and item for item in request_ids)
+            or len(set(request_ids)) != batch
+        ):
+            raise ValueError("request IDs must be a unique non-empty batch identity")
+        if (
+            not isinstance(source_adapter_version, int)
+            or isinstance(source_adapter_version, bool)
+            or source_adapter_version < 0
+        ):
+            raise ValueError("source adapter version must be non-negative")
+        return cls(
+            base,
+            source_delta_logits,
+            source_corrected_logits,
+            proposal,
+            teacher,
+            features,
+            anchor_token_ids,
+            sampled_token_ids,
+            predecessor,
+            confidence,
+            temperatures,
+            greedy_mask,
+            valid_mask,
+            request_ids,
+            source_adapter_version,
+        )
+
+    @property
+    def predecessor_token_ids(self) -> torch.Tensor:
+        return torch.cat(
+            (self.anchor_token_ids[:, None], self.sampled_token_ids[:, :-1]), dim=1
+        )
+
+
+def reconstruct_dspark_logits(
+    evidence: DSparkAdapterFreeEvidence,
+    *,
+    candidate_backbone_delta_logits: torch.Tensor,
+    markov_w1: torch.Tensor,
+    markov_w2: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Reconstruct q with actual sampled predecessors and one backbone delta."""
+
+    delta = _require_float_tensor(
+        candidate_backbone_delta_logits,
+        name="candidate_backbone_delta_logits",
+        ndim=3,
+    )
+    if delta.shape != evidence.adapter_free_logits.shape:
+        raise ValueError("candidate backbone delta has the wrong layout")
+    w1 = _require_float_tensor(markov_w1, name="markov_w1", ndim=2)
+    w2 = _require_float_tensor(markov_w2, name="markov_w2", ndim=2)
+    if w1.shape != w2.shape:
+        raise ValueError("DSpark W1 embedding and W2 projection layouts disagree")
+    predecessor = evidence.predecessor_token_ids
+    if predecessor.numel() and (
+        bool((predecessor < 0).any()) or bool((predecessor >= w1.shape[0]).any())
+    ):
+        raise ValueError("sampled predecessor lies outside the Markov vocabulary")
+    predecessor_embeddings = F.embedding(predecessor, w1)
+    markov_bias = F.linear(predecessor_embeddings, w2)
+    reconstructed = evidence.adapter_free_logits + delta + markov_bias
+    return reconstructed, predecessor_embeddings
+
+
+def proposal_probabilities(
+    corrected_logits: torch.Tensor,
+    temperatures: torch.Tensor,
+    *,
+    greedy_mask: torch.Tensor | None = None,
+) -> torch.Tensor:
+    logits = _require_float_tensor(corrected_logits, name="corrected_logits", ndim=3)
+    if temperatures.shape != (logits.shape[0],):
+        raise ValueError("proposal temperatures do not cover the batch")
+    if (
+        not temperatures.is_floating_point()
+        or temperatures.device != logits.device
+        or not bool(torch.isfinite(temperatures).all())
+        or not bool((temperatures > 0).all())
+        or temperatures.requires_grad
+    ):
+        raise ValueError(
+            "proposal temperatures must be positive, finite, frozen, and colocated"
+        )
+    probabilities = torch.softmax(
+        logits.to(torch.float32) / temperatures[:, None, None], dim=-1
+    )
+    if greedy_mask is None:
+        return probabilities
+    if (
+        greedy_mask.shape != (logits.shape[0],)
+        or greedy_mask.dtype != torch.bool
+        or greedy_mask.device != logits.device
+    ):
+        raise ValueError("proposal greedy mask does not cover the batch")
+    greedy = F.one_hot(logits.argmax(-1), num_classes=logits.shape[-1]).to(
+        probabilities.dtype
+    )
+    return torch.where(greedy_mask[:, None, None], greedy, probabilities)
+
+
+def _require_probability_rows(
+    value: object,
+    *,
+    name: str,
+    shape: tuple[int, ...],
+    device: torch.device,
+) -> torch.Tensor:
+    probabilities = _require_float_tensor(value, name=name, ndim=3)
+    if probabilities.shape != shape or probabilities.device != device:
+        raise ValueError(f"{name} does not cover the evidence rows")
+    if bool((probabilities < 0).any()) or not torch.allclose(
+        probabilities.sum(-1),
+        torch.ones_like(probabilities[..., 0]),
+        atol=1e-5,
+        rtol=1e-5,
+    ):
+        raise ValueError(f"{name} rows must be probability distributions")
+    return probabilities
+
+
+def reconstruct_confidence_logits(
+    *,
+    draft_hidden: torch.Tensor,
+    predecessor_embeddings: torch.Tensor,
+    confidence_weight: torch.Tensor,
+    confidence_bias: torch.Tensor | None,
+) -> torch.Tensor:
+    hidden = _require_float_tensor(draft_hidden, name="draft_hidden", ndim=3)
+    embeddings = _require_float_tensor(
+        predecessor_embeddings, name="predecessor_embeddings", ndim=3
+    )
+    if hidden.shape[:2] != embeddings.shape[:2]:
+        raise ValueError("confidence hidden and predecessor rows disagree")
+    weight = _require_float_tensor(
+        confidence_weight, name="confidence_weight", ndim=2
+    )
+    if weight.shape != (1, hidden.shape[-1] + embeddings.shape[-1]):
+        raise ValueError("confidence projection must consume hidden plus Markov W1")
+    if confidence_bias is not None:
+        bias = _require_float_tensor(confidence_bias, name="confidence_bias", ndim=1)
+        if bias.shape != (1,):
+            raise ValueError("confidence bias must be scalar-output")
+    else:
+        bias = None
+    features = torch.cat((hidden, embeddings.to(hidden.dtype)), dim=-1)
+    return F.linear(features, weight.to(features.dtype), bias).squeeze(-1)
+
+
+def conditional_survival_target(
+    *, target_probabilities: torch.Tensor, proposal_probabilities_: torch.Tensor
+) -> torch.Tensor:
+    target = _require_float_tensor(
+        target_probabilities, name="target_probabilities", ndim=3
+    )
+    proposal = _require_float_tensor(
+        proposal_probabilities_, name="proposal_probabilities", ndim=3
+    )
+    if target.shape != proposal.shape:
+        raise ValueError("target and proposal distributions disagree")
+    for name, value in (("target", target), ("proposal", proposal)):
+        if bool((value < 0).any()) or not torch.allclose(
+            value.sum(-1), torch.ones_like(value[..., 0]), atol=1e-5, rtol=1e-5
+        ):
+            raise ValueError(f"{name} rows must be probability distributions")
+    total_variation = 0.5 * (target - proposal).abs().sum(-1)
+    return (1.0 - total_variation).clamp(0.0, 1.0).detach()
+
+
+@dataclass(frozen=True)
+class DSparkCompositeLoss:
+    total: torch.Tensor
+    proposal: torch.Tensor
+    confidence: torch.Tensor | None
+    conditional_survival: torch.Tensor | None
+
+
+def dspark_composite_loss(
+    *,
+    target_probabilities: torch.Tensor,
+    corrected_proposal_logits: torch.Tensor,
+    temperatures: torch.Tensor,
+    valid_mask: torch.Tensor,
+    position_decay: float,
+    confidence_logits: torch.Tensor | None = None,
+    frozen_confidence_temperature: torch.Tensor | None = None,
+    confidence_loss_weight: float | None = None,
+    exact_proposal_probabilities: torch.Tensor | None = None,
+) -> DSparkCompositeLoss:
+    proposal_logits = _require_float_tensor(
+        corrected_proposal_logits, name="corrected_proposal_logits", ndim=3
+    )
+    target = _require_probability_rows(
+        target_probabilities,
+        name="target_probabilities",
+        shape=tuple(proposal_logits.shape),
+        device=proposal_logits.device,
+    )
+    if (
+        valid_mask.shape != target.shape[:2]
+        or valid_mask.dtype != torch.bool
+        or valid_mask.device != target.device
+    ):
+        raise ValueError("valid mask does not cover teacher rows")
+    if not isinstance(position_decay, (int, float)) or isinstance(position_decay, bool):
+        raise TypeError("position_decay must be numeric")
+    if not math.isfinite(position_decay) or not 0 < position_decay <= 1:
+        raise ValueError("position_decay must be in (0, 1]")
+    weights = float(position_decay) ** torch.arange(
+        target.shape[1], device=target.device, dtype=torch.float32
+    )
+    weights = weights[None, :] * valid_mask.to(torch.float32)
+    normalizer = weights.sum().clamp_min(1.0)
+    proposal_row_loss = F.kl_div(
+        torch.log_softmax(
+            proposal_logits.to(torch.float32) / temperatures[:, None, None],
+            dim=-1,
+        ),
+        target.to(torch.float32),
+        reduction="none",
+    ).sum(-1)
+    proposal_loss = (proposal_row_loss * weights).sum() / normalizer
+    if confidence_loss_weight is None:
+        if (
+            confidence_logits is not None
+            or frozen_confidence_temperature is not None
+            or exact_proposal_probabilities is not None
+        ):
+            raise ValueError("layer-only DSpark must not train confidence state")
+        return DSparkCompositeLoss(proposal_loss, proposal_loss, None, None)
+    if (
+        not isinstance(confidence_loss_weight, (int, float))
+        or isinstance(confidence_loss_weight, bool)
+        or not math.isfinite(confidence_loss_weight)
+        or confidence_loss_weight < 0
+    ):
+        raise ValueError("confidence loss weight must be finite and non-negative")
+    if (
+        confidence_logits is None
+        or frozen_confidence_temperature is None
+        or exact_proposal_probabilities is None
+    ):
+        raise ValueError(
+            "hybrid DSpark requires confidence logits, temperature, and exact proposal"
+        )
+    confidence = _require_float_tensor(
+        confidence_logits, name="confidence_logits", ndim=2
+    )
+    temperature = _require_float_tensor(
+        frozen_confidence_temperature,
+        name="frozen_confidence_temperature",
+        ndim=1,
+    )
+    if confidence.shape != target.shape[:2] or temperature.shape != (target.shape[1],):
+        raise ValueError("confidence rows or frozen temperatures are incomplete")
+    if not bool((temperature > 0).all()) or temperature.requires_grad:
+        raise ValueError("confidence temperatures must be positive and frozen")
+    exact_proposal = _require_probability_rows(
+        exact_proposal_probabilities,
+        name="exact_proposal_probabilities",
+        shape=tuple(target.shape),
+        device=target.device,
+    )
+    survival = conditional_survival_target(
+        target_probabilities=target,
+        proposal_probabilities_=exact_proposal,
+    )
+    confidence_rows = F.binary_cross_entropy_with_logits(
+        confidence.to(torch.float32) / temperature[None, :],
+        survival,
+        reduction="none",
+    )
+    confidence_loss = (confidence_rows * weights).sum() / normalizer
+    total = proposal_loss + float(confidence_loss_weight) * confidence_loss
+    return DSparkCompositeLoss(total, proposal_loss, confidence_loss, survival)
+
+
+@dataclass(frozen=True)
+class DSparkVerificationDecision:
+    mode: str
+    total_token_budget: int | None
+    additional_token_budget: int | None
+    native_scheduler_authoritative: bool
+    global_verify_all_override: bool = False
+
+
+def resolve_dspark_verification(
+    *,
+    mode: str,
+    batch_size: int,
+    verify_width: int,
+    fixed_total_token_budget: int | None,
+    native_total_token_budget: int | None,
+) -> DSparkVerificationDecision:
+    if (
+        not isinstance(batch_size, int)
+        or isinstance(batch_size, bool)
+        or batch_size < 1
+        or not isinstance(verify_width, int)
+        or isinstance(verify_width, bool)
+        or verify_width < 1
+    ):
+        raise ValueError("verification dimensions must be positive integers")
+    maximum = batch_size * verify_width
+    if mode == "fixed_budget":
+        if native_total_token_budget is not None:
+            raise ValueError("fixed verification cannot consume a native decision")
+        if (
+            not isinstance(fixed_total_token_budget, int)
+            or isinstance(fixed_total_token_budget, bool)
+            or not batch_size <= fixed_total_token_budget <= maximum
+        ):
+            raise ValueError("fixed verification budget lies outside the exact batch")
+        return DSparkVerificationDecision(
+            mode,
+            fixed_total_token_budget,
+            fixed_total_token_budget - batch_size,
+            False,
+        )
+    if mode != "native_scheduler":
+        raise ValueError("unknown DSpark verification mode")
+    if fixed_total_token_budget is not None:
+        raise ValueError("native verification cannot consume a fixed decision")
+    if native_total_token_budget is not None and (
+        not isinstance(native_total_token_budget, int)
+        or isinstance(native_total_token_budget, bool)
+        or not batch_size <= native_total_token_budget <= maximum
+    ):
+        raise ValueError("native verification decision lies outside the exact batch")
+    return DSparkVerificationDecision(
+        mode,
+        native_total_token_budget,
+        (
+            None
+            if native_total_token_budget is None
+            else native_total_token_budget - batch_size
+        ),
+        True,
+    )
+
+
+__all__ = (
+    "DSparkAdapterFreeEvidence",
+    "DSparkCompositeLoss",
+    "DSparkVerificationDecision",
+    "conditional_survival_target",
+    "dspark_composite_loss",
+    "proposal_probabilities",
+    "reconstruct_confidence_logits",
+    "reconstruct_dspark_logits",
+    "resolve_dspark_verification",
+)
