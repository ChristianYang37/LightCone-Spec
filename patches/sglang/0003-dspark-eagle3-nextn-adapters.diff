@@ -0,0 +1,387 @@
+"""Online updates shared by DSpark, EAGLE3, and NEXTN workers."""
+
+from __future__ import annotations
+
+import logging
+import math
+from collections.abc import Sequence
+
+import torch
+from sglang.srt.speculative.online_adaptation_config import (
+    OnlineAdaptationConfig,
+    load_online_adaptation,
+)
+from sglang.srt.speculative.online_adaptation_runtime import (
+    FixedInferenceBank,
+    OnlineCohortRuntime,
+    OnlineSpecOptimizer,
+    adaptation_layout,
+    build_parameter_optimizer,
+    estimate_full_vocab_training_scratch_bytes,
+    estimate_functional_optimizer_scratch_bytes,
+    reconfigure_parameter_optimizer,
+)
+from sglang.srt.speculative.online_parameter_plan import (
+    ParameterSelection,
+    build_native_parameter_plan,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def _bytes(tensors: Sequence[torch.Tensor]) -> int:
+    return sum(value.numel() * value.element_size() for value in tensors)
+
+
+class _LowRankDelta(torch.nn.Module):
+    """Fixed-address LoRA factors over one frozen backend matrix."""
+
+    def __init__(self, weight: torch.Tensor, *, rank: int, seed: int) -> None:
+        super().__init__()
+        if weight.ndim != 2 or rank > min(weight.shape):
+            raise ValueError("native LoRA rank exceeds its backend matrix")
+        generator = torch.Generator(device=weight.device)
+        generator.manual_seed(seed)
+        self.a = torch.nn.Parameter(
+            torch.empty(
+                rank,
+                weight.shape[1],
+                device=weight.device,
+                dtype=torch.float32,
+            )
+        )
+        self.b = torch.nn.Parameter(
+            torch.zeros(
+                weight.shape[0],
+                rank,
+                device=weight.device,
+                dtype=torch.float32,
+            )
+        )
+        torch.nn.init.kaiming_uniform_(self.a, a=math.sqrt(5), generator=generator)
+
+    def forward(self, original: torch.Tensor) -> torch.Tensor:
+        return original + (self.b @ self.a).to(original.dtype)
+
+
+def _canonical_named_parameters(model) -> tuple[tuple[str, str, torch.Tensor], ...]:
+    rows = []
+    seen = set()
+    for raw_name, parameter in model.named_parameters():
+        name = raw_name.removeprefix("model.")
+        if name in seen:
+            raise RuntimeError(f"duplicate native backend parameter: {name}")
+        seen.add(name)
+        rows.append((name, raw_name, parameter))
+    return tuple(sorted(rows))
+
+
+class NativeBackendOnlineAdapter:
+    """One real model graph feeding the shared transactional update runtime."""
+
+    def __init__(self, server_args, worker, *, algorithm: str, model) -> None:
+        config = load_online_adaptation(server_args)
+        if config is None or config.algorithm != algorithm:
+            raise ValueError(f"{algorithm} live adapter requires its exact config")
+        if algorithm not in {"DSPARK", "EAGLE3", "NEXTN"}:
+            raise ValueError("native live adapter backend is unsupported")
+        self.config: OnlineAdaptationConfig = config
+        self.worker = worker
+        self.model = model
+        self.device = torch.device(worker.device)
+        rows = _canonical_named_parameters(model)
+        self.plan: ParameterSelection = build_native_parameter_plan(
+            ((raw_name, parameter) for _, raw_name, parameter in rows),
+            config,
+        )
+        self.live_launch_count = 0
+        self.last_source_tensor_shapes: tuple[tuple[int, ...], ...] = ()
+        self.last_feedback_source_version: int | None = None
+        by_name = {name: (raw_name, parameter) for name, raw_name, parameter in rows}
+        self._parametrizations: list[_LowRankDelta] = []
+        trainable_names: list[str] = []
+        trainable: list[torch.Tensor] = []
+        if config.weight_update_mode == "full":
+            for name in self.plan.full_names:
+                parameter = by_name[name][1]
+                parameter.requires_grad_(True)
+                trainable_names.append(name)
+                trainable.append(parameter)
+        else:
+            if config.rank is None:
+                raise AssertionError("validated native LoRA config has no rank")
+            for index, name in enumerate(self.plan.lora_names):
+                raw_name, parameter = by_name[name]
+                parent_name, _, leaf = raw_name.rpartition(".")
+                if leaf != "weight":
+                    raise ValueError("native LoRA selector named a non-weight tensor")
+                module = model.get_submodule(parent_name) if parent_name else model
+                parameter.requires_grad_(False)
+                parametrization = _LowRankDelta(
+                    parameter,
+                    rank=config.rank,
+                    seed=config.seed + index,
+                )
+                torch.nn.utils.parametrize.register_parametrization(
+                    module,
+                    leaf,
+                    parametrization,
+                    unsafe=True,
+                )
+                self._parametrizations.append(parametrization)
+                trainable_names.extend((f"{name}.lora_a", f"{name}.lora_b"))
+                trainable.extend((parametrization.a, parametrization.b))
+            for name in self.plan.full_names:
+                parameter = by_name[name][1]
+                parameter.requires_grad_(True)
+                trainable_names.append(name)
+                trainable.append(parameter)
+        if not trainable:
+            raise RuntimeError("native backend trainable layout is empty")
+        self.names = tuple(trainable_names)
+        self.trainable = tuple(trainable)
+        self.initial = tuple(value.detach().clone() for value in self.trainable)
+        self.optimizer = build_parameter_optimizer(
+            self.trainable,
+            config,
+            projection_origin=self.initial,
+        )
+        self.inference = FixedInferenceBank(self.trainable)
+        context_capacity = int(
+            server_args.context_length
+            or getattr(model.config, "max_position_embeddings", config.canvas_tokens)
+        )
+        max_batch = max(1, int(server_args.max_running_requests))
+        training_batch = min(max_batch, config.adaptation_microbatch_size)
+        self.runtime = OnlineCohortRuntime(
+            config,
+            device=self.device,
+            reserve_bytes=int(server_args.speculative_adaptation_reserve_mb)
+            * 1024
+            * 1024,
+            telemetry_path=server_args.speculative_adaptation_telemetry_path,
+            max_trace_updates=context_capacity // config.stride + 2,
+            max_trace_batch=max_batch,
+        )
+        self.runtime.bind_parameter_layout(
+            tuple(zip(self.names, self.optimizer.master, strict=True)),
+            projection_identity=f"{algorithm.lower()}:{config.parameter_scope}:{config.weight_update_mode}",
+        )
+        optimizer_state = self.optimizer.state_tensors
+        telemetry = self.runtime.telemetry_tensors
+        resident = self.initial + optimizer_state + self.inference.staging + telemetry
+        parameter_bytes = _bytes(self.optimizer.master)
+        first_bytes = _bytes(self.optimizer.first)
+        second_bytes = _bytes(self.optimizer.second)
+        metadata_bytes = _bytes(self.optimizer.metadata_tensors)
+        online_bytes = 0
+        if isinstance(self.optimizer, OnlineSpecOptimizer):
+            online_bytes = first_bytes + second_bytes
+            first_bytes = 0
+            second_bytes = 0
+        vocab = int(
+            getattr(
+                model.config,
+                "vocab_size",
+                worker.target_worker.model_runner.model_config.vocab_size,
+            )
+        )
+        activation_bytes = estimate_full_vocab_training_scratch_bytes(
+            batch_tokens=training_batch * config.canvas_tokens,
+            vocab_size=vocab,
+        )
+        candidate_bytes = estimate_functional_optimizer_scratch_bytes(
+            self.optimizer,
+            merge_bytes=0,
+        )
+        scratch = parameter_bytes + activation_bytes + candidate_bytes
+        self.runtime.bind_memory(
+            resident_tensors=resident,
+            peak_scratch_bytes=scratch,
+            trainable_tensors=self.optimizer.master,
+            categories={
+                "active_or_base_bytes": _bytes(self.initial),
+                "master_fp32_bytes": parameter_bytes,
+                "gradient_bytes": parameter_bytes,
+                "first_moment_bytes": first_bytes,
+                "second_moment_bytes": second_bytes,
+                "online_state_bytes": online_bytes,
+                "optimizer_metadata_bytes": metadata_bytes,
+                "staging_bytes": _bytes(self.inference.staging),
+                "training_activation_bytes": activation_bytes,
+                "kv_gather_scratch_bytes": 0,
+                "candidate_scratch_bytes": candidate_bytes,
+                "graph_buffer_bytes": 0,
+                "telemetry_bytes": _bytes(telemetry),
+            },
+        )
+        server_args._speculative_adaptation_resident_bytes = self.runtime.resident_bytes
+
+    @property
+    def source_adapter_version(self) -> int:
+        return self.runtime.active_version
+
+    @property
+    def update_due(self) -> bool:
+        return self.runtime.update_due()
+
+    def begin_round(self, batch) -> int:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        return self.runtime.begin_round(request_ids, batch.seq_lens)
+
+    def launch(
+        self,
+        *,
+        loss: torch.Tensor,
+        request_ids: Sequence[str],
+        prefix_lens: torch.Tensor,
+        source_tensors: Sequence[torch.Tensor],
+        feedback_source_version: int,
+    ) -> None:
+        if not self.runtime.update_due():
+            return
+        if loss.numel() != 1 or not loss.requires_grad:
+            self.runtime.disable(
+                "native_backend_loss_not_differentiable", exactness=True
+            )
+            return
+        self.live_launch_count += 1
+        self.last_source_tensor_shapes = tuple(
+            tuple(int(value) for value in tensor.shape) for tensor in source_tensors
+        )
+        self.last_feedback_source_version = feedback_source_version
+        source_round = self.runtime.round
+        source_version = self.runtime.active_version
+        try:
+            with self.runtime.side_update(tuple(source_tensors)):
+                with self.runtime.timing("training"):
+                    raw = torch.autograd.grad(
+                        loss,
+                        self.trainable,
+                        allow_unused=True,
+                    )
+                    gradients = tuple(
+                        torch.zeros_like(parameter) if gradient is None else gradient
+                        for parameter, gradient in zip(self.trainable, raw, strict=True)
+                    )
+                    finite = (
+                        torch.isfinite(loss.detach())
+                        & torch.stack(
+                            [torch.isfinite(gradient).all() for gradient in gradients]
+                        ).all()
+                    )
+                with self.runtime.timing("optimizer"):
+                    proposal = self.optimizer.propose(
+                        gradients,
+                        **(
+                            {
+                                "feedback_source_version": feedback_source_version,
+                                "safe_boundary_version": source_version,
+                            }
+                            if self.config.optimizer.name == "chronobelief"
+                            else {}
+                        ),
+                    )
+                with self.runtime.timing("merge"):
+                    self.inference.stage(proposal.parameters)
+                self.runtime.submit(
+                    source_round=source_round,
+                    source_version=source_version,
+                    optimizer=self.optimizer,
+                    proposal=proposal,
+                    inference_bank=self.inference,
+                    finite=finite,
+                    loss=loss.detach(),
+                    request_ids=request_ids,
+                    prefix_lens=prefix_lens.detach(),
+                    reconstruction_ok=torch.ones(
+                        (), device=self.device, dtype=torch.bool
+                    ),
+                    supervision_nonempty=torch.ones(
+                        (), device=self.device, dtype=torch.bool
+                    ),
+                )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("native_backend_cuda_oom")
+        except Exception as error:
+            logger.exception("Disabling native adaptation after live update failure")
+            self.runtime.counters["fallbacks"] += 1
+            self.runtime.disable(f"native_update_failed:{type(error).__name__}")
+
+    def after_commit(
+        self,
+        batch,
+        *,
+        new_seq_lens: torch.Tensor,
+        verified_drafts: torch.Tensor,
+        accepted_drafts: torch.Tensor,
+        committed_tokens: torch.Tensor,
+    ) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        self.runtime.record_round_outcome(
+            request_ids,
+            verified_drafts=verified_drafts,
+            accepted_drafts=accepted_drafts,
+            committed_tokens=committed_tokens,
+        )
+        self.runtime.record_device_commit(request_ids, new_seq_lens)
+
+    def finish_request(self, request_id: str) -> None:
+        if self.runtime.finish_request(request_id):
+            self._restore_request_source()
+
+    def abort_request(self, request_id: str) -> None:
+        if self.runtime.abort_request(request_id):
+            self._restore_request_source()
+
+    def _restore_request_source(self) -> None:
+        self.optimizer.reset(self.initial)
+        self.inference.stage(self.initial)
+        self.inference.publish()
+
+    def reset(self) -> None:
+        self.runtime.reset()
+        self.optimizer.reset(self.initial)
+        self.inference.stage(self.initial)
+        self.inference.publish()
+
+    def reload_config(self, server_args) -> None:
+        config = load_online_adaptation(server_args)
+        if config is None or adaptation_layout(config) != adaptation_layout(self.config):
+            raise ValueError("native adaptation layout changed; restart the server")
+        self.config = config
+        self.runtime.reload_config(config)
+        reconfigure_parameter_optimizer(self.optimizer, config)
+
+    def diagnostics(self) -> dict[str, object]:
+        return self.runtime.diagnostics(
+            extra={
+                "native_backend": self.config.algorithm,
+                "native_live_launch_count": self.live_launch_count,
+                "native_last_source_tensor_shapes": self.last_source_tensor_shapes,
+                "native_last_feedback_source_version": self.last_feedback_source_version,
+                "native_parameter_names": self.names,
+                "topology": {
+                    "tensor_parallel_size": self.config.topology.tensor_parallel_size,
+                    "data_parallel_size": self.config.topology.data_parallel_size,
+                },
+            }
+        )
+
+
+def maybe_build_native_backend_adapter(server_args, worker, *, algorithm: str, model):
+    config = load_online_adaptation(server_args)
+    if config is None:
+        return None
+    if config.algorithm != algorithm:
+        raise ValueError("native worker/adaptation algorithm mismatch")
+    return NativeBackendOnlineAdapter(
+        server_args,
+        worker,
+        algorithm=algorithm,
+        model=model,
+    )
+
+
+__all__ = ("NativeBackendOnlineAdapter", "maybe_build_native_backend_adapter")
