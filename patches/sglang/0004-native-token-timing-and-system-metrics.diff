diff --git a/python/sglang/srt/managers/native_token_timestamps.py b/python/sglang/srt/managers/native_token_timestamps.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/managers/native_token_timestamps.py
@@ -0,0 +1,61 @@
+"""CPU observation times for committed output tokens.
+
+This hook records host observation time after stop handling, when
+``Req.output_ids_through_stop`` is authoritative. It is not a CUDA event and
+must never be described as the token's device production time.
+"""
+
+from __future__ import annotations
+
+import time
+from typing import Any, Callable, Optional, Sequence
+
+
+NATIVE_TOKEN_TIMESTAMP_HOOK = "sglang.schema_v3.native_per_token_timestamp.v1"
+NATIVE_TOKEN_TIMESTAMP_SEMANTICS = "cpu_committed_token_observed_at_streamer_v1"
+NATIVE_TOKEN_TIMESTAMP_RELEASE_STATUS = "CPU_OBSERVATION_ONLY"
+
+
+def observe_committed_output_tokens(
+    req: Any,
+    *,
+    clock: Callable[[], int] = time.monotonic_ns,
+) -> None:
+    """Append one ordered host observation for every newly committed token."""
+
+    if not getattr(req, "return_native_token_timestamps", False):
+        return
+    output_ids = tuple(int(token) for token in req.output_ids_through_stop)
+    events = req.native_token_timestamp_events
+    if len(output_ids) < len(events):
+        raise RuntimeError("committed output-token coverage moved backwards")
+    if tuple(event[0] for event in events) != output_ids[: len(events)]:
+        raise RuntimeError("committed output-token prefix changed after observation")
+    for token_id in output_ids[len(events) :]:
+        observed_ns = int(clock())
+        if observed_ns < 0 or (events and observed_ns <= events[-1][1]):
+            raise RuntimeError("native token timestamps must be strictly increasing")
+        events.append((token_id, observed_ns))
+
+
+def slice_native_token_timestamp_events(
+    events: Sequence[tuple[int, int]],
+    *,
+    start: int,
+    output_ids: Sequence[int],
+) -> Optional[list[dict[str, int]]]:
+    """Return exact delta events aligned to the streamer's output-token slice."""
+
+    if not events:
+        return None
+    selected = events[start : start + len(output_ids)]
+    if tuple(event[0] for event in selected) != tuple(int(v) for v in output_ids):
+        raise RuntimeError("native token timestamps differ from streamed output IDs")
+    return [
+        {
+            "token_index": start + offset,
+            "token_id": int(token_id),
+            "observed_ns": int(observed_ns),
+        }
+        for offset, (token_id, observed_ns) in enumerate(selected)
+    ]
