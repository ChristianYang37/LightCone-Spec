+                else:
+                    with self.runtime.timing("training"):
+                        member_loss, gradients = member_feedback(self.optimizer.master)
+                        finite = (
+                            torch.isfinite(loss)
+                            & torch.isfinite(member_loss)
+                            & torch.stack(
+                                [
+                                    torch.isfinite(gradient).all()
+                                    for gradient in gradients
+                                ]
+                            ).all()
+                        )
+                    with self.runtime.timing("optimizer"):
+                        proposal = self.optimizer.propose(gradients)
+                with self.runtime.timing("merge"):
+                    effective = self._effective_parameters(proposal.parameters)
+                    # Invalid candidates are rejected from the pinned receipt
+                    # before publication.  Staging their values is harmless;
+                    # selecting the active full drafter here would add another
+                    # full-model read/copy to every update.
+                    self.inference.stage(
+                        tuple(effective[name] for name in self.names)
+                    )
+                self.runtime.submit(
+                    source_round=source_round,
+                    source_version=source_version,
+                    optimizer=self.optimizer,
+                    proposal=proposal,
+                    inference_bank=self.inference,
+                    finite=finite,
+                    loss=loss,
+                    request_ids=self._captured_request_ids,
+                    prefix_lens=self._captured_prefix_lens,
+                    reconstruction_ok=reconstruction_ok,
+                    reconstruction_max_abs=reconstruction_max_abs,
+                    reconstruction_relative_rms=reconstruction_relative_rms,
+                    reconstruction_top1_match=reconstruction_top1_match,
+                    reconstruction_mean_kl=reconstruction_mean_kl,
+                    supervision_nonempty=supervision_nonempty,
+                )
+        except torch.cuda.OutOfMemoryError:
+            self.runtime.counters["oom_events"] += 1
+            self.runtime.disable("adaptation_cuda_oom")
+        except Exception as error:
+            logger.exception("Disabling DFlash adaptation after update failure")
+            self.runtime.counters["fallbacks"] += 1
+            self.runtime.disable(f"adaptation_update_failed:{type(error).__name__}")
+
+    def after_commit(
+        self,
+        batch,
+        new_seq_lens: torch.Tensor,
+        *,
+        accepted_drafts: torch.Tensor,
+        verified_drafts: torch.Tensor,
+        committed_tokens: torch.Tensor,
+    ) -> None:
+        request_ids = tuple(request.rid for request in batch.reqs)
+        self.runtime.record_round_outcome(
+            request_ids,
+            verified_drafts=verified_drafts,
+            accepted_drafts=accepted_drafts,
+            committed_tokens=committed_tokens,
+        )
+        self.runtime.record_device_commit(request_ids, new_seq_lens)
+
+    def finish_request(self, request_id: str) -> None:
+        self.runtime.finish_request(request_id)
+
+    def abort_request(self, request_id: str) -> None:
+        self.runtime.abort_request(request_id)
+
+    def reset(self) -> None:
+        self.runtime.reset()
+        self.optimizer.reset(self.initial_trainable)
+        effective = self._effective_parameters(self.optimizer.master)
+        self.inference.stage(tuple(effective[name] for name in self.names))
+        self.inference.publish()
+        self._captured_input = None
+        self._captured_positions = None
+        self._captured_prefix_lens = None
+        self._captured_request_ids = ()
+        self._captured_history = None
+
+    def note_load(
+        self,
+        *,
+        running_requests: int,
+        waiting_requests: int,
+        graph_replay: bool,
+    ) -> None:
+        self.runtime.note_load(
+            running_requests=running_requests,
+            waiting_requests=waiting_requests,
+            graph_replay=graph_replay,
+        )
+
+    def diagnostics(self) -> dict:
+        online_spec_state = (
+            self.optimizer.diagnostics()
+            if isinstance(self.optimizer, OnlineSpecOptimizer)
+            else None
+        )
+        return self.runtime.diagnostics(
+            extra={"online_spec_state": online_spec_state}
+        )
+
+
+def maybe_build_dflash_drafter_adapter(server_args, worker):
+    config = load_online_adaptation(server_args)
+    if config is None or config.parameter_scope != "drafter":
+        return None
+    return DFlashDrafterAdapter(server_args, worker)
