+                                    draft_logits,
+                                    inference_logits,
+                                )
+                            member_loss = self._distillation_loss(
+                                draft_logits,
+                                target,
+                                owned_mask,
+                            )
+                            return torch.where(
+                                reconstruction_ok,
+                                member_loss,
+                                member_loss * 0.0,
+                            )
+
+                        return loss_and_grad(parameters, objective)
+
+                if (
+                    isinstance(self.optimizer, OnlineSpecOptimizer)
+                    and self.optimizer.is_ensemble
+                ):
+                    expert_losses = []
+                    expert_finite = []
+                    updated_experts = []
+                    for index, expert in enumerate(self.optimizer.experts):
+                        with self.runtime.timing("training"):
+                            member_loss, gradients = member_feedback(expert)
+                            expert_losses.append(member_loss.detach())
+                            expert_finite.append(
+                                torch.isfinite(member_loss.detach())
+                                & torch.stack(
+                                    [
+                                        torch.isfinite(gradient).all()
+                                        for gradient in gradients
+                                    ]
+                                ).all()
+                            )
+                        with self.runtime.timing("optimizer"):
+                            updated_experts.append(
+                                self.optimizer.propose_ensemble_member(
+                                    index,
+                                    gradients,
+                                )
+                            )
+                        # Retain the candidate state, not every expert's
+                        # full-model gradient and differentiable leaves.
+                        del member_loss, gradients
+                    stacked_losses = torch.stack(expert_losses)
+                    finite = torch.isfinite(loss) & torch.stack(expert_finite).all()
+                    with self.runtime.timing("optimizer"):
+                        proposal = self.optimizer.combine_ensemble(
+                            stacked_losses,
+                            updated_experts,
