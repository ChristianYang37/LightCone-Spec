+"""Shared semantic proposal mask for linear speculative backends."""
+
+from __future__ import annotations
+
+from typing import Sequence
+
+import torch
+
+
+def request_boundary_metadata(
+    requests: Sequence[object],
+) -> tuple[list[int], list[tuple[int, ...]], list[bool]]:
+    """Extract max-token and terminal semantics once for every backend."""
+    remaining: list[int] = []
+    terminal_ids: list[tuple[int, ...]] = []
+    ignore_eos: list[bool] = []
+    for request in requests:
+        generated = len(request.output_ids)
+        sampling = request.sampling_params
+        remaining.append(max(int(sampling.max_new_tokens) - generated, 0))
+        stops = set(getattr(request, "eos_token_ids", None) or ())
+        stops.update(getattr(sampling, "stop_token_ids", None) or ())
+        terminal_ids.append(tuple(sorted(int(token) for token in stops)))
+        ignore_eos.append(bool(getattr(sampling, "ignore_eos", False)))
+    return remaining, terminal_ids, ignore_eos
+
+
+def semantic_proposal_semantics(
+    *,
+    proposal_tokens: torch.Tensor,
+    correct_len: torch.Tensor,
+    remaining_output_tokens: Sequence[int],
+    terminal_token_ids: Sequence[Sequence[int]],
+    ignore_eos: Sequence[bool],
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return valid teachers, accepted drafts, and semantic commits."""
+    if proposal_tokens.ndim != 2:
+        raise ValueError("proposal_tokens must have shape (batch, depth)")
+    batch, depth = proposal_tokens.shape
+    if correct_len.shape != (batch,):
+        raise ValueError("correct_len must have one value per request")
+    if not (
+        len(remaining_output_tokens)
+        == len(terminal_token_ids)
+        == len(ignore_eos)
+        == batch
+    ):
+        raise ValueError("request-boundary metadata length mismatch")
+    positions = torch.arange(
+        depth, device=proposal_tokens.device, dtype=correct_len.dtype
+    )[None, :]
+    # The first rejected proposal has a valid target teacher distribution;
+    # positions after it were conditioned on an invalid draft suffix.
+    valid = positions <= correct_len[:, None]
+    remaining = torch.tensor(
+        remaining_output_tokens,
+        device=proposal_tokens.device,
+        dtype=correct_len.dtype,
+    )
+    valid &= positions < remaining[:, None]
+    # The target bonus is committed only when the accepted draft prefix and
+    # request boundary leave room for it.
+    committed = torch.minimum(correct_len + 1, remaining)
+    for index, terminal_ids in enumerate(terminal_token_ids):
+        if ignore_eos[index] or not terminal_ids:
+            continue
+        terminals = torch.tensor(
+            tuple(terminal_ids),
+            device=proposal_tokens.device,
+            dtype=proposal_tokens.dtype,
+        )
+        hit = (proposal_tokens[index, :, None] == terminals).any(-1)
+        accepted_hit = hit & (positions[0] < correct_len[index])
+        earlier_terminal = (
+            torch.cat(
+                (
+                    torch.zeros((1,), device=proposal_tokens.device, dtype=torch.bool),
+                    accepted_hit[:-1],
+                )
+            ).cumsum(0)
+            > 0
+        )
+        valid[index] &= ~earlier_terminal
+        terminal_positions = torch.where(
+            accepted_hit,
+            positions[0] + 1,
+            torch.full_like(positions[0], depth + 1),
+        )
+        committed[index] = torch.minimum(committed[index], terminal_positions.min())
+    accepted = torch.minimum(correct_len, committed)
+    return valid, accepted, committed
+
+
+def semantic_valid_mask(
+    *,
+    proposal_tokens: torch.Tensor,
+    correct_len: torch.Tensor,
+    remaining_output_tokens: Sequence[int],
+    terminal_token_ids: Sequence[Sequence[int]],
+    ignore_eos: Sequence[bool],
+) -> torch.Tensor:
+    """Mask rejected suffix, request boundary, and accepted terminal suffix."""
+    valid, _, _ = semantic_proposal_semantics(
+        proposal_tokens=proposal_tokens,
+        correct_len=correct_len,
+        remaining_output_tokens=remaining_output_tokens,
+        terminal_token_ids=terminal_token_ids,
+        ignore_eos=ignore_eos,
+    )
+    return valid
+
+
+def semantic_outcome_lengths(
+    *,
+    proposal_tokens: torch.Tensor,
+    correct_len: torch.Tensor,
+    bonus_tokens: torch.Tensor,
+    remaining_output_tokens: Sequence[int],
+    terminal_token_ids: Sequence[Sequence[int]],
+    ignore_eos: Sequence[bool],
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return accepted drafts and committed tokens after request semantics.
+
+    A normal verification commits ``correct_len`` drafts plus one target bonus.
+    A request boundary may cut inside the accepted prefix, while an accepted
+    terminal token commits that token but neither its suffix nor the bonus.
+    """
+    batch = proposal_tokens.shape[0] if proposal_tokens.ndim == 2 else -1
+    if bonus_tokens.shape != (batch,):
+        raise ValueError("outcome lengths require one value per request")
+    _, accepted, committed = semantic_proposal_semantics(
+        proposal_tokens=proposal_tokens,
+        correct_len=correct_len,
+        remaining_output_tokens=remaining_output_tokens,
+        terminal_token_ids=terminal_token_ids,
+        ignore_eos=ignore_eos,
+    )
+    return accepted, committed
