diff --git a/python/sglang/srt/speculative/compile_cache_evidence.py b/python/sglang/srt/speculative/compile_cache_evidence.py
new file mode 100644
index 0000000..21497fb
--- /dev/null
+++ b/python/sglang/srt/speculative/compile_cache_evidence.py
@@ -0,0 +1,378 @@
+"""Source-owned CPU contract for one ordered compile/prewarm lifecycle.
+
+The producer observes terminal requests inside the scheduler.  It does not
+accept runtime counters, cache digests, JIT durations, or CUDA Graph claims
+from the caller.  Those GPU semantics remain explicitly pending until a
+separate GPU qualification binds this exact patched tree.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import subprocess
+from pathlib import Path
+
+SOURCE_OWNED_COMPILE_HOOK = (
+    "sglang.schema_v3.source_owned_compile_cache_lifecycle.v1"
+)
+SOURCE_OWNED_COMPILE_ACTIONS = frozenset({"compile_begin", "compile_finalize"})
+SOURCE_OWNED_COMPILE_RELEASE_STATUS = "CPU_CONTRACT_ONLY"
+GPU_COMPILE_SEMANTICS = "PENDING"
+GPU_COMPILE_REASON = "gpu_compile_semantics_unavailable"
+
+_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
+_GIT_OBJECT = re.compile(r"[0-9a-f]{40}\Z")
+_PLAN_KEYS = {
+    "assignment_plan_sha256",
+    "compile_key_sha256",
+    "model_lock_sha256",
+    "sampling_profile_sha256",
+    "physical_assignment_sha256",
+    "experiment_budget_sha256",
+    "inventory_sha256",
+    "prewarm_manifest_sha256",
+    "prewarm",
+}
+_PREWARM_KEYS = {
+    "graph_bucket",
+    "request_id",
+    "input_token_ids_sha256",
+    "requested_output_tokens",
+    "sampling_seed",
+}
+_STATE_KEYS = {"active_requests", "queued_requests"}
+_UNAVAILABLE_GPU_MEASUREMENTS = (
+    "cache_hits",
+    "cache_misses",
+    "jit_time_ns",
+    "graph_capture_count",
+    "graph_replay_count",
+    "cache_write_count",
+)
+
+
+def content_sha256(value: object) -> str:
+    encoded = json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    ).encode()
+    return hashlib.sha256(encoded).hexdigest()
+
+
+SOURCE_OWNED_COMPILE_PROTOCOL_SHA256 = content_sha256(
+    {
+        "schema_version": 1,
+        "hook": SOURCE_OWNED_COMPILE_HOOK,
+        "release_status": SOURCE_OWNED_COMPILE_RELEASE_STATUS,
+        "lifecycle": ("begin", "ordered_request_terminals", "finalize"),
+        "source_owned": (
+            "patched_tree",
+            "process_identity",
+            "process_start",
+            "request_terminals",
+            "begin_and_final_scheduler_state",
+        ),
+        "caller_runtime_counters_forbidden": True,
+        "gpu_compile_semantics": GPU_COMPILE_SEMANTICS,
+        "gpu_measurements": {
+            name: None for name in _UNAVAILABLE_GPU_MEASUREMENTS
+        },
+    }
+)
+
+
+def _sha256(value: object, name: str) -> str:
+    if not isinstance(value, str) or _SHA256.fullmatch(value) is None:
+        raise ValueError(f"{name} must be a lowercase SHA-256")
+    return value
+
+
+def _text(value: object, name: str) -> str:
+    if (
+        not isinstance(value, str)
+        or not value
+        or "\n" in value
+        or "\r" in value
+    ):
+        raise ValueError(f"{name} must be non-empty single-line text")
+    return value
+
+
+def _integer(value: object, name: str, *, positive: bool = False) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise ValueError(f"{name} must be an integer")
+    minimum = 1 if positive else 0
+    if value < minimum:
+        raise ValueError(f"{name} must be at least {minimum}")
+    return value
+
+
+def resolve_patched_sglang_tree() -> str:
+    """Read the running checkout tree; never trust an HTTP field for it."""
+
+    source = Path(__file__).resolve()
+    for parent in source.parents:
+        if not (parent / ".git").exists():
+            continue
+        completed = subprocess.run(
+            ["git", "rev-parse", "HEAD^{tree}"],
+            cwd=parent,
+            check=True,
+            text=True,
+            capture_output=True,
+        )
+        tree = completed.stdout.strip()
+        if _GIT_OBJECT.fullmatch(tree) is not None:
+            return tree
+        break
+    raise RuntimeError("source-owned compile requires a verifiable patched checkout")
+
+
+def _scheduler_state(value: object) -> dict[str, int]:
+    if not isinstance(value, dict) or set(value) != _STATE_KEYS:
+        raise ValueError("compile scheduler state fields are incomplete")
+    state = {
+        name: _integer(value[name], f"compile {name}") for name in _STATE_KEYS
+    }
+    if state["active_requests"] or state["queued_requests"]:
+        raise RuntimeError("compile lifecycle boundary requires a drained scheduler")
+    return state
+
+
+def _prewarm_plan(value: object) -> tuple[dict[str, object], ...]:
+    if not isinstance(value, list) or not value:
+        raise ValueError("compile prewarm plan must be a non-empty array")
+    rows: list[dict[str, object]] = []
+    request_ids: set[str] = set()
+    prior_bucket = 0
+    for raw in value:
+        if not isinstance(raw, dict) or set(raw) != _PREWARM_KEYS:
+            raise ValueError("compile prewarm row fields are incomplete")
+        request_id = _text(raw["request_id"], "compile prewarm request ID")
+        bucket = _integer(
+            raw["graph_bucket"], "compile graph bucket", positive=True
+        )
+        input_sha256 = _sha256(
+            raw["input_token_ids_sha256"], "compile prewarm input token IDs"
+        )
+        requested_output_tokens = _integer(
+            raw["requested_output_tokens"],
+            "compile requested output tokens",
+            positive=True,
+        )
+        sampling_seed = _integer(raw["sampling_seed"], "compile sampling seed")
+        if request_id in request_ids:
+            raise ValueError("compile prewarm request IDs must be unique")
+        if bucket < prior_bucket:
+            raise ValueError("compile graph buckets must be ordered")
+        request_ids.add(request_id)
+        prior_bucket = bucket
+        rows.append(
+            {
+                "graph_bucket": bucket,
+                "request_id": request_id,
+                "input_token_ids_sha256": input_sha256,
+                "requested_output_tokens": requested_output_tokens,
+                "sampling_seed": sampling_seed,
+            }
+        )
+    return tuple(rows)
+
+
+class SourceOwnedCompileCacheProducer:
+    """One-shot source producer for begin -> ordered terminals -> finalize."""
+
+    def __init__(
+        self,
+        *,
+        process_started_ns: int,
+        patched_sglang_tree: str | None = None,
+    ) -> None:
+        self.process_id = os.getpid()
+        self.process_started_ns = _integer(
+            process_started_ns, "compile process start", positive=True
+        )
+        tree = patched_sglang_tree or resolve_patched_sglang_tree()
+        if _GIT_OBJECT.fullmatch(tree) is None:
+            raise ValueError("compile patched SGLang tree must be a Git object")
+        self.patched_sglang_tree = tree
+        self.phase = "IDLE"
+        self.failed = False
+        self.plan: dict[str, object] | None = None
+        self.prewarm: tuple[dict[str, object], ...] = ()
+        self.terminals: list[dict[str, object]] = []
+        self.begin_receipt: dict[str, object] | None = None
+
+    def fail_closed(self) -> None:
+        self.failed = True
+        self.phase = "FAILED"
+
+    def begin(
+        self, payload: object, *, scheduler_state: object
+    ) -> dict[str, object]:
+        if self.phase != "IDLE" or self.failed:
+            raise RuntimeError("compile lifecycle has already started")
+        if not isinstance(payload, dict) or set(payload) != _PLAN_KEYS:
+            raise ValueError("compile begin fields are incomplete")
+        plan = dict(payload)
+        for name in _PLAN_KEYS - {"prewarm"}:
+            _sha256(plan[name], f"compile {name}")
+        prewarm = _prewarm_plan(plan.pop("prewarm"))
+        begin_state = _scheduler_state(scheduler_state)
+        identity = {
+            **plan,
+            "prewarm_sha256": content_sha256(list(prewarm)),
+        }
+        receipt = {
+            "schema_version": 1,
+            "hook": SOURCE_OWNED_COMPILE_HOOK,
+            "protocol_sha256": SOURCE_OWNED_COMPILE_PROTOCOL_SHA256,
+            "release_status": SOURCE_OWNED_COMPILE_RELEASE_STATUS,
+            "gpu_compile_semantics": GPU_COMPILE_SEMANTICS,
+            "gpu_compile_reason": GPU_COMPILE_REASON,
+            "patched_sglang_tree": self.patched_sglang_tree,
+            "process_id": self.process_id,
+            "process_started_ns": self.process_started_ns,
+            **identity,
+            "ordered_prewarm": list(prewarm),
+            "begin_state": begin_state,
+        }
+        receipt["begin_sha256"] = content_sha256(receipt)
+        self.plan = identity
+        self.prewarm = prewarm
+        self.begin_receipt = receipt
+        self.phase = "PREWARM"
+        return receipt
+
+    def note_request_terminal(
+        self,
+        *,
+        request_id: object,
+        input_token_ids: object,
+        output_token_ids: object,
+        requested_output_tokens: object,
+        sampling_seed: object,
+        terminal_status: object,
+        terminal_reason: object,
+    ) -> None:
+        if self.phase != "PREWARM" or self.failed:
+            return
+        index = len(self.terminals)
+        try:
+            if index >= len(self.prewarm):
+                raise RuntimeError("compile observed an unregistered terminal request")
+            expected = self.prewarm[index]
+            observed_request_id = _text(request_id, "compile terminal request ID")
+            if observed_request_id != expected["request_id"]:
+                raise RuntimeError("compile terminal request order differs from plan")
+            if not isinstance(input_token_ids, tuple) or any(
+                isinstance(token, bool) or not isinstance(token, int)
+                for token in input_token_ids
+            ):
+                raise ValueError("compile terminal input token IDs are invalid")
+            if not isinstance(output_token_ids, tuple) or any(
+                isinstance(token, bool) or not isinstance(token, int)
+                for token in output_token_ids
+            ):
+                raise ValueError("compile terminal output token IDs are invalid")
+            input_sha256 = content_sha256(list(input_token_ids))
+            if input_sha256 != expected["input_token_ids_sha256"]:
+                raise RuntimeError("compile terminal input differs from prewarm plan")
+            observed_requested_output_tokens = _integer(
+                requested_output_tokens,
+                "compile terminal requested output tokens",
+                positive=True,
+            )
+            observed_sampling_seed = _integer(
+                sampling_seed, "compile terminal sampling seed"
+            )
+            if (
+                observed_requested_output_tokens
+                != expected["requested_output_tokens"]
+                or observed_sampling_seed != expected["sampling_seed"]
+            ):
+                raise RuntimeError("compile terminal sampling differs from plan")
+            status = _text(terminal_status, "compile terminal status")
+            reason = _text(terminal_reason, "compile terminal reason")
+            if status != "completed":
+                raise RuntimeError("compile prewarm request did not complete")
+            row = {
+                "sequence": index,
+                "graph_bucket": expected["graph_bucket"],
+                "request_id": observed_request_id,
+                "input_token_count": len(input_token_ids),
+                "input_token_ids_sha256": input_sha256,
+                "output_token_count": len(output_token_ids),
+                "output_token_ids_sha256": content_sha256(list(output_token_ids)),
+                "requested_output_tokens": observed_requested_output_tokens,
+                "sampling_seed": observed_sampling_seed,
+                "terminal_status": status,
+                "terminal_reason": reason,
+            }
+            row["terminal_sha256"] = content_sha256(row)
+            self.terminals.append(row)
+        except Exception:
+            self.fail_closed()
+            raise
+
+    def finalize(
+        self,
+        *,
+        begin_sha256: object,
+        scheduler_state: object,
+    ) -> dict[str, object]:
+        if self.failed or self.phase != "PREWARM":
+            raise RuntimeError("compile lifecycle is not finalizable")
+        if self.begin_receipt is None or self.plan is None:
+            raise RuntimeError("compile lifecycle lacks its begin receipt")
+        if _sha256(begin_sha256, "compile begin receipt") != self.begin_receipt[
+            "begin_sha256"
+        ]:
+            raise ValueError("compile finalize names another begin receipt")
+        if len(self.terminals) != len(self.prewarm):
+            raise RuntimeError("compile prewarm terminal coverage is incomplete")
+        final_state = _scheduler_state(scheduler_state)
+        unavailable = {
+            name: {"value": None, "reason": GPU_COMPILE_REASON}
+            for name in _UNAVAILABLE_GPU_MEASUREMENTS
+        }
+        receipt = {
+            "schema_version": 1,
+            "hook": SOURCE_OWNED_COMPILE_HOOK,
+            "protocol_sha256": SOURCE_OWNED_COMPILE_PROTOCOL_SHA256,
+            "release_status": SOURCE_OWNED_COMPILE_RELEASE_STATUS,
+            "gpu_compile_semantics": GPU_COMPILE_SEMANTICS,
+            "gpu_compile_reason": GPU_COMPILE_REASON,
+            "patched_sglang_tree": self.patched_sglang_tree,
+            "process_id": self.process_id,
+            "process_started_ns": self.process_started_ns,
+            **self.plan,
+            "begin_sha256": self.begin_receipt["begin_sha256"],
+            "begin_state": self.begin_receipt["begin_state"],
+            "ordered_terminals": list(self.terminals),
+            "final_state": final_state,
+            "gpu_measurements": unavailable,
+            "completion_marker": "COMPILE_CPU_CONTRACT_COMPLETE",
+        }
+        receipt["compile_receipt_sha256"] = content_sha256(receipt)
+        self.phase = "FINALIZED"
+        return receipt
+
+
+__all__ = [
+    "GPU_COMPILE_REASON",
+    "GPU_COMPILE_SEMANTICS",
+    "SOURCE_OWNED_COMPILE_ACTIONS",
+    "SOURCE_OWNED_COMPILE_HOOK",
+    "SOURCE_OWNED_COMPILE_PROTOCOL_SHA256",
+    "SOURCE_OWNED_COMPILE_RELEASE_STATUS",
+    "SourceOwnedCompileCacheProducer",
+    "content_sha256",
+    "resolve_patched_sglang_tree",
+]
