+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+MODULE_PATH = (
+    Path(__file__).resolve().parents[4]
+    / "python/sglang/srt/speculative/compile_cache_evidence.py"
+)
+SPEC = importlib.util.spec_from_file_location("compile_cache_evidence", MODULE_PATH)
+assert SPEC is not None and SPEC.loader is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+GPU_COMPILE_REASON = MODULE.GPU_COMPILE_REASON
+GPU_COMPILE_SEMANTICS = MODULE.GPU_COMPILE_SEMANTICS
+SOURCE_OWNED_COMPILE_ACTIONS = MODULE.SOURCE_OWNED_COMPILE_ACTIONS
+SOURCE_OWNED_COMPILE_HOOK = MODULE.SOURCE_OWNED_COMPILE_HOOK
+SOURCE_OWNED_COMPILE_RELEASE_STATUS = MODULE.SOURCE_OWNED_COMPILE_RELEASE_STATUS
+SourceOwnedCompileCacheProducer = MODULE.SourceOwnedCompileCacheProducer
+content_sha256 = MODULE.content_sha256
+
+
+def _sha(label: str) -> str:
+    return hashlib.sha256(label.encode()).hexdigest()
+
+
+def _payload() -> dict[str, object]:
+    return {
+        "assignment_plan_sha256": _sha("plan"),
+        "compile_key_sha256": _sha("key"),
+        "model_lock_sha256": _sha("model"),
+        "sampling_profile_sha256": _sha("sampling"),
+        "physical_assignment_sha256": _sha("assignment"),
+        "experiment_budget_sha256": _sha("budget"),
+        "inventory_sha256": _sha("inventory"),
+        "prewarm_manifest_sha256": _sha("prewarm-manifest"),
+        "prewarm": [
+            {
+                "graph_bucket": 1,
+                "request_id": "compile-bucket-1",
+                "input_token_ids_sha256": content_sha256([1, 2]),
+                "requested_output_tokens": 1,
+                "sampling_seed": 11,
+            },
+            {
+                "graph_bucket": 2,
+                "request_id": "compile-bucket-2",
+                "input_token_ids_sha256": content_sha256([3, 4]),
+                "requested_output_tokens": 2,
+                "sampling_seed": 22,
+            },
+        ],
+    }
+
+
+def _producer() -> SourceOwnedCompileCacheProducer:
+    return SourceOwnedCompileCacheProducer(
+        process_started_ns=9,
+        patched_sglang_tree="a" * 40,
+    )
+
+
+def _drained() -> dict[str, int]:
+    return {"active_requests": 0, "queued_requests": 0}
+
+
+def test_compile_action_set_and_cpu_only_capability_are_exact() -> None:
+    assert SOURCE_OWNED_COMPILE_ACTIONS == frozenset(
+        {"compile_begin", "compile_finalize"}
+    )
+    producer = _producer()
+    begin = producer.begin(_payload(), scheduler_state=_drained())
+    assert begin["hook"] == SOURCE_OWNED_COMPILE_HOOK
+    assert begin["release_status"] == "CPU_CONTRACT_ONLY"
+    assert begin["gpu_compile_semantics"] == "PENDING"
+    assert begin["gpu_compile_reason"] == GPU_COMPILE_REASON
+    assert begin["patched_sglang_tree"] == "a" * 40
+    assert begin["ordered_prewarm"] == _payload()["prewarm"]
+
+
+def test_source_owned_ordered_terminals_finalize_without_invented_gpu_values() -> None:
+    producer = _producer()
+    begin = producer.begin(_payload(), scheduler_state=_drained())
+    producer.note_request_terminal(
+        request_id="compile-bucket-1",
+        input_token_ids=(1, 2),
+        output_token_ids=(7,),
+        requested_output_tokens=1,
+        sampling_seed=11,
+        terminal_status="completed",
+        terminal_reason="FINISH_LENGTH",
+    )
+    producer.note_request_terminal(
+        request_id="compile-bucket-2",
+        input_token_ids=(3, 4),
+        output_token_ids=(8, 9),
+        requested_output_tokens=2,
+        sampling_seed=22,
+        terminal_status="completed",
+        terminal_reason="FINISH_LENGTH",
+    )
+    receipt = producer.finalize(
+        begin_sha256=begin["begin_sha256"], scheduler_state=_drained()
+    )
+
+    assert receipt["release_status"] == SOURCE_OWNED_COMPILE_RELEASE_STATUS
+    assert receipt["gpu_compile_semantics"] == GPU_COMPILE_SEMANTICS
+    assert receipt["completion_marker"] == "COMPILE_CPU_CONTRACT_COMPLETE"
+    assert [row["graph_bucket"] for row in receipt["ordered_terminals"]] == [1, 2]
+    assert [row["request_id"] for row in receipt["ordered_terminals"]] == [
+        "compile-bucket-1",
+        "compile-bucket-2",
+    ]
+    assert all(
+        measurement == {"value": None, "reason": GPU_COMPILE_REASON}
+        for measurement in receipt["gpu_measurements"].values()
+    )
+    assert receipt["compile_receipt_sha256"] == content_sha256(
+        {
+            key: value
+            for key, value in receipt.items()
+            if key != "compile_receipt_sha256"
+        }
+    )
+
+
+@pytest.mark.parametrize(
+    "extra_field",
+    (
+        "cache_hits",
+        "cache_misses",
+        "jit_time_ns",
+        "graph_capture_count",
+        "cache_write_count",
+    ),
+)
+def test_begin_rejects_caller_authored_runtime_measurements(extra_field: str) -> None:
+    payload = _payload()
+    payload[extra_field] = 0
+    with pytest.raises(ValueError, match="begin fields"):
+        _producer().begin(payload, scheduler_state=_drained())
+
+
+def test_request_order_and_input_identity_fail_closed() -> None:
+    producer = _producer()
+    begin = producer.begin(_payload(), scheduler_state=_drained())
+    with pytest.raises(RuntimeError, match="order differs"):
+        producer.note_request_terminal(
+            request_id="compile-bucket-2",
+            input_token_ids=(3, 4),
+            output_token_ids=(8,),
+            requested_output_tokens=2,
+            sampling_seed=22,
+            terminal_status="completed",
+            terminal_reason="FINISH_LENGTH",
+        )
+    with pytest.raises(RuntimeError, match="not finalizable"):
+        producer.finalize(
+            begin_sha256=begin["begin_sha256"], scheduler_state=_drained()
+        )
+
+    second = _producer()
+    second.begin(_payload(), scheduler_state=_drained())
+    with pytest.raises(RuntimeError, match="input differs"):
+        second.note_request_terminal(
+            request_id="compile-bucket-1",
+            input_token_ids=(99,),
+            output_token_ids=(8,),
+            requested_output_tokens=1,
+            sampling_seed=11,
+            terminal_status="completed",
+            terminal_reason="FINISH_LENGTH",
+        )
+
+
+def test_incomplete_coverage_and_non_drained_boundaries_are_rejected() -> None:
+    with pytest.raises(RuntimeError, match="drained scheduler"):
+        _producer().begin(
+            _payload(), scheduler_state={"active_requests": 1, "queued_requests": 0}
+        )
+    producer = _producer()
+    begin = producer.begin(_payload(), scheduler_state=_drained())
+    with pytest.raises(RuntimeError, match="coverage is incomplete"):
+        producer.finalize(
+            begin_sha256=begin["begin_sha256"], scheduler_state=_drained()
+        )
+
+
+def test_http_surface_never_accepts_runtime_measurements_or_generic_actions() -> None:
+    root = Path(__file__).resolve().parents[4]
+    server = (root / "python/sglang/srt/entrypoints/http_server.py").read_text()
+    generic = server.split(
+        "async def terminal_speculative_evidence(", maxsplit=1
+    )[1].split(
+        "async def _send_terminal_speculative_evidence_transition(", maxsplit=1
+    )[0]
+    assert "SOURCE_OWNED_COMPILE_ACTIONS" in generic
+    begin = server.split("async def source_owned_compile_begin(", maxsplit=1)[1].split(
+        '@app.post("/v1/lightcone-spec/compile-cache-evidence/finalize")',
+        maxsplit=1,
+    )[0]
+    for forbidden in (
+        "cache_hits",
+        "cache_misses",
+        "jit_time_ns",
+        "graph_capture_count",
+        "cache_write_count",
+    ):
+        assert forbidden not in begin
