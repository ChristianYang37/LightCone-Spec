         ret["effective_max_running_requests_per_dp"] = self.max_running_requests
+        if self.metrics_reporter.speed_study_enabled:
+            speed_samples = self.metrics_reporter.speed_study_graph_total
+            target_calls = (
+                self.metrics_reporter.spec_total_num_forward_ct
+                + self.metrics_reporter.spec_num_forward_ct
+            )
+            committed_tokens = (
+                self.metrics_reporter.spec_total_num_accept_tokens
+                + self.metrics_reporter.spec_num_accept_tokens
+            )
+            accepted_drafts = max(committed_tokens - target_calls, 0)
+            verified_drafts = target_calls * max(
+                int(self.server_args.speculative_num_draft_tokens) - 1, 0
+            )
+            ret["speed_study_metrics"] = {
+                "target_calls": target_calls,
+                "accepted_drafts": accepted_drafts,
+                "committed_tokens": committed_tokens,
+                "verified_drafts": verified_drafts,
+                "verification_waste": verified_drafts - accepted_drafts,
+                "oom_events": self.metrics_reporter.speed_study_oom_events,
+                "retractions": self.metrics_reporter.speed_study_retractions,
+                "peak_hbm_bytes": int(
+                    torch.cuda.max_memory_allocated(self.device)
+                    if torch.cuda.is_available()
+                    and str(self.device).startswith("cuda")
+                    else 0
+                ),
+                "kv_bytes": int(
+                    self.token_to_kv_pool_allocator.get_kvcache().mem_usage
+                    * (1 << 30)
+                ),
+                "batch_fill": (
+                    self.metrics_reporter.speed_study_batch_sum / speed_samples
+                    if speed_samples
+                    else 0.0
+                ),
+                "queue_occupancy": (
+                    self.metrics_reporter.speed_study_queue_sum / speed_samples
+                    if speed_samples
+                    else 0.0
+                ),
+                "graph_replay_hit_rate": (
+                    self.metrics_reporter.speed_study_graph_hits / speed_samples
+                    if speed_samples
+                    else 0.0
+                ),
+            }
 
         if self.server_args.elastic_ep_backend is not None:
             from sglang.srt.elastic_ep.elastic_ep import ElasticEPStateManager
@@ -4024,10 +4088,14 @@ class Scheduler(
         if RECORD_STEP_TIME:
