+class DFlashTargetDecodeRequired(RuntimeError):
+    """The current request must bypass DFlash and use ordinary target decode.
+
+    This is intentionally distinct from a generic kernel error.  Catchers may
+    safely fail open to the target model, but must never reinterpret it as
+    permission to run greedy DFlash for a stochastic request.
+    """
+
+
+@runtime_checkable
+class DFlashTailAdapter(Protocol):
+    """Capture-safe protocol implemented by a DFlash tail adaptation runtime.
+
+    ``correct_draft_logits`` is called exactly once for each contiguous local
+    vocabulary range, after the frozen target head matmul and before argmax.
+    Implementations must use fixed-address device buffers when this call is
+    captured in a CUDA graph and must not mutate ``hidden_states`` or
+    ``raw_logits`` in place: both are immutable training evidence.
+    Lifecycle/training hooks are deliberately duck-typed by
+    ``DFlashWorkerV2`` so a minimal inference-only adapter only needs this
+    method plus ``source_adapter_versions``.
+    """
+
+    def correct_draft_logits(
+        self,
+        *,
+        hidden_states: torch.Tensor,
+        raw_logits: torch.Tensor,
+        row_start: int,
+        rows_per_request: int,
+        vocab_start: int,
+        vocab_end: int,
+        graph_capture: bool,
+    ) -> torch.Tensor: ...
+
+    def source_adapter_versions(self, batch: Any) -> Any: ...
+
+
+def apply_dflash_tail_correction(
+    adapter: Optional[DFlashTailAdapter],
+    *,
+    hidden_states: torch.Tensor,
+    raw_logits: torch.Tensor,
+    row_start: int,
+    rows_per_request: int,
+    vocab_start: int,
+    vocab_end: int,
+    graph_capture: bool,
+) -> torch.Tensor:
+    """Apply one local-vocabulary tail correction and validate its contract.
+
+    Returning ``raw_logits`` verbatim for the disabled case is important: it
+    preserves the native allocation/lifetime graph and keeps DFlash-off free of
+    adaptation buffers.  The strict checks prevent an adapter from silently
+    changing TP row ownership or introducing an implicit cross-device copy.
+    """
+    if adapter is None:
+        return raw_logits
+
+    correct = getattr(adapter, "correct_draft_logits", None)
+    if correct is None:
+        raise TypeError(
+            "DFLASH tail adaptation requires correct_draft_logits(...)."
+        )
+    corrected = correct(
+        hidden_states=hidden_states,
+        raw_logits=raw_logits,
+        row_start=int(row_start),
+        rows_per_request=int(rows_per_request),
+        vocab_start=int(vocab_start),
+        vocab_end=int(vocab_end),
+        graph_capture=bool(graph_capture),
+    )
+    if not torch.is_tensor(corrected):
+        raise TypeError(
+            "DFLASH correct_draft_logits must return a torch.Tensor, "
+            f"got {type(corrected).__name__}."
+        )
+    if corrected.shape != raw_logits.shape:
+        raise ValueError(
+            "DFLASH tail correction changed the local logits shape: "
+            f"raw={tuple(raw_logits.shape)}, corrected={tuple(corrected.shape)}."
+        )
+    if corrected.device != raw_logits.device:
+        raise ValueError(
+            "DFLASH tail correction moved logits across devices: "
+            f"raw={raw_logits.device}, corrected={corrected.device}."
+        )
+    if corrected.dtype != raw_logits.dtype:
+        raise ValueError(
+            "DFLASH tail correction changed logits dtype: "
+            f"raw={raw_logits.dtype}, corrected={corrected.dtype}."
+        )
+    return corrected
+
+
+def validate_dflash_exact_sampling(
+    *,
+    adaptation_enabled: bool,
+    is_all_greedy: bool,
+    sampling_kernel_available: bool,
+    threshold_single: float,
+    threshold_acc: float,
+) -> None:
+    """Fail closed when adapted stochastic DFlash would change the target law.
+
+    DFlash emits a deterministic proposal (a delta distribution).  The
+    target-only verification kernel is exact only with both heuristic
+    acceptance thresholds disabled (equal to one).  If that kernel is absent,
+    callers must switch the request to ordinary target decoding; greedy verify
+    is not a distribution-preserving fallback.
+    """
+    if not adaptation_enabled or is_all_greedy:
+        return
+    if float(threshold_single) != 1.0 or float(threshold_acc) != 1.0:
+        raise ValueError(
+            "Adapted stochastic DFLASH requires "
+            "speculative_accept_threshold_single=1.0 and "
+            "speculative_accept_threshold_acc=1.0 for exact verification."
+        )
+    if not sampling_kernel_available:
+        raise DFlashTargetDecodeRequired(
+            "Adapted stochastic DFLASH verification is unavailable on this "
+            "build/device; route the request through ordinary target decode. "
+            "Greedy DFLASH fallback is forbidden because it changes the "
+            "sampling distribution."
+        )
+
+
+def validate_dflash_adaptation_startup(
+    *,
+    sampling_kernel_available: bool,
+    threshold_single: float,
+    threshold_acc: float,
+    stochastic: bool = True,
+) -> None:
+    """Reject an unsafe adapted DFlash service before model/draft execution.
+
+    DFlash is selected at the scheduler/batch level today.  In particular, an
+    overlap scheduler unconditionally dereferences ``next_draft_input`` and a
+    non-overlap scheduler keeps invoking the same speculative worker, so the
+    worker cannot safely turn one request into ordinary target decoding by
+    returning ``None``.  Validate the stochastic superset at installation time
+    instead of discovering the incompatibility after prefill or draft work.
+    """
+    if float(threshold_single) != 1.0 or float(threshold_acc) != 1.0:
+        raise RuntimeError(
+            "Cannot enable DFLASH tail adaptation safely at service startup: "
+            "speculative_accept_threshold_single=1.0 and "
+            "speculative_accept_threshold_acc=1.0 are required; heuristic "
+            "thresholds are not an exactness mechanism."
+        )
+    if not stochastic:
+        return
+    try:
+        validate_dflash_exact_sampling(
+            adaptation_enabled=True,
+            is_all_greedy=False,
+            sampling_kernel_available=sampling_kernel_available,
+            threshold_single=threshold_single,
+            threshold_acc=threshold_acc,
+        )
+    except DFlashTargetDecodeRequired as exc:
+        raise RuntimeError(
+            "Cannot enable DFLASH tail adaptation safely at service startup: "
+            f"{exc} DFLASH is a scheduler-wide worker choice in the current "
+            "runtime, so per-request fallback through next_draft_input=None is "
+            "unsupported. Install a build with the exact stochastic verification "
+            "kernel and set both speculative acceptance thresholds to 1.0, or "
+            "start a target-only/DFLASH-without-adaptation service."
+        ) from exc
+
+
 def scale_kv_cell_size_per_token_for_dflash(
     *,
     target_cell_size_per_token: int,
