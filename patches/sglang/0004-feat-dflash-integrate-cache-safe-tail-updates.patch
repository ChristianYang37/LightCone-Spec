+    def replay_signals(
+        self, *, graph_batch_size: int, actual_batch_size: int
+    ) -> Optional[DFlashHeadSamplingResult]:
+        """Return fixed-address signals written by the graph that just replayed.
+
+        ``actual_batch_size`` may be smaller than the selected CUDA graph
+        bucket.  SGLang packs real requests first, so slicing the request-major
+        token rows preserves their exact association with adapter rows.  A
+        missing bucket is not guessed: callers retain the existing eager
+        reconstruction fallback.
+        """
+
+        captured = self._captured_signals_by_bs.get(int(graph_batch_size))
+        if captured is None:
+            return None
+        actual = int(actual_batch_size)
+        graph = int(graph_batch_size)
+        if actual < 1 or actual > graph:
+            return None
+        rows = actual * (self.block_size - 1)
+        tail_hidden, raw_logits, proposal_logits = captured
+        if any(int(value.shape[0]) < rows for value in captured):
+            return None
+        return DFlashHeadSamplingResult(
+            token_ids=self.out[:rows],
+            tail_hidden=tail_hidden[:rows],
+            raw_logits=raw_logits[:rows],
+            proposal_logits=proposal_logits[:rows],
+            vocab_ranges=(
+                (self.org_vocab_start, self.org_vocab_start + self.num_org),
+            ),
+        )
