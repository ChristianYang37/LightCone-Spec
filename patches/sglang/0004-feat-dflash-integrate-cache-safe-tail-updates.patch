+    def set_tail_adaptation(self, adapter: DFlashTailAdapter) -> None:
+        """Install the tail runtime before CUDA graphs are initialized.
+
+        Construction sites that own the generic LightCone manager can use this
+        narrow protocol without importing ``lightcone_spec`` from SGLang.  A
+        late install would leave already-captured proposal graphs uncorrected,
+        so it is rejected rather than silently mixing proposal semantics.
+        """
+        if adapter is None:
+            raise ValueError("DFLASH tail adapter must not be None.")
+        if not isinstance(adapter, DFlashTailAdapter):
+            raise TypeError(
+                "DFLASH tail adapter must implement correct_draft_logits "
+                "and source_adapter_versions."
+            )
+        if self._cuda_graphs_initialized:
+            raise RuntimeError(
+                "DFLASH tail adaptation must be installed before init_cuda_graphs()."
+            )
+        if self._tail_adaptation is not None and self._tail_adaptation is not adapter:
+            raise RuntimeError("DFLASH tail adaptation is already installed.")
+        adapter_config = getattr(adapter, "config", None)
+        # DFlash delegates missing attributes to the target worker.  Read
+        # optional wrapper-local state directly so partially constructed test
+        # and startup-failure objects cannot recurse through ``__getattr__``.
+        stochastic = vars(self).get("_tail_adaptation_stochastic", True)
+        adapter_temperature = getattr(
+            getattr(adapter_config, "sampling", None), "temperature", None
+        )
+        if adapter_temperature is not None:
+            stochastic = float(adapter_temperature) > 0.0
+        validate_dflash_adaptation_startup(
+            sampling_kernel_available=is_dflash_sampling_verify_available(),
+            threshold_single=self.server_args.speculative_accept_threshold_single,
+            threshold_acc=self.server_args.speculative_accept_threshold_acc,
+            stochastic=stochastic,
+        )
+        self._tail_adaptation_stochastic = stochastic
