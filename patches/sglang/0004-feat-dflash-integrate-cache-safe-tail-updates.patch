+    def _sample_dflash_draft_head(
+        self,
+        *,
+        draft_out,
+        batch_size: int,
+        lm_head,
+        adaptation: Optional[DFlashTailAdapter],
+        capture_tail_signals: bool,
+    ) -> tuple[torch.Tensor, Optional[DFlashHeadSamplingResult]]:
+        """Sample one DFlash block and return current-round supervision.
+
+        CUDA graphs are captured from the largest batch bucket to the smallest.
+        ``_DflashDraftSampler`` is one shared Python object, so its tensor
+        attributes refer to the *last captured* bucket rather than necessarily
+        the bucket replayed for this request.  The folded tokens remain valid --
+        every graph writes them into ``sampler.out`` -- but treating those
+        Python attributes as replay output can reshape a bs=1 hidden tensor as
+        bs=4 (for Qwen3-4B, ``15 x 2560`` became ``60 x 640``).
+
+        The sampler now retains the fixed-address intermediates for each graph
+        bucket and the runner exposes the bucket selected for replay.  A
+        supervision round consumes that exact bucket, avoiding a duplicate
+        full-vocabulary head evaluation.  If a backend cannot expose a matching
+        bucket, the old reconstruction from replay hidden remains the fail-safe
+        path rather than guessing tensor ownership.
+        """
+
+        block_size = int(self.block_size)
+        depth = block_size - 1
+        use_folded_tokens = self._draft_sampler is not None and bool(
+            draft_out.can_run_graph
