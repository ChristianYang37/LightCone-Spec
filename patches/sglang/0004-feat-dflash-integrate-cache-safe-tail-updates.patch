+@dataclass(frozen=True)
+class DFlashHeadSamplingResult:
+    """Result of the target-head proposal step.
+
+    ``raw_logits`` and ``proposal_logits`` are local-vocabulary shards and are
+    retained only on adaptation supervision rounds.  ``vocab_ranges`` maps the
+    concatenated shard columns back to global token ids; it normally contains
+    one range and contains two only for a base-plus-added vocabulary layout.
+    """
+
+    token_ids: torch.Tensor
+    tail_hidden: Optional[torch.Tensor] = None
+    raw_logits: Optional[torch.Tensor] = None
+    proposal_logits: Optional[torch.Tensor] = None
+    vocab_ranges: tuple[tuple[int, int], ...] = ()
+
+
+@dataclass(frozen=True)
+class DFlashProposalSignals:
+    """Immutable, current-round evidence handed to tail adaptation hooks.
+
+    DFlash proposals are deterministic, so the exact proposal distribution
+    ``q`` is the one-hot distribution at ``proposal_token_ids``.  The logits
+    fields are the scores immediately before and after the tail correction;
+    they are optional on non-supervision rounds to avoid retaining a
+    ``batch * block * vocab`` tensor in the hot path.  Proposal column ``k``
+    is supervised by target-verify position ``k``; the seeded token at verify
+    position zero is not itself a draft proposal.
+    """
+
+    proposal_token_ids: torch.Tensor
+    tail_hidden: Optional[torch.Tensor]
+    raw_logits: Optional[torch.Tensor]
+    proposal_logits: Optional[torch.Tensor]
+    valid_mask: torch.Tensor
+    prefix_lens_before: torch.Tensor
+    source_adapter_versions: torch.Tensor | tuple[int, ...]
+    vocab_ranges: tuple[tuple[int, int], ...] = ()
+
+
+@dataclass(frozen=True)
+class DFlashAcceptResult:
+    """Acceptance result used by the backend-neutral adaptation lifecycle."""
+
+    correct_len: torch.Tensor
+    commit_lens: torch.Tensor
+    bonus: torch.Tensor
+
+
+def dflash_semantic_valid_mask(
+    *,
+    proposal_token_ids: torch.Tensor,
+    base_valid_mask: torch.Tensor,
+    correct_len: torch.Tensor,
+    bonus: torch.Tensor,
+    remaining_output_tokens: Sequence[int] | torch.Tensor,
+    terminal_token_ids: Sequence[Sequence[int]],
+    ignore_eos: Sequence[bool],
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Backward-compatible DFlash name for the shared semantic mask."""
+
+    from sglang.srt.speculative.spec_utils import speculative_semantic_valid_mask
+
+    return speculative_semantic_valid_mask(
+        proposal_token_ids=proposal_token_ids,
+        base_valid_mask=base_valid_mask,
+        correct_len=correct_len,
+        bonus=bonus,
+        remaining_output_tokens=remaining_output_tokens,
+        terminal_token_ids=terminal_token_ids,
+        ignore_eos=ignore_eos,
+        backend="DFLASH",
+    )
+
