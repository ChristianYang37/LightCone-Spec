diff --git a/python/sglang/srt/entrypoints/source_owned_http_accounting.py b/python/sglang/srt/entrypoints/source_owned_http_accounting.py
new file mode 100644
index 0000000..2d3d642
--- /dev/null
+++ b/python/sglang/srt/entrypoints/source_owned_http_accounting.py
@@ -0,0 +1,188 @@
+"""Process-owned HTTP connection lifecycle accounting.
+
+The ASGI application cannot distinguish a reused keep-alive connection from a
+new transport.  This module therefore instruments uvicorn's protocol boundary,
+where ``connection_made`` and ``connection_lost`` are the authoritative TCP
+lifecycle events.  Snapshots are cumulative for exactly one HTTP process and
+generation; request headers and scheduler counters never contribute.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+from typing import Any
+
+
+class SourceOwnedHttpConnectionAccounting:
+    """Cumulative connection totals for one HTTP-server process generation."""
+
+    def __init__(self) -> None:
+        self._process_id = os.getpid()
+        self._generation = time.monotonic_ns()
+        self._created = 0
+        self._closed = 0
+        self._active_protocols: set[int] = set()
+        self._lock = threading.Lock()
+
+    @property
+    def process_id(self) -> int:
+        """Return the process generation that owns this accumulator."""
+
+        return self._process_id
+
+    def _require_owner_process(self) -> None:
+        if os.getpid() != self._process_id:
+            raise RuntimeError(
+                "HTTP connection accounting cannot cross a process generation"
+            )
+
+    def connection_made(self, protocol: object) -> None:
+        """Record one protocol-level transport creation exactly once."""
+
+        self._require_owner_process()
+        identity = id(protocol)
+        with self._lock:
+            if identity in self._active_protocols:
+                raise RuntimeError("HTTP protocol connection was opened twice")
+            self._active_protocols.add(identity)
+            self._created += 1
+
+    def connection_lost(self, protocol: object) -> None:
+        """Record one protocol-level transport close exactly once."""
+
+        self._require_owner_process()
+        identity = id(protocol)
+        with self._lock:
+            if identity not in self._active_protocols:
+                raise RuntimeError("unknown HTTP protocol connection was closed")
+            self._active_protocols.remove(identity)
+            self._closed += 1
+
+    def snapshot(self, *, require_observed: bool = False) -> dict[str, int]:
+        """Return an internally consistent source-owned cumulative snapshot."""
+
+        self._require_owner_process()
+        with self._lock:
+            current = len(self._active_protocols)
+            if self._created - self._closed != current:
+                raise RuntimeError("HTTP connection lifecycle accounting diverged")
+            if require_observed and self._created == 0:
+                raise RuntimeError(
+                    "source-owned HTTP protocol accounting has no lifecycle event"
+                )
+            return {
+                "process_id": self._process_id,
+                "generation": self._generation,
+                "connections_created": self._created,
+                "connections_closed": self._closed,
+                "connections_current": current,
+            }
+
+
+SOURCE_OWNED_HTTP_CONNECTION_ACCOUNTING: SourceOwnedHttpConnectionAccounting | None = (
+    None
+)
+
+
+def initialize_source_owned_http_connection_accounting() -> (
+    SourceOwnedHttpConnectionAccounting
+):
+    """Initialize accounting at the HTTP process startup boundary.
+
+    Import-time construction is deliberately forbidden: the module can be
+    imported before uvicorn forks or spawns its serving process.  A forked
+    child replaces an inherited accumulator, while a second initialization in
+    the same process fails closed instead of silently changing generations.
+    """
+
+    global SOURCE_OWNED_HTTP_CONNECTION_ACCOUNTING
+    accounting = SOURCE_OWNED_HTTP_CONNECTION_ACCOUNTING
+    process_id = os.getpid()
+    if accounting is not None and accounting.process_id == process_id:
+        raise RuntimeError(
+            "source-owned HTTP connection accounting was initialized twice"
+        )
+    accounting = SourceOwnedHttpConnectionAccounting()
+    SOURCE_OWNED_HTTP_CONNECTION_ACCOUNTING = accounting
+    return accounting
+
+
+def _require_initialized_accounting() -> SourceOwnedHttpConnectionAccounting:
+    accounting = SOURCE_OWNED_HTTP_CONNECTION_ACCOUNTING
+    if accounting is None:
+        raise RuntimeError(
+            "source-owned HTTP connection accounting was not initialized"
+        )
+    accounting._require_owner_process()
+    return accounting
+
+
+def instrument_http_protocol(
+    protocol_base: type,
+    *,
+    accounting: SourceOwnedHttpConnectionAccounting | None = None,
+) -> type:
+    """Wrap one asyncio/uvicorn protocol at its real transport lifecycle."""
+
+    if accounting is None:
+        accounting = _require_initialized_accounting()
+
+    class SourceOwnedHttpProtocol(protocol_base):
+        def __init__(self, *args: Any, **kwargs: Any) -> None:
+            super().__init__(*args, **kwargs)
+            self._source_owned_connection_open = False
+
+        def connection_made(self, transport: Any) -> None:
+            accounting.connection_made(self)
+            self._source_owned_connection_open = True
+            try:
+                super().connection_made(transport)
+            except BaseException:
+                accounting.connection_lost(self)
+                self._source_owned_connection_open = False
+                raise
+
+        def connection_lost(self, exc: BaseException | None) -> None:
+            try:
+                super().connection_lost(exc)
+            finally:
+                if self._source_owned_connection_open:
+                    accounting.connection_lost(self)
+                    self._source_owned_connection_open = False
+
+    SourceOwnedHttpProtocol.__name__ = f"SourceOwned{protocol_base.__name__}"
+    SourceOwnedHttpProtocol.__qualname__ = SourceOwnedHttpProtocol.__name__
+    return SourceOwnedHttpProtocol
+
+
+def source_owned_uvicorn_http_protocol() -> type:
+    """Select and instrument the same HTTP implementation as uvicorn ``auto``."""
+
+    try:
+        import httptools  # noqa: F401
+        from uvicorn.protocols.http.httptools_impl import HttpToolsProtocol
+
+        protocol_base = HttpToolsProtocol
+    except ImportError:
+        from uvicorn.protocols.http.h11_impl import H11Protocol
+
+        protocol_base = H11Protocol
+    return instrument_http_protocol(protocol_base)
+
+
+def source_owned_http_connection_snapshot() -> dict[str, int]:
+    """Snapshot the live HTTP process; reject uninstrumented server paths."""
+
+    return _require_initialized_accounting().snapshot(require_observed=True)
+
+
+__all__ = (
+    "SOURCE_OWNED_HTTP_CONNECTION_ACCOUNTING",
+    "SourceOwnedHttpConnectionAccounting",
+    "initialize_source_owned_http_connection_accounting",
+    "instrument_http_protocol",
+    "source_owned_http_connection_snapshot",
+    "source_owned_uvicorn_http_protocol",
+)
