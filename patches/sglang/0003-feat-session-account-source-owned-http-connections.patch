+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+MODULE_PATH = (
+    Path(__file__).resolve().parents[4]
+    / "python/sglang/srt/entrypoints/source_owned_http_accounting.py"
+)
+HTTP_SERVER_PATH = MODULE_PATH.with_name("http_server.py")
+SPEC = importlib.util.spec_from_file_location(
+    "source_owned_http_accounting", MODULE_PATH
+)
+assert SPEC is not None and SPEC.loader is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+SourceOwnedHttpConnectionAccounting = MODULE.SourceOwnedHttpConnectionAccounting
+instrument_http_protocol = MODULE.instrument_http_protocol
+initialize_source_owned_http_connection_accounting = (
+    MODULE.initialize_source_owned_http_connection_accounting
+)
+source_owned_http_connection_snapshot = MODULE.source_owned_http_connection_snapshot
+
+
+class _ObservedProtocol(asyncio.Protocol):
+    opened = asyncio.Event()
+    closed = asyncio.Event()
+
+    def connection_made(self, transport: asyncio.BaseTransport) -> None:
+        self.transport = transport
+        type(self).opened.set()
+
+    def connection_lost(self, exc: BaseException | None) -> None:
+        type(self).closed.set()
+
+
+async def _exercise_real_tcp_lifecycle() -> tuple[dict[str, int], ...]:
+    accounting = SourceOwnedHttpConnectionAccounting()
+    protocol = instrument_http_protocol(_ObservedProtocol, accounting=accounting)
+    server = await asyncio.get_running_loop().create_server(protocol, "127.0.0.1", 0)
+    address = server.sockets[0].getsockname()
+    try:
+        _, writer = await asyncio.open_connection(address[0], address[1])
+        await asyncio.wait_for(protocol.opened.wait(), timeout=2)
+        first = accounting.snapshot(require_observed=True)
+        writer.close()
+        await writer.wait_closed()
+        await asyncio.wait_for(protocol.closed.wait(), timeout=2)
+        second = accounting.snapshot()
+    finally:
+        server.close()
+        await server.wait_closed()
+    return first, second
+
+
+def test_protocol_counts_real_tcp_create_and_close_in_one_generation() -> None:
+    first, second = asyncio.run(_exercise_real_tcp_lifecycle())
+    assert first["process_id"] == second["process_id"]
+    assert first["generation"] == second["generation"]
+    assert first["connections_created"] == 1
+    assert first["connections_closed"] == 0
+    assert first["connections_current"] == 1
+    assert second["connections_created"] == 1
+    assert second["connections_closed"] == 1
+    assert second["connections_current"] == 0
+
+
+async def _observe_connection_changes_during_await() -> tuple[dict[str, int], ...]:
+    accounting = SourceOwnedHttpConnectionAccounting()
+    protocol = instrument_http_protocol(asyncio.Protocol, accounting=accounting)
+    server = await asyncio.get_running_loop().create_server(protocol, "127.0.0.1", 0)
+    address = server.sockets[0].getsockname()
+    control_writer = transient_writer = replacement_writer = None
+    try:
+        _, control_writer = await asyncio.open_connection(address[0], address[1])
+        _, transient_writer = await asyncio.open_connection(address[0], address[1])
+        while accounting.snapshot()["connections_created"] != 2:
+            await asyncio.sleep(0)
+        before = accounting.snapshot(require_observed=True)
+
+        async def reset_await_window() -> None:
+            nonlocal replacement_writer
+            assert transient_writer is not None
+            transient_writer.close()
+            await transient_writer.wait_closed()
+            while accounting.snapshot()["connections_closed"] != 1:
+                await asyncio.sleep(0)
+            _, replacement_writer = await asyncio.open_connection(
+                address[0], address[1]
+            )
+            while accounting.snapshot()["connections_created"] != 3:
+                await asyncio.sleep(0)
+
+        await reset_await_window()
+        after = accounting.snapshot(require_observed=True)
+    finally:
+        for writer in (control_writer, transient_writer, replacement_writer):
+            if writer is not None and not writer.is_closing():
+                writer.close()
+                await writer.wait_closed()
+        server.close()
+        await server.wait_closed()
+    return before, after
+
+
+def test_pre_and_post_snapshots_observe_connections_changed_during_reset_await() -> (
+    None
+):
+    before, after = asyncio.run(_observe_connection_changes_during_await())
+    assert before["process_id"] == after["process_id"]
+    assert before["generation"] == after["generation"]
+    assert before["connections_created"] == 2
+    assert before["connections_closed"] == 0
+    assert before["connections_current"] == 2
+    assert after["connections_created"] == 3
+    assert after["connections_closed"] == 1
+    assert after["connections_current"] == 2
+
