+@pytest.mark.skipif(not hasattr(os, "fork"), reason="requires POSIX fork")
+def test_http_process_initialization_rebuilds_in_forked_child() -> None:
+    parent_accounting = initialize_source_owned_http_connection_accounting()
+    parent_snapshot = parent_accounting.snapshot()
+    with pytest.raises(RuntimeError, match="initialized twice"):
+        initialize_source_owned_http_connection_accounting()
+
+    read_fd, write_fd = os.pipe()
+    child_pid = os.fork()
+    if child_pid == 0:
+        exit_code = 1
+        try:
+            os.close(read_fd)
+            child_accounting = initialize_source_owned_http_connection_accounting()
+            payload = json.dumps(child_accounting.snapshot()).encode("utf-8")
+            os.write(write_fd, payload)
+            exit_code = 0
+        finally:
+            os.close(write_fd)
+            os._exit(exit_code)
+
+    os.close(write_fd)
+    chunks = []
+    while chunk := os.read(read_fd, 4096):
+        chunks.append(chunk)
+    os.close(read_fd)
+    waited_pid, status = os.waitpid(child_pid, 0)
+
+    assert waited_pid == child_pid
+    assert os.waitstatus_to_exitcode(status) == 0
+    child_snapshot = json.loads(b"".join(chunks))
+    assert child_snapshot["process_id"] == child_pid
+    assert child_snapshot["process_id"] != parent_snapshot["process_id"]
+    assert child_snapshot["generation"] != parent_snapshot["generation"]
+    assert child_snapshot["connections_created"] == 0
+    assert child_snapshot["connections_closed"] == 0
+    assert child_snapshot["connections_current"] == 0
