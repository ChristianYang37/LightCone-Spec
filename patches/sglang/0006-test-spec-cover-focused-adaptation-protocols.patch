+def _config_value(**overrides):
+    value = {
+        "schema_version": 2,
+        "method": "tts",
+        "weight_update_mode": "lora",
+        "parameter_scope": "drafter",
+        "kv_history_policy": "frozen",
+        "adaptation_scope": "cohort",
+        "adaptation_group_id": "study-a",
+        "tenant_id": "tenant-a",
+        "optimizer": {
+            "name": "adamw",
+            "learning_rate": 1e-5,
+            "weight_decay": 0.01,
+            "beta1": 0.9,
+            "beta2": 0.999,
+            "epsilon": 1e-8,
+            "grad_clip": 1.0,
+        },
+        "rank": 8,
+        "stride": 10,
+        "max_in_flight": 1,
+        "canvas_tokens": 4096,
+        "loss_position_decay": 1.0,
+        "target_revision": "b" * 40,
+        "drafter_revision": "c" * 40,
+        "sampling_profile_sha256": "a" * 64,
+        "telemetry_detail": "headline",
+    }
+    value.update(overrides)
+    return value
+
+
+def _write_config(value) -> str:
+    directory = tempfile.mkdtemp(prefix="sglang-online-adaptation-")
+    path = Path(directory) / "config.json"
+    path.write_text(json.dumps(value), encoding="utf-8")
+    return str(path)
+
+
+def _server_args(config_path=None, **overrides):
+    value = {
+        "speculative_adaptation_config": config_path,
+        "speculative_adaptation_reserve_mb": 0 if config_path is None else 1024,
+        "speculative_adaptation_telemetry_path": None,
+        "speculative_speed_study_metrics": config_path is not None,
+        "speculative_algorithm": "DFLASH",
+        "speculative_draft_model_quantization": None,
+        "kv_cache_dtype": "auto",
+        "enable_two_batch_overlap": False,
+        "enable_pdmux": False,
+        "speculative_accept_threshold_single": 1.0,
+        "speculative_accept_threshold_acc": 1.0,
+        "speculative_use_rejection_sampling": config_path is not None,
+        "tp_size": 1,
+        "dp_size": 1,
+    }
+    value.update(overrides)
+    return SimpleNamespace(**value)
+
+
+class TestOnlineAdaptationConfig(unittest.TestCase):
+    def test_strict_schema_and_normalized_modes(self):
+        value = _config_value()
+        loaded = OnlineAdaptationConfig.load(_write_config(value))
+        self.assertEqual(loaded.method, "tts")
+        self.assertEqual(loaded.weight_update_mode, "lora")
+        self.assertEqual(loaded.parameter_scope, "drafter")
+        canonical = json.dumps(
+            value, sort_keys=True, separators=(",", ":")
+        ).encode()
+        self.assertEqual(loaded.sha256, hashlib.sha256(canonical).hexdigest())
+
+    def test_unknown_method_and_legacy_schema_fail_closed(self):
+        for update in (
+            {"method": "unsupported_method_a"},
+            {"method": "unsupported_method_b"},
+            {"schema_version": 1},
+        ):
+            with self.subTest(update=update), self.assertRaises(ValueError):
+                OnlineAdaptationConfig.load(
+                    _write_config(_config_value(**update))
+                )
+
+    def test_rejects_zero_depth_canvas(self):
+        with self.assertRaisesRegex(ValueError, "at least two"):
+            OnlineAdaptationConfig.load(
+                _write_config(_config_value(canvas_tokens=1))
+            )
+
+    def test_revisions_and_optimizer_values_are_immutable_and_finite(self):
+        with self.assertRaisesRegex(ValueError, "immutable Git SHA"):
+            OnlineAdaptationConfig.load(
+                _write_config(_config_value(target_revision="main"))
+            )
+        value = _config_value()
+        value["optimizer"]["learning_rate"] = float("nan")
+        with self.assertRaisesRegex(ValueError, "finite"):
+            OnlineAdaptationConfig.load(_write_config(value))
+
+    def test_full_requires_null_rank_and_residual_is_tail_only(self):
+        with self.assertRaisesRegex(ValueError, "rank=null"):
+            OnlineAdaptationConfig.load(
+                _write_config(
+                    _config_value(weight_update_mode="full", rank=8)
+                )
+            )
+        with self.assertRaisesRegex(ValueError, "tail-only"):
+            OnlineAdaptationConfig.load(
+                _write_config(_config_value(weight_update_mode="residual"))
+            )
+
+    def test_disabled_path_forbids_reserve_and_telemetry(self):
+        validate_online_adaptation(_server_args())
+        with self.assertRaisesRegex(ValueError, "forbidden"):
+            validate_online_adaptation(
+                _server_args(speculative_adaptation_reserve_mb=1)
+            )
+        with self.assertRaisesRegex(ValueError, "forbidden"):
+            validate_online_adaptation(
+                _server_args(
+                    speculative_adaptation_telemetry_path="telemetry.json"
+                )
+            )
+
+    def test_unsupported_backend_fails_before_allocation(self):
+        path = _write_config(_config_value())
+        with self.assertRaisesRegex(ValueError, "requires DFLASH"):
+            validate_online_adaptation(
+                _server_args(path, speculative_algorithm="EAGLE3")
+            )
+
+    def test_unsupported_parallel_layout_fails_before_allocation(self):
+        path = _write_config(_config_value())
+        for field in ("tp_size", "dp_size"):
+            with self.subTest(field=field), self.assertRaisesRegex(
+                ValueError, "TP=1 and DP=1"
+            ):
+                validate_online_adaptation(
+                    _server_args(path, **{field: 2})
+                )
+
+    def test_adaptation_requires_exact_rejection_sampling(self):
+        path = _write_config(_config_value())
+        with self.assertRaisesRegex(ValueError, "exact rejection sampling"):
+            validate_online_adaptation(
+                _server_args(
+                    path, speculative_use_rejection_sampling=False
+                )
+            )
+
+    def test_adaptation_requires_explicit_speed_study_metrics(self):
+        path = _write_config(_config_value())
+        with self.assertRaisesRegex(ValueError, "speed-study-metrics"):
+            validate_online_adaptation(
+                _server_args(path, speculative_speed_study_metrics=False)
+            )
+
+    def test_native_disabled_path_does_not_enable_study_metrics(self):
+        args = _server_args()
+        validate_online_adaptation(args)
+        self.assertFalse(args.speculative_speed_study_metrics)
+
+    def test_static_study_metrics_require_exact_sampling(self):
+        validate_online_adaptation(
+            _server_args(
+                speculative_speed_study_metrics=True,
+                speculative_use_rejection_sampling=True,
+            )
+        )
+        with self.assertRaisesRegex(ValueError, "exact rejection sampling"):
+            validate_online_adaptation(
+                _server_args(speculative_speed_study_metrics=True)
+            )
