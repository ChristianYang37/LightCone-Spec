+class TestHistoryGather(unittest.TestCase):
+    def test_reconstruction_gate_compares_actual_logits(self):
+        from sglang.srt.speculative.dflash_online_adaptation import (
+            _logit_reconstruction_gate,
+        )
+
+        reference = torch.tensor([[1.0, -2.0]])
+        valid, error = _logit_reconstruction_gate(
+            reference, reference + 1e-3
+        )
+        self.assertTrue(bool(valid))
+        self.assertAlmostEqual(float(error), 1e-3, places=6)
+        invalid, _ = _logit_reconstruction_gate(
+            reference, reference + 1.0
+        )
+        self.assertFalse(bool(invalid))
+
+    def test_nhd_and_hnd_layouts_match(self):
+        from sglang.srt.speculative.dflash_online_adaptation import (
+            DFlashDrafterAdapter,
+        )
+
+        nhd_key = torch.arange(8 * 2 * 3).view(8, 2, 3)
+        nhd_value = nhd_key + 1000
+        hnd_key = nhd_key.view(2, 4, 2, 3).permute(0, 2, 1, 3)
+        hnd_value = nhd_value.view(2, 4, 2, 3).permute(0, 2, 1, 3)
+        locations = torch.tensor([1, 6])
+
+        class Pool:
+            def __init__(self, key, value):
+                self.key = key
+                self.value = value
+
+            def get_kv_buffer(self, _layer_id):
+                return self.key, self.value
+
+        def adapter(key, value):
+            return SimpleNamespace(
+                worker=SimpleNamespace(
+                    page_size=4,
+                    draft_model_runner=SimpleNamespace(
+                        token_to_kv_pool=Pool(key, value)
+                    ),
+                )
+            )
+
+        nhd = DFlashDrafterAdapter._gather_history(
+            adapter(nhd_key, nhd_value),
+            layer_id=0,
+            locations=locations,
+        )
+        hnd = DFlashDrafterAdapter._gather_history(
+            adapter(hnd_key, hnd_value),
+            layer_id=0,
+            locations=locations,
+        )
+        torch.testing.assert_close(nhd[0], hnd[0])
+        torch.testing.assert_close(nhd[1], hnd[1])
+
