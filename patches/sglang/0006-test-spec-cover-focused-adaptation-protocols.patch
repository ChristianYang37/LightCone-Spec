+class TestFrozenKVVersionHistory(unittest.TestCase):
+    def test_publish_only_changes_future_segments(self):
+        state = RequestVersionState(version=0, slot_generation=0)
+        state.append(8, source_version=0)
+        state.version = 1
+        state.append(12, source_version=1)
+        self.assertEqual(
+            [
+                (segment.start, segment.end, segment.source_version)
+                for segment in state.segments
+            ],
+            [(0, 8, 0), (8, 12, 1)],
+        )
+        state.retract(10)
+        self.assertEqual(state.segments[-1].end, 10)
+        self.assertEqual(state.segments[-1].source_version, 1)
+
