+@unittest.skipUnless(torch.cuda.is_available(), "CUDA publication test")
+class TestCudaFixedAddress(unittest.TestCase):
+    def test_publish_does_not_replace_cuda_storage(self):
+        active = torch.zeros(16, device="cuda", dtype=torch.float16)
+        bank = FixedInferenceBank((active,))
+        address = active.data_ptr()
+        for value in (1.0, 2.0, 3.0):
+            bank.stage((torch.full_like(active, value),))
+            bank.publish()
+            self.assertEqual(active.data_ptr(), address)
+        torch.testing.assert_close(active, torch.full_like(active, 3.0))
+
+    def test_round_telemetry_stays_device_resident_until_diagnostics(self):
+        from sglang.srt.speculative.online_adaptation_runtime import (
+            OnlineCohortRuntime,
+        )
+
+        config = OnlineAdaptationConfig.load(
+            _write_config(_config_value(stride=2, canvas_tokens=16))
+        )
+        runtime = OnlineCohortRuntime(
+            config,
+            device=torch.device("cuda"),
+            reserve_bytes=64 * 1024 * 1024,
+            telemetry_path=None,
+            max_trace_updates=10,
+            max_trace_batch=2,
+        )
+        runtime.bind_parameter_layout(
+            (("weight", torch.zeros(1, device="cuda")),),
+            projection_identity="test-head",
+        )
+        version = runtime.begin_round(
+            ("r0", "r1"), torch.tensor([100, 200], device="cuda")
+        )
+        self.assertEqual(version, 0)
+        runtime.record_round_outcome(
+            ("r0", "r1"),
+            verified_drafts=torch.tensor([15, 15], device="cuda"),
+            accepted_drafts=torch.tensor([4, 5], device="cuda"),
+            committed_tokens=torch.tensor([5, 6], device="cuda"),
+        )
+        rounds = runtime.diagnostics()["rounds"]
+        self.assertEqual(len(rounds), 1)
+        self.assertEqual(rounds[0]["prefix_len_before"], [100, 200])
+        self.assertEqual(rounds[0]["accepted_drafts"], [4, 5])
+
+
+if __name__ == "__main__":
+    unittest.main()
