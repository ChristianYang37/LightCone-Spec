+class TestCancellationLifecycle(unittest.TestCase):
+    def test_abort_invalidates_pending_candidate_without_publishing(self):
+        from sglang.srt.speculative.online_adaptation_runtime import (
+            OnlineCohortRuntime,
+        )
+
+        runtime = OnlineCohortRuntime.__new__(OnlineCohortRuntime)
+        runtime.requests = {"request-a": object()}
+        runtime.latest_device_lengths = {}
+        runtime.slot_generation = 4
+        runtime.update_traces = [SimpleNamespace(status="pending")]
+        runtime.counters = {"updates_discarded": 0}
+        runtime.pending = SimpleNamespace(trace_index=0)
+        runtime.abort_request("request-a")
+
+        self.assertEqual(runtime.slot_generation, 5)
+        self.assertIsNone(runtime.pending)
+        self.assertEqual(runtime.update_traces[0].status, "request_aborted")
+        self.assertEqual(runtime.counters["updates_discarded"], 1)
+
+    def test_dflash_abort_cleans_both_parameterizations(self):
+        from sglang.srt.speculative.dflash_worker_v2 import DFlashWorkerV2
+
+        drafter = SimpleNamespace(aborted=[])
+        drafter.abort_request = drafter.aborted.append
+        tail = SimpleNamespace(aborted=[])
+        tail.abort_request = tail.aborted.append
+        worker = DFlashWorkerV2.__new__(DFlashWorkerV2)
+        worker._online_drafter_adapter = drafter
+        worker._online_tail_adapter = tail
+
+        worker.note_request_aborted(rid="request-a")
+
+        self.assertEqual(drafter.aborted, ["request-a"])
+        self.assertEqual(tail.aborted, ["request-a"])
+
